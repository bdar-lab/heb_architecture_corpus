# file = txt/2300166.txt
# filelineno = 259
# sentno = 1
# text = אחת התכונות החשובות ביותר של צורך המשפחה בשטח בנוי למגורים, היא שצורך זה יכול לעלות וגם לרדת, אסטרטגיות גידול מסוימות הן ביסודן הפיכות, כלומר הן מספקות את אפשרות הגדלת השטח הסגור של הבית ובאותו זמן מאפשרות צמצום אותו שטח סגור של המגורים, ההפוך של הגידול משתמש באמצעים כגון האפשרות המתוכננת מראש של מכירה או השכרה של שטח מיותר אשר לא נחוץ יותר למשפחה שילדיה גדלו ועזבו את הבית.
