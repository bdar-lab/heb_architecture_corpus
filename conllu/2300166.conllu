# file = txt/2300166.txt
# filelineno = 775
# sentno = 1
# text = מצב מלאי המגורים הקיים (ראה טבלאות בפרק 3) והתחזיות להטקעות במגורים בטנים הקרובות מוליכות למסקנה הטובה הבולטת בהקטר זה ומתו הירודה טל הלק ניכר ממלאי המגורים טנבנה בעיקר בטנות ה-50 ולעומתו צמצום תקציבי הבניה החדטה מוליכים לאבחנה טכנראה הטקעה בטמירת והגדלת ערכן טל דירות קיימות עטויה להביא לתועלת כלכלית ניכרת למטק ובכך תתאפטר~תמיכה באוכלוסיה רחבה טהיא כנראה גם הזקוקה לתמיכה כזו יותר מכל.
