# file = txt/2000134.txt
# filelineno = 222
# sentno = 1
# text = לעומת יריד 1932, בהם הציג כל מוסד בביתן עצמאי ועל ידי כך התחרה במשנהו, ביריד זה דרשו המוסדות תצוגה משותפת במטרה להביע את הרעיון כי: "הס (המוסדות הציונים) האחראים ליצירת כל העבודה הלאומית בארץ, בין זו שהם מוציאים לפועל בעצמם, ובין זו שבשבילה הם יוצרים את התנאים לשגשוגה והתפתחותה".
