# file = txt/2000134.txt
# filelineno = 164
# sentno = 1
# text = הנהלת היריד - הוגי מפעל הירידים, אלכסנדר יבזרוב (עזר, 1973-1895), שלמה יפה (1949-1894) ואברהם אידלסון (אילון), היו אחראים על המימון והארגון הכלכלי, קביעת התכנים, הניהול והפיקוח; כגון העבודה מול עיריית תל אביב (קבלת רשיונות, תשלומי מסים), התקשרויות עם המציגים השונים והוצאת פרסומים, חוברות וכרזות לקראת היריד בארץ ובחו״ל.
