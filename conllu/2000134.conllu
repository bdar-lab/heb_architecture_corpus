# file = txt/2000134.txt
# filelineno = 65
# sentno = 3
# text = החברה ארגנה גם את הביתן הארץ ישראלי בתערוכה הקולוניאלית הבינלאומית בפריז (1931, תוכנן על ידי אריה אל־חנני), את הביתן הארץ ישראלי בתערוכה בבארי, איטליה (1931) והביתן בתערוכה העולמית בניו יורק (1939) שתוכנן אף הוא על ידי אריה אל-חנני.
