# file = txt/1500244.txt
# filelineno = 561
# sentno = 3
# text = בהתאם לכך, תוספת שטחי שירות לבניית מרחב מוגן לא תחשב כסטייה ניכרת מתכנית - על פי נוסח דברי ההסבר לתיקון, מוצע כי ניתן להגיש בקשה להיתר אף אם המדובר בה על היתר לשימוש חורג או למתן הקלה כמשמעותם בחוק ואף אם הבקשה אינה תואמת תכנית תקפה לפי החוק, וכי רשות רישוי מקומית תחליט בבקשה להיתר למרחב מוגן בתוך 30 ימים; זאת במקום 60 ימים הקבועים בחוק (תקנה 158ז.(א)), ובתנאי ששטח התוספת לא יעלה על השטח שקבע שר הביטחון לפי חוק ההתגוננות האזרחית; כמו כן התיקון פוטר חובת תשלום היטל השבחה בשל הקמת מרחב מוגן, בשטח מינימלי (9 מ״ר) שאושר על פי תקנות ההתגוננות האזרחית.
