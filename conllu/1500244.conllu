# text = מחקרי הערכה של פרויקט שיקום שכונות העלו כי שיפור פיסי במצב הבניינים משליך על איכות החיים ומכאן על הדימוי העצמי של הדיירים (כרמון ואוקסמן, 1981; גינסברג וורצברגר, 1988); ברמה העירונית, נמצא כי ההרחבות התורמות להארכת משך השימוש בבניינים מונעות הידרדרות עתידית של השכונות (כרמון ואוקסמן, 1981 ; ,Carmon 2002); ברמה הארצית, נטען כי תרומתן הרחבה לשיפור תנאי המגורים וחיזוק הדימוי של הדיירים מסייעת להקטנת פערים חברתיים.
# raw = {'id': 2, 'text': 'מחקרי הערכה של פרויקט שיקום שכונות העלו כי שיפור פיסי במצב הבניינים משליך על איכות החיים ומכאן על הדימוי העצמי של הדיירים (כרמון ואוקסמן, 1981; גינסברג וורצברגר, 1988); ברמה העירונית, נמצא כי ההרחבות התורמות להארכת משך השימוש בבניינים מונעות הידרדרות עתידית של השכונות (כרמון ואוקסמן, 1981 ; ,Carmon 2002); ברמה הארצית, נטען כי תרומתן הרחבה לשיפור תנאי המגורים וחיזוק הדימוי של הדיירים מסייעת להקטנת פערים חברתיים.', 'dspan': (129, 543), 'tokens': [{'id': 1, 'text': 'מחקרי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 7, 'deprel': 'nsubj', 'dspan': (129, 134), 'span': (0, 5), 'lemma': 'מחקר'}, {'id': 2, 'text': 'הערכה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'compound', 'dspan': (135, 140), 'span': (6, 11), 'lemma': 'הערכה'}, {'id': 3, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 4, 'deprel': 'case', 'dspan': (141, 143), 'span': (12, 14), 'lemma': 'של'}, {'id': 4, 'text': 'פרויקט', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'nmod:poss', 'dspan': (144, 150), 'span': (15, 21), 'lemma': 'פרויקט'}, {'id': 5, 'text': 'שיקום', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'compound', 'dspan': (151, 156), 'span': (22, 27), 'lemma': 'שיקום'}, {'id': 6, 'text': 'שכונות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 5, 'deprel': 'compound', 'dspan': (157, 163), 'span': (28, 34), 'lemma': 'שכונה'}, {'id': 7, 'text': 'העלו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HIFIL|Number=Plur|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (164, 168), 'span': (35, 39), 'lemma': 'העלה'}, {'id': 8, 'text': 'כי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 15, 'deprel': 'mark', 'dspan': (169, 171), 'span': (40, 42), 'lemma': 'כי'}, {'id': 9, 'text': 'שיפור', 'u