# sentno = 2
# text = פערי המקלוט והמיגון שנמצאו בבנייה למגורים מוסברים בדוחות על רקע שינויים באופי העימותים ותדירותם; אומדן טווח פערי המיגון, המגולם ברמת המיגון הפיסי המסופק לאוכלוסייה ובמאפיינים פיסיים של בנייה למגורים הצביע על מצב מתמשך של חוסר איזון בין האיומים למענה הפיסי הנדרש להגנה מפניהם - דחיפות הטיפול בבעיה הודגשה בסיכום דוח המבקר על הערכות העורף ותפקודו במלחמת לבנון השנייה (שם: 2007: 456); על פי המלצותיו מציאת פתרונות מחייבת "קבלת החלטות מכריעות בתחומי התכנון והבנייה".
# raw = {'id': 2, 'text': 'פערי המקלוט והמיגון שנמצאו בבנייה למגורים מוסברים בדוחות על רקע שינויים באופי העימותים ותדירותם; אומדן טווח פערי המיגון, המגולם ברמת המיגון הפיסי המסופק לאוכלוסייה ובמאפיינים פיסיים של בנייה למגורים הצביע על מצב מתמשך של חוסר איזון בין האיומים למענה הפיסי הנדרש להגנה מפניהם - דחיפות הטיפול בבעיה הודגשה בסיכום דוח המבקר על הערכות העורף ותפקודו במלחמת לבנון השנייה (שם: 2007: 456); על פי המלצותיו מציאת פתרונות מחייבת "קבלת החלטות מכריעות בתחומי התכנון והבנייה".', 'dspan': (137, 599), 'tokens': [{'id': 1, 'text': 'פערי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 14, 'deprel': 'nsubj', 'dspan': (137, 141), 'span': (0, 4), 'lemma': 'פערי'}, {'id': (2, 3), 'text': 'המקלוט', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'מקלוט', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'compound:smixut', 'lemma': 'מקלוט'}], 'span': (5, 11), 'dspan': (142, 148)}, {'id': (4, 6), 'text': 'והמיגון', 'expanded': [{'id': 4, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 6, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'מיגון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'conj', 'lemma': 'מיגון'}], 'span': (12, 19), 'dspan': (149, 156)}, {'id': (7, 8), 'text': 'שנמצאו', 'expanded': [{'id': 7, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 8, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 8, 'text': 'נמצאו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem,Masc|HebBinyan=NIFAL|Number=Plur|Person=3|Tense=Past|Voice=Mid', 'head': 1, 'deprel': 'acl:relcl', 'lemma': 'נמצא'}], 'span': (20, 26), 'dspan': (157, 163)}, {'id': (9, 11), 'text': 'בבנייה', 'expanded': [{'id': 9, 'text': 'ב', 'upos': 'ADP', 