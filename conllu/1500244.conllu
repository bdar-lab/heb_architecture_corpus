# text = דו"חות מבקר המדינה הרלבנטיים לפרויקט מיגון בתי המגורים בשדרות כוללים דו״ח ביקורת על ההתנתקות ומיגון היישובים בגזרת עוטף עזה - החלטות ויישומן (ינואר 2006); דו״ח הביקורת על היערכות העורף ותפקודו במלחמת לבנון השנייה (יולי 2007), אומנם אינו נוגע במישרין למיגון שדרות ויישובי עוטף עזה, אבל פתח דיון ציבורי סוער בנושא.
# raw = {'id': 1, 'text': 'דו"חות מבקר המדינה הרלבנטיים לפרויקט מיגון בתי המגורים בשדרות כוללים דו״ח ביקורת על ההתנתקות ומיגון היישובים בגזרת עוטף עזה - החלטות ויישומן (ינואר 2006); דו״ח הביקורת על היערכות העורף ותפקודו במלחמת לבנון השנייה (יולי 2007), אומנם אינו נוגע במישרין למיגון שדרות ויישובי עוטף עזה, אבל פתח דיון ציבורי סוער בנושא.', 'dspan': (0, 312), 'tokens': [{'id': 1, 'text': 'דו"חות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Abbr=Yes|Gender=Masc|Number=Plur', 'head': 16, 'deprel': 'nsubj', 'dspan': (0, 6), 'span': (0, 6), 'lemma': 'דו"ח'}, {'id': 2, 'text': 'מבקר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'compound:smixut', 'dspan': (7, 11), 'span': (7, 11), 'lemma': 'מבקר'}, {'id': (3, 4), 'text': 'המדינה', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'מדינה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'compound:smixut', 'lemma': 'מדינה'}], 'span': (12, 18), 'dspan': (12, 18)}, {'id': (5, 6), 'text': 'הרלבנטיים', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'רלבנטיים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'amod', 'lemma': 'רלבנטיים'}], 'span': (19, 28), 'dspan': (19, 28)}, {'id': (7, 9), 'text': 'לפרויקט', 'expanded': [{'id': 7, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ל'}, {'id': 8, 'text': 'ה_', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'פרויקט', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'nmod', 'lemma': 'פרויקט'}], 'span': (29, 36), 'dspan': (29, 36)}, {'id': 10, 'text': 'מיגון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Defin