# file = txt/1500244.txt
# filelineno = 99
# sentno = 2
# text = הסוגיה העיצובית נגזרת מהשאלה כיצד ניתן להבטיח חופש בחברה פתוחה ופלורליסטית, וזאת מבלי לפגוע באפשרויות העירוניות שהוא מציע בעצם התהליכים ואמצעים שנועדו לשמור על ביטחון הכלל ולהגן על זכויות הפרט (ר' למשל: 2009 ,Lentzos & Rose); הביקורת הציבורית הנמתחת על מנגנוני הביטחון של המדינה מגדירה את הסוגיה בהשפעת כוח ממשלתי על מידת חופש אינדיבידואלי וחוסר איזון בין ערכי חופש והגנה
