# file = txt/1500244.txt
# filelineno = 486
# sentno = 1
# text = מקרה גלילי הרצוג מראה כי מיקומן של תוספות הממ"דים בחזית הבניינים הקיימים אשר אפיינה את הסגירות של החצר כחלל פנימי הומוגני, שובר את רצף חזית המגורים של החצר; תוספות הממ"דים יוצרות בחצר תחושת צפיפות, כאשר המאפיינים הפיסיים של המיגון החיצוני מחלקים את שטחה לתאים נפרדים ומנותקים ויזואלית זה מזה.
