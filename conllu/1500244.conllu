# text = ממצאי הבדיקה של הוועדה לבדיקת מוכנות העורף ודוח מבקר המדינה, הראו כי אמות המידה של פקע״ר להערכת פערי מיגון לא היו רלוונטיות לתרחיש מלחמת לבנון השנייה, ושבו האוכלוסייה נדרשה לשהות במקלטים ובממ"דים ברציפות במשך זמן ממושך מאוד והגדול מ-3 שעות (דוח מבקר המדינה, יולי 2007: 460) 4°; מובהר כי פערי המיגון הנ"ל חושבו על יסוד הנחת פקע״ר אשר לפיה השהייה של אדם במקלט או במרחב מוגן תהייה קצרה משלוש שעות.
# raw = {'id': 1, 'text': 'ממצאי הבדיקה של הוועדה לבדיקת מוכנות העורף ודוח מבקר המדינה, הראו כי אמות המידה של פקע״ר להערכת פערי מיגון לא היו רלוונטיות לתרחיש מלחמת לבנון השנייה, ושבו האוכלוסייה נדרשה לשהות במקלטים ובממ"דים ברציפות במשך זמן ממושך מאוד והגדול מ-3 שעות (דוח מבקר המדינה, יולי 2007: 460) 4°; מובהר כי פערי המיגון הנ"ל חושבו על יסוד הנחת פקע״ר אשר לפיה השהייה של אדם במקלט או במרחב מוגן תהייה קצרה משלוש שעות.', 'dspan': (0, 394), 'tokens': [{'id': 1, 'text': 'ממצאי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 18, 'deprel': 'nsubj', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'ממצא'}, {'id': (2, 3), 'text': 'הבדיקה', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'בדיקה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'compound', 'lemma': 'בדיקה'}], 'span': (6, 12), 'dspan': (6, 12)}, {'id': 4, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 6, 'deprel': 'case', 'dspan': (13, 15), 'span': (13, 15), 'lemma': 'של'}, {'id': (5, 6), 'text': 'הוועדה', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'וועדה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'nmod:poss', 'lemma': 'ועדה'}], 'span': (16, 22), 'dspan': (16, 22)}, {'id': (7, 8), 'text': 'לבדיקת', 'expanded': [{'id': 7, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ל'}, {'id': 8, 'text': 'בדיקת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'nmod', 'lemma': 'בדיקה'}], 'span': (23, 29), 'dspan': (23, 29)}, {'id': 9, 'text': 'מוכנות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'c