# file = txt/1500244.txt
# filelineno = 696
# sentno = 5
# text = כך, בשכונת נאות הנביאים7'אתר חירום" (ר' צוק, 2009), תוספות ממ"דים לבתים צמודי קרקע מילאו את שטחי החצרות וביטלו אותן; הצפיפות הקיימת ב"שכונת משעולים" לא אפשרה הוספת ממ"דים לבתים הקיימים, לכן בוצע בהם מיגון פנימי שביטל חלונות והקטין את שטח המגורים הקיים.
