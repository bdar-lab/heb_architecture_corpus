# file = txt/1500244.txt
# filelineno = 191
# sentno = 2
# text = כך למשל, נטען כי העדפה למיקום המרחבים המוגנים עם מינימום של קירות חוץ, ובנייתם זה מעל זה בצורת מגדל מיגון בתוך המבנה, מגבילות את חופש התכנון ואת גמישות הפרוגרמה האדריכלית בכל אחת מהדירות בנפרד ובשטחים משותפים בבניין.
