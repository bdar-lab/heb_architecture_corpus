# file = txt/1500244.txt
# filelineno = 605
# sentno = 1
# text = על פי נתוני מינהלת פרויקט המיגון בשדרות, בכל שלבי הפרויקט נרשמו בםה״כ כ-500 יחידות דיור בביצוע עצמי; מתוכן כ-250 יח"ד צמודי קרקע בשלב א', כ-70 יח״ד בבנייה רוויה בשלב ב', וכ-180 יח״ד צמודי קרקע שהצטרפו לפרויקט בשלב מאוחר ואושרו בוועדת חריגים לאחר גמר שלב א' (ראיון: מנכ"ל עמיגור פרנקל,21/5/2014).
