# file = txt/1500244.txt
# filelineno = 237
# sentno = 1
# text = בעיקרי הדו״ח השני המסכם את המלצות הוועדה נכתב כי בבחינת תפיסת ומדיניות המיגון בעורף, "הוועדה חוזרת וממליצה לקיים בדיקה מחודשת של כל תפיסת מיגון האזרחים הן מבחינת ההגנה הפיסית והן מבחינת ההשלכות הנגזרות מבחינת היכולת להיכנס אליהם בזמן ולשהות בהם תקופות ארוכות, כולל היבטים חברתיים (שם: דוח שני, פברואר 2007; הדגשה ע.צ.); כפי שצוין בדוח הראשוני, "היערכות והפעלת העורף צריכה לצאת מנקודת מוצא של צרכי האזרח - יכולתו לשרוד ולהמשיך לתפקד בתקופת חירום".
