# file = txt/1500244.txt
# filelineno = 527
# sentno = 3
# text = ממצאים אלה מערערים את המסר שבאמצעותו מנהל התכנון משווק למתכננים את תוספות הממ"דים כהרחבות מגורים; לשיטתו, יישומן מתפרש כסיפוק בו-זמני של צורכי ביטחון ורווחה אבל בעיקר כביטוי חומרי של מימוש עצמי (משרד הפנים, 2014).
