# file = txt/1500244.txt
# filelineno = 578
# sentno = 3
# text = לעומת זאת, מרחב מוגן דירתי המתוכנן לשהייה ארוכה כחדר אחד ודו-תכליתי בדירה, נתפס כפתרון נוח ויתרון בזמן התקפה; כאמור על פי תפיסת המיגון של פיקוד העורף, השימוש בממ״ד לא רק מבטיח את תקינותו אלא בעיקר מהווה יתרון פסיכולוגי מרגיע בזמן חירום (מפקדת פיקוד העורף, מחלקת התגוננות אוכלוסייה, ענף הנדסה ומיגון, 2001).
