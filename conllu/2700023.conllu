# file = txt/2700023.txt
# filelineno = 438
# sentno = 1
# text = שינוי במחירים על ידי התערבות בתחום המיסוי (או על ידי מתן סבסוד) עשויה, במקרה של התחבורה, לא רק להביא לשינוי בכמות הנצרכת (נסועה של רכב פרטי) אלא גם להסטה לתחליפים, כמו למשל הסטה (רצויה) מרכב פרטי לציבורי, מרכב גדול לרכב קטן או ממרחק נסיעה גדול לקטן יותר, על ידי העתקת מקום המגורים או התעסוקה.
