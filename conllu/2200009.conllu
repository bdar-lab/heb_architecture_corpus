# file = txt/2200009.txt
# filelineno = 154
# sentno = 3
# text = לעומת זאת, התקנת חחכנח למצנן לא גורעת כחוא זח מתאפשרות של שמוש במזגן בין אם התנאים הכלכליים ישתנו (כגון עליה דרסטית של מחיר מים המלוות בירידת משמעותית של מחיר החשמל - ראה ציור 31) ובין אם רמת חחיים של חמשתמש בדירת תאפשר לו לצרוך רמת נוחות תרמית גבוהה יותר, אותה אין המצנן מסוגל לספק.
