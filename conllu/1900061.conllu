# file = txt/1900061.txt
# filelineno = 97
# sentno = 1
# text = (ב) על אף האמור בתקנת משנה (א)(7), פנה עורך הבקשה לבעל מיתקן תשתית בבקשה לקבל מידע לפי תקנת המשנה האמורה לעניין מיתקני תשתית שאין לגביהם פרטים בתכנית, ולא קיבל את תגובתו, לא תחול עליו החובה לציין מידע כאמור במפת איתור העבודה, ובלבד שפנייה כאמור תהיה לכתובת הגוף הרשומה אצל רשם החברות, ולעניין גוף שאינו נדרש לפי דין לרישום ברשם החברות – למשרדיו הראשיים; עורך הבקשה יציין בבקשה כי פנה לבעלי מיתקני תשתית כאמור ולא קיבל את תגובתם.
