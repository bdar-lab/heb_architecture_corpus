# file = txt/1500250.txt
# filelineno = 73
# sentno = 2
# text = כמו כן נטען כי התפיסה לפיה בנייה צמודת קרקע הינה מאפיין של החברה הערבית לא עולה בקנה אחד עם יישובים מקבילים בסוריה, לבנון או מצרים שהיו בעבר חקלאיים והיום הם עירוניים, שם נבנים בנייני דירות רבי־קומות (סופר, 2003).
