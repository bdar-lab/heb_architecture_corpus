# file = txt/1800148.txt
# filelineno = 204
# sentno = 2
# text = דוגמאות לכשל מבני של החיבור בין מערכת הביסוס למבנה העילי של בניין הינם למשל, כשל כפיפה ו/או או גזירה ו/או מתיחה במחברים בין רכיבי מערכת הביסוס למבנה העילי, או קריעה או שליפה מהבטון של מוטות זיון המקשרים בין מערכת הביסוס למבנה העילי, במקרה של הפעלת עומסי מתיחה משמעותיים עליהם, אשר לא נלקחו בחשבון בזמן התכן.
