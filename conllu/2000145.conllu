# file = txt/2000145.txt
# filelineno = 279
# sentno = 4
# text = על מנת להבטיח את קריאותם והבנתם של אותם חוזים נקבעו תקנות מיוחדות המסדירות את אופן כתיבתם: הגודל המזערי של האותיות (2 מ״מ), אופן כתיבת האותיות (לא נטויות ולא מוצרות), צבע האותיות (נוגד את הרקע עליו הן מודפסות), הרווח בין השורות (לא קטן מגודל האות) וצפיפות האותיות (לא יגעו אחת בשניה).
