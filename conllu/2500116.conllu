# text = טמפרטורת המשטחים החיצוניים עוקבת כמובן בקרבה גדולה מאד אחרי התנודות בטמפרטורת אוויר החוץ, אך הערך האבסולוטי שלה תלוי גם במידת החשיפה לקרינת השמש, בקרינה החוזרת אל החלל וכאינרציה התרמית, כך שבשעות מסויימות פני השטח החיצוניים של הקיר המזרח צפוני כתוצאה מקרינת השמש חמים יותר, מעל ומעבר, לטמפרטורת האוויר (ראה ימים 28/1 - 29/1), בעוד שפני השטח החיצוניים של הקיר הצפון מערבי עדיין קרים יותר כאורח ניכר (באותה עת עצמה) מטמפרטורת האוויר, אף על פי שבלילה הם היו חמים יותר מטמפרטורת האוויר ששררה באותה עת.
# raw = {'id': 1, 'text': 'טמפרטורת המשטחים החיצוניים עוקבת כמובן בקרבה גדולה מאד אחרי התנודות בטמפרטורת אוויר החוץ, אך הערך האבסולוטי שלה תלוי גם במידת החשיפה לקרינת השמש, בקרינה החוזרת אל החלל וכאינרציה התרמית, כך שבשעות מסויימות פני השטח החיצוניים של הקיר המזרח צפוני כתוצאה מקרינת השמש חמים יותר, מעל ומעבר, לטמפרטורת האוויר (ראה ימים 28/1 - 29/1), בעוד שפני השטח החיצוניים של הקיר הצפון מערבי עדיין קרים יותר כאורח ניכר (באותה עת עצמה) מטמפרטורת האוויר, אף על פי שבלילה הם היו חמים יותר מטמפרטורת האוויר ששררה באותה עת.', 'dspan': (0, 497), 'tokens': [{'id': 1, 'text': 'טמפרטורת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'nsubj', 'dspan': (0, 8), 'span': (0, 8), 'lemma': 'טמפרטורת'}, {'id': (2, 3), 'text': 'המשטחים', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'משטחים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'compound', 'lemma': 'משטח'}], 'span': (9, 16), 'dspan': (9, 16)}, {'id': (4, 5), 'text': 'החיצוניים', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'חיצוניים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 3, 'deprel': 'amod', 'lemma': 'חיצוני'}], 'span': (17, 26), 'dspan': (17, 26)}, {'id': 6, 'text': 'עוקבת', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PAAL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (27, 32), 'span': (27, 32), 'lemma': 'עקב'}, {'id': 7, 'text': 'כמובן', 'upos': 'ADV', 'xpos': 'ADV', 'head': 6, 'deprel': 'advmod', 'dspan': (33, 38), 'span': (33, 38), 'lemma': 'כמובן'}, {'id': (8, 9), 'text': 'בקרבה', 'expanded': [{'id': 8, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma':