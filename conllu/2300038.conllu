# file = txt/2300038.txt
# filelineno = 105
# sentno = 1
# text = בסקר שערך 2006) Allison) על השפעותיה של אוניברסיטת Selly Oak בקרב בעלי עניין בברמינגהם אנגליה, עלה שרבים רואים את חצי הכוס הריקה, וציינו את אורח חייהם של סטודנטים הממריצים את חיי הלילה כגורם למטרדי רעש ופעמים רבות מפר את שלוות הלילה.
