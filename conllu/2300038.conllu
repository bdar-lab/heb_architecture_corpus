# file = txt/2300038.txt
# filelineno = 68
# sentno = 2
# text = למרות שרמת המצרפיות המרחבית (הגדרת גבולות האזוריים והמטרופולינים), כמו גם מערכי המחקר היו שונים במידת מה מהמחקרים שנערכו בארה״ב, חלקם עדיין מצביעים על זליגתו של ידע חדשני מאוניברסיטאות לתעשייה ועל הנטייה של פירמות טכנולוגיות להתמקם בסמוך למוקדי חדשנות אקדמיים.
