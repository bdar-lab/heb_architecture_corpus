# file = txt/2300143.txt
# filelineno = 26
# sentno = 1
# text = במחקרם של שפר ופרנקל (1987), שעסק בין השאר בפערים שבין ערי הפיתוח למרכז, נמצא כי בעשור האחרון חלו שינויים שתרמו לסגירת הפערים שבין המאפיינים הסוציו-כלכליים של אוכלוסיית ערי הפיתוח לבין מאפיינים הסוציו-כלכליים של אוכלוסיית שאר הישובים העירוניים בישראל.
