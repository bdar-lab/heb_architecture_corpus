# file = txt/1500123.txt
# filelineno = 71
# sentno = 2
# text = מבנה הקבורה של הקדוש אשר על שמו קרוי בית הקברות ("עבד הנביא" - כינויו של מוחמד לפי המסורת המוסלמית) מצוי כיום במרכז בית הקברות, ובו חמש גומחות תפילה, קשתות רבות, כוכים ועיטורים מאבן צבעונית - עם זאת לא מצוי מידע היסטורי אודות זהותו (קרק 984ו, יהב 2004).
