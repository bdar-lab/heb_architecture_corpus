# file = txt/1500123.txt
# filelineno = 70
# sentno = 2
# text = מבנה הקבר משתייך לרצף אתרי עלייה לרגל אשר הוקמו בתקופה הממלוכית לאורך מישור החוף, דוגמת סידנא עלי שמדרום לארסוף או נבי רובין הסמוך לשפך נחל שורק, אולם הוא פחות מהם בחשיבותו, ואינו מוזכר כמעט בספרות עולי הרגל של התקופה (ארליך 2009).
