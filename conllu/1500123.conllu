# file = txt/1500123.txt
# filelineno = 84
# sentno = 2
# text = לפי היימן היו לממשל הבריטי כמה עקרונות מנחים ביחס למדיניות פיתוח הארץ: (ו) ״ממשל טוב״ -ניהול תקין ומודרני של הארץ; (2) מודרניזציה דרך השקעה בתשתיות ותחבורה; (3) עידוד פיתוח על ידי האוכלוסייה המקומית; (4) השקעות בעקבות אינטרסים אימפריאליים (994ו Hyman).
