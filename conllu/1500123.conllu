# file = txt/1500123.txt
# filelineno = 84
# sentno = 1
# text = "ייבוא" של תיאוריות תכנון מערביות עדכניות, ידע אדריכלי וחקיקה עירונית אפיין ככלל את השלטון הקולוניאלי בתחילת המאה העשרים, ושימש פעמים רבות אמצעי של שליטה ויצירת מערך מודרני ומפותח בעולם ה״לא מערבי״ (996ו Kolodney and Kallus 2008 ,Home).
