# text = על אף חשיבות הטיפול בנוף, מעמדם המקצועי של אדריכלי הגנים בתקופה זו עדיין נותר במקרים רבים בעייתי אל מול גופי תכנון אחרים, כפי שמעיד על כך אדריכל הנוף שלמה גת ב־ 1968: "לעיתים רחוקות אנו מוצאים שיתוף פעולה מלא ובמיוחד שילוב מתכנני הנוף בפיתוח אזורים חדשים [...] אם כבר משתפים אדריכלי נוף בתכנון, הרי עושים זאת לאחר מעשה, לאחר שכבר נקבעו עובדות מוגמרות, בלי שתהיה לאדריכל כל השפעה עליהם״ (גת 1968, 528).
# raw = {'id': 1, 'text': 'על אף חשיבות הטיפול בנוף, מעמדם המקצועי של אדריכלי הגנים בתקופה זו עדיין נותר במקרים רבים בעייתי אל מול גופי תכנון אחרים, כפי שמעיד על כך אדריכל הנוף שלמה גת ב־ 1968: "לעיתים רחוקות אנו מוצאים שיתוף פעולה מלא ובמיוחד שילוב מתכנני הנוף בפיתוח אזורים חדשים [...] אם כבר משתפים אדריכלי נוף בתכנון, הרי עושים זאת לאחר מעשה, לאחר שכבר נקבעו עובדות מוגמרות, בלי שתהיה לאדריכל כל השפעה עליהם״ (גת 1968, 528).', 'dspan': (0, 401), 'tokens': [{'id': 1, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'dspan': (0, 2), 'span': (0, 2), 'lemma': 'על'}, {'id': 2, 'text': 'אף', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 1, 'deprel': 'fixed', 'dspan': (3, 5), 'span': (3, 5), 'lemma': 'אף'}, {'id': 3, 'text': 'חשיבות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 22, 'deprel': 'obl', 'dspan': (6, 12), 'span': (6, 12), 'lemma': 'חשיבות'}, {'id': (4, 5), 'text': 'הטיפול', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'טיפול', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'compound:smixut', 'lemma': 'טיפול'}], 'span': (13, 19), 'dspan': (13, 19)}, {'id': (6, 7), 'text': 'בנוף', 'expanded': [{'id': 6, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'ב'}, {'id': 7, 'text': 'נוף', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'nmod', 'lemma': 'נוף'}], 'span': (20, 24), 'dspan': (20, 24)}, {'id': 8, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 22, 'deprel': 'punct', 'dspan': (24, 25), 'span': (24, 25), 'lemma': ','}, {'id': (9, 11), 'text': 'מעמדם', 'expanded': [{'id': 9, 'text': 'מעמד_', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Def|Gender=Masc|Number=Sing', 'head': 22, 'deprel': 'nsubj', 'lemma': 'מעמד'}, {'id': 10, 'text': '_של_', 'upos': 'ADP', 'xpos': 'ADP'