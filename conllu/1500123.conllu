# text = מדיניות מחלקת הנטיעות, אשר תאמה את מדיניות העירייה, הייתה מעין "חומה ומגדל׳ ירוקה: "קרוון ידע ששטחים שיישארו פתוחים רק "על הנייר", יהפכו בשטח למגרשי גרוטאות ולמטרד עירוני, שיהפוך בסופו של דבר לשטח פרטי ובנוי [...] הוא הרבה לטעת עצים במגרשים פנויים [...] הנטיעות הללו קבעו עובדות ירוקות בשטח״ (ברניר ומוריה 2003, 27).
# raw = {'id': 4, 'text': 'מדיניות מחלקת הנטיעות, אשר תאמה את מדיניות העירייה, הייתה מעין "חומה ומגדל׳ ירוקה: "קרוון ידע ששטחים שיישארו פתוחים רק "על הנייר", יהפכו בשטח למגרשי גרוטאות ולמטרד עירוני, שיהפוך בסופו של דבר לשטח פרטי ובנוי [...] הוא הרבה לטעת עצים במגרשים פנויים [...] הנטיעות הללו קבעו עובדות ירוקות בשטח״ (ברניר ומוריה 2003, 27).', 'dspan': (417, 733), 'tokens': [{'id': 1, 'text': 'מדיניות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 16, 'deprel': 'nsubj', 'dspan': (417, 424), 'span': (0, 7), 'lemma': 'מדיניות'}, {'id': 2, 'text': 'מחלקת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'compound', 'dspan': (425, 430), 'span': (8, 13), 'lemma': 'מחלקה'}, {'id': (3, 4), 'text': 'הנטיעות', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'נטיעות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 2, 'deprel': 'compound', 'lemma': 'נטיעות'}], 'span': (14, 21), 'dspan': (431, 438)}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 7, 'deprel': 'punct', 'dspan': (438, 439), 'span': (21, 22), 'lemma': ','}, {'id': 6, 'text': 'אשר', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 7, 'deprel': 'mark', 'dspan': (440, 443), 'span': (23, 26), 'lemma': 'אשר'}, {'id': 7, 'text': 'תאמה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PIEL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 1, 'deprel': 'acl:relcl', 'dspan': (444, 448), 'span': (27, 31), 'lemma': 'תאמה'}, {'id': 8, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'dspan': (449, 451), 'span': (32, 34), 'lemma': 'את'}, {'id': 9, 'text': 'מדיניות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'obj', 'dspan': (452, 459), 'span': (35, 42), 'lemma': 'מדיניות'}, {'id'