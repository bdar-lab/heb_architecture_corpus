# file = txt/1500123.txt
# filelineno = 240
# sentno = 3
# text = סימונם של בתי הקברות בחורבות, שטחי הפקר עירוניים, חיזקו אמנם את ההקשר בין שטחים אלו לבין פוטנציאלי השימוש בהם, אולם בחלק גדול מהמקרים שטחם יקר הערך לא יכול היה לשמש לבנייה, וגם הפיתרון ה״טבעי" של הפיכתם לגן עירוני על ידי תכנון מוסדר ורשמי עורר מחלוקות וקשיים כפי שיודגם בהמשך.
