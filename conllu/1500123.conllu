# file = txt/1500123.txt
# filelineno = 399
# sentno = 3
# text = 259 כך גם מדבריו של טדי קולק, מנהל משרד ראש הממשלה דאז: "הבינותי כי סוכם על דעת היועץ לענייני ערבים, חברת התיירות ומשרד האוצר כי במסגרת הטיפול ברכישת הבעלות על בית הקברות הנ״ל רצוי בשלב ראשון לקבל את אישור הרשויות הדתיות המוסלמיות ולבצע את ריכוז הקברים הפזורים על פני השטח במקום אחד בשטח שלא יעלה על שני דונם [...] כמו כן, סוכם כי לאחר ריכוז הקברים יוחל בעבודות הנטיעה ופתיחת שבילים ודרכים בשטח בית הקברות בהתאם לתכנית הגן של העירייה".
