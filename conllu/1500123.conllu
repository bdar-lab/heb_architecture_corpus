# file = txt/1500123.txt
# filelineno = 458
# sentno = 3
# text = הניסיונות הרבים לפיתוח ממילא כמו גם היעדרם בעבד אל־נאבי, מעידים על כך שבית הקברות הינו תמיד שלוחה של העיר החיה: ממילא בירושלים היה סמוך למרקמי מגורים מוסלמיים ונתון להשפעתה של המועצה המוסלמית העליונה, ומכאן הניסיונות הרבים לפתחו; עבד אל־נאבי לעומתו היה כבר בשלב זה מובלעת שקשה יותר היה לדמיין את פיתוחה על ידי מוסלמים, אשר העדיפו להקפיא את השטח מאשר לראותו מפותח כחלק ממרקם העיר היהודית.
