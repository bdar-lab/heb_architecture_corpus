# file = txt/1500123.txt
# filelineno = 80
# sentno = 2
# text = אחד ההישגים המשמעותיים של האימפריה הבריטית היה סקירה ומיפוי דקדקני של שטחי הקולוניות שברשותה, עניין שהיה מהותי הן כאמצעי של שליטה וניהול שטחים, והן כסמל וביטוי מוחשי להגמוניה האימפריאלית (2002 Brayshay and Cleary).
