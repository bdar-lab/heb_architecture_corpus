# file = txt/1500123.txt
# filelineno = 266
# sentno = 6
# text = גם כאן רע מצבן של רוב המצבות [...] מספר המצבות ההרוסות גדול ביותר ונראה כי חלק ממעשה ההרס עודנו נמשך [...] יש לציין כי הרס זה בחלקו נעשה גם לפנים - ומידי פעם חזרו והשתמשו במצבות עתיקות - צלבניות או מוסלמיות - להתקנת קבר חדש [...] אך ברור כי הרס רב נעשה בעת חפירת תעלות הביוב באביב [...] ובמידה פחותה - על ידי חפירת תעלות הניקוז".
