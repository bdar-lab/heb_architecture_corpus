# file = txt/1500123.txt
# filelineno = 388
# sentno = 8
# text = לדברי קרוון גם צירופי הצמחייה ונוף המסלעות הבנוי מסייעים לתווך בין קנה המידה הציבורי של הגן לתחושת האינטימיות של המבקר בו, ומאפשרים מבט כללי וקרוב בו זמנית: "צירופי הצמחייה, אפילו הם "צירופים אינטימיים" במקרים רבים, אינם עומדים בסתירה לפרופורציות הגדולות של הגן״ (אצל עומר 2003 [1955], 232) (איור 80).
