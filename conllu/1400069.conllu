# text = יתירה מזאת, מחקרים מראים כי המוטיבציה לקבל החלטות הנוגעות לתכנון או תפעול הבית נובעת יותר משיקולים אסתטיים ותרבות של ניהול משק בית מאשר משיקולים כלכליים רציונליים הקשורים לחיסכון באנרגיה, אפילו כאשר התועלת הכלכלית מתממשת תוך זמן קצר (2014 ,Gram-Hanssen).
# raw = {'id': 9, 'text': 'יתירה מזאת, מחקרים מראים כי המוטיבציה לקבל החלטות הנוגעות לתכנון או תפעול הבית נובעת יותר משיקולים אסתטיים ותרבות של ניהול משק בית מאשר משיקולים כלכליים רציונליים הקשורים לחיסכון באנרגיה, אפילו כאשר התועלת הכלכלית מתממשת תוך זמן קצר (2014 ,Gram-Hanssen).', 'dspan': (1171, 1425), 'tokens': [{'id': 1, 'text': 'יתירה', 'upos': 'ADJ', 'xpos': 'ADJ', 'head': 6, 'deprel': 'advmod', 'dspan': (1171, 1176), 'span': (0, 5), 'lemma': 'יתירה'}, {'id': (2, 3), 'text': 'מזאת', 'expanded': [{'id': 2, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'lemma': 'מ'}, {'id': 3, 'text': 'זאת', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Dem', 'head': 1, 'deprel': 'obl', 'lemma': 'זה'}], 'span': (6, 10), 'dspan': (1177, 1181)}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (1181, 1182), 'span': (10, 11), 'lemma': ','}, {'id': 5, 'text': 'מחקרים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 6, 'deprel': 'nsubj', 'dspan': (1183, 1189), 'span': (12, 18), 'lemma': 'מחקר'}, {'id': 6, 'text': 'מראים', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HIFIL|Number=Plur|Person=3|Tense=Pres|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (1190, 1195), 'span': (19, 24), 'lemma': 'הראה'}, {'id': 7, 'text': 'כי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 20, 'deprel': 'mark', 'dspan': (1196, 1198), 'span': (25, 27), 'lemma': 'כי'}, {'id': (8, 9), 'text': 'המוטיבציה', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'מוטיבציה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 20, 'deprel': 'nsubj', 'lemma': 'מוטיבציה'}], 'span': (28, 37), 'dspan': (1199, 1208)}, {'id': 10, 'text': 'לקבל', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PIEL|VerbForm=Inf|Voice=