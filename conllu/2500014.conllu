# file = txt/2500014.txt
# filelineno = 800
# sentno = 1
# text = (ז)	הוועדה מדגישה שמסקנותיה מבוססות על טיפוסים מסויימים של בתים ועל הנחות בדבר משך תקופת החימום ושעות החימום, כיוון שהנתונים עליהם התבססה ההשוואה משתנים לפי הרגלי המגורים והעבודה של המשפחה, תיכנון המיבנים וכו" ועל כן רצוי להשתמש במסקנות הוועדה כהנחיות ולבדוק באמצעות מומחים בכל מקרה מה היא השיטה המתאימה, הן מבחינת הכנסתה למיבנה חדש או קיים והן מבחינת
