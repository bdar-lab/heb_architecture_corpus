# file = txt/2500014.txt
# filelineno = 544
# sentno = 2
# text = לסקר זה מצורפות המלצות כאלו, אולם מתבקש הצורך לבסס המלצות אלו על נורמות בדוקות והכנת נורמות כאלו דורשת מחקר יסודי נוסף המבוסס על נורמות קיימות של ארצות אחרות ועל בדיקות ונסיונות בארץ בתנאי אקלים שלנו* לסקר זה מצורפת הצעה מוקדמת של נורמות לפי דוגמת הנורמות בכמה ארצות אירופה (ראה עם" ג-8), אולם הצעה מוקדמת זו מהווה רק תדריך לעיבוד יסודי, טכני וכלכלי של נורמות ודורשת שיתוף פעולה של מדענים ומומחים מקצועיים.
