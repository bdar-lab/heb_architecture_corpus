# file = txt/2500014.txt
# filelineno = 441
# sentno = 1
# text = קיים מספר רב של חומרי בידוד ושיטות בנייה שונות לקירות, תקרות, גגות, חלונות ודלתות ויש נסיון רב בקשר להשפעת השמש, הרוח, רטיבות מכל סרג ואמצעי ההגנה הדרושים" אולם חייבים לבדוק כל זאת ולהתאים לתנאים המיוחדים שלנו♦ בגייה טובה של דירות מגורים ובתי-ספר, היגה תפקיד חשוב ומכובד, אולם היא מהורה מעמסה כלכלית גדולה ומסרם כך חשוב שכל ההמלצות לשיפור תנאי הבידוד של המיבנים תהיינה מבוססות על העקרון הכלכלי♦ אין כל קושי להמליץ על קירות, תקרות, גגות וחלונות טובים ויקרים רכמו-כן אין קושי להמליץ על שיטות חימום וקירור יעילות ויקרות♦ אולם מטרת סקר זה להמליץ על שיפור שיטות, כך שיהיו יעילות וזולות ושניתן יהיה ליישמם בבניית שיכון בעל אופי סוציאלי עממי, ובבנייני ציברר כמו בתי-ספר, גני-ילדים, מרפאות וכד'.
