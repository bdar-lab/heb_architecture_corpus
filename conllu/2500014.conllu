# file = txt/2500014.txt
# filelineno = 793
# sentno = 1
# text = (א)	טבלת ההשוואה של ההבקעה החד-פעמית, ההוצאות הקבועות וההוצאות השוטפות, נותנת תמונה ברורה ומאפשרת בחירת שיטת החימום הכלכלית ביותר בסוגי מיבנים שונים (מיבני מגורים, בתי-ספר ומיבנים קיימים) באזורים שונים, הן לפי השיטות המקובלות כיום והן לפי השיטות המשופרות בהתאם להמלצות הוועדה.
