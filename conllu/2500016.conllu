# file = txt/2500016.txt
# filelineno = 123
# sentno = 1
# text = מתוך הטבלה הנ״ל למדים שהמקום החשוף ביותר לחדירת הרטיבות היתה "הבליטה” וסביבה החלון: בכל הדירות שנסקרו נתגלתה רטיבות בתוך הבליטה, ו ב—90% מכלל הדירות נמצאה רטיבות בסביבת החלון» שכיחות הופעת הרטיבות השניה בדרגתה נתגלתה בתפרים החצוניים ובמיוחד בתפרים הו רם י קל י י ם • החי צ ו נ י י ם (31%) • בתפרים הוריזונטליים חצוניים חדרה הרטיבות ב-9% 1 מכל הדירות שנסקרו.
