# raw = {'id': 3, 'text': 'בשנות שיא העלייה 1990 ו־ 1991, מאזן ההגירה הפנימית נטו של האוכלוסייה היהודית במחוז היה חיובי בהיקף של 10,300 נפש, מתוכם 9,400 עולים שהגיעו לארץ בגל העלייה (מאז 1990), ואשר השתקעו לראשונה מחוץ למחוז והיגרו למחוז בשנים אלה.', 'dspan': (173, 394), 'tokens': [{'id': (1, 2), 'text': 'בשנות', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'שנות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 25, 'deprel': 'obl', 'lemma': 'שנה'}], 'span': (0, 5), 'dspan': (173, 178)}, {'id': 3, 'text': 'שיא', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'compound:smixut', 'dspan': (179, 182), 'span': (6, 9), 'lemma': 'שיא'}, {'id': (4, 5), 'text': 'העלייה', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'עלייה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'compound:smixut', 'lemma': 'עלייה'}], 'span': (10, 16), 'dspan': (183, 189)}, {'id': 6, 'text': '1990', 'upos': 'NUM', 'xpos': 'NUM', 'head': 3, 'deprel': 'appos', 'dspan': (190, 194), 'span': (17, 21), 'lemma': '1990'}, {'id': 7, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 9, 'deprel': 'cc', 'dspan': (195, 196), 'span': (22, 23), 'lemma': 'ו'}, {'id': 8, 'text': '־', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 7, 'deprel': 'punct', 'dspan': (196, 197), 'span': (23, 24), 'lemma': '־'}, {'id': 9, 'text': '1991', 'upos': 'NUM', 'xpos': 'NUM', 'head': 6, 'deprel': 'conj', 'dspan': (198, 202), 'span': (25, 29), 'lemma': '1991'}, {'id': 10, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 25, 'deprel': 'punct', 'dspan': (202, 203), 'span': (29, 30), 'lemma': ','}, {'id': 11, 'text': 'מאזן', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head