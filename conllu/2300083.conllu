# file = txt/2300083.txt
# filelineno = 243
# sentno = 1
# text = לפי מאזן יחידות הדיור ואומדן הצרכים בהשוואה להיצע יח״ד שנערכו בת.מ.א/ 31, ובהתאמה לתחזית האוכלוסייה שנערכה לקראת שנת 1995 (תחזית שלא התממשה, כפי שהוסבר לעיל, משום שגודל האוכלוסייה בפועל הינו נמוך מהחזוי), נקבע כי נכון לשנת 1995 צפוי להיווצר בקריית שמונה "עודף תכנוני" של כ-1,600 יח״ד, וכי אין צורך בבנייה נוספת בכל טווח התכנון.
