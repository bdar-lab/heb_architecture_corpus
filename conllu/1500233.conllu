# file = txt/1500233.txt
# filelineno = 27
# sentno = 4
# text = זאת, אף על פי שפוליטיקאים בכירים העומדים בראש הערים הללו זנחו את השאיפה לקדם את האקלים הרב תרבותי בעיר, מתוך הנחה כי הטרוגניות בהכרח מובילה לקונפליקטים בין קבוצות תושבים בעיר (Fincher, Iveson, Leitner, & Preston, 2014).
