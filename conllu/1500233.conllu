# file = txt/1500233.txt
# filelineno = 489
# sentno = 4
# text = בכוחן של מערכות התכנון והניהול העירוניות לפתח את הגמישות הדרושה על מנת לכלול את מבקשי המקלט אזרחי העיר בתכניות העירוניות ובסדר היום העירוני, דבר שיתרום לא רק למבקשי המקלט, אלא גם לשכניהם, למעסיקיהם, ולכל מי שמשתמש במרחב הציבורי בשכונת הדר.
