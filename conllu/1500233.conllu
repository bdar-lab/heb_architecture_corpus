# file = txt/1500233.txt
# filelineno = 50
# sentno = 7
# text = משוואה זו הייתה בגדר טיפוס אידיאלי שמעולם לא מומש במלואו, זאת משום שבתוך גבולותיה הטריטוריאליים של כל מדינת לאום חיים גם מי שאינם חלק מקבוצת הלאום הדומיננטית, בין אם מדובר באזרחים מקבוצות מיעוט, או בתושבים שאינם אזרחי המדינה- כמו למשל מהגרי עבודה, מבקשי מקלט ופליטים.
