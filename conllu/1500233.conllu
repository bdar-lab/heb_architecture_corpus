# file = txt/1500233.txt
# filelineno = 199
# sentno = 1
# text = Fenster & Yacobi, מתארים תהליך תכנוני לגיבוש תכנית אסטרטגית לאזור התחנה המרכזית בעיר, במסגרתו ביקשה העירייה להכליל ולקחת בחשבון את המהגרים החיים באזור זה בעת עיצוב וקידום התכנית, ניסיון המעיד על הייחודיות בגישה שאימצה העיר כלפי תושביה המהגרים (2005 ,Fenster & Yacobi).
