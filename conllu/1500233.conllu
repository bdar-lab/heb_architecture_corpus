# file = txt/1500233.txt
# filelineno = 341
# sentno = 1
# text = בעוד שרשות האוכלוסין וההגירה דיווחה בתום הרבעון השני של שנת 2017 בדו״ח "נתוני זרים בישראל" על 38,540 מבקשי מקלט, הנתונים שהציגה בדיון מתייחסים רק ל-29,500 מהם (כולל דיווח על 5000 מבקשי מקלט שאין נתונים לגביהם), כלומר שאלפים מבין מבקשי המקלט אינם נמצאים כלל במאגר הנתונים של הרשות האמונה על הטיפול הבירוקרטי בהם.
