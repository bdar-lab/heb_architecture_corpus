# file = txt/1500164.txt
# filelineno = 74
# sentno = 1
# text = תיאוריה זו חשובה ומרכזית לדיוננו, מכיוון שהיא ממפה ומנכיחה תחום ממש■ ופיזי שנמצא בין האדם לבין המרחב, היא הופכת את היחסים בין האדם לסביבתו ליחסים ממשיים, פיזיים ונחקרים, שדה של פוטנציאל שבסיסו הוא פיזי אובייקטיבי ולא רק סובייקטיבי■ יחסים אלו שיש להם גם השלכות רגשיות, נפשיות ורעיוניות, מתקיימים בקשר הדוק לעולם הפיזי של הגוף והמקום, ומה שמתקיים בקשרי הגומלין ביניהם.
