# file = txt/1800002.txt
# filelineno = 70
# sentno = 1
# text = יש לציין כי אף שמספר המשכורות הנדרשות לרכישת דירה עלה משמעותית בשנים האחרונות, הרי שהסיבה העיקרית לעלייה זו היא העובדה שהשכר הריאלי עלה בכ-7% בלבד מאז ראשית 2005, זאת בהשוואה לתמ"ג שעלה בכ-36%, ומחירי הדירות בכ-34% ריאלית, באותה תקופה.
