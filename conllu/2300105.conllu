# file = txt/2300105.txt
# filelineno = 538
# sentno = 5
# text = הן ההשוואה למתחם הסמוך והן ההשוואה הרב-שנתית (לפני ואחרי שנות ה-2000) מלמדות כי מתחם הניסוי הוא זה שמציג אנומליה, שכן הגינטריפיקציה בו, ככל שהתקיימה, לא הלכה ונמשכה עם חידוש פני המתחם ועם הריסת המבנים, אלא נעצרה במידה רבה עם אישור התכנית ויהתמצקות' הציפייה לרווח כתוצאה ממימושה.
