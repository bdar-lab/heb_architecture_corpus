# file = txt/2800049.txt
# filelineno = 772
# sentno = 1
# text = מעניין לציין שבקבוצת הנחקרים שלא נכללה באינדקס, מהסיבות שצויינו לעיל, גבוה שיעור הבאים אל דימונה במסגרת הגירה פנימית דווקא בשנים האחרונות־ משיחה עם ראשי הארגונים הוולונסאריים במקום מתברר שוב, שההשתתפות בארגונים אלו היא נחלתם של קבוצה מוגדרת, שאנשיה הינם נושאי משרות גבוהות, יחסית, במועצה, ב"עמידד", במועצת הפועלים ובמפעלים־ אנשי קבוצה זו פעילים בדדך כלל כמספד ארגונים וולונטאדיים.
