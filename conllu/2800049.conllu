# text = סכין הארגונים הפעילים בדימונה יש למנות את האגודה למען העיוור, שחבריה הקבועים הם עשרה במספרם; איל״ן שבמבצעיה משתתפים 13 חברי הנהלתו וחברים מתנדבים מתושבי דימונה; אק"ים, "הועד למען החייל", ויצ״ו, ארגונים אלה כוללים מספר מצומצם של חברים קבועים, אך עם זאת הם נעזרים במבצעיה השונים (כגון מבצע "הקש בדלת", מבצע משלוח חבילות לחיילים וכד') כמתנדבים מאוכלוסיית דימונה ובעיקר בתלמידים.
# raw = {'id': 2, 'text': 'סכין הארגונים הפעילים בדימונה יש למנות את האגודה למען העיוור, שחבריה הקבועים הם עשרה במספרם; איל״ן שבמבצעיה משתתפים 13 חברי הנהלתו וחברים מתנדבים מתושבי דימונה; אק"ים, "הועד למען החייל", ויצ״ו, ארגונים אלה כוללים מספר מצומצם של חברים קבועים, אך עם זאת הם נעזרים במבצעיה השונים (כגון מבצע "הקש בדלת", מבצע משלוח חבילות לחיילים וכד\') כמתנדבים מאוכלוסיית דימונה ובעיקר בתלמידים.', 'dspan': (207, 582), 'tokens': [{'id': 1, 'text': 'סכין', 'upos': 'X', 'xpos': 'X', 'head': 8, 'deprel': 'dep', 'dspan': (207, 211), 'span': (0, 4), 'lemma': 'סכין'}, {'id': (2, 3), 'text': 'הארגונים', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'ארגונים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'compound:smixut', 'lemma': 'ארגון'}], 'span': (5, 13), 'dspan': (212, 220)}, {'id': (4, 5), 'text': 'הפעילים', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'פעילים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 3, 'deprel': 'amod', 'lemma': 'פעיל'}], 'span': (14, 21), 'dspan': (221, 228)}, {'id': (6, 7), 'text': 'בדימונה', 'expanded': [{'id': 6, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'ב'}, {'id': 7, 'text': 'דימונה', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'nmod', 'lemma': 'דימונה'}], 'span': (22, 29), 'dspan': (229, 236)}, {'id': 8, 'text': 'יש', 'upos': 'ADV', 'xpos': 'ADV', 'head': 0, 'deprel': 'root', 'dspan': (237, 239), 'span': (30, 32), 'lemma': 'יש'}, {'id': 9, 'text': 'למנות', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'VerbForm=Inf', 'head': 8, 'deprel': 'xcomp', 'dspan': (240, 245), 'span': (33, 38), 'lemma': 'למנות'}, {'id': 10, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 12, 'deprel': 'case:ac