# file = txt/2800049.txt
# filelineno = 198
# sentno = 1
# text = בתוכניות אחרות שגעשו בתקופה מאוחרת יותר, כגון תוכנית משרד הפנים - "תוכנית ארבעה המיליון", נקבע בתחזית שאוכלוסיית רימונה תניע בשנת 1981 ל-30 אלף נפשות; בתוכנית שניה של משרד הפנים נאסר בתחזית כי האובלוסיה של דימונה בשנת 1970 תהיה 20 אלף תושבים, ובתובניתה של "ועדח-כוכב" ירדה תחזית אוכלוסיית דימונה עוד יותר ועמדה על 18,400 נפש ב־1970 (המקור: משרד הפנים - המחלקה למחקר מוניציפלי).
