# file = txt/1800203.txt
# filelineno = 166
# sentno = 2
# text = בלוח 4.2 להלן מפורטות התועלות שיוחסו לשיפור בהליכה וברכיבה על אופניים, המבוססות על הערכים המומלצים מתוך מחקר עדכני של ליטמן1(2017 ,Litman), המרכז מחקרים רבים מהשנים האחרונות בארה"ב, בקנדה, באירופה ובאוסטרליה על אודות מרכיבי וערכי התועלות של תנועה מקיימת ושל תכנון אורבני התומך בתנועה מקיימת (ראו גם נספח 1).
