# file = txt/1800203.txt
# filelineno = 352
# sentno = 2
# text = אם בעקבות פרויקט יעלה הצורך בביצוע שינוי מיוחד למערכת התחבורה כדי לשמור על תנאי זרימה סבירים אחרי הקמתו (לדוגמה, צורך בהרחבה של צומת או מחלף), הרי שהבה"ת מאפשר לקבוע מתי יבוצעו שיפורים אלה ועל-ידי מי, באיזו מידה השיפורים מהווים התניה למימוש הפרויקט (או שנדרש לקבוע שלביות), והאם העלויות הכרוכות בביצוע השיפורים חלות על יזם הפרויקט (impact fee).
