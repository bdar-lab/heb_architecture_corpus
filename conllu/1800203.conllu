# file = txt/1800203.txt
# filelineno = 31
# sentno = 1
# text = ברמת התכנון הפיזי, היערכות לתנועה מקיימת מחייבת לפיכך עבודה ברבדים שונים: הקמת רשתות תחבורה באמצעים מקיימים לתנועה בעיר ולתנועה בין-עירונית (רשת עם העדפה להליכה, רשת שבילי אופניים, קווי תחבורה ציבורית, מערכת הסעת המונים, רכבת – בהתאם לגודל האזור העירוני), ומצד שני יצירת דפוסים אורבניים המתאימים לשימוש באמצעים מקיימים לנסיעות הקצרות יותר והבטחת הנגישות הדרושה לאמצעים אחרים כגון רכבת.
