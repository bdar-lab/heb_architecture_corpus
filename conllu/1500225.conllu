# sentno = 1
# text = כפי שהסברתי קודם, אחת מטענותיו המרכזיות של מחקר זה היא: מאחר והתופעות של הגלובליזציה והנאו-ליברליזם הן חדשות יחסית, דינאמיות ללא הפסקה, מתרחשות עד עצם כתיבת עבודה זו והספרות מלמדת שכמעט ולא בוצעו מחקרים דוגמת מחקר זה, מצאתי כי השיטות והמדדים הכמותיים הנמצאים היום בשימוש חסרים ואינם מספיק מתאימים להסבר המהפכים המאפיינים את המרחבים המטרופוליטניים והעירוניים הפיזיים והחברתיים־כלכליים, הנובעים ישירות מהשפעותיהם המגוונות, המורכבות והמשולבות של תהליכי "הגלובליזציה" ומדיניות "הנאו-ליברליזם".
