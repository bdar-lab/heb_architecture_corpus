# file = txt/1500225.txt
# filelineno = 585
# sentno = 1
# text = לנא, נור ומיק שלוש מתכננות צעירות במחלקה לתכנון כוללני בעיריית עמאן, בגילאים 33, 29 ו־27 בהתאמה, שראיינתי את שלושתם ביחד במחלקתן, מסכימות ביניהן עם הטיעון שהגלובליזציה היא בבחינת מערכה מתמדת של מאבקי כוח בקנה מידה עולמי והשתלטות הטכנולוגיה על חיי היומיום שלנו, וכי כול מי שלא מתקשר ברובד העולמי ולא הופך לחלק מרובד זה אין לו סיכוי לשרוד בתחרותיות המתחייבת מהקדמה הטכנולוגית.
