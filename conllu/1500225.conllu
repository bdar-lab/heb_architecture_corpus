# file = txt/1500225.txt
# filelineno = 18
# sentno = 3
# text = סקירת הספרות מלמדת, שההשפעות, הכלכליות במיוחד, של הגלובליזציה וה״נאו-ליברליזם" נידונים בהרחבה בספרות הרב-תחומית בכלל ובספרות האורבאנית במיוחד, אך הדיון והמחקר בנושא חסר בחינות אמפיריות להשפעותיהם המשולבות על פיתוח המרחב העירוני הפיזי, במיוחד של שימושי הקרקע מצד אחד, כמו כן חסרה התייחסות אמפירית להשפעותיהם המשולבות יחד על תחושות השייכות והפרקטיקות היומיומיות של דיירי ערים אלה מצד שני.
