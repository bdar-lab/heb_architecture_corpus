# file = txt/1500225.txt
# filelineno = 686
# sentno = 1
# text = בנוסף לחלוקה הדיכוטומית הכול כך ברורה בין מזרח העיר למערבה, עמאן נתונה היום להשפעותיהם של תהליכי הגלובליזציה (Globalization) והנאו־ליברליזם (Neo-liberalism) המוסיפים לחלוקה המרחבית ממדים חדשים נוספים המשנים ומבנים מחדש (restructuring) את מרחביה העירוניים והמטרופוליטניים, הן הפיזיים והן החברתיים־תרבותיים.
