# file = txt/1500225.txt
# filelineno = 113
# sentno = 2
# text = ובמובן של ההתחברויות והתלות ההדדית הבינלאומיות (worldwide interconnections and interdependencies), גלובליזציה מיוחסת לתהליכים בהם יותר ויותר אנשים מסביב לעולם ובמרחקים גדולים מאד הופכים למחוברים בדרכים רבות ושונות (2012 ,Lechner & Boli), מכילה תהליכים תאומים: התהליך הפיזי, של הקישוריות או הדחיסה, שהמשמעות שלו היא שהעולם הופך לקטן יותר ובוזמנית שהמודעות שלנו כיחידים לכך שהיחסים שלנו עם העולם הם בבחינתו כמקום אחד, כך שאירוע כלשהו המתרחש לו לא משנה באיזה נקודה בעולם יכול להשפיע עלינו, במובנים שונים, ובאותה מידה הסוגיות הלאומיות, במובנים שונים, יכולות להיות גם בינלאומיות (Robertson et al., 2011; Nester, 2010).
# raw = {'id': 2, 'text': 'ובמובן של ההתחברויות והתלות ההדדית הבינלאומיות (worldwide interconnections and interdependencies), גלובליזציה מיוחסת לתהליכים בהם יותר ויותר אנשים מסביב לעולם ובמרחקים גדולים מאד הופכים למחוברים בדרכים רבות ושונות (2012 ,Lechner & Boli), מכילה תהליכים תאומים: התהליך הפיזי, של הקישוריות או הדחיסה, שהמשמעות שלו היא שהעולם הופך לקטן יותר ובוזמנית שהמודעות שלנו כיחידים לכך שהיחסים שלנו עם העולם הם בבחינתו כמקום אחד, כך שאירוע כלשהו המתרחש לו לא משנה באיזה נקודה בעולם יכול להשפיע עלינו, במובנים שונים, ובאותה מידה הסוגיות הלאומיות, במובנים שונים, יכולות להיות גם בינלאומיות (Robertson et al., 2011; Nester, 2010).', 'dspan': (197, 810), 'tokens': [{'id': (1, 4), 'text': 'ובמובן', 'expanded': [{'id': 1, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 58, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 2, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ב'}, {'id': 3, 'text': 'ה_', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'מובן', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 58, 'deprel': 'obl', 'lemma': 'מובן'}], 'span': (0, 6), 'dspan': (197, 203)}, {'id': 5, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 7, 'deprel': 'case:gen', 'dspan': (204, 206), 'span': (7, 9), 'lemma': 'של'}, {'id': (6, 7), 'text': 'ההתחברויות', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'התחברויות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 4, 'deprel': 'nmod:poss', 'lemma': 'התחברויות'}], 'span': (10, 20), 'dspan': (207, 217)}, {'id': (8, 9), 'text': 'והתלות', 'expanded': [{'id': 8, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 9, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 9, 'text': 'התלות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'd