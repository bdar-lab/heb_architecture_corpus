# file = txt/1500225.txt
# filelineno = 676
# sentno = 5
# text = בד בבד, בשנת 1979, נבחרת מרגריט ת׳אטצ׳ר (Thatcher) לראשות הממשלה בבריטניה, שגם היא מקבלת סדרה של החלטות מרחיקות לכת כדי להילחם בקיפאון האינפלציוני ומצהירה את אחת ההצהרות החשובות בתולדות בריטניה המשנה את יחסי הכוחות בין המגזרים בה, זוכה לתמיכה רחבה בקרב בוחריה באומרה ש״אין אלטרנטיבה" חוץ מאשר לרסן את כוחם של האיגודים המקצועיים וכי יש לפתוח את השווקים למגזר הפרטי.
