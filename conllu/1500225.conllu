# file = txt/1500225.txt
# filelineno = 290
# sentno = 3
# text = הרוב המכריע של אוכלוסייתה היום הם ערבים מוסלמים, משחקת תפקיד מדיני-פוליטי קריטי באזור ונתונה לאחרונה להשפעותיהם החזקות ביותר של תהליכי הגלובליזציה והנאו-ליברליזם המתבטאים בה בצורה בולטת ביותר, דוחפים אותה להתפתחות אינטנסיבית וגרנדיוזית, מאמצת דפוסי חשיבה ופיתוח מערביים נאו־ ליבראליים, תוך הפגנת רצון עז ונחישות איתנה של המלך עבדאללה ומקבלי ההחלטות בעיר לעצב לעמאן חזון מודרני ההופך אותה תוך 20 שנים לעיר גלובאלית ממשית, אך בוזמנית יודעת גם לעשות איזון ולשמור על צביון העיר הערבית המזרח תיכונית ועל ערכים מסורתיים שיש לשמור עליהם.
