# file = txt/1500225.txt
# filelineno = 279
# sentno = 1
# text = השיקול לבחירת שנת 2006 כנקודת ההתחלה של הבדיקות שלי נובע מכך שהיא נחשבת לנקודת המפנה בכול הקשור לתכנון ולפיתוח העיר עמאן עת שהפנטזיה של המלך עבדאללה הפכה לחזון שעל בסיסו הנחה את ראש העיר עמאן להכין תוכנית כוללנית לעיר עמאן ועת שנקבעו אסטרטגיות פיתוח נאו-ליברליות המאפשרות ליזמים פרטיים ולבעלי הקרקעות בעיר עמאן לשלב את כוחותיהם עם ראש העיר ומקבלי ההחלטות כדי לבנות את הפרויקטים שחוללו את המהפך בעיר.
