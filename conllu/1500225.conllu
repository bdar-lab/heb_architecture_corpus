# file = txt/1500225.txt
# filelineno = 276
# sentno = 1
# text = יחד עם זאת, איסוף הנתונים הגולמיים ויצירת מאגר המידע הקשור במאפיינים הפיזיים של מרקמי הבינוי, שימושי הקרקע, התוכניות ברמות השונות והפרויקטים המחוללים את המהפך בעיר עמאן נדלו בעיקר ממחלקת התכנון הכוללני של עיריית עמאן ומוסדות התכנון שלה, מאתרי האינטרנט הרשמיים של העירייה, ממשרדי הממשלה, מהלשכה המרכזית לסטטיסטיקה של ירדן, מהיזמים, מהארגונים האזרחיים, מעיתונאים, מסופרים ומאינפורמציה שנדלתה מתוך התשובות לשאלונים של כלל האינפורמנטים שראיינתי.
