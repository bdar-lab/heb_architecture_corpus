# file = txt/1500225.txt
# filelineno = 455
# sentno = 1
# text = תכנון ״עמאן 2025״ : נקודת מעבר אחת הוקמה לזירוז ההליכים הרגולטיביים למען המשקיעים -One Stop-Shop for Investors ; הקמת מחלקה חדשה בעיריית עמאן הגדולה כדי לנהל את העניינים והדאגות של הקהילה ושל המשקיעים ככול שזה נוגע להם בפרויקטים הגדולים, לבקר את הפרוצדורות של התכנון והעיצוב במתחמי עליהם מתוכננים הפרויקטים הגדולים כדי לשלב את המאפיינים הייחודיים של האזור עם פרויקטים אלו ושלא תהיה הפרה לאיזון האורבני וחפיפה למדיניות והיעדים של התכנית הכוללת; הוספה של שני מסים הקשורים לתשתיות ולזכויות פיתוח.
