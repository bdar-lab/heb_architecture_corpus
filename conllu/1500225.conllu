# file = txt/1500225.txt
# filelineno = 513
# sentno = 1
# text = בבעלות פרטית אשר הוקמה בשנת 2004 ומאגדת בתוכה שתי חברות: החברה הממשלתית לפיתוח נדל״ן "מוארד" השייכת לשיח׳ בהאא רפיק אלחרירי בלב העיר עמאן, על שטח של 384,000 מטרים רבועים, "עבדלי" הוא האזור הראשון בעיר עמאן המפותח בהתאם לקודים החדשים של תכנון שימושים מעורבים אשר מייצגת את הסינרגיה היוצאת דופן של שימושי הקרקע המעורבים של מגורים, מסחר, הארחה, רפואה וקמעונאות המושקעות ביותר באחת הכתובות התוססות והיוקרתיות ביותר בעיר עמאן.
