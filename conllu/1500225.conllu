# file = txt/1500225.txt
# filelineno = 612
# sentno = 1
# text = חלקם האחר של האינפורמנטים טוענים כי הפערים בין מזרח למערב העיר הם כול כך גדולים, שונים תכלית השוני במאפייני הבסיס החברתיים־כלכליים והתרבותיים שלהם ובאופנים שלא ניתן לגשר על הפערים שביניהם, וכי התוצרים של המדיניות ה״נאו-ליברלית" עכשווית לא רק שמגילדה את הפערים אלא שמנציחה קיטוב זה, מחזקת את השכונות המערביות ותושביה מחד גיסא ומדירה ומחלישה את השכונות המזרחיות ותושביה מאידך גיסא.
