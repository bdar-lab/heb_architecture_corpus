# file = txt/1500225.txt
# filelineno = 161
# sentno = 1
# text = בשנת 2008, התפרסם אינדקס הערים הגלובאליות בכתב העת האמריקאי Foreign Policy בהתבסס על חמישה מדדים: הראשון, הוא הפעילות העסקית הכולל את ערך ההון של השווקים בפעילות זו, מספרם של מרכזי החברות מתוך 500 החברות הגלובאליות הממוקמות בעיר והיקף המצרכים העוברים דרך העיר.
