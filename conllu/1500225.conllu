# file = txt/1500225.txt
# filelineno = 234
# sentno = 1
# text = •	ששה עשר אינפורמנטים מהסקטור האזרחי: שניים מעמותת המשקיעים בענף השיכון הירדני, ארבעה מרואיינים מהשכונות המזרחיות של עמאן העובדים כסדרנים ושומרים על גני המלך עבדאללה בשכונות המזרחיות, בעל בית דפוס, מהנדס חשמל ואלקטרוניקה במפעל לייצור רכיבים אלקטרוניים באזור התעשייה החדש, בעל חנות ספרים, פנסיונר סוחר לשעבר, אדריכלית חופשית, מנהל מסעדה במתחם אלעבדלי, פקיד בבנק האסלאמי, בעל בית קפה עממי בעיר תחתית של עמאן.
