# file = txt/1500225.txt
# filelineno = 460
# sentno = 1
# text = להבדיל מהגישה המסורתית של הכנת תוכניות כוללניות המפקידות את פעולות הפיתוח בידי המוסדות הממשלתיים והציבוריים מחד גיסא ובהרחק משיתוף ציבורי והעדר השפעה של הסקטור הפרטי מאידך גיסא, הגישה התכנונית החדשנית של אסטרטגיטת צמיחה של ״עמאן 2025״ לפי רמות, שלביות ביצוע, מכניזם מיוחד לשיתוף ושילוב האוכלוסייה וישום פרויקטים נקודתיים כמפורט לעיל, גישה חדשנית זו נועדה כדי להקל, לפשט ולזרז את תהליכי הפתוח הנאו-ליברלי מחד גיסא ולעזור לחלחול הפנטזיה והחזון של המלך בקרב כלל התושבים של עמאן הרואים בתהליכי הנאו-ליברליזם תהליכם מקובלים ומוצדקים על אף שהם פוגעים ברווחתם ובסביבתם מאידך גיסא.
