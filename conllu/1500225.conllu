# file = txt/1500225.txt
# filelineno = 432
# sentno = 6
# text = כול הגורמים לעיל מעריכים בפרקי זמן מדודים וקצרים מאוד יחסית את המתרחש ברמות השונות של היישום והתכנון, בוחנים את התוצרים ואת ההשלכות של העשייה הביצועית הקודמת על המרחב ועל האנשים, ובהתאם לאינטראקציה בין כלל הגורמים השונים התכנון והיישום משתדריגים בהתאם למסקנות שמגיעים אליהם, מציבים מחדש יעדי תכנון וביצוע, ממשיכים את הפרויקטים המשודרגים ו/או גוזרים פרויקטים חדשים.
