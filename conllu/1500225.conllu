# file = txt/1500225.txt
# filelineno = 294
# sentno = 1
# text = על אף שקיימות הגדרות ופרשנויות רבות למונח "עיר אסלאמית", הגדרה כוללנית ושלמה טרם הוצגה על יד אף מהחוקרים (2015 ,Shojaee & Paeezeh), תוך טענה של מרבית האדריכלים והמתכננים הערביים היום, ביניהם (רפעת אלג׳אדרגי וג׳מיל עבדלקאדר אקבר), שטוענים, שעל אף שקיימים דפוסי ערים דומות בעולם הערבי אך עדיין לא ניתן להשתמש במונח "עיר אסלאמית" לתיאור הערים בעולם האסלאמי כאל ערים שיש להם מאפיינים דומים זאת בשל העובדה שקיים ריבוי ערים במדינות אסלאמיות השונות זו מזו במאפייניהם, הן החברתיים־כלכליים־תרבותיים והן האורבאניים ארכיטקטוניים.
