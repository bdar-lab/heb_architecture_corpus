# file = txt/1500225.txt
# filelineno = 95
# sentno = 1
# text = הדואליות לעיל אף היא חלק ממאפייניה החדשים של הגלובליזציה לצד ממדים נוספים פורצי גבולות פיזיים המתבטאים בעיקר בטכנולוגיות החדישות עתירות הידע המאפשרות את הייצור ההמוני, ברשתות התקשורת העולמיות (תקשורת האינטרנט וסלולר למשל), במערכות הכלכליות המתרחבות לקנה מידה גלובלי (חברות ייצור בינלאומיות), בשירותים הפיננסיים העולמיים (הבנקים העולמיים למשל).
