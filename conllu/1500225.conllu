# file = txt/1500225.txt
# filelineno = 556
# sentno = 3
# text = המחלוקת והוויכוח הערכי הנוקב בין שני המחנות לעיל, בין המצדדים לבין המתנגדים לגלובליזציה והשלכותיה שטרם הוכרע (2006 Al-Rodhan & Stoudmann), מהווה אחד המאפיינים הבולטים של דעותיהם של האינפורמנטים שראיינתי ומבליטה את השונות של תושבי עמאן והפרדוקסליות המשקפות היום את דעותיהם השנויות במחלוקת של תושבי העיר אודות תוצריה של הגלובליזציה.
