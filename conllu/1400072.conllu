# file = txt/1400072.txt
# filelineno = 17
# sentno = 2
# text = אחד האתגרים המורכבים בפניהם ניצב המחקר היה להשוות בין בתי ספר 'ירוקים', שהתאפיינו בשונות גבוהה מאוד ביניהם בהשוואה לשונות בין בתי ספר 'רגילים', הרושם המתקבל הוא, שבשל הייחודיות והחדשנות היחסית של בתי ספר שנבנים בבניה ירוקה בישראל, לעתים קרובות, הגורמים המזמינים והמתכננים נותנים משקל יתר לשיקולים עיצוביים "לא סטנדרטיים", שתורמים לבולטות החזותית והייחודיות האדריכלית של המבנה, אך אינם תורמים בהכרח למידת הקיימות שלו.
