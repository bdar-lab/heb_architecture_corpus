# file = txt/1400072.txt
# filelineno = 33
# sentno = 4
# text = במסגרת ההחלטה1, המשרד להגנת הסביבה יקצה למועצה המקומית חריש בדרך של תמיכה במועצה, בהיקף של עד 9 מלש״ח בפריסה על פני שלוש שנים (2018-2016), לטובת בניית מוסדות חינוך באופן שיעמדו בדרישות התקן לבנייה ירוקה מסי 5281; זאת, בכפוף לתכנית עבודה שתאושר על ידי המשרד להגנת הסביבה ומשרד הבינוי והשיכון ביחס למרכיבי התקן שייושמו בכל מבנה.
