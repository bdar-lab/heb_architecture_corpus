# file = txt/2300030.txt
# filelineno = 56
# sentno = 2
# text = כמדד לרמה הסוציו-כלכלית של השכונות שימש הדרוג הדמוגרפי-חברתי-כלכלי של האזורים הסטטיסטיים בישראל ( דח"כ) שנעשה על ידי הלמ"ס (ע״פ נתוני מפקד האוכלוסין והדיור 1983) וכמדד לאיכות הסביבה באותה שכונה שמשה רמת זהום האויר בשכונה, על פי הדרוג כפי שסווג במחקרם של 1988,.
