# file = txt/2800037.txt
# filelineno = 3
# sentno = 1
# text = החוברת המוגשת בזאת סוקרת, איפוא, לא רק את מחירי הדירות בארבע הערים הגדולות בארץ, כפי שהם נרשמו במשך שנת 1973 אלא גם מנסה לערוך השוואה לאורך תקופה ארוכה יותר, שתחילתה בשנת 1971, כאשר הוחל לראשונה בפרסום סדרה זו.
