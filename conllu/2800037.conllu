# text = בדיקת נתוני לוח 2 מעוררת את השאלה לגבי המאפינים העיקריים של שוק הדיור בכל אחת ם-4 הערים הנסקרות־ השאלה העיקרית שניתן לבחון בהקשר לכך, היא מה מידת הריכוזיות בהיקף העסקות מבחינת התפלגותן המרחבית־ מתברר כי ההתפרסות הגיאוגרפית של העיסקות פחות או יותר שווה בירושלים, פרט לרובע 5 (תלפיות, ימין משה ומקור חיים), בעוד שבתל-אביב, ובמידה רבה יותר בחיפה, קימת ריכוזיות ברורה בתחום זה־ וכך למשל, ב-%52 ממספר העיסקות וכ-60% מהקיפן הכספי התרכזו ברובעי "היוקרה" של תל-אביב (רובע 3 - אזור רחוב דיזנגוף וצפונה ממנו ורובע 4 - רחוב ארלוזורוב וסביבתו הקרובה)־ בחיפה ריכוזיות זו גבוהה אף יותר: ברובע 4 הכולל שטח נרחב המשתרע על הכרמל המערבי והמרכזי, רמת שאול ועוד, התרכזו כ-40% ממספר העיסקות וכ-^50 מהיקפן הכספי־ הרובעים הדומיננטיים בשוק הדיור מצטינים, איפוא, בשתי תכונות עיקריות: הם מרכזים חלק נכבד ממספר העיסקות ומחירי הדירות בהם גבוהים יותר מאשר ביתר הרובעים־
# raw = {'id': 1, 'text': 'בדיקת נתוני לוח 2 מעוררת את השאלה לגבי המאפינים העיקריים של שוק הדיור בכל אחת ם-4 הערים הנסקרות־ השאלה העיקרית שניתן לבחון בהקשר לכך, היא מה מידת הריכוזיות בהיקף העסקות מבחינת התפלגותן המרחבית־ מתברר כי ההתפרסות הגיאוגרפית של העיסקות פחות או יותר שווה בירושלים, פרט לרובע 5 (תלפיות, ימין משה ומקור חיים), בעוד שבתל-אביב, ובמידה רבה יותר בחיפה, קימת ריכוזיות ברורה בתחום זה־ וכך למשל, ב-%52 ממספר העיסקות וכ-60% מהקיפן הכספי התרכזו ברובעי "היוקרה" של תל-אביב (רובע 3 - אזור רחוב דיזנגוף וצפונה ממנו ורובע 4 - רחוב ארלוזורוב וסביבתו הקרובה)־ בחיפה ריכוזיות זו גבוהה אף יותר: ברובע 4 הכולל שטח נרחב המשתרע על הכרמל המערבי והמרכזי, רמת שאול ועוד, התרכזו כ-40% ממספר העיסקות וכ-^50 מהיקפן הכספי־ הרובעים הדומיננטיים בשוק הדיור מצטינים, איפוא, בשתי תכונות עיקריות: הם מרכזים חלק נכבד ממספר העיסקות ומחירי הדירות בהם גבוהים יותר מאשר ביתר הרובעים־', 'dspan': (0, 840), 'tokens': [{'id': 1, 'text': 'בדיקת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'nsubj', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'בדיקה'}, {'id': 2, 'text': 'נתוני', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'compound:smixut', 'dspan': (6, 11), 'span': (6, 11), 'lemma': 'נתון'}, {'id': 3, 'text': 'לוח', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'compound:smixut', 'dspan': (12, 15), 'span': (12, 15), 'lemma': 'לוח'}, {'id': 4, 'text': '2', 'upos': 'NUM', 'xpos': 'NUM', 'head': 3, 'deprel': 'nummod', 'dspan': (16, 17), 'span': (16, 17), 'lemma': '2'}, {'id': 5, 'text': 'מעוררת', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PIEL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (18, 24), 'span': (18, 24), 'lemma': 'עורר'}, {'id': 6, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 8, 'deprel': 'case:acc', 'dspan': (25, 27), 'span': (25, 27), 'lemma': 