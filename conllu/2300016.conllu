# file = txt/2300016.txt
# filelineno = 4
# sentno = 1
# text = כל בעיה תכנונית ופתרונה כרוכים בהתיהסות לאינטרסים של אנשים; בדרך כלל גם אינטרסים נוגדים של אנשים שונים, ולעיתים קרובות ניתץ להתוות קו מפריד ברור בין הקבוצות החברתיות השונות שהנושא התכנוננ ־נוגע-לחן, וגם ניתן לציין בבירור את הצורה שבה ישפיעו פתרונות שונים על רוחתן היחסית של הקבוצות ועל האינטרסים שלהן מבחינת צורת התכנון הרצויה־ התיחסות אל הבעיה התכנונית דורשת לבן להגדיר בבירור מהם הצרכינו-של-אנשים וקבוצות-העשויים להיות .
