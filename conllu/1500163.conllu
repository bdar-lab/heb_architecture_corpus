# file = txt/1500163.txt
# filelineno = 70
# sentno = 1
# text = קיימות טכניקות רבות לשיתוף ולכל אחת יש מאפיינים שונים, לכן, על פי אלתרמן ואחרים (1996), יש לבחון היטב איזו שיטה היא המתאימה ביותר לתהליך השיתוף הרצוי, וזאת בהתאם לנושא התכנון, מטרות השיתוף וההשתתפות, יחסי כוחות, סוג הציבור, השלב בתהליך התכנון והמשאבים הדרושים (בנספח א׳ מופיע פרוט של מספר טכניקות).
