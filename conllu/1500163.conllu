# file = txt/1500163.txt
# filelineno = 56
# sentno = 3
# text = על מנת להבין את משמעות השיתוף יש להבהיר תחילה את המונחים עצמם: המושג שיתוף מתייחס לפעולה הנעשית ביוזמתו של המשתף, מלמעלה, היינו גוף שלטוני, (אלתרמן ואחרים 1996;וקסמן ובלאנדר 2002), המושג השתתפות מתייחס לפעולה הנעשית מלמטה (בניגוד לגישה מלמעלה, שהיא יוזמת גופים ממשלתיים) והיא מציינת נטילת חלק בפעילות משותפת עם אחרים (אלתרמן ואחרים 1996; צ׳רצ׳מן וסדן 2003).
