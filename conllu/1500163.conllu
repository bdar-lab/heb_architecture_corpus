# file = txt/1500163.txt
# filelineno = 626
# sentno = 3
# text = עכשיו, שתביני עכשיו עד כמה כוונת המועצה הייתה אמיתית ויסודית...כמה עמוקה הייתה המחויבות שהייתה וקיימת לרעיון, שמי שצריך לעבור את השינוי זה לא השטח, זה בני האדם", "ראש מועצה חרט את האג׳נדה של המרחב הביוספרי על דיגלו" (מ.ה) ו״המועצה, כאילו, שינתה את התפקיד שלה.
