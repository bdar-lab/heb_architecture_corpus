# file = txt/1500163.txt
# filelineno = 274
# sentno = 2
# text = מטרה זו העלתה את הצורך בקביעת מדיניות חדשה ומותאמת -ארגונית, מנהלתית ותפקודית ובהתאם לכך תכנית האב המליצה על יצירת מנגנון ניהול שתפקידו להוביל, להנחות, לקשר ולאפשרייצוג והשתתפות פעילה של כל בעלי העניין והקניין בקביעת החלטות ותוך בניית הסכמות: מתן ביטוי ומענה לאינטרסים מוגדרים במסגרת ראייה כוללת, שילוב סמכויות פורמאליות עם כוח ציבורי, ביקורת שוטפת ושקיפות של התהליך, ויצירת מנגנון בוררות ובחינה מחודשת של ההסכמות המהוות את התשתית למרחב (שם).
