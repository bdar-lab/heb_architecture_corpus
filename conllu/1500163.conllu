# file = txt/1500163.txt
# filelineno = 239
# sentno = 2
# text = עם הקמת מדינת ישראל משתנה מסגרת זו, ישובים רבים נהרסו (1992 Khalidi, אצל חמאיסי 2002), וכ-65%מאדמות הערבים מופקעות באמצעות מכניזם חוקי, הנסמך בחלקו על כך, שחלק מהאדמות לא היו רשומות בפועל (1998 Yiftachel & Segal).
