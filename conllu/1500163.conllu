# file = txt/1500163.txt
# filelineno = 788
# sentno = 3
# text = הילי (1997 Healey), מעלה את האפשרות שבמשך הזמן תעלנה פרשנויות שונות, תנאים ישתנו וייווצרו בסיסי כוח חדשים, כפי שמתקיים במקרה זה - פער בין התפיסה כפי שמשתקף בשלב הראשון של התהליך לבין התפיסה בשלבים המתקדמים שלו.
