# file = txt/1500163.txt
# filelineno = 905
# sentno = 3
# text = בדרגתה הגבוהה, משילות שואפת לניהול כלמידה הדדית -למידה הנוצרת מהאינטראקציה החברתית, היא מאפשרת למידה אחד על השני, על דרכי חשיבה ופעולה, ומאפשרת מעבר בין מערכות משמעות ותבניות ייחוס, ובכך גם את היכולת לשנות את תבנית הפעולה (& Healey 1996; Innes 2000 Booher 2004; Kumar & Paddison).
