# file = txt/1500264.txt
# filelineno = 398
# sentno = 1
# text = השחקנים הסכימו שהמשחק מאפשר אלטרנטיבה מהירה לתהליך התכנון הסדור במערכת התכנון עצמה, למשל כאשר נדרש שינוי נקודתי ביעוד הקרקע לטובת שיפור חיי האוכלוסיה, אך גם ככלי להנגשת תהליך התכנון עבור תושבים ובעלי עניין שאינם מתכנני ערים: "יש מקום לחשוב על אקטיביזם של תושבים שיש להם את הכוח לעצב את המרחב, במובן הזה שהם יכולים לתת שיקוף כאשר הסטטוטריקה אינה עובדת.
