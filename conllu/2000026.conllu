# file = txt/2000026.txt
# filelineno = 150
# sentno = 5
# text = למרות שביו 1983 ו־1989 התגלו משתנים שונים כבעלי השפעה על החלטות של אינדבידואלים לגבי בחירה עצמית של יזמות, הדיון הבא מנסה להרחיב את ההשלכות של כל משתנה שזוהה על המדיניות, וכן לענות כיצד מעצבי המדיניות יכולים לשלב את הגורמים הללו בקוי המדיניות המיועדים לקדם את פיתוח הכלכלה המקומית המבוססת על היזמים המקומיים.
