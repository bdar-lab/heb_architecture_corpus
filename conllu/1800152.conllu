# file = txt/1800152.txt
# filelineno = 432
# sentno = 10
# text = למרות פעילות רבת שנים בתחום בניית מקלטים ומרחבים מוגנים עבור האוכלוסייה האזרחית של ישראל, במטרה להבטיח מיגון נאות לכל האוכלוסייה, בכל רחבי המדינה ובכל שעות היממה, קיימים עדיין פערים משמעותיים למדי בכל הקשור לצרכי המיגון של אזרחי המדינה, במיוחד באזורים עירוניים וותיקים שבהם מרבית הבניינים הקיימים אינם כוללים מקלטים או מרחבים מוגנים כלשהם.
