# file = txt/1800152.txt
# filelineno = 505
# sentno = 1
# text = בנוסף לכך, על מנת לבחון באופן ראוי את העלות הכלכלית האמיתית של שימוש בחלונות בעלי יכולת מיגונית משופרת בבניינים אזרחיים רגילים, יש מקום לאימוץ גישת עלות-תועלת כלכלית-הנדסית המתייחסת לא רק לעלות הראשונית של חלונות אלה, אלא גם לתוחלת הנזקים הישירים והעקיפים שעלולים להיגרם כתוצאה מהיפגעותם במהלך תקופת השימוש התכנונית בהם.
