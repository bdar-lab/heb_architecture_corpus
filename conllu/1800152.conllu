# file = txt/1800152.txt
# filelineno = 529
# sentno = 1
# text = ניתוח ביקורתי של האיומים המלחמתיים ושל איומי הטרור הישימים השונים, התקפים כיום, כמו גם ניתוח של הפגיעות שנגרמו כתוצאה מאירועים מלחמתיים שהתרחשו בשנים האחרונות, מצביעים על כך, שפתרונות המיגון עבור האוכלוסייה האזרחית הנהוגים כיום בבנייה האזרחית הרגילה בישראל (מרחבים מוגנים דירתיים, מרחבים מוגנים קומתיים, מרחבים מוגנים מוסדיים), מבטיחים רמת מיגון סבירה יחסית, בהשוואה לבניינים בהם אין פתרון מיגון כלשהו, בפני האיומים הנ"ל התקפים כיום.
