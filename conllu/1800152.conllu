# file = txt/1800152.txt
# filelineno = 312
# sentno = 2
# text = בנוסף לכמות חומר הנפץ ולגורמים נוספים המתוארים בפרק 2 לעיל, חומרת השפעות ההדף תלויה במיוחד במיקום מוקד הפיצוץ - האם הוא בצד החיצוני של מעטפת הבניין הנפגע במידה שמדובר בפיצוץ המתרחש מיד לאחר הפגיעה, או אם הוא מתרחש בתוכו (במקרה של חדירת הרש״ק דרך מעטפת הבניין בטרם התרחשות הפיצוץ).
