# file = txt/1800152.txt
# filelineno = 345
# sentno = 8
# text = העיקריות שבהן הן המרחק המקונם הגדול יותר של מוקד הפיצוץ מחזית הבניין, בהשוואה למקרה המוצג בצילומים שבאיור 4.18, והעובדה שתקרות הבניין, במיוחד תקרת הביניים המקשית המומשכת מבטון מזויין, הנשענת על מערכת קורות פלדה וקירות נושאים מבלוקי בני בהיקפה, איבדה רק את אחד הקירות הנושאים עליו היא נשענת לאורך קטע קצר יחסית (כ- 3.0 מ' בקירוב) ואילו שאר הקירות הנושאים תמכו אותה גם לאחר הפגיעה.
