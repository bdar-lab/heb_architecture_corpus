# file = txt/1800152.txt
# filelineno = 523
# sentno = 1
# text = מן הראוי להדגיש שמערכות מבניות של רצפות/תקרות/גגות של בניינים בכלל ושל בניינים אזרחיים בלתי מוגנים רגילים בפרט, משמשות לא רק כרכיבי גישור וקירוי המיועדים לשאת עומסים אנכיים, אלא גם כדיאפרגמות אופקיות (או נטויות בגגות משופעים), אשר יכולות וצריכות להעביר עומסים אופקיים הצפויים לפעול על חלקים שונים של בניינים אלה אל רכיבי ההקשחה האופקית שלהם, כמפורט בסעיף 5.7.3 לעיל.
