# file = txt/1800152.txt
# filelineno = 528
# sentno = 5
# text = אירועים מלחמתיים אלה גרמו אומנם רק למספר קטן יחסית של נפגעים ואבידות בנפש, בין היתר גם לאור היערכות רבת שנים ומתמשכת להבטחת מיגון מתאים לאוכלוסייה האזרחית של המדינה, אך גרמו לנזקים כלכליים ישירים ועקיפים חמורים מאוד לסביבה האזרחית הבנויה בישראל.
