# file = txt/1800152.txt
# filelineno = 338
# sentno = 1
# text = הצגת תוצאות הניתוחים השונים בתלות בעובי מקונם של רכיבים מבניים שונים כמפורט לעיל מאפשרת הן הצגה הנדסית איכותית, והן הצגה כמותית של תוצאות הניתוחים הנדונים, מבלי הצורך לפרט נתונים ספציפיים על סוג וכמות חומר הנפץ ומרחק מוקד הפיצוץ מהמטרה ויחד עם זאת להכליל את התוצאות לתחום רחב של כמויות חומר נפץ ומרחקים מתאימים המקיימים את כללי הקינום, וכן את המידע על עוביים/מידות חתך בפועל של הרכיבים המבניים אשר לגביהם מתייחסות תוצאות הניתוחים.
