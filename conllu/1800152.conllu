# file = txt/1800152.txt
# filelineno = 557
# sentno = 1
# text = •	במהלך התכן המפורט של בניינים אזרחיים רגילים, לרבות בנייני מגורים, מומלץ לבחון את מידת עמידותם החזויה מצבים קיצוניים של היפגעותם האפשרית כתוצאה של מימוש איומים מלחמתיים ו/או איומי טרור ישימים, או כתוצאה של רעידת אדמה חזקה, הן ברמה מקומית והן ברמה הכוללת, זאת בנוסף להבטחת עמידותם במכלול העומסים החזויים לפעול עליהם במצבים גבוליים של שרות ושל הרס, על פי דרישות התקנים הישראליים ישימים השונים.
