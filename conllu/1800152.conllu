# file = txt/1800152.txt
# filelineno = 318
# sentno = 4
# text = במצב זה גדל מאוד גם הסיכון להיפגעות אנשים השוהים בבניין הבלתי מוגן (למעט אלה השוהים במרחבים מוגנים הקיימים בחלק מהבניינים הקיימים בישראל, כפי שפורט בפרק 3 לעיל), באזורים הסמוכים לאזור הפגיעה, כתוצאה מלחצי הדף אוויר ובמיוחד כתוצאה מפגיעה אפשרית של רסיסי מתכת המועפים ממעטפת הרש"ק המתפוצץ, או כתוצאה מפגיעת רסיסי זכוכית הנוצרים עקב התנפצות חלונות ורכיבים מזוגגים אחרים בעת פיצוץ הרש"ק, או כתוצאה של היפגעות מחלקים ניתקים של רכיבי בניין, מערכות בניין ו/או תכולת הבניין (ריהוט, ציוד וכו'), או מרגמות כמצוין לעיל.
