# text = בין רש"קים המשוגרים לטווח ארוך, של מאות ואף של אלפי קילומטרים, ניתן למנות טילי שיוט וטילים בליסטיים, כדוגמת טילי ה- SCUD העיראקיים - איור 2.4, שפגעו במקומות שונים ברחבי המדינה במהלך מלחמת המפרץ הראשונה, כמו גם טילים בליסטיים חדישים יותר, בעלי טווחים מוגברים ודיוק רב יותר, המיוצרים ו/או הנמצאים כיום בידי מדינות עוינות שונות, כגון איראן וסוריה.
# raw = {'id': 1, 'text': 'בין רש"קים המשוגרים לטווח ארוך, של מאות ואף של אלפי קילומטרים, ניתן למנות טילי שיוט וטילים בליסטיים, כדוגמת טילי ה- SCUD העיראקיים - איור 2.4, שפגעו במקומות שונים ברחבי המדינה במהלך מלחמת המפרץ הראשונה, כמו גם טילים בליסטיים חדישים יותר, בעלי טווחים מוגברים ודיוק רב יותר, המיוצרים ו/או הנמצאים כיום בידי מדינות עוינות שונות, כגון איראן וסוריה.', 'dspan': (0, 344), 'tokens': [{'id': 1, 'text': 'בין', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'בין'}, {'id': 2, 'text': 'רש"קים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 17, 'deprel': 'obl', 'dspan': (4, 10), 'span': (4, 10), 'lemma': 'רש"קים'}, {'id': (3, 4), 'text': 'המשוגרים', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 4, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 4, 'text': 'משוגרים', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PUAL|Number=Plur|Person=3|Tense=Pres|VerbForm=Part|Voice=Pass', 'head': 2, 'deprel': 'acl:relcl', 'lemma': 'משוגרים'}], 'span': (11, 19), 'dspan': (11, 19)}, {'id': (5, 6), 'text': 'לטווח', 'expanded': [{'id': 5, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ל'}, {'id': 6, 'text': 'טווח', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'obl', 'lemma': 'טווח'}], 'span': (20, 25), 'dspan': (20, 25)}, {'id': 7, 'text': 'ארוך', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'amod', 'dspan': (26, 30), 'span': (26, 30), 'lemma': 'ארוך'}, {'id': 8, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 10, 'deprel': 'punct', 'dspan': (30, 31), 'span': (30, 31), 'lemma': ','}, {'id': 9, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 10, 'deprel': 'case', 'dspan': (32, 34), 'span': (32, 34), 'lemma': 'של'}, {'id': 10, 'text': 'מאות', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Definite=Cons|Gender