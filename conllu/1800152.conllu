# file = txt/1800152.txt
# filelineno = 474
# sentno = 1
# text = אחת הבעיות המרכזיות שעלולות להתעורר בישום פתרונות אלה היא הקושי בבקרת איכות הביצוע של יצוקות הבטון בחתכים מרוכבים המוזכרים לעיל, זאת לאור העובדה שרכיבי הפלדה משמשים למעשה גם כתבנית אבודה, כך שבתום יציקת הרכיבים לא ניתן לבדוק בצורה ויזואלית האם הבטונים שנוצקו אינם כוללים אזורים של בטון שלא צופף כראוי (כיסי סגרגציית בטון וכו').
