# file = txt/1800152.txt
# filelineno = 320
# sentno = 4
# text = ניתן להסביר זאת על בסיס נתוני הבניין הנדון שנבנה בשיטת בנייה קונוונציונלית המבטיחה קשר מונוליתי בין הרכיבים השונים של שלד הבניין, ובתרומה המשמעותית של קירות הבני בקומות הבניין שמעל העמוד הנפגע, אשר באה לידי ביטוי ביכולתם להעביר, תוך שיתוף פעולה עם רכיבי הבטון המזויין של שלד הבניין (תקרות, קורות, עמודים) בקומות שמעל אזור הפגיעה (אשר לא נפגעו) את עומסי הכבידה של הקומות העליונות של הבניין ולסייע לרדיסטריבוציה של העומסים שפעלו במקור על העמוד שנפגע, אל עמודים אחרים הסמוכים אליו.
