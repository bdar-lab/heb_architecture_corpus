# file = txt/1800152.txt
# filelineno = 132
# sentno = 1
# text = שימוש במרחק מקונם מאפשר גם הצגת תוצאות של אנליזות שונות של תגובת מבנים הנדסיים שונים או של רכיביהם, וכן גם תוצאות ניסויים לגבי השפעות פיצוץ, בצורה מוכללת, שאינה מפרשת את האיום הספציפי (סוג הרש״ק ו/או כמות חומר הנפץ המתפוצץ ומרחק מוקד הפיצוץ מהמבנה הנבדק), ולכן ניתנת להצגה בפרסומים בלתי מסווגים.
