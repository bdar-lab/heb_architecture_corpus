# file = txt/1800152.txt
# filelineno = 186
# sentno = 2
# text = במקרים בהם הפיצוץ אינו של מטען חומר נפץ נייח, אלא של רש"ק הפוגע במטרה במהירות מסוימת, כגון במקרה של פגיע ישירה של פגזים, פצצות, רקטות, או טילים מסוגים ישימים שונים, כמפורט בסעיף 2.2 לעיל בבניינים אזרחיים בלתי מוגנים רגילים, הסכנה לפריצת הרכיב הנפגע גדולה עוד יותר, עקב תופעות הנגיפה והחדירה של הרש"ק המפורטות בסעיפים 2.4.6 ו- 2.4.7 להלן.
