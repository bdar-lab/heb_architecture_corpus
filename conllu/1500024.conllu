# file = txt/1500024.txt
# filelineno = 658
# sentno = 4
# text = מכיוון שפירוס המסה במבנה מייצג את מערכת הכוחות הדינאמיים הפועלת בעת רעידת אדמה ומערכת רכיבי ההקשחה מייצגת את מערכת הכוחות המתנגדים, יש יתרון גדול בהבטחת מיקום זהה למרכז המסה ולמרכז הקשיחות, שאם לא כן ייגרמו למבנה גם תנודות פיתול ותתפתח חלוקת כוחות לא אחידה בצורה קיצונית יותר.
