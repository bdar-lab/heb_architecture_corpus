# file = txt/1500024.txt
# filelineno = 31
# sentno = 1
# text = ההיערכות מראש לקראת השגת מוכנות גבוהה לאירוע של רעידת אדמה כזאת היא רבת פנים וכוללת פעילויות רבות וביניהן פעולות שונות בתחום הבנייה והתשתית, כגון: הכנת תקנים עדכניים ואכיפתם לשיפור הבנייה החדשה, הערכת עמידות בנייה קיימת ושדרוגה, הערכת העמידות של מתקנים, תשתיות, מבני תעשייה וכו' וטיפול בהם בהתאם, הערכת העמידות של מתקנים מחוללי סיכון כמו מתקנים לאחסון חומרים מסוכנים וטיפול מיוחד בהם, מיפוי תשתיות הקרקע לזיהוי פוטנציאל גלישת קרקע, הגברה, התנזלות וכו'.
