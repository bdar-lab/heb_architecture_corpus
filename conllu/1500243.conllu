# file = txt/1500243.txt
# filelineno = 548
# sentno = 2
# text = בח"א 27 הינו כנף תובלה, אשר הועבר מנתב"ג לנבטים בשנת 2010 והפך את המרחב האווירי בדרום הארץ לאזור העמוס ביותר מבחינת תעבורה צבאית (המועצה הארצית, 2007; ועדת הכלכלה, 2012 ולנת"ע, 2006; רשות התעופה האזרחית ואחרים, 2017).
