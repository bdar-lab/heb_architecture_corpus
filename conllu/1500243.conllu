# file = txt/1500243.txt
# filelineno = 39
# sentno = 1
# text = לעניין של זמינות הנתונים, משרד הבריאות אישש כ׳ אמנם אין לו גישה חופשית לנתוני קופות החולים, אך הסביר באותה נשימה כ׳ אין צורך בהם על מנת לבצע תסקיר השפעה על הבריאות, וכי ישנה מתודולוגיה כיצד ניתן מבחינה אפידמיולוגית לערוך תסקיר בריאות׳ מבוסס על הערכה של נתונים וסקירת ספרות (ועדת הפנים ונוספים, 2010).
