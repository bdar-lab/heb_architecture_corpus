# file = txt/1500243.txt
# filelineno = 397
# sentno = 1
# text = ההבנה כי יש לתת מענה לצרכים התשפת״ם של מדינת ישראל עלתה שד בשנת 1972, כאשר הורתה המועצה הארצית לתכנון ולבניה להכין תכנית מתאר ארצית לשדות תשפה - תמ"א 15, שאושרה רק בשנת 2000 (הכנסת, 2002; רשות התעופה האזרחית ואחרים, 2017).
