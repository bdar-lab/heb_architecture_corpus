# text = מבחינה סטטוטורית, אין מנגנון שבודק את ההשפעות הבריאותיות של פרויקט תכנוני כלשהו, פרט לתסקיר השפעה על הסביבה (Environmental Impact Assessment - EIA) שמבצע הערכה של ההשפעות הפוטנציאליות על הסביבה, ובן של נושאים הקשורים לבריאות כגון זיהום אוויר וחשיפה לחומרים מסוכנים (הקרן לבריאות וסביבה ומשרד הבריאות, 2017).
# raw = {'id': 1, 'text': 'מבחינה סטטוטורית, אין מנגנון שבודק את ההשפעות הבריאותיות של פרויקט תכנוני כלשהו, פרט לתסקיר השפעה על הסביבה (Environmental Impact Assessment - EIA) שמבצע הערכה של ההשפעות הפוטנציאליות על הסביבה, ובן של נושאים הקשורים לבריאות כגון זיהום אוויר וחשיפה לחומרים מסוכנים (הקרן לבריאות וסביבה ומשרד הבריאות, 2017).', 'dspan': (0, 307), 'tokens': [{'id': (1, 2), 'text': 'מבחינה', 'expanded': [{'id': 1, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'מ'}, {'id': 2, 'text': 'בחינה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'obl', 'lemma': 'בחינה'}], 'span': (0, 6), 'dspan': (0, 6)}, {'id': 3, 'text': 'סטטוטורית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'amod', 'dspan': (7, 16), 'span': (7, 16), 'lemma': 'סטטוטורית'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (16, 17), 'span': (16, 17), 'lemma': ','}, {'id': 5, 'text': 'אין', 'upos': 'VERB', 'xpos': 'VERB', 'head': 0, 'deprel': 'root', 'dspan': (18, 21), 'span': (18, 21), 'lemma': 'אין'}, {'id': 6, 'text': 'מנגנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'nsubj', 'dspan': (22, 28), 'span': (22, 28), 'lemma': 'מנגנון'}, {'id': (7, 8), 'text': 'שבודק', 'expanded': [{'id': 7, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 8, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 8, 'text': 'בודק', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Act', 'head': 6, 'deprel': 'acl:relcl', 'lemma': 'בדק'}], 'span': (29, 34), 'dspan': (29, 34)}, {'id': 9, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'dspan': (35, 37), 'span': (35, 37), 'lemma': 'את'}, {'id': (10, 11), 'text': 'ההשפעות', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'h