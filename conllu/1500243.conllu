# file = txt/1500243.txt
# filelineno = 654
# sentno = 2
# text = אחת הסיבות מדוע תסקיר השפעה על הבריאות אינו חלק מהמתודולוגיה התכנונית הינה כ׳ הוא נתפס בעיני מוסדות התכנון בתור גורם שיוסיף לזמן הארוך במילא של קידום פרויקטים, בייחוד של תשתיות לאומיות כפי שעולה מהפרוטוקולים בנושא: "אני פשוט חוששת שההכללה של הנושא (הבריאותי) הזה בתסקיר (הסביבתי) תיצור עיכובים רבים בנושא של קידום פרויקטים, מה גם שכרגע הפוקוס של הממשלה הוא לקדם תשתיות" (ועדת הפנים ונוספים, 2010).
