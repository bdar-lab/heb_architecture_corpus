# file = txt/1500243.txt
# filelineno = 407
# sentno = 1
# text = לאור העובדה שמדינת ישראל נותרה ללא תוכנית שמתוכה ניתן להוציא היתר לבנ״תו של שדה תעופה בינלאומי משלים, מינה שר התחבורה בספטמבר 2007 את הוועדה הציבורית לבחינת תכנית אב לשדות תעופה (הידועה כ"וועדת בודינגר"), שתבחן את תוכנית האב לשדות תעופה, מאחר ולא ננקטו החלטות לאחר הכנתה בשנת 1999 (הוועדה הציבורית, 2008; רשות התעופה האזרחית ואחרים, 2017).
