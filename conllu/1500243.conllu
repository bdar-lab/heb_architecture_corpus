# file = txt/1500243.txt
# filelineno = 414
# sentno = 1
# text = בהמשך לכך, הכירה הממשלה בצורך הלאומי הדחוף בהקמתו של שדה תעופה בינלאומי נוסף משלים לנתב״ג, וכן נתנה הוראה לשר התחבורה והבטיחות בדרכים, להגיש לממשלה תוך שלושה חודשים את המלצות צוותי ההיגוי שנתמנו, בכדי להכריע בדבר מיקומו של שדה התעופה המשלים (משרד הראש הממשלה, 7.2011).
