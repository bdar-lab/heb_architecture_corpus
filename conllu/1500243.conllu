# text = לדוגמה כפי שציין משרד הבינו׳ והשיכון בפרוטוקול של אחד הדיונים, כ׳ לא ברור מ׳ עורך את התסקיר, באיזה פרויקטים יש לעשותו ואיך מתקבלות לפיו החלטות; ולכן לא ניתן לעגנו כמסמך מחייב לפני שברור לכולם איך צריך לפעול: "הנושא של שקיפות התהליך, בהירות התהליך, מ׳ הגורמים הפועלים, מ׳ הגורמים המכינים, מ׳ הגורמים שבודקים, הוא חלק מאוד מאוד חשוב, גם בתוך הרפורמה וגם בתוך תהליך של תכנון, וכשאתה לא יודע מ׳ בעלי המקצוע שאמורים להכין את התסקיר, באיזה פרויקטים אתה אמור להכין את התסקיר...
# raw = {'id': 2, 'text': 'לדוגמה כפי שציין משרד הבינו׳ והשיכון בפרוטוקול של אחד הדיונים, כ׳ לא ברור מ׳ עורך את התסקיר, באיזה פרויקטים יש לעשותו ואיך מתקבלות לפיו החלטות; ולכן לא ניתן לעגנו כמסמך מחייב לפני שברור לכולם איך צריך לפעול: "הנושא של שקיפות התהליך, בהירות התהליך, מ׳ הגורמים הפועלים, מ׳ הגורמים המכינים, מ׳ הגורמים שבודקים, הוא חלק מאוד מאוד חשוב, גם בתוך הרפורמה וגם בתוך תהליך של תכנון, וכשאתה לא יודע מ׳ בעלי המקצוע שאמורים להכין את התסקיר, באיזה פרויקטים אתה אמור להכין את התסקיר...', 'dspan': (139, 609), 'tokens': [{'id': (1, 2), 'text': 'לדוגמה', 'expanded': [{'id': 1, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ל'}, {'id': 2, 'text': 'דוגמה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 21, 'deprel': 'obl', 'lemma': 'דוגמה'}], 'span': (0, 6), 'dspan': (139, 145)}, {'id': 3, 'text': 'כפי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 5, 'deprel': 'mark', 'dspan': (146, 149), 'span': (7, 10), 'lemma': 'כפי'}, {'id': (4, 5), 'text': 'שציין', 'expanded': [{'id': 4, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 3, 'deprel': 'fixed', 'lemma': 'ש'}, {'id': 5, 'text': 'ציין', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PIEL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 21, 'deprel': 'advcl', 'lemma': 'ציין'}], 'span': (11, 16), 'dspan': (150, 155)}, {'id': 6, 'text': 'משרד', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'nsubj', 'dspan': (156, 160), 'span': (17, 21), 'lemma': 'משרד'}, {'id': (7, 8), 'text': 'הבינו׳', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'בינוי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'compound', 'lemma': 'בינוי'}], 'span': (22, 28), 'dspan': (161, 167)}, {'id': (9, 11), 'text': 'והשיכון', 'expanded': [{'id': 9, 'text': 'ו', 'upo