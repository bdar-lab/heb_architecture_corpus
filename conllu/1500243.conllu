# file = txt/1500243.txt
# filelineno = 45
# sentno = 3
# text = תחילה הם קובעים באיזה היקף ההשפעות "בחנו, אחר כך אוספים נתונים בכדי לקבל תמונה של מאפייני האוכלוסייה המושפעת בהקשר הרלוונטי (סביבתי, חברתי או בריאותי), צופים מה יהיו השינויים בתנאים שייווצרו כתוצאה ממימוש הפרויקט או המדיניות, ובסופו של דבר הם מגבשים המלצה כיצד ניתן לשפר את התוכנית על מנת למזער את הפגיעה (במידה והיא קיימת) ולמקסם את הרווח (שם).
