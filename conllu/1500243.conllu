# file = txt/1500243.txt
# filelineno = 137
# sentno = 1
# text = ועדת ההיגוי נחוצה על מנת להבטיח כ׳ תכנית העבודה של התסקיר הבריאותי כוללת בתוכה את שלל האינטרסים השונים בצורה ראויה, כ׳ היא מספיק גמישה כדי להגיב נכונה לדרישות התכנון וההחלטות השונות, בעלת הכלים לתת הערכה וטיפול הולמים לנושאים הבריאותיים וכן נשארת בתוך גבולות היכולת הארגונית והתקציבית של הארגון (2013 ,.Ross et al).
