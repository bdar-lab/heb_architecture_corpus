# file = txt/1500243.txt
# filelineno = 547
# sentno = 2
# text = מצד אחד הייתה ממשלת ישראל אשר רצתה בפיתוח הנגב וקידום שדה תעופה בינלאומי בנבטים כאמצעי למימוש מטרה זו; מצד שני היו הגופים המקצועיים שטענו כ׳ האתר מרוחק מריכוז׳ אוכלוסייה ובעל פריסה בעייתית של תחבורה יבשתית בדגש על הסעת המונים, מה שהופך את ההשקעות באזור זה ללא כדאיות כלכלית; ומצד שלישי מערכת הביטחון שהתנגדה לחלופה זו מסיבות שיפורטו בהמשך (הוועדה הציבורית, 2008; הכנסת, 2002; המועצה הארצית, 2007; ועדת הכלכלה 2011; ועדת הכלכלה 2012; ועדת הכלכלה 2018; ולנת"ע, 2006; ועדת המשנה, 11.2014; רשות התעופה האזרחית ואחרים, 2017).
