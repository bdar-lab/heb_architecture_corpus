# file = txt/1500243.txt
# filelineno = 449
# sentno = 1
# text = בנוגע למקרים בהם השדה אמור לתת מענה למטוסים מסיביים יותר בגודל של 747-400 אשר נמצאים בקטגוריה E (ראו טבלה 9) למטרת ALTERNATE22 , ההנחה היא כ׳ הדבר אפשרי כיוון שמטוס כזה שיגיע לשדה המשלים ויביא את נוסעיו ליעד, ימריא ריק ובמשקל נמוך מאוד יחסית לכיוון נתב"ג, ועל כן הדבר יתאפשר על אורך המסלול המתכונן (רשות התעופה האזרחית ואחרים, 2017).
