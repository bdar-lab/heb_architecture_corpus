# file = txt/1500243.txt
# filelineno = 396
# sentno = 1
# text = התעופה הבינלאומית בישראל מבוססת כיום באופן כמעט מלא על נמל תעופה בן גוריון (הטיסות בשדות עובדה וחיפה הן מינוריות), כאשר נכון לשנת 2016 עברו בנתב״ג כ-17 מיליון נוסעים, ומספר זה צפוי לגדול (המועצה הארצית, 11.2017; רשות התעופה האזרחית ואחרים, 2017).
