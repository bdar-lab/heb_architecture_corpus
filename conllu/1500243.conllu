# file = txt/1500243.txt
# filelineno = 64
# sentno = 1
# text = בבחינה של הפרויקט או התוכנית על מנת לגבש דעה ראשונית האם עשויות להיות השפעות בריאותיות (מועילות ומזיקות) על הקהילה הרלוונטית; שנית, בבדיקה האם התסקיר הבריאות׳ יציף ידע חדש ואקטואלי בתהליך קבלת ההחלטות; וכן סקירה של המשאבים הזמינים לביצוע התסקיר בשביל לקבוע האם יש מספיק זמן, כוח אדם ומימון (שם).
