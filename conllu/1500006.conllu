# file = txt/1500006.txt
# filelineno = 349
# sentno = 3
# text = כך לדוגמא, אזור תעסוקה בו עיקר זכויות הבנייה מוקצים למשרדים הוגדר בשימוש עיקרי של משרדים, ואותו ייעוד בו עיקר זכויות הבניה הם לתעשייה הוגדר בשימוש עיקרי של תעשייה (ראו לדוגמא את השינויים בשימושי הקרקע העיקריים באזור תעסוקה קסם ברביע ב׳ - ראש העין, מפות 6.3 ו 6.4 ).
