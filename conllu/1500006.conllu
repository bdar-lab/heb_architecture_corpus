# file = txt/1500006.txt
# filelineno = 210
# sentno = 2
# text = בשנת 1993 החליטה הממשלה על הקמת חברת כביש חוצה ישראל שתפעל כנאמן של המדינה להגשמת הפרויקט, ובשנים 1994 ו 1995 נחקקו שני חוקים בהתייחס לכביש: חוק כביש ארצי לישראל, התשנ״ה - 1994, העוסק בסדרי הפקעה, תפיסת החזקה ותשלום פיצויים ייחודיים לבעלי הקרקעות בתוואי הכביש, וחוק כביש אגרה (כביש ארצי לישראל) התשנ״ה - 1995 בו נקבע כי חלקו המרכזי של הכביש יהיה כביש אגרה, אשר יוקם ויופעל ע״י זכיין פרטי שייבחר במכרז.
