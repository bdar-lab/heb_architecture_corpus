# file = txt/1500006.txt
# filelineno = 176
# sentno = 1
# text = הבנה של התהליכים המתרחשים בעקבות השקעה בכבישים מהירים הכרחית בעיקר במציאות בה מצד אחד השקעה בתחבורה מהווה אמצעי מרכזי של מדיניות ציבורית לעידוד פיתוח עירוני בעיקר באזורי הפריפריה, ומאידך כבישים חדשים נבנים במטרה להקל על גודש תנועה בעיקר באזורים מטרופוליניים, תוך התעלמות מההשפעות האורבניות של הכביש.
