# file = txt/1400071.txt
# filelineno = 234
# sentno = 1
# text = השיטה הטקסונומית חיפושיות ועכבישים, שסיפקה את דגמי המגוון והתפוצה, נמצאה בעלת ערך מוסף לשתי השיטות האקולוגיות-תכנוניות LARCH-i EBONE בתכנון בקנה מידה מקומי; תוצאותיה של השיטה משתי עונות דיגום בלבד סיפקו תמונה מערכתית, שביטאה את איכותם האקולוגית של השטחים הטבעיים מבחינת: מדדי מגוון, היעדרותם של מינים פולשים ומיעוט של מינים קוסמופוליטים.
