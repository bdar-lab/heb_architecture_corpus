# text = אף על פי שחוקרים זיהו את חשיבותם של גורמים סובייקטיביים בהתנהגות אנשים [ראו למשל, השפעת מורכבות המשימה, צורת הצגת המידע, דמיון בין החלופות, ועוד, על תהליך קבלת ההחלטות של הפרט (1982 ,Puto, 1987 ;(Payne)], לא קיימת הסכמה על הדרך בה נקודת ההשקפה של האדם עשויה להשפיע על קבלת החלטות.
# raw = {'id': 3, 'text': 'אף על פי שחוקרים זיהו את חשיבותם של גורמים סובייקטיביים בהתנהגות אנשים [ראו למשל, השפעת מורכבות המשימה, צורת הצגת המידע, דמיון בין החלופות, ועוד, על תהליך קבלת ההחלטות של הפרט (1982 ,Puto, 1987 ;(Payne)], לא קיימת הסכמה על הדרך בה נקודת ההשקפה של האדם עשויה להשפיע על קבלת החלטות.', 'dspan': (326, 606), 'tokens': [{'id': 1, 'text': 'אף', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 6, 'deprel': 'mark', 'dspan': (326, 328), 'span': (0, 2), 'lemma': 'אף'}, {'id': 2, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 1, 'deprel': 'fixed', 'dspan': (329, 331), 'span': (3, 5), 'lemma': 'על'}, {'id': 3, 'text': 'פי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'fixed', 'dspan': (332, 334), 'span': (6, 8), 'lemma': 'פה'}, {'id': (4, 5), 'text': 'שחוקרים', 'expanded': [{'id': 4, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 1, 'deprel': 'fixed', 'lemma': 'ש'}, {'id': 5, 'text': 'חוקרים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 6, 'deprel': 'nsubj', 'lemma': 'חוקר'}], 'span': (9, 16), 'dspan': (335, 342)}, {'id': 6, 'text': 'זיהו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PIEL|Number=Plur|Person=3|Tense=Past|Voice=Act', 'head': 59, 'deprel': 'advcl', 'dspan': (343, 347), 'span': (17, 21), 'lemma': 'זיהה'}, {'id': 7, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'dspan': (348, 350), 'span': (22, 24), 'lemma': 'את'}, {'id': (8, 9), 'text': 'חשיבותם', 'expanded': [{'id': 8, 'text': 'חשיבות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'obj', 'lemma': 'חשיבות'}, {'id': 9, 'text': 'ם', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Definite=Def|Gender=Masc|Number=Plur|Person=3|Poss=Yes|PronType=Prs', 'head': 8, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (25, 32), 'dspan': (351, 358)}, {'id': 10, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Cas