# file = txt/2000156.txt
# filelineno = 98
# sentno = 2
# text = ההתנגשות האפשרית בין התערבות ממשלתית שמגמתה הגדלת השוויון (כגון קביעת נורמות חדשות ושינוי נורמות קיימות באופן שיאפשר מגורים זולים ומתאימים לבעלי הכנסה נמוכה בכל אזור בארץ, לרבות בשכונות יוקרה) ובין הפגיעה האפשרית בזכות הקניינית הרכושית (לדוגמא פגיעה בזכותם של בעלי הבתים האמידים באותו אזור ע״י ירידת ערך בתיהם, אילוצם לגור ליד שכנים לא רצויים וכד׳), אינה מצדיקה בהכרח המנעות של המדינה מלהתערב בשוק הדיור לצורך קידום המטרה הנ״ל.
