# file = txt/2000156.txt
# filelineno = 547
# sentno = 4
# text = התוצאה היא מאבק בין הועדה המחוזית והמקומית וסירוב הראשונה לאשר את התכנית, אלא בתנאי שהצפיפות תהיה גבוהה מהמוצע בתכנית, דהיינו יבנו מינימום 5 יח״ד לדונם נטו, ובכל מקרה לא פחות מהצפיפות המקובלת כיום בתכניות של המינהל לפי החלטת המינהל משנת 1994- מינימום 3.5 יח״ד לדונם ברוטו.
