# file = txt/1500222.txt
# filelineno = 308
# sentno = 1
# text = ניתוח תוכן של הגדרות למושג ״חבירה״ שבוצעה על ידי החוקרות 1991) Wood and Gray) העלה הגדרה מצומצמת מקובלת בספרות לפיה חבירה (Collaboration) מתרחשת כאשר קבוצת בעלי עניין (ארגונים), בעלי זוויות ראיה שונות של העניין (או הבעיה), חוברים לתהליך אינטראקטיבי, המאופיין במבנים, נורמות וחוקים מוסכמים, כדי לפעול או להחליט בעניינם המשותף.
