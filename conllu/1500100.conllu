# text = עשור מאוחר יותר עדיין נמשך הדיון בשפה דומה בגיליון של כתב העת סטודיו, המוקדש למרחב הבנוי: "...לא הייתה זו אלטרנטיבה רעינית לשיכון העיבורי, כי אם יעירתה של סביבת מגורים אנוכית בעיקרה...התכנון מובל על ידי זערנליזם זול ומנייריזם אישי, המנותק מההוויה התרבותית בישראל' (כנפו, 1991, עמ׳ 7) וכן, "מלבד ריבוי הסגנונות שנשאבו מתורגלים' מיובאים, הבתים התאפיינו בחוסר התחשבות בנוף ובסביבה הבנויה וכל מי שנקלע אליהם חש (עם מעט רגישות) בדוקרניות הצורנית חסרת המעעורים״ (בן־אהרון, 2000).
# raw = {'id': 1, 'text': 'עשור מאוחר יותר עדיין נמשך הדיון בשפה דומה בגיליון של כתב העת סטודיו, המוקדש למרחב הבנוי: "...לא הייתה זו אלטרנטיבה רעינית לשיכון העיבורי, כי אם יעירתה של סביבת מגורים אנוכית בעיקרה...התכנון מובל על ידי זערנליזם זול ומנייריזם אישי, המנותק מההוויה התרבותית בישראל\' (כנפו, 1991, עמ׳ 7) וכן, "מלבד ריבוי הסגנונות שנשאבו מתורגלים\' מיובאים, הבתים התאפיינו בחוסר התחשבות בנוף ובסביבה הבנויה וכל מי שנקלע אליהם חש (עם מעט רגישות) בדוקרניות הצורנית חסרת המעעורים״ (בן־אהרון, 2000).', 'dspan': (0, 473), 'tokens': [{'id': 1, 'text': 'עשור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'obl:tmod', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'עשור'}, {'id': 2, 'text': 'מאוחר', 'upos': 'ADV', 'xpos': 'ADV', 'head': 1, 'deprel': 'advmod', 'dspan': (5, 10), 'span': (5, 10), 'lemma': 'מאוחר'}, {'id': 3, 'text': 'יותר', 'upos': 'ADV', 'xpos': 'ADV', 'head': 2, 'deprel': 'advmod', 'dspan': (11, 15), 'span': (11, 15), 'lemma': 'יותר'}, {'id': 4, 'text': 'עדיין', 'upos': 'ADV', 'xpos': 'ADV', 'head': 5, 'deprel': 'advmod', 'dspan': (16, 21), 'span': (16, 21), 'lemma': 'עדיין'}, {'id': 5, 'text': 'נמשך', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (22, 26), 'span': (22, 26), 'lemma': 'נמשך'}, {'id': (6, 7), 'text': 'הדיון', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'דיון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'nsubj', 'lemma': 'דיון'}], 'span': (27, 32), 'dspan': (27, 32)}, {'id': (8, 9), 'text': 'בשפה', 'expanded': [{'id': 8, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ב'}, {'id': 9, 'text': 'שפה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'nmod', 'lemma': 'שפה