# text = במשהב״ש נקבעה באגף האיכלוס, ועדה לתיאום פעולות “בנה ביתך” ובתחילת 1976 הוצג נוהל עבודה סופי להפעלת תכנית “בנה ביתך” בעיירות הפיתוח (משהב״ש,1976א) החל משנת 1976 לקחה לידיה חברת שו״פ את ניהול הפרויקטים, קבעה מסגרת קבועה לפרויקט “בנה ביתך” הכולל ניהול וליוויו מול הדיירים.
# raw = {'id': 3, 'text': 'במשהב״ש נקבעה באגף האיכלוס, ועדה לתיאום פעולות “בנה ביתך” ובתחילת 1976 הוצג נוהל עבודה סופי להפעלת תכנית “בנה ביתך” בעיירות הפיתוח (משהב״ש,1976א) החל משנת 1976 לקחה לידיה חברת שו״פ את ניהול הפרויקטים, קבעה מסגרת קבועה לפרויקט “בנה ביתך” הכולל ניהול וליוויו מול הדיירים.', 'dspan': (317, 586), 'tokens': [{'id': (1, 2), 'text': 'במשהב״ש', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'משהבחש', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'obl', 'lemma': 'משהבחש'}], 'span': (0, 7), 'dspan': (317, 324)}, {'id': 3, 'text': 'נקבעה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (325, 330), 'span': (8, 13), 'lemma': 'נקבע'}, {'id': (4, 5), 'text': 'באגף', 'expanded': [{'id': 4, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'ב'}, {'id': 5, 'text': 'אגף', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'obl', 'lemma': 'אגף'}], 'span': (14, 18), 'dspan': (331, 335)}, {'id': (6, 7), 'text': 'האיכלוס', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'איכלוס', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'compound:smixut', 'lemma': 'איכלוס'}], 'span': (19, 26), 'dspan': (336, 343)}, {'id': 8, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (343, 344), 'span': (26, 27), 'lemma': ','}, {'id': 9, 'text': 'ועדה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'nsubj', 'dspan': (345, 349), 'span': (28, 32), 'lemma': 'ועדה'}, {'id': (10, 11), 'text': 'לתיאום', 'expanded': [{'id': 10, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case',