# file = txt/1500100.txt
# filelineno = 389
# sentno = 1
# text = מתוך המגמות שנסקרו לעיל, סקירה של חומר ארכיוני (ברנד, 1980) ושיחות עם אנשי משהב״ש (ברנד, 2005 ; יבין, 2005 ; ברקאי, 2006) עולה שבעת הזמנת דו״ח הבדיקה, כווני הפיתוח של מדיניות הדיור של “בנה ביתך”, בתוך משהב״ש, כבר היו מגובשים.
