# file = txt/1500148.txt
# filelineno = 99
# sentno = 3
# text = עצירת הפרויקט התרחשה עקב ההדגשה הנוסטלגית והלגיטימציה התרבותית של התביעה לשמר לא רק את הסגנון הבינלאומי והמשמעות החברתית שייצג המבנה, אלא גם את רוח התקופה שבה נבנה היכל התרבות, את אווירת ההתלהבות והתמימות ואת המחויבות הציבורית שהייתה למתכנני הבניין (גרואג, 2009).
