# file = txt/1500013.txt
# filelineno = 78
# sentno = 2
# text = תשתית הניקוז המקובלת, מתבססת על צינורות ותעלות אטומות, שמזרימות במהירות את כמויות הנגר הגדולות הנוצרות בעיר אל מחוצה לה; מצב זה יוצר נתק בין הנגר, לבין גופי מים שהתקיימו בתוך העיר (ביניהם מאגרים תת-קרקעיים); זאת, בניגוד למתרחש בסביבה הטבעית, שבה ההנגר מהווה מקור מים לצמחייה וממלא תפקיד חשוב בתהליכי פרוק והעשרה של הקרקע, ביצירת בתי גידול לחים ובהעשרת מאגרי מי תהום בעומק הקרקע (2002 ,Ferguson).
