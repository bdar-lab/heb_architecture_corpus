# file = txt/1500013.txt
# filelineno = 237
# sentno = 1
# text = •	קונספט העיצוב ־ צוות אדריכלי הנוף שתכנן את הפארק-ובראשם Herbert Dreiseitl, שם דגש על הפיכת האחו-לח שבפארק לאלמנט נופי, שמלבד השימוש בו לצורך ניהול נגר (כמותית ואיכתית), הוא יתפקד כסביבת טבע עירוני בה יוכלו מבקרי הפארק לחוות את "חיוניות תופעות הטבע המתקיימות בו".
