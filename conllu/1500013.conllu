# file = txt/1500013.txt
# filelineno = 653
# sentno = 1
# text = •	שינויים בפריסת השצ״פים שבתחומי אגן משנה A (ר׳ איור מספר 31) ־ כדי לשמר את הערוץ החוצה את האגן ממערב למזרח, עובתה השדרה הסמוכה לו (סימון ש1), כך שערוץ הזרימה יוכל לעבור לאורכה, ולקלוט נגר ממגרשי מגורים הצמודים לשדרה; שתי השדרות המתוכננות במקור בתחומי האגן, אינן מקבילות לכביש, ולכן לא ניתן להזרים את עודפי נגר מהן - ישירות למערכת הניקוז, ולכן במפגש בין השדרות הוקצה שטח לגן ציבורי שבשטחו ניתן יהיה להשהות נגר שיזרום בקטעי השדרות המסתיימים בו (סימון ג3); בצמוד לתוואי הכביש החוצה את האגן מדרום לצפון, אשר עוקב אחר ערוץ מקורי, הוקצה שטח לשדרה נוספת (סימון ש2), על חשבון שטח משדרה עורפית מקבילה (סימון ש3).
