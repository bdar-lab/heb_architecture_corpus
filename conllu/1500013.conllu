# file = txt/1500013.txt
# filelineno = 240
# sentno = 2
# text = במהלך תכנון והקמת הפארק ־ סטודיו דרייסטיל שהוביל את צוות התכנון, יזם עבור ציבור התושבים סדנאות תכנון בשיתוף אנשי מקצוע, ובנוסף הפיק אירוע השקה לפארק (עם פתיחתו למבקרים); במהלך הסדנאות ואירוע ההשקה, ׳שווקו׳ למשתתפים הרעיונות האקולגיים של שילוב אחו לח בתכנון הפארק השכונתי.
