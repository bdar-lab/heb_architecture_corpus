# file = txt/1500013.txt
# filelineno = 181
# sentno = 1
# text = •	הפגיעה באיכות המים - בסביבה העירונית גדלים מגוון וכמות המזהמים בנגר המחלחל לקרקע, ולעיתים תהליכי הסינון הטבעיים אינם מספיקים כדי לנקות את המזהמים (שפורטו בסעיף הקודם) בנגר המחלחל ומגיע למי תהום.
