# file = txt/1500013.txt
# filelineno = 755
# sentno = 2
# text = גורם נוסף שהשפיע בבחירת מקדמי ה- CN הוא החיבוריות למערכת הניקוז: בכל מקום בו שטח אטום מתחבר לשטח חדיר, הומר מקדם ה-CN הנבחר בזה המתאים לסוג השטח החדיר, כאילו ׳הועבר׳ הגשם שנפל על השטח האטום אל השטח החדיר, והצטרף לגשם שנפל שם (פירוט בנספח 4.2)
