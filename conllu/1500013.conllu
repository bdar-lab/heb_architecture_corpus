# file = txt/1500013.txt
# filelineno = 541
# sentno = 1
# text = מתכנני מערך השצ״פים בתב״ע לשכונה, התמודדו עם שני אילוצים עיקריים: האחד, הגבלה מבחינת כמות השטחים שניתן לייעד לשימושים ציבוריים (וביניהם שצ״פים), עקב יוקר הקרקע באתר; השני, דרך בין עירונית (כביש 531) שעוברת בגבול הדרומי של השכונה (בתחום ׳הקו הכחול׳ של התב״ע), ושטחה 100 דונם, אשר יוצרת אילוצים מבחינת פריסת הבינוי בשכונה (כמפורט בהמשך).
