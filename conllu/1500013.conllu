# file = txt/1500013.txt
# filelineno = 235
# sentno = 2
# text = הפארק ממוקם על רצף של שטחים פתוחים שכונתיים, בליבו של אזור עירוני צפוף, המשלב בתוכו שמושים שונים של מגורים מסחר ותעסוקה (ר׳ איור מספר 10); זהו אזור שבעברו היה מכוסה ביצה, שיובשה והפכה לאזור תעשייה, עד לראשית שנות ה-90, אז החל הפיתוח העירוני בו.
