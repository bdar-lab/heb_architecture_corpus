# file = txt/1500013.txt
# filelineno = 557
# sentno = 1
# text = האתר ממוקם כ-7 ק״מ מזרחית לחוף הים, ומאופיין בקרקעות שמוצאן מבלייה של שכבות כורכר; שני סוגי קרקעות נפוצים באתר (לפי מובשוביץ, 1999) : ׳קרקע חמרה׳ ו׳קרקע אלובית חומרית וגליי׳; לקרקעות אלו כושר חדור מרבי (הולכת מים) של כ-13 מ״מ בשעה ו8-12 מ״מ בשעה בהתאמה, הנחשב לכושר חדור בינוני-גבוה (ר׳ ׳טבלת כושר חדור׳ בנספח 3.1).
