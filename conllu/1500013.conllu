# file = txt/1500013.txt
# filelineno = 151
# sentno = 1
# text = את הקף תהליכי החלחול שיתקיימו באתר מסויים המיועד לפיתוח ניתן לשער באמצעות הערכת נפח הנגר השנתי שיתווסף באתר בעקבות פיתוח השכונה; לפי מחקרים שונים (ר׳ אצל כרמון ושמיר, 1997) ניתן להניח כי תוספת זו בנפח הנגר, שווה לאיבודי המים שהיו מחלחלים לקרקע לולא הפיתוח.
