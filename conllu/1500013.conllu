# file = txt/1500013.txt
# filelineno = 507
# sentno = 1
# text = ישנם גורמים בעלי אינטרס לפיתוח המתחשב בשיקולי ניהול הנגר, מהם ניתן לגייס לקבלת תמיכה בקידום תכניות ואישורן, בינהם: מהנדסי ניקוז שמכירים את הנושא ותומכים בו; מנהלי מחלקת המים ברשות המקומית, בעיקר ברשויות בהן יש תחנות שאיבה משכבות אקוויפר בסביבת אתר הפיתוח, או רשויות בהן יש דרישה לחסוך בהוצאות על מי השקיה בגינון הציבורי; נציגים מגופים אזוריים ארציים לניהול משאבי המים ונציגי גופים ירוקים ומוסדות חינוך העוסקים בחינוך סביבתי.
