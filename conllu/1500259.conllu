# file = txt/1500259.txt
# filelineno = 238
# sentno = 8
# text = בשנת 1976 אושרה תכנית המתאר של יבנה, ועל אף התנגדותם של אנשי משרד השיכון, ובין היתר בשל בדיקות קרינה שנערכו בכור הגרעיני שורק וההבנה שהקרינה באזור אינה מהווה מכשול, אושרה הצעתו של שטרית לבנייה של בתים צמודי קרקע במערב העיר, בני ארבעה חדרים ומעלה "ורק ברמה ובאיכות של שיש בחדר המדרגות" (שם).
