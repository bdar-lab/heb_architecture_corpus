# text = בקבוצת מחקרים זו, למשל, ישנו מחקר המתאר כיצד הפכו המזרחים באשדוד את האתניות שלהם מנטל למשאב, כאשר הבינו שהקטגוריה האתנית מקנה להם את יתרון הקבוצה (אהרון, 2010), מחקר נוסף מתעד את תביעתם של המזרחים להכרה בתרבותם כחלק משדה התרבות הגבוהה בישראל במסגרת התזמורת האנדלוסית (אהרון גוטמן, 2008) ומחקר אחר מתאר כיצד גברים מזרחים הביאו את בתי הכנסת בעיר לחזית הקרב על זהותן של השכונות בעכו (2017 ,Ram & Aharon Gutman) בדומה, יאבו איילון (2017) עסקה בעכו, עיר
# raw = {'id': 3, 'text': 'בקבוצת מחקרים זו, למשל, ישנו מחקר המתאר כיצד הפכו המזרחים באשדוד את האתניות שלהם מנטל למשאב, כאשר הבינו שהקטגוריה האתנית מקנה להם את יתרון הקבוצה (אהרון, 2010), מחקר נוסף מתעד את תביעתם של המזרחים להכרה בתרבותם כחלק משדה התרבות הגבוהה בישראל במסגרת התזמורת האנדלוסית (אהרון גוטמן, 2008) ומחקר אחר מתאר כיצד גברים מזרחים הביאו את בתי הכנסת בעיר לחזית הקרב על זהותן של השכונות בעכו (2017 ,Ram & Aharon Gutman) בדומה, יאבו איילון (2017) עסקה בעכו, עיר', 'dspan': (370, 818), 'tokens': [{'id': (1, 2), 'text': 'בקבוצת', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'קבוצת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'obl', 'lemma': 'קבוצה'}], 'span': (0, 6), 'dspan': (370, 376)}, {'id': 3, 'text': 'מחקרים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'compound:smixut', 'dspan': (377, 383), 'span': (7, 13), 'lemma': 'מחקר'}, {'id': 4, 'text': 'זו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Dem', 'head': 2, 'deprel': 'det', 'dspan': (384, 386), 'span': (14, 16), 'lemma': 'זה'}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 8, 'deprel': 'punct', 'dspan': (386, 387), 'span': (16, 17), 'lemma': ','}, {'id': 6, 'text': 'למשל', 'upos': 'ADV', 'xpos': 'ADV', 'head': 8, 'deprel': 'advmod', 'dspan': (388, 392), 'span': (18, 22), 'lemma': 'למשל'}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 8, 'deprel': 'punct', 'dspan': (392, 393), 'span': (22, 23), 'lemma': ','}, {'id': 8, 'text': 'ישנו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|Number=Sing|Person=3|Polarity=Pos', 'head': 0, 'deprel': 'root', 'dspan': (394, 398), 'span': (24, 28), 'lemma': 'יישן'}, {'id': 9, 'text': 'מחקר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 8, 'deprel': 'nsubj', 'dspan': (399