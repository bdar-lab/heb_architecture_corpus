# file = txt/1500259.txt
# filelineno = 249
# sentno = 1
# text = באותה תקופה התקשה צה״ל לשמר כוח אדם איכותי בשירות קבע בגין שני גורמים: האחד ־ התקופה היא פוסט מלחמת יום הכיפורים שבעקבותיה נשחק מעמדו של צה״ל, וחיילים רבים לא הביעו נכונות להמשיך את שירותם הצבאי מעבר לנדרש; והשני - המשכורות של משרתי הקבע היו נמוכות בהשוואה למשכורות בשוק הפרטי שסיפק תחרות והציע תנאים טובים יותר למועסקים (גוב־ארי, 1998 ; עברי, 2020).
