# file = txt/1500259.txt
# filelineno = 341
# sentno = 1
# text = על אף שחתך האוכלוסייה שהשתתף באירועי התרבות היה ברובו מהשכונה הצבאית, לפי עדותו של המרואיין, השתתפו בו גם יבנאים ותיקים שעד לאותה עת, אם צרכו תרבות, עשו זאת מחוץ ליבנה, ואם לא צרכו, זה היה בשל היעדר עניין או אמצעים, כך שניתנה להם ההזדמנות להשתתף באירועים בקרבת ביתם.
