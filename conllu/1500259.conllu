# file = txt/1500259.txt
# filelineno = 92
# sentno = 3
# text = סקר שבחן את הרובד הבינוני בישראל בשנים 2010-1992 מצא כי בעיירות הפיתוח הרובד הבינוני מהווה כשליש ממשקי הבית, וכי בשנת 1992 הקבוצה הגדולה ביותר מקרב בני המעמד הבינוני היו המזרחים (שאף שיפרו את מעמדם במרוצת השנים, ועד שנת 2010 חוו גידול של 82% ברובד הגבוה, ומנו 45.3% מכלל הקבוצה) (דגן־בוזגלו וקונור-אטיאס, 2013).
