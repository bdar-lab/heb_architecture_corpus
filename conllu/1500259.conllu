# file = txt/1500259.txt
# filelineno = 7
# sentno = 2
# text = עם זאת, נמצא כי השכונה הצבאית לבדה אינה יכולה להיות ערובה לשינוי העירוני, ומי שהיה אחראי לכך שהמנגנון העירוני במתכונתו החדשה יוכל לפעול על אף המתחים וההבדלים בין השכונות, היא דווקא השכונה האזרחית שהוקמה במקביל לשכונה הצבאית ויועדה למשפרי דיור מיבנה ומערי האזור.
