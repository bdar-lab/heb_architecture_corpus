# file = txt/1500259.txt
# filelineno = 92
# sentno = 2
# text = מבחינה כלכלית, מתחלקים המעמדות לשלושה, על פי עשירוני הכנסה: המעמד הנמוך כולל את עשירונים 2-1, הבינוני את 8-3, והגבוה את 10-9, כאשר בתוך המעמד הבינוני ישנה חלוקה למעמד בינוני-נמוך (6-3) ומעמד בינוני-גבוה (8-7).
