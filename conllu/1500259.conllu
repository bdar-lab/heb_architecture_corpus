# file = txt/1500259.txt
# filelineno = 71
# sentno = 1
# text = מאמרים נוספים שפורסמו בגיליון 61 של כתב העת ׳מבנים׳ (1987) עסקו בתכנון שכונות בנה ביתך והיו דווקא בעלי נימה חברתית יותר בשל היותם נסובים סביב הבנייה בשיטת ׳בנה ביתך׳ בישובים קהילתיים, אך גם בהם היה העיסוק בפן החברתי משני, והטענות המרכזיות עסקו בארכיטקטורה ובתכנון שנולדו כתוצאה מתהליכים חברתיים.
