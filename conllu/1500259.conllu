# file = txt/1500259.txt
# filelineno = 308
# sentno = 2
# text = לצד זאת - ההערכה שרחשו לו בקרב שכונת נווה אילן בשל התפקיד הצבאי שמילא,51 המטען ההשכלתי שרכש, יחסי השכנות בשל מגוריו בשכונה האזרחית וכן השתתפותו הפעילה באירועים חברתיים בשכונת נווה אילן (דהן, 2006: 68־67) ובשכונת הוותיקות והרישות החברתי שהצליח לייצר בכל רחבי העיר - הפכו את דמותו לוורסטילית ונגישה לכל הקבוצות, כך שרוב תושבי יבנה האמינו שהוא מייצג אותם ופועל לטובתם, ומנגד ניהלו עמו תקשורת ישירה וללא משוא פנים מטעמם או מטעמו.
