# file = txt/1500259.txt
# filelineno = 184
# sentno = 1
# text = על אף קרבתה לגוש דן, לא הצליחה יבנה להשתלב בה, ומנגד - היא אינה רחוקה דיה עד כדי כך שיתייחסו אליה כאל עיר פיתוח, אם כי במסמכים מסוימים של כמה מן המוסדות הציבוריים, כמו גם בהמלצות אגף הפרוגרמות במשרד השיכון משנת 1970, היא מופיעה כעיר פיתוח.
