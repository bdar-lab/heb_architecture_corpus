# file = txt/1500259.txt
# filelineno = 403
# sentno = 8
# text = מרואיינת זו ציינה גם את המטפוריקה המייצרת בשפת העם הדבורה קשר בין מוצא אתני למעמד, והגיעה לעיר לאור היווצרותן של קטגוריות חברתיות חדשות: "זה כמו ש[בנה], בא יום אחד ואומר - ׳אמרו לי שאני אשכנזי, אני לא יודע מה זה אשכנזי׳, קראו לו אשכנזי כשהגיע לבית ספר פעם ראשונה.
