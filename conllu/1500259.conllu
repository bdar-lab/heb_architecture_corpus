# text = לצד הסיוע, התנה שטרית את אישורו בשלושה תנאים, הקשורים כולם בטבורה של המדיניות האינטגרטיבית ובמתן שוויון הזדמנויות לכלל התושבים: הראשון - כשליש מהמניות בפארק יהיו מוחזקים על ידי תושבים ותיקים; השני - בכל יום יוצעו למכירה שלוש מאות כרטיסים לתושבים שאינם בעלי מניה, במחיר ממוצע של כרטיס כניסה לפארקים באזור; והשלישי - הפארק יופעל על ידי עמותה נפרדת שתוקם במיוחד (״עמותת פארק המים - יבנה") כאשר בוועד המנהל של העמותה יהיו גם תושבים מיבנה הוותיקה.
# raw = {'id': 1, 'text': 'לצד הסיוע, התנה שטרית את אישורו בשלושה תנאים, הקשורים כולם בטבורה של המדיניות האינטגרטיבית ובמתן שוויון הזדמנויות לכלל התושבים: הראשון - כשליש מהמניות בפארק יהיו מוחזקים על ידי תושבים ותיקים; השני - בכל יום יוצעו למכירה שלוש מאות כרטיסים לתושבים שאינם בעלי מניה, במחיר ממוצע של כרטיס כניסה לפארקים באזור; והשלישי - הפארק יופעל על ידי עמותה נפרדת שתוקם במיוחד (״עמותת פארק המים - יבנה") כאשר בוועד המנהל של העמותה יהיו גם תושבים מיבנה הוותיקה.', 'dspan': (0, 442), 'tokens': [{'id': 1, 'text': 'לצד', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'לצד'}, {'id': (2, 3), 'text': 'הסיוע', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'סיוע', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'obl', 'lemma': 'סיוע'}], 'span': (4, 9), 'dspan': (4, 9)}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (9, 10), 'span': (9, 10), 'lemma': ','}, {'id': 5, 'text': 'התנה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HITPAEL|Number=Sing|Person=3|Tense=Past', 'head': 0, 'deprel': 'root', 'dspan': (11, 15), 'span': (11, 15), 'lemma': 'התנה'}, {'id': 6, 'text': 'שטרית', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 5, 'deprel': 'nsubj', 'dspan': (16, 21), 'span': (16, 21), 'lemma': 'שטרית'}, {'id': 7, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 8, 'deprel': 'case:acc', 'dspan': (22, 24), 'span': (22, 24), 'lemma': 'את'}, {'id': (8, 10), 'text': 'אישורו', 'expanded': [{'id': 8, 'text': 'אישור_', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Def|Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'obj', 'lemma': 'אישור'}, {'id': 9, 'text': '_של_', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case:gen', 'lemma': 'של'}, {'id': 10, 'text': '_הוא', 'upos': 'PRON', 'xpos': 'P