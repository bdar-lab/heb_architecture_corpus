# file = txt/1500259.txt
# filelineno = 373
# sentno = 1
# text = אלא בעוד שהשינוי שאליו דחפו תושבי השכונה הצבאית והסטנדרטים החדשים ששאפו ליישם ביבנה, יחד עם יישום המדיניות האינטגרטיבית גם בתחומי הפוליטיקה התקבלו בברכה אצל חלק מהתושבים, מצד קבוצות אחרות בעיר הם עוררו הסתייגות בשל חשש מפני שינוי אופיה של העיירה וכן דאגה מפגיעה בתפקידם של עובדי המועצה מהשכונות הוותיקות.
