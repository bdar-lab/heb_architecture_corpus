# file = txt/1500259.txt
# filelineno = 72
# sentno = 1
# text = חשוב לציין כי חוות הדעת המקצועית אינה עולה בקנה אחד עם דעת הקהל הישראלי, ויעידו על כך הדרישה הבלתי פוסקת לבתים צמודי קרקע בבניה עצמית,14 וסיקור התופעה במגזינים ובמדורים העוסקים באדריכלות ובעיצוב.
