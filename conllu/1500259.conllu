# file = txt/1500259.txt
# filelineno = 81
# sentno = 2
# text = בשל הרצון להבנייה של תחושת שייכות קולקטיבית ובשל השאיפה לעיצוב מחדש של דמות היהודי הישראלי על פי אמות המידה המודרניות והיהודיות-אירופיות לרוב שנטוו בתקופת היישוב (,1954 Eisenstadt ; סבירסקי, 1981 ; שנהב, 2002) הוחלפו המסורות האדריכליות המזרחיות בסגנון המקומי (השיכוני) ונכפה סגנון חיים זר על מי שהיו מורגלים בהרגלי חיים מזרחיים (שדר, 2006).
