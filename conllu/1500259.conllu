# file = txt/1500259.txt
# filelineno = 27
# sentno = 6
# text = הגיוון העירוני מתייחס לריבוי קבוצות ה״אחרים״ בעיר, שכן העיר, לפי וירת׳ (1938 ,Wirth), מאגדת בתוכה אנשים מקטגוריות שונות ומגוונות החיים יחד בצפיפות, ובשל כך נוטים להתבחן ולשמור על איזון בין רצון לשתף פעולה ובין האנטגוניזם שהן רוחשים זה לזה.
