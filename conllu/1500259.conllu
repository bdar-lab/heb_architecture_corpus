# file = txt/1500259.txt
# filelineno = 10
# sentno = 2
# text = סוגיה זו אף עלתה לאחרונה לכותרות בהקשרים של מעבר מחנות צה״ל לנגב (אהרון גוטמן, 2017 ; חודי, 2008 ; מרמור, 2012) וכיום משווקים על ידי עמותות המגורים של צה״ל פרויקטים למגורי אנשי קבע בדרום, בבנייה צמודת קרקע (נאות שבולים ונאות ענבלים בבאר שבע, נאות חיטים בעומר, נאות יעלים במיתר, נאות רימון ונאות עופרים בכרמית, צהלה בירוחם), וגם בבנייה רוויה (נאות הכוכב ונאות הנוף בשכונת רמות בבאר שבע).
