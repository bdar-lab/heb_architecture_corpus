# file = txt/1500134.txt
# filelineno = 27
# sentno = 2
# text = שינויים אלה במבנה העירוני לצד שיפורים טכנולוגיים אחרים הוציאו בהדרגה את הפעילות הגופנית מחיי היום־יום באמצעות מגוון תהליכים, כגון: הגדלת המרחק בין הבית לעבודה, הגברת התלות ברכב פרטי (והמרת הליכות בנסיעות), ריבוי עבודות שאינן כרוכות במאמץ גופני, ׳מיכון׳ עבודות הבית, וריבוי עיסוקי פנאי הכוללים ישיבה.
