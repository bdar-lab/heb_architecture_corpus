# file = txt/1500134.txt
# filelineno = 176
# sentno = 2
# text = לפי התיאוריה, התנהגות מוכתבת על ידי כוונות התנהגות (behavioral intention), אשר, בתורן, מושפעות משלושה גורמים:(1) עמדות כלפי ההתנהגות, למשל אמונה שפעילות גופנית תוביל לשיפור בכושר הגופני ובבריאות, ואמונה שכושר גופני גבוה ובריאות טובה זה חיובי וחשוב;(2) נורמות סובייקטיביות ונטייה של הפרט להיענות לנורמה, למשל אמונה שאחרים משמעותיים מייחסים חשיבות לפעילות גופנית ומצפים מהפרט לבצע פעילות גופנית; ו-(3) שליטה בהתנהגות הנתפסת המורכבת מתפיסת גורמים מעודדים ומעכבים של פעילות גופנית ותפיסת המשקל היחסי של כל גורם, למשל ריבוי מסלולי ריצה כגורם מעודד והיעדר תאורת רחוב כגורם מעכב.
