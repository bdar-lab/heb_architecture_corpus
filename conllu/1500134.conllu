# file = txt/1500134.txt
# filelineno = 271
# sentno = 1
# text = בסקירת הספרות זוהו שלוש קטגוריות של מחקרים אמפיריים שבחנו את הקשר בין הסביבה הבנויה לבין פעילות גופנית (תרשים 9) : (1) מחקרים על הקשר בין סביבת מגורים ואורח חיים פעיל - מחקרים אלו הינם השכיחים ביותר, מדובר במחקרי חתך (cross sectional) שמתמקדים בשכונות מגורים ובביצוע פעילות גופנית יום־יומית על-ידי תושבים;(2) מחקרים על הקשר בין נגישות למוקדי פעילות (יעדי יוממות ומרחבי פנאי) לבין ביצוע תחבורה פעילה ופנאי פעיל ־ מחקרים אלו שכיחים פחות, והם מתמקדים בפעילויות ספציפיות במרחבים ספציפיים; ו-(3) מחקרים על שינוי סביבתי ותיעוד שינוי בפעילות גופנית ־ מחקרים אלו נדירים יחסית, והם מתמקדים בהשוואת פעילות גופנית לפני ואחרי שינוי סביבתי באופן פרוספקטיבי או רטרוספקטיבי.
