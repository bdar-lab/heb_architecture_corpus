# file = txt/1500134.txt
# filelineno = 19
# sentno = 1
# text = מתירנות ההורים לעצמאות מרחבית של הילד נמצאה כמתווך בין זמינות שצ״פ ומאפייני המרקם הבנוי לבין פעילות גופנית בקרב ילדים - נמצא כי בסביבות המאופיינות בריבוי שצ״פ ובמרקם בנוי משתרע (ערכים נמוכים של צפיפות מגורים, קישוריות רחובות ותכסית בינוי), הורים נוטים יותר להרשות לילדיהם להסתובב לבד בשכונה, וכפועל יוצא ילדיהם מבצעים יותר פעילות גופנית בשגרה היומית (רכיבת אופניים ומשחקי חוץ).
