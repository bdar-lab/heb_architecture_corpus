# file = txt/2000140.txt
# filelineno = 297
# sentno = 1
# text = להידרדרות הפיזית של בנייני מגורים השפעה מידית גם על הידרדרות סביבת המגורים כולה, תהליך אשר תועד במחקרים רבים שהוצגו בפרק הקודם (לדוגמה: 1991 ,Kaplan, 1991 ;Cars; 1992 ,Carmon; ארז, 1996) תהליך זה אף מתעצם עם השנים, עם העלייה בנטל התחזוקה של המערכות בבניינים הגבוהים, כתוצאה מהתיישנותם.
