# sentno = 1
# text = ויטק ואלתרמן (1986) במאמרן רואות בשאלה הנ״ל משמעות רבה לבעל הקרקע, כיוון ששינוי היעוד מוריד באופן משמעותי את ערך הקרקע וההמתנה להפקעה שעלולה לעיתים להתארך, פירושה שהבעלים ישארו כל אותה עת עם קרקע שירד ערכה ואין לה קונים; ואילו בבוא מועד ההפקעה יחושבו הפיצויים לפי ערך הקרקע ביעודה החדש, משום שהתאריך הקובע לפיצוי בגין הפקעה על פי פקודת הקרקעות הוא יום פרסום הודעת ההפקעה השווי יחושב על פי שווי הנכס ערב ההפקעה ולאחריה, וכך יהיה הפיצוי נמוך מאוד (ראה המחשה בתרשים 4.1).
