# file = txt/2300144.txt
# filelineno = 430
# sentno = 1
# text = ב־ 30 באוקטובר 1982, הוקמה "ועדת המעקב העליונה ־ לערבים בישראל", ארגון זה כלל בתוכו את וועד הרשויות המקומיות הערביות, את כל הגופים והאישים המייצגים את האוכלוסייה הערבית בישראל: חברי כנסת ערבים, הועד להגנה על האדמות הערביות, הועד הארצי של הסטודנטים הערביים, הוועד הארצי של תלמידי התיכון הערביים, מפלגות ותנועות ערביות שלא מיוצגות בכנסת, ועוד.
