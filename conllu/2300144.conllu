# file = txt/2300144.txt
# filelineno = 21
# sentno = 2
# text = אלתרמן וויטק (1989) מונות מספר סיבות לכך, שעיקרן: המדינה קטנה ולקרקע יש מחיר גבוה ומתחרים רבים וקשה להנהיג מסירתה מרצון כחלק מנוהג של פיתוח מקובל; השלטון המקומי בישראל חלש ו״מסכן" באופן קיצוני, מקורותיו הכספיים העצמיים דלים, אי־לכך חסרה מדיניות של רכישת קרקעות מראש ע״י הרשויות המקומיות בשלב כשוויץ עדיין נמוך; חלוקת התפקידים בין השלטון המרכזי וספיחיו לבין השלטון המקומי היא כזו, שאת בנייתם והפעלתם של חלק חשוב משרותי הציבור נוהג השלטון המרכזי לממן, בעוד נושא הקרקעות נותר כל כולו באחריות השלטון המקומי דל המשאבים.
