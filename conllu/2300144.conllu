# file = txt/2300144.txt
# filelineno = 440
# sentno = 2
# text = מאבק זה נתהווה, בין היותר, בגלל גורמים היסטוריים, שהם משטר אגרארי כושל בתקופה העותמאנית ־ בתקופה בה התפתחה הבעלות הפרטית על הקרקע, רישום קרקעות ומיפויין בימי המנדט, והסדר הקרקעות החד מאז קום המדינה, רישום הקרקעות שהחל בו הנציב העליון בתחילת שנות הארבעים, שנעשה גם בכפרים הערביים, גרם לסכסוך קרקעות בין המועצות המקומיות, שקמו לאחר קום המדינה לבין המדינה (כרמון, מאיר-ברודניץ, יוניש, אלפנדרי, 1992).
