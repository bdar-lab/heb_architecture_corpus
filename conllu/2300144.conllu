# file = txt/2300144.txt
# filelineno = 723
# sentno = 2
# text = התנאי הראשון הוא קיומו של מכנה משותף בין מספר אנשים, התנאי השני לקיומה של קבוצת עניין הוא פיתוח עמדות משותפות, התנאי השלישי הוא קיומה של אינטראקציה בין חברי הקבוצה, התנאי הרביעי הוא להגיע להחלטה לגבי נקיטת פעולה, התנאי האחרון הוא קיומה של פעולה "פוליטית" מכוונת לרשות מחליטה, תהא זו רשות לאומית או מקומית, והמיועדת להשפיע על מדיניות ציבורית; תנאים אלה הופכים אוסף מקרי של אנשים לקבוצות עניין (שם, עמי 12).
