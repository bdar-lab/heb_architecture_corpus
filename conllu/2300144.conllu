# file = txt/2300144.txt
# filelineno = 876
# sentno = 1
# text = מטרת סקר זה היא לבחון את עמדותיהם של ראשי הרשויות המקומיות שנבחרו במדגם, את ממלאי מקומם ו/או את סגניהם, ביחס למדיניות הקצאת קרקע ביישוביהם, את מהותה ועקרונותיה של מדיניות זו מנקודת מבטם, מידת מעורבותם בנושא, עמדותיהם ביחס לכלי ההפקעה כאשר מדובר בקרקע פרטית, עמדותיהם והעדפותיהם לגבי שאר הכלים הקיימים להשגת קרקע, ועוד (ראה : שאלון ״מקבלי ההחלטות, נספח מס׳ 2.2) סקר זה בוצע בעזרת שאלון מובנה בשפה הערבית, וכלל 30 מרואיינים.
