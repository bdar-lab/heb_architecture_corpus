# file = txt/2300144.txt
# filelineno = 908
# sentno = 1
# text = תושבי אום אל־פחם איבדו קרקעות רבות מיד לאחר המלחמה במסגרת העברת הקרקעות של תושבים ערביים נפקדים ־ שרובם המוחלט נוכחים, לידי האפוטרופוס הכללי, אח״כ בשנות ה־ 60 וה־ 70 איבד הישוב קרקעות נוספות כתוצאה מפעולות שונות בהן נקטה המדינה.
