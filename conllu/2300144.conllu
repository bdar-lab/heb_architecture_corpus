# file = txt/2300144.txt
# filelineno = 1016
# sentno = 1
# text = על מנת לבחון אם כמות הקרקע המתוכננת ־ בתכניות המדגם מספיקה, חישבנו את שטחי הקרקע הדרושים עפ״י ״מכסות קרקע לתכנון שירותי ציבור״ (אלתרמן, היל, 1984) ואח״כ השווינו בין כמויות השטחים הדרושים לבין המתוכננים.
