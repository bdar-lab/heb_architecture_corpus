# file = txt/2300144.txt
# filelineno = 879
# sentno = 1
# text = מטרות הסקר הן: לבחון את עמדותיהם של בעלי הקרקע ביחס להקצאת קרקע שבבעלותם, לבחון את מידת הפגיעה בהם, מידת שיתופם ע״י הרשויות הציבוריות בעת קבלת החלטות הנוגעות לנכסיהם, דעתם בנושא קיומם של שיקולים זרים בעת ההקצאה, קיומן של אפשרויות להגנה מינהלית ושיפוטית, ועוד שאלות הקשורות ליעדיהם (ראה: שאלון "בעלי הקרקע הפרטיים, נספח מס׳ 2.4).
