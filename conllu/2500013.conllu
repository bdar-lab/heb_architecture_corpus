# file = txt/2500013.txt
# filelineno = 163
# sentno = 4
# text = משיחות לא רשמיות מתקבל הרושם שבריב המקרים מדובר בנסיון שנרכש עם הזמן במקצי ף מסויים שאת המתכון שלו נתן היה לקנות או לחקות , בתערובת מסוימת ,בשיטת הכנה מסויימת, מבלי שלמפעיל יש ידע מספיק בתהליך הטכנולוגי הקובע, ובתכונות הרלונטיות הנדרשות ואמנם יה לאחר הכנת מפרט חדש לבטון מוקצף ־ *־־ שקובע דרישות לבטון מוקצף לבידוד גגות, לתהליך הכנתו ובקרתו, ולאחר שהתחילו לבצע בדיקותסיסטמטל ות יותר באתר׳ הבניה להתאמת הבטון המוקצף לדרישת המפרט נמצא, שקלים פיזור גדול הו כחוזק והן במשקל המרחבי המתקבלים
