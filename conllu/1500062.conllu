# file = txt/1500062.txt
# filelineno = 578
# sentno = 4
# text = במטרה להבין את נקודת מבטם של המשתמשים ביחס למערכת נערכו ראיונות חצי מובנים, בהם הוצגו שאלות פתוחות שכיוונו את האינפורמנטים לנושאים הרלוונטיים למחקר, סייעו להם להבנות את סיפוריהם ועזרו לי כחוקרת להבין את החוויה שלהם בשימוש במערכת ואת המשמעות שהם מייחסים לחוויה הזאת.
