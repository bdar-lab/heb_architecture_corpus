# file = txt/1500180.txt
# filelineno = 112
# sentno = 3
# text = מעבר לכך שגישה זו מסתמכת על הלקחים שהופקו מהתקופה בה התמקדו ניסיונות השיקום העירוני בפינוי מאסיבי של תושבים, הריסת המבנים הקיימים ושיקום מחודש של הדיור, היא גם תולדה של שינויים חברתיים וכלכליים שונים, מבין אלו ניתן למנות: צמיחה כלכלית, הגדלת הניידות החברתית של אוכלוסיות שונות ומודעות גוברת לנושאי זכויות אזרח (התפתחות משמעותית של תנועות ל"זכויות-אזרח" ואנטי מלחמתיות, אנטי ממסדיות בתקופה זו, בין השאר בהשפעת מלחמת וייטנאם ומאבק האפרו-אמריקאים לשוויון זכויות).
