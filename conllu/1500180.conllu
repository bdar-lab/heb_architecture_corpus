# file = txt/1500180.txt
# filelineno = 293
# sentno = 9
# text = מצד שני ראוי לציין כי הכמות הקטנה של אזורים סטטסיטיים שנדגמה באזורי הפריפריה בייחוד במחוז הצפון בשל מגבלות זיהוי אזורים סטטיסטיים בנויים במלואם, ייתכן ולא משקפת באופן מלא את ההתרחשות של תהליכים אלה באזורים אלה, לעומת דגימה טובה של אזורים סטטיסטיים במרכז הארץ שמספקת לכן תמונה מהימנה של התופעה באזורים אלה.
