# file = txt/2500062.txt
# filelineno = 399
# sentno = 2
# text = לצורת השימוש של הסיליקונים יש ערך מכריע ביחס ליעילותם המידית ולקיים הצפוי שלהם־ על מנת להבטיח את היעילות המקסימלית יש למרוח את השטח המטופל בכמויות חומר עודפות שיציפו את פני השטח ויחדרו לעומק מקסימלי־ דבר זה דרוש כדי ליצור שכבה עבה ורציפה ככל האפשר של חומר המצופה בקרום סיליקוני־ בכל מקרה רצוי טיפול בשתי שכבות על מנת להבטיח את רציפות הקרום הסיליקוני ובמיוחד חשוב הדבר בזמן טיפול בסיליקון בתמיסה אורגנית־ המריחה השניה צריכה להעשות כאשר חלק גדול מהנוזל הממים של השכבה הראשונה התנדף ופנה את השטחים והחללים שהוא תפש ולפני שהסיליקון שבשכבה הראשונה יצר קרום אינרטי־ זאת על מנת להבטיח הדבקות השכבה השניה אל השכבה הראשונה, סתימת המרווחים הבלתי מכוסים ויצירת קרום סיליקוני רציף־ פרק זמן של 24 שעות בין המריחה הראשונה והשניה בתנאי לחות יחסית של 6576 וטמפ' של 20^ C הוכח כמתאים על פי תוצאות הניסויים במסגרת עבודה זו־ בזמן מריחת הקירות שנבדקו , הוכח כי לא קיימת שום בעיה בזמן מריחה שניה של סיליקון בתמיסה אורגנית והקיר סופג יפה את החומר־ לעומת זאת, מריחה שניה של סיליקונט בתמיסה מימית היא קשה משום שבמרי חה השניה החומר לא נספג אל תוך הקיר, רובו ניגר על פניו ורק ח לק קטן חודר לתוך הנקבובים־ דבר זה גורם לבזבוז רב בחומר ולכן רצוי להשתמש עבור השכבה השניה בכמויות קטנות יותר של החומר.
