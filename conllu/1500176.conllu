# file = txt/1500176.txt
# filelineno = 330
# sentno = 2
# text = התכנית מתווה כללים לשמירת אופי זה הכוללים את חובת הבנייה מאבן תוך פירוט של סוג האבן והחומרים האסורים לשימוש, הגבלות הבנייה וגובה הבנייה ליד חומות העיר העתיקה הן מבפנים והן מבחוץ, וכללים העוסקים בפרטים כמו בקרה על צורות השלטים ומיקומם, הגבלת התקנה של קווי טלפון וקווי חשמל על עמודים, פיקוח על צורות האנטנות לרדיו ולטלוויזיה, איסור על התקנת דודי שמש שאינם מוסתרים וקביעת אופי עמודי ופנסי התאורה.
