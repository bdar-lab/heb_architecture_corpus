# file = txt/1500176.txt
# filelineno = 402
# sentno = 1
# text = העבודה על תכנית עמ/9 לתכנון העיר העתיקה וסביבותיה התנהלה במקביל להכנה של תכנית האב לירושלים בין השנים 1964 ל-1968, תכנון העיר העתיקה אותו הוביל ברוצקוס עקב אמנם אחר עקרונות התכנון שהתוותה תכנית האב אך היה שונה ממנה לחלוטין ברוחו.
