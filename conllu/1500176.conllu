# file = txt/1500176.txt
# filelineno = 197
# sentno = 9
# text = השימוש בכיפה גדולה בבית כנסת ברחביה שתכנן קאופמן ב-1923, הכיפות של הדסה הר הצופים שתכנן מנדלסון ב-1936 כחלק מן השפה המודרנית והנקייה שלו, קירות האבן בבית בועזסון שתכנן קרקואר ברחביה ב- 1939, קירות בהן בחר קרקואר בקפידה סוגי אבנים שונות, בעלות צבעים, טקסטורות וגדלים מגוונים על מנת ליצור קומפוזיציה מקורית94, כל אלה מהווים ביטוי לרצון ליצור שפה וזהות אדריכלית אחרת, בעלת מטרות שהיו זרות לתפיסתם של הארכיטקטים המודרניים האחרים שפעלו בארץ, כמו הניסיון להעביר מסר רוחני דרך הארכיטקטורה או הרצון ליצור זהות מזרחית מהותית ולא אקלקטית.
