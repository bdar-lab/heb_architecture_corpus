# file = txt/1500176.txt
# filelineno = 45
# sentno = 3
# text = כך שלמעשה, טוען קלהון (Colquhoun), תנועת הרפורמה האמנותית בגרמניה הייתה קשורה מתחילתה בשאלות של זהות לאומית, ואנשי התנועה נעו בין מודרניזציה ובין רצון לחזור לשורשים טרום תעשייתיים, וכך חדרו בסופו של דבר ערכי הפולק אל תוך בסיס האוונגרד.
