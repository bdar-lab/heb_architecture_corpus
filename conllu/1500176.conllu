# file = txt/1500176.txt
# filelineno = 229
# sentno = 1
# text = הנטייה הגרמנית בבינוי הערים שמה דגש על המקום וההעמדה על הקרקע של המבנים הפיזיים עצמם, מסיטה ועד ה-Siedlungen, הדגש על תלת הממד והמרחב בתכנון תופש מקום חשוב, אך בעוד שפתו של סיטה היא רומנטית ושמה דגש על החוויה, התנועה, הגילוי וההפתעה, כפי שניתן לראות ברבים מערי הגנים שנבנו בתחילת המאה, בתקופה המאוחרת יותר השפה הפורמלית של ה-Siedlungen, מציבה את המבנים על הקרקע עפ״י פרמטרים אובייקטיביים ומדעיים בלבד.
