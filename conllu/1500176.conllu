# file = txt/1500176.txt
# filelineno = 131
# sentno = 8
# text = 61 הזהות הציונית של הציונים יוצאי המרחב הדובר גרמנית נמצאת במתח אם כן בין האינדיבידואלי והקולקטיבי הן מבחינה רעיונית והן מבחינה חברתית, הם מפתחים מעין זהות בתוך זהות תוך שימת דגש על מקומו של האינדיבידואל במעשה הלאומי בניגוד לתפיסה הקולקטיבית הרווחת ביישוב.
