# file = txt/1500176.txt
# filelineno = 172
# sentno = 7
# text = הארכיטקטורה שברוצקוס יוצר מסוגלת להכיל את הניגודים שפולציג בגלל המחויבות שלו למסורת לא היה יכול לעשות, כך למשל בבניינים של ברוצקוס אפשר לראות שילוב בין שימוש באבן כבדה ו׳מסורתית׳ ובין שימוש באבן מסותתת וקלה בין קורות בטון במראה מודרני מובהק.
