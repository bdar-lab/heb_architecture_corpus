# file = txt/1500176.txt
# filelineno = 228
# sentno = 2
# text = ברוצקוס יצר בקריית הממשלה יחידה מלבנית בסיסית מוארכת בעלת שפה פשוטה ונטולת קישוטיות ועסק בהעמדה של מספר יחידות כאלו כמערך בתוך סביבה מסוימת, כאשר בין המבנים יצר חללים ציבוריים פתוחים וגדולים, דבר המאפיין את שכונות ה- Siedlung ואת המתח שבין הבנוי והטבעי אותו הם ירשו מערי הגנים.
