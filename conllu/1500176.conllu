# file = txt/1500176.txt
# filelineno = 379
# sentno = 1
# text = לכאורה נראה כי העיסוק של ברוצקוס במרקם כולו ולא רק במונומנט ושימת הדגש על השפה המקומית קשורה ומושפעת מרוח הזמן באדריכלות בכל הנוגע לעיסוק במקומיות, ומרוח אמנת ונציה והתייחסותה למרקם העירוני, אך למעשה ברוצקוס תמיד שם דגש, עוד שנים רבות לפני כן, על המקום והשפה שלו, על היומיום, ועל השתלבות הבניין בפסיפס העיר.
