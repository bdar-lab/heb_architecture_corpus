# file = txt/2300173.txt
# filelineno = 145
# sentno = 1
# text = ההפחתה המשמעותית בשיעור הגידול של האוכלוסייה היהודית במחוז לשנת 2020 נובעת מההנחה שעד לתחילת שנות האלפיים שיעורי ההגירה של האוכלוסייה היהודית אל מדינת ישראל יהיו גבוהים יחסית, בהיקף ממוצע של כ־50 אלף עולים בשנה, ומכאן שניתן יהיה למלא את חלקו של מחוז צפון בדומה לחלק אשר יועד לו במקור על ידי התוכנית.
