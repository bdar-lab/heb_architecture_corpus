# file = txt/2300173.txt
# filelineno = 5
# sentno = 5
# text = מאז סוף שנות ה־80, עם תחילת גלי העלייה מברית המועצות לשעבר ואתיופיה, החלו להגיע ולהיקלט במחוז הצפון עשרות אלפי עולים חדשים שהפיחו חיים ותקוות חדשות לעתיד טוב יותר שיבוא לידי ביטוי בפיתוחו הכלכלי-חברתי של המחוז.
