# file = txt/1900044.txt
# filelineno = 356
# sentno = 1
# text = (א)	בקשה להיתר לשינוי או לתוספת לדירת מגורים קיימת מהוונת בבנייה רוויה; לעניין זה, "בנייה רוויה" – בנייה למגורים של 2 קומות לפחות, שיש בה לא פחות מ-4 דירות – דירה אחת לפחות בכל קומה, הרשומות כבית משותף כהגדרתו בחוק המקרקעין, התשכ"ט-1969, או ראויות להירשם כבית משותף לפי סעיף 142 לחוק האמור;
