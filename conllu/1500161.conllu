# file = txt/1500161.txt
# filelineno = 16
# sentno = 1
# text = בשנת 1963 בארגנטינה, בעוד תכנית האב של לה-קורביזיה לעיר הבירה בואנוס א״רס עמדה להתבטל סופית, במקום אהר במדינה - בפרובינצ״ת קטמרקה הצהיהה והנידהת - אושרה ועמדה להתממש יוזמה תכנונית אזורית רהבת היקף מבית היוצר הישראלי.
