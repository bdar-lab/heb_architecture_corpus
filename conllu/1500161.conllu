# file = txt/1500161.txt
# filelineno = 472
# sentno = 1
# text = לפי התכנית האינטגרלית שנעשתה על ידי הצוות האינטר דיסציפלינארי בין 1963 ל-1966, היה על היישובים החדשים בלאס פירקיטס לעמוד בשישה כללים בסיסיים: (1) התכנית האזורית תהיה מחויבת לכלול לכל הפחות 500 משפחות; (2) נוסף למושבות, יש לתכנן מספר מוקדי שירות ולפחות מרכז אזורי אחד; (3) היישוב הטיפוס׳ צריך לכלול לפחות שמונים משקים משפחתיים המוגדרים כ"יחידות משפחתיות"; (4) על מוקדי השירות והמרכז האזור׳ לכסות את מרב הצרכים החברתיים והכלכליים היום יומיים; (5) יש לספק מ׳ שתייה וחשמל בעוצמה תעשייתית לכל משק; (6) יש לרכז את המשקים ולחלקם לשני צדדים: האחד ("פרטי-חברת,") יפנה לחזית שתוביל אל מוקד השירות והעורפ׳ יהיה קשור לחלקו החקלאי של המשק, תוך המנעות מפיזור המשקים בהנחה כ׳ הקרבה הפיזית הינה ^ובית (1966 ,Equipo tecnico Argentine Israeli).
