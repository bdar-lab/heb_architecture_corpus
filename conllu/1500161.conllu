# file = txt/1500161.txt
# filelineno = 598
# sentno = 1
# text = ההפנמה המושגית העמוקה של התכנים הישראליים על ידי הצוות הארגנטינאי משתקפת בהשוואה בין הספר על אודות פרויקט לאס פירקיטס (1966 ,Equipo tecnico Argentine Israeli), אשר נוסח והופק על ידי הצוות הארגנטינאי לאחר עזיבתו של הצוות הישראלי, לבין החומרים הישראליים שתורגמו לספרדית.
