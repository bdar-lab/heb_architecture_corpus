# file = txt/1500161.txt
# filelineno = 400
# sentno = 2
# text = על מנת לשחזר את הקשר בין מש״ב לארגנטינה, שהיווה את הרקע לפרויקט הנחקר, היה צורך להסתמך על מעט החומרים הכתובים שנשמרו: התכתבויות דיפלומטיות מתוך תיק׳ מש״ב בארכיון המדינה, שרטוט׳ הפרויקט ופרקים קצרים מטקסטים אוטוביוגרפיים וראיונות עם אנשים שלקחו חלק בפרויקט, הן מהצד הישראלי והן מהצד הארגנטינאי.
