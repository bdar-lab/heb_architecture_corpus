# file = txt/1500161.txt
# filelineno = 21
# sentno = 1
# text = חשיבותו המיוחדת של הפרויקט התכנונ׳ "לאס פירקיטס" בפרובינצ״ת קטמרקה, שמש״ב ביצע ובו מתמקד מחקר זה, נובע מכמה וכמה סיבות: מעמדה המיוחד של ארגנטינה בקרב מדינות אמל״ט (ארגנטינה הייתה המדינה האמל"טית המפותחת היחידה ביבשת), קשרי הידידות ההדוקים בין ישראל לארגנטינה (ארגנטינה הייתה המדינה האמל"טית הראשונה לקיים יחסים דיפלומטיים עם ישראל), המשבר הרגעי בין המדינות כתוצאה מחטיפת אדולף א״כמן והצורך בשיקום מהיר של היחסים, וכן התרומה התכנונית הפוטנציאלית הגלומה בניסיון המש״ב׳ והנכונות הארגנטינאית לאמץ את המערך הארגוני של חבלי התיישבות ישראליים - בצורה של מושבים, מרכזי שירות, מרכזים אזוריים ופיתוח תפיסה חדשה על אודות תכנון המשק המשפחתי.
