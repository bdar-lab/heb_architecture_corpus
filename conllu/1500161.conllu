# file = txt/1500161.txt
# filelineno = 130
# sentno = 1
# text = האירוע המכונן בתולדות הפיתוח באמריקה הלטינית היה הכנס של הוועד הבין אמריקני הכלכלי-חברת, (CIES), שהתקיים בשנת 1961 בעיר פונטה דל אסטה אשר באורוגוואי, בנוכחות נציגים ממדינות אמל״ט, הנשיא האמריקני גיון קנדי והנציג הקובני ארנסטו ציה גווארה.
