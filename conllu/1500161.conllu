# file = txt/1500161.txt
# filelineno = 453
# sentno = 1
# text = לפי הדו"ה, העיר קטמרקה היתה מורכבת אז ממעמד גבוה ממוצא אגרר׳ שעסק במקצועות nופש״ם; מעמד ביניים המורכב מאנשי מקצוע, סוהרים ועובדי ציבור השואפים להתקדם ולהגיע למעלה בפירמידה; מעמד בינוני הלש המורכב מבעלי מקצועות ומלאכה ועובדים שהיגרו מפרובינציות אהרות; מתהתיו מעמד בינוני-נמוך המורכב מעובדים בהמיות, סוהרים פשוטים (רובם ממוצא ספרדי, איטלקי וערבי), עובדי ציבור מוהלשים ופועלים; ולבסוף - העניים, הלקם אף ה״ם בשכונות עוני.
