# file = txt/1500161.txt
# filelineno = 525
# sentno = 4
# text = האדם הנבהר היה המהנדס מריו פולקר וכעבור זמן קצר הוא אישר כ׳ פרויקט לאס פירקיטס הוא פרויקט ראוי ונכון על כל רבדיו(Colonizacidn del 1987 ,Valle de Catamarca); וכי הפרויקט יהווה נקודת ציון להתיישבויות עתידיות לטובת השיפור הכלכלי בפרובינציה.
