# file = txt/1500229.txt
# filelineno = 568
# sentno = 4
# text = 505 בתי הפקידות היו ביטוי לתקוות לאומיות של הקהילה: "בית הפקידות" היה כאילו אתה אומר - "בית הממשלה", העיד אחד המתיישבים בראשון לציון, כשהוא משווה בין הפקיד למושל ומביע בקול רם את שאיפותיהם המתעוררות של אנשי המושבות לשלטון עצמי באדמתם הישנה.
