# file = txt/1500229.txt
# filelineno = 427
# sentno = 7
# text = הסדרת הצנרת שהובילה את המים מהמעיין לרחובות זכרון יעקב הסתיימה רק שש עשרה שנים לאחר ייסוד המושבה, בשנת תרמ״ח (1898), בתום חפירתה של הבאר החדשה בנזלה, ככל הנראה בסיועו של המהנדס אברהם שטרקמאט (איור 34).
