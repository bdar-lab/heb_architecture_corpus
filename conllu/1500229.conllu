# file = txt/1500229.txt
# filelineno = 415
# sentno = 2
# text = 315 היוזמה להקמה של סבילים הייתה של שליטים מקומיים ובעלי שררה, כמו למשל "סביל אבו נבוט" (1815), שהוקם על ידי מחמוד אגא א-שאמי ("אבו נבוט") על ציר הדרך מיפו לכיוון רמלה, לוד וירושלים (איור 33) 316; "סביל סובייח" שהוקם על ידי בעל אדמות מעשירי לוד, על אם הדרך מדרום העיר לכיוון בן שמן317 ו״סביל מוראד״ - בצמוד לביתו המפואר של שיח מוראד בפאתי יפו, שחזיתו פנתה לדרך הראשית העוברת בסמוך.
