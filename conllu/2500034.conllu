# file = txt/2500034.txt
# filelineno = 122
# sentno = 2
# text = במקרה אחד הוילון קבוע מאחורי הזכוכית במקדה שגי, הוילון הוא חפשי ואפשרית קביעת הוילון בגבהים שוגים, זאת אומרת, גתגת אפשרות של אורור האזור שבין זכוכית ווילון וגם אפשר להשאיר חלק משטח החלון גלוי לקרגי השמש־ המדידות כללו את הקריגה הישירה והמרכיב של הקריגה המפוזרת, את הטמפרטורות של האתר החצוגי, של הזכוכית, של אמצעי הצללה ושל האויר שבין וילון הגלילה הפגימי והזכוכית, בכללו גם מדידות רגילות של זרימת חום, המבוצעות בקלורימטר־ התוצאות של המחקר עם וילון גלילה מתיחסות לחמישה חומרים שוגים, וגיתגו כהדרכה לחשוב כמות החום והקריגה החודרות דרך מערכת זכוכית-וילו ן־ געשו הפשטות כדי להקל על חשוב מעבר חום ונתקבלה משואה הגותגת את הכמות הכללית של חום החודרת דרך מערכת זכוכית - וילון - גלילה, בתבאי טמפרטורת פגים קבועה:
