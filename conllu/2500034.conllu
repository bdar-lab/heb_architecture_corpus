# file = txt/2500034.txt
# filelineno = 299
# sentno = 1
# text = הצללה הוריזובטלית אין סופית מחדיר קצת יותרקריבת שמש בקיץ מחלון הוריזובטלי עם הצללת מסגרת ושבי טפוסים אלה משתוים למעשה בספטמבר, אך בחורף חלון עם הצללה הוריזובטלית אין סופית מחדיר הרבה יותרקריבת שמש מכל שאר החלובות־ מכאן ביתן לראות שבמהלך שבתי קשה לקבוע עדיפות של אחד משבי טפוסי הצללה הללו, כיון שהצללת מסגרת יותר יעילה בקיץ והצללה הוריזובטלית אין סופית יעילה יותר בחורף־ חלון ורטיקלי עם ה צללת מסגרת דומה בהשפעתו בקיץ ובסתו לחלון הוריזובטלי עם הצללה הוריזובטלית אין סופית־ לעומת זאת בחורף הוא מפחית מאד את קריבת השמש, יותר מכל טפוסי החלובות האחרים, כך שבמהלך השבתי הוא פחות רצוי מחלון הוריזובטלי־ חלון ורטיקלי עם הצללה ורטיקלית אין סופית מחדיר את כמות הקריבה הגדולה ביותר בקיץ (יותר מכפליים מכל אחד מהטפוסים האחרים)־ בסתו ההבדל יותר קטן, אם כי גם כאן כמות הקריבה החודרת היא הגדולה ביותר־ לעומת זאת בחורף חלון כזה מחדיר כמות קריבה קטבה כמעט כזו של חלון ורטיקלי עם הצללת מסגרת־ ביתן, איפוא, להסיק שחלון ורטיקלי עם הצללה ורטיקלית אין סופית הוא הפחות מתאים מבין אלה שבסקרר בפרק זה־ למסקבה זו חשיבות מיוחדת כיון שבין ארכיטקטים רבים מקובלת, משום מה, הדעה שדוקא טפום זה הוא המתאים ביותר לכוון מזרחי ומערבי־
