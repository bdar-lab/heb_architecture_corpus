# file = txt/1500210.txt
# filelineno = 109
# sentno = 9
# text = יעוד זה טמון ביכולת לאתר מקומות שנעשה בהם שימוש רב-משמעי ולא מודע במילות מפתח, או בהצבעה על מבוכה לוגית (אפוריה) בטקסט, פער בין מה שצריך היה להיות כתוב ־ כתוצר של ניתוח שיטתי - לבין מה שמיוצר בפועל בפרקטיקה של הכתיבה.
