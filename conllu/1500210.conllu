# file = txt/1500210.txt
# filelineno = 495
# sentno = 9
# text = חיסרון נוסף בספרים האישיים נובע מהטיית תיאור הנראה בדרך עבור קהל קוראים מסוים כמו למשל בתיאור שירת העפרוני: « ואלפי עפרונים, שהופרעו על ידינו, התעופפו אלעל, אך מגרונם לא בקעה השירה המתוקה כשל העפרונים בשדות התירס באנגליה״ (ציטוט 225) (בן אריה, 1986:168).
