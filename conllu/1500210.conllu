# file = txt/1500210.txt
# filelineno = 229
# sentno = 1
# text = על פי האנט תנועת המסע שהתפתחה בנוף הינה פרקטיקת תנועה ריטואלית (Ritual) העוקבת אחר שביל ומטרה שנועדו לכך מראש; תנועת המסע בנוף התפתחה כחלק מרוח תקופת ה״רנסנס", בה התחדשה ההתעניינות בעולם הקלאסי58, שבמסגרתה התקבעה מסורת ה-"Grand Tour"- טיול שהיה נפוץ בין השנים 1600 עד לשנות ה-40 של המאה ה-19 ונערך על ידי גברים צעירים מהמעמד הגבוה באירופה ברחבי היבשת.
