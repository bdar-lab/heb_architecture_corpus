# file = txt/1500210.txt
# filelineno = 283
# sentno = 1
# text = על פי מילון המונחים המקיף ביותר לשימור המורשת הבנויה68 בעריכת יעל אלף, המתאר את מגוון הפעילויות והתפיסות של השימור והתאמתם לשפה העברית, שימור הינו סך כל התהליכים שתכליתם דאגה למקום כדי לשמר את משמעותו התרבותית (בורה, 1999) באמצעות מכלול פעולות הנוגעות לטיפול בנכס בסביבתו ההיסטורית.
