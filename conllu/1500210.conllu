# file = txt/1500210.txt
# filelineno = 462
# sentno = 6
# text = לונץ מתעלם בכתיבתו גם ממידע על כפרים ערביים ומתמקד בקורות היהודים בלבד כמו בהזכירו רק את בית דגון שליד בית דג׳אן בכותבו על ״הדרך מיפו לירושלם״: "כפרים וערים רבות תעבורנה לפני הנוסע בהדרך הזה, ואנחנו נזכיר פה רק את אלה הנזכרות בכה״ק, תלמוד ומדרש ובכתובים האחרונים וספרי יוסף הכרך״ןלתץ, תרנ״א:82).
