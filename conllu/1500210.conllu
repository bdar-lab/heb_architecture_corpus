# sentno = 1
# text = במהלך המחצית השנייה של המאה ה-19, בעקבות ה״יציאה מן החומות" ביפו ובירושלים, נעשתה הדרך שקישרה בין הערים לציר השידרה המרכזי בהתפתחותן; תחילה התרכזה ההתיישבות מחוץ לחומות העיר סביב ציר הדרך מטעמי ביטחון, פרנסה ונוחות, אולם בהמשך, משעה שהדרך (שנקראה גם דרך יפו) התבססה כציר מרכזי פעיל בין הערים, הוקמו לצידה גם מוסדות ובניינים רבים, ומחירי הקרקע לבנייתם נגזרו ממידת קרבתם לדרך.
# raw = {'id': 1, 'text': 'במהלך המחצית השנייה של המאה ה-19, בעקבות ה״יציאה מן החומות" ביפו ובירושלים, נעשתה הדרך שקישרה בין הערים לציר השידרה המרכזי בהתפתחותן; תחילה התרכזה ההתיישבות מחוץ לחומות העיר סביב ציר הדרך מטעמי ביטחון, פרנסה ונוחות, אולם בהמשך, משעה שהדרך (שנקראה גם דרך יפו) התבססה כציר מרכזי פעיל בין הערים, הוקמו לצידה גם מוסדות ובניינים רבים, ומחירי הקרקע לבנייתם נגזרו ממידת קרבתם לדרך.', 'dspan': (0, 374), 'tokens': [{'id': (1, 2), 'text': 'במהלך', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'מהלך', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'fixed', 'lemma': 'מהלך'}], 'span': (0, 5), 'dspan': (0, 5)}, {'id': (3, 4), 'text': 'המחצית', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'מחצית', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 28, 'deprel': 'obl', 'lemma': 'מחצית'}], 'span': (6, 12), 'dspan': (6, 12)}, {'id': (5, 6), 'text': 'השנייה', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'שנייה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing|NumType=Ord', 'head': 4, 'deprel': 'amod', 'lemma': 'שני'}], 'span': (13, 19), 'dspan': (13, 19)}, {'id': 7, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 9, 'deprel': 'case', 'dspan': (20, 22), 'span': (20, 22), 'lemma': 'של'}, {'id': (8, 9), 'text': 'המאה', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'מאה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'nmod:poss', 'lemma': 'מאה'}], 'span': (23, 27), 'dspan':