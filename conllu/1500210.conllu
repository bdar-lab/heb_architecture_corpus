# raw = {'id': 8, 'text': 'בתיאור הנוף האנושי בדרך רוג׳רס ממעטת לתאר את האוכלוסייה היהודית ולא ברור האם זה מפני שהיא מיעטה להיקרות בדרכה או שהיא פחות התאימה לתיאור האוריינטלי.', 'dspan': (1340, 1488), 'tokens': [{'id': (1, 2), 'text': 'בתיאור', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'תיאור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 10, 'deprel': 'obl', 'lemma': 'תיאור'}], 'span': (0, 6), 'dspan': (1340, 1346)}, {'id': (3, 4), 'text': 'הנוף', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'נוף', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'compound:smixut', 'lemma': 'נוף'}], 'span': (7, 11), 'dspan': (1347, 1351)}, {'id': (5, 6), 'text': 'האנושי', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'אנושי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'amod', 'lemma': 'אנושי'}], 'span': (12, 18), 'dspan': (1352, 1358)}, {'id': (7, 8), 'text': 'בדרך', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 8, 'text': 'דרך', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'nmod', 'lemma': 'דרך'}], 'span': (19, 23), 'dspan': (1359, 1363)}, {'id': 9, 'text': 'רוג׳רס', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 8, 'deprel': 'compound:smixut', 'dspan': (1364, 1370), 'span': (24, 30), 'lemma': 'רוג׳רס'}, {'id': 10, 'text': 'ממעטת', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PIEL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (1371, 1376), 'span': (31, 36), 'lemma': 'ממעטת'}, {'id