# file = txt/1500210.txt
# filelineno = 495
# sentno = 4
# text = אני מניחה שמעצם היותה אחות דיפלומט, הייתה לרוג׳רס גם מודעות גבוהה משל האדם הממוצע לחשיבות הדיווח התקופתי בהקשר ההיסטורי במיוחד לאור העובדה שלא מעט מהנציגים הדיפלומטיים כתבו ספרי מסע וזיכרונות אודות ביקורם ושהייתם בארץ ובמזרח.
