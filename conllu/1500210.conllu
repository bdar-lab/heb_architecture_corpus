# file = txt/1500210.txt
# filelineno = 155
# sentno = 2
# text = J.B Jackson שסקר את משמעויות המילה landscape, השתלשלותה ההיסטורית, מקורותיה בעבר ומופעה העכשווי במאמרו The word itself" טען שלמרות שלהגדרת המילה כיום במילון יש דומיננטיות לעין ולמבט, landscape- בראשית מופעה כמילה בשפה האנגלית - תיארה תמונה של הנוף ולא את הנוף עצמו.
