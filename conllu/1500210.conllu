# file = txt/1500210.txt
# filelineno = 496
# sentno = 2
# text = בשל היותה חלק ממערך דיפלומטי שהגן עליה מתחושות הסכנה הרגילות שאפפו את העוברים בדרכים יש לעמוד על טיבם ומהימנותם המוחלטת של התחושות שאחזו בה בעת ביקורה בארץ שכן, יש לצפות, שתחושות החרדה וענייני הבטיחות בדרך לא באו לביטוי בכתיבתה בעוצמה המופיעה בכתובים אחרים.
