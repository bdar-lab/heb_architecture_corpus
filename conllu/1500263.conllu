# file = txt/1500263.txt
# filelineno = 233
# sentno = 6
# text = קיימות גם הערכות אקולוגיות שמשלבות התייחסות תכנונית, ביניהן סקר שנעשה בבריכות החורף מתחם הלוחמים (גזית ואחרים, 2009), הכולל סקירה אקולוגית והידרולוגית והטמעת עקרונות אקולוגיים בתכנון, וכן סקרי תשתיות טבע עירוני בנתניה (בלבן ווכטל, 2009) ובת"א- יפו (מעוז, 2012), המבקשים לשלב את המערכות הטבעיות בתוך העיר כתשתית עירונית תוך שמירה על המגוון הביולוגי.
