# file = txt/1500263.txt
# filelineno = 80
# sentno = 4
# text = כמו כן, קיימים שינויים יומיים בטמפרטורה- בלילה המים קרים יותר ובמשך היום מתחממים, וכן השפעה של עכירות המים- בבריכה עכורה המים יתחממו סמוך לפני השטח, ואילו בבריכה צלולה המים יתחממו סמוך לקרקעית (גזית ומילשט״ן, 2003).
