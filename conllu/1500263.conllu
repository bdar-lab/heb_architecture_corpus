# file = txt/1500263.txt
# filelineno = 609
# sentno = 5
# text = יתרה מזאת, CRAM קלה ביותר להתאמה לישראל בהשוואה לשאר השיטות מבחינת תנאים אקלימיים ופיסיקאל״ם, מפני שיצרו אותה בקליפורניה בעלת אקלים סובטרופ׳ הדומה מבחינות רבות לאקלים בארץ, בעוד ששתי השיטות האחרות פותחו במדינות בעלי תנאים גיאומורפ״ם והידרולוג״ם שונים מישראל- ORAM שפותחה באוהיו, שבה רוב בריכות החורף בה מיוערות ו- FWRAP שפותחה בפלורידה הגשומה.
