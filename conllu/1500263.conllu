# file = txt/1500263.txt
# filelineno = 279
# sentno = 4
# text = לדוגמה, זיהום בריכת סאסא ממי קולחין שהוזרמו באגן היקוותה גרם להכחדת מיני סרטנים ודו ח״ם שאכלסו אותה; בריכת הר דלתון נפגעה מזיהום כתוצאה מזליגה תת-קרקעית של קולחים ממאגר סמוך; זיהום בריכת הר חורשן עקב הפרשות בקר, גרם להיעלמות אוכלוסיית הטריטונים ( matotriton vittatus) בבריכה (גפני וגזית, 2005; גפני, בדפוס).
