# file = txt/1500263.txt
# filelineno = 384
# sentno = 4
# text = לדוגמה, יצירת בריכת החורף בשמורה הגיאולוגית מצליח: במסגרת עבודות להרחבת מסילת הרכבת לוד־נען־באר שבע, שוקמה השמורה כבריכת חורף, ובשנים 2012-2014 צופתה קרקעית הבריכה בשכבה חרסתית, הוקמה גדר ונעשה איכלוס במיני ח׳ וצומח מקומיים (מנדלסון, ח״ת).
