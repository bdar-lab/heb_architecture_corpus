# file = txt/1500263.txt
# filelineno = 471
# sentno = 1
# text = בשיטת ה- IBI, מאפייני האסופה הביולוגית (כדוגמת מספר והרכב מינים, שפיעות יחסית), הרגישים לשינויים כימיים, פיזיקאליים וביולוגיים כתוצאה מפעילויות האדם, מבוטאים כמדדים ביוט״ם, למשל עושר מינים ומגוון מינים (הרשקוביץ, 2002; 1998 ,Danielson).
