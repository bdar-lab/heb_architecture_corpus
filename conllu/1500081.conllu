# file = txt/1500081.txt
# filelineno = 69
# sentno = 1
# text = המדגם כולל נתונים של התשואה השנתית על מניות בשנים 2005-2007, כמו גם את התשואה סביב תאריך פרסום מדד "מעלה", עשרה ימים לפני הפרסום ועשרה ימים לאחר הפרסום, בחברות הכלולות ב"מדד מעלה לאחריות חברתית"; שערי מק"מ בסוף כל שנה בין השנים -2005 2007; וביטא (רמת הסיכון של מניה ביחס למדד המניות הכללי).
