# file = txt/1900055.txt
# filelineno = 438
# sentno = 1
# text = (ח)	במגרש שבו אין דרך להחדיר את מי הגשם לקרקע מחלחלת, לפי חוק הפיקוח על קידוחי מים, התשט"ו-1955, או לפי תקנות בריאות העם (תנאים תברואיים לקידוח מי שתייה), התשנ"ה-1995, או לפי דין וחשבון (דוח) של מהנדס ביסוס, או לפי תכנית האוסרת חלחול, יסולקו המים למערכת ניקוז מי גשם או תיעול, באופן שלא ייגרם כל נזק או מפגע לבניין או לסביבה.
