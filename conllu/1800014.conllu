# file = txt/1800014.txt
# filelineno = 157
# sentno = 3
# text = בין היתר הן עסקו בהגדרת הצוות הבין־מוסדי המוביל את הפרויקט; במשמעות של הגדרת שכונת שיקום (או יישוב), כולל החלטות בנושא השקעת משאבים עבור הפעלת הפרויקט והטבות נלוות שניתנו לשכונה (או ליישוב); בהיבטים שונים של פעילות הפרויקט בדגש על כניסתו לרשויות מקומיות ויציאה מהן; החלטות שהתוו פעילות נוספת תוספתית לפרויקט, פעילות המנוהלת באמצעות מנגנון שיקום שכונות ונסמכת עליו.
