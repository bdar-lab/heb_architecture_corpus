# text = לתהליך זה קדם רקע ארוך הכולל בתוכו פסיקה של בג״ץ שנגעה לצורך לקבוע קריטריונים שקופים, ברורים ושיווניים להכללת רשויות בתהליך; דוח של מבקר המדינה משנת 2003 שהתייחס לעובדה שטרם נקבעו קריטריונים ולהחלטה פנימית במשרד הבינוי והשיכון כי הכרח להניע תהליכים אלו.
# raw = {'id': 2, 'text': 'לתהליך זה קדם רקע ארוך הכולל בתוכו פסיקה של בג״ץ שנגעה לצורך לקבוע קריטריונים שקופים, ברורים ושיווניים להכללת רשויות בתהליך; דוח של מבקר המדינה משנת 2003 שהתייחס לעובדה שטרם נקבעו קריטריונים ולהחלטה פנימית במשרד הבינוי והשיכון כי הכרח להניע תהליכים אלו.', 'dspan': (209, 462), 'tokens': [{'id': (1, 2), 'text': 'לתהליך', 'expanded': [{'id': 1, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ל'}, {'id': 2, 'text': 'תהליך', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'obl', 'lemma': 'תהליך'}], 'span': (0, 6), 'dspan': (209, 215)}, {'id': 3, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Dem', 'head': 2, 'deprel': 'det', 'dspan': (216, 218), 'span': (7, 9), 'lemma': 'זה'}, {'id': 4, 'text': 'קדם', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (219, 222), 'span': (10, 13), 'lemma': 'קדם'}, {'id': 5, 'text': 'רקע', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'nsubj', 'dspan': (223, 226), 'span': (14, 17), 'lemma': 'רקע'}, {'id': 6, 'text': 'ארוך', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'amod', 'dspan': (227, 231), 'span': (18, 22), 'lemma': 'ארוך'}, {'id': (7, 8), 'text': 'הכולל', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 8, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 8, 'text': 'כולל', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 5, 'deprel': 'acl:relcl', 'lemma': 'כלל'}], 'span': (23, 28), 'dspan': (232, 237)}, {'id': (9, 10), 'text': 'בתוכו', 'expanded': [{'id': 9, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ב'}, {'id': 10, 'text': 'תוכו', 'upos': 'NOUN', 'xpos': 'NOUN',