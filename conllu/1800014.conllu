# text = עם זאת, בשנת 2014 הציגה הממשלה היטל לעמותות דיור של 1.7 מיליארד אירו בשנה (נקבע שהיטל זה יעלה לשני מיליארד יורו), כדי להגדיל את התקציב הלאומי, מה שעלול לדחוף את אגודות הדיור לגבות דמי שכירות גבוהים יותר, להפחית את שכר העובדים ולמכור דירות נוספות אשר היה ממשיך להיות במלאי.
# raw = {'id': 3, 'text': 'עם זאת, בשנת 2014 הציגה הממשלה היטל לעמותות דיור של 1.7 מיליארד אירו בשנה (נקבע שהיטל זה יעלה לשני מיליארד יורו), כדי להגדיל את התקציב הלאומי, מה שעלול לדחוף את אגודות הדיור לגבות דמי שכירות גבוהים יותר, להפחית את שכר העובדים ולמכור דירות נוספות אשר היה ממשיך להיות במלאי.', 'dspan': (349, 621), 'tokens': [{'id': 1, 'text': 'עם', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'dspan': (349, 351), 'span': (0, 2), 'lemma': 'עם'}, {'id': 2, 'text': 'זאת', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Dem', 'head': 7, 'deprel': 'obl', 'dspan': (352, 355), 'span': (3, 6), 'lemma': 'זה'}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 7, 'deprel': 'punct', 'dspan': (355, 356), 'span': (6, 7), 'lemma': ','}, {'id': (4, 5), 'text': 'בשנת', 'expanded': [{'id': 4, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'ב'}, {'id': 5, 'text': 'שנת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'obl', 'lemma': 'שנה'}], 'span': (8, 12), 'dspan': (357, 361)}, {'id': 6, 'text': '2014', 'upos': 'NUM', 'xpos': 'NUM', 'head': 5, 'deprel': 'compound:smixut', 'dspan': (362, 366), 'span': (13, 17), 'lemma': '2014'}, {'id': 7, 'text': 'הציגה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=HIFIL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (367, 372), 'span': (18, 23), 'lemma': 'הציג'}, {'id': (8, 9), 'text': 'הממשלה', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'ממשלה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'nsubj', 'lemma': 'ממשלה'}], 'span': (24, 30), 'dspan': (373, 379)}, {'id': 10, 'text': 'היטל', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'obj', 'dspan': (3