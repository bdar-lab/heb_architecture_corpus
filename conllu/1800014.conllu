# file = txt/1800014.txt
# filelineno = 222
# sentno = 5
# text = נכון להנחיות תכנון 2019, הייתה אמורה לפעול תוכנית בשיתוף המשרד לשוויון חברתי וקרן שח״ף, ככל שעולה מהראיונות, מהלך זה לא יצא אל הפועל, ונכון להיום הקהילות המשימתיות פועלות כעוד גורם מפעיל בשכונה עימו הפרויקט יכול לעבוד בשיתוף פעולה, אך הן לא בהכרח חלק ממנו78.
