# file = txt/1800014.txt
# filelineno = 61
# sentno = 1
# text = סקירה היסטורית זו היא רק רכיב אחד מני רבים במסגרת תהליך הייעוץ ולצידה נכתבה גם סקירה בין־לאומית על מדיניות הנוגעת לשיקום אזורים מוחלשים; התקיים ניתוח תקציבים של הפרויקט ושל פעילות בתחומים משיקים; נערכו דיונים מקצועיים על הרכיבים השונים של הפרויקט (עם נציגי משרד הבינוי והשיכון ועם הצוות הבין־מוסדי) והתקיימה חשיבה שוטפת עם ועדה מלווה לתהליך כולו הכוללת נציגים של משרד הבינוי והשיכון.
