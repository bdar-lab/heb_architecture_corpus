# file = txt/1800014.txt
# filelineno = 217
# sentno = 6
# text = נכון לשנת 2019 מטרות ההתערבות במסגרת הפרויקט מופנות להקמת מרכזים נוספים לגיל הרך; עידוד עבודה כוללנית; הכשרת אנשי מקצוע; העלאת מודעות לצורכי הילדים בגיל הרך ומתן כלים מתאימים להורים; פיתוח שירותים לילדים; איתור מוקדם של ילדים עם צרכים מיוחדים או עם עיכובים התפתחותיים ייחודיים וקידום מוכנות הילדים לכיתה אי.
