# file = txt/1800014.txt
# filelineno = 1045
# sentno = 1
# text = שנים רבות הגישה לדיור חברתי בהולנד הייתה אפשרית כמעט לכל האזרחים, אולם עקב פסיקות הנציבות האירופית בשנת 2011 הוחלט שיש להקצות 90% לפחות מדירות האגודה לדיור לאנשים שיש להם הכנסה ביתית שנתית נמוכה מ-34,000 אירו, ורק 10% מהדירות האלה מיועדות למשקי בית שבהם ההכנסה גבוהה יותר, אך הם נתקלים בקשיים למצוא דיור הולם.
