# file = txt/1800014.txt
# filelineno = 641
# sentno = 1
# text = תהליך הייעוץ נערך בתקופה שבין ספטמבר 2019 לסוף אוקטובר 2020 וכלל סקירה היסטורית מעמיקה של הפרויקט; סקירה בין־לאומית על מדיניות להתמודדות עם חיזוק אזורים מוחלשים פיזית וחברתית; ניתוח כלכלי של משאבי הפרויקט וניתוח של משאבים ממשלתיים וחברתיים המיועדים לתחומי התערבות משיקים; עשרות ראיונות עומק; העמקה בחומרים מקצועיים ואקדמיים ושיח מתמשך עם הוועדה המלווה של התהליך מטעם המשרד.
