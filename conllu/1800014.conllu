# file = txt/1800014.txt
# filelineno = 406
# sentno = 3
# text = עם זאת, שתי סוכנויות ממשלתיות פדרליות מתאמות ומתוות מדיניות בעניין החייאת הקהילה ופיתוחה: המחלקה לדיור ופיתוח עירוני (HUD) מנהלת תוכניות פדרליות שונות הקשורות לדיור ולשכונות במצוקה, ככל שאלה קשורות לפיתוח בר-קיימא, לפיתוח כלכלי, לאנרגיה ולהוגנות של משטר הדיור; ומחלקת האוצר מפקחת ומסדירה רבים מהמכשירים הפיננסיים התומכים בפיתוח הכלכלי בקרב הקהילות הנתונות במצוקה כלכלית לפי הקריטריונים שהמדינה מגדירה.
