# file = txt/1300017.txt
# filelineno = 7
# sentno = 3
# text = פעילויות רבות - כגון תעבורה ימית, דיג וחקלאות ימית, חיפוש והפקה של גז ודלק והקמת תשתיות מתאימות, שאיבת מ׳ ים לקירור ולהתפלה, כרייה של חומרי גלם וחולות, פעולות צבא וביטחון, תיירות, ספורט ימי ונופש, וכן תכנון אפשרי של א״ם מלאכותיים ותשתיות להפקת אנרגיה מתחדשת - הולכות וממלאות את המרחב הימי, והן בעלות פוטנציאל כלכלי וחברתי עצום.
