# file = txt/2700021.txt
# filelineno = 127
# sentno = 3
# text = דרישות הפיתוח לשנת היעד 2020 לאוכלוסייה המונה כ-8 מליון נפש יביאו - בלא נקיטת צעדים מגבילים - לתוספת משמעותית של שטח מפותח, עד כדי 50% ומעלה של שטח בנוי, במרבית חלקיו של המרחב הצפוני, (ראה פירוט אצל מזור וטרופ, 1994, בדו״ח מס׳ 21 בשלב ב׳ של פירסומי ״ישראל 2020״).
