# file = txt/1300016.txt
# filelineno = 738
# sentno = 1
# text = בהחלטה 1456 (חלקת המגורים), נקבע באופן כי שיוך הדירות יכול להתבצע רק למשפחת חברים אשר "הינם שותפים בכל נכסי האגודה, ובכל חובות הקיימים לחברים כלפי האגודה, וכן בכל הזכויות המוקנות מהאגודה לחברים".
