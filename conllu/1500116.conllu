# file = txt/1500116.txt
# filelineno = 695
# sentno = 5
# text = לא רק עם ירדן אמורים היו הפליטים להתמודד, כלומר עם שומרי החוק, המשעים את החוק בשם השלווה והסדר, אם לנסח זאת ברוח דבריה של מאלקי, הפליטים נאלצו להתמודד גם עם המפקחים התלויים בהומאניטאריזם, שבעצמם היוו את ה״יוצא מן הכלל׳ של הריבון; זהו אותו אירגון אדיב הפועל זמנית כריבון (353 ,2002 Malkki).
