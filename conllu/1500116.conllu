# file = txt/1500116.txt
# filelineno = 557
# sentno = 1
# text = מכל מקום תוכניות אלה נכשלו כולן; הפליטים שהתגוררו במחנות המשיכו לחיות בתוכם תוך דבקות ברעיון השיבה, אונר״א המשיכה לנהל את המחנות, והמחנות בגדה המערבית ובעזה נכנסו לעידן חדש, תחת ריבונותה של ישראל.
