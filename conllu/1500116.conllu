# file = txt/1500116.txt
# filelineno = 150
# sentno = 3
# text = הם ראו במלחמה הזדמנות היסטורית חד־פעמית להקמת מדינת ישראל, שכבר הייתה קיימת חלקית על יסודות שהונחו בתהליך ההתיישבות היהודית החדשה, כמו גם הזדמנות לשינוי המאזן הדמוגרפי וההתיישבותי בין היהודים והערבים (וילנאי 1949, לורך 1958, שרת 1958, בן־גוריון 1982, נאור 1988, גלבר 2004, קדיש 2004, יצחק 2006, בר און וחזן 2007).
