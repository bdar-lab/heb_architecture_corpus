# file = txt/1500116.txt
# filelineno = 780
# sentno = 4
# text = רק לאחר מכן, המחקר עבר לבחינת אותה היסטוריה מרחבית על רקע שני הממדים של "אובדן" ו״הרס" שהוגדרו מראש כמושגים בסיסיים לניתוח המחקר, וזאת על מנת לבסס את טענת המחקר, לפיה לא התקיים גבול קשיח שהפריד בין שני המרחבים, "הפרטי" ו״הציבורי", בתוך מחנה הפליטים הפלסטיני.
