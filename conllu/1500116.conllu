# file = txt/1500116.txt
# filelineno = 773
# sentno = 1
# text = תנועות ההתנגדות התגבשו בתוך המחנה בתקופה זאת ועליהם עמד המחקר בחלקו השני, עם סקירת התנועות השונות שהתפתחו במחנות ומאבקיהן שהסתכמו במאבק מזוין שהגיע מצד המדינות הערביות אל פנים המחנות, דהיינו מבחוץ אל הבפנים, והמסרבים להיכנע לשליטה תוך הדגשת "הפרויקט הלאומי הערבי" שלהם, או כפי שבשארה רואה בפעולותיהן של התנועות האלו ובמאבקן המזוין - "תרבות ההתנגדות", פעולות פרקטיות ועמדות שמנעו מהמחנות להפוך ל״גטו", למאגרי ייאוש ולשכונות עוני (בשארה 2009, 50ו), הפרק הנוכחי ביקש לעמוד על הפרקטיקות האדריכליות שאינן חשובות פחות מהפרקטיקות של המאבק המזוין ואשר דרכן המחנה קיבל משמעויות שמנעו ממנו להפוך ל״גטו".
