# file = txt/1500116.txt
# filelineno = 736
# sentno = 5
# text = 140 בחינת התוכניות השונות באמצעותן ביקש המערב, דרך אונר״א, ליישב מחדש את הפליטים הפלסטינים - כאשר חלק מאותן תכניות כלל גם את השימוש במסות הבטון, שאיפיין מודלים של תיכנון מחנות צבאיים אירופיים, וגם את המלצותיו של קלאפ ושל אחרים לקידום פיתרונות כלכליים ולא פיתרונות פוליטיים ל״בעיית הפלסטינים״ - חושפת את השיקולים הפוליטיים שהיו מעורבים בגיבוש אותן תוכניות, שאופי ההתנהלות שלהם דומה לזה של משטרי החוץ בזמן המלחמה הקרה, כאשר קידמו מדיניות החוץ תוכניות כלכליות ככלי לאינטגרציה של הפליטים ולמניעת התארגנותם בצורה פוליטית שעלולה להוביל לנפילתם בידי הקומוניסטים.
