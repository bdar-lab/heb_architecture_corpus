# file = txt/1500116.txt
# filelineno = 580
# sentno = 3
# text = יחד עם אשתי זיינב הלכנו למקום שבו התקבצו אנשים עם אוהלים ופעילים הומאניטאריים שמאכילים ומטפלים בהם, אמא ואח שלי הלכו לגור במערה עלובה בארטאס, אני ואשתי התיישבנו במחנה של הצלב האדום [שהפך לדהיישה], והרבה ממי שהיה בארטאס עזב אותנו לכיוון ע׳ור ירדן, איפה שהצלב האדום הקים לו מחנות, פשוט האנשים היו רעבים וחיפשו מי שיאכיל אותם וחשבו שהירדניים יעזרו להם... בקיץ כאשר החום והשרב פקד אותם חזרו בחזרה לגדה, חלק מהם הגיע למחנה דהיישה, היו שהגיעו לערוב ואחרים למחנה פוואר״ (אבו עאדל־ ח׳ליל אל־לחאם, 2008)
