# file = txt/1500116.txt
# filelineno = 728
# sentno = 2
# text = מחנות כמו אלה הממוקמים בניקרגואה, טורקיה ויגוסלביה שימשו פליטים לאחר רעידות האדמה השונות שפקדו את עריהם ואת כפריהם, כאשר כולם נבנו באופן זהה, גם אם ייתכן שנבנו מחומרים שונים, חלקם חזקים ועמידים יותר חלקם פחות, ומהר מאוד הפכו אלה מהתיישבות "זמנית" שהופיעה בזמן חירום להתיישבות "קבע", דבר שגרם לאדריכלים המתמחים בתיכנון מבני מגורים בזמני חירום, כמו האדריכל הבריטי איאן דיוויס ואחרים, למהר ולדרוש מהסוכנויות המטפלות בנסיבות של אסונות, לחשוב על תיכנון מבני המגורים ועל חומריותם עם המעבר מהאוהלים למבני קבע, מאחר ושברוב המקרים התיישבויות אלה הולכות והופכות קבועות (1977 Davis).
