# file = txt/1500116.txt
# filelineno = 119
# sentno = 1
# text = הניתוח המרכזי במחקר זה יתמקד במקורות הראשוניים, באמצעותם תיבדק ההיסטוריה המרחבית של היווצרות המחנות והתנהלותו של הפליט במסגרתם בשלוש תקופות: בשנים 1949־1947 - שנות המלחמה ויצירת הקטגוריה של הפליט, בשנים 1958־1949 - שלב מיסוד המחנה כמרחב אוהלי, ובשנים 1967־1958 - המעבר מהאוהלים לגריד מודרני של מחסות.
