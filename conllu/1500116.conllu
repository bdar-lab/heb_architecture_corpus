# file = txt/1500116.txt
# filelineno = 294
# sentno = 3
# text = לפי מוריס, ישראל סירבה לכך, וביקשה למנוע חזרה של הערבים לבתיהם על־ידי חיסול מוחלט של הכפרים, תמיכה בקליטת ערבים במקומות חדשים, עיכוב עיבוד הקרקע, התיישבות יהודית מהירה בכפרים ובערים ערביות, על מנת להימנע מיצירת "חללים ריקים", חקיקה הקובעת הגבלות שיבה ותעמולת הסברה המכוונת לאי־חזרה (מוריס 2005, 89ו).
