# file = txt/1500116.txt
# filelineno = 274
# sentno = 4
# text = מנגנונים אחרים לא ינותחו בהרחבה במסגרת מקרה הבוחן אך יתוארו ויעמדו לדיון, במסגרת העיסוק ב״היסטוריה המרחבית", אותה היסטוריה הקשורה בתהליכי ייצור "מחנות הפליטים", במערך יחסי הכוח ובמאבקי הכוחות שמשפיעים על אופיים וצורת התנהלותם של המחנות והעסוקים, בו־זמנית, בבנייתם, הריסתם וחיסולם.
