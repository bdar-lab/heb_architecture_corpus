# text = "התפתחות הכרחית", כפי שקראה לה אונר״א, הפכה סיבה לדאגה, כאשר התגלתה תחילה כמקרה חריג במחנות שהיו ממוקמים בעזה - שכאמור, הייתה הראשונה שבה הופעל פרויקט המעבר - לאחר שעבר זמן מה והפליטים הספיקו כבר לגור ב״בית" ולהכיר את ממדיו.
