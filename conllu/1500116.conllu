# file = txt/1500116.txt
# filelineno = 757
# sentno = 1
# text = קריאה זו של המרחב הדהישיאני מבקשת לסדוק סדק באותו מבט אוטופי, הרואה בתיכנון כלי ליצירת מרחב וחברה טובה יותר, ברוח דבריו של יפתחאל, "להאיר׳ את "צדה האפל׳ של אותה פעולה, הכרוכה בפיקוח, שליטה חברתית הפעלת לחץ, אילוץ, ניצול ודיכוי, החורגים מעבר לדרישות הסבירות לקיומו של סדר חברתי (יפתחאל 2006, 79).
