# file = txt/1500116.txt
# filelineno = 743
# sentno = 3
# text = אפילו בקונגרס השמיני שלה, שהתקיים באנגליה בשנת ו95ו כאשר העלתה את נושא מרכזי הערים למרכז דיוניה, התמקדה וחזרה, באופן מודע, לדון בעיצוב שמטרתו תיכנון אורבאני (Athens Charter) ולהתמקד ב״עיר הפונקציונאלית״ ובארבעת הפונקציות הבסיסיות שלה - מגורים, עבודה, בילוי וסירקולציה (1951 Giedion מצוטט אצל 135 ,1993 Ockman).
