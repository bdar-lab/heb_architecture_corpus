# text = אינדיקציה ראשונה להתגשמות תחזית זו אפשר למצוא כבר בנתונים מן המפקד שנערך בישראל ב—983ר; נהון (1987) ניתח אותם וגילה, כי חניכי הארץ ממוצא אסיה ואפריקה הם אשר זוכים פחות מכל קבוצה אחרת בתארים אקדמיים, הרבה פחות מחניכי הארץ ממוצא אירופה אמריקה, ואף פחות מן הערבים, ובמיוחד הנוצרים שביניהם (שם, עמי 24 ו-82).
# raw = {'id': 4, 'text': 'אינדיקציה ראשונה להתגשמות תחזית זו אפשר למצוא כבר בנתונים מן המפקד שנערך בישראל ב—983ר; נהון (1987) ניתח אותם וגילה, כי חניכי הארץ ממוצא אסיה ואפריקה הם אשר זוכים פחות מכל קבוצה אחרת בתארים אקדמיים, הרבה פחות מחניכי הארץ ממוצא אירופה אמריקה, ואף פחות מן הערבים, ובמיוחד הנוצרים שביניהם (שם, עמי 24 ו-82).', 'dspan': (399, 703), 'tokens': [{'id': 1, 'text': 'אינדיקציה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'obj', 'dspan': (399, 408), 'span': (0, 9), 'lemma': 'אינדיקציה'}, {'id': 2, 'text': 'ראשונה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'amod', 'dspan': (409, 415), 'span': (10, 16), 'lemma': 'ראשון'}, {'id': (3, 4), 'text': 'להתגשמות', 'expanded': [{'id': 3, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ל'}, {'id': 4, 'text': 'התגשמות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'nmod', 'lemma': 'התגשמות'}], 'span': (17, 25), 'dspan': (416, 424)}, {'id': 5, 'text': 'תחזית', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'compound:smixut', 'dspan': (425, 430), 'span': (26, 31), 'lemma': 'תחזית'}, {'id': 6, 'text': 'זו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Dem', 'head': 5, 'deprel': 'det', 'dspan': (431, 433), 'span': (32, 34), 'lemma': 'זה'}, {'id': 7, 'text': 'אפשר', 'upos': 'ADV', 'xpos': 'ADV', 'head': 0, 'deprel': 'root', 'dspan': (434, 438), 'span': (35, 39), 'lemma': 'אפשר'}, {'id': 8, 'text': 'למצוא', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PAAL|VerbForm=Inf|Voice=Act', 'head': 7, 'deprel': 'xcomp', 'dspan': (439, 444), 'span': (40, 45), 'lemma': 'מצא'}, {'id': 9, 'text': 'כבר', 'upos': 'ADV', 'xpos': 'ADV', 'head': 8, 'deprel': 'advmod', 'dspan': (445, 448), 'span': (46, 49), 'lemma': 'כבר'}, {'id': (10, 11), 'text': 'בנתונים', 'expanded': [{'id':