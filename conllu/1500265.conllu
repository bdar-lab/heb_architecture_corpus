# file = txt/1500265.txt
# filelineno = 810
# sentno = 5
# text = ייצוג הבניין דרך מערכות יחסים גיאומטריות מאפשר באופן עקרוני להכיל את הפרופיל על כל בניין שהוא (משרדים, ת״א), באמצעות חישובים בסיסיים, וללא צורך בסימולציה, כאשר מרחב התוצאות שהוצג מאפשר הגדרת טווחי המלצה לכל אחד מן המדדים.
