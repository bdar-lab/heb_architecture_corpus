# file = txt/1500265.txt
# filelineno = 587
# sentno = 1
# text = בבדיקה שנערכה עבור Rectangle long בדומיננטיות +1, -1 ללא הצללה כלל, ועם הצללה פנימית לא חכמה, ניכר כי צריכת האנרגיה לקירור עולה משמעותית בין +1 ל- -1 בשני המקרים, וההפרש בין צריכת האנרגיה הכוללת הגבוה ביותר שנרשם הוא בדומיננטיות +1, -1 ללא הצללה עבור המלבן הארוך (10.52 kWh/m2) (טבלה 7.8).
