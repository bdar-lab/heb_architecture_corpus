# sentno = 1
# text = בישראל, תקנות הבנייה מגדירות בניין משרדים כבבניין או חלק ממנו המיועד לפעילות מנהלית או עסקית (לרבות בניינים של משרדי ממשלה ורשויות מקומיות), ושהוגדר כבניין שהשימוש העיקרי שלו הוא משרדים בטופס הבקשה להיתר בנייה, ע״פ חוק התכנון והבנייה התשכ"ה -1965 (ת"י 2011,5282-2).
