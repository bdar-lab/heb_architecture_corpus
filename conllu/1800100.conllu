# file = txt/1800100.txt
# filelineno = 213
# sentno = 2
# text = שיטת הרגיסטרציה אותה מציעים הכותבים מורכבת ממספר שלבים: חילוץ והתאמת קטעי קווים ישרים בין סטים של נקודות, תוך שימוש בשיטת הריבועים הפחותים; לאחר-מכן חילוץ מישורים בעזרת Modified Hough Transform מתוך המקטעים שנמצאו בשלב הקודם; ולבסוף פתירת המיקום היחסי בעזרת זוגות של מישורים מתאימים.
