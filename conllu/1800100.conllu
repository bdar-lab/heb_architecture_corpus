# file = txt/1800100.txt
# filelineno = 142
# sentno = 2
# text = לפי הכותבים, השיטות המקובלות בתחום לזיהוי אובייקטים הן שיטות מבוססות-מודל, דהיינו, הן מתבססות על ידע מוקדם בנוגע לאובייקט הרצוי (צבע, צורה, טמפרטורה, וכדומה) או על השוואה בין רשתות פוליגונאליות דו-ממדיות (polygonal surface meshes) של התמונה ושל האובייקט.
