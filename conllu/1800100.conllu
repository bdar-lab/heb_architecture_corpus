# file = txt/1800100.txt
# filelineno = 380
# sentno = 3
# text = לשם מציאת הקו הראשון נמצא את הערך המקסימאלי במטריצה ואת הפרמטרים שלו, לאחר חילוץ משוואת הקו הראשון ומציאת הנקודות הנמצאות בקרבתו במרחק המתאים לנתוני הסריקה, תסולקנה נקודות אלו ממאגר הנקודות הראשי ועל המאגר הראשי יבוצע עוד פעם תהליך מציאת קוו ישר חדש המתחיל מטרנספורמציה Hough והפעם יופיעו אותם שיאים ללא הקו הראשון שחולץ (ר' איור 6-11), מציאת הקו השני תהיי בעזרת מציאת מקסימה גלובלית וההמשך זהה למה שהוסבר לעיל.
