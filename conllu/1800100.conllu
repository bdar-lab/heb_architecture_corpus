# text = בעוד אשר אתרי בנייה הינם, מעצם טיבם, מקומות עבודה "מסוכנים" [על פי נתונים שמפרסם משרד התעשייה, המסחר והתעסוקה (משרד התמ"ת 2004), כ-50% מכלל תאונות העבודה שהסתיימו במוות על- פני עשר שנים (2004-1995), מקורן בענף הבנייה (367 מקרי מוות מתוך ס״ה 710, שהם 51.7%) ; על פי נתונים שמפרסמת הלשכה המרכזית לסטטיסטיקה (הלמ"ס 2005), ענף הבנייה מעסיק רק כ-5% מכלל עובדי המשק, ובשנים מסוימות הגיע שיעור זה אף לכדי 10%, דהיינו, יש פי חמישה עד עשרה הרוגים בענף הבנייה יחסית לגודל הענף מבחינת מועסקים], השימוש בעגורן לכשעצמו יוצר פוטנציאל גבוה לסיכון בטיחותי ותורם תרומה נכבדה לסך כל הסיכון הבטיחותי באתר.
# raw = {'id': 2, 'text': 'בעוד אשר אתרי בנייה הינם, מעצם טיבם, מקומות עבודה "מסוכנים" [על פי נתונים שמפרסם משרד התעשייה, המסחר והתעסוקה (משרד התמ"ת 2004), כ-50% מכלל תאונות העבודה שהסתיימו במוות על- פני עשר שנים (2004-1995), מקורן בענף הבנייה (367 מקרי מוות מתוך ס״ה 710, שהם 51.7%) ; על פי נתונים שמפרסמת הלשכה המרכזית לסטטיסטיקה (הלמ"ס 2005), ענף הבנייה מעסיק רק כ-5% מכלל עובדי המשק, ובשנים מסוימות הגיע שיעור זה אף לכדי 10%, דהיינו, יש פי חמישה עד עשרה הרוגים בענף הבנייה יחסית לגודל הענף מבחינת מועסקים], השימוש בעגורן לכשעצמו יוצר פוטנציאל גבוה לסיכון בטיחותי ותורם תרומה נכבדה לסך כל הסיכון הבטיחותי באתר.', 'dspan': (154, 740), 'tokens': [{'id': 1, 'text': 'בעוד', 'upos': 'ADP', 'xpos': 'ADP', 'head': 13, 'deprel': 'case', 'dspan': (154, 158), 'span': (0, 4), 'lemma': 'בעוד'}, {'id': 2, 'text': 'אשר', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 13, 'deprel': 'mark', 'dspan': (159, 162), 'span': (5, 8), 'lemma': 'אשר'}, {'id': 3, 'text': 'אתרי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 13, 'deprel': 'nsubj', 'dspan': (163, 167), 'span': (9, 13), 'lemma': 'אתר'}, {'id': 4, 'text': 'בנייה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'compound:smixut', 'dspan': (168, 173), 'span': (14, 19), 'lemma': 'בנייה'}, {'id': 5, 'text': 'הינם', 'upos': 'AUX', 'xpos': 'AUX', 'feats': 'Gender=Masc|Number=Plur', 'head': 13, 'deprel': 'cop', 'dspan': (174, 178), 'span': (20, 24), 'lemma': 'הינם'}, {'id': 6, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 13, 'deprel': 'punct', 'dspan': (178, 179), 'span': (24, 25), 'lemma': ','}, {'id': (7, 8), 'text': 'מעצם', 'expanded': [{'id': 7, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'מ'}, {'id': 8, 'text': 'עצם', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 13, 'deprel': 'nmod', 'lemma': 'עצם'}], 'span': (26, 30), 'dspan': (180, 184)}, {'id': (9, 11), 'text': 'ט