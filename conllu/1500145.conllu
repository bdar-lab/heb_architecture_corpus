# text = להבדיל משכונת מנשיה הצפונית שנמחקה כליל ב-1948, או מהרובע העתיק של יפו שנהרס ושוחזר עד זרא כקריית אומנים, בעג׳מי, נכון לזמן כתיבת המחקר (2010-2013) נוכחות תצורות מגוונות של בינוי: חורבות, חלקות שוממות, בתי מגורים מטים לנפול, מאולתרים, משומרים,משופצים, וחדשים.
# raw = {'id': 3, 'text': 'להבדיל משכונת מנשיה הצפונית שנמחקה כליל ב-1948, או מהרובע העתיק של יפו שנהרס ושוחזר עד זרא כקריית אומנים, בעג׳מי, נכון לזמן כתיבת המחקר (2010-2013) נוכחות תצורות מגוונות של בינוי: חורבות, חלקות שוממות, בתי מגורים מטים לנפול, מאולתרים, משומרים,משופצים, וחדשים.', 'dspan': (223, 482), 'tokens': [{'id': 1, 'text': 'להבדיל', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=HIFIL|VerbForm=Inf|Voice=Act', 'head': 46, 'deprel': 'advcl', 'dspan': (223, 229), 'span': (0, 6), 'lemma': 'הבדיל'}, {'id': (2, 3), 'text': 'משכונת', 'expanded': [{'id': 2, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'lemma': 'מ'}, {'id': 3, 'text': 'שכונת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 46, 'deprel': 'obl', 'lemma': 'שכונה'}], 'span': (7, 13), 'dspan': (230, 236)}, {'id': 4, 'text': 'מנשיה', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'compound', 'dspan': (237, 242), 'span': (14, 19), 'lemma': 'מנשיה'}, {'id': (5, 6), 'text': 'הצפונית', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'צפונית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'amod', 'lemma': 'צפוני'}], 'span': (20, 27), 'dspan': (243, 250)}, {'id': (7, 8), 'text': 'שנמחקה', 'expanded': [{'id': 7, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 8, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 8, 'text': 'נמחקה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 3, 'deprel': 'acl:relcl', 'lemma': 'נמחקה'}], 'span': (28, 34), 'dspan': (251, 257)}, {'id': 9, 'text': 'כליל', 'upos': 'ADV', 'xpos': 'ADV', 'head': 8, 'deprel': 'advmod', 'dspan': (258, 262), 'span': (35, 39), 'lemma': 'כליל'}, {'id': 10, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 12, 'deprel': 'case', 'dspan': (263, 264