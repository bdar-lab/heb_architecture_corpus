# file = txt/1500145.txt
# filelineno = 301
# sentno = 4
# text = מונטרסקו מרחיב על המעבר מדפוס מודרניסטי אתנוקרטי, לדפוס ניאו ליברלי, ומאפיין במדיניות חדשה זו שני קטבים מנוגדים: מחד גיסא, של הפרטת נכסי נדל״ן, ליברליזציה וביזור מערכות, ומאידך גיסא, מגמה אזרחנית, קרי, מדיניות של אפליה מתקנת, נסיונות של שיתוף תושבים והצעות סיבסוד דיור (מונטרסקו, 143-144:2005).
