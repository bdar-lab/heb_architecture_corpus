# file = txt/1500145.txt
# filelineno = 467
# sentno = 1
# text = בניתוח ההזרה באובייקטים לשימור בעג׳מי, המרוקנים מתוכנם עד להפיכת רעיון השימור על פניו (מונטרסקו ופביאן, 2003), עולה מושג ה״סימולקרה" של אפלטון שפיתח בודריאר (בודריאר, 2007[1981]), או ה״פאסטיש" של ג׳יימסון (בעקבות אדורנו ומאן), המתארים שניהם הוויה פוסט מודרנית של סימולציות מציאות, של דימוי שהוא העתק שבעצם קיומו מהדהד היעדרו של המקור (ג׳ימסון, 2007[1991], : 45-48).
