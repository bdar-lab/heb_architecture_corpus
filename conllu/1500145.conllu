# file = txt/1500145.txt
# filelineno = 103
# sentno = 2
# text = המעניין במקרה של רתימנו הוא שהיא חושפת מנגנון מורכב אף יותר, כשבנסיבות של בעלות התושבים על נכסיהם (פריבילגיה שאינה שמורה לרוב עם תושבי אזורים הסטוריים), העימות בין מורשת בנויה עות׳מנית לבין מורשת בנוייה ונציאנית, הוכרע על ידי התיירים, כשהתושבים לא רק שאינם מתנגדים למיתוג עירם כונציאנית, אלא אף מחזקים דימוי זה, לטובת שיגשוג עסקיהם בעיר.
