# text = תחושה זו ניזונה מתהליכים הנקשרים בשימור, בעיקר כחלק מתנופת הפיתוח בשכונה, חלקם נסקרו בפרקים הקודמים: ההתיחסות הבלעדית של המתכננים למימד הפיזי, והיעדר התיחסותם לתהליכים מורכבים כמו הרס, כשלון מנגנוני עירוני לחבר שיקום חברתי עם שימור פיזי, חוסר תיאום בין מנגנונים מדינתיים (ממ״י שהוא הבעלים על הקרקע) לבין מנגנונים עירוניים, ולבסוף, לחצים יזמיים חיצוניים והגדלת משקלם בתהליכי הפרטת המרחב.
# raw = {'id': 4, 'text': 'תחושה זו ניזונה מתהליכים הנקשרים בשימור, בעיקר כחלק מתנופת הפיתוח בשכונה, חלקם נסקרו בפרקים הקודמים: ההתיחסות הבלעדית של המתכננים למימד הפיזי, והיעדר התיחסותם לתהליכים מורכבים כמו הרס, כשלון מנגנוני עירוני לחבר שיקום חברתי עם שימור פיזי, חוסר תיאום בין מנגנונים מדינתיים (ממ״י שהוא הבעלים על הקרקע) לבין מנגנונים עירוניים, ולבסוף, לחצים יזמיים חיצוניים והגדלת משקלם בתהליכי הפרטת המרחב.', 'dspan': (501, 887), 'tokens': [{'id': 1, 'text': 'תחושה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'nsubj', 'dspan': (501, 506), 'span': (0, 5), 'lemma': 'תחושה'}, {'id': 2, 'text': 'זו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Dem', 'head': 1, 'deprel': 'det', 'dspan': (507, 509), 'span': (6, 8), 'lemma': 'זה'}, {'id': 3, 'text': 'ניזונה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (510, 516), 'span': (9, 15), 'lemma': 'ניזונה'}, {'id': (4, 5), 'text': 'מתהליכים', 'expanded': [{'id': 4, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'מ'}, {'id': 5, 'text': 'תהליכים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 3, 'deprel': 'obl', 'lemma': 'תהליך'}], 'span': (16, 24), 'dspan': (517, 525)}, {'id': (6, 7), 'text': 'הנקשרים', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 7, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 7, 'text': 'נקשרים', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Plur|Person=1,2,3|VerbForm=Part|Voice=Mid', 'head': 5, 'deprel': 'acl:relcl', 'lemma': 'נקשר'}], 'span': (25, 32), 'dspan': (526, 533)}, {'id': (8, 9), 'text': 'בשימור', 'expanded': [{'id': 8, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ב'}, {'id': 9, 'text': 'שימור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number