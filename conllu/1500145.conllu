# file = txt/1500145.txt
# filelineno = 69
# sentno = 2
# text = במודל חשיבה כזה, מיתווסף למימד האנכי של הזמן ההסטורי המשובר, מבצרם של ״צאצאי הזמן״ (פוקו, 2003 :7) גם מימד אופקי של מרחב וזמן יומיומי, אוהלם של "דיירי המרחב" (שם) כחלק מהכרה, בעקבות לפבר, שאותם מצבי חיים אנושיים משפיעים על עיצוב זהות ביחס לטריטוריה והפיכתה ממרחב למקום.
