# file = txt/1500145.txt
# filelineno = 337
# sentno = 4
# text = מאפיינים ספציפיים בתכנית מרחיקים עוד יותר את התושבים הותיקים מהתקיימות: תמהיל דירות שמגדיר גודל מינימלי של 90 מ״ר (שאינו מתאים למשפחות עניות), היעדר התיחסות לאתרי דיור ציבורי, מענה דל לצרכי תעסוקה מקומית בסביבה הביתית,66 ושמירת נפחי בניה ואחוזי בניה קטנים יחסית (לרצועת החוף התל אביבית ולשכונות אחרות).
