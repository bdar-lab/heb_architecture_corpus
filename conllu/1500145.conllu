# text = בשנים האחרונות נותח ונדון האופן בו התכנון הישראלי, לרבות העיסוק בשימור, שימש שוב ושוב לאישוש הבעלות על הארץ, לרוב בבחירה סלקטיבית של מורשות התואמות את הסיפר הלאומי (נצן־שפטן,2000, 2006, נעמן פורמן, 2008).
# raw = {'id': 1, 'text': 'בשנים האחרונות נותח ונדון האופן בו התכנון הישראלי, לרבות העיסוק בשימור, שימש שוב ושוב לאישוש הבעלות על הארץ, לרוב בבחירה סלקטיבית של מורשות התואמות את הסיפר הלאומי (נצן־שפטן,2000, 2006, נעמן פורמן, 2008).', 'dspan': (0, 204), 'tokens': [{'id': (1, 2), 'text': 'בשנים', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Definite=Def|PronType=Art', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'שנים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 5, 'deprel': 'obl', 'lemma': 'שנה'}], 'span': (0, 5), 'dspan': (0, 5)}, {'id': (3, 4), 'text': 'האחרונות', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'אחרונות', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Plur', 'head': 2, 'deprel': 'amod', 'lemma': 'אחרון'}], 'span': (6, 14), 'dspan': (6, 14)}, {'id': 5, 'text': 'נותח', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (15, 19), 'span': (15, 19), 'lemma': 'נותח'}, {'id': (6, 7), 'text': 'ונדון', 'expanded': [{'id': 6, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 7, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 7, 'text': 'נדון', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Pass', 'head': 5, 'deprel': 'conj', 'lemma': 'נדון'}], 'span': (20, 25), 'dspan': (20, 25)}, {'id': (8, 9), 'text': 'האופן', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'אופן', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'nsubj', 'lemma': 'אופן'}], 'span': (26, 31), 'dspan': (26, 31)}, {'id': (10, 11), 'text': 'בו', 'expanded