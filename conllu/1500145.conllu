# file = txt/1500145.txt
# filelineno = 208
# sentno = 3
# text = עצם ההתיחסות לשימור, שאינה רווחת בשכונות המעורבות בעיר בפרט, ובישראל בכלל, חלקן בנות גילה של עג׳מי או עתיקות ממנה, מרמזת כי ערכי השימור נבחנים כחלק בלתי נפרד ממגמות פיתוח הנובעות מביקושים הגבוהים בעג׳מי ביחס לשכנותיה.
