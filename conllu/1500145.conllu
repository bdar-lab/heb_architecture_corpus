# text = תוצרי תרבות שונים שצמחו מתוך היפואיות נבחנו גם הם במכלול התרשמות שבה משיקות החויות המרחביות והחברתיות, דוגמת עבודות אמנות (תערוכה ויום עיון: "פה, יפו"/ בית האדריכל ביפו/9-2010) או במדיום הקולנועי, כמו בסרט ״עג׳מי״ (2009, קופטי ס. ושני י.), המשקף סיטואציות חברתיות ואתנו-פוליטיות, אך צילומו בשכונה חושף קשר הדוק בין אתריה הפיזיים לבין הארועים.
# raw = {'id': 1, 'text': 'תוצרי תרבות שונים שצמחו מתוך היפואיות נבחנו גם הם במכלול התרשמות שבה משיקות החויות המרחביות והחברתיות, דוגמת עבודות אמנות (תערוכה ויום עיון: "פה, יפו"/ בית האדריכל ביפו/9-2010) או במדיום הקולנועי, כמו בסרט ״עג׳מי״ (2009, קופטי ס. ושני י.), המשקף סיטואציות חברתיות ואתנו-פוליטיות, אך צילומו בשכונה חושף קשר הדוק בין אתריה הפיזיים לבין הארועים.', 'dspan': (0, 342), 'tokens': [{'id': 1, 'text': 'תוצרי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 9, 'deprel': 'nsubj', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'תוצרי'}, {'id': 2, 'text': 'תרבות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'compound', 'dspan': (6, 11), 'span': (6, 11), 'lemma': 'תרבות'}, {'id': 3, 'text': 'שונים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'amod', 'dspan': (12, 17), 'span': (12, 17), 'lemma': 'שונה'}, {'id': (4, 5), 'text': 'שצמחו', 'expanded': [{'id': 4, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 5, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 5, 'text': 'צמחו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Plur|Person=3|Tense=Past|Voice=Act', 'head': 1, 'deprel': 'acl:relcl', 'lemma': 'צמח'}], 'span': (18, 23), 'dspan': (18, 23)}, {'id': 6, 'text': 'מתוך', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'dspan': (24, 28), 'span': (24, 28), 'lemma': 'מתוך'}, {'id': (7, 8), 'text': 'היפואיות', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'obl', 'lemma': 'ה'}, {'id': 8, 'text': 'יפואיות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'obl', 'lemma': 'יפואיות'}], 'span': (29, 37), 'dspan': (29, 37)}, {'id': 9, 'text': 'נבחנו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Plur|Person=3|Tense=Past|Voice=Pass', 'head': 0, 'deprel': 'root