# file = txt/1500145.txt
# filelineno = 629
# sentno = 2
# text = הן כוללות היאחזות ושימוש בכל פיסת אדמה- מגידול עצי פרי במצבי דחק בלתי אפשריים של חצרות זעירות, עד לגידולן של חיות משק; הן כוללות זליגה של חצרות, של מבואות כניסה, של שימושי שירות ופנאי מהתחום הפרטי אל הציבורי עד כדי קושי לסמן את גבולותיו; פעולות בינוי וחלוקות פנימיות בבתים מעידה על חשיבות לכידותה של המשפחה המורחבת וכבוד אבי המשפחה האחראי למגורי ילדיו בחסותו, תופעה המאפיינת קהילות מסורתיות כפריות.
