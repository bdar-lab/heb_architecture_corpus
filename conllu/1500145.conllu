# text = מטרת המחקר לבחון כיוון זה, של שימור חיוני וחי, שימור מקיים, הבא להרחיב את מינעד ערכי השימור, בהתאם להרחבה המוצעת באמנת בורה (איקומוס 1999 [1979]), וכך לבסס תפישת שימור הנותנת ביטוי לקהילה מקומית ולמירקם חיי היומיום שלה בתוך הסביבה הפיזית.
# raw = {'id': 1, 'text': 'מטרת המחקר לבחון כיוון זה, של שימור חיוני וחי, שימור מקיים, הבא להרחיב את מינעד ערכי השימור, בהתאם להרחבה המוצעת באמנת בורה (איקומוס 1999 [1979]), וכך לבסס תפישת שימור הנותנת ביטוי לקהילה מקומית ולמירקם חיי היומיום שלה בתוך הסביבה הפיזית.', 'dspan': (0, 238), 'tokens': [{'id': 1, 'text': 'מטרת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'nsubj', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'מטרה'}, {'id': (2, 3), 'text': 'המחקר', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'מחקר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'compound:smixut', 'lemma': 'מחקר'}], 'span': (5, 10), 'dspan': (5, 10)}, {'id': 4, 'text': 'לבחון', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PAAL|VerbForm=Inf|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (11, 16), 'span': (11, 16), 'lemma': 'בחן'}, {'id': 5, 'text': 'כיוון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'obj', 'dspan': (17, 22), 'span': (17, 22), 'lemma': 'כיוון'}, {'id': 6, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Dem', 'head': 5, 'deprel': 'det', 'dspan': (23, 25), 'span': (23, 25), 'lemma': 'זה'}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (25, 26), 'span': (25, 26), 'lemma': ','}, {'id': 8, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 9, 'deprel': 'case:gen', 'dspan': (27, 29), 'span': (27, 29), 'lemma': 'של'}, {'id': 9, 'text': 'שימור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'nmod', 'dspan': (30, 35), 'span': (30, 35), 'lemma': 'שימור'}, {'id': 10, 'text': 'חיוני', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 9, 'deprel'