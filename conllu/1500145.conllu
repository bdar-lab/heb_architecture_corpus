# file = txt/1500145.txt
# filelineno = 265
# sentno = 4
# text = המהפך הרדיקלי באופיה האורבני של יפו והפיכתה "מעיר נמל וממרכז סחר בינלאומי בתקופות העות׳מנית והבריטית, מרכז פוליטי חינוכי, חברתי מסחרי וכלכלי ראשון במעלה- לפרבר עוני של תל אביב״ (שקר 1996 אצל מונטרסקו 2007), והנרטיב הפלסטיני המספר אותו, הם הרקע שעליו יש להבין את התפתחותה של יפו כעיר מעורבת תחת הגמוניה מוניציפלית יהודית (שם: 10).
