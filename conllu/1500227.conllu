# file = txt/1500227.txt
# filelineno = 348
# sentno = 2
# text = הניתוח הסטטיסטי איפשר לערוך ניתוח מקיף בשלושה נושאים:(1) אפיון משתתפי השאלון והמדגם שהתקבל, (2) מציאת מתאמים בין משתנים חברתיים־כלכליים לבין מידת החשיפה לתכנים תכנוניים במדיה החברתית ומידת ההשתתפות, ו-(3) אפיון תהליך ההשתתפות במדיה החברתית על בסיס המודל של צ׳רצ׳מן וסדן.
