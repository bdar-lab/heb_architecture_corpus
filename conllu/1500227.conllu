# file = txt/1500227.txt
# filelineno = 126
# sentno = 3
# text = במחקר שנערך בשכונת שפירא בתל אביב, נמצא כי שיתוף הציבור הקלאסי מושך יותר קהל דתי, שאיננו חשוף לאינטרנט באותה מידה כמו החילוני, ותושבים מבוגרים יותר (מעל גיל 50), אשר רגילים לתקשורת בין אישית ופרונטאלית ואינם מעוניינים בתקשורת מקוונת (2009 ,.Stern et al).
