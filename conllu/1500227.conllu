# file = txt/1500227.txt
# filelineno = 202
# sentno = 2
# text = כך למשל, החוקרים .2002) Hudson-Smith et al) הציעו סולם בן שבעה שלבים, כאשר בין השלבים הנמוכים נמנים פורומים, דיונים מקוונים ואספקת שירותים מקוונים, ובמעלה הסולם נמצאות המערכות הווירטואליות שאפיינו את שיתוף הציבור המקוון החל משנות ה-90 של המאה הקודמת, לרבות מערכת מידע גיאוגרפית ומערכת מציאות מדומה.
