# file = txt/1500227.txt
# filelineno = 69
# sentno = 1
# text = לשיתוף הציבור המקוון מספר מטרות עיקריות, הדומות לשיתוף הציבור הקלאסי, אך מנסות להביא לידי ביטוי את הפוטנציאל הטמון בשינויים הטכנולוגיים כדי לשפר תהליכים אלו:(1) הרחבת מעגל המשתתפים בתהליכי שיתוף הציבור, (2) אספקת מידע נגיש ומובן לציבור, הכולל גם שיקוף עמדות של כלל המעורבים בתהליך, (3) קיומו של דיון מעמיק כדי לאפשר קבלת החלטות בשקיפות ומתן אפשרות לתרומה עמוקה יותר, (4) קידום אמינות ושקיפות של התהליך ו-(5) יצירת לגיטימציה לתהליכי התכנון ומחויבות גבוהה יותר של התושבים לתהליך זה (טלמור, 2006).
