# file = txt/1500227.txt
# filelineno = 38
# sentno = 2
# text = תהליך שהינו למראית עין בלבד או שיתוף סמלי (1969 ,Arnstein), תהליך שמטרתו לגייס תמיכה לתכנון ולמנוע התנגדויות (אלתרמן ואח׳, 1996), תהליך חד צדדי הכולל את עמדות מקבלי ההחלטות בלבד (1997 ,Healey) וכתהליך שנעשה במסגרת מחויבות והוא איננו יעיל או מועיל, הלכה למעשה, בתהליך קבלת ההחלטות (1992,1998 ,Innes).
