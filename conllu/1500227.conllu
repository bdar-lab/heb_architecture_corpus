# file = txt/1500227.txt
# filelineno = 605
# sentno = 1
# text = הן המומחים בתחום שיתוף הציבור והן הספרות המקצועית לא התייחסו ליתרון מובהק שקיים בפלטפורמות המקוונות והוא זמינות המידע עבור הפרט לאורך כל תקופת התכנון, היכולת לעדכן תהליכים והתקדמות בנושאים אלו, ויכולתו של הפרט להיכנס ולבדוק מהו הסטאטוס ומה קרה בדיון לפני כמה חודשים.
