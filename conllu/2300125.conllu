# text = בהמלצה זו טמונה בעייתיות, ולפיכך נוסיף בעניינה: יש לדאוג מראש לתחרות בין מבטחים ולבקרה ציבורית על מחירי ביטוח משכנתא; יש להגדיר את הסכום המכסימלי שיבוטח (הצעה לבדיקה: $100,000); יש להגדיר מראש ובבירור את מקרי הזכאות והדרכים להוכחת זכאות לדמי הביטוח; דמי ביטוח המשכנתאות עבור בעלי הכנסות נמוכות (על־פי מבחן הכנסה), ישולמו על ידי משרד הבינוי והשיכון, כחלק מתמיכתו בדיור של קבוצות מעוטות משאבים.
# raw = {'id': 2, 'text': 'בהמלצה זו טמונה בעייתיות, ולפיכך נוסיף בעניינה: יש לדאוג מראש לתחרות בין מבטחים ולבקרה ציבורית על מחירי ביטוח משכנתא; יש להגדיר את הסכום המכסימלי שיבוטח (הצעה לבדיקה: $100,000); יש להגדיר מראש ובבירור את מקרי הזכאות והדרכים להוכחת זכאות לדמי הביטוח; דמי ביטוח המשכנתאות עבור בעלי הכנסות נמוכות (על־פי מבחן הכנסה), ישולמו על ידי משרד הבינוי והשיכון, כחלק מתמיכתו בדיור של קבוצות מעוטות משאבים.', 'dspan': (208, 600), 'tokens': [{'id': (1, 3), 'text': 'בהמלצה', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'ה_', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'המלצה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'obl', 'lemma': 'המלצה'}], 'span': (0, 6), 'dspan': (208, 214)}, {'id': 4, 'text': 'זו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Dem', 'head': 3, 'deprel': 'det', 'dspan': (215, 217), 'span': (7, 9), 'lemma': 'זה'}, {'id': 5, 'text': 'טמונה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PAAL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (218, 223), 'span': (10, 15), 'lemma': 'טמן'}, {'id': 6, 'text': 'בעייתיות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'nsubj', 'dspan': (224, 232), 'span': (16, 24), 'lemma': 'בעייתיות'}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (232, 233), 'span': (24, 25), 'lemma': ','}, {'id': (8, 9), 'text': 'ולפיכך', 'expanded': [{'id': 8, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 10, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 9, 'text': 'לפיכך', 'upos': 'ADV', 'xpos': 'ADV', 'head': 10, 'deprel': 'advmod', 'lemma': 'לפיכך'}], 'span': (26, 32), 'dspan': (234, 240)}, {'id': 10, 'text': 'נוסיף', 'upos': 'VERB', 'xpos': 