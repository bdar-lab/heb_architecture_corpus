# file = txt/2300125.txt
# filelineno = 21
# sentno = 1
# text = הסדרים ציבוריים / חוקיים / תקנוניים בנושאי משכנתאות, ביניהם: התיקון לחוק הערבות (1992), המחייב בנקים למשכנתאות למצות הליכים כנגד החייב לפני פנייה לערבים, אשר יצר מצב חדש שאין לו מענים תקנוניים הולמים; פתיחת אפשרות רחבה ^LTV גבוה מאוד (עד 95% באופן פורמלי, ויותר מכך בפועל), גם עבור עולים חדשים, שלא מצאו את מקומם בשוק העבודה; רשתות ביטחון בלתי מספיקות למקרי כשל בפירעון (גורם חשוב במיוחד, בקבוצה זו); ובנוסף לאלה, אי איסוף ואי פרסום של נתונים, שהיו יכולים לאפשר מעקב אחר החתומים על משכנתאות, ובעיקר, אחר הנכשלים (אלה המוכרזים כחדלי פירעון ואלה שדירותיהם נמכרו), ושהיו יכולים לאפשר לימוד התנהגותו של שוק המשכנתאות לצורך התוויית מדיניות מושכלת.
# raw = {'id': 1, 'text': 'הסדרים ציבוריים / חוקיים / תקנוניים בנושאי משכנתאות, ביניהם: התיקון לחוק הערבות (1992), המחייב בנקים למשכנתאות למצות הליכים כנגד החייב לפני פנייה לערבים, אשר יצר מצב חדש שאין לו מענים תקנוניים הולמים; פתיחת אפשרות רחבה ^LTV גבוה מאוד (עד 95% באופן פורמלי, ויותר מכך בפועל), גם עבור עולים חדשים, שלא מצאו את מקומם בשוק העבודה; רשתות ביטחון בלתי מספיקות למקרי כשל בפירעון (גורם חשוב במיוחד, בקבוצה זו); ובנוסף לאלה, אי איסוף ואי פרסום של נתונים, שהיו יכולים לאפשר מעקב אחר החתומים על משכנתאות, ובעיקר, אחר הנכשלים (אלה המוכרזים כחדלי פירעון ואלה שדירותיהם נמכרו), ושהיו יכולים לאפשר לימוד התנהגותו של שוק המשכנתאות לצורך התוויית מדיניות מושכלת.', 'dspan': (0, 642), 'tokens': [{'id': 1, 'text': 'הסדרים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 0, 'deprel': 'root', 'dspan': (0, 6), 'span': (0, 6), 'lemma': 'הסדר'}, {'id': (2, 6), 'text': 'ציבוריים / חוקיים / תקנוניים', 'expanded': [{'id': 2, 'text': 'ציבוריים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'amod', 'lemma': 'ציבורי'}, {'id': 3, 'text': '/', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'lemma': '/'}, {'id': 4, 'text': 'ציים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'conj', 'lemma': 'ציים'}, {'id': 5, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 6, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 6, 'text': 'יתסויונונינים', 'upos': 'ADJ', 'xpos': 'ADJ', 'head': 4, 'deprel': 'amod', 'lemma': 'יתסויונונינים'}], 'span': (7, 35), 'dspan': (7, 35)}, {'id': (7, 8), 'text': 'בנושאי', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 8, 'text': 'נושאי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 162, 'deprel': 'nmod', 'lemma': 'נושא'}], 'span': (36, 42), 'dspan': (36, 42)}, {'id': 9, 'text': 'משכנתאות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feat