# file = txt/1300008.txt
# filelineno = 685
# sentno = 2
# text = היזמים, שמשביחים מאוד את הנכס שלהם ואין מנגנון שגורם להם להפנים את הנטל שהם גורמים לסביבה, לחינוך ולכבישים; הרשויות המקומיות שעדיין לא מודעות למצב, אבל מקבלות היטל השבחה גבוה ; ושוחרי הסביבה - שפתאום חברו ליזמים, אך לאחרונה החלו לקלוט את הסכנה", מציינת אלתרמן .
