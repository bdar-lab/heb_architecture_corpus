# file = txt/1300008.txt
# filelineno = 158
# sentno = 1
# text = כדוגמא למבנים המיועדים לאוכלוסייה פחות חזקה נסקרה שכונת נאות גולדה בנתניה, ובה מבנים חדשים יחסית בני 16 קומות, שגילם 8-7 שנים (ראו איור5 ), ולצידם מבנים ותיקים יותר בני 10 קומות אשר נבנו בשנות ה־70 וה־80 (ראו איור 7).
