# file = txt/1800039.txt
# filelineno = 194
# sentno = 4
# text = הסבר נוסף להתפלגות המעליות בדיור השכור הוא ששכר הדירה בעבור דירה עם מעלית יהיה גבוה יחסית, וכך מנתבים עצמם משקי הבית השוכרים גם באזורים בעלי פרופיל בנייה חדשה, לדירות (בממוצע) חסרות מעלית או מאפיינים "יקרים" אחרים.
