# file = txt/1800106.txt
# filelineno = 318
# sentno = 1
# text = בבניין חד משפחתי בן שלושה מפלסים פנימיים בצרפת נמדדה תחלופת האוויר לאורך 12 יום במצבים שונים של פתיחת חלונות, כאשר דיירי הבית ממשיכים את אורח חייהם הרגיל בבית לארוך כל תקופת המדידה (1987 Roulet) החוקרים מדגישים כי לא מהירות הרוח ולא הפרשי טמפרטורות היו הגורם העיקרי בהשפעה על שיעור תחלופת האוויר בחדרים, אלא פתיחה או סגירה של חלונות בבית (לאו דווקא בחדר הנמדד).
