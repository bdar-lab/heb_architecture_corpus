# file = txt/1800106.txt
# filelineno = 51
# sentno = 2
# text = בין הסקירות עליהן התבססנו קיימת סקירה שנערכה על ידי המכון השבדי להגנה מקרינה בשנת 1999 (1999 Akerblom), מאמר שפורסם על ידי קובלר ושות׳ ב- 2002 (Kovler et al), סקירה שנערכה בשנת 2008 על ידי חקין (2008 Haquin), וסקירה שנערכה על ידי קובלר בשנת 2009 (2009 Kovler).
