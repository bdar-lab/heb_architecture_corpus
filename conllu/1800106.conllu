# file = txt/1800106.txt
# filelineno = 592
# sentno = 3
# text = בהתחשב בעובדה שבדיקות הבטונים הראו שקצב השפיעה החופשית מהקיר, E0w, לא עלה על הערך הנ"ל באף מקרה, ומשום שתחלופת אוויר כה נמוכה תגרום בדרך כלל לפתיחת חלון או דלת היות שהיא גורמת להצטברות לחות גדולה באוויר החדר, להיווצרות עיבוי על פני החלון, ולתחושת אי נעימות וחוסר נוחות בחדר, סביר להניח שהתנאים האלה לא יתקיימו במצבי שירות רגילים, ומהווים מבחינה זו מצב גבולי נדיר.
