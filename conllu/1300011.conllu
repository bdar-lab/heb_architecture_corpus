# file = txt/1300011.txt
# filelineno = 307
# sentno = 1
# text = התמודדות עם אתגרים אקולוגיים בנוף הישראלי - גידול האוכלוסייה המואץ בישראל ופיתוח התשתיות הנדרש על מנת לספק את המענה לגידול זה, יחד עם הצמיחה הכלכלית, יביאו להגברת הלחץ על בתי הגידול שנותרו בארץ, על הפוטנציאל לשמירה על המגוון הביולוגי הייחודי הקיים בישראל ועל יכולתן של המערכות האקולוגיות לספק תועלות תומכות-חיים (שירותי מערכת אקולוגית כדוגמת מזון, מים ואנרגיה) לאוכלוסייה.
