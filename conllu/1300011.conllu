# file = txt/1300011.txt
# filelineno = 617
# sentno = 2
# text = המיפוי הראה כי אפשר לזהות סכמות מרחביות החוזרות על עצמן במאה שנות פיתוח בישראל: מהעיר העתיקה לבנייה מוסדית בשוליה, מתכנון גריד והמושבות הראשונות להתפתחות הערים, דרך היציאה ממרכזי הערים לפרברים ובניית השיכונים ועד הבינוי המגדלי.
