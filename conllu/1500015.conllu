# text = פתרונות שיקלו על התנהלותן של נשים בפרט, וכלל תושבי העיר, כוללים שימוש באינטרנט להזמנה מחנויות, תשלום חשבונות, הזמנת מונית או רכב שכור, או צפייה במפות אינטראקטיביות לתכנון הנסיעה; כבישי אגרה למשתמשים במכוניות, והקמת נתיבי אופניים ואוטובוסים במימון אגרה זו; עידוד עבודה מהבית או עבודה בשעות גמישות; עידוד השימוש באמצעי תחבורה לא מזהמים ולא יוצרי גודש, וביניהם תחבורה ציבורית, רכב היברידי, הליכה ברגל, ורכיבה על אופניים או רולרבליידס (2004 ,Zielinski).
# raw = {'id': 3, 'text': 'פתרונות שיקלו על התנהלותן של נשים בפרט, וכלל תושבי העיר, כוללים שימוש באינטרנט להזמנה מחנויות, תשלום חשבונות, הזמנת מונית או רכב שכור, או צפייה במפות אינטראקטיביות לתכנון הנסיעה; כבישי אגרה למשתמשים במכוניות, והקמת נתיבי אופניים ואוטובוסים במימון אגרה זו; עידוד עבודה מהבית או עבודה בשעות גמישות; עידוד השימוש באמצעי תחבורה לא מזהמים ולא יוצרי גודש, וביניהם תחבורה ציבורית, רכב היברידי, הליכה ברגל, ורכיבה על אופניים או רולרבליידס (2004 ,Zielinski).', 'dspan': (266, 715), 'tokens': [{'id': 1, 'text': 'פתרונות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 17, 'deprel': 'nsubj', 'dspan': (266, 273), 'span': (0, 7), 'lemma': 'פתרון'}, {'id': (2, 3), 'text': 'שיקלו', 'expanded': [{'id': 2, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 3, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 3, 'text': 'יקלו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem,Masc|HebBinyan=HIFIL|Number=Plur|Person=3|Tense=Fut|Voice=Act', 'head': 1, 'deprel': 'acl:relcl', 'lemma': 'הקל'}], 'span': (8, 13), 'dspan': (274, 279)}, {'id': 4, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'dspan': (280, 282), 'span': (14, 16), 'lemma': 'על'}, {'id': (5, 6), 'text': 'התנהלותן', 'expanded': [{'id': 5, 'text': 'התנהלות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'obl', 'lemma': 'התנהלות'}, {'id': 6, 'text': 'ן', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Definite=Def|Gender=Fem|Number=Plur|Person=3|Poss=Yes|PronType=Prs', 'head': 5, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (17, 25), 'dspan': (283, 291)}, {'id': 7, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 8, 'deprel': 'case', 'dspan': (292, 294), 'span': (26, 28), 'lemma': 'של'}, {'id': 8, 'text': 'נשים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 5, 'deprel': 'nmod:poss', 'dspan': (295, 299), 'span': (29, 33), 'lemma': 'איש'}, {'id': 9, 'text':