# file = txt/1500015.txt
# filelineno = 86
# sentno = 1
# text = מספר שינויים שכבר חלו ומקלים על הנשים כוללים החלפת חופשת הלידה לאם בחופשה הורית, מתן זכות לאבות ללקיחת ימי מחלה עבור טיפול בילדיהם, ביטול ההגבלה על עבודת לילה של נשים, השוואת גיל הפרישה לפנסיה, וכדומה (יזרעאלי, 1993).
