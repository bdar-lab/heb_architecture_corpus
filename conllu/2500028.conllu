# file = txt/2500028.txt
# filelineno = 159
# sentno = 2
# text = מבין החסרונות המובהקים שהועלו ע״י הדיירים רק רגישות קירות הגבס למכה והתפוררות קירות הגבס בחדרי רחצה מופיעים בשכיחות קרובה או גבוהה מזו של המעדיפים בנייה כבדה־ בקבוצה vin השכיחויות של : סדקים בקירות, דהייה וקילוף צבע מחלונות ותריסים, התעקמות חלונות ודלתות, הפרעות אקוסטיות, פגיד פגיעה בפרטיות עקב בידוד אקוסטי לקוי, והעדר מקום לאיחסון, קרובות או עולות על השכיחות של המעדיפים מגורים בבנייה כבדה.
