# file = txt/2000061.txt
# filelineno = 1169
# sentno = 1
# text = השערה זו ניתנת לאינטרפרטציה הבאה: אם מחלף השלום שעל האיילון הוא מרכז התעסוקה במטרופולין, וקיימים שני אזורי מגורים הנמצאים במרחק שווה מנקודה זו, אולם האחד לאורך ציר האיילון והשני ניצב לציר זה, יעלו המחירים שלאורך הציר בקצב גדול יותר מאשר באזור הניצב.
