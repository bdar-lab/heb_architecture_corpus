# file = txt/2300027.txt
# filelineno = 327
# sentno = 3
# text = מחצבה המטפסת על מדרון, יוצרת "פצע" בהר, המדרגות והקירות מתוכננים בהתאם לתקנות בטיחות של משרד העבודה, אולם בעזרת נתוח ויזואלי נופי ניתן לתכנן את המדרגות והקירות גם בהתחשב בפרופיל המדרון הממוצע של שטח החציבה בו מוקם האתר, יש לציין שבתכנון ההשתלבות הצורתית, בין צורת החציבה המודרגת, רצוי שתלך במקביל לקוי גובה, יש לתת תשומת לב מיוחדת לקוי המגע הניצבים לקוי גובה, מאחר, שפעילות החציבה נמשכת עשרות בשנים, ניחן גם לתכנן את פתיחת המחצבה והמשך ההליך החציבה בדרך שתביא למינימום של התבלטות למשך תקופה ממושכת, כלומר, להקטין את משך זמז ההתבלמות הויזואלית, במקרים מסוימים ניתן להקטין את ההתבלטות ע״י השארת חגורת צומת מסביבה, במידה והיא קיימת, ואף ניתן עם התחלת החציבה לדאוג לצמחיה "מסוה" מבחינה ויזואלית, תכנון מעין זה יביא את אתר החציבה לסיומו, כשההתבלטות הויזואלית הינה מינימלית ופעולת השיקום אף היא פשוטה יחסית,
