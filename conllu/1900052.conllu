# file = txt/1900052.txt
# filelineno = 36
# sentno = 1
# text = (1)	תוביל אל כניסות נגישות של מוסד חינוך חדש מתחנה לאיסוף נוסעים ולהורדתם, ומאזורי העלאת נוסעים כמשמעותם בת"י 1918 חלק 2, אם אלה מצויים בתחום המגרש, וכן ממדרכה או משביל ציבורי הגובלים במגרש, כפי שמתואר במפת תיאור העבודה כנדרש בתקנה 5(ב) לתקנות בקשה להיתר;
