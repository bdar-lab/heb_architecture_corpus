# file = txt/2000114.txt
# filelineno = 403
# sentno = 3
# text = זהו קונפליקט בין השאיפה ל״חקלאות מודרנית" לבין הנוף והטבע, המתרחש כיום בישראל, בה בשעה שבארצות המערב המפותחות מתחזקת המגמה של ״חזרה בתשובה״: הכרה בחשיבות האקולוגית והחברתית של החקלאות המסורתית, ונכונות ציבורית לשלם על מנת שזו תמשיך להתקיים.
