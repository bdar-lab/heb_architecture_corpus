# text = אברהם יסקי, אחד האדריכלים המשפיעים ביותר בישראל מאמצע שנות החמישים ועד היום החל לעבוד כאדריכל עצמאי ב 1955 יחד עם אדריכל שמעון פובזנר לאחר שזכו יחד בתחרות לתכנון הפקולטה לכלכלה ולמדעי החברה בקמפוס גבעת רם באוניברסיטה העברית בירושלים.
# raw = {'id': 1, 'text': 'אברהם יסקי, אחד האדריכלים המשפיעים ביותר בישראל מאמצע שנות החמישים ועד היום החל לעבוד כאדריכל עצמאי ב 1955 יחד עם אדריכל שמעון פובזנר לאחר שזכו יחד בתחרות לתכנון הפקולטה לכלכלה ולמדעי החברה בקמפוס גבעת רם באוניברסיטה העברית בירושלים.', 'dspan': (0, 233), 'tokens': [{'id': 1, 'text': 'אברהם', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 20, 'deprel': 'nsubj', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'אברהם'}, {'id': 2, 'text': 'יסקי', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'flat:name', 'dspan': (6, 10), 'span': (6, 10), 'lemma': 'יסקי'}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (10, 11), 'span': (10, 11), 'lemma': ','}, {'id': 4, 'text': 'אחד', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'appos', 'dspan': (12, 15), 'span': (12, 15), 'lemma': 'אחת'}, {'id': (5, 6), 'text': 'האדריכלים', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'אדריכלים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'compound:smixut', 'lemma': 'אדריכל'}], 'span': (16, 25), 'dspan': (16, 25)}, {'id': (7, 8), 'text': 'המשפיעים', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 8, 'text': 'משפיעים', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HIFIL|Number=Plur|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 6, 'deprel': 'acl:relcl', 'lemma': 'השפיע'}], 'span': (26, 34), 'dspan': (26, 34)}, {'id': 9, 'text': 'ביותר', 'upos': 'ADV', 'xpos': 'ADV', 'head': 8, 'deprel': 'advmod', 'dspan': (35, 40), 'span': (35, 40), 'lemma': 'ביותר'}, {'id': (10, 11), 'text': 'בישראל', 'expanded': [{'id': 10, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'lemma': 'ב'}, {'id': 11, 'te