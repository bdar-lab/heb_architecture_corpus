# file = txt/1500026.txt
# filelineno = 332
# sentno = 1
# text = בישיבה זו השתכנעו חברי הועדה לוותר על חלופה של השטח בדרום מערב העיר ליד כביש חצרים (שטח 4), ממספר טעמים: צפויות הפרעות אקוסטיות משדה התעופה הקרוב (בבסיס חיל האוויר חצרים), הועדה לא מצאה יתרון אורבני משמעותי במיקום הקמפוס החדש במקום ואף הועלה חשש כי הקרבה למוסדות חינוך רבים באזור תמנע את התפתחותה של אוניברסיטה במקום זה.
