# file = txt/1500026.txt
# filelineno = 378
# sentno = 1
# text = בחינת הקריירה של האדריכלים מיכאל ושולמית נדלר מעלה כי החלו את דרכם המקצועית בהשתתפות בתחרויות לתכנון מבני ציבור: ב 1947 זכו בתחרות לתכנון מדרשה חקלאית בעמק חפר, ב 1951 זכו בתחרות לתכנון בית תרבות לפועלי באר שבע, ב 1952 זכו בתחרות לתכנון מעונות הסטודנטים בקמפוס גבעת רם בירושלים, ב 1955 זכו בתחרות לתכנון בית אגד בתל אביב ובאותה שנה זכו במקום שלישי בתחרות לתכנון מגורים לעובדי בית החולים הדסה בעין כרם בירושלים.
