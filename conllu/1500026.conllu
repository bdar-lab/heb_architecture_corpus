# file = txt/1500026.txt
# filelineno = 747
# sentno = 1
# text = הצענו מערך של בניינים המתלכדים ליצירת כיכר אורבנית – אמצעי לקרב בין "חיי העיר" שבקמפוס לבין חיי העיר כולה, בדומה למוסדות ההשכלה הנטועים בלבו של מרכז עירוני (כמו גימנסיה הרצליה הישנה בתל אביב או בניין הטכניון הישן בחיפה) או במסורת "ערי האוניברסיטה" האנגליות (דוגמת אוקספורד וקיימברידג').
