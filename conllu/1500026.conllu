# file = txt/1500026.txt
# filelineno = 741
# sentno = 2
# text = כמו כן, מבירור שערכו ראשי האוניברסיטה במוסדות אקדמיים אחרים בארץ, כמו מכון וייצמן, התברר כי שיכון הסגל הזוטר יחד עם סטודנטים לתואר ראשון, באותו מתחם לא עלה יפה ולכן החליטה הנהלת האוניברסיטה שכל מרצה (כולל סגל הוראה זוטר) יתארגן לפי טעמו ושיקוליו והמוסד יתמוך כלכלית בשכירה או ברכישת דירה בעיר באר שבע.
# raw = {'id': 2, 'text': 'כמו כן, מבירור שערכו ראשי האוניברסיטה במוסדות אקדמיים אחרים בארץ, כמו מכון וייצמן, התברר כי שיכון הסגל הזוטר יחד עם סטודנטים לתואר ראשון, באותו מתחם לא עלה יפה ולכן החליטה הנהלת האוניברסיטה שכל מרצה (כולל סגל הוראה זוטר) יתארגן לפי טעמו ושיקוליו והמוסד יתמוך כלכלית בשכירה או ברכישת דירה בעיר באר שבע.', 'dspan': (385, 686), 'tokens': [{'id': 1, 'text': 'כמו', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'dspan': (385, 388), 'span': (0, 3), 'lemma': 'כמו'}, {'id': 2, 'text': 'כן', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Person=3|PronType=Dem', 'head': 22, 'deprel': 'obl', 'dspan': (389, 391), 'span': (4, 6), 'lemma': 'כן'}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 22, 'deprel': 'punct', 'dspan': (391, 392), 'span': (6, 7), 'lemma': ','}, {'id': (4, 5), 'text': 'מבירור', 'expanded': [{'id': 4, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'מ'}, {'id': 5, 'text': 'בירור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 22, 'deprel': 'obl', 'lemma': 'בירור'}], 'span': (8, 14), 'dspan': (393, 399)}, {'id': (6, 7), 'text': 'שערכו', 'expanded': [{'id': 6, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 7, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 7, 'text': 'ערכו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem,Masc|HebBinyan=PAAL|Number=Plur|Person=3|Tense=Past|Voice=Act', 'head': 5, 'deprel': 'acl:relcl', 'lemma': 'ערך'}], 'span': (15, 20), 'dspan': (400, 405)}, {'id': 8, 'text': 'ראשי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 7, 'deprel': 'nsubj', 'dspan': (406, 410), 'span': (21, 25), 'lemma': 'ראש'}, {'id': (9, 10), 'text': 'האוניברסיטה', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 10, 'deprel': 'det', 'lemma': 'ה'}, {'id': 10, 'text': 'אוניברסיטה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, '