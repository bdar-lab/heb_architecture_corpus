# sentno = 3
# text = 28 מחקר בנוגע לעלויות בנייה ירוקה למגורים שנערך ביוזמת המועצה הישראלית לבנייה ירוקה,29 בחן שני מקרי מבחן של מבני מגורים ירוקים, ומצא כ׳ ההשקעה הנוספת בגין רכיבים ירוקים, ביחס לבנייה קונבנציונאלית, הייתה 4.1% ו-% 2.1 מעלות הבנייה של הבניין, וזאת בניגוד לדעה הרווחת, לפיה בנייה ירוקה יקרה באופן משמעות׳ מבנייה קונבנציונאלית.
