# file = txt/1400063.txt
# filelineno = 181
# sentno = 1
# text = השינוי הראשון בתמ"א 38 אושר ב- 69.16.8.2007 מטרת השינוי הייתה להבהיר את היחס בין תמ״א 38 לבין תכניות מפורטות שקדמו לה, להבהיר את מועד החלת התכנית (מבנים שההיתר לבנייתם הוצא לפני 1.1.1980 ולא רק כאלו שנבנו לפני מועד זה) ולהכליל הוראה בדבר חיזוק המבנה כתנאי למתן היתר.
