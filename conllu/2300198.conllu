# file = txt/2300198.txt
# filelineno = 852
# sentno = 7
# text = לדוגמה, במבנה עם שלד בטון יש לשים לב להחלדת זיון ושיחון הבטון כתוצאה מחדירת רטיבות; במבנה עם שלד פלדה יש לשים לב לקורוזיה של רכיבי שלד, כשל או ריפוי מחברים; חיבורים לרכיבים לא מבניים, כגון קירות מסך וכו׳.
