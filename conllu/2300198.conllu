# file = txt/2300198.txt
# filelineno = 513
# sentno = 1
# text = מבחינת הבנייה לגובה יש חשיבות לכלול בהליכי הרישוי באופן מוגדר ומפורש את המקצועות ההנדסיים הבאים: מהנדסי מבנים; מהנדס גיאוטכני; מהנדס בניין (כולל התמחויות אפשריות: בטיחות, בטיחות אש, תפקוד/פיסיקת הבנייה, אקוסטיקת הבנייה, חומרים וטכנולוגיות בנייה); מהנדס מערכות בנייה (כולל התמחויות אפשריות: מיזוג אוויר ואוורור; חשמל; אלקטרוניקה; תאורה; בקרה; בטיחות; הגנת ברקים; תקשורת; מערכות סניטריות; מעליות); מהנדס ניהול וביצוע.
