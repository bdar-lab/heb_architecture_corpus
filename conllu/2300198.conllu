# file = txt/2300198.txt
# filelineno = 11
# sentno = 4
# text = בגישה מערכתית אידיאלית יש לקחת בחשבון את מכלול הנושאים וההיבטים בהם צריך לתת מענה לתפקוד בטיחותי ותקין של הבניין וחלקיו, לגבש חלופות תכנון כוללניות המאפשרות מתן מענה בו־זמני לכל הדרישות והקריטריונים, לבחון מהי החלופה הכלכלית והמתאימה ביותר מבחינת הפרוייקט הספציפי, עבור חלופה זו למצוא את טווח הפתרונות האופטימליים (במובן שכל הפתרונות בטווח עומדים בדרישות הסף, אך לכל אחד מהם יתרונות בנושאים אחרים, ועלות מחזור חיים אחרת), ולבחור מתוך טווח זה את הפיתרון העדיף ביותר לפרוייקט הנתון לפי שיקולים פרטניים של היזם וסדרי עדיפות שלו.
