# text = הקביעות הרשומות הן תוצאה של שיקול דעת, הלוקח בחשבון גורמים שונים התורמים לסיכון האש, ובהם גורמים מקומיים כמו רמת המודעות של הציבור לסיכוני האש, מהירות ההגעה ורמת הביצועים של מערכות הכבאות, וגורמים תכנוניים כמו ייעוד הבניין, גודלו וגובחו, וקיום מערכות מתזים אוטומטיים.
# raw = {'id': 3, 'text': 'הקביעות הרשומות הן תוצאה של שיקול דעת, הלוקח בחשבון גורמים שונים התורמים לסיכון האש, ובהם גורמים מקומיים כמו רמת המודעות של הציבור לסיכוני האש, מהירות ההגעה ורמת הביצועים של מערכות הכבאות, וגורמים תכנוניים כמו ייעוד הבניין, גודלו וגובחו, וקיום מערכות מתזים אוטומטיים.', 'dspan': (538, 805), 'tokens': [{'id': (1, 2), 'text': 'הקביעות', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'קביעות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 6, 'deprel': 'nsubj', 'lemma': 'קביעות'}], 'span': (0, 7), 'dspan': (538, 545)}, {'id': (3, 4), 'text': 'הרשומות', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'רשומות', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Plur', 'head': 2, 'deprel': 'amod', 'lemma': 'רשם'}], 'span': (8, 15), 'dspan': (546, 553)}, {'id': 5, 'text': 'הן', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Plur|Person=3|Polarity=Pos|PronType=Prs', 'head': 6, 'deprel': 'cop', 'dspan': (554, 556), 'span': (16, 18), 'lemma': 'הוא'}, {'id': 6, 'text': 'תוצאה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (557, 562), 'span': (19, 24), 'lemma': 'תוצאה'}, {'id': 7, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 8, 'deprel': 'case', 'dspan': (563, 565), 'span': (25, 27), 'lemma': 'של'}, {'id': 8, 'text': 'שיקול', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'nmod:poss', 'dspan': (566, 571), 'span': (28, 33), 'lemma': 'שיקול'}, {'id': 9, 'text': 'דעת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'compound', 'dspan': (572, 575), 'span': (34, 37), 'lemma': 'דעה'}, {'id': 10, 'te