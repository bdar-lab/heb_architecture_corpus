# text = •	בתקן הישראלי ת״י 1525, ו/או בכל מסמך אחר שיוחלט עליו להנחיית עבודתן של חברות התחזוקה, יש להוסיף את הנושא הבא: בכל מקרה שנעשית פעולת שיפוץ או תיקון פולשנית באזורי החיבור של קירות חוץ ותקרות הבניין, יש לוודא שלא נפגם תפקודם של מחסומי רעש, עשן, אש וריחות המותקנים שם.
# raw = {'id': 1, 'text': '•\tבתקן הישראלי ת״י 1525, ו/או בכל מסמך אחר שיוחלט עליו להנחיית עבודתן של חברות התחזוקה, יש להוסיף את הנושא הבא: בכל מקרה שנעשית פעולת שיפוץ או תיקון פולשנית באזורי החיבור של קירות חוץ ותקרות הבניין, יש לוודא שלא נפגם תפקודם של מחסומי רעש, עשן, אש וריחות המותקנים שם.', 'dspan': (0, 266), 'tokens': [{'id': 1, 'text': '•', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 29, 'deprel': 'punct', 'dspan': (0, 1), 'span': (0, 1), 'lemma': '•'}, {'id': (2, 3), 'text': 'בתקן', 'expanded': [{'id': 2, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'lemma': 'ב'}, {'id': 3, 'text': 'תקן', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 29, 'deprel': 'obl', 'lemma': 'תקן'}], 'span': (2, 6), 'dspan': (2, 6)}, {'id': (4, 5), 'text': 'הישראלי', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'ישראלי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'amod', 'lemma': 'ישראלי'}], 'span': (7, 14), 'dspan': (7, 14)}, {'id': 6, 'text': 'ת״י', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Abbr=Yes|Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'nmod', 'dspan': (15, 18), 'span': (15, 18), 'lemma': 'ת״י'}, {'id': 7, 'text': '1525', 'upos': 'NUM', 'xpos': 'NUM', 'head': 6, 'deprel': 'nummod', 'dspan': (19, 23), 'span': (19, 23), 'lemma': '1525'}, {'id': 8, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (23, 24), 'span': (23, 24), 'lemma': ','}, {'id': (9, 11), 'text': 'ו/או', 'expanded': [{'id': 9, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 14, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 10, 'text': '/', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 11, 'deprel': 'cc', 'lemma': '/'}, {'id': 11, 'text': 'או', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 9, 'deprel': 'dep', 'lemma': 'או'}], 'span': (25, 29), 'dspan': (25, 29)}, {'id': (12, 13), 'te