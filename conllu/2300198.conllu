# file = txt/2300198.txt
# filelineno = 106
# sentno = 5
# text = היות שלפרט הרוכש או שוכר חלק בבניין, שניבנה ע״י אחרים (למשל בבנייני מגורים ומשרדים), אין כל שליטה על תהליך התכנון וטיב הבנייה, ואין לו כל כלים לבחון אותם בזמן ביצוע העיסקה, נהוג ברוב המדינות להסדיר ע״י התקנות גם את טיב הבנייה, וזאת על-מנת למנוע אובדן ערך בלתי סביר לרכוש (שהוא מלכתחילה יקר במיוחד לעומת מוצרי צריכה מתכלים) כתוצאה מטיב ירוד יתר על המידה.
