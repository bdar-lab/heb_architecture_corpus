# file = txt/2300198.txt
# filelineno = 134
# sentno = 1
# text = ב.	המצב שבו הכללים לתכנון ולבניית מרחבים מוגנים וחדרי מדרגות ביטחוניים או מחוזקים בבניינים הם בשליטה בלעדית של גוף בטחוני ומכוסים בחוקים ותקנות שאינם מקושרים היטב עם תקנות התכנון והבנייה: בנייה ביטחונית בכלל, ובנייה כזו שהיא חלק מבניין אזרחי כללי בפרט, הם בעיקרם נושאים הנדסיים וצריכים להיות כלולים במסגרת נוהלי הבנייה הרגילים, כולל תקנות התכנון והבנייה והתקנים השונים.
