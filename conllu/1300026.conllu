# file = txt/1300026.txt
# filelineno = 161
# sentno = 3
# text = להערכתנו, התמיכה הממשלתית בהקמה ואיכלוס יישובי הפריפרייה היתה תנאי הכרחי בשלבי□ הראשונים, אך לקראת שנות האלפיים, ובהנחה שהממשלה עדיין מעוניינת לקדם את איכלוס הפריפרייה, מוטב להעביר את רוב הסיוע הציבורי לתשתיות, בעיקר תשתיות קומוניקציה וחינוך, וגם לפיתוח תעסוקה מקומית מתקדמת (כרמון ואחרים, 1996).
