# file = txt/1300026.txt
# filelineno = 85
# sentno = 4
# text = מה שאי אפשר לראות בטבלה, משום שאיש לא טרח לעבד את הנתונים הרלבנטיים, אלה הפערים הגדולים בתוך האוכלוסייה הערבית, בין מוסלמים, נוצרים ודרוזים, בין עשירונים עליונים לתחתונים, ובין המתגוררים מחוץ ליישובים מוכרים (כ-5% מהערבים בישראל) לבין האחרים.
