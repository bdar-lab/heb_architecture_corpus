# file = txt/1300026.txt
# filelineno = 162
# sentno = 1
# text = השאלה השניה היא: האם סביר לזקוף את השיפורים הרבים בתנאי הדיור של אזרחי ישראל בחמישי□ השנים האחרונות לזכותה של מדיניות השיכון הישראלית, או ששיפורים דומים היו חלים גם אילו הושאר תחום הדיור למשחק השוק החופשי’ בהעדר דרך לבדיקה אמפירית ישירה של שאלה זו, אתייחס אליה באמצעות השוואה בין תהליכים שחלו בסקטור היהודי, שבו היתה מעורבות עמוקה מאד של הממשלה, הן בצד ההיצע והן בצד הביקוש לדיור, לעומת הסקטור הערבי, שבו היתה מעורבות ציבורית מזערית במשך כ-30 שנה ומעורבות קטנה בלבד בשנים הבאות.
