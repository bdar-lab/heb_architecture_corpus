# file = txt/1300026.txt
# filelineno = 109
# sentno = 4
# text = אולם העיון בה מלמד על כך שבשנות ה-70, משרד השיכון עדיין רואה עצמו כממונה לא רק על בניין הארץ אלא גם על גיבוש החברה הישראלית, וזאת באמצעות בניית שכונות מגוונות מבחינה דפוסי הדיור והרכב האוכלוסייה, ובעזרת הקמתם של כל מוסדות הציבור הדרושים בן: מוסדות חינוך, בריאות, תרבות וחברה, מרכז מסחרי, גנים ושטחים פתוחים.
