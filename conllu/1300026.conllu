# file = txt/1300026.txt
# filelineno = 165
# sentno = 2
# text = דוגמא בכיוון ההפוך: ממשלת ישראל השקיעה כסף ומאמץ רב בשיקומן של שכונות מצוקה ויצרה בן תנאי חיים דומים, מבחינה חיצונית, לאלה של שכונות טובות; לאחרונה, הפעילות הממשלתית יוצאת מן השכונות ומפנה את הדרך לפעילות של הסקטור הפרטי, המוכן להשקיע בבנייה חדשה עבור המעמד הבינוני בשכונות שמצבן שופר, תודות למאמץ הציבורי.
