# file = txt/1500014.txt
# filelineno = 293
# sentno = 2
# text = ניתן להבחין למשל כי הקריקטורות הועדפו בעיקר בגלל הבעות הפנים של הדמויות (סיבה שלא ניתנה לאף סוגה אחרת), הריאליסטי הנטרלי נבחר רק מהסיבה שנתפסו כברורות ומובנות, ואחוז ניכר מסך הנבדקים שהעדיפו את הסוגות מופשט וצללית הצהירו כי עשו זאת כיוון שאלו נראו להם סמלים מסוכנים יותר או כיוון שדמו בעיניהם לדברים מוכרים מהעולם האמיתי.
