# file = txt/1500014.txt
# filelineno = 93
# sentno = 7
# text = כאשר מתייחסים אל תפיסת הסיכון כמשתנה בלתי תלוי (כמו במקרה הנוכחי), מוקד העניין יכול להיות אחד משניים: מחקר עשוי להתמקד בשורש הנטייה או הדעה הקדומה שגורמת לאנשים לעיוות בהערכה ובתגובה לסיכונים שונים או, כפי שבחרנו במקרה זה, לעסוק בתפיסת הסיכון בצורה יותר כוללת ולאמוד את היכולת של מספר אזהרות להשפיע על שיקול הדעת המתבטא בערכת המסוכנות הנתפסת.
