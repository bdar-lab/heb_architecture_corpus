# file = txt/1500014.txt
# filelineno = 324
# sentno = 5
# text = על פי תפיסה זו, ניתן לפרש כי הסוגות שנמצאו עדיפות במחקר הנוכחי מאופיינות בתאימות גדולה יותר למודל הקיים אצל המשתמשים לגבי השאלה איך צריך להראות סמל בטיחות, וניתן לשער כי ההיכרות של הנבדקים עם תמרורים ושלטי בטיחות אחרים היא שגרמה להם לתפוס את הסוגות המופשטות כיותר "אזהרתיות" ומתאימות לעיצוב סמלי בטיחות.
