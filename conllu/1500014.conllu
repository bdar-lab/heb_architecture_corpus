# file = txt/1500014.txt
# filelineno = 9
# sentno = 4
# text = יצוין כי ממצאיה של העבודה הנוכחית שולבו לכדי תוצר שלם של מערכת שלטי בטיחות אשר מומשה במפעל במסגרת פרויקט של יחידת היישום של מרכז המחקר לבטיחות בעבודה והנדסת אנוש בטכניון (גולדשמידט, גופר, מרום, קדמי ושגיא, 2006).
