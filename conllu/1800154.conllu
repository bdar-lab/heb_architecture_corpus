# file = txt/1800154.txt
# filelineno = 520
# sentno = 1
# text = הניסויים הראו שסדקים רחבים אינם מתפתחים באזורים בהם טבלת המקשר קיימת בין הלוח הראשון לקורת שפה, במידה ואין קורה ניצבת המתחברת לעמוד וניתן מספיק זיון קושר בטופינג המסוגל לקבל את כוח מתיחה תקני (10.3.6 NZS 3101: 2006, clause), ראה איור א-30 (c).
