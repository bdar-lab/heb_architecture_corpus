# file = txt/1400077.txt
# filelineno = 42
# sentno = 4
# text = נוסף על כך, נטל תחזוקת השטחים הירוקים הרבים בערים היה קשה מדי עבור הרשויות המקומיות, וכך השטחים ה"ירוקים" בתכניות נשארו בשממתם (שדר, 2014), ויתרה מכך, חוסר בתשתית ובמזבלות הביא להשלכת פסולת רבה ברשות הרבים (חסון & ולר׳, 2012).
