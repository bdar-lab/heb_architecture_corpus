# text = תהליך דומה התקיים גם במערכות התכנון באירופה ובצפון אמריקה, והוביל לשינו׳ פרדיגמאט■ בשיח הסביבתי/תכנוט במהלך השנים האחרונות: מחיפוש אחר סביבות עירוניות "ירוקות" ונקיות מזיהומים, ישנו מעבר לחיפוש אחר סביבות התומכות באורח ח״ם בעל השפעה סביבתית נמוכה; ומדגש על איכותה של הסביבה המקומית בלבד - לדגש גם על איכותה של הסביבה הגלובלית.
# raw = {'id': 1, 'text': 'תהליך דומה התקיים גם במערכות התכנון באירופה ובצפון אמריקה, והוביל לשינו׳ פרדיגמאט■ בשיח הסביבתי/תכנוט במהלך השנים האחרונות: מחיפוש אחר סביבות עירוניות "ירוקות" ונקיות מזיהומים, ישנו מעבר לחיפוש אחר סביבות התומכות באורח ח״ם בעל השפעה סביבתית נמוכה; ומדגש על איכותה של הסביבה המקומית בלבד - לדגש גם על איכותה של הסביבה הגלובלית.', 'dspan': (0, 326), 'tokens': [{'id': 1, 'text': 'תהליך', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'nsubj', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'תהליך'}, {'id': 2, 'text': 'דומה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'amod', 'dspan': (6, 10), 'span': (6, 10), 'lemma': 'דומה'}, {'id': 3, 'text': 'התקיים', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HITPAEL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (11, 17), 'span': (11, 17), 'lemma': 'התקיים'}, {'id': 4, 'text': 'גם', 'upos': 'ADV', 'xpos': 'ADV', 'head': 6, 'deprel': 'advmod', 'dspan': (18, 20), 'span': (18, 20), 'lemma': 'גם'}, {'id': (5, 6), 'text': 'במערכות', 'expanded': [{'id': 5, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ב'}, {'id': 6, 'text': 'מערכות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 3, 'deprel': 'obl', 'lemma': 'מערכת'}], 'span': (21, 28), 'dspan': (21, 28)}, {'id': (7, 8), 'text': 'התכנון', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'תכנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'compound', 'lemma': 'תכנון'}], 'span': (29, 35), 'dspan': (29, 35)}, {'id': (9, 10), 'text': 'באירופה', 'expanded': [{'id': 9, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ב'}, {'id': 10, 'text': 'אירופה', 'upos': 'PROPN'