# file = txt/1500216.txt
# filelineno = 392
# sentno = 2
# text = בעוד ה- BGIE מתמקד במרחב העירוני בפרויקטים נופיים המשלבים אמצעים לניהול נגר, שני הכלים האחרים מתאפיינים בהערכת אזורים נרחבים בהרבה: מטרתו של ה-Envision היא להעריך את מידת הקיימות של פרויקטי תשתית גדולים (בשטח הפתוח או במרחב העירוני), ומטרתו של האינדקס האוסטרלי היא להעריך מידת הצלחתו של יישוב בקנ״מ משתנה (עיירה, עיר ומטרופולין) לנהל באופן מיטיבי את משאבי המים שלו.
