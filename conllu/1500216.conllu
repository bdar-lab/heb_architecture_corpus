# file = txt/1500216.txt
# filelineno = 9
# sentno = 2
# text = מסר זה התגבש בין היתר בעקבות תחזיות תכנית האב ״ישראל 2020״ שהצביעו על הגדלה משמעותית של היקפי הפיתוח העירוני במישור החוף, ולכן העלו חשש לפגיעה משמעותית במילויו החוזר של אקוויפר החוף (שמיר וכרמון 1997 ;1999 Shamir & Carmon).
