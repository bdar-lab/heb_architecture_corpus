# file = txt/1500211.txt
# filelineno = 105
# sentno = 1
# text = תהליך זה של הגשמת הקונספט שהתחיל בשנת 1939 והגיע לשיאו ב בתחילת שנות החמישים הוא אחת הדוגמאות לתהליך העיצוב האיטרטיבי של ציארלס וריי וליצירת "סדרות מחקר" של כסאות שהן כעין מעבר בין פיתרון (כיסא מסוים) לפיתרון הבא - האיטרציה הבאה.
