# file = txt/1500010.txt
# filelineno = 274
# sentno = 2
# text = המחקרים שנעשו בקרב אותם ילדים שכן מצליחים להתמודד עם המצב, מראים כי לאותם ילדים משאבים חברתיים, כולל משפחה תומכת המאופיינת בהורים מעורבים וחמים ומישהו אחר תומך מחוץ למשפחה (מורה, עובדת סוציאלית וכדומה) (,Torquati & Gamble 2001).
