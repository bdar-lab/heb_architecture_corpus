# file = txt/1500076.txt
# filelineno = 96
# sentno = 3
# text = רעיון הגמישות הוביל להדגשה של אלמנט נוסף של הבניין, אותו ניתן גם להסיק, לחוות ולראות: אלמנט התנועה והשינוי המאפיין הדומיננטי של הביקור במבנה זה, והמתרחש בו זמנית גם במרחב הציבורי של הבניין, (בפיאצה ובגג), וגם בתוככי הבנין.
