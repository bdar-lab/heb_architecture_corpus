# file = txt/1500076.txt
# filelineno = 862
# sentno = 1
# text = טכנולוגיית ה LCP, מתנהגת בתנאים מסוימים כמראה דו כיוונית, כלומר כפי שהיא מסוגלת להסיט אור החוצה בזוויות רום שמש גבוהות, כך היא מסוגלת גם להסיט אור פנימה, בזוויות רום שמש נמוכות, כפי שמתקיים במהלך הבוקר והערב, ממזרח וממערב בהתאמה (ראה ציור מס. 7.8).
