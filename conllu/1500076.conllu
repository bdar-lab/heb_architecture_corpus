# file = txt/1500076.txt
# filelineno = 115
# sentno = 2
# text = בניגוד לגישה העיצובית הגלובאלית בה אדריכלים כוכבי על מכתיבים סגנון אדריכלי מוחצן המותאם באופן דומה לכל סביבה אורבאנית ותרבותית נתונה, טוענים צוניס ולה פבר כי יש לבחון בגישה ביקורתית כיצד אדריכלות מקומית יוצרת דיאלוג בין תרבותי, בין החזית התרבותית של הציביליזציה הדומיננטית, המערבית לבין תרבויות האדריכלות ומסורות האומנות ומלאכת יד המקומיות58.
