# sentno = 4
# text = קאהן התעקש על השימוש באור טבעי – עם מגוון איכויותיו המשתנות, ואף טען כי חלל אינו חלל אדריכלי אם אינו מואר באור טבעי, בטענה כי האור החשמלי אינו מסוגל להאיר את החלל האדריכלי, היות ובחלל חייבת להיות נוכחת תחושת הזמן של היום והעונה שבשנה – וכל זאת בלתי ניתן להשגה על ידי תאורה החשמלית55 .
