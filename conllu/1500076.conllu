# file = txt/1500076.txt
# filelineno = 834
# sentno = 2
# text = בתוכנה זו ניתן לקבוע את תנאי הרקיע (בהיר, מועב, אחיד), התכונות הפיזיקאליות של החומר, כדוגמת מקדם החזרה והעברה, המיקום הגיאוגרפי – קו רוחב וקו אורך שבהם נמצא המבנה, וכן תאריך, שעה ודקה אשר לפיה מחושב כיוון מקור האור הטבעי.
