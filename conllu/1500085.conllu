# file = txt/1500085.txt
# filelineno = 639
# sentno = 4
# text = הדור שצמח לאחר מכן (כדוגמת רפי לביא ויגאל תומרקין בשנות השישים) הושפע גם הוא מהעשייה האמנותית הקוסמופוליטית: "גם אמנים אלה שאבו השראה ממגמות תרבות ברחבי העולם- דוגמת אמנות ה"פופ" האמריקאית ועבודתם של אמנים אירופאים... אבל החומרים 'החוץ אמנותיים' שבהם השתמשו נלקחו מהתרבות המקומית: כרזות פוליטיות ומודעות על אירועי תרבות, לוחות דיקט משומשים..." (פורר, 1998, עמ' 10).
