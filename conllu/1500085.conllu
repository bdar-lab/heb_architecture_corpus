# file = txt/1500085.txt
# filelineno = 640
# sentno = 1
# text = ניתן לאפיין את הזיקה בין האמנות הבינלאומית לזרמיה וגווניה השונים ובין האמנות הישראלית הן במובן של יחסי שוליים ומרכז (והרצון להפוך לחלק מקהילת האמנות המודרנית הבינלאומית) והן כמניע תרבותי שמהותו היא קבלה לזירה העולמית תוך וויתור (או הדחקה) של מאפייני זהות מקומיים, לאומיים (פישר, מנור-פרידמן, 2008).
