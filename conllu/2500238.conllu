# file = txt/2500238.txt
# filelineno = 356
# sentno = 2
# text = מניתוח התוצאות התקבל הרושם שהחוזק והקשיחות של הטפסות היו בדרך כלל מספיקים כדי למנוע דפורמציות העולות על המותר (3 מ"מ או 1/360 של המיפתח של אלמנטי הטפסות - הקטן מבין השניים), פרט למספר קטן של מקרים של טפסות לקירות שנוצקו בקצב מהיר מאד, ולשקיעות שהתקבלו לאורך קו החיבור בין שני חצאי טפסת מנהרה.
