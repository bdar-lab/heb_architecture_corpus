# file = txt/2300149.txt
# filelineno = 379
# sentno = 3
# text = עיקריהן - הענקת סמכות לגביית היטל במקום הפקעה, במקרים שבהם אין ההפקעה שוויונית, פיתוח אמות מידה לחלוקת נטל ההפקעה וההנאה ממנה, מיסוד נוהג שיחייב הצגתם של נימוקי תיכנון ענייניים כתנאי להפעלת סמכויות ההפקעה ללא תמורה, ומיסוד דרכים שיבטיחו הגנה לפרט והתראה מוקדמת לבעלים על הפקעה צפויה.
