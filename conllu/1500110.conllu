# file = txt/1500110.txt
# filelineno = 294
# sentno = 1
# text = בתשובה על ההצהרות הבאות לא נמצא הבדל בין קבוצות הגיל השונות: העדפה לשבת באותו צד של החולה ולא מעבר לשולחן, חשיבות שינוי עיצוב החלל ומיקום הכיור ו-או אמצעי החיטוי כך שיקל ויעודד את הרופא לחטא ידיים, הוספת אמצעי פשוט לנעילת הדלת ממקום מושבו של הרופא, שילוב שימוש באמצעי ביומטרי לזיהוי החולה עוד לפני כניסתו לחדר, חשיבות פיתוח אמצעי לבדיקה פיזיקאלית באופן מהיר, חשיבות פיתוח אמצעי שיפשט את המעבר מהכיסא למיטת הבדיקה, הוספת עמדת מחשב או מסך מגע סמוך למיטת הבדיקה לצורך הקלדת הנתונים של הבדיקה הפיזיקאלית תוך כדי הבדיקה, חשיבות פיתוח אמצעי הדפסה ושידוך תדפיסים טוב יותר בכדי לחסוך זמן וצורך בהוספת אמצעי לכריזה כדי שניתן יהיה לקרוא לחולה להיכנס לחדר הרופא.
