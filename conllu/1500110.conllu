# file = txt/1500110.txt
# filelineno = 26
# sentno = 1
# text = לעיצוב מרפאות ומבנים הקשורים למערכת הרפואית (Healthcare design) השפעה על פרמטרים רבים בקרב החולה והצוות הרפואי מביניהם: הורדת הלחץ בקרב הצוות והחולים וייעול הטיפול, שיפור בטיחות הצוות, הורדת מספר השגיאות הרפואיות, מניעת זיהומים צולבים בבית החולים, שיפור מנוחת החולים, מניעת מקרי דליריום בקרב החולים, הורדת משך האשפוזים ועוד.
