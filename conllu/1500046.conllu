# text = מצב זה תואם את טענתם של קלוש ולו-יון (2000), כי תהליכי השיכון בשנות החמישים ושיכונן של אוכלוסיות מהגרים באזורים פריפריאליים מבודדים יחסית - פיסית, חברתית ותרבותית - יצרו סביבות מגורים שלמות המתקשות בחלקן עד היום להפוך למקומות "ממשים", על-אף שהן מהוות מציאות יומיומית עבור חלק גדול מאוכלוסיית המדינה.
# raw = {'id': 6, 'text': 'מצב זה תואם את טענתם של קלוש ולו-יון (2000), כי תהליכי השיכון בשנות החמישים ושיכונן של אוכלוסיות מהגרים באזורים פריפריאליים מבודדים יחסית - פיסית, חברתית ותרבותית - יצרו סביבות מגורים שלמות המתקשות בחלקן עד היום להפוך למקומות "ממשים", על-אף שהן מהוות מציאות יומיומית עבור חלק גדול מאוכלוסיית המדינה.', 'dspan': (613, 912), 'tokens': [{'id': 1, 'text': 'מצב', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'nsubj', 'dspan': (613, 616), 'span': (0, 3), 'lemma': 'מצב'}, {'id': 2, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Dem', 'head': 1, 'deprel': 'det', 'dspan': (617, 619), 'span': (4, 6), 'lemma': 'זה'}, {'id': 3, 'text': 'תואם', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (620, 624), 'span': (7, 11), 'lemma': 'תאם'}, {'id': 4, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 5, 'deprel': 'case', 'dspan': (625, 627), 'span': (12, 14), 'lemma': 'את'}, {'id': (5, 6), 'text': 'טענתם', 'expanded': [{'id': 5, 'text': 'טענת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'obj', 'lemma': 'טענה'}, {'id': 6, 'text': 'ם', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Definite=Def|Gender=Masc|Number=Plur|Person=3|Poss=Yes|PronType=Prs', 'head': 5, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (15, 20), 'dspan': (628, 633)}, {'id': 7, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 8, 'deprel': 'case:gen', 'dspan': (634, 636), 'span': (21, 23), 'lemma': 'של'}, {'id': 8, 'text': 'קלוש', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 5, 'deprel': 'nmod:poss', 'dspan': (637, 641), 'span': (24, 28), 'lemma': 'קלוש'}, {'id': 9, 'text': 'ולו', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 8, 'deprel': 'flat', 'dspan': (642, 645), 'span': (29, 32), 'lemma': 'ולו'}, 