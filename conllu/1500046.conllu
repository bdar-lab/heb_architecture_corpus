# file = txt/1500046.txt
# filelineno = 126
# sentno = 12
# text = מדבריו אלו של ויץ ניתן להסיק, כי מערכת התכנון הממסדית ראתה עצמה כבעלת מאפיינים דומים למדינות החזקות, על-ידי כך שהתבססה על-אותם מודלים וגישות תכנון, ועל-כן הסברה הייתה, כי התכנון האזורי בישראל יצליח גם ברמה המקומית ואף יוביל לפיתוח הראוי כפי שהוגדר ברמה הלאומית.
