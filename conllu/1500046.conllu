# file = txt/1500046.txt
# filelineno = 323
# sentno = 1
# text = הקמתם של מאות יישובים חקלאיים לאחר קום המדינה והעלייה בפריון הייצור של המשק הבודד כתוצאה משיפורים טכנולוגיים וארגוניים, ושיפור אמצעי התחבורה והביטחון, גרמו לכך שבאמצע שנות החמישים נוצר עודף היצע במוצריו של המשק המעורב ואי-אפשר היה לפתח משקים נוספים באותה מתכונת של ענפים (אפלבאום ומרגוליס, 1985 ; ויץ, 1968b; מעוז, פלאי ולוינגר, 1980).
