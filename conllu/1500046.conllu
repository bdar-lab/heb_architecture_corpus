# text = גם השינויים הארגוניים והכלכליים שהעולים היו צריכים להסתגל אליהם נחקרו, מנקודת מבט שהדגישה את ההיבט התרבותי (ראו: ויינגרוד, 1972 ; מינקוביץ, 1967), על-אף שמטרתם היתה בעיקר למצוא פתרונות תכנוניים לבעיות חברתיות, תעסוקתיות וארגוניות במושבי העולים (ראו למשל: גורן, 1967; הסוכנות היהודית, 1974).
# raw = {'id': 7, 'text': 'גם השינויים הארגוניים והכלכליים שהעולים היו צריכים להסתגל אליהם נחקרו, מנקודת מבט שהדגישה את ההיבט התרבותי (ראו: ויינגרוד, 1972 ; מינקוביץ, 1967), על-אף שמטרתם היתה בעיקר למצוא פתרונות תכנוניים לבעיות חברתיות, תעסוקתיות וארגוניות במושבי העולים (ראו למשל: גורן, 1967; הסוכנות היהודית, 1974).', 'dspan': (755, 1045), 'tokens': [{'id': 1, 'text': 'גם', 'upos': 'ADV', 'xpos': 'ADV', 'head': 3, 'deprel': 'advmod', 'dspan': (755, 757), 'span': (0, 2), 'lemma': 'גם'}, {'id': (2, 3), 'text': 'השינויים', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'שינויים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 17, 'deprel': 'nsubj', 'lemma': 'שינוי'}], 'span': (3, 11), 'dspan': (758, 766)}, {'id': (4, 5), 'text': 'הארגוניים', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'ארגוניים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 3, 'deprel': 'amod', 'lemma': 'ארגוני'}], 'span': (12, 21), 'dspan': (767, 776)}, {'id': (6, 8), 'text': 'והכלכליים', 'expanded': [{'id': 6, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 8, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'כלכליים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'conj', 'lemma': 'כלכלי'}], 'span': (22, 31), 'dspan': (777, 786)}, {'id': (9, 11), 'text': 'שהעולים', 'expanded': [{'id': 9, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 13, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 11, 'deprel': 'det', 'lemma': 'ה'}, {'id': 11, 'text': 'עולים', 'upos': 'NOUN', 'xpos': 'NOUN'