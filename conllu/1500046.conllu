# file = txt/1500046.txt
# filelineno = 506
# sentno = 3
# text = יחד עם זאת, על סמך המצב במושב גדיש, סביר להניח שמצב שהיה מאפשר ליותר מבן אחד להישאר במושב, היה מחזק את המבנה החמולתי בתקופה שבין שלהי שנות השישים והשבעים, וככל הנראה השפעתו היתה מתבטאת מהבחינה החמולתית גם אצל בני הדור השלישי.
