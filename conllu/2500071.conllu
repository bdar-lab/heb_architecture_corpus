# file = txt/2500071.txt
# filelineno = 281
# sentno = 2
# text = מסקנה ראשונית מכך היא שכדאי לנסות ולגבש צוותי עבודה קבועים ולאפשר להם לעבור כקבוצה שלמה, ולא כבודדים, מאתר אחד למשנהו (המשימה אינה פשוטה לביצוע, כי היא מחייבת תיזמוך של הפרויקטים לפי מצאי כוח האדם של החברה, שאינו עולה בקנה אחד עם התנודות הגדולות בפעילות, המאפיינות את ענף הבנייה).
