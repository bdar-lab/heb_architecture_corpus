# file = txt/2500071.txt
# filelineno = 494
# sentno = 1
# text = ממצא זה מחייב סטייה מן (ואת״ל - התאמה של) המתכונת הרגילה של חוגי-איכות בתעשייה ובשירותים, כיוון שהתכניות הרגילות של חוגי איכות מכוונות, בעיקר, אל האוכלוסיה הרחבה של עובדי הקו-הראשון, אשר אמורים לשבת קבוצות-קבוצות - כל קבוצה עם האחראי הישיר שלה -ולדון בבעיות שהן ברמה הבסיסית של הקבוצה.
