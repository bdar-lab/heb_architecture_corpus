# text = לכשתתמסד מערכת חוגי האיכות בחברה שבה יבוצעו הניסויים הנרחבים הנ״ל, ולאחר שנה - שנתיים של הפעלה מלאה, יהיה אפשר להתחיל להסיק מסקנות מבוססות כוללניות לטווח ארוך, וגם הן תסבולנה עדיין מחולשות שונות, כמו: המאפיינים הספציפיים האחידים של הנהלת החברה,, שהשפעתה לא בודדה, חלקם של מפעילי הניסוי - מתאמים, ומרכזים בהצלחתו, ועד כמה החברה הספציפית שבה ייערך הניסוי מייצגת את ענף הבנייה בכללותו; כך,שגם לאחר ביצוע המחקרים המוצעים יהיה עוד כר נרחב להמשך מחקר.
# raw = {'id': 1, 'text': 'לכשתתמסד מערכת חוגי האיכות בחברה שבה יבוצעו הניסויים הנרחבים הנ״ל, ולאחר שנה - שנתיים של הפעלה מלאה, יהיה אפשר להתחיל להסיק מסקנות מבוססות כוללניות לטווח ארוך, וגם הן תסבולנה עדיין מחולשות שונות, כמו: המאפיינים הספציפיים האחידים של הנהלת החברה,, שהשפעתה לא בודדה, חלקם של מפעילי הניסוי - מתאמים, ומרכזים בהצלחתו, ועד כמה החברה הספציפית שבה ייערך הניסוי מייצגת את ענף הבנייה בכללותו; כך,שגם לאחר ביצוע המחקרים המוצעים יהיה עוד כר נרחב להמשך מחקר.', 'dspan': (0, 445), 'tokens': [{'id': (1, 2), 'text': 'לכשתתמסד', 'expanded': [{'id': 1, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ל'}, {'id': 2, 'text': 'כשתתמסד', 'upos': 'VERB', 'xpos': 'VERB', 'head': 28, 'deprel': 'obl', 'lemma': 'כשתתמסד'}], 'span': (0, 8), 'dspan': (0, 8)}, {'id': 3, 'text': 'מערכת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'nsubj', 'dspan': (9, 14), 'span': (9, 14), 'lemma': 'מערכת'}, {'id': 4, 'text': 'חוגי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 3, 'deprel': 'compound:smixut', 'dspan': (15, 19), 'span': (15, 19), 'lemma': 'חוג'}, {'id': (5, 6), 'text': 'האיכות', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'איכות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'compound:smixut', 'lemma': 'איכות'}], 'span': (20, 26), 'dspan': (20, 26)}, {'id': (7, 8), 'text': 'בחברה', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 8, 'text': 'חברה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'nmod', 'lemma': 'חברה'}], 'span': (27, 32), 'dspan': (27, 32)}, {'id': (9, 11), 'text': 'שבה', 'expanded': [{'id': 9, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 12, 'deprel': 'mark',