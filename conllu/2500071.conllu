# raw = {'id': 1, 'text': 'האיכות ביפו, הגדירם באחד מהפרסומים הראשונים על הנושא (1967) כדלהלן: ״חוג לבקרת איכות (Quality Control Circle) הינו קבוצה קטנה של עובדי קו מאותה מחלקה, שהתנדבו להקדיש זמן, מעבר לזמני העבודה הרגילים שלהם, כדי לפתור בעיות איכות של מחלקתם".', 'dspan': (0, 236), 'tokens': [{'id': (1, 2), 'text': 'האיכות', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'איכות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'nsubj', 'lemma': 'איכות'}], 'span': (0, 6), 'dspan': (0, 6)}, {'id': (3, 4), 'text': 'ביפו', 'expanded': [{'id': 3, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ב'}, {'id': 4, 'text': 'יפו', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 2, 'deprel': 'nmod', 'lemma': 'יפו'}], 'span': (7, 11), 'dspan': (7, 11)}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (11, 12), 'span': (11, 12), 'lemma': ','}, {'id': 6, 'text': 'הגדירם', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HIFIL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (13, 19), 'span': (13, 19), 'lemma': 'הגדירם'}, {'id': (7, 8), 'text': 'באחד', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 8, 'text': 'אחד', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'obl', 'lemma': 'אחת'}], 'span': (20, 24), 'dspan': (20, 24)}, {'id': (9, 11), 'text': 'מהפרסומים', 'expanded': [{'id': 9, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'lemma': 'מ'}, {'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 11, 'deprel': 'det', 'lemma': 'ה'}, {'id': 11, 'text': 'פרסומים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur'