# file = txt/2500071.txt
# filelineno = 259
# sentno = 1
# text = אחת ההתלבטויות העיקריות ביחס למספר הרמות האופטימלי על גבי סקלת התשובות בראיונות (בחלקים א‘ ו-ב‘ של השאלון), קיבלה מענה ענייני ממחקרם של (1975) Lissitz and Green שמצאו - ע״י שימוש בשיטת מונטה-קרלו - עלייה ניכרת במהימנות של התשובות עם עליית מספר הרמות בסקלת התשובות מ-2^או 3 ל-5, ובו-בזמן - מצאו שיפור מזערי בלבד במהימנות התשובות עם הגדלת מספר הרמות בסקלת התשובות מעבר ל-5.
