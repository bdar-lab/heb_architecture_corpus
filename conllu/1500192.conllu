# sentno = 2
# text = פרסומיו במהלך שהותו ביפן, ביניהם אמנויות יפניות בעיניים מערביות שפרסם ביפנית (1936) ועקרונות הארכיטקטורה היפנית (Fundamentals of Japanese Architecture) בגרמנית ואנגלית (1936), לא רק ביטאו את הערכתו לפשטות ולאסתטיקה הפונקציונלית של האמנות היפנית, אלא גם הציגו סינתזה בין התרבות ההיסטורית שנשמרה שנים מבודדת מהעולם לבין ההשפעה הזרה שנכנסה מסוף המאה ה-125.19 טאוט ראה את האלמנטים הבנויים של מבנה העץ הנקי, הצבעים העדינים של כיסוי הנייר ודלתות הנייר דרכן עובר האור ברכות- כנמצאים בהרמוניה עם החלל שלהם, בשל התכליתיות שמאפיינת אותם (1937 ,Taut) (איור 93).
# raw = {'id': 2, 'text': 'פרסומיו במהלך שהותו ביפן, ביניהם אמנויות יפניות בעיניים מערביות שפרסם ביפנית (1936) ועקרונות הארכיטקטורה היפנית (Fundamentals of Japanese Architecture) בגרמנית ואנגלית (1936), לא רק ביטאו את הערכתו לפשטות ולאסתטיקה הפונקציונלית של האמנות היפנית, אלא גם הציגו סינתזה בין התרבות ההיסטורית שנשמרה שנים מבודדת מהעולם לבין ההשפעה הזרה שנכנסה מסוף המאה ה-125.19 טאוט ראה את האלמנטים הבנויים של מבנה העץ הנקי, הצבעים העדינים של כיסוי הנייר ודלתות הנייר דרכן עובר האור ברכות- כנמצאים בהרמוניה עם החלל שלהם, בשל התכליתיות שמאפיינת אותם (1937 ,Taut) (איור 93).', 'dspan': (211, 761), 'tokens': [{'id': (1, 2), 'text': 'פרסומיו', 'expanded': [{'id': 1, 'text': 'פרסומי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 46, 'deprel': 'nsubj', 'lemma': 'פרסומי'}, {'id': 2, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 1, 'deprel': 'nmod:poss', 'lemma': 'ו'}], 'span': (0, 7), 'dspan': (211, 218)}, {'id': (3, 4), 'text': 'במהלך', 'expanded': [{'id': 3, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ב'}, {'id': 4, 'text': 'מהלך', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'nmod', 'lemma': 'מהלך'}], 'span': (8, 13), 'dspan': (219, 224)}, {'id': (5, 6), 'text': 'שהותו', 'expanded': [{'id': 5, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 6, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 6, 'text': 'הותו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HIFIL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 1, 'deprel': 'acl:relcl', 'lemma': 'הותו'}], 'span': (14, 19), 'dspan': (225, 230)}, {'id': (7, 8), 'text': 'ביפן', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 8, 'text': 'יפן', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 6, 'deprel': 'obl', 'lemma': 'יפן'}], 'span': (20, 24), 'dspan': (231, 235)}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos':