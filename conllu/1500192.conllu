# file = txt/1500192.txt
# filelineno = 452
# sentno = 2
# text = מכיוון שראה את הבית האידיאלי כאורגניזם המתאים עצמו לאיכויות האישה, התייחסותו אל הבית היא כהארכה של בגד המתגורר, והחוקרת גיוליאנה ברונו (Giuliana Bruno) רואה הארכה אופנתית זו כשפה קולנועית, אשר מציידת את הבית בדימויים נעים.
