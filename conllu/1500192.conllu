# file = txt/1500192.txt
# filelineno = 59
# sentno = 2
# text = יחד עם זאת, אדולף בן (Adolf Behne), התיאורטיקן וההיסטוריון הגרמני שפעל בתקופת הרפובליקה הווימרית, לא כתב על אף אחד אחר בתדירות ובהתלהבות כמו על ברונו טאוט, כפי שמציין ההיסטוריון הגרמני ווינפריד נרדינגר (Winfried Nerdinger).
