# text = מכיוון שהגופים המרחביים האפולונ״ם לא רק משקפים את החיים הדיוניס״ם המתקיימים בתוכם- כמגוון אקספרסיבי חברתי-אנוש׳, אלא הם גם בעלי פוטנציאל תנועתי בזכות עצמם, מתקיימת בין הגופים המרחביים והחיים הדדיות, וזו מתבססת על חוויה גופנית- של הגופים האפולונ״ם ושל החיים הדיוניס״ם.
# raw = {'id': 6, 'text': 'מכיוון שהגופים המרחביים האפולונ״ם לא רק משקפים את החיים הדיוניס״ם המתקיימים בתוכם- כמגוון אקספרסיבי חברתי-אנוש׳, אלא הם גם בעלי פוטנציאל תנועתי בזכות עצמם, מתקיימת בין הגופים המרחביים והחיים הדדיות, וזו מתבססת על חוויה גופנית- של הגופים האפולונ״ם ושל החיים הדיוניס״ם.', 'dspan': (774, 1041), 'tokens': [{'id': 1, 'text': 'מכיוון', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 11, 'deprel': 'mark', 'dspan': (774, 780), 'span': (0, 6), 'lemma': 'מכיוון'}, {'id': (2, 4), 'text': 'שהגופים', 'expanded': [{'id': 2, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 1, 'deprel': 'fixed', 'lemma': 'ש'}, {'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'גופים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 11, 'deprel': 'nsubj', 'lemma': 'גוף'}], 'span': (7, 14), 'dspan': (781, 788)}, {'id': (5, 6), 'text': 'המרחביים', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'מרחביים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'amod', 'lemma': 'מרחביים'}], 'span': (15, 23), 'dspan': (789, 797)}, {'id': (7, 8), 'text': 'האפולונ״ם', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'אפולונחם', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'amod', 'lemma': 'אפולונחם'}], 'span': (24, 33), 'dspan': (798, 807)}, {'id': 9, 'text': 'לא', 'upos': 'ADV', 'xpos': 'ADV', 'feats': 'Polarity=Neg', 'head': 10, 'deprel': 'advmod', 'dspan': (808, 810), 'span': (34, 36), 'lemma': 'לא'}, {'id': 10, 'text': 'רק', 'upos': 'ADV', 'xpos': 'ADV', 'head': 11, 'deprel': 'advmod', 'dspan': (811, 813), 'span': (37, 39), 'lemma': 'רק'}, {'id': 1