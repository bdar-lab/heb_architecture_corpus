# text = כשם שלאבאן ראה את האנרגיה התנועתית מוקרנת מהמרכז לעבר פינות הטטרהדרון- הנוצר על ידי חיבור דמיוני של נקודות הקצה של האיברים ( ,Maletic 1987) (איור 38), כך גם טאוט תיאר את גדילת הערים "החוצה לעבר קירות העיר שהיו ממוקמים במקור רחוק מאוד מהמרכז".
# raw = {'id': 6, 'text': 'כשם שלאבאן ראה את האנרגיה התנועתית מוקרנת מהמרכז לעבר פינות הטטרהדרון- הנוצר על ידי חיבור דמיוני של נקודות הקצה של האיברים ( ,Maletic 1987) (איור 38), כך גם טאוט תיאר את גדילת הערים "החוצה לעבר קירות העיר שהיו ממוקמים במקור רחוק מאוד מהמרכז".', 'dspan': (606, 848), 'tokens': [{'id': 1, 'text': 'כשם', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 3, 'deprel': 'mark', 'dspan': (606, 609), 'span': (0, 3), 'lemma': 'כשם'}, {'id': 2, 'text': 'שלאבאן', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'nsubj', 'dspan': (610, 616), 'span': (4, 10), 'lemma': 'שלאבאן'}, {'id': 3, 'text': 'ראה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 44, 'deprel': 'advcl', 'dspan': (617, 620), 'span': (11, 14), 'lemma': 'ראה'}, {'id': 4, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 6, 'deprel': 'case', 'dspan': (621, 623), 'span': (15, 17), 'lemma': 'את'}, {'id': (5, 6), 'text': 'האנרגיה', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'אנרגיה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'obj', 'lemma': 'אנרגיה'}], 'span': (18, 25), 'dspan': (624, 631)}, {'id': (7, 8), 'text': 'התנועתית', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'תנועתית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'amod', 'lemma': 'תנועתית'}], 'span': (26, 34), 'dspan': (632, 640)}, {'id': 9, 'text': 'מוקרנת', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PUAL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Pass', 'head': 6, 'deprel': 'amod', 'dspan': (641, 647), 'span': (35, 41), 'lemma': 'מוקרנת'}, {'id': (10, 12), 'text': 'מהמרכז', 'expanded'