# file = txt/1500192.txt
# filelineno = 176
# sentno = 1
# text = מרבית רעיונותיו של לאבאן לגבי 'מחול ההבעה' לא רק הפכו למאפייני הזרם, אלא גם שימשו כנקודות המוצא לתיאוריות התנועה אותן פיתח לאורך כל ח״ו, ולמעשה אלו היו הגדרה תיאורטית לימחול ההבעה', בין הרעיונות החשובים של 'מחול ההבעה' היו השאיפה להבנת מערכות היחסים בין הגוף והנפש ובין היחיד לקוסמוס, מתוך הנחה שהאינדיבידואל השואף להכרה עצמית, ככל שיהיה מפותח יותר- כך נוכחותו במסגרת הקבוצה תהיה משמעותית יותר.
