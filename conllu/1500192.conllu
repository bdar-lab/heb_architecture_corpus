# file = txt/1500192.txt
# filelineno = 189
# sentno = 1
# text = טאוט שימש כאדריכל העיר מגדבורג בשנים 1921-1924, עבורה פיתח את התכנית הכללית למגורים, כולל סכמות הצבע האדריכליות הנועזות43, וכאדריכל האגודה לבנייה GEHAG בברלין בשנים 1924-1932, עבורה תכנן יותר מ-10,000 דירות, תוך עבודה קרובה עם האדריכל ומתכנן הערים הגרמני מרטין וגנר ( Martin Wagner), עמו שיתף פעולה במספר פרויקטים.
