# file = txt/1500192.txt
# filelineno = 204
# sentno = 1
# text = אדולף בן, אשר טבע את המונח 'ארכיטקטורה אקספרסיוניסטית' בביקורת שכתב על טאוט, תיאר במאמרו 'לידתה מחדש של הארכיטקטורה' את משמעות המונח 'עבודת אמנות טוטלית' (Gesamtkunstwerk): "על אף כל האי הבנות, 'עבודת האמנות הטוטלית' היא המטרה- בהחלט לא מכילה חלקים מקובצים שלא עולים אף פעם מעל הסכום של החלקים, אלא ['עבודת אמנות טוטלית'] אשר, לא משנה אילו או בכמה אמצעים היא משתמשת, עדיין גורמת לכל החרוזים לרטוט, כ׳ היא ברמה גבוהה, שם הכל עדיין אחדות מרוכזת.
