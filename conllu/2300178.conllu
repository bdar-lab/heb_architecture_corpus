# file = txt/2300178.txt
# filelineno = 94
# sentno = 2
# text = ההשערות נבדקו ביחס לשלוש קבוצות: קבוצת ניסוי - כל שכונות הפרוייקט בערים מטרופוליטניות ובינוניות; קבוצת ביקורת -איזורים סטטיסטיים בעלי סטטוס חברתי כלכלי נמוך שלא נכללו בתהליך השיקום; ישובי המצוקה - עיירות שלמות, אשר נכללו במלואן בפרוייקט השיקום, שהוגדרו לצורך המחקר כקבוצה נפרדת.
