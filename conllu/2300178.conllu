# file = txt/2300178.txt
# filelineno = 64
# sentno = 3
# text = עד סוף דצמבר 1991 ־ כ- 76,000 מהדירות שבאזורי השיקום הפיסי שופצו חיצונית (איטום גגות, צביעת חזיתות, תיקונים בחדרי המדרגות, פיתוח גינות וכו׳), כמחציתן ע״י חברות הניהול הציבוריות ומחצית! בשיטת "עשה זאת בעצמך"; שיפוצים פנימיים נערכו בכ- 2,300ו דירות, מרביתן של שוכרים (בניגוד לבעלים), ועוד 3,200 בבתי קשישים; כ־ 25,000 דירות הורחבו (מתוכן כ- 1,000 איחורי דירות), כמעט כולן ע״י דייריהן-בעליהן.
