# sentno = 1
# text = נראה כי כמו כל תורה חברתית כלכלית המאומצת באיחור מה במדינת ישראל לעומת מדינות המערב, ניתן לראות אנלוגיה ישירה (ולראיה, בזמן כתיבת שורות אלו מתמודדות לבחירות 2009 בישראל שתי מפלגות "ירוקות" המציגות אג'נדה חברתית ירוקה מובהקת בדומה למפלגות הירוקות המסורתיות באירופה).
