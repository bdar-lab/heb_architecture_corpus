# text = בהקשר הנוכחי, זוהו שלוש פרספקטיבות תיאורטיות להבנת הקשר סביבה-התנהגות בכלל וסביבה בנויה-פעילות גופנית בפרט, כדלהלן: (1) הפרספקטיבה הדטרמיניסטית-סביבתית, לפיה הסביבה הממשית משפיעה באופן ישיר על התנהגות; (2) הפרספקטיבה הסביבתית-קוגניטיבית, לפיה האופן שבו אדם תופס את הסביבה (להלן: סביבה נתפסת) משפיע באופן ישיר על התנהגות; ו-(3) הפרספקטיבה הסוציו-אקולוגית לפיה הסביבה הממשית והסביבה הנתפסת משפיעות על התנהגות לצד גורמים אחרים.
# raw = {'id': 6, 'text': 'בהקשר הנוכחי, זוהו שלוש פרספקטיבות תיאורטיות להבנת הקשר סביבה-התנהגות בכלל וסביבה בנויה-פעילות גופנית בפרט, כדלהלן: (1) הפרספקטיבה הדטרמיניסטית-סביבתית, לפיה הסביבה הממשית משפיעה באופן ישיר על התנהגות; (2) הפרספקטיבה הסביבתית-קוגניטיבית, לפיה האופן שבו אדם תופס את הסביבה (להלן: סביבה נתפסת) משפיע באופן ישיר על התנהגות; ו-(3) הפרספקטיבה הסוציו-אקולוגית לפיה הסביבה הממשית והסביבה הנתפסת משפיעות על התנהגות לצד גורמים אחרים.', 'dspan': (539, 963), 'tokens': [{'id': (1, 2), 'text': 'בהקשר', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Definite=Def|PronType=Art', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'הקשר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'obl', 'lemma': 'הקשר'}], 'span': (0, 5), 'dspan': (539, 544)}, {'id': (3, 4), 'text': 'הנוכחי', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'נוכחי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'amod', 'lemma': 'נוכחי'}], 'span': (6, 12), 'dspan': (545, 551)}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (551, 552), 'span': (12, 13), 'lemma': ','}, {'id': 6, 'text': 'זוהו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PAAL|Number=Plur|Person=3|Tense=Pres|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (553, 557), 'span': (14, 18), 'lemma': 'זוהו'}, {'id': 7, 'text': 'שלוש', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Gender=Fem|NumType=Card', 'head': 8, 'deprel': 'nummod', 'dspan': (558, 562), 'span': (19, 23), 'lemma': 'שלוש'}, {'id': 8, 'text': 'פרספקטיבות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 6, 'deprel': 'nsubj:pass', 'dspan': (563, 573), 'span': (24, 34), 'lemma': 'פרספקטיבות'}, {'id': 9, 'text': 'תיאורטיות', 'upos':