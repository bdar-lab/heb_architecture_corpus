# file = txt/1300006.txt
# filelineno = 366
# sentno = 1
# text = לפי הפרספקטיבה הסביבתית-קוגניטיבית, הבחירה ללכת ו/או לרכב על אופניים יכולה להיות מושפעת מתפיסת המרחק בשני כיוונים: כשמדובר בתחבורה פעילה, סביר להניח שתפיסת מרחק כקצר תשפיע באופן חיובי, ואילו כשמדובר בפנאי פעיל, סביר להניח שהאדם דווקא ישאף ללכת או לרכב על אופניים לזמן ממושך, ואז תפיסת מרחק כקצר תשפיע באופן שלילי.
