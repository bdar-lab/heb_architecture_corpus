# file = txt/1300006.txt
# filelineno = 15
# sentno = 1
# text = בחירת שכונות למחקר: המחקר כולל בחירה שיטתית של שבע שכונות בעיר ראשון לציון בעלות מאפיינים פיסיים שונים: מחד, שכונות בסגנון עירוני, הכוללות צפיפות מגורים גבוהה, עירוב שימושי קרקע ודגם רחובות שתי-וערב (ארבע שכונות: רמב"ם, כצנלסון, אברמוביץ', ורמז), ומאידך שכונות בסגנון פרברי, הכוללות צפיפות מגורים נמוכה, הפרדת שימושי קרקע ורחובות מפותלים וללא מוצא (שלוש שכונות: נאות שקמה, נאות אשלים וקריית חתני פרס נובל).
