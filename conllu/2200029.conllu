# file = txt/2200029.txt
# filelineno = 260
# sentno = 6
# text = יש להבהיר כי אם מבצעים במודל כל שהוא של בניין ניסוים בהם יש ערכים שתים לפרמטרים המודליים התלויים בבעיה אך ערכם של הפרמטרים הלא מימדיים הבלתי תלויים במשוואה זהה (4.1) באותם ניסויים, ניתן להתייחס לכל אחד מן הניסויים הנ״ל כמודל נפרד בקנה מידה שתה לזמנים, מהירויות וטמפרטורות, אם כי קנה המידה הגיאומטרי במודלים אלו זהה.
