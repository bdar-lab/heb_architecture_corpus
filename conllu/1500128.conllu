# file = txt/1500128.txt
# filelineno = 18
# sentno = 1
# text = לצורך בחינת אדריכלות ברקאי בשנות ה- 30 וכווני התפתחותה במכלול יצירתו, סוקר המחקר בקצרה פרויקטים של ברקאי בין השנים 1973-1947, ועומד על התרחקות התכנון מהתמצית הפוריסטית של אדריכלות לה קורבוזיה, לכוון תכנון אקלקטי, מפוזר, חסר עקביות, המאפיין את אדריכלות ברקאי בשלהי הקריירה המקצועית שלו.
