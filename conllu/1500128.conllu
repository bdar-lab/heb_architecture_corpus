# file = txt/1500128.txt
# filelineno = 1367
# sentno = 1
# text = והרצוף עשוי להתחמם מלהט השמש ביום, וחום זה יהי מוחזר לסביבה-לצד הרחוב ולצד הבית-בשעות הלילה׳ והיושב על הגזוזטרה עם שקיעת החמה, כדי לשאוף קצת רוח, הריהו כאילו נתון באמבט של קיטור, וכי לשם כך צריך האדריכל להיות מלומד גדול בפיסיקה’ הרי לשם כך יטפיקו ראשי פרקים בפיסיקה- ואת אלו הרי ודאי למדו האדריכלים! להיכן אפוא נעלמו ידיעות אלמנטאריות אלו כשהתירו גזוזטראות כאלו! כדומה, שאין כאן גם שאלת קמוצים, או שמא הכריע הצד הסגנוני! שלמות הסגנון ובריאות האוכלוסין-מה עדיף! והאדריכלים שלנו הודו, ששלמות הסגנון עיקר ובריאות האדם טפלי....
