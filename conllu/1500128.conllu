# file = txt/1500128.txt
# filelineno = 1455
# sentno = 1
# text = תכנון השכונה ומכירת המגרשים הופקדו בידי הסוכנות להשקעות ופיתוח,6 חברה בבעלות פרידריק הרמן קיש7 (1943-1888), קולונל בצבא הוד מלכותו, המשמש עם עלייתו ארצה, כמנהל המחלקה המדינית בהנהלה הציונית בירושלים בין השנים 1931-1923, ולאחר פרישתו עובר לעסקים פרטיים.
