# file = txt/1500128.txt
# filelineno = 1450
# sentno = 2
# text = 1 ראשיתה של השכונה בשנת 1932, כאשר יוזם איש המעש הציוני יצחק לייב גולדברג,2 הקמת "קריית סופרים ואומנים" על שם בנו בנימין זאב, שנרצח במאורעות הדמים בשנת תרפ״ט (25 באוגוסט 1929) בשעה שניסה לחלץ שני פועלים יהודים, שכותרו על ידי פורעים ערביים בבית החרושת לספירט של פולר בקרבת הכפר אבו כביר.
