# file = txt/1500128.txt
# filelineno = 1618
# sentno = 1
# text = ־ חלל כפול באטלייה של לובין - לראשונה מאמץ ברקאי את פתרון החלל הכפול כפי שגובש לראשונה באטלייה בפריז (1922) של שותפו לדרך של לה קורבוזיה בפריז, הצייר 70,Ozenfant ולאחר מכן באטלייה באנטוורפן (1926) של הצייר 71.
