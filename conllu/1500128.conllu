# file = txt/1500128.txt
# filelineno = 3
# sentno = 1
# text = מחקר זה בוחן תחילה, את כור ההיתוך של ברקאי עם עלייתו ארצה בשנת 1920, המוביל אותו לעיסוק בבניה אקלקטית, בהשפעת אדריכלות ברוולד ומינור, ומטמיע בעבודתו תפיסות תכנון שחוזרות ועולות באדריכלות של ברקאי בתקופות ביניים בקריירה המקצועית שלו, והמוביל אותו ומתכננים צעירים נוספים, בסיומה של תקופה, למבוי סתום כלכלי ומקצועי, המחייב את ברקאי להגר מהארץ, וללמוד את תחום עיסוקו בראייה מחודשת.
