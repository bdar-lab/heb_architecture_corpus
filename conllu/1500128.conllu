# file = txt/1500128.txt
# filelineno = 41
# sentno = 1
# text = ־ תקופת שנות השישים ותחילת שנות השבעים - תקופה של מספר פרויקטים ציבוריים בהשפעת אדריכלות לה קורבוזיה כפי שהתפתחה בשנות השלושים המוקדמות ובהשפעת הסגנון הברוטליסטי הישראלי של שנות השישים (שגם בו ניכרות טביעות האצבע של לה קרובוזיה) מבנים מייצגים הינם: יד אבנר (1960־1973) בשכונת אפקה, תל-אביב.
