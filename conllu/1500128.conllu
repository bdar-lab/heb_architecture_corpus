# text = 3 שרון דוחה הצעתו המעניינת של Hannes Meyer לעבוד עמו ברוסיה הסובייטית, ואת קריאתו של (1899־1986) Mart Stam לעזרה בתכנון עיר התעשייה Magnitogorsk, ומטמיע רעיונותיו הסוציאליסטיים־קומוניסטיים של Hannes Meyer אל תוך פרויקטי מעונות עובדים של תנועת העבודה בארץ ישראל.
# raw = {'id': 3, 'text': '3 שרון דוחה הצעתו המעניינת של Hannes Meyer לעבוד עמו ברוסיה הסובייטית, ואת קריאתו של (1899־1986) Mart Stam לעזרה בתכנון עיר התעשייה Magnitogorsk, ומטמיע רעיונותיו הסוציאליסטיים־קומוניסטיים של Hannes Meyer אל תוך פרויקטי מעונות עובדים של תנועת העבודה בארץ ישראל.', 'dspan': (352, 613), 'tokens': [{'id': 1, 'text': '3', 'upos': 'NUM', 'xpos': 'NUM', 'head': 2, 'deprel': 'nummod', 'dspan': (352, 353), 'span': (0, 1), 'lemma': '3'}, {'id': 2, 'text': 'שרון', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'nsubj', 'dspan': (354, 358), 'span': (2, 6), 'lemma': 'שרון'}, {'id': 3, 'text': 'דוחה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (359, 363), 'span': (7, 11), 'lemma': 'דחה'}, {'id': (4, 6), 'text': 'הצעתו', 'expanded': [{'id': 4, 'text': 'הצעה_', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Def|Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'obj', 'lemma': 'הצעה'}, {'id': 5, 'text': '_של_', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case:gen', 'lemma': 'של'}, {'id': 6, 'text': '_הוא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Gender=Masc|Number=Sing|Person=3|PronType=Prs', 'head': 4, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (12, 17), 'dspan': (364, 369)}, {'id': (7, 8), 'text': 'המעניינת', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'מעניינת', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'amod', 'lemma': 'מעניין'}], 'span': (18, 26), 'dspan': (370, 378)}, {'id': 9, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 10, 'deprel': 'case:gen', 'dspan': (379, 381), 'span': (27, 29), 'lemma': 'של'}, {'id': 10, 'text': 'Hannes', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 4, 'deprel': 'nmod:poss', 'dspan': (382, 388), 'span': (30