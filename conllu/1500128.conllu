# file = txt/1500128.txt
# filelineno = 337
# sentno = 1
# text = נעצור כאן בתיאורו של (1987) 2,Andre Wogenscky יש בו אמנם הרבה מן הפאתוס השמנוני משהו, אך תיאור זה משמר מקצת מההילה שעטפה את לה קורבוזיה באותם השנים, ונבנתה בעמל רב ובמודע על ידי לה קורבוזיה עצמו,3 ...באמצעות מסעות לימוד ברחבי אירופה ופרסומם בספרי מסע ויומנים,4 בחירה מושכלת של מקומות לימוד ועבודה בבירות אירופה השונות,5 בחירה מכוונת של מקום המגורים ומקום הקמת האטלייה בפריז ,6 היכרות עם אנשי מפתח של הקהילייה הארכיטקטונית הבינלאומית באותה תקופה, 7 פרסום כתב עת משלו ,8 אשר דרכו קשר לה קורבוזיה קשרים עם רוב תנועות האוונגרד באירופה, וקשרים עם אדריכלים ואמנים,ףקשרים עם בעלי ממון וכוח שהפכו בהמשך ללקוחותיו,10 השתתפות באירועים בינלאומיים כגון תערוכות, התחרויות, כנסים אדריכליים.
