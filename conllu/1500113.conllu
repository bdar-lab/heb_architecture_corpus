# file = txt/1500113.txt
# filelineno = 5
# sentno = 3
# text = פתיחות ונועם קורלטיביות בעיקר עם סוגיות הקשורות במאפייני הדירה וסביבתה, אך בעלות קשרים הפוכים -לדוגמא, בעוד פתיחות מתקשרת עם נטייה להעדיף בניה עצמית על-פני רכישת דירה מקבלן והעדפת העיר על-פני הכפר, נועם קשורה בנטייה להעדיף רכישת דירה מקבלן והעדפת סגנון חיים כפרי.
