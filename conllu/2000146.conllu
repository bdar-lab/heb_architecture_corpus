# file = txt/2000146.txt
# filelineno = 93
# sentno = 2
# text = בעבודה זו יקראו הסוכנות היהודית לארץ ישראל (להלן הסוכנות) והקרן הקיימת לישראל (להלן הקק״ל) המוסדות הלאומים ואילו גופים ממשלתיים אחרים העוסקים בתכנון יוזם כגון, משרד הבינוי והשיכון, משרד הפנים יקראו " המוסדות הממלכתיים".
