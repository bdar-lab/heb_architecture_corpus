# file = txt/2000146.txt
# filelineno = 329
# sentno = 1
# text = דוגמא לשינויים אלה מהווה ההסכם התקדימי שנחתם באום אל פחם בינואר 2001 בין משרד הביטחון לבין הוועד הציבורי להגנת אדמות א-רוחה והרשויות המקומיות הערביות בואדי ערה, אשר מסדיר את זכויותיהם של בעלי הקרקע הערביים, שאדמותיהם משמשות גם כשטחי אימונים של יחידות צה״ל ומביא לקצו את סכסוך הקרקעות שעימת בין הגורמים המעורבים (הארץ 1 בינואר 2001).
