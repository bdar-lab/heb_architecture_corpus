# file = txt/2000146.txt
# filelineno = 328
# sentno = 2
# text = הן מציינות 7 אמות מידה לבחינת השינוי במגמות ההתייחסות למגזר הערבי בתכנון אשר בכולן חל שינוי לטובה לכיוון של התייחסות התכנון למגזר הערבי: מהתעלמות ועד אזכור חיובי, מאפליה שלילית ועד "אפליה מתקנת", משליטה לשיתוף הציבור, מבדלנות לשיתוף פעולה, מאויב ועד לקוח, מחסימה ועד לנגישות, מעמימות לשקיפות.
