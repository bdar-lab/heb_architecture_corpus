# file = txt/2000146.txt
# filelineno = 573
# sentno = 4
# text = הטילה הממשלה על מינהל הפיתוח לבצע פעולות הכשרה, פיתוח או ייעור של מקרקעים הרשומים על שם הקרן הקיימת לישראל, והקרן הקיימת לישראל הודיעה לממשלה בכתב, לפני ביצוע הפעולה, שאין ביכולתה לבצעה על חשבונה, תישא המדינה בהוצאות הכרוכות בפעולה כאמור, והוצאות אלה ישולמו לקרן הקיימת לישראל אם במענק , בהלוואה, בחילופי נכסים ואם בדרך אחרת - הכל כפי שהוסכם בין הממשלה ובין הקרן הקיימת לישראל.
