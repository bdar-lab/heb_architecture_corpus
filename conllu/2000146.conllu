# text = ג.	ממשלת ישראל והקרן הקיימת לישראל, גמרו אומר לסלק את הכפילות שנוצרה בניהול אדמותיהם בידי מוסדות שונים, לאחד בידי המדינה את ניהול אדמות אלה, שמירתם והטיפול בהן, ולחזק את ידי הקרן הקיימת לישראל בהגשמת יעודה של גאולת הקרקע מן השממה.
# raw = {'id': 1, 'text': 'ג.\tממשלת ישראל והקרן הקיימת לישראל, גמרו אומר לסלק את הכפילות שנוצרה בניהול אדמותיהם בידי מוסדות שונים, לאחד בידי המדינה את ניהול אדמות אלה, שמירתם והטיפול בהן, ולחזק את ידי הקרן הקיימת לישראל בהגשמת יעודה של גאולת הקרקע מן השממה.', 'dspan': (0, 230), 'tokens': [{'id': 1, 'text': 'ג', 'upos': 'NOUN', 'xpos': 'NOUN', 'head': 12, 'deprel': 'nsubj', 'dspan': (0, 1), 'span': (0, 1), 'lemma': 'ג'}, {'id': 2, 'text': '.', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'feats': 'Abbr=Yes', 'head': 12, 'deprel': 'punct', 'dspan': (1, 2), 'span': (1, 2), 'lemma': '.'}, {'id': 3, 'text': 'ממשלת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 12, 'deprel': 'nsubj', 'dspan': (3, 8), 'span': (3, 8), 'lemma': 'ממשלה'}, {'id': 4, 'text': 'ישראל', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'compound', 'dspan': (9, 14), 'span': (9, 14), 'lemma': 'ישראל'}, {'id': (5, 6), 'text': 'והקרן', 'expanded': [{'id': 5, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 6, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 6, 'text': 'הקרן', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'det', 'lemma': 'הקרן'}], 'span': (15, 20), 'dspan': (15, 20)}, {'id': (7, 8), 'text': 'הקיימת', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'קיימת', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'amod', 'lemma': 'קיים'}], 'span': (21, 27), 'dspan': (21, 27)}, {'id': (9, 10), 'text': 'לישראל', 'expanded': [{'id': 9, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ל'}, {'id': 10, 'text': 'ישראל', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 6, 'deprel': 'nmod', 'lemma': 'ישראל'}], 'span': (28, 34), 'dspan': (28, 34)}, {'id': 11, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 12, 'deprel': 'punct', 'dspan': (34, 35), 'span': (3