# file = txt/2000146.txt
# filelineno = 4
# sentno = 1
# text = העבודה בוחנת את תפקידם של המוסדות הלאומיים במערכת התכנון וזאת על ידי הגדרת תפקידם, בדיקת רשתות העבודה שלהם אל מול מערכות התכנון הממלכתיות בתוך המערכת היוזמת והמוסתת, אפיון הקשרים בין גורמי התכנון השונים ,עמידה על ההתאמה או חוסר ההתאמה של פעילות המוסדות הלאומיים למדיניות ולפעולות המוסדות המתכננים הממלכתיים (גופים ממשלתיים) ובדיקת ההשפעה של פעילות זו על התכנון למגזר הערבי.
