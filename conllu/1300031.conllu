# file = txt/1300031.txt
# filelineno = 316
# sentno = 2
# text = כב׳ השופט י׳ קדמי לא קיבל את עמדת המשיבים בנקודה זו, וסבר כי אמנם ראוי שבקשה למינוי חוקר תוגש מוקדם ככל שניתן, אולם אין בהשהיית הגשת הבקשה כדי לשלול מן השר את הסמכות למנות חוקר כמפורט בסעיף 107(א) לחוק.
