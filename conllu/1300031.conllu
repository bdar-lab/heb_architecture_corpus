# file = txt/1300031.txt
# filelineno = 118
# sentno = 2
# text = הסדרים אלו באים לידי ביטוי בהרכב מוסדות התיכנון הכולל נציגים מקצועיים כחברים בו (ראו טבלה מס* 1), בשיתוף יועצים מקצועיים, בהליכי הוועצות עם גורמים מקצועיים, בהליך הבדיקה התכנונית המוקדמת טרם דיון בתוכנית במוסד התיכנון, בתסקירי השפעה על הסביבה ועוד.
