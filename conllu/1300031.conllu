# file = txt/1300031.txt
# filelineno = 765
# sentno = 2
# text = הסברים סיבתיים ניתנים בדרך כלל לבחינה במחקר ניסויי, אשר קיימת אפשרות במסגרתו לשנות חלק מהנתונים, להפעיל לגביהן מניפולציות שונות, לבחון השפעת שינויים אלה על קבוצת הנתונים הנבדקת ולהפריך בכך הסברים חלופיים ובכך מתאפשרת, באופן דדוקטיבי, להציע במסגרת המחקר הניסויי גם הסבר סיבתי לקשר שזוהה - אך כפי שפורט שם, ומחקר מסוג זה אינו רלוונטי במקרה דנן.
