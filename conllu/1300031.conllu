# text = גם פה, קיים דמיון לתוצאות מחקרן של ורנסקי, אלתרמן וצ׳רצ׳מן (1986), שם 45% מהתוכניות להן הוגשו התנגדויות מצויות בתחומי הערים; 22.5% מהן בישובים החקלאיים; 5% בתחום ה,אחר״, ורק ביחס לתחום ה״עיירה״ קים שוני: 27.5% מהתוכניות (לעומת 16.6% במחקר הנדון).
# raw = {'id': 2, 'text': 'גם פה, קיים דמיון לתוצאות מחקרן של ורנסקי, אלתרמן וצ׳רצ׳מן (1986), שם 45% מהתוכניות להן הוגשו התנגדויות מצויות בתחומי הערים; 22.5% מהן בישובים החקלאיים; 5% בתחום ה,אחר״, ורק ביחס לתחום ה״עיירה״ קים שוני: 27.5% מהתוכניות (לעומת 16.6% במחקר הנדון).', 'dspan': (323, 569), 'tokens': [{'id': 1, 'text': 'גם', 'upos': 'ADV', 'xpos': 'ADV', 'head': 2, 'deprel': 'advmod', 'dspan': (323, 325), 'span': (0, 2), 'lemma': 'גם'}, {'id': 2, 'text': 'פה', 'upos': 'ADV', 'xpos': 'ADV', 'head': 4, 'deprel': 'advmod', 'dspan': (326, 328), 'span': (3, 5), 'lemma': 'פה'}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (328, 329), 'span': (5, 6), 'lemma': ','}, {'id': 4, 'text': 'קיים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (330, 334), 'span': (7, 11), 'lemma': 'קיים'}, {'id': 5, 'text': 'דמיון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'nsubj', 'dspan': (335, 340), 'span': (12, 17), 'lemma': 'דמיון'}, {'id': (6, 7), 'text': 'לתוצאות', 'expanded': [{'id': 6, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'ל'}, {'id': 7, 'text': 'תוצאות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 5, 'deprel': 'nmod', 'lemma': 'תוצאה'}], 'span': (18, 25), 'dspan': (341, 348)}, {'id': 8, 'text': 'מחקרן', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'compound:smixut', 'dspan': (349, 354), 'span': (26, 31), 'lemma': 'מחקרן'}, {'id': 9, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 10, 'deprel': 'case:gen', 'dspan': (355, 357), 'span': (32, 34), 'lemma': 'של'}, {'id': 10, 'text': 'ורנסקי', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 7, 'deprel': 'nmod:poss', 'dspan': (358, 364), 'span': (35, 41), 'lemma': 'ורנסקי'}, {'id': 11, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head