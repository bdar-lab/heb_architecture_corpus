# file = txt/1300031.txt
# filelineno = 181
# sentno = 2
# text = על פי זמיר (1996), קיימים חמישה מרכיבים לחובת השימוע: השימוע צריך להתקיים בפני הרשות המוסמכת; הרשות חייבת לתת הודעה על מהות העניין הנדון על ידה ואשר בגינו קמה זכות הטיעון; הרשות צריכה להקצות די זמן לצורך הכנת הטיעון; חובת הרשות לאפשר לטוען, או לבא-כוחו, להציג בפניה הן את טענותיו והן את ראיותיו; ובמקרים מסויימים, עליה להתיר גם חקירת עדים; לאלה ניתן להוסיף גם את החובה לספק מידע על מהות העניין הנדון, והחובה של הרשות המינהלית לנמק החלטותיה.
