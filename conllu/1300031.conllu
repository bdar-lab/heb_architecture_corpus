# file = txt/1300031.txt
# filelineno = 769
# sentno = 2
# text = כך ניתן לבחון השערות שונות, דוגמת הקשר בין תוכניות אשר עוסקות בחלוקה של "עוגת זכויות" לטענות דוגמת אי-שוויון, קיפוח ואפלייה; הקשר בין תיכנון נקודתי, המציע פתרון אד-הוק שלא על בסיס מדיניות תכנונית כוללת לטענות סביבתיות, חברתיות ומשפטיות הנוגעות לתיכנון נקודתי; הקשר בין תוכניות המאפשרות גמישות ביחס לפיתרון שימומש לטענות הנוגעות לאי-וודאות, עיכוב מימוש; הפעלת שיקולים זרים, תיכנון הנסתר מעיני הציבור וכד׳.
