# file = txt/1300031.txt
# filelineno = 726
# sentno = 1
# text = קשיים אלו בדרכי אישורן של תוכניות שנושאן תשתיות תחבורתיות היזומות על ידי משרדי וגורמי ממשלה עמדו גם לנגד עיני המחוקק128, ועל רקע זה אף בוצעו שני תיקונים מרכזיים בחוק התיכנון והבניה לנושא זה: תיקון מספר 37 לחוק התיכנון והבניה, משנת 1994, אשר הגדיר סוג מסויים של תוכניות כ ״תוכנית דרך״ וייחד הליך נפרד לתוכניות מסוג זה, ותיקון מס׳ 60 לחוק התיכנון והבניה, משנת 2002, אשר קבע הסדרים חדשים בכל הנוגע לפרויקטי תשתיות לאומיות, ובכלל זה גם לתשתיות תחבורתיות המהוים פרויקטי תשתית לאומית.
