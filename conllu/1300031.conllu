# file = txt/1300031.txt
# filelineno = 416
# sentno = 2
# text = בחינת התפלגות התוכניות שהופקדו בתקופה זו על-פי המחוזות השונים מעלה כי חלק ניכר מהתוכניות הופקדו במחוז הצפון (27%) כשאחריו, בהפרש קטן, מחוז המרכז (24%), ובהמשך מחוזות ירושלים (21%), דרום (15%), חיפה (7%) ותל אביב (6%) (ראו תרשים מס׳ 6).
