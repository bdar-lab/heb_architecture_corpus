# file = txt/1300031.txt
# filelineno = 584
# sentno = 1
# text = ביחס לשיעור ההולך וגדל של תוכניות עם התנגדויות ככל ששטח התוכנית גדל - יתכן שתוכניות רחבות היקף מעלות מספר רב של סוגיות תכנוניות, עשויות לכלול בתחומן מספר רב של בעלי זכויות במקרקעין, כמות בעלי מקרקעין גובלים עשויה להיות גדולה יותר - וכל אלו ועוד עשויים לעורר "פוטנציאל" התנגדויות גבוה יותר.
