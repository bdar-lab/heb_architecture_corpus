# file = txt/1300031.txt
# filelineno = 567
# sentno = 1
# text = שיעור גבוה זה צפוי, במידה מסויימת: מדובר בתוכניות שהממשלה או גורמים מטעמה, דוגמת משרד השיכון, מינהל מקרקעי ישראל, מע״צ, רכבת ישראל וכד׳ יוזמים; תוכניות אלו עוסקות, בדר״כ, בפרויקטים גדולים ורחבי היקף, בעלי השפעה ניכרת על הסביבה - וכתוצאה מכל אלה - מעוררים הרבה קונפליקטים.
