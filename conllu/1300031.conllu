# file = txt/1300031.txt
# filelineno = 358
# sentno = 1
# text = הליך ההתנגדויות, כפי שגובש בחוק ובפסיקה מאפשר אמנם לציבור להשמיע במסגרתו את התייחסותו לתוכנית, אך בהסתייגויות הבאות: לא ביחס לתוכניות המתאר הארציות, רק לציבור מסוים (רק מי שרשאי להגיש התנגדות), וכל זאת - רק בשלב מתקדם יחסית בהליך הסטטוטורי (לאחר שהתוכנית כבר הופקדה בפועל).
