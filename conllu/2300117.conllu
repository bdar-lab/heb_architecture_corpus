# file = txt/2300117.txt
# filelineno = 300
# sentno = 6
# text = מרבית התושבים הם ערבים, שהאזור היה מרכזם הקהילתי [...] במהלך העשורים שאחרי אישור התכניות פונו מאות משפחות ונהרסו מאות מבנים (אחדים מהם בעלי ערכים אדריכלים מיוחדים), ואולם,עד לשנות השמונים לא הצליחו הגופים המיישמים את התכנון לייצר מרחב מספק לשם בנייה חדשה באזורים המתפנים".
