# file = txt/1500045.txt
# filelineno = 270
# sentno = 1
# text = ב.	דפוס הפעילות היומית כאשר הפעילות העיקרית היא לימודים: למודל הזה יש שלוש אלטרנטיבות: הראשונה, הליכה ברגל לבית הספר ללא פעילויות נוספות (HE) (איור 3.4), השנייה, הליכה ברגל לבית הספר הלוך וחזור, כשלאחר החזרה הבייתה יש גם יציאה ברגל לבילוי (HELw) השלישית, נסיעה לבית הספר ולמטרות אחרות כמו קניות ובילוי באמצעי נסיעה מעורב, כלומר ברגל וגם ברכב כנוסע (HEO).
