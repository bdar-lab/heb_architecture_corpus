# file = txt/1500045.txt
# filelineno = 163
# sentno = 2
# text = יש אומנם כמה מחקרים שעוסקים בקשר שבין שימושי קרקע ובין ההליכה ברגל או השימוש באופניים מתוך התחשבות בהיבט הבטיחותי, אולם רק מקצתם דנים בצורה מפורשת בקשר שבין השינויים בשימושי קרקע ובין ִהי ָקרּות התאונות (2006 ,.Kim et al), כשלטענתם, כאשר מכינים תוכניות אב, נושא הבטיחות והקשר בין השינויים בשימושי קרקע ובין הפיתוח העירוני והשפעתם על רמת הבטיחות לא נלקחים בחשבון.
