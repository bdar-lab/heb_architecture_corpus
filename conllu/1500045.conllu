# file = txt/1500045.txt
# filelineno = 269
# sentno = 3
# text = כאשר הפעילות העיקרית היא עבודה, למודל הזה יש שתי אלטרנטיבות בחירה: הראשונה, מסלול פשוט של נסיעה אחת לעבודה ברכב הלוך וחזור (HW) (איור 3.4), השנייה, מסלול מורכב יותר הכולל נסיעה לעבודה שיכול לכלול גם מספר נסיעות למקום העבודה או למקומות שקשורים בעבודה, ונסיעות למטרות אחרות, כמו קניות, בילויים סידורים ואמצעי תחבורה מסוגים שונים, כלומר רכב כנהג או רכב כנוסע וברגל (HWO) (איור 3.4 ).
