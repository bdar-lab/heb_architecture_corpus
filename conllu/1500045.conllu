# file = txt/1500045.txt
# filelineno = 446
# sentno = 1
# text = טבלה 6.3.2 מציגה את התפלגות התחלות הבנייה ביישוב ראמה בין ארבעה אזורים: אזור א' -שטחים הנמצאים בין דרך 85 העוקפת ובין הדרך הפנימית הנעקפת (איור 6.3.5), אזור ב' -שטחים הנמצאים צפונית לדרך 85 העוקפת (איור 6.3.5), אזור ג'-מערב - שטחים הנמצאים בצד המערבי של היישוב רחוקים יחסית ממרכז היישוב, אזור ג'-מזרח - שטחים הנמצאים מזרחית לכביש אזורי 864 (כביש בית ג'ן) ואזור הכולל את כל שאר השטחים הנמצאים בתוך תחום תוכנית המתאר המאושרת.
