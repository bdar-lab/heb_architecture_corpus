# file = txt/1500045.txt
# filelineno = 393
# sentno = 7
# text = מילוי יומני נסיעות לכל הפרטים במשק הבית חושף את הקשרים והאילוצים הקיימים בין הפרטים במשק הבית בזמן בחירת הנסיעה, המסלול והאמצעי, ומאפשר ללמוד את הקשר בין הפעילויות והנסיעות ובין תכונות דמוגראפיות, כלכליות וחברתיות של משק הבית, בפריסה המרחבית של הפעילויות והשירותים ביישוב ובמקום המגורים.
