# file = txt/1500234.txt
# filelineno = 184
# sentno = 1
# text = כאשר מסתכלים על ההבדל בין מספר הנוסעים בכל מקטע בתחבורה ציבורית וברכב פרטי בזמן שיא בוקר עולה שחלו שינויים משמעותיים במספר הנוסעים העוברים במקטעים ברשת; ישנם מקטעים שבהם חלה עלייה של עד 1000 נוסעים במקטע, וכן להיפך, ירידה במקטעים מסוימים כתוצאה מהשינויים בנתיבים שהוסבו.
