# text = בשונה מאלבירטי, אנדרי פלאדיו (1508-1580) Andrea Palladio השאיר ויכוח רב בעניין הדו-ערכיות שנקט בה בספריו ביחס לסאונד, אבל רוב החוקרים שעקבו אחרי עבודותיו הצליחו לזהות כי פלאדיו מיישם את תורתו של פיתאגורס ברוב עבודותיו, דוגמא לכך היא וילה לה רוטנדה Villa "La
# raw = {'id': 1, 'text': 'בשונה מאלבירטי, אנדרי פלאדיו (1508-1580) Andrea Palladio השאיר ויכוח רב בעניין הדו-ערכיות שנקט בה בספריו ביחס לסאונד, אבל רוב החוקרים שעקבו אחרי עבודותיו הצליחו לזהות כי פלאדיו מיישם את תורתו של פיתאגורס ברוב עבודותיו, דוגמא לכך היא וילה לה רוטנדה Villa "La', 'dspan': (0, 257), 'tokens': [{'id': (1, 2), 'text': 'בשונה', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'שונה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'fixed', 'lemma': 'שונה'}], 'span': (0, 5), 'dspan': (0, 5)}, {'id': (3, 4), 'text': 'מאלבירטי', 'expanded': [{'id': 3, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 1, 'deprel': 'fixed', 'lemma': 'מ'}, {'id': 4, 'text': 'אלבירטי', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 13, 'deprel': 'obl', 'lemma': 'אלבירטי'}], 'span': (6, 14), 'dspan': (6, 14)}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (14, 15), 'span': (14, 15), 'lemma': ','}, {'id': 6, 'text': 'אנדרי', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 13, 'deprel': 'nsubj', 'dspan': (16, 21), 'span': (16, 21), 'lemma': 'אנדרי'}, {'id': 7, 'text': 'פלאדיו', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 6, 'deprel': 'flat', 'dspan': (22, 28), 'span': (22, 28), 'lemma': 'פלאדיו'}, {'id': 8, 'text': '(', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 9, 'deprel': 'punct', 'dspan': (29, 30), 'span': (29, 30), 'lemma': '('}, {'id': 9, 'text': '1508-1580', 'upos': 'NUM', 'xpos': 'NUM', 'head': 4, 'deprel': 'appos', 'dspan': (30, 39), 'span': (30, 39), 'lemma': '1508-1580'}, {'id': 10, 'text': ')', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 9, 'deprel': 'punct', 'dspan': (39, 40), 'span': (39, 40), 'lemma': ')'}, {'id': 11, 'text': 'Andrea', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 6, 'deprel': 'appos', 'dspan': (41, 47), 'span': (41, 47), 'lemma': 'Andrea'}, {'id': 12, 'text': 'Palladio', 'upos': 'PROPN', 'xpos':