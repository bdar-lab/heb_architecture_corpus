# file = txt/1500082.txt
# filelineno = 325
# sentno = 2
# text = הוא טוען כי ההתעסקות בתחום של חלל הסאונד ואוצר 'הצורות' המרכיב אותו מאפשר הגדרת מהותו של חלל הסאונד, איך אפשר לחוות או למדוד את תנועותיו של הסאונד בחלל, מהו "חלל סאונד וירטקלי" ומהו "שדה סאונד אופקי", מה פירוש שמיעת מעבר של הסאונד באלכסון לגוף האדם, איך אדם יכול לעמוד מעל סאונד או לשכוב מתחת לסאונד, איך סאונד חודר לתוך גוף האדם באופן וירטקאלי מלמעלה למטה, האם הסאונד מרחיב או דוחס את חלל הגוף.
