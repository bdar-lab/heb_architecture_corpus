# file = txt/1200126.txt
# filelineno = 6
# sentno = 1
# text = העבודה בחנה על כן מספר פולימרים, גם כאלה שמצויים בתווך מיימי וממילא קומפטיבליים עם עיסת הבטון הטרייה וגם כאלה שניתן להגדירם "כנידחים מפני – המים" ושאינם קומפטיבליים עם העיסה הטרייה, והיא נעשתה על ידי שימוש במספר סוגים של פולימרים מקובלים דוגמת אמולסיה של פוליויניל-אצטט, אמולסיות אקריליות,אמולסיות SBR ופולימרים אפוקסיים.
