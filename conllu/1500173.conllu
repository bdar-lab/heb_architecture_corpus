# file = txt/1500173.txt
# filelineno = 536
# sentno = 2
# text = מומלץ להקים "ועדה לתכנון היישובים הבדווים" (ולה״ב) בחסות הוועדה המחוזית לתכנון ולבנייה, בשיתוף נציגות משמעותית של תושבי הכפרים, מומחים מקצועיים ואקדמיים, ונציגי משרדי הממשלה ורשויות השלטון [...] מתווה זה, כך טוענת התכנית, יעלה את המרחב הבדווי על דרך המלך של שוויון, פיתוח ושגשוג, תוך שמירה מלאה על זכויות הבדווים, דרך אשר תביא ברכה לכל תושבי האזור, ערבים ויהודים כאחד״ (תכנית אב אלטרנטיבית 2012).
