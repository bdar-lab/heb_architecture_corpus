# file = txt/1500173.txt
# filelineno = 495
# sentno = 1
# text = לדוגמא, בית המשפט קבע שתושבי הכפר "אום אלחיראן" אינם פולשים לא חוקיים לאדמה, כפי שהמדינה טענה בתחילת הדיונים בבית המשפט, אלא הועברו על ידי המושל הצבאי בשנת 1956, לאחר שנעקרו מכפרם באיזור חירבת זובאלה, השטח מצוי כיום בידיו של קיבוץ שובל.
