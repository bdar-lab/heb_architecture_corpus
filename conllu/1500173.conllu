# file = txt/1500173.txt
# filelineno = 745
# sentno = 1
# text = משתתפים הצביעו על כך, שלאורך עשרות שנים היו גורמים שונים שתרמו לניתוק הזהות והמאבק הבדווי מהזהות והמאבק הפלסטיני והמרחב הלאומי הארצי, אם זה מסיבת היותם בפריפריה הגיאוגרפית והחברתית של החברה האזרחית הפלסטינית החזקה הנמצאת בגליל ובצפון בעיקר, ואם זה בשל מדיניות המדינה, החל מהממשל הצבאי במשך 20 שנה עד שנת 1967, ועד מדיניות התכנון כיום, המשרישה שיח ושפה ממסדית שמבליטה את נבדלות הבדווים משאר הפלסטינים.
