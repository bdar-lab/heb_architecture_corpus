# raw = {'id': 2, 'text': 'במקביל, הוקמה אגודת ״הארבעים״ בשנת 1988, כעמותה שפועלת למען ההכרה בכפרים הבלתי מוכרים בכל הארץ ובכללותם הנגב, אך כאשר הצליחה להשיג הכרה ב9 הכפרים הבלתי מוכרים בצפון בתחילת שנות ה1990, הפסיקה את פעולתה בנגב, מה שהעלה את הצורך של הבדווים בנגב לארגן את עצמם.', 'dspan': (169, 424), 'tokens': [{'id': 1, 'text': 'במקביל', 'upos': 'ADV', 'xpos': 'ADV', 'head': 3, 'deprel': 'advmod', 'dspan': (169, 175), 'span': (0, 6), 'lemma': 'במקביל'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (175, 176), 'span': (6, 7), 'lemma': ','}, {'id': 3, 'text': 'הוקמה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=HUFAL|Number=Sing|Person=3|Tense=Past|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (177, 182), 'span': (8, 13), 'lemma': 'הוקם'}, {'id': 4, 'text': 'אגודת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'nsubj', 'dspan': (183, 188), 'span': (14, 19), 'lemma': 'אגודה'}, {'id': 5, 'text': '״', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 7, 'deprel': 'punct', 'dspan': (189, 190), 'span': (20, 21), 'lemma': '״'}, {'id': (6, 7), 'text': 'הארבעים', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'ארבעים', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'compound:smixut', 'lemma': 'ארבעים'}], 'span': (21, 28), 'dspan': (190, 197)}, {'id': 8, 'text': '״', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 7, 'deprel': 'punct', 'dspan': (197, 198), 'span': (28, 29), 'lemma': '״'}, {'id': (9, 10), 'text': 'בשנת', 'expanded': [{'id': 9, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ב'}, {'id': 10, 'text': 'שנת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'obl', 'lemma': 'שנה'}], 'span': (30, 34), 'dspan': (199, 20