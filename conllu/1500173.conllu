# file = txt/1500173.txt
# filelineno = 508
# sentno = 1
# text = כפי שהוצג קודם, המועצה האזורית לכפרים הבלתי מוכרים בנגב יזמה שני תהליכים תכנוניים אלטרנטיביים, עריכת התכנית המוניציפאלית בשנת 1999- כתגובה לתכנית מטרופולין באר שבע, ועריכת תכנית האב האלטרנטיבית בשנת 2012- במקביל לוועדת גולדברג.
