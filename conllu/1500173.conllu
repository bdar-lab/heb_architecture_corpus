# file = txt/1500173.txt
# filelineno = 216
# sentno = 7
# text = הצעת החוק מפרטת את הנסיבות שבהן ישולמו פיצויים למפונים, כך היא מציבה תנאים נוקשים לתביעת פיצויים ויוצרת מספר קטן של בעלי זכות לתבוע פיצויים, שבמקרה הטוב ביותר יוכלו לקבל פיצוי חלקי על עקירתם, נישולם והוויתור על תביעות הקרקע שלהם, תוך שלילת זכותם החוקית להתנגד לעקירה הכפויה (עדאלה 2013).
