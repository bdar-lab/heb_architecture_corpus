# file = txt/1500173.txt
# filelineno = 207
# sentno = 2
# text = לאחר שרוב תובעי הקרקעות הבדווים נפטרו, פתחה מדינת ישראל בתהליך המתעל את תביעות הקרקע אל בתי המשפט, על ידי יוזמתה ל ׳תביעות נוגדות׳ הטוענות בעלות מדינה על קרקעות בדוויות, מתוך כוונה להביאם אל בית המשפט העליון, שכבר פסק לזכות המדינה בכ200 תביעות בעלות, בהסתמך על ׳הלכת הוואשלה׳ ופסיקתו בשנת 1984 שכל קרקעות הבדווים בנגב הן כביכול קרקעות ׳מתות׳, כיוון שלא נרשמו ב-1921 כפי שדרשה ׳פקודת הקרקעות המתות הבריטית׳ (תכנית אב לכפרים הבלתי מוכרים 2012).
