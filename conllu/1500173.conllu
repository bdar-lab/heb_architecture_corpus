# file = txt/1500173.txt
# filelineno = 930
# sentno = 1
# text = בנוסף לכך, ובעקבות הגישה הקולוניאלית המנתקת את הידע מהעוצמה ומהאג׳נדה של המדינה ( Yiftachel 2012), החברה האזרחית בכפרים הבלתי מוכרים בנתה שיח חדש, על ידי יצירת ידע, שפה, אוצר מלים והשתמשה בכלים היסטוריים ובינלאומיים כהתנגדות לשפה התכנונית הממסדית.
