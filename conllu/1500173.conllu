# file = txt/1500173.txt
# filelineno = 78
# sentno = 1
# text = לסיכום, המדינה מתמודדת עם האי פורמאליות של הילידים על ידי דה לגיטימציה, האשמה בפשיעה, בפלישה וסכנה לסדר הציבורי הרצוי, וזאת על ידי הגבלת ניידות, ניצול, הכחשה, הפרדה בצמיחה הניאוליברלית (2004 Yiftachel 2012; Mbembe & Nutall), תהליך של "אפרטהייד בזחילה" שמסרב להכיר בבעלות ההיסטורית של הילידים בקרקע (2012 Yiftachel).
