# file = txt/1500173.txt
# filelineno = 608
# sentno = 1
# text = "תמיכה נוספת בזכויות הקרקע והתכנון של הבדווים בנגב נובעת מהיותם מיעוט יליד, המוגדר בהצהרות ואמנות בינלאומיות, ובפרסומים של ועדות או״ם שונות, כאוכלוסייה אשר הוכפפה לשלטון של מדינות מודרניות, לאחר שחיה במשך דורות תחת שלטון עצמי[...] טענתנו היא שבדומה לאופן בו זכויות הקניין הקרקעי של השבט שרדו את תקופות המעבר בין התקופה של אוטונומיה בדווית לבין כניסתו של המשטר העות׳מאני, ובין המשטר העות׳מאני למנדט הבריטי, כך ראוי שזכויות אלה יישמרו גם לאחר המעבר בין המשטר הבריטי לישראלי״ (תכנית אב להכרה בכפרים הלא מוכרים 2012).
