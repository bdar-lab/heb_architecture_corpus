# file = txt/1500173.txt
# filelineno = 511
# sentno = 2
# text = ההבדל בין התכניות שהתכנית האלטרנטיבית היא תכנית אב ולא מנסה לעשות תכנון ממסדי אך נותנת כללים תכנוניים ומודלים איך צריך להכיר בכפרים ולבטא את ההכרה בכלים תכנוניים [...] התכנית המוניציפאלית לא עוסקת בתכנון יישובי וקבעה עקרונות כלליים להכרה בישובים ולמאבק על ההכרה אך לא מעבר לזה לתכנון" (רונן בן אריה, במקום מתכננים למען זכויות אדם).
