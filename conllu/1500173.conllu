# file = txt/1500173.txt
# filelineno = 966
# sentno = 1
# text = בעקבות הספרות, אשר התייחסה לתפקיד החברה האזרחית בתכנון כבעל פוטנציאל טרנספורמטיבי (2000 Friedmann 2005; Edwards 2004; Fischer), התחילה החברה האזרחית בכפרים הבלתי מוכרים, בדרישה להשתתף בקבלת ההחלטות, ולהבטיח ביטוי לצרכים, ידע קהילתי והגדלת מרחבי הדמוקרטיה בתהליכי התכנון המרחבי.
