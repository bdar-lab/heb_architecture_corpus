# file = txt/1500173.txt
# filelineno = 143
# sentno = 4
# text = השנייה נוגעת בזכות לניכוס המרחב, היא הזכות של התושבים להשתמש באופן מלא במרחב שלהם במסלול של חייהם היומיומיים, המתבטא ב״סוציאליזציה של המרחב הפרטי והאינדיבידואליזציה של המרחב החברתי״ (2015 Stanek 2011: 90 Cite at: Jabareen).
