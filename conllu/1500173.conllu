# file = txt/1500173.txt
# filelineno = 223
# sentno = 3
# text = שיטה זו מיוצרת על ידי האנשים כאשר המדינה אינה מספקת להם מרחבי מגורים, תעסוקה, תרבות ובילוי הולמים (2014 Jabareen) : מרחב נתפס (Perceived Space) ; מרחב פיזי, שניתן להתבוננות אמפירית, בעל היגיון ארגוני מרחבי של הפרקטיקות החברתיות המבנות את החיים היומיומיים ומרחבי הפעולה שלנו, ומבטיחה לכידות חברתית, המשכיות ויכולת מרחבית( 1996 Jabareen 2014; Soja) .
