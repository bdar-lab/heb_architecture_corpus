# file = txt/1500173.txt
# filelineno = 64
# sentno = 3
# text = בעוד שהקולוניאליזם החיצוני הינו התרחבות מעבר לגבולות הריבונות, הקולוניאליזם הפנימי מאמץ מדיניות תכנון מפלה, הדרה ונישול (2000 Yiftachel 2012; Tully ) ומייצר משאבים ועוצמה של קבוצה השלטת אתנית ומעמדית על חשבון האוכלוסייה הילידית (2012 Yiftachel).
