# file = txt/1800048.txt
# filelineno = 109
# sentno = 1
# text = מכאן, אם היקף העלייה לישראל במחצית השניה של שנות התשעים עמד על כ-70,000 עולים בשנה, מאזן ההגירה (עולים בניכוי מאזן יציאות וחזרות של ישראלים ששהו שנה לפחות בחו"ל) עומד על 57,000-53,000 נפש בשנה (בהתבסס על נתוני 1998-1995).
