# file = txt/2300163.txt
# filelineno = 222
# sentno = 2
# text = התקיימו פגישות עבודה עם קבוצות המיקוד ובמהלך הפגישות, אשר נערכו בין החודשים דצמבר 2000 עד פברואר 2001, הוצג חומר הרקע למחקר אשר הצביע על הבעייתיות של אבדן קרקעות בכלל, וקרקעות חקלאיות בפרט, הערכת היצע הקרקעות בשימושים השונים והביקושים לקרקע לפיתוח.
