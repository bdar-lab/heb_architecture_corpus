# file = txt/2300015.txt
# filelineno = 55
# sentno = 1
# text = קשיי הפרט ואי-השויון עלולים להחמיר עוד יותר לפי המצב המשפטי הנוכחי, מאחר שהחוק אינו דן בעננה של וזינב כפול׳ למשל כאשר בנוסף לתכנית מתאר חלים על אותו שטח גם תכנית מפורטת ואולי גם תכנית מחוזית (מאיר, 1972, עי 128), וכאמור לעיל, אין התיחסות בחוק לאפשרות של גביה פעם לפי אשור תכנית ופעם לפי בצועה ואולי גם מספר פעמים במשך תקופת בצוע בלתי מוגדרת.
