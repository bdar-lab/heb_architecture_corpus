# file = txt/2300015.txt
# filelineno = 54
# sentno = 2
# text = מצב סביר זה של התפשרות עם המציאות ועם שקולים של התחשבות בקשיי הפרט הותקף פעמים חוזרות ונשנות ע״י מבקר המדינה בדו״חות השנתיים של הרשויות המקומיות (1976, בת-ים, עי 39;	1971, פתח-תקוה, עי 48;	1972, רעננה, עי 32).
