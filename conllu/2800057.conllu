# file = txt/2800057.txt
# filelineno = 99
# sentno = 1
# text = ריכוז מאמץ התכנון לכיוון של יצירת המבנה המרחבי טומן הסיכון שהתוצאה תעבור במקרה זה מעבר לעיקרון האיזון ושמירת המידה, עם השפעה ברמת השגת היעדים־ בעקבות טיפול המבנה בשכונת רמות ומעלות דפנה, אין זה מן הנמנע שהמרחב המתוכנן ניראה כאילו עמוס מדי לעומת הצורך ב"קריאה מהירה".
