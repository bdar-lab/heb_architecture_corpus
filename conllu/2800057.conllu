# file = txt/2800057.txt
# filelineno = 239
# sentno = 1
# text = מובן שבסביבה "הפונקציונליסטית" אשר מושתתת על תלות באותות, בהוראות, בהזהרות וכוי - אין מקום להתבטאות כזאת; והתוצאה היא תהליך של ריחוק, עד כדי העלמות יכולת הסביבה להגשים את סיפוק הפרט לפי שאיפותיו ונטיותיו" נוצר משום כך המצב המוזר של "בריחת המונים" למרחקים (חיפוש מקומות הנופש), שעה שאין המשתכנים מוצאים בקרבת מגוריהם מקורות לסיפוק אנושי.
