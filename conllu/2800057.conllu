# file = txt/2800057.txt
# filelineno = 316
# sentno = 2
# text = אם כן, כדאי להזכיר גם בהקשר זה מספר השלכות תכנוניות שנבעו מהאיבחון בחומר הירושלמי, כרקע מרחבי לייצוג הסמלי של אירועי המקום: מיקום מרכזי שהוא מעודד נגישות המונית אליו; תפיסה וויזואלית והכוונת מספר נקודות תצפית אליו; "קפיצה" מסויימת בקני-המידה של מרכיבי המקום וכו'.
