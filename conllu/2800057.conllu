# file = txt/2800057.txt
# filelineno = 229
# sentno = 2
# text = כמעט שאינם קיימים כלים מסודרים לאינפורמציה שוטפת - לוחות מסוגים שונים, שלטים, עמודים וכוי - ובמידה שהם קיימים, מידת הזנחתם מצביע על היעדר השיקולים להצבתם לגבי טיפוס הריהוט וכוח משיכתו, המיקום וכוי־ למרות הקושי שמלווה בכלל התמצאותם של המבקרים במירקם המסובך של שכונות אלו, אין מעמידים באופן שוטף לרשותם כלים מתאימים - מיפוי המקום, תרשימים וכדומה -בתור מבצע מקיף של תידרוך שיטתי־ שרות התידרוך עדיין נדיר, מקרי וחלקי, ללא עידכון תכוף בהתאם לפיתוח המקום־
