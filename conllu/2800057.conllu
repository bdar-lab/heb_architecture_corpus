# file = txt/2800057.txt
# filelineno = 287
# sentno = 2
# text = על מנת להרחיק לגמרי את הסיכון שציר המיכלים האלה יסבוב את דימוי המרחב, ידרש כניראה שינוי מהותי בפתרון עצמו: העברת עמדות הפסולת לצמידות מיידית בתוך המבנה, וחיסול פעולת האיסוף בתור עיסוק מרחבי של המשפחה־ פתרונות שהם בשימוש רחב בארצות אחרות כוללים בתוך הבנין כל ה"נוהלים הטכנולוגיים" שמתייחסים לאיסוף - ולא פעם גם השמדת האשפה: מערכת של צינורות עם שרות בכל קומה, גופי איחסון וכו'.
