# file = txt/2800057.txt
# filelineno = 165
# sentno = 1
# text = על כן, אם יש להתגבר על החד-גוניות בהרכב הדמוגרפי של השכונה, אין זה מספיק, לפי דעתנו, - ואולי אינו מכריע - העירבוב הדמוגרפי שאותו מבקשים להשיג כעת באיכלום השכונה: משפחות שונות לפי גודל, סטטוס וכו'.
