# file = txt/1500185.txt
# filelineno = 23
# sentno = 2
# text = במילון מונחים לשימור של רשות העתיקות אלו מוגדרים כ״שימור באתרו״ ־ (Jn-Situ Conservation) : "שימור באתרו מתייחס, לרוב, בטיפול השרידים הארכיאולוגיים בסביבתם המקורית, זאת כדי לשמר את הערכים של הנכס ואת האותנטיות שלו תוך שמירה על מרב ההקשרים וההיבטים הנובעים ממנו.
