# file = txt/1500185.txt
# filelineno = 300
# sentno = 2
# text = המשמעות היא שתכנון וניהול גנים ארכאולוגים צריכים להתחשב ולפתח את שלושת המרכיבים שנבדקו במקביל: פעולות שימור פיזיים וחיזוק הופעתם בעיני המתבונן, פעולות להגדלת המודעות לקיומם של העתיקות ומשמעותם המדעית בסביבה העירונית הקרובה, וכן הגדלת הנגישות הפיזית אל העתיקות ליצירת חוויה מוחשית למבקר בגן.
