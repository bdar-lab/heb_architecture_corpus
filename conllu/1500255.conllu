# file = txt/1500255.txt
# filelineno = 36
# sentno = 4
# text = לכן, כל פגיעה או הפרעה בערוצי הנחל במדבר תוכל לגרור אחריה פגיעה לא רק בצומח אלא גם בבעלי החיים הנסמכים עליו, פגיעה זו תהיה משמעותית הרבה יותר ממקומות אחרים, מפני שפרט לערוצי הנחל אין לבעלי החיים ולצומח מקומות אחרים המספקים להם מזון, מים ומחסה (2013 ,.Wolf et al).
