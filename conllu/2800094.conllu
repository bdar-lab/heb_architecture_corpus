# file = txt/2800094.txt
# filelineno = 328
# sentno = 3
# text = השוואה עם התפלגות משלחי היד של אוכלוסיית כלל המועסקים בשנת 1980* (בטבלה מס’ 22), מצביעה על אחוז גבוה יחסית של קבוצת״הצוארון הכחול הנמוך" בקרב אוכלוסיית הסקר: 18% לעומת 13%, ולעומת זאת - שיעור נמוך מאוד, יחסית, של קבוצת "הצוארון הלבן הגבוה": 9% באוכלוסיית המרואיינים לעומת 22.5% בכלל המועסקים.
