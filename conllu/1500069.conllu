# text = מגמת התכנון הכללית של מחנות הצבא הייתה ריכוז המבנים וקיצור המרחקים ביניהם, וכל זאת נעשה בתקופה של הצטמצמות המדינה בגבולות "הקו הירוק", שהיוו לא רק גבול מדיני אלא גבול לתפיסה רחבה וכוללת, דבר אשר השתנה עם תום מלחמת ששת הימים (שפט אצל אהרוני, 2003).
# raw = {'id': 2, 'text': 'מגמת התכנון הכללית של מחנות הצבא הייתה ריכוז המבנים וקיצור המרחקים ביניהם, וכל זאת נעשה בתקופה של הצטמצמות המדינה בגבולות "הקו הירוק", שהיוו לא רק גבול מדיני אלא גבול לתפיסה רחבה וכוללת, דבר אשר השתנה עם תום מלחמת ששת הימים (שפט אצל אהרוני, 2003).', 'dspan': (166, 413), 'tokens': [{'id': 1, 'text': 'מגמת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 11, 'deprel': 'nsubj', 'dspan': (166, 170), 'span': (0, 4), 'lemma': 'מגמה'}, {'id': (2, 3), 'text': 'התכנון', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'תכנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'compound:smixut', 'lemma': 'תכנון'}], 'span': (5, 11), 'dspan': (171, 177)}, {'id': (4, 5), 'text': 'הכללית', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'כללית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'amod', 'lemma': 'כללי'}], 'span': (12, 18), 'dspan': (178, 184)}, {'id': 6, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 7, 'deprel': 'case:gen', 'dspan': (185, 187), 'span': (19, 21), 'lemma': 'של'}, {'id': 7, 'text': 'מחנות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'nmod', 'dspan': (188, 193), 'span': (22, 27), 'lemma': 'מחנה'}, {'id': (8, 9), 'text': 'הצבא', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'צבא', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'compound:smixut', 'lemma': 'צבא'}], 'span': (28, 32), 'dspan': (194, 198)}, {'id': 10, 'text': 'הייתה', 'upos': 'AUX', 'xpos': 'AUX', 'feats': 'Gender=F