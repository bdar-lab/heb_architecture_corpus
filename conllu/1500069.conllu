# file = txt/1500069.txt
# filelineno = 1284
# sentno = 2
# text = אך עבודה זו שמה דגש דווקא על שביעות הרצון של המשתמש – תחום שטרם נבדק בהקשר של מחנות צה"ל, והיא יוצאת מנקודת ההנחה שככל שהמשתמש מרוצה יותר, גם מן התנאים הפיזיים שהוא מצוי בהם, הדבר תורם לתפקודו ומשפר אותו ובכך תורם להשגת מטרות הארגון.
