# file = txt/1500069.txt
# filelineno = 371
# sentno = 1
# text = גם במסמך זה, בדומה למסמך הדן בבניה הקשיחה למגורים, מפורטות הנחיות בנוגע לגיאומטריית העמדה, הפניות המבנים, מרחקי בטיחות והרחקה ממטרדים סביבתיים, וכן בהמשך קיימת ירידה לפרטים בנושא אזורי תפקוד שונים במבנים, גדלים ומידות של הפונקציות השונות, חומרי גמר, וכן נושאי בטיחות ומערכות חשמל, אינסטלציה ומיזוג אויר, ומספר הנחיות בנוגע להיקף הבניין (סטנדרטיזציה של מבני משרדים בבניה קשיחה, 2004).
