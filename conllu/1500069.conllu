# sentno = 1
# text = בגיליון עיתון "במחנה" מ - 28.4.2006, מצוין כי ההנחיה נועדה להבטיח שכל המבנים הצה"ליים שייבנו בעתיד יעמדו בפקודת השילוב הראוי, ועל פיה יש לשאוף ליישם את עקרונות השילוב הראוי באמצעות תכנון אדריכלי מקדים, בדגש מיוחד על העמדת מבנים ועל יצירת מתחמי בינוי, כך שתיווצר מחיצה בין מגורי הבנים למגורי הבנות, וזאת מבלי לעשות שימוש באמצעי גידור.
