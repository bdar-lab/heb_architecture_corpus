# file = txt/1500069.txt
# filelineno = 940
# sentno = 1
# text = על פי אפרת, הבטון החשוף נמצא בגרסאות רבות ובסוגי מבנים רבים משתי סיבות : הבטון נתפס כ"חומר ישראלי" הן משום זמינותו והן משום שאפשר חדשנות אדריכלית תוך שימוש בחומריות דלה (עקרון הצניעות והאמת המוחצנת), והן משום שאפשר לדור האדריכלים ילידי הארץ "הצברים" להתנתק מהסגנון ה"גלותי" התלוש לכאורה של הוריהם (אפרת, 2004).
