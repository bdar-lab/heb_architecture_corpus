# file = txt/1500069.txt
# filelineno = 931
# sentno = 1
# text = קבוצת אדריכלים, שהתגבשה בפקולטה לארכיטקטורה בטכניון – ביניהם אלפרד נוימן (המורה הנערץ, נושא הבשורה), וכן מיכאל בורט, ישראל גודוביץ, ליאופלד גרסטל, צבי הקר, דוד ינאי , אל מנספלד, יונה פרידמן ואלדר שרון – ביקשה להמיר את הגריד ישר-הזוית במטריצה רב-פיאונית, ולהחליף את האובייקט הקופסתי באשכול מגובב, חסר צורה קבועה, של תאים מודולריים משתכפלים.
