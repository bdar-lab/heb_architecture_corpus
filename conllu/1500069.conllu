# file = txt/1500069.txt
# filelineno = 466
# sentno = 2
# text = בעקבות זאת, וכן לאור התיקון לחוק שירות הביטחון אשר במרכזו מתן הזכות לנשים לשרת בכל היחידות והמערכים, החל בשנת 2005 תהליך בהובלת מרכז הבינוי שמטרתו לאפשר לכל חייל וחיילת לשרת שירות משמעותי, בהתאם לחוק ומבלי שייפגעו ערכיהם, אמונתם ואורך חייו של מי מהם.
