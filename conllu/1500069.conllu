# file = txt/1500069.txt
# filelineno = 193
# sentno = 1
# text = עם קבלת החלטת הממשלה על ההינתקות מרצועת עזה בשנת 2005, מרכז הבינוי החל לבצע את פרויקט 'שבת אחים' אשר כלל גדר אינדיקטיבית (המתריעה באופן חשמלי על נגיעות בה) באורך 66 ק"מ, כולל מכשול כדוגמת קו התפר, מיסוד מחנות קבע, הגדול מביניהם מחנה רעים (אשר שימש בתחילה את הכוחות שלקחו חלק בתהליך הפינוי, ולאחר מכן, את הכוחות המתפנים מרצועת עזה) ובניית שמונה מחנות תגבור נוספים לכוחות שלקחו חלק בתהליך הפינוי, בעלות של כ-350 מליון ש"ח (כהן, 2006).
