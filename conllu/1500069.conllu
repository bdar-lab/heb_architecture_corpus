# text = כאשר יוסף בן-מתתיהו מתאר את בנייתו של מחנה ללגיון רומאי, הוא מדגיש את העקרונות החשובים, כגון: כיוונים ומימדים קבועים, התחשבות בכיווני הרוח, מהירות הקמה, מהירות הפינוי והיציאה מן המחנה, חלוקה פנימית לאזורים לוגיסטיים ולאזורים קרביים, וכל זאת בשילוב של אסטרטגיה צבאית ובתוספת דרישות פונקציונליות ואנושיות (אהרוני, 2003).
# raw = {'id': 3, 'text': 'כאשר יוסף בן-מתתיהו מתאר את בנייתו של מחנה ללגיון רומאי, הוא מדגיש את העקרונות החשובים, כגון: כיוונים ומימדים קבועים, התחשבות בכיווני הרוח, מהירות הקמה, מהירות הפינוי והיציאה מן המחנה, חלוקה פנימית לאזורים לוגיסטיים ולאזורים קרביים, וכל זאת בשילוב של אסטרטגיה צבאית ובתוספת דרישות פונקציונליות ואנושיות (אהרוני, 2003).', 'dspan': (290, 608), 'tokens': [{'id': 1, 'text': 'כאשר', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 6, 'deprel': 'mark', 'dspan': (290, 294), 'span': (0, 4), 'lemma': 'כאשר'}, {'id': 2, 'text': 'יוסף', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 6, 'deprel': 'nsubj', 'dspan': (295, 299), 'span': (5, 9), 'lemma': 'יוסף'}, {'id': 3, 'text': 'בן', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 2, 'deprel': 'flat', 'dspan': (300, 302), 'span': (10, 12), 'lemma': 'בן'}, {'id': 4, 'text': '-', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (302, 303), 'span': (12, 13), 'lemma': '-'}, {'id': 5, 'text': 'מתתיהו', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 2, 'deprel': 'flat', 'dspan': (303, 309), 'span': (13, 19), 'lemma': 'מתתיהו'}, {'id': 6, 'text': 'מתאר', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PIEL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Act', 'head': 17, 'deprel': 'advcl', 'dspan': (310, 314), 'span': (20, 24), 'lemma': 'תיאר'}, {'id': 7, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 8, 'deprel': 'case', 'dspan': (315, 317), 'span': (25, 27), 'lemma': 'את'}, {'id': (8, 9), 'text': 'בנייתו', 'expanded': [{'id': 8, 'text': 'בניית', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'obj', 'lemma': 'בנייה'}, {'id': 9, 'text': 'ו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Definite=Def|Gender=Masc|Number=Sing|Person=3|Poss=Yes|PronType=Prs', 'head': 8, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (28, 34), 'dspan': (318, 324)}, {'id': 10, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen',