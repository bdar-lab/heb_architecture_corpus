# file = txt/2300099.txt
# filelineno = 179
# sentno = 1
# text = אם תנאי הדיור של חלק מסוים של האוכלוסיה נופלים באופן ניכר מאלה המקובלים במדינה, ואם מקובל במדינה שמוסדות הציבור מסייעים לתושבים בהשגת דיור נאות, אזי מובנת הציפיה מצד תושבי "שכונות העוני" ששיכון מסודר "מגיע להם", ומובנת גם תחושת האפליה כאשר אחרים מצליחים "להסתדר" יותר מהר או יותר טוב.
