# file = txt/2300099.txt
# filelineno = 125
# sentno = 3
# text = עוד יתכן, שעצם ההבדלים הדימוגרפיים בין המפונים בשיכונים ובין המפונים בדירות חילוף, בגילם, בהשכלתם, במוצאם, ובותקם בארץ (ראה פרק 3.1) - יוצרים בהם ציפיות שונות בקשר לתנאי המגורים ובמושגים כגון צפיפות, הפרעה, וכדומה.
