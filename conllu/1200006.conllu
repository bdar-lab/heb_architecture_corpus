# file = txt/1200006.txt
# filelineno = 279
# sentno = 1
# text = למרות שבטווח הקצר לא נראה שיפור משמעותי בלוחות הזמנים הכוללים של פרויקטים קיימת הסכמה כוללת בקרב המרואיינים כי מעבר שיטתי לשיווקים מוגברים של פרויקטים גדולים למגורים הכוללים את ביצוע עבודות התשתית והפיתוח ומוסדות הציבור על-ידי המגזר הפרטי יובילו להקטנת היקפי המטלות הציבוריות, להקלה על העומס ברשויות, ועם הזמן התהליכים המתמשכים ברשויות יתקצרו גם הם.
