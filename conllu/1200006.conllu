# file = txt/1200006.txt
# filelineno = 148
# sentno = 3
# text = ארגון ה OECD מחזיק בהגדרה אחרת ולפיה שותפות ציבורית פרטית היא "חוזה לטווח ארוך בין חברה פרטית לבין ישות ממשלתית, למתן נכס או שירות ציבורי, שבו החברה הפרטית נושאת סיכון משמעותי ואחריות ניהולית ושכרה מקושר לביצועיה" (2012 ,OECD).
