# file = txt/1200006.txt
# filelineno = 310
# sentno = 1
# text = יחד עם זאת, בענף הבנייה קיים פוטנציאל עצום לשיפור הפריון והיעילות הודות לטכנולוגיות ושיטות בנייה מתקדמות אשר חלקן כבר זמינות לשימוש, וחברות אשר משכילות לפתח ולשכלל טכנולוגיות, ליישם שיטות ניהול מתקדמות ומשקיעות באופן שוטף בהכשרה, הטמעת חדשנות וניהול הידע הארגוני, מכינות את עצמן מראש לעתיד ענף הבנייה וזוכות להישגים עודפים מול מתחרותיהן בענף (רוזנפלד, בן עוז ותורגמן, 2019).
# raw = {'id': 1, 'text': 'יחד עם זאת, בענף הבנייה קיים פוטנציאל עצום לשיפור הפריון והיעילות הודות לטכנולוגיות ושיטות בנייה מתקדמות אשר חלקן כבר זמינות לשימוש, וחברות אשר משכילות לפתח ולשכלל טכנולוגיות, ליישם שיטות ניהול מתקדמות ומשקיעות באופן שוטף בהכשרה, הטמעת חדשנות וניהול הידע הארגוני, מכינות את עצמן מראש לעתיד ענף הבנייה וזוכות להישגים עודפים מול מתחרותיהן בענף (רוזנפלד, בן עוז ותורגמן, 2019).', 'dspan': (0, 374), 'tokens': [{'id': 1, 'text': 'יחד', 'upos': 'ADV', 'xpos': 'ADV', 'head': 3, 'deprel': 'case', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'יחד'}, {'id': 2, 'text': 'עם', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'dspan': (4, 6), 'span': (4, 6), 'lemma': 'עם'}, {'id': 3, 'text': 'זאת', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Dem', 'head': 9, 'deprel': 'obl', 'dspan': (7, 10), 'span': (7, 10), 'lemma': 'זה'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (10, 11), 'span': (10, 11), 'lemma': ','}, {'id': (5, 6), 'text': 'בענף', 'expanded': [{'id': 5, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ב'}, {'id': 6, 'text': 'ענף', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 9, 'deprel': 'obl', 'lemma': 'ענף'}], 'span': (12, 16), 'dspan': (12, 16)}, {'id': (7, 8), 'text': 'הבנייה', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'בנייה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'compound', 'lemma': 'בנייה'}], 'span': (17, 23), 'dspan': (17, 23)}, {'id': 9, 'text': 'קיים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (24, 28), 'span': (24, 28), 'lemma': 'קיים'}, {'id': 10, 'text': 'פוטנציאל', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sin