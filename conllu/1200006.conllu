# file = txt/1200006.txt
# filelineno = 342
# sentno = 3
# text = על פי סקר אתרים אשר נערך במהלך שנת 2015 נמצא כי הרוב המכריע של הבניה בישראל משתמש בשיטות בנייה קונבנציונליות, כאשר שימוש בשיטות מתועשות נעשה בעיקר במבנים רבי קומות ובמגדלים, המהווים פחות מרבע מהיקף התחלות הבניה למגורים בישראל.
