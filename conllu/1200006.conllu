# text = כמו כן, פיתוחים של שימוש ברובוטים לטובת חיסכון בכוח אדם והגברת הדיוק בביצוע; שימוש ברחפנים לתיעוד, פיקוח וניטור של התקדמות העבודה באתרי הבנייה; ותוכנות ממשק בין התוכניות המבוססות BIM אשר מאחדות את המידע המתקבל מהמתכננים בשלבים השונים בפרויקט עם ריבוי הגרסאות, לבין התקדמות העבודות בשטח, על-מנת למנוע ולפתור אי-התאמות.
# raw = {'id': 2, 'text': 'כמו כן, פיתוחים של שימוש ברובוטים לטובת חיסכון בכוח אדם והגברת הדיוק בביצוע; שימוש ברחפנים לתיעוד, פיקוח וניטור של התקדמות העבודה באתרי הבנייה; ותוכנות ממשק בין התוכניות המבוססות BIM אשר מאחדות את המידע המתקבל מהמתכננים בשלבים השונים בפרויקט עם ריבוי הגרסאות, לבין התקדמות העבודות בשטח, על-מנת למנוע ולפתור אי-התאמות.', 'dspan': (370, 687), 'tokens': [{'id': 1, 'text': 'כמו', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'dspan': (370, 373), 'span': (0, 3), 'lemma': 'כמו'}, {'id': 2, 'text': 'כן', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Person=3|PronType=Dem', 'head': 4, 'deprel': 'nmod', 'dspan': (374, 376), 'span': (4, 6), 'lemma': 'כן'}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (376, 377), 'span': (6, 7), 'lemma': ','}, {'id': 4, 'text': 'פיתוחים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 0, 'deprel': 'root', 'dspan': (378, 385), 'span': (8, 15), 'lemma': 'פיתוח'}, {'id': 5, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 6, 'deprel': 'case', 'dspan': (386, 388), 'span': (16, 18), 'lemma': 'של'}, {'id': 6, 'text': 'שימוש', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'nmod:poss', 'dspan': (389, 394), 'span': (19, 24), 'lemma': 'שימוש'}, {'id': (7, 8), 'text': 'ברובוטים', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 8, 'text': 'רובוטים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 6, 'deprel': 'nmod', 'lemma': 'רובוטים'}], 'span': (25, 33), 'dspan': (395, 403)}, {'id': (9, 10), 'text': 'לטובת', 'expanded': [{'id': 9, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'lemma': 'ל'}, {'id': 10, 'text': 'טובת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 9, 'deprel': 'fixed', 'lemma': 'טובה'}], 'span': (