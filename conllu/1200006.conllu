# sentno = 1
# text = אך ייתכן שהמציאות בשטח מעט פחות מזהירה: על פי נתוני חברת מדלן אשר עוקבת אחרי כל בקשה להיתר שמוגשת בישראל מרגע הגשתה ועד לאישורה, משך הזמן הממוצע להוצאת היתר בנייה רק הולך ומתארך עם השנים, ובממוצע ארצי עסקאות מקרקעין מאושרות מקבלות היתרי בנייה לאחר זמן ארוך מבעבר.
