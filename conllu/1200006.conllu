# file = txt/1200006.txt
# filelineno = 418
# sentno = 3
# text = באזורים רבים בפריפריה יצרה תוכנית מחיר למשתכן היצע גדול מאוד ביחס לביקוש בשוק המקומי, וכתוצאה מכך יזמים וקבלנים רבים נותרו עם מלאי גדול של דירות לא מכורות –הן בתוכנית מחיר למשתכן והן בשוק החופשי (בנק ישראל דין וחשבון, שוק הדיור, 2019).
