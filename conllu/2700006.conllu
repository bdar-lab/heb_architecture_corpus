# file = txt/2700006.txt
# filelineno = 148
# sentno = 1
# text = רמה נמוכה יחסית באיכות הסביבה - בהתייחס למקורות זיהום סביבתי ולמאפיינים המייצגים רמות זיהום, מוצאים שלאורך כל התקופה, נמוך מאוד ויציב מיקומה היחסי של ישראל בייצור ובצריכת אנרגיה לנפש (מקומות 9ו ו-21 בהתאמה) וברמת המינוע (מקום 22).
