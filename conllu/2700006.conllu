# file = txt/2700006.txt
# filelineno = 95
# sentno = 1
# text = בניתוח הגורמים נמצא כי מעמדה של ישראל במדרג העולמי (על-פי גורם הפיתוח המסביר את מרבית השונות בין המדינות) של המדינות נשאר יציב (מקום 23 בשנת 1965 ומקום 22 בשנת 1985), אך ההתקדמות המהירה של המדינות, שבראש סולם המדרג, הותירה את ישראל בפיגור ניכר, ודוחקת אותה בבירור לקבוצת המדינות הנמצאות אף הן בנסיגה יחסית, אם כי הולכות ומתמקמות ברובד העליון של המתנות המתפתחות.
