# file = txt/2700006.txt
# filelineno = 145
# sentno = 2
# text = תמונה הפוכה למגמת השתנות מיקומה היחסי של ישראל במשקל המועסקים בתעשייה מתקבלת במשקל השירותים: כאשר שיעור המועסקים בתעשייה מיקם את ישראל ברובד התחתון של המדינות המפותחות, מיקמו אותה השירותים ברובד העליון של המדינות המפותחות, וכאשר עלה מיקומה של ישראל במדרג על-פי משקל המועסקים בתעשייה, הסתמן במקביל כרסום במעמדה על-פי משקל המועסקים בשירותים.
