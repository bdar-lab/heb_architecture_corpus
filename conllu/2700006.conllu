# file = txt/2700006.txt
# filelineno = 266
# sentno = 1
# text = העיכוב בפיתוחה של מדינה הנובע מערך גבוה של גורם זה מתבטא גם ברמת קשר בינונית אך הפוכה עם תבחינים נוספים של פיתוח, הכוללים: תמ״ג לנפש, תמ״ג למועסק בענפים השונים, שיעור השתתפות נמוך בכוח העבודה, שיעור השתתפות בבי״ס תיכון, מספר רופאים לאלף נפש, ומקדמי רווחת פרט שונים, כמו: שיעור משקי בית עם טלוויזיה, מספר טלפונים לאלף נפש, רמת מינוע של רכב פרטי ושיעור גידול ברמת המינוע.
