# sentno = 1
# text = 3.	רחוב מאסף - זהו הרחוב המרכזי בשכונה, אשר יכול גם לחבר שכונות ברובע, מפזר תנועה מהרחוב העורקי אל רחובות מקומיים או אל שימושי הקרקע השונים בשכונה, משרת תנועה עוברת ותנועה ניגשת ומתחבר אל רחובות מקומיים,עורקיים או מאספים אחרים.
