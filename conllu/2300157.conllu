# file = txt/2300157.txt
# filelineno = 354
# sentno = 6
# text = יחד עם זאת, חוסנם הכלכלי והחברתי של קיבוצי המחקר מעגן מיכאל ושדות ים מהווה גורם משיכה משמעותי לבניו, ואלו בוחרים ברובם להישאר בקיבוץ ולהסתפק בהיצע המקומי, השארות הבנים מעידה חד משמעית על העדפת הבית בכפר על העיר, זאת למרות מגבלות הדיור הקיבוצי הקיים, ואורח החיים הקיבוצי השיתופי המחייב הנהוג במקום.
