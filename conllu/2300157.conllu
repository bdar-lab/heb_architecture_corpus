# file = txt/2300157.txt
# filelineno = 887
# sentno = 1
# text = תהליך איחוד היישובים והרחבתם, אשר יביא, לרוב, להתיישבות של אוכלוסייה חדשה ביישובים, השונה מהאוכלוסייה הקיימת, מעורר את הצורך בשינוי המבנה הארגוני של הישובים ומציב סימני שאלה רבים באשר לאופן התפתחותם באשר לתושבים אשר ייקלטו ביישוב, הקשרים שייווצרו בין הוותיקים והחדשים, מתמודדים התמודדות על גידול בתושבים ועם תושבים בעלי מאפיינים ואינטרסים שונים, כיצד תושפע הפעילות החקלאית, כיצד יושפע סדר היום הציבורי ביישוב, מי יפעיל את מוסדות הציבור ומי יהיו בעליהם, ועוד.
