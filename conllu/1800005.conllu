# file = txt/1800005.txt
# filelineno = 182
# sentno = 2
# text = עם זאת, לפי החלטת ממשלה 3453 (המתקנת את החלטה 2080 מיום 15.7.2010), בעניין עידוד תעסוקת ישראלים ומכסות פועלים מחו"ל בענף הבניין, הואט קצב צמצום המכסה לבנייה, כך שהמכסה לא תעלה על 8,000 ותפחת בהדרגה: 5,000 פועלים מ-1 ביולי 2014 וכעבור שנה 2,000 בלבד.
