# file = txt/1800005.txt
# filelineno = 324
# sentno = 2
# text = הגידול בהיקף המימוש ב-2012 נובע בעיקר ממדיניות המשרד להקל על זכאים חסרי דירה ולעודד את המגורים ביישובי הפריפריה: הפחתת הריבית על הלוואות לדיור לזכאי המשרד ל-3% בלבד (לעומת 4%– 4.5% בעבר) למשך 25–28 שנה, הענקת הטבה לזכאי המשרד בסך של כ-100,000 ש"ח לזוגות צעירים ולרוכשי דירה ראשונה חדשה בפריפריה, ושמירה על מעמד עולה למשך 15 שנים במקום 10 שנים בעקבות המלצות ועדת טרכטנברג.
