# file = txt/1800008.txt
# filelineno = 259
# sentno = 1
# text = הגבייה הממשלתית העיקרית במסגרת מיסוי מקרקעין נעשית באמצעות מס רכישה שלגביו התקבלה בכנסת בתחילת חודש מאי 2013 החלטה על הארכת הוראת השעה, ולפיה יופחתו שיעורי מס הרכישה לרוכשי דירה יחידה ויועלו שיעורי מס הרכישה לרוכשי דירה נוספת ל-5%– 7% משווי הדירה.
