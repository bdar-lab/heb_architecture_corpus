# sentno = 1
# text = 1.2	בתחום המיסוי מדובר בעיקר בביטול פטורים ממס שבח שהיו בתוקף עד 5 במאי 2013 במסגרת הוראת שעה לעידוד היצע הדירות, וקידום החלטות חדשות, ובהן ביטול הפטור ממס שבח לדירת מגורים נוספת אחת לארבע שנים והטלת מס לינארי.
