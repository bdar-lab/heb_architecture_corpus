# file = txt/1500152.txt
# filelineno = 414
# sentno = 1
# text = תהליכי ההפרטה בקיבוצים המתחדשים, ובעיקר שיוך הדירות, וכן השינוי במבנה החברתי שבו משפחות ויחידים מתגוררים במעמד של תושבים, משפיעים בסופו של דבר על הפרטת המרחב המשותף בדרך של חלוקת אזורי המגורים למגרשי מגורים פרטיים והענקת זכויות במקרקעין, אם בחוזים ישירים מול המנהל ואם בהסכמים פנימיים מול הקיבוץ.
