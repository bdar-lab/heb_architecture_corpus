# file = txt/1500152.txt
# filelineno = 38
# sentno = 1
# text = במאמר הבוחן את יחסי הקיבוצים ומוסדות המדינה בעידן ההתחדשות (בן רפאל וחוב', 2011) מתאר המחבר מצב בו בהעדר גופים תנועתיים המייצגים את האינטרס הקיבוצי מול מוסדות המדינה, מתמודד כל קיבוץ ישירות מול רשויות כמו שלטונות המס, מנהל מקרקעי ישראל, משרד החינוך ומשרדים ממשלתיים אחרים.
