# file = txt/1500257.txt
# filelineno = 235
# sentno = 7
# text = התוכנית כוללת שני מגדלי מגורים (המגדל הראשון המאוכלס מונה כ-337 יח״ד), שני מגדלי משרדים וכ-14 בניינים נמוכים נוספים המשמשים ברובם למסחר, אחד מהם מתפקד כמרכז ספורט קהילתי, חלק מהשטחים בקומה השלישית בבנייני המגורים משמשות לטובת גני ילדים עירוניים אשר מחוברים בגשרונים אל קומת הגג של המבנים הנמוכים המשמשים כגינות, גני הילדים היו במסגרת "מטלות היזם".
