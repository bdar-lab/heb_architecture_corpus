# file = txt/1500257.txt
# filelineno = 236
# sentno = 1
# text = בראיון עם אור׳ גת, שותף במשרד משה צור אדריכלים, אשר מוביל את הפרויקט משנת 2011, הוצגו עקרונות התכנון הכוללים התייחסות ליצירת מרקם, נגישות מלאה להולכ׳ רגל ללא תנועה רכובה, יצירת הקשרים אורבניים, הכנסת אור יום למהלכי התנועה הוורטיקל״ם וגגות ירוקים.
