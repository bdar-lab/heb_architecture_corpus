# text = אולם השאלות אותן העלתה מחאת הדיור לדיון ציבורי החלו להופיע בשיח האדריכל׳ כעשור קודם לכן, למשל באמצעות התערוכה "יחידת המגורים" בגלריית בית האדריכל באוצרות שלי כהן, אשר לוותה באסופת מאמרים קצרה אשר דנה בפער בין הבית כמושג המשקף זהות אישית וייחודית, לבין המציאות של יחידות הדיור המשועתקות (כהן, 2001).
# raw = {'id': 2, 'text': 'אולם השאלות אותן העלתה מחאת הדיור לדיון ציבורי החלו להופיע בשיח האדריכל׳ כעשור קודם לכן, למשל באמצעות התערוכה "יחידת המגורים" בגלריית בית האדריכל באוצרות שלי כהן, אשר לוותה באסופת מאמרים קצרה אשר דנה בפער בין הבית כמושג המשקף זהות אישית וייחודית, לבין המציאות של יחידות הדיור המשועתקות (כהן, 2001).', 'dspan': (298, 596), 'tokens': [{'id': 1, 'text': 'אולם', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 13, 'deprel': 'cc', 'dspan': (298, 302), 'span': (0, 4), 'lemma': 'אולם'}, {'id': (2, 3), 'text': 'השאלות', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'שאלות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 13, 'deprel': 'nsubj', 'lemma': 'שאלה'}], 'span': (5, 11), 'dspan': (303, 309)}, {'id': (4, 5), 'text': 'אותן', 'expanded': [{'id': 4, 'text': 'אות', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'את'}, {'id': 5, 'text': 'ן', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Plur|Person=3|PronType=Prs', 'head': 6, 'deprel': 'obj', 'lemma': 'הוא'}], 'span': (12, 16), 'dspan': (310, 314)}, {'id': 6, 'text': 'העלתה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=HIFIL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 3, 'deprel': 'acl:relcl', 'dspan': (315, 320), 'span': (17, 22), 'lemma': 'העלה'}, {'id': 7, 'text': 'מחאת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'nsubj', 'dspan': (321, 325), 'span': (23, 27), 'lemma': 'מחאת'}, {'id': (8, 9), 'text': 'הדיור', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'דיור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'compound', 'lemma': 'דיור'}], 'span': (28, 33), 'dspan': (326, 331)}, {'