# file = txt/1500257.txt
# filelineno = 123
# sentno = 4
# text = את יציר הכלאיים החדש של שכונת המגורים הישראלית מעצבות פעולות אוטומטיות, פעולות אלו לא מיוחסות רק לרוח הזמן ולשליטה של מכונות ותוכנות על ח״נו ופועלם (למרות שפרק נרחב בספר עוסק בזה), לא פחות מכך הן מיוחסת להחלטות היסטוריות הנובעות מהנרטיב הישראלי שקרא לפירבור המרחב, לשליטה טרטורית בכל חבלי הארץ ושימוש בכלי ההתיישבות ככלי להוכחת החזקה (ברנד ושלום, 2014).
