# text = דמויות מפתח כפיטר בהרנס, וולטר גרופיוס, אלבר אאלטו, פרנק לויד ר״ט ולה קורבוזיה עסקו בתכנון המרחב כולו, מהעיר ועד פריטי ריהוט, הנדסה ונוף, מתוך תפיסה הוליסטית של המלאכה כאמצעי לשחרור חברתי ושל המרחב עצמו כרצף רעיוני של קני מידה שלאדריכל יש אחריות לעיצובו (ויטפורד,1984, 2012 ,Cohen ,1960 ,Pevsner).
# raw = {'id': 2, 'text': 'דמויות מפתח כפיטר בהרנס, וולטר גרופיוס, אלבר אאלטו, פרנק לויד ר״ט ולה קורבוזיה עסקו בתכנון המרחב כולו, מהעיר ועד פריטי ריהוט, הנדסה ונוף, מתוך תפיסה הוליסטית של המלאכה כאמצעי לשחרור חברתי ושל המרחב עצמו כרצף רעיוני של קני מידה שלאדריכל יש אחריות לעיצובו (ויטפורד,1984, 2012 ,Cohen ,1960 ,Pevsner).', 'dspan': (75, 372), 'tokens': [{'id': 1, 'text': 'דמויות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 18, 'deprel': 'nsubj', 'dspan': (75, 81), 'span': (0, 6), 'lemma': 'דמות'}, {'id': 2, 'text': 'מפתח', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'compound', 'dspan': (82, 86), 'span': (7, 11), 'lemma': 'מפתח'}, {'id': (3, 4), 'text': 'כפיטר', 'expanded': [{'id': 3, 'text': 'כ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'כ'}, {'id': 4, 'text': 'פיטר', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'nmod', 'lemma': 'פיטר'}], 'span': (12, 17), 'dspan': (87, 92)}, {'id': 5, 'text': 'בהרנס', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 4, 'deprel': 'flat', 'dspan': (93, 98), 'span': (18, 23), 'lemma': 'בהרנס'}, {'id': 6, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 7, 'deprel': 'punct', 'dspan': (98, 99), 'span': (23, 24), 'lemma': ','}, {'id': 7, 'text': 'וולטר', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 4, 'deprel': 'conj', 'dspan': (100, 105), 'span': (25, 30), 'lemma': 'וולטר'}, {'id': 8, 'text': 'גרופיוס', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 7, 'deprel': 'flat', 'dspan': (106, 113), 'span': (31, 38), 'lemma': 'גרופיוס'}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 10, 'deprel': 'punct', 'dspan': (113, 114), 'span': (38, 39), 'lemma': ','}, {'id': 10, 'text': 'אלבר', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 4, 'deprel': 'conj', 'dspan': (115, 119), 'span': (40, 44), 'lemma': 'אלבר'}, {'id': 11, 'text': 'אאלטו', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 10, 'deprel': 'flat', 'dspan': (120,