# file = txt/1500156.txt
# filelineno = 213
# sentno = 1
# text = גם מחקרם של1999) Weinstein & Clower) העלה ממצאים שונים, לגבי מידת ההשפעה של הרכבת הקלה בדאלאס (10DART) על פרמטרים מרכזיים - שינוי בשיעור התפוסה והשינוי בגובה דמי השכירות - לגבי נכסים מסחר שונים : מסחר קהילתי, מוסדות מסחר שכונתיים (חנויות נוחות, שירותים אישיים וסופר-מרקטים), קניון אזורי ומסחר לאורך הרחוב הראשי.
