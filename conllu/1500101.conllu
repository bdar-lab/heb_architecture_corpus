# file = txt/1500101.txt
# filelineno = 158
# sentno = 6
# text = יחסי המחקר המדעי למחשבה חברתית ואתיקה מנוסחים על ידי הורקה״מר בחיבורו "תיאוריה מסורתית ותיאוריה ביקורתית", בו הוא מבסס את ההנחה כ׳ מתחיב קשר בין המדעים המסורתיים לבין מחשבה ביקורתית הנותנת את הדעת על השלכותיו של המחקר המדעי ואינה נופלת ממנו בחשיבותה (אדורנו 1 הורקה״מר 2003).
