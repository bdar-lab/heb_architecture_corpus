# file = txt/1500101.txt
# filelineno = 69
# sentno = 6
# text = הקשר בין תנאים טכנולוגיים לבין ח״ם סימבוליים, שאפיין את כל השינויים הטכנולוגיים משחר התרבות (עידן האבן, הברונזה, המצאת הדפוס וכוי), מקבל משמעות עצומה בשל היקפו הן מבחינת מידת היקף השינוי שנעשה בכל תחומי החיים, הן מבחינת פרק הזמן הקצר יחסית בו שינוי זה נעשה, והן בשל התפשטותו ברחבי העולם כחלק מיכולת הניידות הגוברת באותה תקופה (פוסטמן 2003).
