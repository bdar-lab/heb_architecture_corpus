# file = txt/1500101.txt
# filelineno = 291
# sentno = 5
# text = תפקיד המעצב נע בין מילוי צרכים שונים (לעיתים סותרים ולעיתים הופפים), בהם הוא מתווך בין האדם לסביבתו החומרית כמעין ממציא, מהנדס, אמן, מנתה ומיעל תהליכים ומערכות מורכבות, משפר הוויות שימוש, מונע תאונות, מנתה הברתי, יוצר אובייקטים סימבוליים וכדומה (Klooster2009).
