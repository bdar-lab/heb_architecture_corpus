# file = txt/1500101.txt
# filelineno = 170
# sentno = 3
# text = יחסי גומלין בין טכנולוגיה לעיצוב אשר התרחשו במהלך שתי המהפכות הטכנולוגיות הקודמות מבססים את ההנחה כ׳ ההיבטים המערכתיים של השיטות הננוטכנולוגיות כמו הרכבה ותיקון עצמיים, "מלמטה למעלה", שינו" תכונות החומר בקנה מידה ננומטר׳, פיתוח חומרים חדשים, חיקוי תופעות טבע וכדומה - ישפיעו על פעולת העיצוב ויחוללו תמורות בין טכנולוגיה לעיצוב בכלל ובין ננוטכנולוגיה לעיצוב בפרט.
