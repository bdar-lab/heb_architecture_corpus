# text = תכנון השכונה הניסיונית השתייך למגמה רחבה יותר של ניסיונות לשיפור תנאי המגורים של המהגרים בפריפריה, וליצירת סדר ואיכות בעיצוב ותכנון מגורים המוניים שלרוב סבלו מתנאים ירודים (סלייפר, 1992) ולקדם את מיזוג הגלויות בשכונות השיכון הציבורי בפריפריה (שדר, 2014).
# raw = {'id': 1, 'text': 'תכנון השכונה הניסיונית השתייך למגמה רחבה יותר של ניסיונות לשיפור תנאי המגורים של המהגרים בפריפריה, וליצירת סדר ואיכות בעיצוב ותכנון מגורים המוניים שלרוב סבלו מתנאים ירודים (סלייפר, 1992) ולקדם את מיזוג הגלויות בשכונות השיכון הציבורי בפריפריה (שדר, 2014).', 'dspan': (0, 254), 'tokens': [{'id': 1, 'text': 'תכנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'nsubj', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'תכנון'}, {'id': (2, 3), 'text': 'השכונה', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'שכונה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'compound:smixut', 'lemma': 'שכונה'}], 'span': (6, 12), 'dspan': (6, 12)}, {'id': (4, 5), 'text': 'הניסיונית', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'ניסיונית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'amod', 'lemma': 'ניסיונית'}], 'span': (13, 22), 'dspan': (13, 22)}, {'id': 6, 'text': 'השתייך', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HITPAEL|Number=Sing|Person=3|Tense=Past', 'head': 0, 'deprel': 'root', 'dspan': (23, 29), 'span': (23, 29), 'lemma': 'השתייך'}, {'id': (7, 9), 'text': 'למגמה', 'expanded': [{'id': 7, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ל'}, {'id': 8, 'text': 'ה_', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'מגמה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'obl', 'lemma': 'מגמה'}], 'span': (30, 35), 'dspan': (30, 35)}, {'id': 10, 'text': 'רחבה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 9, 'deprel': 'amod', 