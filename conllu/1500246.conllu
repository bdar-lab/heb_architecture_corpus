# file = txt/1500246.txt
# filelineno = 259
# sentno = 1
# text = תכנון השכונה הניסיונית בקרית גת היה חלק מניסיון כולל לתת מענה לבעיות אשר זוהו בסביבות המגורים בפריפריה, על ידי הכנסת סדר ואיכות לפס הייצור של יחידות המגורים למהגרים בשיכון הציבורי, אשר סבלו מתנאים ירודים ואי סדר כללי (סלייפר, 1992).
