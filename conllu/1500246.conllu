# file = txt/1500246.txt
# filelineno = 370
# sentno = 5
# text = פעולות גלויות ונצפות אלו מצביעות על מערכת יחסי הגומלין של אינדבידואלים וקהילות עם הסביבה הפיזית והחברתית שלהם; בחינה של תחושת המקום במרחב הביתי יכולה לעזור בהבנת המרחב השכונתי, על ידי יצירת מסגרת שבה נסיבות חברתיות, פסיכולוגיות, כלכליות-פוליטיות וסביבתיות מתגלמות באינטראקציות שבין האדם לסביבתו (2012 ,Aziz & Ahmed).
