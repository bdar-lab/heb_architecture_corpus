# file = txt/1500246.txt
# filelineno = 74
# sentno = 4
# text = דרך קריאה ביקורתית של רפורמות בחוק התכנון והבנייה מאז שנות ה-90 שמהותן הייתה חלוקה מחדש של זכויות קרקעיות- הפרטה של זכויות בקרקע והלאמה של זכויות התכנון- והכפפת הניהול הקרקעי להגיון כלכלי; ובאמצעות ניתוח ביקורתי של תוכניות המתאר הלאומיות 31 ו-35, אשר מיסדו בחוק את זכויות היתר ליזמים המשתפים פעולה עם רשויות מקומיות, המשיכו את מסורת ההתיישבות שעיקרה ייהוד המרחב והגבילו את התרחבות ההתיישבות הפלסטינית; מראים יעקובי וצפדיה כי הרפורמות השונות מעוגנות בהיגיון הקולוניאליזם ההתיישבותי, והאחרון מנחה את הקצאת המשאבים הלאומיים בהתאם.
