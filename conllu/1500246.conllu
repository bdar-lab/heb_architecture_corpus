# text = לאחר מכן, בשנת 1987 יזמה עיריית קרית גת את תכנית 9/ 02/ 101/ 16 (בתכנון אדריכל אלי פירשט) אשר קבעה הוראות לבניית צמודי קרקע ברובע הדרום מזרחי, ובשנת 1993 יזמו עיריית קריית גת וממ״י את תכנית 9/ במ/ 124 אשר הסדירה את המגרשים ברובע זה, עבור שיווקם כמגרשים לבנייה עצמית.
# raw = {'id': 3, 'text': 'לאחר מכן, בשנת 1987 יזמה עיריית קרית גת את תכנית 9/ 02/ 101/ 16 (בתכנון אדריכל אלי פירשט) אשר קבעה הוראות לבניית צמודי קרקע ברובע הדרום מזרחי, ובשנת 1993 יזמו עיריית קריית גת וממ״י את תכנית 9/ במ/ 124 אשר הסדירה את המגרשים ברובע זה, עבור שיווקם כמגרשים לבנייה עצמית.', 'dspan': (373, 639), 'tokens': [{'id': 1, 'text': 'לאחר', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'dspan': (373, 377), 'span': (0, 4), 'lemma': 'לאחר'}, {'id': (2, 3), 'text': 'מכן', 'expanded': [{'id': 2, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'lemma': 'מ'}, {'id': 3, 'text': 'כן', 'upos': 'ADV', 'xpos': 'ADV', 'head': 8, 'deprel': 'advmod', 'lemma': 'כן'}], 'span': (5, 8), 'dspan': (378, 381)}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 8, 'deprel': 'punct', 'dspan': (381, 382), 'span': (8, 9), 'lemma': ','}, {'id': (5, 6), 'text': 'בשנת', 'expanded': [{'id': 5, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ב'}, {'id': 6, 'text': 'שנת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'obl', 'lemma': 'שנה'}], 'span': (10, 14), 'dspan': (383, 387)}, {'id': 7, 'text': '1987', 'upos': 'NUM', 'xpos': 'NUM', 'head': 6, 'deprel': 'compound:smixut', 'dspan': (388, 392), 'span': (15, 19), 'lemma': '1987'}, {'id': 8, 'text': 'יזמה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PAAL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (393, 397), 'span': (20, 24), 'lemma': 'יזם'}, {'id': 9, 'text': 'עיריית', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'nsubj', 'dspan': (398, 404), 'span': (25, 31), 'lemma': 'עירייה'}, {'id': 10, 'text': 'קרית', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 9, 'deprel': 'compound:smixut', 'dspan': (405, 409), 'span': (32, 36), 'lemma': 'קריה'}, {