# file = txt/1500246.txt
# filelineno = 494
# sentno = 2
# text = בדומה לדיירים אשר מייצרים בדירותיהם מרחבים של מודרניות אלטרנטיבית באמצעות פעולות המבטלות או משנות את חזון המודרניות בתרגומו הפיזי (שדר ויעקובי, 2014), דיירי הטונל מייצרים מרחב של קהילתיות אלטרנטיבית, על ידי חתירה תחת חזון הדרך השכונתית המדומיינת ויצירת מרחב פרטי, שגם אם אינו שוקק חיים, הרי שהוא מנוכס על ידם ובו הם רשאים לעשות ככל העולה על רוחם.
