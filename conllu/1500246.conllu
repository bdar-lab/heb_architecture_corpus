# text = בהתאמה, הדיון באיכויות האדריכליות בשתי הדוגמאות מתמקד במרחב הציבורי אשר ממלא מספר תפקידים במערכת הבניינית: תנועה אנכית, מרחבי כניסה ליחידות הדיור, סירקולציה וקישור לחלקי מבנה אחרים ולשכונה (שדר, 2014, עמ 88) ; סירקולציה שכונתית ותת שכונתית, חללי משחק, מרחבי כניסה ליחידות הדיור ושטחי חוץ שירותיים של יחידות הדיור בשכונת גליקסון (מרנס 2017, ראיון).
# raw = {'id': 2, 'text': 'בהתאמה, הדיון באיכויות האדריכליות בשתי הדוגמאות מתמקד במרחב הציבורי אשר ממלא מספר תפקידים במערכת הבניינית: תנועה אנכית, מרחבי כניסה ליחידות הדיור, סירקולציה וקישור לחלקי מבנה אחרים ולשכונה (שדר, 2014, עמ 88) ; סירקולציה שכונתית ותת שכונתית, חללי משחק, מרחבי כניסה ליחידות הדיור ושטחי חוץ שירותיים של יחידות הדיור בשכונת גליקסון (מרנס 2017, ראיון).', 'dspan': (22, 369), 'tokens': [{'id': (1, 2), 'text': 'בהתאמה', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'התאמה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 14, 'deprel': 'obl', 'lemma': 'התאמה'}], 'span': (0, 6), 'dspan': (22, 28)}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (28, 29), 'span': (6, 7), 'lemma': ','}, {'id': (4, 5), 'text': 'הדיון', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'דיון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 14, 'deprel': 'nsubj', 'lemma': 'דיון'}], 'span': (8, 13), 'dspan': (30, 35)}, {'id': (6, 7), 'text': 'באיכויות', 'expanded': [{'id': 6, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'case', 'lemma': 'ב'}, {'id': 7, 'text': 'איכויות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 5, 'deprel': 'nmod', 'lemma': 'איכות'}], 'span': (14, 22), 'dspan': (36, 44)}, {'id': (8, 9), 'text': 'האדריכליות', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'אדריכליות', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Plur', 'head': 7, 'deprel': 'amod', 'lemma': 'אדריכליות'}], 'span': (23, 33), 'dspan': (45, 55)}, {'id': (10, 11), 'text': 'בשתי', 'ex