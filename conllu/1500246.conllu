# text = גוף הידע הביקורתי אודות הקשר בין מדיניות הדיור הלאומית בישראל לבין חיי היומיום של הדיירים נחלק לשני זרמים: מחד, ספרות מחקרית הבוחנת, באמצעות ניתוח שיח ביקורתי, את המטרות שהנחו את דפוסי ההתיישבות במהלך תקופות השיכון השונות, ואת השלכותיהן הסוציולוגיות והגאו-פוליטיות, כגון: ריבוד חברתי , הבניית זהויות, יחסי עדות, פערים בין פריפריה למרכז, והתפלגות אתנית של האוכלוסייה (יזהר, 2016 ; יפתחאל וצפדיה, 2000 ; לו-יון וקלוש, 1994 ; קלוש ולו יון, 2000 ; ,Tzfadia 2000,2006) .
# raw = {'id': 1, 'text': 'גוף הידע הביקורתי אודות הקשר בין מדיניות הדיור הלאומית בישראל לבין חיי היומיום של הדיירים נחלק לשני זרמים: מחד, ספרות מחקרית הבוחנת, באמצעות ניתוח שיח ביקורתי, את המטרות שהנחו את דפוסי ההתיישבות במהלך תקופות השיכון השונות, ואת השלכותיהן הסוציולוגיות והגאו-פוליטיות, כגון: ריבוד חברתי , הבניית זהויות, יחסי עדות, פערים בין פריפריה למרכז, והתפלגות אתנית של האוכלוסייה (יזהר, 2016 ; יפתחאל וצפדיה, 2000 ; לו-יון וקלוש, 1994 ; קלוש ולו יון, 2000 ; ,Tzfadia 2000,2006) .', 'dspan': (0, 465), 'tokens': [{'id': 1, 'text': 'גוף', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 24, 'deprel': 'nsubj', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'גוף'}, {'id': (2, 3), 'text': 'הידע', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'ידע', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'compound:smixut', 'lemma': 'ידע'}], 'span': (4, 8), 'dspan': (4, 8)}, {'id': (4, 5), 'text': 'הביקורתי', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'ביקורתי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'amod', 'lemma': 'ביקורתי'}], 'span': (9, 17), 'dspan': (9, 17)}, {'id': 6, 'text': 'אודות', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'dspan': (18, 23), 'span': (18, 23), 'lemma': 'אודות'}, {'id': (7, 8), 'text': 'הקשר', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'קשר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'nmod', 'lemma': 'קשר'}], 'span': (24, 28), 'dspan': (24, 28)}, {'id': 9, 'text': 'בין', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'ds