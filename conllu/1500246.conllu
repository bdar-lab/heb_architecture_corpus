# file = txt/1500246.txt
# filelineno = 606
# sentno = 2
# text = בנוסף, צילה ויוסף מאירים בכעסם את הכשלון של תכניות מדיניות שונות לייצר שינוי והתחדשות במרחב העירוני: מבנה ביתך, אשר היוותה אתר להגירה פנימית בתוך השכונה לתושבים בעלי היכולת, ובכך קיבעה את מעמדה כשכונת מהגרים ענייה, דרך שיקום שכונות אשר מתוארת על ידי צאלה כפרקטיקה קוסמטית לשיפור פני העיר, ועד למדיניות התחדשות עירונית אשר נסמכת על פעילות השוק החופשי ולא מייצרת פתרונות התחדשות עבור אתרים "לא כלכליים".
