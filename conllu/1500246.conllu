# file = txt/1500246.txt
# filelineno = 264
# sentno = 2
# text = שלא בדומה לתכנית שרון, אשר הנחתה את תכנונן של סביבות מגורים הומוגניות וחזרתיות (סלייפר, 1992; סטופ ראיון, 2016), השכונה האינטגרטיבית תוכננה להכיל מגוון רחב של טיפוסי דיור וטיפולוגיות בינוי, איזורים מתוכננים עבור פעילויות קהילתיות (בשונה משטחים פתוחים וריקים מפעילות) ושירותים ציבוריים מחושבים.
