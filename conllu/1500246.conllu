# file = txt/1500246.txt
# filelineno = 570
# sentno = 8
# text = פגיעה זו בזכותם לעיר הנוצרת היא פועל יוצא של תוכניות בקנה מידה לאומי, אשר עוקפות את מסלולי התכנון העירוניים שנועדו להבטיח את זכויות התושבים בעירם, ומייצרות נתיב ישיר לתכנון וביצוע שמשפיע באופן בלתי הפיך ואקוטי על חיי היומיום של תושבי העיר הקיימת (דומיניץ, 2019).
