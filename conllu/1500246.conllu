# file = txt/1500246.txt
# filelineno = 152
# sentno = 4
# text = פעולת הניתוח הנרטיבי היא שלב ארוך של פרשנות ועיון במאמץ לגלות מה הנושאים והתבניות בסיפור שמספר המרואיין, וכיצד אפשר לשפוך אור באמצעות הניתוח על שאלת המחקר ממנה יצא החוקר לדרכו (ג׳וסלסון ,2015, עמי 30).
