# file = txt/1500246.txt
# filelineno = 365
# sentno = 1
# text = העיסוק המחקרי במושג ׳מקום׳ צבר תאוצה בשנות ה-70, בתקופה בה הגיאוגרפיה השתנתה משדה מדעי הבוחן את המרחב כישות מוחלטת ואובייקטיבית בכלים מדעיים, למה שמכונה גיאוגרפיה הומניסטית, אשר מעמידה את האישי, הסובייקטיבי והחד פעמי במוקד המחקר הבוחן את היחסים שבין האדם לסביבתו (פורטוגלי, 2000).
