# sentno = 3
# text = דיון זה מראה כי על אף שהתקיימו מחקרים אשר ניסו לבסס מסקנות וידע בהסתמך על ידע סובייקטיבי של הדיירים באמצעות שאלונים (סלייפר וסטופ, 1977 ; סלייפר וסטופ, 1978 ; שובל, 1966 ; 1978 ,Ginsberg & Marans), מחקרים אלו כשלו בחשיפת המידע האישי והייחודי של הדיירים, תפיסותיהם, גישותיהם ועמדותיהם.
