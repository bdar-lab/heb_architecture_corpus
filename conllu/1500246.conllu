# file = txt/1500246.txt
# filelineno = 235
# sentno = 5
# text = כרמון (1998) מצביעה על שינוים בדפוסי המעורבות הממשלתית בשוק הדיור בין השנים 1965-1978, כאשר הסטת המיקוד מהשגת מטרות לאומיות באמצעות דיור למאמצים לקידום רמת החיים הביאה לירידה במעורבות הישירה באספקת הדיור (שם, עמי 1).
