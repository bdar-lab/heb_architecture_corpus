# file = txt/1500246.txt
# filelineno = 573
# sentno = 4
# text = בהמשך לקו זה, ברצוני לטעון כי הוד״ל והותמ״ל כזרוע מדינית, שמטרתה המוצהרת הינה ייצור מאסיבי של מלאי יח״ד לאומי, משעתקת את מצבם העגום של תושבי שכונת גליקסון ומונעת את מימוש זכותם לעיר, על ידי הפניית משאבים עירוניים למימוש התוכניות החדשות (כרמי גת שהיא תכנית וד״לית, וקריית גת מערב- תמ״ל 1011) והזנחת השכונות הוותיקות, כפי שעולה מסיפורם של צילה ויוסף.
