# file = txt/1500246.txt
# filelineno = 51
# sentno = 4
# text = הימנעות המדינה ממעורבות בשוק הדיור בעשור זה גובה מחיר בכמה רבדים: פגיעה בחזון התכנוני של המדינה, אשר גולם בתמ״א 35 ; הגברת הקיטוב בין מרכז לפריפריה; ועליית מחירים ואינפלציה כבדה, אשר הביאו להתמרמרות ציבורית רחבה שהגיעה לשיאה במחאה של קיץ 2011 (בן־שטרית, 2014).
