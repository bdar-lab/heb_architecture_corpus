# text = מטרות המנהלת, כפי שהוגדרו בהצגה לפני חברי מועצת העיר בשנת 2005 הן: הקניית בטחון אישי לתושבי האזור; שיפור הנגישות של התושבים למשאבים קיימים; שיפור פיזי של פני המתחם ורמת המגורים; גישור וגיבוש תושבי האזור לכלל קהילה; תמיכה וקידום הדור הצעיר באזור; תמיכה באוכלוסיה הקשישה באזור; קידום בריאות הציבור; שינוי הדימוי ע״י העלאת רמת השירות ואיכות החיים כדי למשוך אנשים חדשים; שינוי חוסר האמון המוחלט של התושבים בממסד (ראיון עם ברודר 2005).
# raw = {'id': 3, 'text': 'מטרות המנהלת, כפי שהוגדרו בהצגה לפני חברי מועצת העיר בשנת 2005 הן: הקניית בטחון אישי לתושבי האזור; שיפור הנגישות של התושבים למשאבים קיימים; שיפור פיזי של פני המתחם ורמת המגורים; גישור וגיבוש תושבי האזור לכלל קהילה; תמיכה וקידום הדור הצעיר באזור; תמיכה באוכלוסיה הקשישה באזור; קידום בריאות הציבור; שינוי הדימוי ע״י העלאת רמת השירות ואיכות החיים כדי למשוך אנשים חדשים; שינוי חוסר האמון המוחלט של התושבים בממסד (ראיון עם ברודר 2005).', 'dspan': (211, 641), 'tokens': [{'id': 1, 'text': 'מטרות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 20, 'deprel': 'nsubj', 'dspan': (211, 216), 'span': (0, 5), 'lemma': 'מטרה'}, {'id': (2, 3), 'text': 'המנהלת', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'מנהלת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'compound', 'lemma': 'מנהל'}], 'span': (6, 12), 'dspan': (217, 223)}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 7, 'deprel': 'punct', 'dspan': (223, 224), 'span': (12, 13), 'lemma': ','}, {'id': 5, 'text': 'כפי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 7, 'deprel': 'mark', 'dspan': (225, 228), 'span': (14, 17), 'lemma': 'כפי'}, {'id': (6, 7), 'text': 'שהוגדרו', 'expanded': [{'id': 6, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 5, 'deprel': 'fixed', 'lemma': 'ש'}, {'id': 7, 'text': 'הוגדרו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=HUFAL|Number=Plur|Person=3|Tense=Past|Voice=Pass', 'head': 20, 'deprel': 'advcl', 'lemma': 'הוגדר'}], 'span': (18, 25), 'dspan': (229, 236)}, {'id': (8, 9), 'text': 'בהצגה', 'expanded': [{'id': 8, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ב'}, {'id': 9, 'text': 'הצגה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'obl', 'lemma': 'הצגה'}], 