# file = txt/1500033.txt
# filelineno = 391
# sentno = 3
# text = את תחנות הכוח ומבנים אחרים של חברת החשמל תכננו האדריכלים הבולטים ביותר שהיו קשורים לאדריכלות הארצישראלית של אותה תקופה, ביניהם אלכסנדר ברוולד, יוסף ברלין, ריכארד קאופמן, ס' אדוארד רוזנהק, קליפורד הולידיי, אריך מנדלסון ובנימין אוראל (איור 2.3.7.4.).
