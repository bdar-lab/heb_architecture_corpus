# file = txt/1500133.txt
# filelineno = 39
# sentno = 1
# text = בעבודה זו יודגם כיצד באמצעות השילוב בין השיטות המשמשות למחקר, תיעוד ואפיון מתחום המורשת התעשייתית ומתחום דרך התרבות ניתן ליצור שיטת עבודה מובנית, המותאמת לקו רכבת היסטורי, ובאמצעותה ניתן לגבש עבורו מדיניות שימור מושכלת וכוללנית, המבוססת על מערך של קריטריונים אחידים ומביאה בחשבון את מכלול הנושאים והמשמעויות המרכיבים את הקו.
