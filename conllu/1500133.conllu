# file = txt/1500133.txt
# filelineno = 620
# sentno = 1
# text = השימוש בסטנדרטיזציה לאורך קו הרכבת חושף את הפרמטרים הרבים שנלקחו בחשבון ונדונו בתהליך גיבוש קבוצת המבנים הסטנדרטיים הנבחרים: שיקולים של התאמה לאקלים ולחומרי הגלם המקומיים, עלות בנייה, התאמה למערכת חשמל אחידה, נוחות ועלות תחזוקה, עמידות להצתות5 ושיקולים של אסתטיקה ותדמית.
