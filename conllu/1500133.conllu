# file = txt/1500133.txt
# filelineno = 134
# sentno = 3
# text = למרות שכבר היו קיימים אתרי מורשת עולמית שהכילו בתוכם אלמנטים רכבתיים (כמו ה-Ironbridge Georg באנגליה, שהוכרז ב-1986, וכולל אזור תעשייתי שלם ובו בין היתר מכרות פחם וקווי רכבת המקשרים ביניהם), הייתה זאת הפעם הראשונה שקו רכבת עמד כאתר מורשת עולמית בפני עצמו, בהתאמה למסקנות הדו“ח: ”קווי הרכבת נהנים מזהות מובהקת מספיק כסוג של מערכת טכנולוגית-חברתית על מנת שיהיו ראויים להכרזה בזכות עצמם.
