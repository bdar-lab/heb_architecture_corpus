# file = txt/1500133.txt
# filelineno = 286
# sentno = 1
# text = בנוסף מדגישה החברה את המייצג האור-קולי בתחנת החשמל בנהריים, אשר נבנה ביחד עם קיבוץ גשר, ומספר את סיפורה של תחנת-הכוח ההידרו-אלקטרית, אשר הוקמה בשנים 1927-1932, ותרמה למשק ייצור החשמל בארץ־ישראל עד ערב פרוץ מלחמת העצמאות.
