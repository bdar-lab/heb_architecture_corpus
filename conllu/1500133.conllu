# file = txt/1500133.txt
# filelineno = 48
# sentno = 1
# text = יש להדגיש, כפי שיודגם בעבודה, כי במרבית המקרים קו רכבת היסטורי לא מהווה דרך תרבות, אך בשל המבנה המרחבי הייחודי של דרך התרבות ומורכבות הטיפול בה פותחו והוצעו לגביה שיטות עבודה אותן ניתן ליישם, ולו באופן חלקי, גם על קו רכבת היסטורי.
