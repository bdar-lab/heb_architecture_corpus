# file = txt/2300108.txt
# filelineno = 56
# sentno = 6
# text = בתאריך 24/2/05 התאשרה תכנית המתאר ג/11787 שהכפילה את השטח ל־480 דונם ומטרותיה הן: הכנת תכנית לכלל הישוב כולל שטח להרחבה קהילתית ולאזור תיירותי, קביעת ייעודי קרקע לאזורי מגורים ב ו־ג (מגורים בצפיפות שונה), שצ״פ, דרכים, מבני משק ותיירות על חשבון שטחים חקלאים וקביעת זכויות ומגבלות בניה.
