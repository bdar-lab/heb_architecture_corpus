# file = txt/2300108.txt
# filelineno = 918
# sentno = 1
# text = בהנחה שתכנית השכונה המעורבת שלפים תאושר ע״י מוסדות התכנון, ויחלו פעולות הכשרת הקרקע להקמתה בפועל, ייתכנו מספר תרחישים אפשריים אשר יכריעו את גורל השכונה ואת יחסי הגומלין בינה ובין הקיבוצים רשפים ושלוחות, אליהם היא משוייכת, כאשר לכל אחד מהם השפעה על המאזן היישובי במקום, וניתן לבחון כל אחד מהם על פי פרמטר פיסי, מוניציפאלי, תפקודי (פרוגרמתי), דמוגרפי וחברתי - קהילתי.
