# file = txt/2300108.txt
# filelineno = 854
# sentno = 1
# text = התכניות התקפות בקיבוץ שלוחות הינן תכנית ג/6612 משנת 1994 (נערכה ע״י חברת א.ב. תכנון), אשר תוחמת את שטח הפיתוח של קיבוץ שלוחות, קובעת ייעודים, אזורים והוראות פיתוח, וכן מהווה את התכנית המפורטת מכוחה ניתנים היתרי בנייה, ומש״צ/52 שמטרתה רישום אדמות קיבוץ שלוחות והסביבה בספרי המקרקעין של מדינת ישראל.
