# text = באירופה, מקום התפתחות התעשייה, רוב המפעלים נבנו ליד האוקיינוס או ליד הנהרות, וכיוון שגבס מסיס מעט במים, ניתן היה להטמין את הפוספוגבס בנהרות ללא בעיות של הצטברות וחסימת ערוצי תעבורה, וכן ניתן היה להשליך את החומר לאוקיינוס שבו המסיסות גבוהה יותר.
# raw = {'id': 2, 'text': 'באירופה, מקום התפתחות התעשייה, רוב המפעלים נבנו ליד האוקיינוס או ליד הנהרות, וכיוון שגבס מסיס מעט במים, ניתן היה להטמין את הפוספוגבס בנהרות ללא בעיות של הצטברות וחסימת ערוצי תעבורה, וכן ניתן היה להשליך את החומר לאוקיינוס שבו המסיסות גבוהה יותר.', 'dspan': (234, 478), 'tokens': [{'id': (1, 2), 'text': 'באירופה', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'אירופה', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 12, 'deprel': 'obl', 'lemma': 'אירופה'}], 'span': (0, 7), 'dspan': (234, 241)}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (241, 242), 'span': (7, 8), 'lemma': ','}, {'id': 4, 'text': 'מקום', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'appos', 'dspan': (243, 247), 'span': (9, 13), 'lemma': 'מקום'}, {'id': 5, 'text': 'התפתחות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'compound:smixut', 'dspan': (248, 255), 'span': (14, 21), 'lemma': 'התפתחות'}, {'id': (6, 7), 'text': 'התעשייה', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'תעשייה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'compound:smixut', 'lemma': 'תעשייה'}], 'span': (22, 29), 'dspan': (256, 263)}, {'id': 8, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 12, 'deprel': 'punct', 'dspan': (263, 264), 'span': (29, 30), 'lemma': ','}, {'id': 9, 'text': 'רוב', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Cons', 'head': 11, 'deprel': 'det', 'dspan': (265, 268), 'span': (31, 34), 'lemma': 'רוב'}, {'id': (10, 11), 'text': 'המפעלים', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 11, 'deprel': 'det', 'lemma': 'ה'}, {'id': 11, 't