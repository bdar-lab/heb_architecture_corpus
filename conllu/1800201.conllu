# file = txt/1800201.txt
# filelineno = 521
# sentno = 2
# text = בתאריך 15.04.2007 התקבלה החלטת ממשלה מס' 1578, שקבעה "להטיל על משרד הבינוי והשיכון, בשיתוף עם משרד הפנים ומשרד המשנה לראש הממשלה, לבצע עבודת מטה מקצועית, בשיתוף של כל הגורמים המקצועיים הנוגעים בדבר... וזאת לצורך גיבוש תוכנית להקמת יישוב חדש עבור אוכלוסייה בעלת צביון דתי על צומת דרכים כביש מספר 80 וכביש מספר 31.
