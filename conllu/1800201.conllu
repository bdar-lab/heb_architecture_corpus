# file = txt/1800201.txt
# filelineno = 629
# sentno = 1
# text = •	ישנו קושי להעריך האם תמומשנה יח״ד בשכונות החדשות עליהן דובר שתעבורנה תכנון מחדש בעבור המגזר החרדי, ואם תמומשנה, האם תגענה בפועל לחרדים לאור הביקוש באזור המרכז ויכולתה המוגבלת של המדינה לייעד שיורקים.
