# file = txt/2800083.txt
# filelineno = 200
# sentno = 1
# text = מחוז הדרום במשרד הפנים, עם אדריכל בץ ז״ל ועם מר ורדימון הממונה על המחוז וסגנו מר אליהו שפירא, יבדלו לחיים ארוכים; עם אנשי היחידה לסיוע לאזורי פיתוח במשרד התמ״ת - מר ראובן דוד, ואחר כך עם מר אהרון לפידות; עם אנשי היחידה לבינוי במשרד הבטחון - עוזי גדור, ואחר-כך עם סא״ל דן סתיו ועם עוד רבים אחרים.
