# text = ההיקף הגדול יותר והגוון הרב יותר של תעשיה בערד ובדימונה לעומת ירוחם, נותנים להם עצמה כלכלית רבה יותר וכח משיכה רב יותר, ומדביקים על ירוחם תוית נוספת של נחיתות: וכי מדוע ילכו מפעלי תעשיה נוספים או כח אדם תעשייתי, שבאים לנגב - לירוחם ולא לדימונה וערד, כאשר באלה האחרונים קיימת כבר תשתית תעשיתית הרבה יותר מפותחת ומגווונת?
# raw = {'id': 1, 'text': 'ההיקף הגדול יותר והגוון הרב יותר של תעשיה בערד ובדימונה לעומת ירוחם, נותנים להם עצמה כלכלית רבה יותר וכח משיכה רב יותר, ומדביקים על ירוחם תוית נוספת של נחיתות: וכי מדוע ילכו מפעלי תעשיה נוספים או כח אדם תעשייתי, שבאים לנגב - לירוחם ולא לדימונה וערד, כאשר באלה האחרונים קיימת כבר תשתית תעשיתית הרבה יותר מפותחת ומגווונת?', 'dspan': (0, 319), 'tokens': [{'id': (1, 2), 'text': 'ההיקף', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'היקף', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 22, 'deprel': 'nsubj', 'lemma': 'היקף'}], 'span': (0, 5), 'dspan': (0, 5)}, {'id': (3, 4), 'text': 'הגדול', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'גדול', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'amod', 'lemma': 'גדול'}], 'span': (6, 11), 'dspan': (6, 11)}, {'id': 5, 'text': 'יותר', 'upos': 'ADV', 'xpos': 'ADV', 'head': 4, 'deprel': 'advmod', 'dspan': (12, 16), 'span': (12, 16), 'lemma': 'יותר'}, {'id': (6, 8), 'text': 'והגוון', 'expanded': [{'id': 6, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 8, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'גוון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'conj', 'lemma': 'גוון'}], 'span': (17, 23), 'dspan': (17, 23)}, {'id': (9, 10), 'text': 'הרב', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 10, 'deprel': 'det', 'lemma': 'ה'}, {'id': 10, 'text': 'רב', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 8, 'deprel': 'amod', 'lemma': 'רב'}], 'span': (24, 27), 'dspan': (24, 27)}, {'id':