# file = txt/2800083.txt
# filelineno = 8
# sentno = 1
# text = כדאי להדגיש שמרבית הצעות התכנית נשארו בעינן, וחלק מהן אף גדלה חשיבותן־ השינוי העיקרי בתכנית הוא באפשרות - שהיתה חסרת כל סיכויים, בתכנית המקורית -להציע תיקף בנית נרחב בירוחם, כבר בשנים הקרובות.
