# file = txt/2300156.txt
# filelineno = 934
# sentno = 2
# text = לאחר שמיעת ההתנגדות רשאית הועדה המחוזית לאשר את התוכנית כפי שהיא או עם תיקונים (סעיף 108),ובאם יש צורך לאישור שר הפנים אזי התוכנית תהיה טעונה אישורו והיא תיכנס לתוקף ותחילתה של תוכנית שאושרה כאמור היא בתום 15 יום לאחר פירסום הודעה ברשומות על אישורה.
