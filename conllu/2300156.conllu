# file = txt/2300156.txt
# filelineno = 939
# sentno = 4
# text = לפי דבריו של אמנון פרנקל תוכנית זו לא התקבלה עקב אי הסכמתו של ראש עירית ק' ביאליק דאז,מר צבי קרלינר כי השטחים מצפון הקריון ייועדו לפארק עירוני גדול בשטח של כ-20ו דונם ויתחברו לקי מוצקי ן בשטח המחנה הצבאי כורדני, שם יוקם פארק עירוני בן 200 דונם ואילו המסחר ירוכז בחגורה רוחבית,בי ן מרכז צבר למרכז רסקו.
