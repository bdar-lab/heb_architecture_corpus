# file = txt/1300029.txt
# filelineno = 893
# sentno = 2
# text = הזמן הרב המוקדש לכך פוגע באפשרות הוועדות לעסוק בנושאים בעלי משמעות כלל עירונית, בחתווית מדיניות ובהכנת תכניות• קיימת אמנם מסגרת של וועדת מישנה לוועדה לתיכנון ובנייה, ולאחר תיקון 26 לחוק - מסגרת של רשות רישוי מקומית - המוסמכת לאשר בקשות להיתר במיה שאין בהן כל חריגה מהתוכניות המאושרות, אולם ניסוחן של תוכניות בניין עיר, המאופיין בדרך כלל בפירוט רב ובחוסר גמישות, מביא לכך שלעיתים לא ניתן להימנע מחריגות, הדיון, לכן, חייב לעיתים תכופות לחיות בוועדה עצמה (דוגמות של מצב זה ראו ב-אלתרמן, 1989).
