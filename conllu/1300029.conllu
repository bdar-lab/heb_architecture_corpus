# file = txt/1300029.txt
# filelineno = 340
# sentno = 1
# text = א.	כמות הקרקע: בדיקת הפירוש הניתן לחוק בחיפה ובתל אביב הצביעה על גישות הפוכות לגבי השאלה, אס ניתן - ורצוי - להפריש במסגרת רפרצלציה מעל 40% משטח המיגרשים; ובהנחה שמותר, קיימת מחלוקת כיצד יש לחשב את אחוזי הבנייה המותרים: האם מהשטח הנטו לבנייה, או מהשטח התיאורטי שבהפחתת 40% בלבד.
