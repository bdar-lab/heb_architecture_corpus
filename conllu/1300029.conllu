# file = txt/1300029.txt
# filelineno = 250
# sentno = 7
# text = מתכננים נבונים יכולים אמנם להשתמש בכלי הקייס לצורך הכוונת הפיתוח למקום הרצוי, אך הכוונה זו דורשת שימוש דיפרנציאלי נבון בהפקעות ללא תמורה: יספקו המתכננים קרקע זמינה לצורכי ציבור ברמה גבוהה יותר באזורים נבחרים, ובכך יגדילו את כדאיות הפיתוח ונכונות הצרכנים לגור או לעבוד באזורים אלה.
