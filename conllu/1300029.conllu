# file = txt/1300029.txt
# filelineno = 6
# sentno = 6
# text = רביעית, חלוקת התפקידים המקובלת בין השלטון המרכזי וספיחיו לבין השלטון המקומי היא כזו, שאת ההפעלה של חלק חשוב משירותי הציבור, נוהג לממן השלטון המרכזי (או קופ״ח, או הסוכנות היהודית), בעוד נושא הקרקעות וחלק ממימון הקמת המתקנים נותר כל כולו באחריות השלטון המקומי דל המשאבים.
