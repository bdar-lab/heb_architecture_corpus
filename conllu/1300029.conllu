# file = txt/1300029.txt
# filelineno = 261
# sentno = 1
# text = אשר לנושא הראשון! ראינו כי המחוקק סיפק הגנה מטויימת לבעלים שהופקעה מחס קרקע, כך שהפגיעה לא תגיע לכדי נזק קשה או חיסול שוויה של החלקה־ כאן קיימות גירסאות שונות לפירוש החוק, אולם לאחרונה מובחנת בפסיקה נטייה לצימצוס זכויות	הבעלים בהקשר זח.
