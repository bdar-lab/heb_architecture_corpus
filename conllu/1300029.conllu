# file = txt/1300029.txt
# filelineno = 955
# sentno = 4
# text = מדיניות כזו תוכל לכלול אמצעים כגון מדיניות רכישת קרקעות שטרם יועדו לפיתוח, כפי שנהוג בארצות רבות; יעוד תקציבים והכנסות מסויימות להפקעה בתמורה, כגון כספי היטל ההשבחה; השגת קרקעות במסגרת מדיניות של עידוד הסכמים מסוגים מסויימים; ושימוש בכלי□ חליפיים בהיקף מורחב, כגון בחלוקה חדשה (רה-פרצלציה).
