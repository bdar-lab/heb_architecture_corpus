# text = הדוגמא הקיבוצית תאמה לפרסומיו של כריסטופר טנרד, אחד מחשובי החוקרים והוגי הדעות בתחום תולדות אדריכלות הגנים וארכיטקורת הנוף במאה הזאת, אשר טען כי "הגיע הזמן לראות את מקום מגורינו ואת מקום עבודתינו לא כיחידות עצמאיות וגדורות, כי אם כחלק אינטגרלי בפתוח הסביבה.
# raw = {'id': 1, 'text': 'הדוגמא הקיבוצית תאמה לפרסומיו של כריסטופר טנרד, אחד מחשובי החוקרים והוגי הדעות בתחום תולדות אדריכלות הגנים וארכיטקורת הנוף במאה הזאת, אשר טען כי "הגיע הזמן לראות את מקום מגורינו ואת מקום עבודתינו לא כיחידות עצמאיות וגדורות, כי אם כחלק אינטגרלי בפתוח הסביבה.', 'dspan': (0, 257), 'tokens': [{'id': (1, 2), 'text': 'הדוגמא', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'דוגמא', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'nsubj', 'lemma': 'דוגמה'}], 'span': (0, 6), 'dspan': (0, 6)}, {'id': (3, 4), 'text': 'הקיבוצית', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'קיבוצית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'amod', 'lemma': 'קיבוצי'}], 'span': (7, 15), 'dspan': (7, 15)}, {'id': 5, 'text': 'תאמה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PAAL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (16, 20), 'span': (16, 20), 'lemma': 'תאמה'}, {'id': (6, 9), 'text': 'לפרסומיו', 'expanded': [{'id': 6, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'ל'}, {'id': 7, 'text': 'פרסום_', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Def|Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'obl', 'lemma': 'פרסום'}, {'id': 8, 'text': '_של_', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case:gen', 'lemma': 'של'}, {'id': 9, 'text': '_הוא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Gender=Masc|Number=Sing|Person=3|PronType=Prs', 'head': 7, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (21, 29), 'dspan': (21, 29)}, {'id': 10, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 11, 'deprel': 'case:gen', 'dspan': (30, 32), 'span': (30, 32),