# file = txt/2000172.txt
# filelineno = 489
# sentno = 1
# text = העצים, השיחים והפרחים באותם קיבוצים, ניטעו ונשתלו בהתאם לתכניות של אדריכלי גנים אשר לעיתים אף תוכננו עוד בטרם לעלייה להתיישבות בנקודת הקבע, כדוגמת שדה אליהו (ברנשטיין, 1996), וברב המקרים במקביל לתכנית הבינוי ולא כחלק ממנה, כפי שהיה מקובל ערב התקופה.
