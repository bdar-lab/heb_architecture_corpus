# file = txt/2300047.txt
# filelineno = 17
# sentno = 1
# text = של הציבור להגנה מפני אנרכיה בסביבה הבנוייה, ומפני פגיעה בזהותו התרבותית; בין תכליותיה הראויות של בקרת העיצוב, לבין הפעלתה להשגת מטרות ספק-ראויות של הרשות; ובין המידה הראויה לבין המידה היצירתית, אשר רחוקות זו מזו כמידת המרחק שבין הדיציפלינות המשפטית והאדריכלית.
