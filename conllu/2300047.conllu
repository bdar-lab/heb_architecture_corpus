# file = txt/2300047.txt
# filelineno = 598
# sentno = 3
# text = רק בתנאי שהיזמים בכל ארבע הרחבות יתאגדו יחדיו ויגישו בקשה לשינוי התוכנית - אז תדון בה הוועדה המקומית ותישקול אם לאשרה, אם לאו; תנאי זה התכוון להוות תמריץ שלילי לשינוי, מתוך הנחה שהיזמים יירתעו מלשתף פעולה מבחינה תכנונית בינם לבין עצמם, בשל הזמן הרב שהליך מסוג זה דורש, וניגודי האינטרסים שעשויים לנובע ממנו.
