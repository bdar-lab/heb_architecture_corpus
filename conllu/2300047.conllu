# file = txt/2300047.txt
# filelineno = 452
# sentno = 2
# text = התיכנון המפורט של המרחב העירוני כולו איפשר ליצור קומפילציה ממוחשבת של זכויות הבנייה בכל חלקה וחלקה ברשות, ולספק לציבור היזמים מידע תיכנוני מדוייק ומהיר, כנדרש בחוק; בנוסף, מכיוון שכל הוראות העיצוב מפורטות בתוכניות מפורסמות ומאושרות, נהנה הציבור מרמה גבוהה של וודאות לגבי יוזמות פיתוח שעתידות להתרחש בסביבתו, ושעשויות להשפיע על זכויותיו.
