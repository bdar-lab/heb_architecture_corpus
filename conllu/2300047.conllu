# text = לסיכום, ניתן ללמוד מספר דברים משני מיונים אלה של בקרת העיצוב: ראשית, נראה כי מרבית האלמנטים האדריכלים נתונים לבקרה - החל ממיקום המבנה במרחב, עובר דרך עיצוב המאסה, ועד לפרטי הבנייה; שנית, נראה כי בקרת העיצוב נובעת מכלל הסדרי התכנון הסטטוטורי: "ישירים", "משולבים" ו״עקיפים" גם יחד.
# raw = {'id': 1, 'text': 'לסיכום, ניתן ללמוד מספר דברים משני מיונים אלה של בקרת העיצוב: ראשית, נראה כי מרבית האלמנטים האדריכלים נתונים לבקרה - החל ממיקום המבנה במרחב, עובר דרך עיצוב המאסה, ועד לפרטי הבנייה; שנית, נראה כי בקרת העיצוב נובעת מכלל הסדרי התכנון הסטטוטורי: "ישירים", "משולבים" ו״עקיפים" גם יחד.', 'dspan': (0, 279), 'tokens': [{'id': (1, 2), 'text': 'לסיכום', 'expanded': [{'id': 1, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ל'}, {'id': 2, 'text': 'סיכום', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'obl', 'lemma': 'סיכום'}], 'span': (0, 6), 'dspan': (0, 6)}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (6, 7), 'span': (6, 7), 'lemma': ','}, {'id': 4, 'text': 'ניתן', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|VerbType=Mod|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (8, 12), 'span': (8, 12), 'lemma': 'ניתן'}, {'id': 5, 'text': 'ללמוד', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PAAL|VerbForm=Inf|Voice=Act', 'head': 4, 'deprel': 'csubj:pass', 'dspan': (13, 18), 'span': (13, 18), 'lemma': 'למד'}, {'id': 6, 'text': 'מספר', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Cons', 'head': 7, 'deprel': 'det', 'dspan': (19, 23), 'span': (19, 23), 'lemma': 'מספר'}, {'id': 7, 'text': 'דברים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'obj', 'dspan': (24, 29), 'span': (24, 29), 'lemma': 'דבר'}, {'id': (8, 9), 'text': 'משני', 'expanded': [{'id': 8, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'מ'}, {'id': 9, 'text': 'שני', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Definite=Cons|Gender=Masc|NumType=Card', 'head': 10, 'deprel': 'nummod', 'lemma': 'שני'}], 'span': (30, 34), 'dspan': (30, 34)}, {'id': 10, 'text': 'מיונים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Ma