# file = txt/2300047.txt
# filelineno = 279
# sentno = 6
# text = הוועדות המקומיות ולצידן מרכז השילטון המקומי אשר מטבע הדברים שואפים להרחיב את סמכויותיהם, דוגלים במובן הרחב של המושג, וכוללים בו גם שינוי בגובה המבנה; משרד הפנים והוועדות המחוזיות, לעומת זאת, אשר שואפים לשמר בידיהם את הפיקוח הריכוזי על התיכנון המקומי, דוגלים במובן הצר וכוללים בו היבטים אסתטיים בלבד.
