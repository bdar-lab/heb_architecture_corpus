# file = txt/2300047.txt
# filelineno = 593
# sentno = 2
# text = התוכנית קבעה בינוי טורי בהיקפן של הרחבות, ואילו הצרכן הישראלי, כך נאמר לנו, אוהב "כיווני אוויר" ומה שפחות קירות משותפים עם שכניו; הטיפולוגיה האדריכלית האחידה שנאכפה ב״חולות בי" (בית מדורג בן ארבע-חמש קומות המכיל דירות בשטח ממוצע של כ- 120 מ״ר), הגבילה את היכולת של היזמים לייצר דירות בטווח מחירים רחב; היזמים העדיפו לרכז את שטחי הבנייה המותרים בבנייני H גבוהים, או לחילופין, לחלק אותם בין בתים גבוהים לקוטג׳ים צמודי קרקע; נאמר לנו שבנייני ה- H רצויים על ידי היזמים כיוון שהם מאפשרים לחלק את עלות המעליות בין מספר גדול יותר של דירות בקומה, וכן לגבות מחיר דיפרנציאלי עבור יחידות הדיור השונות בבנין - מחיר שעולה ככל שהקומה גבוהה יותר.
