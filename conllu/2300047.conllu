# file = txt/2300047.txt
# filelineno = 148
# sentno = 4
# text = המחכירים בני האצולה, גילו אחריות מעמדית (nobless oblige), בכך שריסנו את נטייתם הטבעית להפקת רווח כלכלי מיידי, ועיגנו תנאי עיצוב "איכותיים" בהסכמי החכירה מתוך תפישה ציבורית ארוכת טווח של המבנה ותיפקודיו; החוכרים, מצידם, מצאו שהבנייה ה״איכותית" משרתת את האינטרס הכלכלי שלהם עצמם בשיווק בתיהם למעמדות הביניים.
