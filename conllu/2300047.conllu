# file = txt/2300047.txt
# filelineno = 792
# sentno = 1
# text = מעניין לציין את היחס ההופכי שנמצא במחקר בין מידת הבקרה שהרשויות השונות מנהיגות בניספחי עיצוב, לבין בחירת מנגנון הסטייה מהתוכנית: ככל שהרשות מהדקת את הקשר בין נספח העיצוב לתוכנית, וקובעת כי היא מהווה חלק בלתי נפרד ממנה, כן היא נוטה להתנות את השינוי בו בשיקול דעת.
