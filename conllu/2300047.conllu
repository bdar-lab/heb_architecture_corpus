# file = txt/2300047.txt
# filelineno = 282
# sentno = 1
# text = אולם כיצד יכול המורשה להיתר לערוב להיתרים שניתנים במסגרת תוכניות שמותירות שיקול דעת עיצובי לוועדות! כאשר התוכנית הסטטוטורית מתנה את היתר הבנייה ב״תוכנית עיצוב" עתידית אין הוא יכול להוציא היתר על פיה אלא לאחר שניכנס לתהליך ממושך של הכנת תוכנית זו ואישורה על ידי הוועדה המקומית; במצב זה, כוונת קיצור ההליכים של החוק יורדת לטימיון; וסמכותו של מי גוברת במצב בו הבקשה להיתר תואמת את כל הוראות החוק, התקנות והתוכניות, אולם הרשות מוצאת לנכון להתלות את ההיתר על רקע אי התאמתו של המבנה לסביבתו! נראה אפוא, כי סמכויות שיקול הדעת שהעניק החוק לוועדות המקומיות אינן עולות בקנה אחד עם סמכויות המורשה להיתר, וגם בעניין זה חסרה מדיניות ברורה של מוסדות התיכנון.
