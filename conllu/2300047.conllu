# file = txt/2300047.txt
# filelineno = 94
# sentno = 1
# text = מיון נושאי בקרת העיצוב מבוסס על שלושה מקורות עיקריים אשר בולטים במיגוון ההסדרים שהם מתארים, ובמידת השיטתיות של ההצגה: 1989) Habe), סוקר את הפרקטיקה של בקרת העיצוב ב-66 רשויות מקומיות אמריקניות;  מתאר את בקרות העיצוב אשר מופעלות בערים אמריקניות גדולות, ומתמקד בניו-יורק ובסן־פרנסיסקו, אשר ידועות במידת הקפדתן על העיצוב האדריכלי, ובמנגנונים החדשניים המשמשים להסדרתו; המקור הבולט השלישי, הוא ה- מדריך זה מפרט את בקרות העיצוב אשר נהוגות במחוז אסקס אשר זכו לתהודה רבה ברחבי בריטניה, ואומצו ג□ על ידי רשויות מקומיות אחרות.
