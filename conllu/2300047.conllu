# file = txt/2300047.txt
# filelineno = 914
# sentno = 1
# text = נכון להיום, חוק התיכנון והבנייה אינו מבחין בין זכות ההתנגדות של הציבור לפי נושאים; לאור הניתוח העיוני שבחלקו הראשון של ספר זה עולה ספק עקרוני האם ראוי ליצור אבחנה מעין זו, ולהפקיד בידי ניבחרי ציבור או אנשי מיקצוע שיקול דעת עיצובי, ללא בקרה ציבורית: מצד אחד מתברר מן הספרות, שנבחרי ציבור או אנשי מיקצוע אינם ברי-סמכא בהעדפות האסתטיות של הציבור; מצד שני למדנו, כי אין גבול חד בין הסדרים אסתטיים להסדרים חברתיים וכלכליים אשר שיתוף הציבור בהם אינו שנוי במחלוקת.
