# file = txt/2700003.txt
# filelineno = 969
# sentno = 1
# text = יישוב יוכל להיקרא יישוב מרפא במידה שמתקיימים בו התנאים האלה או צירוף מספק שלהם: (א) קיום נושא מרפא טבעי ־ מעין או קידוח מים קרים או חמים בעלי תכונות מתאימות ומפותחים לקליטת קהל; מזג אוויר מיוחד או נושא מרפא מפותח בידי אדם (טבעוניות, טיפול בריאות ויופי בשיטות מתאימות, ספורט עממי), (ב) איכות סביבה המתבטאת באוויר, במי שתייה וברעש בתקנים מיטביים, (ג) בקרה מלאה על הצומח בשטחים הציבוריים והפרטיים שלא יכללו גורמי אלרגיות ושאר מטרדים בריאותיים, (ד) שילוב מירבי של היישוב בטבע הסובב, (ה) תכנון ופיתוח בדגש של נוי, טיילות, מצפורים, שבילי אופניים, מתקני משחק לילדים ומבוגרים ומוסדות תרבות.
