# file = txt/2500023.txt
# filelineno = 179
# sentno = 3
# text = מבחינה תאורטית המבנה הרצוי ביותר של קירות החוץ הוא בעל שתי שכבות: שכבת בידוד תרמי מעולה מבחוץ, ושכבת קיבול חום רב מבפנים־ באופן מעשי ניתן לקבל קיר כזה ע"י קיר קונסטרוקטיבי מבטון בעובי 20 ס״מ, המצופה בצדו החצוני ע״י שכבת חומר בידוד (פוליסטירן מותפח בעובי 5 ם'זמ, למשל) המוגנת כלפי חוץ ע״י שכבת מגן כל שהיא (למשל אסבסט צמנט גלי)בצבע לבן.
