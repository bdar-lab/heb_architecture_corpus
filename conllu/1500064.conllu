# file = txt/1500064.txt
# filelineno = 987
# sentno = 5
# text = מנהלת רובע לב העיר לעומת זאת הציגה עמדה אחרת והיא כי אי אפשר להתעלם מן התושבים וכי בהתייחס לרחוב שינקין יש בו בעיות שצריך לטפל בהן אבל צריך לזכור כי התושבים הם אלו "שעשו את הרחוב" (ראיון עם רוב, 2006).
