# file = txt/1500064.txt
# filelineno = 1005
# sentno = 1
# text = בנוסף לעדויות על קירות הרחוב, תועדו ברחוב וסביבתו על ידי העיתונות, אירועים לא ממסדיים פתוחים לקהל הרחב– מסיבת ריקודים של קבוצת מובייל קלאבינג120 בשדרות רוטשילד פינת שינקין (לופיאן, 2006, 14 בספטמבר), הופעת מוזיקה של להקת פאנק על אחד מגגות הבתים ברחוב ביום שישי (זיו, 2007, 18 במאי) והתפתחות מסורת של ציורים על הכביש והמדרכות על ידי ילדים ומבוגרים ביום כיפור, בצומת הרחובות שינקין - המלך ג'ורג' (לאחר שבשנה הראשונה הפעילות הופסקה על ידי המשטרה) (זיו, 2007, 28 בספטמבר).
