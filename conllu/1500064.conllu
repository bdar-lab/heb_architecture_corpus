# file = txt/1500064.txt
# filelineno = 92
# sentno = 3
# text = חקירה זו חיונית כיוון שהתיאור והתיאוריות של מערכות ומוסדות הכוח השלטים, אין בהם די כדי להסביר את החברה בשלמותה: "אילו הליכים עממיים (גם הם "מזעריים" ויומיומיים) מהתלים במנגנוני המשמעת ונוהגים על-פיהם רק כדי להפכם על פיהם" (דה סרטו, 1997:17).
