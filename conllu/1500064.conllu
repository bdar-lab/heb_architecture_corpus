# file = txt/1500064.txt
# filelineno = 819
# sentno = 1
# text = מרכז העיר ואזור רחוב שינקין בפרט מופיעים בדו״ח במספר הקשרים המעידים על החשיבות הרבה אשר מייחסים לאזור זה בפעילות העירונית: הדו״ח מציג את מרכז העיר ככולל את מרבית המאפיינים הטיפוסיים לעיר תל אביב יפו כולה ולמעשה פעמים רבות מייצג אותה מבחינת תפיסתית - מהי תל אביב, האזור מכונה כ"סיטי של תל אביב" ומבחינה פיזית הוא מאופיין בקומפקטיות ועירוב שימושי קרקע שונים (מגורים, מסחר, תעסוקה, שירותי ציבור, מוסדות תרבות, חוף ים ושטחים ציבוריים).
