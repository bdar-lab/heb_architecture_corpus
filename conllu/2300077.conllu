# file = txt/2300077.txt
# filelineno = 7
# sentno = 1
# text = מתוך מדינות אלה, בחרנו להציג בדו״ח זה נתוח מפורט של שתי מדינות שלהן זיקה מיוחדת למערכת התכנון בישראל: בריטניה, לנוכח תקופת המנדאט הבריטי והשפעתה על מערכת התכנון והבניה בישראל, ומשום הקירבה בין שתי שיטות המשפט; וצרפת, משום המסורת הריכוזית מאד של קבלת החלטות שהיתר! נהוגה בה עד לאחרונה, ובכך דמתה לשיטתנו.
