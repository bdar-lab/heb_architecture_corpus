# file = txt/2300077.txt
# filelineno = 14
# sentno = 1
# text = עיקר הבעיות במערכת התכנון בכל מדינה מתמקד בדרך כלל לא בחוק עצמו, אלא ביחסי הגומלין בין ההסדר שבחוק, לבין גורמים המשפיעים על מוסדות התכנון כגון: מבנה המערכת השלטונית, מידת היעילות האדמיניסטרטיבית, שוק המהקרקעין והפיתוח, שינויים שחלו באורחות החיים וטעמי הצרכנים, שינויים באידיאולוגיות ובתפיסות תכנון, נכונות האזרחים לציית לחוק, ונורמות של קבלת החלטות - לדוגמא, חלוקת הסמכויות הרצויה בין השלטון המרכזי למקומי, ומידת המעורבות הראויה לציבור המושפע מתכנון.
