# file = txt/1800198.txt
# filelineno = 32
# sentno = 2
# text = כיום קיימים שני סוגים של עמדות טעינה, לפי סוג הזרם החשמלי שבהם – עמדות עם זרם חילופין (AC) בהן הטעינה איטית יותר (בין שעה לשמונה שעות, תלוי בסוג הזרם ובגודל הסוללות), אך הן זולות וקלות יותר להתקנה; או עמדות עם זרם ישר (DC), בהן הטעינה מהירה יותר (טעינה בתוך 20 עד 40 דקות של כ-80% מהסוללה, כתלות בגודל העמדה ובגודל הסוללה), אך הן יקרות ומורכבות יותר להתקנה.
