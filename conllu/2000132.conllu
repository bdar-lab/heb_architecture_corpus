# file = txt/2000132.txt
# filelineno = 168
# sentno = 1
# text = בשנת 1990, לאור גל העלייה מברית המועצות לשעבר, חוקקה הממשלה את "חוק הליכי תכנון ובניה (הוראת שעה)" חוק הבא "לקבוע הסדרים מיוחדים לאישור תוכניות בנייה לשם הערכות דחופה למתן פתרון לצורכי דיור והתעסוקה במדינה" (חוק התכנון והבנייה 1990) ותוקפו חמש שנים.
