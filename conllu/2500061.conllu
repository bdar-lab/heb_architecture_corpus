# file = txt/2500061.txt
# filelineno = 113
# sentno = 4
# text = בכל מקום בו שכבת האיטום אינה חשופה לשינויי טמפרטורה גדולים, לקרינה אולטרה סגולית ישירה ולדפורמציות גדולות, ניתן עקרונית, גם בבניה הטרומית, להשתמש הן בחומרים הביטומנייים המקובלים והן בחומרים חדשים, בתנאי, שיעמדו בדרישות התקנים והמפרטים הרלוונטיים ובמיוחד, שהישום נעשה בצורה מקצועית ובדיוק הנדרש.
