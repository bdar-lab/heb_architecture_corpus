# file = txt/2000148.txt
# filelineno = 188
# sentno = 2
# text = דירוג הדירות שבתקן זה מתבסס על השיטות להערכת צריכת האנרגיה הנדרשת לאקלום הדירה, המובאת במחקר שהוכן בטכניון, במרכז למחקר ופיתוח בארכיטקטורה- מעבדת אקלים ואנרגיה בארכיטקטורה, שכותרתו :״תפקוד תרמי של בניינים ופיתוח קוים מנחים של תכנון מודע לאנרגיה״ (שביב ושות., 2002).
