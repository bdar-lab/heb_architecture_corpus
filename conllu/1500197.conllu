# filelineno = 30
# sentno = 1
# text = מספר מושגים משמשים לתיאור הצפת הצונאמי בחוף (ראה איור 2): תחום אופקי מוצף (Inundation Area) - אזור יבשתי המוצף מצונאמי; רום פני חים בקו החוף (Flow depth)־ גובה הצונאמי מעל הקרקע בנקודת ייחוס קו החוף; קו חחצפה מרבי (Max. Inundation line) - המרחק האופקי המרבי של ההצפה מקו החוף לכיוון היבשה; רום טיפוס מרבי (Max. Run-Up) ־ גובה הצפה בקו ההצפה המרבי; מפלס מים מרבי - גובה ההצפה המרבי, יכול להימצא בין קו החוף לקו ההצפה.
