# file = txt/1500194.txt
# filelineno = 4
# sentno = 3
# text = ראיונות העומק הורכבו מ-3 אשכולות שאלות: שאלות אודות אופי המשתמשים, פרסומי מיקום בפייסבוק, וחקר אירועים ספציפיים מפרופיל הפייסבוק האישי של המרואיינים; האחרון מהווה את אשכול השאלות המרכזי, ומייצר "סיפור אירוע" לכל אירוע שנחקר מהפייסבוק, הכולל התייחסות מעמיקה מנקודת מבט המרואיין (חקר אירוע לפי הגישה האגוצנטרית) לדרך התהוותו, הפצתו, והקשרו במבנה החברתי הספציפי - ברשת החברתית המקוונת והלא מקוונת.
