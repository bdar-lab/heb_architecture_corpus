# file = txt/1500194.txt
# filelineno = 59
# sentno = 4
# text = המשתמש חשוף למידע רב גם מחברים שאינם מצויים בקרבה חזקה עמו בעולם הפיזי (קשרים חלשים), דבר אשר מאפשר למשתמש להרחיב את מקורות שיתוף המידע החברתי שאליו הוא חשוף- ממידע מצומצם ב״חממח החברתית" הפיזית (קשרים בקרבה גבוהה), לכמות מידע עצומה, אשר אותה שואב המשתמש מרחבי הרשת שלו (2012 ,Bakshy).
