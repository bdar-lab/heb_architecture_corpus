# file = txt/1500194.txt
# filelineno = 483
# sentno = 2
# text = בחינת סימטריות הנסיעות לאירועים נעשית בניתוח מחקרי נבדל מן הנסיעות המורכבות והתהוותן, זאת משום שמהראיונות עולה כי נסיעה א־סימטרית היא תרחיש עצמאי ומבודד משאר הגורמים שנבדקו במחקר זה, המושפע לרוב מאינטראקציות פנים אל פנים המתרחשות באירועים עצמם ולא בפייסבוק.
