# file = txt/2500072.txt
# filelineno = 179
# sentno = 3
# text = בסה"ב נקבל תוספת עלות חודשית של -,1100 ל״י־ ניתן לראות, שבקרקעות בהן אפשר לבצע חפירה בציוד מכני, לא יהיה, במקרה זה, תחום כלכלי לעגורן על גלגלים, פרט למקרה בו אין הבדל במחיר הרכישה , אורך המסילה - 150 מטר ושפוע הקרקע מעל 4% (ציור ג-4)» גם בקרקע סלעית שבה כל המסילה היא במלוי יקטן בהרבה תחום הכדאיות של העגורן על גלגלים, במסילות שאורכן 50 מטר לא יהיה תחום כדאיות לעגורן זה, ואילו במסילות שאורכן 100 עד 150 מטר יהיה לו תחום כדאיות בשפועים שמעל 3% בערך,
