# file = txt/2500072.txt
# filelineno = 39
# sentno = 1
# text = במקרים מסוימים, בעיק- בתכניות בגוי "מסובכות", לא יהיה יעיל עגורן בעל זרוע של 25 מטר, כפי שניתן לראות למשל באתרים מם' 25, 26, 28, 29, 50 בנספח א', אתרים מסוג זה נפוצים בעי קי־ באיוי־ ירושלים ופחות מזה באיורים אחרים, במקרים מסרג זה אפשי־ לקבל כסוי טרב יותר של הבנינים ע״י השמוש בעגורנים על גלגלים, בתכנית הבנוי של אתר מם' 50 ניתנת גם האפשרות של שט וש בעגורן כזה, ניתן לראות שבעגורן מסוג זה אפשר לכסות את כל שטח המינים גם עם זרוע קצרה יותר, עגורן על גלגלים איננו קשור למסילה ולכן אפשרויות ההתקרבות שלו לבנינים גדולות יותר, כתוצאה מכך דרושה לו זרוע קצרה יותר מאשר לעגורן על מסילה, והבדל זה הולך וגדל ככל שתכנית הבנוי "מסובכת" יותר, מתוך בדיקה של האתרים שבנספח א' מתברר שאפשר להשיג כסו" מלא או כמעט מלא של הבנינים ברוב המקרים, בעגורן על גלגלים בעל זרוע באורך של 17 עד 20 מטר, בעגורן כזה עם זרוע של 25 עד 24 מטר אפשר להשיג כסוי מלא (או כמעט מלא) בכל המקרים הנזכרים־
# raw = {'id': 1, 'text': 'במקרים מסוימים, בעיק- בתכניות בגוי "מסובכות", לא יהיה יעיל עגורן בעל זרוע של 25 מטר, כפי שניתן לראות למשל באתרים מם\' 25, 26, 28, 29, 50 בנספח א\', אתרים מסוג זה נפוצים בעי קי־ באיוי־ ירושלים ופחות מזה באיורים אחרים, במקרים מסרג זה אפשי־ לקבל כסוי טרב יותר של הבנינים ע״י השמוש בעגורנים על גלגלים, בתכנית הבנוי של אתר מם\' 50 ניתנת גם האפשרות של שט וש בעגורן כזה, ניתן לראות שבעגורן מסוג זה אפשר לכסות את כל שטח המינים גם עם זרוע קצרה יותר, עגורן על גלגלים איננו קשור למסילה ולכן אפשרויות ההתקרבות שלו לבנינים גדולות יותר, כתוצאה מכך דרושה לו זרוע קצרה יותר מאשר לעגורן על מסילה, והבדל זה הולך וגדל ככל שתכנית הבנוי "מסובכת" יותר, מתוך בדיקה של האתרים שבנספח א\' מתברר שאפשר להשיג כסו" מלא או כמעט מלא של הבנינים ברוב המקרים, בעגורן על גלגלים בעל זרוע באורך של 17 עד 20 מטר, בעגורן כזה עם זרוע של 25 עד 24 מטר אפשר להשיג כסוי מלא (או כמעט מלא) בכל המקרים הנזכרים־', 'dspan': (0, 859), 'tokens': [{'id': (1, 2), 'text': 'במקרים', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'מקרים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 158, 'deprel': 'obl', 'lemma': 'מקרה'}], 'span': (0, 6), 'dspan': (0, 6)}, {'id': 3, 'text': 'מסוימים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'amod', 'dspan': (7, 14), 'span': (7, 14), 'lemma': 'מסוים'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 17, 'deprel': 'punct', 'dspan': (14, 15), 'span': (14, 15), 'lemma': ','}, {'id': 5, 'text': 'בעיק', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 172, 'deprel': 'obl', 'dspan': (16, 20), 'span': (16, 20), 'lemma': 'בעיק'}, {'id': 6, 'text': '-', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 213, 'deprel': 'punct', 'dspan': (20, 21), 'span': (20, 21), 'lemma': '-'}, {'id': (7, 8), 'text': 'בתכניות', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel