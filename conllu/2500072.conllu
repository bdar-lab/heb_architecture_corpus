# file = txt/2500072.txt
# filelineno = 22
# sentno = 1
# text = בניני המגורים של 4 ו-5 קומות עתיד לרדת בשנים הקרובות הרי שאין לצפות שהירידה של אחוז הבנינים בעלי 4 עד 6 קומות תהיה בשעור ניכר" קבלנים רבים עוסקים רק או בעיקר בהקמת מבנים מסוג זה" משום כך נתיחם בנפיד לקבוצה זו של בנינים ששכיחותם מצדיקה רכישת עגורנים שיתאימו להקמת בנינים אלה" גם השוק מציע עגורנים מסוגים ומסוסים שונים המתאימים למבנים אל ר " בעיקר מקובל השמוש בעגורני צי־יח בעלי זרוע מתרוממת הנעים על מסילה ובעגוי־ני צריח בעלי זרוע אופקית (ללא משקל נגדי.) הנעים על גלגלי גומי (ראה פרטים בנספח די,)" עגורנים אלו, הם בעלי גובה מוגבלי הם קלים יחסית, נוחים להעברה ומהירים בהקמה ובפריק"
