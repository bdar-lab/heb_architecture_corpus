# file = txt/2500072.txt
# filelineno = 47
# sentno = 1
# text = א)	העגורן רתוק למקומו בשעת העבודה ואינו יכול לעבור ממקום למקום עם משא, כתוצאה מכך יש צורך להעביר את כל החומרים עד לקרבתו ואין הוא יכול להעבירם בעצמו ממרכזי הייצור שלהם באתר, אלא אם כן האתר הוא קטן.
