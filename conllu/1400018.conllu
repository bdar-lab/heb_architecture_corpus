# file = txt/1400018.txt
# filelineno = 16
# sentno = 2
# text = הערים הן בעצם אלה שיוצרות את הרווחה הכללית של מדינות (1984 Jacobs) אולם רווחה זאת יכולה להתקיים כיום בזכות ניצול של טובין ממערכות אקולוגיות שונות (לרב טבעיות) ומבלי להתחשב בשירותים,שלעיתים הם ברמה גלובלית, הניתנים על ידי מערכות אקולוגיות טבעיות אלה.
