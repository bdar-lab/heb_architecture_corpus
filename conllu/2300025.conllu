# file = txt/2300025.txt
# filelineno = 936
# sentno = 1
# text = השימוש בנע״ת ככלי לניתוח כדאיות השקעות נפוץ כיום בתכנון השקעות בסקטור הציבורי, אשר מחד חייב להביא בחשבון שיקולים ציבוריים אשר משקיע פרסי לא היה כולל, או לא היה מסוגל לכלול, בחישובי הכדאיות; ומאידך, חייב להצדיק את הבחירה מבחינה כלכלית ע״י כך שתבחרנה השקעות עם שיעור תשואה סביר לעומת השקעות ציבוריות אלטרנטיביות.
