# file = txt/1500204.txt
# filelineno = 316
# sentno = 5
# text = עליית קרנו של ענף המסחר והשירותים כמעסיק מרכזי בעיר קיבלה עדות בישיבת הוועדה המקומית מהתאריך 7.5.2013 בה הוצגו שמונה פרויקטי ״מסחר ותעסוקה״ - בפועל כולם מרכזים מסחריים בינוניים־גדולים (בשטח כולל של כ- 84,000 מ״ר).
