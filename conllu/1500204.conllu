# file = txt/1500204.txt
# filelineno = 47
# sentno = 2
# text = הפיתוח האזורי בקריית גת התבסס על ההנחה כי בעקבות הגעת מפעל אינטל תתגבש אגלומרציה של תעשיות בפארק תעשייה המקומי, וכי ההשלכות הכלכליות של מהלך זה יהיו זהות לאלו הנובעות מאגלומרציה תעשייתית ״טבעית״ (2005 ,.Shachar et al).
