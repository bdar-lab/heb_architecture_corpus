# file = txt/1500204.txt
# filelineno = 19
# sentno = 2
# text = ההתמקדות בצעירים חשובה הן מבחינת לוח הזמנים - פיתוחו המחודש של פארק התעשייה החל כאשר קבוצה זו הייתה בגילאי בית ספר - מה שהותיר לה זמן רב להתכונן באמצעות רכישת הון אנושי מתאים - והן מבחינת יכולתה ללמד על מגמות עומק בתנועת האוכלוסייה, מגמות שמצביעות על עתיד היישוב.
