# file = txt/1500022.txt
# filelineno = 260
# sentno = 5
# text = החלטה זו גרמה להפעלת ברירת המחדל בסעיף 17(ד) בצו, לפיה אם לא הועברה לשר הפנים המלצה מהמועצה בנוגע למודד הכללי, כל אזור בחירה יהיה זכאי לנציג אחד למליאת המועצה, מלבד אזורים בני יותר ב-750 בוחרים, שיהיו זכאים לבחור שני נציגים למועצה.
