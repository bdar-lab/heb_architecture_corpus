# file = txt/1500022.txt
# filelineno = 280
# sentno = 1
# text = אי הבהירות הקיימת בחוק עשויה להוביל לשלושה מצבים אפשריים של חיכוך בין הרבדים: הראשון, כאשר המועצה בוחרת לספק רק חלק מן השירותים המבוקשים על-ידי התושבים או למלא חלק מן התפקידים שהיא מוסמכת למלא; השני, כאשר שני הרבדים אינם משתמשים בסמכויותיהם ואינם ממלאים את תפקידם; והשלישי, כאשר הם מתחרים בינהם על תפקיד מסוים (אמרני, 2000).
# raw = {'id': 1, 'text': 'אי הבהירות הקיימת בחוק עשויה להוביל לשלושה מצבים אפשריים של חיכוך בין הרבדים: הראשון, כאשר המועצה בוחרת לספק רק חלק מן השירותים המבוקשים על-ידי התושבים או למלא חלק מן התפקידים שהיא מוסמכת למלא; השני, כאשר שני הרבדים אינם משתמשים בסמכויותיהם ואינם ממלאים את תפקידם; והשלישי, כאשר הם מתחרים בינהם על תפקיד מסוים (אמרני, 2000).', 'dspan': (0, 324), 'tokens': [{'id': 1, 'text': 'אי', 'upos': 'ADV', 'xpos': 'ADV', 'feats': 'Prefix=Yes', 'head': 3, 'deprel': 'compound:affix', 'dspan': (0, 2), 'span': (0, 2), 'lemma': 'אי'}, {'id': (2, 3), 'text': 'הבהירות', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'בהירות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'nsubj', 'lemma': 'בהירות'}], 'span': (3, 10), 'dspan': (3, 10)}, {'id': (4, 5), 'text': 'הקיימת', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'קיימת', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'amod', 'lemma': 'קיים'}], 'span': (11, 17), 'dspan': (11, 17)}, {'id': (6, 7), 'text': 'בחוק', 'expanded': [{'id': 6, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'ב'}, {'id': 7, 'text': 'חוק', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'nmod', 'lemma': 'חוק'}], 'span': (18, 22), 'dspan': (18, 22)}, {'id': 8, 'text': 'עשויה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (23, 28), 'span': (23, 28), 'lemma': 'עשוי'}, {'id': 9, 'text': 'להוביל', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=HIFIL|VerbForm=Inf|Voice=Act', 'head': 8, 'deprel': 'xcomp', 'dspan': (29, 35), 'span': (29, 35), 'lemma': 'הוביל'}, {'id': (10, 11), 'text': 'לשלושה', 'expanded': [{'id': 10, 'text