# file = txt/1500022.txt
# filelineno = 403
# sentno = 3
# text = לעומתם טען השר כי טובת היישוב מחייבת עריכת בחירות שייצגו את רצונם של כלל התושבים ולא רק של חברי הוועד, וכי הפתרון שהציע תואם את האמור בסעיף 37 בס"ק י'(ב) לפיו "...ימנה השר,ללא דיחוי, חבר חדש מבין האנשים הזכאים להיבחר לחברי המועצה, על פי הצעת ארגון הציבור שמטעמו נבחר החבר שמקומו נתפנה, ואם אין, לדעת השר, ארגוןכזה, ייעשה המינוי בהתחשב ברצונם של אותם אנשים שהשר רואה אותם כנציגיו של אותו ציבור".
