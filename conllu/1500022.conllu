# file = txt/1500022.txt
# filelineno = 302
# sentno = 7
# text = לפיכך הודיע ועד המושב כי פעולות המועצה בעניין החינוך נעשו שלא כדין, בהסתמך על סעיף 63 (א)(3) בצו לפיו "המועצה לא תטפל בענייני תרבות וחינוך הנוגעים לישוב אחד או לישובים אחדים אלא אם הייתה דעתם של הוועדים המקומיים, שלהנהלתם נתונים הישובים הנוגעים בדבר, נוחה מטיפול זה".
