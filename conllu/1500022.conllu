# file = txt/1500022.txt
# filelineno = 510
# sentno = 1
# text = השינוי המהותי בסוגית הבחירות לוועד המקומי בא עם בג"צ בורשטיין7, הראוי לציון משתי סיבות: ראשית, בעתירה זו, שהוגשה בשנת 1987, תוקפים העותרים לראשונה ישירות את סעיף 91 לצו המועצות האזוריות ואת עקרון זהות הוועדים; שנית, בית המשפט, שנמנע בעבר מלהתערב בענייני היישוב השיתופי, החליט לדון בשאלת האיזון הראוי בין טובת המערכת השיתופית לזכויות הפרט, וקבע בהחלטתו כי על שר הפנים לתקן את סעיף 91 כך שהבטחת האינטרס של המערכת השיתופית לא תגרום לשלילת הזכות לבחור ולהיבחר מתושבים שאינם חברי האגודה.
