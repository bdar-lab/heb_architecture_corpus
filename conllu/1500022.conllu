# text = אלה כוללות, בין השאר, את המשבר הכלכלי שהתחולל בשנות ה-80 של המאה ה-20, את שינוי סדרי העדיפות הלאומיים שבא לידי ביטוי בהיחלשות ההגנה המסורתית על ערכי ההתיישבות והמרחב הכפרי; את התגברות הלחצים להפשרת שטחים חקלאיים לצורך קליטת מיליון העולים שהגיעו ממדינות חבר העמים, ואת שינוי בסיס המימון של הרשויות המקומיות שהביא לתביעות מצד הרשויות העירוניות השכנות לספח אליהן שטחים מניבי מס מתוך המרחב הכפרי.
# raw = {'id': 4, 'text': 'אלה כוללות, בין השאר, את המשבר הכלכלי שהתחולל בשנות ה-80 של המאה ה-20, את שינוי סדרי העדיפות הלאומיים שבא לידי ביטוי בהיחלשות ההגנה המסורתית על ערכי ההתיישבות והמרחב הכפרי; את התגברות הלחצים להפשרת שטחים חקלאיים לצורך קליטת מיליון העולים שהגיעו ממדינות חבר העמים, ואת שינוי בסיס המימון של הרשויות המקומיות שהביא לתביעות מצד הרשויות העירוניות השכנות לספח אליהן שטחים מניבי מס מתוך המרחב הכפרי.', 'dspan': (554, 946), 'tokens': [{'id': 1, 'text': 'אלה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Plur|Person=3|PronType=Dem', 'head': 2, 'deprel': 'nsubj', 'dspan': (554, 557), 'span': (0, 3), 'lemma': 'זה'}, {'id': 2, 'text': 'כוללות', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PAAL|Number=Plur|Person=3|Tense=Pres|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (558, 564), 'span': (4, 10), 'lemma': 'כלל'}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (564, 565), 'span': (10, 11), 'lemma': ','}, {'id': 4, 'text': 'בין', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'dspan': (566, 569), 'span': (12, 15), 'lemma': 'בין'}, {'id': (5, 6), 'text': 'השאר', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'שאר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'obl', 'lemma': 'שאר'}], 'span': (16, 20), 'dspan': (570, 574)}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (574, 575), 'span': (20, 21), 'lemma': ','}, {'id': 8, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 10, 'deprel': 'case', 'dspan': (576, 578), 'span': (22, 24), 'lemma': 'את'}, {'id': (9, 10), 'text': 'המשבר', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 10, 'deprel': 'det', 'lemma