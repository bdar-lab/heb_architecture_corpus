# file = txt/1500022.txt
# filelineno = 477
# sentno = 1
# text = בדצמבר 2000, עתרו האגודה השיתופית נוף איילון ו-6 מחבריה אל בית המשפט בבקשה שיורה על שלושה צווים: הראשון, לבטל את החלטתו של שר הפנים לאמץ את המלצת ועדת הגבולות בראשות פרופ' ברוור שעיקרה סיפוח נוף איילון למועצה המקומית מודיעין; השני, שיורה לשר הפנים לתת מעמד מוניציפאלי עצמאי ליישוב כוועד מקומי במסגרת המועצה האזורית גזר; השלישי, שיורה על הקמת ועדה חדשה לבדיקת גבולותיו ומעמדו המוניציפאלי של היישוב נוף איילון.
