# file = txt/1500114.txt
# filelineno = 94
# sentno = 2
# text = במרכז הקונגרס עמדה היצירה הקלאסית 'גבות' (Gavot)- ריקודו של הכוריאוגרף קלום טומלינסון (Tomlinson) משנת 1720- שנכתב בכתב 'פולט' (Feuillet) ותורגם, לצורך הקונגרס, על ידי שלושת כתבי התנועה הבולטים של אותה תקופה: כתב בנש, כתב לבאן וכתב אשכול-וכמן.
