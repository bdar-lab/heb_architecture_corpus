# file = txt/1500114.txt
# filelineno = 347
# sentno = 1
# text = 1964)70 (איור 113) באמצעותו ניתן לחקור ללמוד ולהתנסות דרך אינטראקציה שבין אדם למכונה, בין אנשים לבין עצמם ואף בין מכונות לבין עצמן - הינו מעין תצוגת תכלית של אדריכלות דינאמית התלויה בזמן ובאינפורמציה, כאשר הוא שואב השראה מרעיונות 'האדריכלות המובילית' של פרידמן והגדרתם את הצורך בחברה ניידת חדשה ובמערכות תקשורת שיאפשרו לעדכן סביבות חיים קיימות.
