# file = txt/1500114.txt
# filelineno = 477
# sentno = 1
# text = לפי ובמן, חיוני שהפיתוח הפיזי והתפרוסת של מדינת ישראל יתבססו לא על עמוד שידרה יחיד, אלא על שתי שידרות מקבילות מפותחות באופן אינטנסיבי, בעלות 'קשרי אורך' חזקים בתוכן ויקשרי רוחבי חזקים ביניהן: 'שידרת החוף' ויהשידרה המיזרחית', על פי הערכתו, ככל שהמבנה רב שידרתי ובעל דרגת 'קשירות' גבוהה יותר (במונחים גיאומטריים) הוא גם בעל עדיפות ועמידות בכל הנוגע לקשרי גומלין בתוך הרקמה הפיזית, ליכולת תמרון במצבי חירום ולתחושת הביטחון של תושבי המדינה.
