# text = תחום מחקרו של גילברט היווה את גוף הידע על בסיסו ניבחן ומודען היחס שבין תהליכי מכניזציה ותיעוש לבין האדם, כשבשנת 1912 בחן באמצעותו פרדריק טיילור (Taylor) אופני ייצוג ויזואלי של תהליכי עבודה, בדגש על מיומנויות כפיים שונות המערבות הפעלת מכשור וציוד בתחומי ייצור שונים.
# raw = {'id': 2, 'text': 'תחום מחקרו של גילברט היווה את גוף הידע על בסיסו ניבחן ומודען היחס שבין תהליכי מכניזציה ותיעוש לבין האדם, כשבשנת 1912 בחן באמצעותו פרדריק טיילור (Taylor) אופני ייצוג ויזואלי של תהליכי עבודה, בדגש על מיומנויות כפיים שונות המערבות הפעלת מכשור וציוד בתחומי ייצור שונים.', 'dspan': (203, 468), 'tokens': [{'id': 1, 'text': 'תחום', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'nsubj', 'dspan': (203, 207), 'span': (0, 4), 'lemma': 'תחום'}, {'id': (2, 3), 'text': 'מחקרו', 'expanded': [{'id': 2, 'text': 'מחקר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'compound:smixut', 'lemma': 'מחקר'}, {'id': 3, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'feats': 'Case=Gen|Definite=Def|Gender=Masc|Number=Sing|Person=3|Poss=Yes|PronType=Prs', 'head': 2, 'deprel': 'nmod:poss', 'lemma': 'ו'}], 'span': (5, 10), 'dspan': (208, 213)}, {'id': 4, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 5, 'deprel': 'case:gen', 'dspan': (214, 216), 'span': (11, 13), 'lemma': 'של'}, {'id': 5, 'text': 'גילברט', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'nmod:poss', 'dspan': (217, 223), 'span': (14, 20), 'lemma': 'גילברט'}, {'id': 6, 'text': 'היווה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PIEL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (224, 229), 'span': (21, 26), 'lemma': 'היווה'}, {'id': 7, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 8, 'deprel': 'case', 'dspan': (230, 232), 'span': (27, 29), 'lemma': 'את'}, {'id': 8, 'text': 'גוף', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'obj', 'dspan': (233, 236), 'span': (30, 33), 'lemma': 'גוף'}, {'id': (9, 10), 'text': 'הידע', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 10, 'deprel': 'det', '