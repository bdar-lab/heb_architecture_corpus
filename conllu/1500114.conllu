# file = txt/1500114.txt
# filelineno = 374
# sentno = 1
# text = לצורך דיון בסוגיות אלה חוזר המחקר ומתחקה בפרק זה אחר הפילוג בתוך הפרדיגמה בין אלה שעסקו בצורות ובאדריכלות באי גדולה ('המעצבים') ובין אדריכלי הזרם האנטי-סגנוני שעסקו בתהליכים, בפרוגראמות ('הענייניים): בעוד הקבוצה הראשונה ערכה דיאלוג עם גוף הידע האדריכל, המסורתי, כתב התנועה אשכול-וכמן הפגין הלך מחשבה דומה לזה של חברי הקבוצה השנייה שקראו לטשטוש הגבולות בין אדריכלות לתחומים אחרים, התבססו על שיטה, תבנית ושפה אוניברסאלית מדעית והטיפו לאנטי סגנוניות.
