# file = txt/1500114.txt
# filelineno = 102
# sentno = 2
# text = דוגמא אחת לכך היא הבלט של אוסקר שלמר (Schlemmer) שפעל בביה"ס הבאוהאוס בין 1912-1928 שהציג אסטטיקה של מונטאג' ועסק בהתאם ביציקת התכנים של מושג המכונה אל תוך הדמות האנושית בהשפעת רעיונות הדאדא, הרובוטים וייצוגים טכנולוגים של סוף שנות ה-20 , וכן במעבר התפיסתי מאדם כאינדיבידואל לישות שהיא קבוצה.
