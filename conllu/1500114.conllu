# file = txt/1500114.txt
# filelineno = 200
# sentno = 1
# text = מבחינה זו, כתב התנועה אשכול-וכמן מציע אלטרנטיבה: בהסתמך על נוטציה ככלי המאפשר רישום מבנה בתנועה והשתנות מתמדת הוא מציג חשיבה יצירתית של המרחב דרך תהליכי מידול המתבססים על עקרונות 'דיגיטאליים', (איורים 57,58) בעצם היותו מאפשר חוקיות ברורה, מקורית וקריאה לא רק לילא ידוע' כי אם גם לדבר יחסר הצורה המוגדרת', קיימת אפשרות לתכנן אירוע מרחבי, לייצר תרחיש, לתזמן ולמרחב את הדבר הארעי, הזמני.
