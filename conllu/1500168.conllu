# text = ועדת תכנון ובנייה, מר גלבהרט, ועדת תכנון ובנייה לא יודעת כלום על העניין הזה, שום דבר, אפילו לא מילה אחת, ורק יום שני השבוע, בשבוע שעבר התכנסנו לעדכן, לדבר, לפתוח, גילוי נאות על הדברים, להחדיר, חלק מהם יושבים פה ואתם עדיין צריכים... מביאים ספר טלפונים, זה דבר... איפה אנחנו חיים! התוכנית העתידית שרוצים בגדול להוריד בניינים ולעלות, להגיע ל-1,400,1,300 דירות בברל כנצנלסון.
# raw = {'id': 2, 'text': 'ועדת תכנון ובנייה, מר גלבהרט, ועדת תכנון ובנייה לא יודעת כלום על העניין הזה, שום דבר, אפילו לא מילה אחת, ורק יום שני השבוע, בשבוע שעבר התכנסנו לעדכן, לדבר, לפתוח, גילוי נאות על הדברים, להחדיר, חלק מהם יושבים פה ואתם עדיין צריכים... מביאים ספר טלפונים, זה דבר... איפה אנחנו חיים! התוכנית העתידית שרוצים בגדול להוריד בניינים ולעלות, להגיע ל-1,400,1,300 דירות בברל כנצנלסון.', 'dspan': (236, 607), 'tokens': [{'id': 1, 'text': 'ועדת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 14, 'deprel': 'nsubj', 'dspan': (236, 240), 'span': (0, 4), 'lemma': 'ועדה'}, {'id': 2, 'text': 'תכנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'compound:smixut', 'dspan': (241, 246), 'span': (5, 10), 'lemma': 'תכנון'}, {'id': (3, 4), 'text': 'ובנייה', 'expanded': [{'id': 3, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 4, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 4, 'text': 'בנייה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'conj', 'lemma': 'בנייה'}], 'span': (11, 17), 'dspan': (247, 253)}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (253, 254), 'span': (17, 18), 'lemma': ','}, {'id': 6, 'text': 'מר', 'upos': 'NOUN', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'appos', 'dspan': (255, 257), 'span': (19, 21), 'lemma': 'מר'}, {'id': 7, 'text': 'גלבהרט', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 6, 'deprel': 'appos', 'dspan': (258, 264), 'span': (22, 28), 'lemma': 'גלבהרט'}, {'id': 8, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (264, 265), 'span': (28, 29), 'lemma': ','}, {'id': 9, 'text': 'ועדת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 14, 'deprel': 'nsubj', 'dspan': (266, 270), 'span': (30, 34), 'lemma': 'ועדה'}, {'id': 10, 'text': 'תכנון', 'upos': 'NOUN', 'xpos'