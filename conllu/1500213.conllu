# file = txt/1500213.txt
# filelineno = 961
# sentno = 4
# text = כשאני עוד ראית• את זה כ-, זה המצב הקיים, זו הקריאה שלי... אבל, אה, ההנחיה שקיבלתי היא כבר הייתה כמה שלבים קדימה לתוך ההתערבות, שאני חושבת שהיה צריך להעמיק יותר בשלב של החקירה, במיוחד בגלל שאנחנו מתעסקים עם מבנים קיימים ושימוש מחדש במבנה.
