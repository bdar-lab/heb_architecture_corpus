# file = txt/1500213.txt
# filelineno = 82
# sentno = 3
# text = הוא מעלה מספר תחומים שבהם הדבר בא ליד׳ ביטוי: יחסי הכוח בין מרצה לסטודנט הנבנים על מנת לאפשר דמוקרטיזציה של הסטודיו; תהליך מתן ביקורת בין מנחה לסטודנט ובין הסטודנטים לבין עצמם; איזון הכוח בין סטודנטים לבין עצמם בפרויקטים הנעשים במשותף והיכולת הנלמדת של הסטודנט לווסת בתהליך קבלת ההחלטות בין המשמעות הסובייקטיבית שהוא נותן לדברים לזו של המנחה ו/או הקבוצה.
