# file = txt/1500213.txt
# filelineno = 57
# sentno = 6
# text = בהשוואה לכך, הגישה המיוצגת על ידי Simon (סימון) והפרדיגמה הפוזיטיביסטית, אמנם מכירות בייחודן של בעיות התכנון, אך מגדירות אותן כבעיות שאינן מובנות היטב (Ill-structured problems) ורואות בתכנון פעילות כמו מדעית, שמטרתה תהליך פתרון שיטת׳ ומובנה של בעיות: תהליך הכולל ניתוח אנליטי, סינתזה, החלטה והיזון חוזר, השואף למצוא נוסחה לפתרון (1992 ,Simon, 1973) (Buchanan) .
