# file = txt/1500078.txt
# filelineno = 76
# sentno = 2
# text = הבנה נכונה של הקשר הזה תשפר את תהליך עבודתו של המעצב מול החברה המסחרית וכמו כן תשפר את תהליך גיוס העובדים ואף את תשפיע על מערך הציפיות שהמועסק הפוטנציאלי בונה לעצמו כלפי מעסיק מסוים, דבר שעשוי להשפיע על אופי קליטת העובד בארגון והאם יבחר מלכתחילה להגיש את מועמדותו לארגון זה או אחר.
