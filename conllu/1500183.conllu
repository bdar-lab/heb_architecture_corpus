# file = txt/1500183.txt
# filelineno = 118
# sentno = 1
# text = אך בבואנו לדון ב״חוויה״, מסתבר שזו ״נופלת״ בין שני הכסאות ו״אנו יודעים עליה בעצם מעט מאוד״ (הררי 2015 עמי 414), שכן בניגוד לחשיבה המקובלת, חוויה אינה רק משהו המתקיים ב״נפש" אלא היא תמיד כרוכה גם ב״פעולה בעולם״.
