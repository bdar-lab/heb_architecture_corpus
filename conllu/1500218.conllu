# file = txt/1500218.txt
# filelineno = 109
# sentno = 2
# text = על פי ההגדרות השונות, מקור ייצור אנרגיה יכול להימצא בגבולות תכסית הבניין או בתחומי המגרש המתוכנן, עם זאת ניתן לרכוש אנרגיה "ירוקה" מחוץ לגבולות המגרש או לייבא מקור אנרגיה מתחדשת, ביו מסה, אתנול או אחר, כאשר תהליך ייצור האנרגיה מתבצע בתחומי המגרש.
