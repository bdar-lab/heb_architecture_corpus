# file = txt/2300116.txt
# filelineno = 795
# sentno = 1
# text = דרך שניה להחלטה היא להכיר בכך שלשתי התפישות (א ו־ב) יש הצדקות ותומכים ולכן בשלב ראשון יש ללכת בשתיהן בעת ובעונה אחת, אך רצוי לעשות זאת בצורה שבמשך הזמן תהיה אפשרות להדגיש את האחת או השנייה,; כמו כן רצוי למנוע בשלב זה את החסרונות החמורים ביותר שבכל אחת מהן, ורצוי להפיק את היתרונות המירביים בכל פעולה שבכל אחת מהן.
