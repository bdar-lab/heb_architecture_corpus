# file = txt/2800017.txt
# filelineno = 338
# sentno = 1
# text = בהתאם להנחת הייסוד על פעולת מרכיביה השונים של "מערכת המיגבלות" המשפיעה על שיקוליו ההיפוטטיים של הפרט בדבר מקום המגורים הרצוי והאפשרי, ניתן לומר כי במקרה שלפנינו שילוב של כמה מהמרכיבים הללו העניק בפועל "כוח משיכה" גבוה במיוחד לאותו יישוב עולים ופיתוח, אשר שנים מעטות בלבד לפני כן לא היה אלא ציבור של צריפים ואתר של בנייה חפוזה ומעוטת פיתוח בנוף שומם למדי, זאת, אפילו בהשוואה לערים וותיקות ומבוססות המצויות במרחק גישה נוח מהמרכז העירוני הדומיננטי של הארץ.
