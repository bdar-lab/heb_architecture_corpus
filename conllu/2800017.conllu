# text = ההתערבות הממשלתית, באמצעות השימוש במרכיב המחיר הכספי של מערכת המגבלות ובאמצעות צעדים אחרים שנזכירם להלן, יעילה אם כן רק בגבולות מסויימים; יתר על כן, כפי שנראה להלן, גם מרכיב "כספי״ זה - וגם המרכיבים האחרים של מערכת המיגבלות - אין להם בהכרח ערך משפיע כשהם לעצמם.
# raw = {'id': 1, 'text': 'ההתערבות הממשלתית, באמצעות השימוש במרכיב המחיר הכספי של מערכת המגבלות ובאמצעות צעדים אחרים שנזכירם להלן, יעילה אם כן רק בגבולות מסויימים; יתר על כן, כפי שנראה להלן, גם מרכיב "כספי״ זה - וגם המרכיבים האחרים של מערכת המיגבלות - אין להם בהכרח ערך משפיע כשהם לעצמם.', 'dspan': (0, 261), 'tokens': [{'id': (1, 2), 'text': 'ההתערבות', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'התערבות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 27, 'deprel': 'nsubj', 'lemma': 'התערבות'}], 'span': (0, 8), 'dspan': (0, 8)}, {'id': (3, 4), 'text': 'הממשלתית', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'ממשלתית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'amod', 'lemma': 'ממשלתי'}], 'span': (9, 17), 'dspan': (9, 17)}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 8, 'deprel': 'punct', 'dspan': (17, 18), 'span': (17, 18), 'lemma': ','}, {'id': 6, 'text': 'באמצעות', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'dspan': (19, 26), 'span': (19, 26), 'lemma': 'באמצעות'}, {'id': (7, 8), 'text': 'השימוש', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'שימוש', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'nmod', 'lemma': 'שימוש'}], 'span': (27, 33), 'dspan': (27, 33)}, {'id': (9, 10), 'text': 'במרכיב', 'expanded': [{'id': 9, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ב'}, {'id': 10, 'text': 'מרכיב', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 8, 'deprel': 'nmod', 'lemma': 'מרכיב'}], 'span': (34, 40), 'dspan': (34, 40)}, {'