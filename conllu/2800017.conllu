# file = txt/2800017.txt
# filelineno = 91
# sentno = 2
# text = למטרות מעשיות, יכול לשמש כמדד למשיכה זו המאזן של תנועת התושבים אל היישוב וממנו: הוא מבטא גם את האפשרות שתושבים אשר הופנו ליישוב המסויים, וכן תושבים אשר גדלו באותו היישוב מגיל רך, עזבוהו למטרת השתכנות ביישוב אחר (או שהם ממשיכים להתגורר בו), וגם את האפשרות שתושבים נוספים מגיעים ליישוב, מרצונם, מיישובים אחרים.
