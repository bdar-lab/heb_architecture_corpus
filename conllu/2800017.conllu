# file = txt/2800017.txt
# filelineno = 25
# sentno = 1
# text = לבחינת אמיתותה של הנחת היסוד האמורה שימשה בדיקה אמפירית לגבי מידת התלות הקיימת בין הדגם של ה"פיזור הגיאוגרפי הדינמי" של האוכלוסיה בין היישובים והאיזורים השונים, לבין מספר מישתנים בתחום החברתי-כלכלי והגיאוגרפי־ מישתנים אלה הם - הם המייצגים את פעולת המרכיבים השונים של מערכת המיגבלות: בה במידה שאמנם נמצא קשר מובהק ביניהם לבין דגם הפיזור הדינמי של המגורים בין היישובים והאזורים השונים, הרי מלמד הדבר על תקפותן של אותן מיגבלות מרכזיות, והן אמנם מצמצמות את "חופש הבחירה" של הפרט לגבי מקום המגורים הרצוי ביותר והאפשרי לגביו, מעל ומעבר להשפעת גורמים אחרים על שיקוליו האישיים־
