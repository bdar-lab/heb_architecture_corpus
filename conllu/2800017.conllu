# file = txt/2800017.txt
# filelineno = 80
# sentno = 1
# text = העובדה, שלפחות חלק מהמרכיבים הם מניפולטיביים, וניתנים להפעלה ותימרון ע״י הגופים המתכננים וקובעי המדיניות, יש לה חשיבות לגבי אותם היישובים שבהם הממיצאים הרלבנטיים סווגו בציונים שליליים לגבי "כוח המשיכה" המקומי; באמצעות אותם המרכיבים ניתן להביא לשינויים חיוביים ביישובים אלה, בגבולות מסויימים המוכתבים ע״י גורמי פוטנציאל הפיתוח המקומי.
