# file = txt/2800017.txt
# filelineno = 34
# sentno = 1
# text = כלי עזר מעין זה שנוסה בעבודה הנוכחית עשוי לבוא כהשלמה להפעלתם של מודלים מתמטיים המספקים נתונים כמותיים לצורך הכנתן של תוכניות הפיתוח־ זאת, מכיוון שאין הוא עצמו בנוי כדי לספק נתונים כאלה, אך מאידך גיסא עשוי "דגם התנהגותי" כזה להצביע על גורמים המשפיעים על מגמות ההתפתחות בכיוון זה או אחר ביישוב נתון, בתוך הקונטקסט האזורי שלו, הן לגבי העבר והן לצורך תחזיות לגבי העתיד־ ובכך הוא עשוי לסייע למאצמים להשפיע על ההתפתחות בכיוון הנראה למתכנן כהולם את מטרות התיכנון העקריות לגבי היישוב הנתון־
