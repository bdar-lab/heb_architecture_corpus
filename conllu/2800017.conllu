# file = txt/2800017.txt
# filelineno = 97
# sentno = 1
# text = כמו כן מבהיר הלוח דלעיל, וכן גם לוח מס' 2, ש"מדד המשיכה" אף איננו פועל יוצא של גודל האוכלוסיה המקומית בתאריך מסויים - ויוכיחו המקרים של תל-אביב-יפו, מזה, וטבריה מזה, לעומת אשדוד ודימונה שבהן ניצפה "מדד משיכה" גבוה כבר בתקופה שהיישוב בהן היה עדיין קטן ביותר.
