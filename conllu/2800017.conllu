# file = txt/2800017.txt
# filelineno = 98
# sentno = 1
# text = ואילו לגבי טבריה, אשר מבחינת גודלה ה"התחלתי" ומבחינות אחרות נוספות הקשורות בגרעין האוכלוסיה הוותיק הניכר שבמקום, ודאי שהיו לה יתרונות בתחום "כוח המשיכה" לעומת יישובי עולים ופיתוח קטנים וחדשים באשדוד ודימונה (במצבן ה"התחלתי"), מסבירים בעיקר מרכיבי המערכת ב' ו-ג, שלהלן את מאזן התנועה המקומי שלה, האדיש (ואף שלילי), כפי שהוצג בלוח שאנו דנים בו, בשנים 67—1963.
