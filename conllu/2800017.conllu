# file = txt/2800017.txt
# filelineno = 255
# sentno = 1
# text = פעולת "הגורם הממתן" האפשרי במצב מעין זה (התאמת פעולות הכשרה מקצועיות והשכלתיות לכישורים נדרשים במקום או באיזור) היתה מוגבלת למדי: נמצא כי מעל למחצית מבני הנוער בגילי 15-18 שנים עבדו בעבודות עונתיות (בחקלאות, בעיקר בנות) או "לא עבדו ולא למדו"; ואילו רק פחות מחמישית מכלל בני הנוער עבדו בתנאי חניכות בחרושת ומלאכה, כלומר הכינו עצמם לתחומים המקצועיים שתאמו את המתכונת הסלקטיבית האזורית של מקורות התעסוקה.
