# file = txt/2800017.txt
# filelineno = 332
# sentno = 2
# text = ללא זאת, יש להניח כי המרחקים הקצרים יחסית מהיישוב החדש, הקטן, ליישובים אחרים וותיקים ומבוססים— ואף המרחק הלא גדול לריכוז של "מקומות מרכזיים" במסגרת הארצית — היו מקשים ביותר על התחרות של עיר העולים המקומית החדשה, ב"שוק מקומות המגורים הארצי", מול יישובים מתחרים גדולים; בישובים "מתחרים" אלה, מחיר ההשתכנות הנוח יותר (במונחים הלא-כספיים), היה ללא ספק גורם השקול כנגד ההטבות הכספיות שניתנו למשתכנים הפוטנציאליים בעיר החדשה.
