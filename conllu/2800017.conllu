# file = txt/2800017.txt
# filelineno = 159
# sentno = 1
# text = ואילו ביישובים ובאזורים שהמרחק ביניהן לבין נקודות המוקד של המערכת החברתית-כלכלית הארצית גדול יחסית (יישובי הפיתוח בדרום ובצפון), ניתן לדבר כפי שנאמר לעיל אף על מחיר "שלילי", כביכול, של אתר מסויים כמקום מגורים: כאשר הפרט המשתכן נהנה מסובסידיות ניכרות; תנאי מימון נמוכים מתנאי השוק; הקלות ממסים ממשלתידם וכו , למעשה "משלמים" לו על מנת שלא יגור במקום אחר.
