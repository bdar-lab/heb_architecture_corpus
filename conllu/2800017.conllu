# file = txt/2800017.txt
# filelineno = 287
# sentno = 1
# text = נראה, כמו כן, כסביר להניח כי שיקולים כאלה פעלו אף ביתר תוקף לגבי אותו חלק מקרב בני הנוער המקומי אשר התבסס במעמדו המקצועי והסוציו-כלכלי בעקבות תהליך הסתגלות חברתית וכלכלית לתנאי הארץ; לגבי אלה, אף ההיקף הפוטנציאלי של תעסוקה התואמת את כישוריהם המקצועיים האישיים היה קטן ביותר, כאמור; הרמה הנמוכה של המנהיגות המקומית, שנזכרה לעיל, ודאי השלימה את התמונה בהקשר זה, בנוסף למימצאי ניתוח האפשרויות הפוטנציאליות המצומצמות של היישוב לגבי מילוי תיפקודים "אקטיביים" כלשהם בעתיד הנראה לעין.
