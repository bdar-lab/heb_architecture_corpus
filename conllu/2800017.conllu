# file = txt/2800017.txt
# filelineno = 83
# sentno = 1
# text = מכל מקום, אין הכוונה בשום פנים ל"התרשמות" אישית גרידא של האדם האוסף ומנתח את המידע, ואף לא ל"חוות דעה" של מספר תושבים או אנשי רשות מקומית: בשני המקרים ללא סקר משלים מקיף ושיטתי, אין ערך ל"מידע" כזה.
