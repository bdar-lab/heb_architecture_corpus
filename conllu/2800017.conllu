# file = txt/2800017.txt
# filelineno = 92
# sentno = 1
# text = הבחינה האמפירית מלמדת, כי מדד משיכה נמוך (או שלילי) ביישוב מסויים אכן יכול להחשב כמגבלה על "חופש הבחירה" של משתכנים פוטנציאליים לגבי ישוב זה: כפי שמראה לוח 5 להלן, בישובים מסויימים שפועלים לגביהם באורח שלילי המרכיבים האחרים הנוספים של מערכת המיגבלות, אם גם הופנו אליהם תושבים־עולים בהיקף ניכר (אבסולוטית ויחסית לגודל האוכלוסיה), הרי המדד המקומי הנמוך של "המשיכה למטרות השתכנות" מתבלט כעבור תקופת מה ומתמיד לאורך זמן - כל עוד פועלת על אותם היישובים מערכת המגבלות.
