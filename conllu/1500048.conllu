# file = txt/1500048.txt
# filelineno = 453
# sentno = 2
# text = אולם מחקרים אמפיריים מלמדים, ובהם גם זה של לינץ׳, כי במקרים רבים אפשר לזהות מפות הכרתיות קולקטיביות, כאלה המייצגות את מה שמכונה ע״י לינץ׳ “public image” - דימוי ציבורי, דימוי שמשותף לקבוצה גדולה של אנשים, תושבים, במקרה הזה, ובא לידי ביטוי ב"אזורי הסכמה" שניתן לאתר במפה ההכרתית של כל תושב ותושב בעיר מסוימת.
