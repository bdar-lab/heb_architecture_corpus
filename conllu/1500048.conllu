# file = txt/1500048.txt
# filelineno = 478
# sentno = 10
# text = דרך זו להבעת הזהות ההומו-לסבית במרחב העירוני מופיעה גם במפות של הומואים ולסביות אחרים, ומתחזקת בעקבות השיחות שקיימתי עימם לאחר ציור המפות, באופן שמקומות הבילוי והמפגש כמו ברים, מועדונים, גן העצמאות או אזורי הבילוי בדרום העיר הופכים במפות ההכרתיות לסימבול המייצג זהות הומו- לסבית.
