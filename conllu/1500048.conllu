# file = txt/1500048.txt
# filelineno = 560
# sentno = 1
# text = •	יש לשים לב ולהבין כי פרויקטים חברתיים בעלי חשיבות לקהילה ההומו-לסבית עשויים לסבול מעוינות ודחייה של גורמים אחרים באוכלוסיה (תסמונת NIMBY), כך למשל פרויקטים כגון דיור לנוער הומו-לסבי, שירותים לנשאי איידס, דיור לקשישים וכדומה.
