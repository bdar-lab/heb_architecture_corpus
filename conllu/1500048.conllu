# file = txt/1500048.txt
# filelineno = 34
# sentno = 5
# text = תנועות המחאה והתנועות החברתיות הרדיקליות שקמו בארצות הברית של שנות השישים – התנועה לשחרור השחורים, תנועת הסטודנטים והתנועה לשחרור נשים, וכן תרבות הנגד שיצרו תנועות אלו יצרו מצע מתאים לתנועת המאבק לשיוויון ההומו-לסבית ( Gay Liberation Movement) כתנועה פוליטית רדיקלית (1995 ,Bell and Valentine).
