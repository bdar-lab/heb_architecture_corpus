# file = txt/1800080.txt
# filelineno = 181
# sentno = 1
# text = כפי שנראה בפרק 5, על-מנת להגיע לנקודת איזון כלכלית נוחה – מבחינת הדיירים (שיוכלו לקבל שידרוג משמעותי, ובחינם), מבחינת היזם-קבלן (שיוכל לעשות רווח סביר), מבחינת הרשויות המקומיות (שתוכלנה לגבות היטלי-השבחה) ומבחינת אוצר המדינה (שיוכל לגבות מס שבח מקרקעין) – מספר הדירות החדשות שצריך להוסיף לבניין הקיים בפרוייקט שידרוג אופייני, הוא כמחצית ממספר הדירות שהיו בו לפני השידרוג.
