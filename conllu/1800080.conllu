# file = txt/1800080.txt
# filelineno = 412
# sentno = 2
# text = ההפרש של $500 בין המחיר של הדירות הישנות הקיימות לבין המחיר של הדירות החדשות הוערך בצורה זהירה, והוא נובע משלושה מרכיבים ראשיים: (א) התוספות של מרפסות גדולות, שאינן נחשבות באחוזי הבנייה לדירות הפנטהאוז, והתוספות של הגינות הפרטיות הצמודות לדירות הקרקע; (ב) העובדה שמדובר בדירות חדשות לגמרי בבניין מחודש לגמרי; (ג) הרוכשים החדשים מקבלים יחד עם הדירה גם מחסן פרטי, מקומות חניה צמודים, מעלית, ממ"ד ועוד שאינם בדירות הישנות.
