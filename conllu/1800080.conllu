# file = txt/1800080.txt
# filelineno = 324
# sentno = 3
# text = על-פי-רוב, אחוז הגידול בערך הדירה יהיה גדול מאחוז הגידול בשטח הדירה, משום שהדירה המשודרגת תהיה, לא רק גדולה יותר, אלא גם בבית יפה, משופץ, מודרני, מעודכן (כמעט כמו בית חדש, ולעתים אף יותר מבית חדש רגיל), עם מעלית, עם ממ"ד תקני, עם חיזוק בדוק ומאושר נגד רעידות אדמה, עם מקומות חנייה צמודים לכל דירה, עם חזית מטופחת, עם חצר מטופחת, וגם – ממוקם בתוך שכונה הרבה יותר מטופחת (משום שבתוך שנים אחדות, הרבה בניינים בשכונה יעברו שידרוג, ולכן תעלה יוקרתה של השכונה כולה, והמחירים – יעלו גם הם בהתאם).
