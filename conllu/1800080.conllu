# file = txt/1800080.txt
# filelineno = 8
# sentno = 4
# text = תוכנית ממלכתית נרחבת לשידרוג בניינים קיימים (שתהיה גורפת במובן החיובי), תוכל לשנות ממש את פני המדינה לטובה: במקום המראה, הנפוץ כל-כך במקומותינו, של ניוון ועזובה בשכונות וותיקות ושל בתים משותפים מוזנחים ומתדרדרים, יתקבל בהדרגה מראה כללי מלבב של התרעננות והתחדשות מתמדת, של בתים מטופחים, של רחובות עמוסים פחות במכוניות חונות, של תנועה זורמת טוב יותר ושל שירותים קהילתיים משופרים, הן בזכות שידרוגם הפיסי והן בזכות הגדלת המספר והמגוון של המשתמשים בהם.
