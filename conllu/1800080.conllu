# text = דוגמאות קיצוניות אלו, הן היוצא מן הכלל, אשר מעיד על הכלל, והוא: במדינת ישראל של ראשית שנות האלפיים, המצב הוא עדיין כזה שאוכלוסייה של כ- 6 מיליון תושבים מצטופפת בכ- 5 מיליון חדרי מגורים, בעוד שבמדינות מערב אירופה המפותחות, אוכלוסייה דומה של 6 מיליון תושבים משתמשת בכ- 10 מיליון חדרי מגורים (פי שניים מאשר במדינת ישראל!), ובארה"ב - משתמשת אוכלוסייה דומה של 6 מיליון תושבים בכ13- מיליון חדרים! אף שהמספרים הללו התקבלו על-פי שיטות מדידה שונות במדינות השונות (מבחינת ההגדרות של "חדר" או "חצי חדר", למשל), ואע"פ שאינם מדויקים לגמרי, בכל זאת – המשמעות החמורה שלהם היא, שעל-פי סטנדרט מגורים מערבי מקובל אנו גרים, וכנראה עוד נמשיך לגור שנים רבות, בצפיפות דיור נחותה, שאינה הולמת את היכולות הכלכליות שלנו – היום ובעתיד.
# raw = {'id': 3, 'text': 'דוגמאות קיצוניות אלו, הן היוצא מן הכלל, אשר מעיד על הכלל, והוא: במדינת ישראל של ראשית שנות האלפיים, המצב הוא עדיין כזה שאוכלוסייה של כ- 6 מיליון תושבים מצטופפת בכ- 5 מיליון חדרי מגורים, בעוד שבמדינות מערב אירופה המפותחות, אוכלוסייה דומה של 6 מיליון תושבים משתמשת בכ- 10 מיליון חדרי מגורים (פי שניים מאשר במדינת ישראל!), ובארה"ב - משתמשת אוכלוסייה דומה של 6 מיליון תושבים בכ13- מיליון חדרים! אף שהמספרים הללו התקבלו על-פי שיטות מדידה שונות במדינות השונות (מבחינת ההגדרות של "חדר" או "חצי חדר", למשל), ואע"פ שאינם מדויקים לגמרי, בכל זאת – המשמעות החמורה שלהם היא, שעל-פי סטנדרט מגורים מערבי מקובל אנו גרים, וכנראה עוד נמשיך לגור שנים רבות, בצפיפות דיור נחותה, שאינה הולמת את היכולות הכלכליות שלנו – היום ובעתיד.', 'dspan': (541, 1250), 'tokens': [{'id': 1, 'text': 'דוגמאות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 7, 'deprel': 'nsubj', 'dspan': (541, 548), 'span': (0, 7), 'lemma': 'דוגמה'}, {'id': 2, 'text': 'קיצוניות', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Plur', 'head': 1, 'deprel': 'amod', 'dspan': (549, 557), 'span': (8, 16), 'lemma': 'קיצוני'}, {'id': 3, 'text': 'אלו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem,Masc|Number=Plur|Person=3|PronType=Dem', 'head': 1, 'deprel': 'det', 'dspan': (558, 561), 'span': (17, 20), 'lemma': 'זה'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 7, 'deprel': 'punct', 'dspan': (561, 562), 'span': (20, 21), 'lemma': ','}, {'id': 5, 'text': 'הן', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Plur|Person=3|Polarity=Pos', 'head': 7, 'deprel': 'cop', 'dspan': (563, 565), 'span': (22, 24), 'lemma': 'הוא'}, {'id': (6, 7), 'text': 'היוצא', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'יוצא', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'lemma': 'יוצא'}], 'sp