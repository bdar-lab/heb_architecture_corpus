# text = המשותף הוותיקים, לשקול ברצינות את האופציה לקבל על עצמם כמה שכנים חדשים, ובתמורה לכך לקבל – בחינם, או כמעט בחינם – לא רק דירה מוגדלת, שערכה בשוק יהיה גבוה בהרבה מערך דירתם הנוכחית, אלא גם ביטחון אישי (ממ"ד וחיזוק הבניין נגד רעידות אדמה), נוחות חיים (למשל, מעלית), רווחת מגורים יום-יומית להם ולבני ביתם, ויתרונות רבים נוספים, כמו: מחסן צמוד וחנייה צמודה בתוך תחומי המגרש, שיהוו חלק אינטגרלי של תוכנית השידרוג.
# raw = {'id': 1, 'text': 'המשותף הוותיקים, לשקול ברצינות את האופציה לקבל על עצמם כמה שכנים חדשים, ובתמורה לכך לקבל – בחינם, או כמעט בחינם – לא רק דירה מוגדלת, שערכה בשוק יהיה גבוה בהרבה מערך דירתם הנוכחית, אלא גם ביטחון אישי (ממ"ד וחיזוק הבניין נגד רעידות אדמה), נוחות חיים (למשל, מעלית), רווחת מגורים יום-יומית להם ולבני ביתם, ויתרונות רבים נוספים, כמו: מחסן צמוד וחנייה צמודה בתוך תחומי המגרש, שיהוו חלק אינטגרלי של תוכנית השידרוג.', 'dspan': (0, 407), 'tokens': [{'id': (1, 2), 'text': 'המשותף', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'משותף', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'nsubj', 'lemma': 'משותף'}], 'span': (0, 6), 'dspan': (0, 6)}, {'id': (3, 4), 'text': 'הוותיקים', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'וותיקים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'dep', 'lemma': 'ותיק'}], 'span': (7, 15), 'dspan': (7, 15)}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (15, 16), 'span': (15, 16), 'lemma': ','}, {'id': 6, 'text': 'לשקול', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PAAL|VerbForm=Inf|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (17, 22), 'span': (17, 22), 'lemma': 'שקל'}, {'id': (7, 8), 'text': 'ברצינות', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 8, 'text': 'רצינות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'obl', 'lemma': 'רצינות'}], 'span': (23, 30), 'dspan': (23, 30)}, {'id': 9, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 11, 'deprel': 'case', 'dspan': (31, 33), 'span': (31, 33), 'lemma': 'את'}, {'id': (10, 11), 'text': 