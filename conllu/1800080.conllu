# text = ברם, מאחר שבעשורים הקודמים נבנו דירות קטנות בהרבה (הגודל הממוצע של כל מלאי הדירות בישראל בשנת 1989 היה כ80- מ"ר בלבד!), הרי שחיוץ (אקסטרפולציה) של עשר שנים לתוך העתיד הוביל לתוצאה המוזרה שהגודל הממוצע של הדירות אשר תיבננה בשנת 2000 צפוי להיות יותר מ250- מ"ר! תוצאה זו נראתה לי מוגזמת, והרגשתי צורך לנסות ולהבין את הגורמים לקצב הגידול המואץ – בעיקר במהלך שנות השמונים – מצד אחד, ואת המכניזם אשר עתיד, כנראה, לבלום את קצב הגידול המהיר הזה – מצד שני.
# raw = {'id': 4, 'text': 'ברם, מאחר שבעשורים הקודמים נבנו דירות קטנות בהרבה (הגודל הממוצע של כל מלאי הדירות בישראל בשנת 1989 היה כ80- מ"ר בלבד!), הרי שחיוץ (אקסטרפולציה) של עשר שנים לתוך העתיד הוביל לתוצאה המוזרה שהגודל הממוצע של הדירות אשר תיבננה בשנת 2000 צפוי להיות יותר מ250- מ"ר! תוצאה זו נראתה לי מוגזמת, והרגשתי צורך לנסות ולהבין את הגורמים לקצב הגידול המואץ – בעיקר במהלך שנות השמונים – מצד אחד, ואת המכניזם אשר עתיד, כנראה, לבלום את קצב הגידול המהיר הזה – מצד שני.', 'dspan': (577, 1024), 'tokens': [{'id': 1, 'text': 'ברם', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 49, 'deprel': 'cc', 'dspan': (577, 580), 'span': (0, 3), 'lemma': 'ברם'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (580, 581), 'span': (3, 4), 'lemma': ','}, {'id': 3, 'text': 'מאחר', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 9, 'deprel': 'mark', 'dspan': (582, 586), 'span': (5, 9), 'lemma': 'מאחר'}, {'id': (4, 6), 'text': 'שבעשורים', 'expanded': [{'id': 4, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 3, 'deprel': 'fixed', 'lemma': 'ש'}, {'id': 5, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'case', 'lemma': 'ב'}, {'id': 6, 'text': 'עשורים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 9, 'deprel': 'obl', 'lemma': 'עשור'}], 'span': (10, 18), 'dspan': (587, 595)}, {'id': (7, 8), 'text': 'הקודמים', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'קודמים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 6, 'deprel': 'amod', 'lemma': 'קודם'}], 'span': (19, 26), 'dspan': (596, 603)}, {'id': 9, 'text': 'נבנו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=NIFAL|Number=Plur|Person=3|Tense=Past|Voice=Mid', 'head': 49, 'deprel': 'advcl', 'dspan': (604, 608), 'span': (27, 31), 'lemma': 'נבנה'}, {'id': 1