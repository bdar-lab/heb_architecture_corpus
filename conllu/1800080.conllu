# raw = {'id': 1, 'text': 'השידרוג הבסיסי יהיה בהיקף מצומצם, ויכלול, בעיקר, הוספת חדר ממ"ד מרווח לכל דירה (כ-15 מ"ר, שעלותו אינה גבוהה, אלא במעט מחדרון ממ"ד מינימלי של 8 מ"ר) ורצוי להוסיף גם מרפסות לסירוגין, ולאפשר תוך כדי כך – חיזוק של הבניין בפני רעידות אדמה.', 'dspan': (0, 234), 'tokens': [{'id': (1, 2), 'text': 'השידרוג', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'שידרוג', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'nsubj', 'lemma': 'שידרוג'}], 'span': (0, 7), 'dspan': (0, 7)}, {'id': (3, 4), 'text': 'הבסיסי', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'בסיסי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'amod', 'lemma': 'בסיסי'}], 'span': (8, 14), 'dspan': (8, 14)}, {'id': 5, 'text': 'יהיה', 'upos': 'AUX', 'xpos': 'AUX', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Sing|Person=3|Polarity=Pos|Tense=Fut|VerbType=Cop', 'head': 7, 'deprel': 'cop', 'dspan': (15, 19), 'span': (15, 19), 'lemma': 'היה'}, {'id': (6, 7), 'text': 'בהיקף', 'expanded': [{'id': 6, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'ב'}, {'id': 7, 'text': 'היקף', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'lemma': 'היקף'}], 'span': (20, 25), 'dspan': (20, 25)}, {'id': 8, 'text': 'מצומצם', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'amod', 'dspan': (26, 32), 'span': (26, 32), 'lemma': 'מצומצם'}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 11, 'deprel': 'punct', 'dspan': (32, 33), 'span': (32, 33), 'lemma': ','}, {'id': (10, 11), 'text': 'ויכלול', 'expanded': [{'id': 10, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'hea