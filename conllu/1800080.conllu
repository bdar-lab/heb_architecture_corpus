# file = txt/1800080.txt
# filelineno = 411
# sentno = 1
# text = היזם-קבלן והדיירים יגיעו, בדוגמה זו, להסכמה עקרונית להוסיף לבניין בסה"כ "קומה וחצי" של 4 דירות פנטהאוז/דופלקס דו-מפלסיות, על-פי הקווים המנחים של הרשות המקומית ושל מינהלת השידרוג, בשטח של כ- 180 מ"ר כל אחת ובתוספת מרפסות גג גדולות (על גבי הדירות המוגדלות שמתחתיהן, ששטחן החדש המוגדל יהיה, כאמור, 120 מ"ר).
