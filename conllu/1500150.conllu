# file = txt/1500150.txt
# filelineno = 407
# sentno = 1
# text = יהיה מעניין לראות עם בעתיד יעשה שימוש נרחב אף יותר בכלי זה כפי שנעשה במדינות אחרות בעולם כמו בברזיל, נושא שאף אומץ על ידי האו״ם והאם אף תנתן לקהילות אפשרות ניהול על השכונות שלהן כפי שמוצע במודל הכפר העירוני.
