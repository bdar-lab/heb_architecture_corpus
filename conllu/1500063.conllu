# file = txt/1500063.txt
# filelineno = 144
# sentno = 1
# text = קריית גת ממוקמת מחוץ לטבעות המטרופולין תל-אביב, ירושלים ובאר-שבע כפי שתוארו בתמ"א 31 ונמצאת בתחום השפעתה של העיר אשקלון, שמיועדת להיות מרכז עירוני משני לסביבתה הקרובה, קריית-גת, מוגדרת כ"עיר אמצע הדרך" בין מטרופולין תל-אביב למטרופולין באר-שבע ומוקפת בשלוש מועצות אזוריות: מ.א. יואב, מ.א. לכיש ומ.א. שפיר.
