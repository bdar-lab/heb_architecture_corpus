# file = txt/1500063.txt
# filelineno = 521
# sentno = 2
# text = ניצול רכבת המקצרת את זמני הנסיעה מעודדת חיפוש משרות באזור שדרות, הנסקרים השוו את זמן הנסיעה ברכב פרטי אל מקום העבודה וחזרה ממנו בשעות העומס, התוצאה היתה שקדמת הנגב בתחבורה מסילתית "קרובה" יותר לדרום מטרופולין תל-אביב, מאשר אותו אזור למרכז תל-אביב, ברכב פרטי, בשעות העומס.
