# file = txt/1500063.txt
# filelineno = 350
# sentno = 1
# text = המלצה או המלצות לאפיון הפתרון המרחבי: שלב ראשון ביצירת תנאי הליכה נוחים יהיו הפתרונות הפיזיים של: צל, הפרדה מתנועת רכב, זמינות של קו שירות (ראה 3.3.6) ובנוסף ציר ההליכה יהיה רצוף בהתרחשות עירונית, משולב במסחר, פנאי ותרבות כך שחוויות ההליכה תהיה מגוונת, מעודדת מפגשים ומעשירה.
