# file = txt/2200033.txt
# filelineno = 294
# sentno = 3
# text = היות והטיפול הנפרד בכל אחד מן הנושאים עלול להוביל למסקנות מנוגדות לגבי אותו הנתון, המערכת המוצעת מצוידת במנגנון לזיהוי ורישום הניגודים, אותם היא מציגה למתכנן, אך מתוך רצון לא להפריע להרגלי התכנון של המתכנן, משאירה בידיו את קבלת ההחלטה לגבי הפתרון הרצוי (פתרון הקונפליקט).
