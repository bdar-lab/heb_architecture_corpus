# file = txt/2500042.txt
# filelineno = 143
# sentno = 1
# text = למרות שידוע שהדרך המדויקת לחזוי האמפליטודה של טמפרטורת הפנים הינה זו של כפל מטריצות, בפרק הנוכחי מתכונים לבדוק עד כמה החישוב המקורב של אמפליטודת הטמפרטורה באמצע המסה הפנימית של מבגה פשוט ניתנת לחישוב בקירוב ראשון, כפי שיוסבר להלן־ החישוב המקורב יעשה, כפי שנעשה עם השיטות האחרות בפרקים 2 ו-1<3, עבור המבנים אשר תוארו בפרק 2־ 1, שלמעשה לא הוכיחו עצמן.
