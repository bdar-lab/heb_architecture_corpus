# file = txt/2000138.txt
# filelineno = 695
# sentno = 1
# text = בעבר נפסק כי הליכי התכנון והבנייה והזכויות הקנייניות אינן קשורות זו בזו, אך מאז חקיקת חוק יסוד "נמו האדם וחירותו" הפסיקה נוטה יותר ויותר להתחשב בשיקולים קנייניים ולאחרונה מתחזקת מגמה ה נראה כי הטלטלה העיקרית שסופג ושיספוג מוסד הבעלות הפרטית על הקרקע, נגרמת ותגרם בעקבות הדוקטרינה של 'פיתוח בר קיימא' כפי שהוצג בחלק א' של עבודה זו בפרק מסי 3.
