# file = txt/2000138.txt
# filelineno = 771
# sentno = 1
# text = ישם העקרונות לפיתוח בר-קיימא, והמחויבות לדורות הבאים אנו מחויבים לנקוט באמצעים להגבלת תחומי העיור ככל האפשר בגבולותיהם הנוכחיים בעיקר בדרך של מדיניות תכנון ופתוח המעודדת מימוש צפיפויות עירוניות גדולות יותר (באופן משמעותי), וכל זאת תוך חתירה לשמירה על נורמות סבירות של איכות חיים (פייטלסון ע. מרינוב א. וקפלן מ.(1996))	.
