# file = txt/2000138.txt
# filelineno = 725
# sentno = 1
# text = למרות שרעיונות אלו קיבלו פרסום נרחב בשנות ה-60, לא הצליחה התפיסה להתגבש לידי מעש!< אדריכלי, למעט מספר בודד של תקדימים (טיבי, (1997)) ככל הנראה הסיבות לכך היו מגוונות וחלקן קשורות למצב החברתי-פוליטי ולמבנה הכלכלי בשנות ה-70: משבר כלכלי, תמיכה ברקמות אורבניות בצפיפות נמוכה, פרבור וכוי חלקם בדרך שבה הוצגו הרעיונות: ללא סבירות טכנו-הנדסית וללא רצינות מקצועית(( 1971) ,Dahinden).
