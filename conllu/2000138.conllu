# file = txt/2000138.txt
# filelineno = 114
# sentno = 2
# text = צפיפות הבנייה אינה מוגדרת בחוק מבחינת סוג המדד ולא מוגבלת למישור מסוים (צפיפות דיור, צפיפות מגורים נטו, ברוטו וכוי), וכל עוד אין הוראות אחרות בתכנית מתאר, מותר לקבוע בתכניות מפורטות הוראות בקשר לשיקום אזורים ושטחים מאוכלסים או בנויים בצפיפות יתר, כך שכל בנייה נוספת בהם תבוא לידי ביטוי בצפיפות יתרה של האוכלוסייה או של הבניינים.
