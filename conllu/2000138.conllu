# file = txt/2000138.txt
# filelineno = 376
# sentno = 3
# text = כיוון שאנחנו מעונינים שתגובת האנשים תהייה חיובית יש צורך בטיפול נכון במידת התאמה בין מספר ומגוון האנשים לבין המשאבים והשירותים הקיימים או המתוכננים, ביחס בין שטחים מבונים ושטחים פתוחים, בטיפול בנושאי בטיחות, בטיפול בפן התפקודי של הסביבה, אפשרויות לסוגים שונים של פרטיות, מניעת פגיעה באיכות הסביבתית מבחינת רעש וזיהום האוויר (צירצימן (2000)).
