# file = txt/2000138.txt
# filelineno = 419
# sentno = 1
# text = צפיפות מגרש כלשהי מותנית כיום בחלוקה הקיימת בין המגרש הפרטי לבין המגרש הציבורי ומותנית באותו חלק של המגרש הפרטי שאותו אפשר לנצל (תכסית בינוי (a)), בהתחשב במרחקים של הבניין מקצות המגרש מסיבות סטטוטוריות או סביבתיות-וכפועל יוצא מהשטחים הפנויים אותם יש להשאיר לצורכי ציבור (בונה ופרידמן (1979 ו-1981); טיבי (1996); ורשבסקי (2001)).
