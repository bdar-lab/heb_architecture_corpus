# file = txt/2000138.txt
# filelineno = 716
# sentno = 1
# text = כבר בראשית המאה החלו תאורטיקנים ואנשי מעוף להעלות רעיונות עתידיים בנושאים אורבניים הנותנים פתרונות שונים למרחב התלת מימדי, וזאת במטרה לפתח גישות המתמודדות עם צפיפות גבוהה ועל-מנת לשמור על איכות חיים ועל איכות הסביבה בעידן של 'התפוצצות אוכלוסין', בקבוצה זו ניתן למצוא את האדריכלים והוגי הדעות: וויליאם לי (1908), לה-קורברזיה (1915), אנטוניו סנטאליה (1916), לודוויג הילברשהימר (1923), קרלוס מורגן (1928), ויוג' פריס (1929), נורמן בל גדס (1939).
