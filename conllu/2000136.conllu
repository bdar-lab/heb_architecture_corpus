# text = בבחינת האתרים שנבחרו במחקר השטח - גן העיר, מתחם היכל התרבות ומרכז דיזנגוף, יש להפריד בין גן העיר ומרכז דיזעוף, המציגים את הטיפוס השכיח ביותר, הוא מרכז הקניות (הקניון) -טיפוס עירוני המציג באופן המובהק ביותר את ״ההיפוך בחוויה העירונית״ (ע״פ Dovey), ובין מתחם היכל התרבות המציג טיפוס שונה של חלל עירוני חדש, כיוון שהוא בשימוש עיקרי של תרבות ואינו בעל שימושים מגוונים כפי שמופיע בשני האתרים האחרים.
# raw = {'id': 5, 'text': 'בבחינת האתרים שנבחרו במחקר השטח - גן העיר, מתחם היכל התרבות ומרכז דיזנגוף, יש להפריד בין גן העיר ומרכז דיזעוף, המציגים את הטיפוס השכיח ביותר, הוא מרכז הקניות (הקניון) -טיפוס עירוני המציג באופן המובהק ביותר את ״ההיפוך בחוויה העירונית״ (ע״פ Dovey), ובין מתחם היכל התרבות המציג טיפוס שונה של חלל עירוני חדש, כיוון שהוא בשימוש עיקרי של תרבות ואינו בעל שימושים מגוונים כפי שמופיע בשני האתרים האחרים.', 'dspan': (761, 1155), 'tokens': [{'id': (1, 2), 'text': 'בבחינת', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'בחינת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 24, 'deprel': 'obl', 'lemma': 'בחינה'}], 'span': (0, 6), 'dspan': (761, 767)}, {'id': (3, 4), 'text': 'האתרים', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'אתרים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'compound', 'lemma': 'אתר'}], 'span': (7, 13), 'dspan': (768, 774)}, {'id': (5, 6), 'text': 'שנבחרו', 'expanded': [{'id': 5, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 6, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 6, 'text': 'נבחרו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Plur|Person=3|Tense=Past|Voice=Pass', 'head': 4, 'deprel': 'acl:relcl', 'lemma': 'נבחר'}], 'span': (14, 20), 'dspan': (775, 781)}, {'id': (7, 8), 'text': 'במחקר', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 8, 'text': 'מחקר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'obl', 'lemma': 'מחקר'}], 'span': (21, 26), 'dspan': (782, 787)}, {'id': (9, 10), 'text': 'השטח', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|