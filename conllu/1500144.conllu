# sentno = 7
# text = באמירה "מברשת צבע היא סוג של משאבה" הזמין המתכנן את שותפיו לקבוצת העבודה לחשוב על מברשת הצבע במונחים אשר אינם מיוחסים לה בדרך כלל, כלומר כאשר תיאור של מושג המברשת אינו רק "כלי ליישום צבע על גבי משטח" אלא גם "כלי להעברת נוזל ממקום למקום", זאת בעזרת חיבור המושג לימשאבה', לדבריו, הקשרים מסוג זה הם המאפשרים המצאה של אובייקטים חדשים, תהליך המתאפשר כאשר בתחילה תופסים ומבינים המתכננים את B-i A כזרים זה לזה, כה שונים עד שהצמדתם יחדיו במבנה המטאפור׳ A הוא B נשמע בתחילה כטעות.
