# file = txt/1500144.txt
# filelineno = 62
# sentno = 20
# text = מחלוקת עדיין קיימת בין אלו הטוענים בעד ההשפעה של שפה על החשיבה, לבין אלו המנתקים אותן זו מזו אולם על דבר אחד קיימת הסכמה ממשית: פינקר מציין כ׳ וורף טעה כשאמר ששפתו של אדם תקבע כיצד יחווה את המציאות, אך הוא ודאי צדק במובן אחד - בכוחה של השפה לקבוע כיצד יחווה אותו אדם את המציאות אם בכוונתו לדבר על כך (1989 ,Pinker).
