# file = txt/1500262.txt
# filelineno = 289
# sentno = 2
# text = אל מול 'מרחבי מדינת הרווחה' של הדור הראשון בתכנון סביבות מגורים מודרניות לאחר מלה"ע-2, בהן המרחבים הבין־בנ״נ״ם דומ״נו כמעין טבע נעדר גבולות, שילוב אלמנטים כמו-עירונ״ם אלה איפשר להגדיר ולאפיין את השימוש במרחבי החוץ, והיווה את ניצניה הראשונים של דיסציפלינת העיצוב העירוני.
