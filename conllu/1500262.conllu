# file = txt/1500262.txt
# filelineno = 364
# sentno = 3
# text = האפשרות להיאבק ולהשפיע על המרחב בסדרי גדול שונים, אני טוענת, מבססת את תחושת השייכות לסביבת המגורים, בשני מובנים: אני ש״ך לקהילה הספציפית הזו—כחלק מקבוצה בעלת אינטרס משותף; המקום הזה שייך לי—יש לי זכות להיאבק על המרחב ולהשפיע עליו.
