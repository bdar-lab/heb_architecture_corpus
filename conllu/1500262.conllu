# file = txt/1500262.txt
# filelineno = 135
# sentno = 3
# text = בהמשך למחקר מקיף על ההיסטוריה של תל אביב (שביט & ביגר, 2001), ובדומה למחקרים המציגים את תל אביב ה"לבנה" כאנטיתזה להתפתחות העירונית הפלסטינית ביפו ובדרום תל אביב (2004 ,Levine ; רוטברד, 2005), מרום מדגים כיצד תכנון העיר עיצב את אופי הסביבה הפיזית והשפיע על מערך היחסים החברתיים בין חלקיה השונים של העיר (מרום, 2009).
