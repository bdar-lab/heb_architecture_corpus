# file = txt/1500262.txt
# filelineno = 346
# sentno = 3
# text = 25 בעוד משפחות צעירות משתמשות במרבד הדשא הנרחב כמקום מפגש לחגיגות יום הולדת ואירועים משותפים לדיירי הכניסות השונות—"השטח למטה הופך את הכניסות הנפרדות לבניין אחד גדול" (כרמל, ראיון, 5.11.20), דיירים אחרים מפרשים את הגן כגינת נוי בלבד—"לא ניתן להשתמש בדשא, מאוד מקפידים על זה ... זה משנה את אופי הבית.
