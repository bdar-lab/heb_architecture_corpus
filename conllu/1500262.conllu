# file = txt/1500262.txt
# filelineno = 90
# sentno = 2
# text = בכנס התשיעי של CIAM, שנערך בשנת 1953 תחת הכותרת La Charte de !'Habitat, אתגרו נציגי הדור הצעיר של CIAM (אשר כונו בהמשך teamlO) את החזון של CIAM לארגון פונקציונאלי של העיר אשר יצר לדידם סביבות מגורים מאורגנות והיג״ניות אך סטריליות וחסרות זהות, וקראו לשלב נושאים חברתיים במערכת השיקולים של תכנון סביבות המגורים.
