# file = txt/1500262.txt
# filelineno = 176
# sentno = 2
# text = 4 כרמי, אשר כחשב אחד הנציגים המובהקים של הברוטליזם הישראלי, התחנך בבית הספר ה-Architectural Association) AA) בלונדון (1956-1951), בדיוק בשנים בהן נפוץ לכל עבר המפנה בשיח הבינלאומי אודות תכנון סביבות מגורים מודרניות בהובלת קבוצת האדריכלים teamlO, מכונני הגישה הברוטליסטית לתכנון מגורים אשר קראו לתכנן סביבות מגורים עירוניות כמרחב לח" קהילה ערים (אפרת & ׳גיד-ח״מוביץ, 2004).
