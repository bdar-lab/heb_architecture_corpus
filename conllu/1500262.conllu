# file = txt/1500262.txt
# filelineno = 382
# sentno = 4
# text = (1) מבנן: קבוצת-המגורים הברוטליסטית בבית משותף-מפוצל - ניתוח המתווה של בתי בארי מראה שהתכנון מכיל ומגיב לניגודים המובנים בין מגורים עירוניים קולקטיביים לבין צורך בפרטיות ומרחב בעיר: העיצוב של בתי בארי כסדרה מגוונת של ארבעה בניינים נפרדים, ומנגד רישומם כיבית משותף', מתווים את המבנן הברוטליסט׳ כ"בית גדול" המתפקד כ"עיר קטנה"; אופן העמדת הבניינים במרחב מציב אתבת׳ בארי כיחידה עירונית המשתלבת במהלך העירוני ומעשירה אותו, בו בזמן שהיא מאפשרת לדיירים פרטיות ומרווח במרחב העירוני; העיצוב האדריכל׳ של הבניינים, הדירות, ופרטי הבנייה, מאפשר לדיירים שליטה בחיבור או התנתקות מהממד הקולקטיבי של המגורים־יחד.
