# text = עשור קודם לתכנון בתי בארי, חברת 'סולל בונה' ציוותה את אריה שרון ודב כרמי בתכנון בניין אחד נוסף בתל אביב, בניין משרדים שהשתלב במרקם העירוני על ידי פסאז' מקורה במפלס הרחוב (הידוע בשם פסאז' "תמר", 1952), ונהרס בשנת 2009 לטובת מגדל מגורים יוקרתי (איור מסי 3, ראה דביר, 2009).
# raw = {'id': 6, 'text': 'עשור קודם לתכנון בתי בארי, חברת \'סולל בונה\' ציוותה את אריה שרון ודב כרמי בתכנון בניין אחד נוסף בתל אביב, בניין משרדים שהשתלב במרקם העירוני על ידי פסאז\' מקורה במפלס הרחוב (הידוע בשם פסאז\' "תמר", 1952), ונהרס בשנת 2009 לטובת מגדל מגורים יוקרתי (איור מסי 3, ראה דביר, 2009).', 'dspan': (489, 760), 'tokens': [{'id': 1, 'text': 'עשור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 13, 'deprel': 'obl:tmod', 'dspan': (489, 493), 'span': (0, 4), 'lemma': 'עשור'}, {'id': 2, 'text': 'קודם', 'upos': 'ADV', 'xpos': 'ADV', 'head': 1, 'deprel': 'amod', 'dspan': (494, 498), 'span': (5, 9), 'lemma': 'קודם'}, {'id': (3, 4), 'text': 'לתכנון', 'expanded': [{'id': 3, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ל'}, {'id': 4, 'text': 'תכנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'nmod', 'lemma': 'תכנון'}], 'span': (10, 16), 'dspan': (499, 505)}, {'id': 5, 'text': 'בתי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'compound', 'dspan': (506, 509), 'span': (17, 20), 'lemma': 'בית'}, {'id': 6, 'text': 'בארי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'compound', 'dspan': (510, 514), 'span': (21, 25), 'lemma': 'בארי'}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (514, 515), 'span': (25, 26), 'lemma': ','}, {'id': 8, 'text': 'חברת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 13, 'deprel': 'nsubj', 'dspan': (516, 520), 'span': (27, 31), 'lemma': 'חברה'}, {'id': 9, 'text': "'", 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 10, 'deprel': 'punct', 'dspan': (521, 522), 'span': (32, 33), 'lemma': "'"}, {'id': 10, 'text': 'סולל', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 8, 'deprel': 'compound', 'dspan': (522, 526), 'span': (33, 37), 'lemma':