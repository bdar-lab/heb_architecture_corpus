# file = txt/1500262.txt
# filelineno = 382
# sentno = 9
# text = (4) חומר: לבני סיליקט בחומר בנייה מקומי - ברוח הברוטליזם, העיצוב האדריכל׳ של בתי בארי מתבסס על חשיפת חומרי הבנ״ה ושימוש בחומרי בנ״ה מקומיים, במטרה לקשור את המבנן עם הטקסטורה התל אביבית והמורשת העירונית של בנ״ה בלבני סיליקט.
