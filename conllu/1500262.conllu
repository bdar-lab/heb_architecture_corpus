# file = txt/1500262.txt
# filelineno = 124
# sentno = 2
# text = מפגש אידאולוג׳ זה הניע את התפתחותן המאורגנת של שכונות מגורים עירוניות, בערים גדולות ובפאתיהן, במטרה לענות על הפער בין חלום ההתיישבות במרחב הכפרי לבין המציאות היום־יומית של הפועל העירוני, תוך אימוץ נרחב של עקרונות תנועת יעיר הגנים', "שום רעיונות אלה במסגרת אגודות שיתופיות עירוניות, אחד הכלים הראשונים של הציונות הסוציאליסטית לבניית דיור עירוני, איפשרה להעמיד לרשות חבריה קרקע ותנאי אשראי לבנ״ה-עצמית של בתים משותפים שהעניקו למתיישבים תחושה של אחידות חברתית ותרבותית (ד. רבינוביץ, 2000).
