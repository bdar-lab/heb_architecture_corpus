# file = txt/1500262.txt
# filelineno = 312
# sentno = 1
# text = אסתטיקת הבטון החשוף של הברוטליזם הישראלי נדונה בהרחבה כביטוי של דור אדריכלי המדינה ליצבריות' ישראלית ישירה וחסרת פורמליות, ובתוך כך זכתה לביקורת נרחבת כחזות מדינת הרווחה ככוחנית, אטומה, ואלימה (אפרת & ׳גיד-ח״מוביץ, 2004; ר. כרמי, 2001; נצן־שיפטן, 2006; עמיר, 2013).
