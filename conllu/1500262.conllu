# text = גן הישורה העליונה', לדוגמא, בה עיצוב הנוף נשאר עד היום נאמן לתכנון המקורי—מרבד דשא פתוח לשימוש הדיירים—הוא מושא למאבק דיירים בין־דור׳ מתמשך, מאבק שהתעצם עם תהליך הדרגתי של כניסת משפחות צעירות למגורים במבנן.
# raw = {'id': 2, 'text': "גן הישורה העליונה', לדוגמא, בה עיצוב הנוף נשאר עד היום נאמן לתכנון המקורי—מרבד דשא פתוח לשימוש הדיירים—הוא מושא למאבק דיירים בין־דור׳ מתמשך, מאבק שהתעצם עם תהליך הדרגתי של כניסת משפחות צעירות למגורים במבנן.", 'dspan': (183, 389), 'tokens': [{'id': 1, 'text': 'גן', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (183, 185), 'span': (0, 2), 'lemma': 'גן'}, {'id': (2, 3), 'text': 'הישורה', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'ישורה', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'compound', 'lemma': 'ישורה'}], 'span': (3, 9), 'dspan': (186, 192)}, {'id': (4, 5), 'text': 'העליונה', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'עליונה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'amod', 'lemma': 'עליון'}], 'span': (10, 17), 'dspan': (193, 200)}, {'id': 6, 'text': "'", 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (200, 201), 'span': (17, 18), 'lemma': "'"}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (201, 202), 'span': (18, 19), 'lemma': ','}, {'id': (8, 9), 'text': 'לדוגמא', 'expanded': [{'id': 8, 'text': 'ל', 'upos': 'ADV', 'xpos': 'ADV', 'head': 9, 'deprel': 'advmod', 'lemma': 'ל'}, {'id': 9, 'text': 'דוגמא', 'upos': 'ADV', 'xpos': 'ADV', 'head': 1, 'deprel': 'nmod', 'lemma': 'דוגמה'}], 'span': (20, 26), 'dspan': (203, 209)}, {'id': 10, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 16, 'deprel': 'punct', 'dspan': (209, 210), 'span': (26, 27), 'lemma': ','}, {'id': (11, 12), 'text': 'בה', 'expanded': [{'id': 11, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 12, 'deprel': 'case', 'lemma': 'ב'}, {'id': 12, 'text