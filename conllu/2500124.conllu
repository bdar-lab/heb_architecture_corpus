# file = txt/2500124.txt
# filelineno = 148
# sentno = 3
# text = אף של-PVC הגולמי אין תכונות מתאימות לשימוש לחיפויי גגות בהיותו חומר קשיח בטמפרטורת החדר (Tg~100°C) בעל עמידות בינונית בחשיפה חיצונית, ניתן בתרכוב מתאים להופכו לחומר פלסטי המצטיין בתכונות הדרושות למטרה זו: רכות, גמישות, עמידות אקלימית טובה וחוזק מכני מתאים.
