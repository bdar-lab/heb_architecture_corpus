# sentno = 1
# text = -	במקרה של יריעות מפוליאתילן, היריעה הדקה יותר ואשר לא הוגדרה ככוללת חומר לבליעת אולטרסגול (ראה ציור ב13) מעבירה באופן כללי יותר קרינה מאשר היתר, עבור כל זוית פגיעה־ העברת הקרינה של היריעה העבה יותר (ראה ציור ב10) דומה לזו של הדקה בתחומי ספקטרום גבוהים יותר רק עבור זויות פגיעה קטנות לערמת הניצב־ ביתר המקרים (ציורים ב-11 רב-12) השוני מתבטא בצורה דומה, אם כי לא באותן העוצמות כמו במקרה של הקרינה האולטרסגולית־
