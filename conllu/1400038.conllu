# file = txt/1400038.txt
# filelineno = 636
# sentno = 1
# text = 10)	סקירת מקרי הי,■ ח■ מגבול ארה״ב מקסיקו מעז ה גם כי ראוי שמדינת ישראל, בהיותה ׳בעלת יכולת כלכלית׳ גבוהה יותר ביחס לרשות הפלשתינאית, ובהיותה ממוקמת במורד הזרם -ובעלת אינטרס גבוה לפתור את בעיית השפכים חוצי הגבולות תוך הצבת סטנדרטים גבוהים לטיפול בשפכים, תיטול על עצמה אחריות כלכלית לטיפול בשפכים חוצי הגבולות בדומה לזו שנטלה על עצמה ארצות הברית.
