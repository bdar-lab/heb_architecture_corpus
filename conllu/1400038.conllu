# file = txt/1400038.txt
# filelineno = 468
# sentno = 4
# text = לטענתו, בסמוך לקיבוץ גיר אליהו פעלה מזבלה אזורית שהיוותה מטרד לתושבי קלקיליה, והיא זו שהובילה את העירייה מלכתחילה לשיתוף פעולה עם הישראלים ולחיפוש פתרונות ■משותף למטרדים של שגי הצדדים (בלום, 26/11/2003) ־׳־‘.
