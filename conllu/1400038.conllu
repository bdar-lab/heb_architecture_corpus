# file = txt/1400038.txt
# filelineno = 415
# sentno = 4
# text = אין זה פלא, אם כן, בי שיתוף הפעולה נערך כין שתי רשויות מקומיות אלו אשר סבלו במידה הרבה ביותר מאי הטיפול בשפכים, והן גם אלו הנהנות במידה הרבה ביותר מהטיפול בהם: כיום שפכי טול כרם מטופלים במתקן החרום בתחומי מדינת ישראל, נערך שדרוג למט״ש של העיר ולמתקן המשאבות שלה ובעתיד אף אמורים להפסק המטרדים הנובעים מהשפכים המגיעים במעלה הנחל.
