# file = txt/1400038.txt
# filelineno = 619
# sentno = 5
# text = מאידך, נדמה כי יכולתו של קנה המידה לשמש ■כפתרון עוקף קונפליקטים׳ מוגבלת: כאשר צריכים הצדדים להגיע להסכמה הקשורה (ולו :בעקיפין) לנושאים פוליטיים ■בוערים׳ (כמו התנחלויות, ירושלים) או הסכמה שעשויה להיות בעלת השלמת פוליטיות (כמו מתן לגיטימציה לקיומן של ישובים ישראלים בשטחי הגדה המערבית) אין די בכלי זה כדי לאפשר את שיתוף הפעולה והרמה המקומית אינה מצליחה להתנתק מהמסגרת המדינית126 (זו הסיבה לכך שהישובים הפלשתינאים מסרבים לשתף פעולה עם ישובים ישראלים בתוך הגדה המערבית, אולם בו זמנית מוכנים לשתף פעולה עם ישובים ישראלים בתוך הקו הירוק'2,).
