# file = txt/1400038.txt
# filelineno = 527
# sentno = 7
# text = בשני המקרים, קיימים יתרונות סביבתיים וכלכליים לחבר את הישובים למתקן בנחל שורק (ליד שלושת הכפרים, כסו ליד הר גילה, כבר קיימים צינורות איסוף אל המט״ש), ובשני המקרים דומה כי שיקולים פוליטיים מונעים את החיבור (במקרה של הר גילה ציין בפני Bargouty כי הפלשתינים אינם מעוניינים לשתף פעולה עם התנחלויות; יתכן וגם במקרה של שלושת הכפרים נמנעים הפלשתינאים משיתוף פעולה עם גבעת זאב מאותה הסיבה.
