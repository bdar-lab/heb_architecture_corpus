# sentno = 1
# text = מהאמור לעיל עולה כי מידת שיתוף הפעולה בנוגע לתכנון המתקן המשותף הינה גבוהה, אולם נכון להיום היא לא הובילה לניהול משותף של השפכים המתקן הפלשתיני לא הוקם וישראל נאלצה לפעול ולהקים ׳מתקן חירום׳, בחינת הקמת מתקן החירום ותפעולו, מאידך, מעידה על מידת שיתוף פעולה נמוכה (מימון ישראלי וקיזוזים, תפעול ישראלי, טיפול בשפכים פלשתינים בלבד, אין הסכם או תשלום בעבור הטיפול).
