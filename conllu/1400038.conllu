# file = txt/1400038.txt
# filelineno = 619
# sentno = 4
# text = הגברת נכונות הצדדים לשתף פעולה ברמה המקומית בולטת במקרי המבחן בנחל הקישון {׳שיתוף פעולה צפון׳), מחל אלכסנדר, במט״ש ניר אליהו הישן ובהסכם בין ראש עיריית ירושלים וראש העיריות של בית לחם ובית גיאלה.
