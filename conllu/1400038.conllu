# file = txt/1400038.txt
# filelineno = 253
# sentno = 1
# text = המרחבים האפשריים לניהול שפכים חוצי גבולות חולקו לחמש קבוצות עיקריות, המבוססות על ארבעת המרחבים שזוהו להלן בפרק הרביעי: קנה מידה אגבי, בו שפכים מכל האגן נאספים לצורך טיפול המנוהל באופן משותף; קנה מידה תת־אגגי, בו שפכים נאספים מחלקו של האגן לטיפול המנוהל במשותף; קנה מידה על־אגני, בו שפכים משני אגנים שלמים או יותר נאספים לטיפול המנוהל במשותף; וקנה מידה מעורב, בו שפכים נאספים מחלקים של שני אגנים או יותר לצורך טיפול המנוהל במשותף.
