# file = txt/1500232.txt
# filelineno = 334
# sentno = 4
# text = עם התקדמות שלבי התכנון גדלה גם האפשרות של המתכנן לדייק בהערכת הפתרון הרצו׳ תוך שימוש בשיטות כמותיות כמו מודלים של סימולציה להערכת צריכת האנרגיה או חישובים מדויקים של צריכת המים להשקיית הגינה (דרורי, 2012) (2012 ,Drori & Shaviv).
