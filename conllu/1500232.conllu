# file = txt/1500232.txt
# filelineno = 335
# sentno = 1
# text = הקשר בין התקדמות תהליך התכנון לשיטות התכנוניות המלוות את תהליכי קבלת ההחלטות מבוסס על מחקר של שביב וקלעי העוסק בשילוב שיטות תכנון פרוצדורליות והיוריסטיות בתכנון והערכה חסכוניים באנרגיה בשלבי התכנון השונים (1992 ,Shaviv & Kalay) (איור 29).
