# file = txt/1500232.txt
# filelineno = 731
# sentno = 2
# text = המשותף לכל המדדים הוא השימוש הן בנתוני מערכת קבועים מבסיס ידע גנרי, שהוא בדייכ בסיס ידע מקצוע׳ בנושא בנייה ירוקה, והן בנתוני משתמש דינמיים מבסיס ידע ספציפי, שמתאים את הידע הגנרי לנתוני הפרויקט לפי הקליינט והמקום (איור 65).
