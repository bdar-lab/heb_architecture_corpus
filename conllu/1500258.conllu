# file = txt/1500258.txt
# filelineno = 525
# sentno = 1
# text = הצוותים עבדו במשך מספר חודשים כאשר התוצרים הוצגו במפגשים ציבוריים, בכל מפגש מסוג זה הוגדרו מהם הנושאים עליהם יש הסכמות ועל מה יש להמשיך לעבוד כדי להגיע להסכמה, כאשר הוחלט מראש שקבלת ההחלטות תהיה באמצעות הסכמה רחבה, וכאשר קונפליקטים יצופו הם ידונו עד שיגיעו להסכמה בין הגורמים הרלוונטיים (ראובני, 2017).
