# file = txt/1500258.txt
# filelineno = 645
# sentno = 2
# text = חלק מהנושאים אשר נידונו בחלק השני של המחקר, דהיינו בחקרי המקרה בישראל, הורחבו בשאלון הבינ״ל משתי סיבות עיקריות: הראשונה, בניגוד למקרים בישראל, עליהם ניתן לאסוף ידע מקדים ולהציבו בהקשר המקומי המתאים, בסקר בינ״ל נרחב ישנן פחות אפשרויות, הן מבחינת המידע הנגיש והן מבחינת כמות הש״ב.
