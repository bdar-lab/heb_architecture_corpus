# file = txt/1500258.txt
# filelineno = 530
# sentno = 1
# text = לבסוף, בפברואר 2008 נערכו שני מפגשים, מליאת מועצה מורחבת ומפגש ציבורי להצגת תכנית האב ומעבר לשלב היישום (מצגת בועז בר אילן, שנה לא ידועה) תכנית זו היוותה את הבסיס למסמכים שהוגשו לאונסקו לצורך הגשת המועמדות בשנת 2011.
