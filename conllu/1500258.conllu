# file = txt/1500258.txt
# filelineno = 397
# sentno = 1
# text = המרחב הביוספרי שפלת יהודה הוא תוצר של יוזמה של המועצה הארצית לתכנון ובנייה, הוא לא הוכר על ידי אונסק״ו (נכון ל־ 2020), ותוצריו הם בין היתר תכנית אב למ״ב המתבססת על העקרונות של הש״ב עם התאמות ופיתוחים נוספים של המודל.
