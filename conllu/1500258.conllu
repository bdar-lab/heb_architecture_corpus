# file = txt/1500258.txt
# filelineno = 402
# sentno = 3
# text = ביוטפרה למהי כי הרעיון העיקרי שלה, אמורה להיות ביחד מערכת התיישבות אדם עם הטביבה בהתייחטות מאוד מיוחדת לטביבה... הוחלט לעשות תכנית למ״ב בשפלת יהודה, תכנית הרבה יותר גדולה שהיא לא תכנית טטטוטורית, שהיא לא תכנית ייעודי קרקע אלא תכנית שיותר ממשק הנחיות תכנון וכללי התנהגות, איך בכלל לחיות ולתכנן ולפעול במרחב הזה" (אדר׳ נינה רבינוביץ, חב׳ סביבתכנון בע״מ, מתוך תמלול ישיבת וועדת משנה להתנגדויות, 26.5.13)
