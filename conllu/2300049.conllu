# file = txt/2300049.txt
# filelineno = 243
# sentno = 2
# text = העלייה בהשפעתם של העולים המזרחים, הופעתן של תנועות אזרחיות כגון הפנתרים השחורים, גוש אמונים, שלום עכשיו ותנועות המחאה בעקבות מלחמת אוקטובר 1973, הבחירות האישיות לראשי הרשויות המקומיות והתחזקותה של חד״ש במגזר הערבי, כל אלו הביאו לידי ירידה בהשפעתן היחסית של מפא״י והאליטה האשכנזית הוותיקה ולידי הגדלת הפלורליזם
