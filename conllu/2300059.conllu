# file = txt/2300059.txt
# filelineno = 23
# sentno = 5
# text = התקנות נועדו להבטיח גם את צרכיו הנפשיים של הקשיש, המתגורר בבית ההורים: זכות בחירה במקום ("לא יתקבל קשיש אלא אם כן נתן הסכמתו לכך"), תנועה חופשית פנימה והחוצה, זכות להתקשר בטלפון, לקבל מבקרים ודברי דואר סגורים ועוד (פר״זלר, 1987, ועדכון מ־1988).
