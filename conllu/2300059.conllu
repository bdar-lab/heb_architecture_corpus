# file = txt/2300059.txt
# filelineno = 74
# sentno = 2
# text = יחידת המגורים מצטיירת כמקום החשוב ביותר לדייר בבית ההורים, כי שם הוא מבלה את רוב זמנו ובה ־ ככל הנראה ־ מתמלאים רוב צרכיו הנפשיים והאינםטרומנטל״ם היא הנותנת את תחושת 'הבית', החשובה לכל אדם, אך במיוחד לקשיש, שתנועתו במרחב העירוני מוגבלת בדרך כלל (צ׳רצ׳מן, 1986).
