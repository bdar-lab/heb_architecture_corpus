# file = txt/1500171.txt
# filelineno = 531
# sentno = 1
# text = הזדמנויות החיים הוגדרו באמצעות בניית מדד משוקלל מהכפלת ציון התקן של כל גורם שהתקבל בניתוח הגורמים של משתני היכולות והתפקודים אשר ייצגו את הזדמנויות החיים ביחס לכל תצפית, במשקל היחסי שהיווה כל גורם בסך ההסבר שתרם לשונות בין התצפיות (ר׳ תת פרק 6.4.2).
