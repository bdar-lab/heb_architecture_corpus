# file = txt/1500174.txt
# filelineno = 642
# sentno = 3
# text = ההצדקות לפגיעה בקניין הפרטי עוצבו והושפעו ע״י מספר גורמים: נתונים גיאוגרפיים של מדינה ישראל, מבנה משטר המקרקעין עם מעורבות גדולה של השלטון במשק, המאבק היהודי-ערבי על השליטה בקרקע, יחסה של האידיאולוגיה הציונית למוסד הבעלות במקרקעין וכולי (הולצמן־גזית, 1999).
