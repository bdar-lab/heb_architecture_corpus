# file = txt/1500174.txt
# filelineno = 865
# sentno = 3
# text = לכן חלק מהמעורבות הייתה השתתפות של הציבור, כאשר נציגי המועצה האזורית או הוועד המקומי, ואפילו התושבים בעלי הקרקעות ידעו על הישיבות, ובחרו להיות נוכחים בתוך ישיבות אלו, לדבר, ובמקרים רבים לצעוק ולהביע את אי-שביעות רצונם מאי זימונם, ומהיבטים מסוימים בתוך התכנית.
