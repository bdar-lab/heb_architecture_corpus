# file = txt/1500174.txt
# filelineno = 657
# sentno = 1
# text = במחקר הנוכחי ,שבוחן את תהליך שיתוף הציבור בקבלת ההחלטות התכנוניות בישובים הערביים, אנו בוחנות אוכלוסייה מיוחדת בהיותה משלבת בין שני ״הניגודים״: אוכלוסיית ילידים, שיש לה בעלות פרטית על הקרקע מצד אחד, אבל מצד שני מהווה אוכלוסיית מיעוט חלשה.
