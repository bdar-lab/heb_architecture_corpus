# sentno = 3
# text = היא טוענת שהשתתפות רחבה יכולה להתמודד עם אי השוויון המעוות שאינו משקף את הצרכים החברתיים הבוערים ביותר, כמו מצוקותיהם של העניים, של נשים מוכות ושל קבוצות מופלות, מאחר שאין להם ייצוג (ישי, 2003).
