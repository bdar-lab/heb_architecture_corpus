# file = txt/1500151.txt
# filelineno = 83
# sentno = 2
# text = עומס פיזי: המרדים אומנם אינו חשוף לעומסים פיסיים, אינו חייב לעמוד כל זמן הניתוח, ובפועל חלק ניכר מהזמן הוא מסתובב בחדר או יושב ויכול להתמקם בתנוחות שונות, וגם הפרוצדורות אותן הוא מבצע בכפיפה קצרות יחסית ומתרחשות בעיקר בשלבי ההכנה וההרדמה, בהם הוא האחראי והוא זה שקובע את קצב העבודה, אך עם זאת ישנם מצבים, שנלקחו מהתצפיות, השאלונים והראיונות האישיים להשלמת המידע, בהם שתי ידי המרדים אוחזות בציוד ו\או תרופות ועל מנת לסיים מטלה הרופא המרדים מבצע תנועות לא ארגונומיות.
