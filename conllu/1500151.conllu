# file = txt/1500151.txt
# filelineno = 86
# sentno = 3
# text = אי לכך יש לספק גם לרופא המרדים פתרון תצוגתי שישמור על ערנותו בשלבי הניתוח בהם הוא חסר תפקיד, ובמקביל יוכל לאפשר לו קבלת מידע על נתוני החולה גם כאשר הוא שקוע בעבודה שאינה קשורה למנותח (מילוי טפסים ודוחות ואפילו קריאה או בהייה).
