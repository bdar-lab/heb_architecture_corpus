# file = txt/1500151.txt
# filelineno = 81
# sentno = 1
# text = למרות שהרופא המרדים מפסיד מחדות הראייה ונאלץ להפעיל מנגנוני הסתגלות בעלי זמן תגובה ודעיכה ממושך בשל החשכת חדר הניתוח, הוא נדרש לקרוא את תוויות התכולה שעל מארזי הציוד והתרופות בגדלים קטנים יחסית (איור 49) בתאורה מוחשכת בשדה עבודתו למראשות המנותח.
