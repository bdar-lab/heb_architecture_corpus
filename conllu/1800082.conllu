# file = txt/1800082.txt
# filelineno = 34
# sentno = 2
# text = לדוגמה, אם משווים חלופות ציוד בהן יש שימוש באמצעי הפעלה שונים ו/או עבודה במשמרת לילה (בחלופה אחת יש עבודת לילה ובחלופה אחרת אין), אזי אם הפרויקט ממוקם בלב שכונת מגורים יש מקום להכניס את שיקול הרעש להירארכיה, אולם אם הפרויקט נמצא במקום בו הרעש לא יפריע לאף אחד, שיקול זה לא רלוונטי.
