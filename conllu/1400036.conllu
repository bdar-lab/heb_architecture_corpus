# file = txt/1400036.txt
# filelineno = 53
# sentno = 1
# text = השינוי המדובר הוא כמובן תפנית מרחיקה לכת ביחסי הגומלין של "הסביב העירוני" הבנוי והסלול לבין רשת ומתקני הנגישות: מעבר מסביבה התומכת ברכב מנועי בעיקר ומתייחסת אל שאר אמצעי הנסיעה כספיחים נלווים וזניחים, אל סביבה התומכת בשילובם של כל האמצעים, כולל "האמצעי האיטי" (הליכה, אופניים) והרכבת-הפרברית - סביבה, המתוכננת המרחבית כך שאמנם כל האמצעים ינוצלו במלואם והתלות ברכב מנועי תקטן.
