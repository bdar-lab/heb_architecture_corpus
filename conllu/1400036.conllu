# file = txt/1400036.txt
# filelineno = 134
# sentno = 2
# text = מתכננים המצדדים בהקמת פרויקטים של דיור מבוסם תחבורה ציבורית טוענים כי חוץ מהיתרונות הברורים של מספר רב יותר של תושבים שיתגוררו סמוך לתחנות תח״צ, יכולים גם להתווסף תועלות אחרות כגון דיור זול יותר, בחירה רבה יותר באשר למיקום אזור המגורים והאמצעי לנסיעה לעבודה ונגישות גבוהה יותר לאוכלוסיות חסרות אמצעיים תחבורתיים (1994 ,Cervro and val Menotti).
