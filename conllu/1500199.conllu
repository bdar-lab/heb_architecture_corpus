# file = txt/1500199.txt
# filelineno = 193
# sentno = 4
# text = שפת ההצבה היא אסתטית: היא עשויה בתחביר של 'מלא-ריק', 'פוזיטיב-נגטיב', ההצבה של ליף עשויה להיות 'פוזיטיב' של העבודה של אולמן: מילוי היריק' הדירתי בעצמים תלת-ממדיים (כמובן, לא מילוי פיזי בהצבה של אולמן, אלא מילוי רפלקסיבי - הוא משקף את ה"נגטיב" שאולמן יצר); עם זאת, בממד הזמן, אי-ההשתנות והקביעות שבהצבה של אולמן עשויה להיות 'פוזיטיב' ביחס לארעיות ההצבה והחומרים של ליף.
