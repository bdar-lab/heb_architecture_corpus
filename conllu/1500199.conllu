# file = txt/1500199.txt
# filelineno = 21
# sentno = 1
# text = בשל אופני הפעולה האמנותית, ביניהם האינטראקציה הפרטנית והבין־אישית (אמן־תושב), בחרתי לבצע את חקר המקרה ביחס לארבעה פרויקטים בעלי מאפיינים שונים (פרויקטים של אמנים עצמאיים ושל קולקטיבים, מהארץ ומחו״ל, הפועלים במשבי זמן מגוונים ובעלי מוטיבציה - חלקה חברתית וחלקה אורבנית), ולנתח את השפה (דימוי, תחביר וכוי) והאמצעים האמנותיים (חלל/זמן, חומרים, מדיה ועוד).
