# file = txt/1500199.txt
# filelineno = 248
# sentno = 1
# text = בפרוטוקול ישיבת סיכום של פעילות המרכז לאמנות דיגיטלית בשנת 2011 מצוינים דגשים כלליים להמשך הפרויקט שכונה פרויקט גיס• כהן: מעורבות תושבים כאמצעי לקיום הפרויקט; קיום פורמט אחיד של מפגש חודשי למעקב אחר התקדמות כל הפרויקטים וכן לגבי בחירה וקבלת פרויקטים חדשים; בדיקת רקורד של האמן מבחינת עבודה עם קהילה וניסיון קודם בפרויקטים מסוג זה; "רצוי שבפרויקטים שהשליטה שלנו בהם מוגבלת (כמו עם מכללות) לא תהיה עבודה ישירה מול התושבים"; "שיתוף השותפים לעבודה בבחירת הפרויקטים - פורום שלנו יחד עם עובדי המתנ"ס, מחלקת הרווחה, בית הספר"; נראות - נציגות בחנות (נספח 3, עמי 95).
