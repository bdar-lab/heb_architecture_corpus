# file = txt/1500199.txt
# filelineno = 115
# sentno = 1
# text = אני מבקש לטעון, שהתערבות במרחב הציבורי היא פעולה אמנותית בלי קשר לזהות היוצר ו/או המבצע ולהיותו אמן, אם היא ממלאת שני תנאים: (א) שימוש בטקטיקות, באמצעים, במבנה ובתחביר הנהוגים בשפה האמנותית, וכן (ב) הצבת השיפוט האסתטי ברמה אחת עם שיפוטים אחרים - אתי, חברתי, סביבתי ופוליטי - או ברקע של שיפוטים כאלה.
