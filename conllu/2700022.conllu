# file = txt/2700022.txt
# filelineno = 613
# sentno = 1
# text = תפיסת מערכת האנרגיה כמערכת שירות שתפקידה לספק את הביקושים לאנרגיה במשק, תוך התחשבות בקשרי הגומלין עם המערכות המשיקות, ובעלת השפעה על המערכת העל לאומית, מכתיבה את מטרת העל של מערכת האנרגיה: לספק את האנרגיה הדרושה לפעילות המשק באופן יעיל וברמת אמינות, מירבית, בהתאמה למטרות העל לאומיות ־ ביטחון קיומי, פיתוח כלכלי והבטחת איכות חיים ורווחה לאוכלוסייה.
