# file = txt/2700022.txt
# filelineno = 332
# sentno = 1
# text = הדרכים העיקריות שבהן מדיניות האנרגיה יכולה להשפיע בכיוון הגדלת שיעור החשמול הן עקיפות בלבד ובתוכן: תמיכה חזקה בהחדרת מכונית חשמלית לשימוש, אם ובמידה, שייפתרו הבעיות הטכנולוגיות והלוגיסטיות המעכבות כיום את כניסתה באופן מסיבי לשוק העולמי; עידוד ניכר של המעבר לתחבורה ציבורית (שבה הפליטה של מזהמים לנוסע קטנה הרבה יותר) וכן עמידה על מעבר להפעלת תחבורה ציבורית בחשמל (לפחות ביחס לאמצעי ההסעה ההמוניים שיפותחו ב-25 השנים הבאות); עידוד העמקת החדירה של מערכות מיזוג אוויר לסקטור הביתי, המסחרי והתעשייתי.
