# file = txt/2700022.txt
# filelineno = 213
# sentno = 1
# text = התפלגות עוגת ייצור החשמל המקומי בין מקורות ראשוניים שונים, ושהחלוקה החשובה לענייננו כאן היא בעלת שתי דרגות: בדרגה הראשונה אנו מעונינים בחלוקה שבין ייצור מבוסס מקורות פוסיליים, גרעין ואנרגיות מתחדשות; בדרגה השנייה אנו מעונינים בהתפלגותו של הנתח הפוסילי בין גז טבעי לפחם ולפצלי שמן וכן בהתפלגות הנתח המבוסס על אנרגיות מתחדשות בין ייצור תרמו־סולארי (לשיטותיו השונות), ייצור הידרו־אלקטרי וייצור על בסיס מתחדש "אחר" (ביומסה, רוח, גלים וכדומה).
