# file = txt/1500073.txt
# filelineno = 12
# sentno = 1
# text = עיריית באר שבע החליטה להקפיא את בנייתו של מועדון לילדים חולי סרטן בשכונה בעיר לאחר שהתושבים שם הביעו התנגדות חריפה להקמתו;1 בית-משפט השלום בירושלים דחה את תביעתו של ד''ר אלעד פלד, מנכ''ל משרד החינוך לשעבר, תביעה שבה דרש לסגור מעון לילדים אוטיסטים בשכונת מגוריו ברמת אשכול בירושלים;2 בכפר סבא תושבים הקימו ועד פעולה על-מנת להיאבק בתכנית להקמת מעון לחוסים הלוקים בפיגור במתחם שכונתם;3 בחולון הוצת מבנה שיועד בעבור אנשים הסובלים מפיגור שכלי פעמיים בתוך חצי שנה;4 בחיפה, פקיעין, מסעדה ומקומות נוספים הוצתו אנטנות סלולריות;5 על אף אמנת באזל מ-61989, טונות רבות מספור של אשפה אלקטרונית עדיין מוצאות את דרכן מן העולם המפותח לעולם המתפתח; בין ארגנטינה ואורוגוואי התעוררה מתיחות בשל הקמתו של מפעל לייצור עיסת נייר בקרבת נהר האורוגוואי אשר מהווה גבול בין שתי המדינות.
