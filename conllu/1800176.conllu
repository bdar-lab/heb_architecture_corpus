# file = txt/1800176.txt
# filelineno = 1511
# sentno = 1
# text = במחקר מקיף בנושא יישום 9000-ISO בענף הבניה שנעשה בעבודתם של רוזנפלד ואסטה "בחינת יישום של תוכניות ניהול איכות 9000-ISO בחברות בניה בישראל״ (רוזנפלד ואסטה, 1999), נערך סקר ספרות מקיף אשר ממצה את המחקרים ביישום של מערכות איכות בענף הבניה בעולם, ונערך סקר שדה מעמיק בקרב 20 חברות בניה בארץ, אשר יישמו את תקן 9000-ISO.
