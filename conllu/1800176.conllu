# file = txt/1800176.txt
# filelineno = 605
# sentno = 2
# text = בשנת 1943 פיתח ארמנד פייגנבאום את המושג עלות האיכות במסגרת עבודתו כמנהל האיכות בחברת General Electric ע״י פיתוח מערכת דיווח על בסיס דולרי, מערכת זו כללה הן את כל העלויות הקשורות בפיתוח מערכת האיכות ופיקוח המוצרים, והן את העלויות הנובעות כאשר המוצר אינו עומד בדרישות.
