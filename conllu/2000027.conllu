# file = txt/2000027.txt
# filelineno = 196
# sentno = 2
# text = בהשוואה בין בסיליקת הארמון Triers והבסיליקה של הלטרן, מדגיש המחבר את משחק הגומלין בין הדומה והשונה בבניינים אלה גם בייעוד וגם בתכנון: הלאטרן היתה כנסית מושב הבישום, אך בו-זמנית גם אולם הכס של המלך המשיח ( Christ Basileus) ונציגו (הבישום), כפי שהבסיליקה Triers היתה מקום מושבו של הקיסר האלוהי.
