# file = txt/1500075.txt
# filelineno = 239
# sentno = 1
# text = בחינת מדדי הביצוע של המשימה המשנית, אשר כללה בקרה של מטרה בשטח מוגדר ולחיצה על פקד ייעודי (הדק) בכל פעם שהמטרה יוצאת מהשטח המוגדר, העלתה כי המדד אשר בחן את משך הזמן בו הצליח הנבדק לשמור את המטרה בשטח המוגדר (Rectout), הושפע באופן מובהק ממהירות המטרה.
