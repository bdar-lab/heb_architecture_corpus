# file = txt/1400017.txt
# filelineno = 12
# sentno = 1
# text = חלוקת הארץ לאזורים אלו נעשתה על סמך ניתוח השפעות הטמפרטורה של הסביבה על התנאים בתוך הבניין, תוך התייחסות לקריטריונים שונים: באזורים א׳, ב׳ ו־ג׳ הקריטריון הקובע את הדרישה להתנגדות תרמית מינימלית של אלמנטי המעטפת הוא מניעת עיבוי על המשטחים הפנימיים בחורף; באזור ד׳, הקריטריון הוא הקטנת השפעתה של קרינה מהמשטחים בעונה החמה (תוך הנחה שטמפרטורת הפנים המרבית לא תעלה על 28 מ״צ, ושהפרש הטמפרטורות המינימלי בין המשטחים הפנימיים לבין האוויר הפנימי הגורם לקרינת חום מורגשת הוא 3 מ׳׳צ).
