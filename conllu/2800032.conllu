# file = txt/2800032.txt
# filelineno = 25
# sentno = 1
# text = יתכן, שיש קשר בין השאיפה להקניית השכלה גבוהה ותיכונית אצל בעלי אמצעים מוגבלים, ובמיוחד אצל -וצאי אסיה ואפריקה, ובין הרצון לצמצם את מספד הילדים בהשוואה למספד הילדים אצל הוריהם־ החשיבות הרבה כל כך, שמייחסים להקניית השכלה על דמה גבוהה לילדים, היא תוצאה ממגמות-התפתחות כלכליות וחברתיות של החברה המודרנית במדינת ישראל־ יש להניח, ששכבות רחבות הגיעו להכרה, שרמת ההשכלה היא הגורם הדומיננסי, המעלה את עדך האדם בחברה, מאפשרת לו להגיע למקום גבוה יותר בסולם החברתי וסבסיחה את עתידו הכלכלי־ מאידך יש להניח, שיש קשר הדוק בין שאיפות אלה לבין רצונם של זוגות צעירים, שנולדו במשפחות מרובוח-ילד ם, לצמצס את מספד הילדים על מנת לאפשר לדוד-ההפשך להקנות דמה השכלתית, ההולמת את צורכי החברה־ סביר הוא שהשאיפות הן תוצאה ממצבן של משפחות מרובות-ילדים, שבמקרים רבים אין באפשרותן להבסיח חינוך לילדיהן, גם אם הוא ניתן בחינם, כי המשפחה איננה יכולה להסתפק במפרנס אחד כדי להבטיח לעצמה קיום, ולפיכך נאלצת היא להכניס את הילדים למעגל-העכודה בגיל צעיר ביותר־ יש להביא גם בחשבון, שמצב הדיור של משפחות מרובות-ילדים משפיע לא במעט על שאיפות הזוגות הצעיריס יוצאי אסיה־אפריקה להקטנת מספר ילדיהם.
