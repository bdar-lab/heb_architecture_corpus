# file = txt/2800032.txt
# filelineno = 541
# sentno = 2
# text = גובה  לגבי התלות בין שני המשתנים היה 29.26 ל-15 דרגות חופש, ז״א מלות מובהקת ברמת 02־0־ המגמה שנתגלתה כאן, היתה - קבוצות ההכנסה הגבוהות, הרבו בציון סיבות המתייחסות לערכים חברתיים ולאידאלים משפחתיים, בעוד שקבוצות ההכנסה הנמוכות הירבו בציון סיבות המתייחסות לכושר כלכלי ותנאי מגורים־ Q אשר חושב לגבי החלוקה הדיכוטומיה, סיבות כלכליות וסיבות אחרות, מכאן, ודמות הכנסה של פחות מ-650 ל״י ומעל לסכום זה - מכאן, היה בגובה 31־0.
