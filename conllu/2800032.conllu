# file = txt/2800032.txt
# filelineno = 166
# sentno = 1
# text = אשר לתנאי הדיור, מצאנו הבדלים אף לגבי המשתנים של וותק בארץ ומוצא אפני־ כן ניתן להבחין בהבדלים בתנאי הדיור הנובעים מהמשתנים של הכנסה ומשלח יד, אך אין הם בולפים ביותר־ לא נמצאו הבדלים בתנאי המגורים הקשודים בגיל האוכלוסייה־אשר 1לורחק בארץ, מצאנו כי משתנה זה לא השפיע על הגודל והצפיפות הממוצעים של הדירה, אך השפיע במידה ניכרת על דרך השגת הדירה־ ככל שגדול יותר הוותק בארץ של אוכלוסייתנו, כן גבוה יותר אחוז השוב-ריס.
