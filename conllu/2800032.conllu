# file = txt/2800032.txt
# filelineno = 230
# sentno = 4
# text = במסגרות השירותים השונים הוערכו שירוחי-המשנה הבאים כחשובים ביותר: בחינוך - ספריות; בשירותי הבריאות - מרפאות; באפשרויות הנופש והבידור - קולנוע; בשירותי הסעד - תחנת משטרה ולשבת עבודה; ובתנאי הנקיון והסדר בסביבות המגורים, נקיון מחוץ לבתים; ואשר לתנאי מיקומו היחסי של האיזור - הוערך כחשוב ביותר המרחק הקצר ממקום-העבודה ומשירותים.
