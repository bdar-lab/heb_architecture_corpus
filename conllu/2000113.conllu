# file = txt/2000113.txt
# filelineno = 487
# sentno = 7
# text = בנוסף יש לציין, כי רק בשנים בהן לא היה עדיין קשר גיאוגרפי רציף בין גרעין האגד (העיר תל אביב), לבין השכונות המהוות כיום את טבעת האגד הראשונה (רמת גן, גבעתיים, בני ברק, חולון ובת ים), ניתן היה למקם מתקנים על שטחי קרקע גדולים (פרט למתקנים הממוקמים על קרקע פרטית).
