# file = txt/2000113.txt
# filelineno = 477
# sentno = 1
# text = כאשר מסתכלים על היווצרותה של רצועת החרושת של תל אביב, רואים כי הרצועה התפתחה בשנות ה - 20 משכונת המרכז המסחרי כמעט ללא הכוונה, מכיוון שקרקע רבה היתה בבעלות פרטית, והשלטונות העירוניים לא דאגו לתיקון תקנות הנוגעות לאזורי תעשייה (גרייצר ב׳, 1987).
