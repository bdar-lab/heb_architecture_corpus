# file = txt/2000113.txt
# filelineno = 339
# sentno = 3
# text = למרות ששימוש קרקע זה עונה על חלק מהקריטריונים המזהים שימושי קצה (שימוש קרקע הגורם לזיהום רעש ופגיעה בנוף), לא נכללו כבישים ומחלפים ברשימה, מכיוון בהם חלק מרשת ארצית והיקף המפגעים מקטע כביש נמדד כפונקציה של תפעול כלל הרשת ולכן לא ניתן להתייחס אליו באופן אוטונומי (פיטלסון, 1996).
