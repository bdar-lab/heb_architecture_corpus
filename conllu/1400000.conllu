# file = txt/1400000.txt
# filelineno = 432
# sentno = 1
# text = אלו הם הקריטריונים הנוגעים למדידה ולהפחתה של פחמן מגולם: דרישה לביצוע חישוב ניתוח חיים של פליטות גז״ח מכלל חומרי הבניין; המלצות ללקוחות (מנהלי הרכש הציבורי) לבחירת פתרונות וחומרים דלי-פליטות ביחס לאחרים; דרישה ש־10% מסך חומרי הבנייה יהיו ממוחזרים או מתחדשים (2020 ,Kuittinen and Hakkinen).
