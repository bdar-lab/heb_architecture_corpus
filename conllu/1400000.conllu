# file = txt/1400000.txt
# filelineno = 88
# sentno = 2
# text = קידום המדידה וההפחתה של פליטות פחמן מגולם בחומרי בניין ובתהליכי הבנייה נמצא בתחילת דרכו, והמחקר הנוכחי מבקש להעלות על סדר היום את חשיבותו, להציג את כלי המדיניות שיושמו בעולם ולהמליץ על כלים רלוונטיים לישראל.
