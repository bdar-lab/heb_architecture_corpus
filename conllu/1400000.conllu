# text = נראה שיצירת מאגר נתונים עם בנצ׳מרקים ישראליים מדויקים איננה אפשרית בטווח המיידי, מכיוון שבמרבית תעשיות החומרים ומוצרי הבניין אין די נתונים, מרבית מאגרי הנתונים שפורטו לעיל מבוססים על EPD's של מוצרים ספציפיים, ומתוך ממוצע ה$׳םק£ מחושב ערך הבנצ׳מרק הממוצע של פליטות פחמן מגולם לטון חומר, בנצ׳מרקים של בניינים דורשים חישוב של ערכי הפליטות של סך החומרים בבניין, ויצירת ממוצע פליטות של מספר גדול של מבנים, מרבית החברות הישראליות אינן יודעות מה ערך הפליטה שלהם לטונה חומר, רובן המוחלט אינן מבצעות LCA או EPD, ולכן כיום אין די נתונים ליצירת מאגר נתונים ישראלי מדויק, נוסף על כך, כפי שצוין לעיל, השוק הישראלי ריכוזי וקטן, וישנם חומרים ומוצרי בניין המיוצרים על־ידי שחקנים בודדים, דבר שעלול להקשות מאוד על חישוב הערך הממוצע לפליטות פחמן מגולם, וישנם חומרי בניין שאינם מיוצרים בישראל,
# raw = {'id': 1, 'text': "נראה שיצירת מאגר נתונים עם בנצ׳מרקים ישראליים מדויקים איננה אפשרית בטווח המיידי, מכיוון שבמרבית תעשיות החומרים ומוצרי הבניין אין די נתונים, מרבית מאגרי הנתונים שפורטו לעיל מבוססים על EPD's של מוצרים ספציפיים, ומתוך ממוצע ה$׳םק£ מחושב ערך הבנצ׳מרק הממוצע של פליטות פחמן מגולם לטון חומר, בנצ׳מרקים של בניינים דורשים חישוב של ערכי הפליטות של סך החומרים בבניין, ויצירת ממוצע פליטות של מספר גדול של מבנים, מרבית החברות הישראליות אינן יודעות מה ערך הפליטה שלהם לטונה חומר, רובן המוחלט אינן מבצעות LCA או EPD, ולכן כיום אין די נתונים ליצירת מאגר נתונים ישראלי מדויק, נוסף על כך, כפי שצוין לעיל, השוק הישראלי ריכוזי וקטן, וישנם חומרים ומוצרי בניין המיוצרים על־ידי שחקנים בודדים, דבר שעלול להקשות מאוד על חישוב הערך הממוצע לפליטות פחמן מגולם, וישנם חומרי בניין שאינם מיוצרים בישראל,", 'dspan': (0, 773), 'tokens': [{'id': 1, 'text': 'נראה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'נראה'}, {'id': (2, 3), 'text': 'שיצירת', 'expanded': [{'id': 2, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 11, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 3, 'text': 'יצירת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 11, 'deprel': 'nsubj', 'lemma': 'יצירה'}], 'span': (5, 11), 'dspan': (5, 11)}, {'id': 4, 'text': 'מאגר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'compound', 'dspan': (12, 16), 'span': (12, 16), 'lemma': 'מאגר'}, {'id': 5, 'text': 'נתונים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'compound', 'dspan': (17, 23), 'span': (17, 23), 'lemma': 'נתון'}, {'id': 6, 'text': 'עם', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'dspan': (24, 26), 'span': (24, 26), 'lemma': 'עם'}, {'id': 7, 'text': 'בנצ׳מרקים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=M