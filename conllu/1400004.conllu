# text = במחקר "שיפוץ בנייני מגורים בישראל לשם חיסכון באנרגיה" מוצע לנקוט באמצעים כלכליים של סובסידיות והלוואות באמצעות החזר בגובה מס ערך מוסף למשקיעים בשיפוץ אנרגטי בשווי של כ־15% מעלות ההשקעה הכוללת מע״מ; סבסוד חשבון החשמל של פרט המשקיע בשיפוץ בסכום שיחזיר למשקיע במשך חמש שנים כ-10% מערך ההשקעה, בתנאי שחשבון החשמל יהיה נמוך יותר לאחר השיפוץ כדי למנוע אפקט "ריבאונד";39 הלוואות אטרקטיביות באמצעות בנקים מסחריים והקמת קרן להתייעלות אנרגטית שתמומן מאחוז מחשבון החשמל שנלקח עבור ההשפעות החיצוניות השליליות שמקורן בייצור חשמל (הטלת מס פיגוביאני) (אראל, פרידמן, ובקר, 2013).
# raw = {'id': 1, 'text': 'במחקר "שיפוץ בנייני מגורים בישראל לשם חיסכון באנרגיה" מוצע לנקוט באמצעים כלכליים של סובסידיות והלוואות באמצעות החזר בגובה מס ערך מוסף למשקיעים בשיפוץ אנרגטי בשווי של כ־15% מעלות ההשקעה הכוללת מע״מ; סבסוד חשבון החשמל של פרט המשקיע בשיפוץ בסכום שיחזיר למשקיע במשך חמש שנים כ-10% מערך ההשקעה, בתנאי שחשבון החשמל יהיה נמוך יותר לאחר השיפוץ כדי למנוע אפקט "ריבאונד";39 הלוואות אטרקטיביות באמצעות בנקים מסחריים והקמת קרן להתייעלות אנרגטית שתמומן מאחוז מחשבון החשמל שנלקח עבור ההשפעות החיצוניות השליליות שמקורן בייצור חשמל (הטלת מס פיגוביאני) (אראל, פרידמן, ובקר, 2013).', 'dspan': (0, 563), 'tokens': [{'id': (1, 2), 'text': 'במחקר', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Definite=Def|PronType=Art', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'מחקר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 14, 'deprel': 'obl', 'lemma': 'מחקר'}], 'span': (0, 5), 'dspan': (0, 5)}, {'id': 3, 'text': '"', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (6, 7), 'span': (6, 7), 'lemma': '"'}, {'id': 4, 'text': 'שיפוץ', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'appos', 'dspan': (7, 12), 'span': (7, 12), 'lemma': 'שיפוץ'}, {'id': 5, 'text': 'בנייני', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'compound', 'dspan': (13, 19), 'span': (13, 19), 'lemma': 'בניין'}, {'id': 6, 'text': 'מגורים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'compound', 'dspan': (20, 26), 'span': (20, 26), 'lemma': 'מגורים'}, {'id': (7, 8), 'text': 'בישראל', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 8, 'text': 'ישראל', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 5, 'deprel': 'nmod', 'lemma': 'ישראל'}], 'span': (27, 33), 'dspan': (27, 33)}, {'i