# file = txt/1400004.txt
# filelineno = 205
# sentno = 2
# text = כלים אלו הם תוכנית מענקים; תוכנית למתן הלוואות וחבילות מימון מסובסדות; שילוב של תוכנית מענקים עם הלוואות; יצירת מסגרת רגולטורית תומכת לתוכניות ייעודיות לרשויות מקומיות או תאגידים עירוניים (מודל ״עזרה וביצרון״); הגברת התמריץ המוצע בתוכנית הלאומית לחיזוק מבנים מפני רעידות אדמה (תמ״א 38); הטמעת תקציבים לטכנולוגיות ואמצעי חיסכון בדיור ציבורי; יישום מנגנוני המימון באמצעות חברת החשמל (שמואלי והרשגל, 2014).
