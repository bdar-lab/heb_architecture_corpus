# file = txt/2800042.txt
# filelineno = 5
# sentno = 3
# text = מענין לציין כי קצב התייקרותן של הדירות הגדו לות (2/י3 חדרים ומעלה) היה מהיר יותר מזה של הדירות הבינוניות והקטנות, וזאת כנראה משום שהעלאות מחירי הדירות הקטנות יותר נתקלה בקשיים עקב כושר הקניה המצומצם יחסית של רוכשי דירות אלו הנמנים ברגיל על בעלי אמצעים מוגבלים; בעוד שהמעצורים לעליית מחיריהן של דירות גדולות אשר רוכשיהן הם כרגיל בעלי הכנסות גבוהות, היו מועטים יותר.
