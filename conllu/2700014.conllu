# file = txt/2700014.txt
# filelineno = 25
# sentno = 6
# text = לאחר שהוחק חוק בשנת 1963 שדרש התקנת חגורות במושבים הקדמיים בכל מכוניות הנוסעים החל משנת הייצור של 1965 הנמכרות במדינת ניו-יורק, הודיעו חברות הרכב, לקראת סוף שנת 1963, על התקנת חגורות במושבים הקדמיים כציוד סטנדרטי בכל דגמי מכוניות הנוסעים של שנת 1964.
