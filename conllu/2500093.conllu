# file = txt/2500093.txt
# filelineno = 16
# sentno = 2
# text = ההתחשבות במסה התרמית הפנימית הובילה בכל המחקרים להנחיות ברורות של אופן השימוש באנרגיה עם דגש מיוחד על הוזלת מחיר ההספק המותקן (INSTALLED POWER) - שיש לו השלכות לגבי מדיניות תעו״ז של חברת החשמל - בנוסף לשיטות הבידוד התרמי והשימוש באמצעים פסיביים.
