# file = txt/2500093.txt
# filelineno = 326
# sentno = 1
# text = לא מובאות כאן התוצאות החלקיות שנתקבלו בחישובים עם התוכניות של חדרי אוכל ואולם כניסה ששטחיהם 600 מ"ר, משום שבתנאי תיכנון עם הצללה מלאה - והדבר הוצדק כרצוי כי אחרת אנו מדברים על הספקי קירור דימיוניים - עם שינויים מאד קטנים על פי הכיוונים של החלונות (מתאפשרת חדירת קרינת שמש מפוזרת בלבד) מתקבלים הספקי קירור ואוורור כמעט כפולים (בין 1.92 לבין 2) מאלה של חדרי אוכל ששטחם 300 מייר בכל המצבים שנבדקו.
