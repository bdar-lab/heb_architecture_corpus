# file = txt/2500093.txt
# filelineno = 41
# sentno = 3
# text = מחקר זה, אשר בוצע בהזמנת משרד האנרגיה והתשתית וסוכם בדו"ח מסי 4 (יוני 1987), הביא בסיכומו של דבר -בנוסף לניתוח מעמיק של משמעות השימוש בחשמל לילה להפעלת מערכות חימום וקירור (כאיקלום הכנה "פסיבי") - להצעת תקן לבידוד תרמי ההופך את הבניין לחסכוני מבחינה אנרגטית (ראה טבלה 6, באופן שיובטחו תנאי הטמפרטורה המוצגים בטבלה 7 והדרישות של הכנסת אויר צח על פי הטבלה 8), תוך הבטחת תנאי נוחות מבחינה אקלימית.
