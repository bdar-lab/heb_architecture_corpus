# file = txt/2500093.txt
# filelineno = 142
# sentno = 2
# text = אבל בכל אזורי הארץ נראה שעם תפוסה מלאה של חדר האוכל יש להפעיל את החימום בחורף וגם את הקירור בקיץ במשך כל היממה (אזי ההספק המותקן יותר קטן ואין צורך במתן הספקים גדולים מאד של חימום וקירור) ובצורה דיפרנציאלית כדי להבטיח תנאי טמפרטורה בהתאם לדרישות שהובאו בפרקים הקודמים.
