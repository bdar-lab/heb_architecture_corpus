# file = txt/2300152.txt
# filelineno = 314
# sentno = 2
# text = עבודתו כללה ניתוח של מקורות לזיהום מי התהום, ובעקבותיו דיווחים על ממצאים בנוגע לאיכות מי הנגר משתי בחינות עיקריות: הימצאותם של מיקרואורגניזמים פתוגניים, אשר השפעתם על הבריאות נמצאת במחלוקת, והימצאותם של מזהמים כימיים, אשר הצטברותם בגוף במשך הזמן עשויה להיות בעלת השפעות בריאותיות שליליות.
