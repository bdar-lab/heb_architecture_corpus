# file = txt/2300152.txt
# filelineno = 550
# sentno = 1
# text = אי אפשר לערוך השוואה מדויקת בין האומדן שציטטנו בעבודתנו הקודמת לבין זה שחושב כאן, כי בסיס החישוב בכל אחת משתי העבודות שונה: בעבודה הקודמת נערך אומדן של כלל השטחים הבנויים החזויים מעל אקוויפר החוף ב-2020 (שם), מבלי לייחסו ישירות לגודל האוכלוסייה בשטח זה, בעוד שכאן נקודת המוצא לחישוב הייתה תוספת של מליון נפש.
