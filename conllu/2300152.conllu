# file = txt/2300152.txt
# filelineno = 491
# sentno = 4
# text = תועלת סביבתית עיקרית מעירוב שימושים היא פועל יוצא מהפחתת הצורך בסלילת דרכים לצורך נסיעות בין מגורים לתעסוקה, לקניות ולבידור; נהוג היה להפריד בין פונקציות אלה וליצור מרחקים שלא סביר לעוברם ברגל, כשהפרדה קיצונית מונעת גם קישור יעיל בתחבורה ציבורית.
