# file = txt/1800083.txt
# filelineno = 813
# sentno = 2
# text = מסיבה זו לא נכללו בו ענפים מהסוגים הבאים: 1) ענפים, שנהוג אומנם לעסוק בהם בחו"ל, אך אין להם שום אופי מקומי ולכן ניתן להעביר בקלות את הידע המצטבר שם (למשל, התת-תחום של "פיתוח מודלים לאנאליזה ותוכנות לצורך חישוב עמידות בזמן שריפה של מבני פלדה"), 2) ענפים, שנהוג עדיין לעסוק בהם בחו"ל, אך למיטב ידיעתנו הצטבר בהם מספיק ידע בישראל וניתן לכנותם "בשלים" (למשל, התת-תחום של "בידוד תרמי"), 3) ענפים רלוונטיים וחשובים, שנהוג לעסוק בהם בחו"ל ויש צורך לעסוק בהם גם בישראל, אך שהטיפול בהם נעשה בדרך כלל ע"י אנשי מקצוע שאינם בתחום הנדסת הבנייה (למשל, התת-דיסציפלינות של "תאורה", ו"מערכות אלקטרו-מכניות בבניינים"), 4) ענפים מעניינים וחדשניים, שמתפתחים ומקודמים בחו"ל, אך ההשקעה הכספית הנדרשת היא מעבר לאמצעים שמדינת ישראל תוכל לגייס כדי לעסוק בהם, ותועלתם המשקית הישירה אינה מצדיקה גיוס מיוחד של משאבים כאלה (למשל, התחום הראשי של "דרישות תפקוד בבנייה מחוץ לכדור הארץ", או התת-
