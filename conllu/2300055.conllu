# sentno = 1
# text = לאור הנסיון שנרכש בהפעלת תכנית המתאר למחוז ירושלים לא נכללו הוראות בניה בתכניות המחוזיות שאושרו אחריה, ולעומת זאת נכללו בהן סעיפים המאפשרים יתר גמישות: במחוזות תל-אביב והצפון הותרו סטיות הנובעות מקנה חמדה של התכניות* ובמחוזות המרכז והדרום הורחב סעיף הגמישות והוא מאפשר שיקול דעת לועדה המחוזית באישור סטיות מהתכניות לצורך שימור של שטחים בעלי ערך מבחינה טבעית, נופית או היסטורית.
