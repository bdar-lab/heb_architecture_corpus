# file = txt/2300055.txt
# filelineno = 578
# sentno = 2
# text = יוצאות מכלל זה תכניות מחוז המרכז ומחוז חיפה 1985 שבהן נכלל סעיף הקובע: "מצאה הועדה המחוזית כי מבחינת כושר בצועה של התכנית רצוי להכניס בה תיקונים או שינויים - תכין ותגיש הועדה הצעות שינוי כאמור לאישור המועצה הארצית".
