# file = txt/2300055.txt
# filelineno = 133
# sentno = 4
# text = אך יש לזכור שתכניות אלה יצאו מנקודת מוצא מקומית של הסדרת שמושי קרקע ורישוי בניה - ולא היוו חוליה בהיררכיה של תכניות, שמטרתן - השגת יעדים לאומיים תוך תיאום אזורי של תכנון כוללני, כפי שבדרש לימים בחוק התכנון והבניה.
