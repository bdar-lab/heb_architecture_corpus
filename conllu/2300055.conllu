# file = txt/2300055.txt
# filelineno = 1137
# sentno = 1
# text = שונות הן ההמלצות בנושאים הבאים: שינוי בתחומי התייחסותן של התכניות העלול לחייב שינוי במערכת התכנון ובסמכויות הבצוע; שילובם של משרדים נוספים בתהליך התכנון והאישור של התכניות המחוזיות, שיחייב שינוי בחקיקה; חובת בקרה ועדכון של התכניות תחייב בודאי תוספת כח אדם מקצועי בלשכות התכנון המחוזיות; תיקונם של גבולות המחוזות יחייב פעולה משולבת של מוסדות התכנון ושל הממשלה ומשרדיה; אולם אין ספק שההמלצה שהיא מרחיקת לכת ביותר מבחינת השלכותיה היא זו המתיחסת להיקפן הגיאוגרפי של התכניות, תוך בטול ההתיחסות למחוזות האדמיניסטרטיביים הנוכחיים והעברת הדגש לתכנון האזורי.
