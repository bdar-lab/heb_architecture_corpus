# file = txt/2300055.txt
# filelineno = 135
# sentno = 1
# text = אולם המודעות לחשיבותו של התכנון הפיסי היוזם לא היתה נחלתו של הדרג הפוליטי, וכך, לאחר הקמתה של הממשלה הראשונה, בשנת 1949, חולק אגף התכנון: נושא השכון נשאר במשרד העבודה והבינוי, התכנון הסדיר (טפול בתכניות מוצעות ע״י רשויות מקומיות ואחרים, רישוי בניה, פקוח, ובצוע תכניות ארציות), עבר למשרד הפנים (שבתחום סמכותו היה נושא השלטון המקומי) ואילו התכנון היוזם, שבמסגרתו הוחל בהכנת תכניות ארציות ואזוריות, היה זמן מה ללא "גג" ולבסוף הועבר למשרד ראש הממשלה.
