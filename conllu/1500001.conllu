# file = txt/1500001.txt
# filelineno = 114
# sentno = 1
# text = אולם, למרות השוני הגדול שבין המקום הקדוש בספרות לבין מתחם הקבר הקדוש במרוקו, ניתן למצוא נקודות משותפות, כגון: פריצת הקדושה מהמקום הקדוש למקומות אחרים במרחב, גבולות המתחם הקדוש ברורים ולרוב קיימת היררכיה חללית בדרגת הקדושה ושימוש באלמנטים טבעיים לצד מבנים.
