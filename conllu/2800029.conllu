# file = txt/2800029.txt
# filelineno = 80
# sentno = 4
# text = אמנם, גם רחביה מתחילה לשנות את צורתה, ויש להניח כי בסופו של דבר לא יפסח גלגל הזמן גם עליה, ויוקרתה תרד לעומת שכונות אחרות - אך, מכל מקום, שכונה המתקרבת לסיום יובל שנים להקמתה והיא עדיין שכונת פאר - מהווה הישג לתכנון טוב.
