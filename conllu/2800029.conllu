# file = txt/2800029.txt
# filelineno = 187
# sentno = 3
# text = מעצם חיותה שכובה בעלת יוקרת מיוחדת בשל היסוד הוותיק ומעמדם החברתי, המקצועי והכלכלי הגבוה של תושביה, התפשטה רחביה זח מכבר עוד יותר כיום בכיוון לשכונת טלביה הסמוכה שאף היא הפכה, עקב התפשטות זו, לאחת השכונות האמידות והסועדפות בעיר; יתירה מזאת, ההתפתחות לא נפסקה בהגיעה למוקד זה, והמגמה של "זחילה" מתמדת דרך טלביח לקטמון הישנה נמשכת - דבר המשתקף בערכי הקרקע לחדד, המהווה מודד תשוב במיוחד בירושלים.
