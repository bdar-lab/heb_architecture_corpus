# file = txt/2800029.txt
# filelineno = 136
# sentno = 1
# text = הנובעות מהיותה קרובה לתל-אביב (מבחינת משיכת אוכלוסיה וכר‘), רכן גם היא סובלת משכנות זו, המקשה על פיתוח חיים עצמאיים של העיר:מוקדי המשיכה של העיר הגדולה, מבחינת מסחר ושרוחים אישיים, מכבידים על פיתוח מסחר ושרוחים אישיים בחולון; תופעה זר תלך כנראה ותקפן, עם גידול האוכלוסיה בחולון (רעל כןגידרל משיכתה הגררויסציונית) ועלית סטנדרט הבניה ורמת השרותים בשכונותיה החדשות (נסיה המאופיינת ע״י שכונות חדישות כנאות רחל).
