# text = חישוב גולמי, המבוסם על הנתונים שלעיל מדאה, כי מתוך התייקרות כללית של הדירות בשיעור 48% בין דצמבר 1961 ובין דצמבר 1963 -נבעו רק 15% מעליית הוצאות הבניה, לעומת זאת יש לזקוף כ-30% מההאייקדות על חשבון התייקרות הקרקע ואפשר להניח, כי כ-3% - 2 מהעליה הנ״ל יש לייחס לעליית דווחי הקבלנים.
# raw = {'id': 2, 'text': 'חישוב גולמי, המבוסם על הנתונים שלעיל מדאה, כי מתוך התייקרות כללית של הדירות בשיעור 48% בין דצמבר 1961 ובין דצמבר 1963 -נבעו רק 15% מעליית הוצאות הבניה, לעומת זאת יש לזקוף כ-30% מההאייקדות על חשבון התייקרות הקרקע ואפשר להניח, כי כ-3% - 2 מהעליה הנ״ל יש לייחס לעליית דווחי הקבלנים.', 'dspan': (171, 450), 'tokens': [{'id': 1, 'text': 'חישוב', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 11, 'deprel': 'nsubj', 'dspan': (171, 176), 'span': (0, 5), 'lemma': 'חישוב'}, {'id': 2, 'text': 'גולמי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'amod', 'dspan': (177, 182), 'span': (6, 11), 'lemma': 'גולמי'}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (182, 183), 'span': (11, 12), 'lemma': ','}, {'id': (4, 5), 'text': 'המבוסם', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 5, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 5, 'text': 'מבוסם', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PUAL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Pass', 'head': 1, 'deprel': 'acl:relcl', 'lemma': 'מבוסם'}], 'span': (13, 19), 'dspan': (184, 190)}, {'id': 6, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'dspan': (191, 193), 'span': (20, 22), 'lemma': 'על'}, {'id': (7, 8), 'text': 'הנתונים', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'נתונים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'obl', 'lemma': 'נתון'}], 'span': (23, 30), 'dspan': (194, 201)}, {'id': (9, 10), 'text': 'שלעיל', 'expanded': [{'id': 9, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 10, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 10, 'text': 'לעיל', 'upos': 'ADV', 'xpos': 'ADV', 'head': 5, 'deprel': 'advmod', 'lemma': 'לעיל'}], 'spa