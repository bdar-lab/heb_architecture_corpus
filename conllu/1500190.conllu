# file = txt/1500190.txt
# filelineno = 73
# sentno = 3
# text = היה זה אחד המקומות המשפיעים ביותר על התפתחות מקצוע אדריכלות הנוף בארה״ב ובכלל, כאשר סגל האוניברסיטה ובוגריה היו ממובילי תנועת אדריכלות הנוף המודרנית ותרמו להפצתה עת הביאו לארצותיהם את הרעיונות אליהם נחשפו בקליפורניה (2013 ,Wolch & Wurster).
