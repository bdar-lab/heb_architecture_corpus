# file = txt/1500190.txt
# filelineno = 434
# sentno = 2
# text = אנשי קק"ל נטעו את הלימנים הראשונים בשנת תשכ״ב לאורך הדרך מבאר שבע לדימונה במטרה לדחוק את המדבר ולהיאחז בקרקע (וייץ, 1970) וגם להיות "חלוץ לפני המחנה שיאפשר פיתוח עתידי" (טל-אור, 1963 אצל ברנשטיין, 2012), ומוזכרים שימושיו כאזור מוצל החשוב גם למרעה.
