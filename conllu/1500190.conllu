# file = txt/1500190.txt
# filelineno = 633
# sentno = 1
# text = קריאת נוסי מדבר - לנוף במדבר נוכחות דומיננטית במיוחד ואהרונסון עומד על מאפייניו: אספקת מים לא קבועה או היעדר מים, תנאי אקלים קיצוניים שאינם נוחים לאדם, היעדר צל, דומיננטיות הגיאולוגיה בנוף, מערכת אקולוגית רגישה ופגיעה, קושי לשקם את הנוף שכן צלקות נשארות בו לאורך אלפי שנים ואין צמחיה שתסתיר או תרכך אותן עם הזמן, ועוד.
