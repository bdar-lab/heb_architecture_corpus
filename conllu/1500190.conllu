# text = "היווצרות המיתולוגיה" היא תוצאה של שלושה גורמים: מסעות לימוד, אשר החלו אצל אהרונסון בתנועת הנוער והמשיכו בחברות בגרעין ההקמה של יודפת ובמסעותיו לארצות הברית וללונדון; בבחירת מקומות הלימוד והעבודה בברקלי ובהרווארד, עבודתו אצל הלפרין ויצירת קשרים ארוכי טווח אתו ועם דמויות מפתח בשיח האדריכלי, כגון מוריו הפרופסורים ניוטון, אקרמן, גירלדין סקוט, או אדריכלי נוף מובילים ומשפיעים בני דורו כמו פיטר ווקר, מרתח שוורץ, פול פרידברג, לארי אולין, קרל שטייניץ, משה ספדי, דוד רזניק ואחרים; ולבסוף בחירת מקום המגורים והעבודה בירושלים של סוף שנות השישים, עת הייתה למעבדה אדריכלית חדשנית ופעילה, באתרים בעלי חשיבות לעולם כולו.
# raw = {'id': 1, 'text': '"היווצרות המיתולוגיה" היא תוצאה של שלושה גורמים: מסעות לימוד, אשר החלו אצל אהרונסון בתנועת הנוער והמשיכו בחברות בגרעין ההקמה של יודפת ובמסעותיו לארצות הברית וללונדון; בבחירת מקומות הלימוד והעבודה בברקלי ובהרווארד, עבודתו אצל הלפרין ויצירת קשרים ארוכי טווח אתו ועם דמויות מפתח בשיח האדריכלי, כגון מוריו הפרופסורים ניוטון, אקרמן, גירלדין סקוט, או אדריכלי נוף מובילים ומשפיעים בני דורו כמו פיטר ווקר, מרתח שוורץ, פול פרידברג, לארי אולין, קרל שטייניץ, משה ספדי, דוד רזניק ואחרים; ולבסוף בחירת מקום המגורים והעבודה בירושלים של סוף שנות השישים, עת הייתה למעבדה אדריכלית חדשנית ופעילה, באתרים בעלי חשיבות לעולם כולו.', 'dspan': (0, 609), 'tokens': [{'id': 1, 'text': '"', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (0, 1), 'span': (0, 1), 'lemma': '"'}, {'id': 2, 'text': 'היווצרות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'nsubj:cop', 'dspan': (1, 9), 'span': (1, 9), 'lemma': 'היווצרות'}, {'id': (3, 4), 'text': 'המיתולוגיה', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'מיתולוגיה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'compound:smixut', 'lemma': 'מיתולוגיה'}], 'span': (10, 20), 'dspan': (10, 20)}, {'id': 5, 'text': '"', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (20, 21), 'span': (20, 21), 'lemma': '"'}, {'id': 6, 'text': 'היא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|Polarity=Pos', 'head': 7, 'deprel': 'cop', 'dspan': (22, 25), 'span': (22, 25), 'lemma': 'הוא'}, {'id': 7, 'text': 'תוצאה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (26, 31), 'span': (26, 31), 'lemma': 'תוצאה'}, {'id': 8, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 10, 'deprel': 'case:gen', 'd