# file = txt/1500190.txt
# filelineno = 455
# sentno = 2
# text = ישנה מחלוקת באשר לשאלה האם הלימנים משמשים בית גידול חליפי (כעין "מבלע") למינים המקומיים או עופות נודדים שבתי הגידול שלהם נכחדים בשל ניצול יתר, או שהם מושכים מינים מתפרצים המאיימים על האוכלוסייה הטבעית (פרלברג ורון, 2014).
