# file = txt/1500190.txt
# filelineno = 456
# sentno = 1
# text = בשנות האלפיים הוכנו מסמך מדיניות של קק״ל, תכנית אב ותכנית סטטוטורית בהם הוגדרו מטרות ללימנים הבוגרים ולחדשים שיינטעו: אספקת חניונים מוצלים לצדי הכבישים למטרות תיירות ונופש; אספקת חניוני מנוחה מוצלים לצורך אימוני הצבא; שיפור חזות ונוף צדי הדרכים בנגב; אספקת עשב למרעה וצל לעדרים הרועים באזור, ובמידה מסוימת גם תחנת שהייה לציפורים נודדות (ברנשטיין, 2012).
