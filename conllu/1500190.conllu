# file = txt/1500190.txt
# filelineno = 648
# sentno = 2
# text = אהרונסון היה ער לנושאים חברתיים, סביבתיים, תרבותיים ואחרים שהעסיקו את הקהילה המקצועית בתקופות שונות, ויחסו אליהם השתנה בהתאם לתקופות אלו; אולם בסופו של דבר, הגם שהתייחס אליהם בתכנון פרויקטים שונים, יש להם ביטוי שולי בלבד באופן בו הגדיר את עיקרי התפישה המסכמת.
