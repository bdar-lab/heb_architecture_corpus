# file = txt/1500190.txt
# filelineno = 643
# sentno = 1
# text = מן המחקר עולה כי תפישת התכנון של אהרונסון עברה עם השנים תהליך של התפתחות, במהלכה נשאר נאמן לעקרונות שהציג בראשית הדרך (ר' טבלה 3.6) תוך תהליך מתמשך של דיוק, זיקוק והתאמה לזירת הפעולה הישראלית, למציאות התכנונית בה פגש, לזמנים המשתנים - על השיח המקצועי שליווה אותם והביקורת הציבורית שזימנו, ולאישיותו כאדריכל בוגר ומנוסה.
