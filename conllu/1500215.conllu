# file = txt/1500215.txt
# filelineno = 14
# sentno = 1
# text = בעיני רוחנו הנוף הקיבוצי הוא מראה מוכר שאותו אנו יודעים לזהות, לתאר ולאפיין ללא קושי: מדן ועד איילות נוף הקיבוץ מתאפיין במדשאות גדולות התחומות בצמחייה ובשיחייה במרכז הקיבוץ ובאזורים המשותפים, ובשדרות עצים מצילים וצמחי נוי באזורי המגורים והשבילים (אניס ובן ערב, 1994).
