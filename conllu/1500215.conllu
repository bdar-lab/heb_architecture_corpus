# file = txt/1500215.txt
# filelineno = 175
# sentno = 1
# text = כמו לנגה הטיפה גם הופרט לשימוש בצמחי המקום לצורך יצירת גן מקומי שהוא המשך לנוף הטבעי אשר יקשור את הקיבוץ אל האדמה הן מבחינה פיזית-ממשית על ידי יצירת תמונת נוף המשכית מהקיבוץ אל הטבע הסובב אותו, והן מבחינה רעיונית-רוחנית של התערות בנוף המקומי והפיכת הקיבוץ לחלק אינטגרלי של הנוף המקומי (הופרט, 1956).
