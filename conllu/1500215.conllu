# file = txt/1500215.txt
# filelineno = 176
# sentno = 2
# text = במאמרו ״הגן בישראל - קטן או גדול״ (1959) כתב כיצד נעשה שימוש בצמחייה המקומית ליצירת התאמה טובה יותר לטבע המקומי בקיבוץ מעלה החמישה: "כדאי עוד לציין את מעלה החמישה, שם השתמשו לראשונה בשיחי בר בכמות יותר גדולה ובעזרתם השיגו התאמה יותר טובה לטבע הסובב ולתנאי האקלים״ (ויס, 1959).
