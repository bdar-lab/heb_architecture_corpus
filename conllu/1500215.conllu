# file = txt/1500215.txt
# filelineno = 328
# sentno = 2
# text = בהתאם לתוכניותיו הקים עוד מדרכות, שתל דשא ליד בתי הילדים, והכין תשתית לצורך שתילת דשא בקדמת חדר האוכל, כמו כן הוציא לפועל פרויקטים נוספים ברחבי המחנה: שתילת צמחים מטפסים על כל מבני המגורים על מנת לווסת את החום בימי הקיץ; נטיעת צמחי כיסוי ושיחים וכן המשיך כדרכו בלימוד עצמי שינחה אותו במלאכתו (כספי, 1952ב).
