# text = אפרים היה איש של קונפליקט: קונפליקט בין צמחיית-הבר הטבעית לצמחי תרבות ואינטרודוקציה; קונפליקט בין צמחייה המחייבת טיפול והחזקה ובין זו שניתן לגדל במינימום דרישת מים; קונפליקט בין הבנייה וכל מה שנקרא במרכאות, פיתוח לצורכי היום־יום המתרחבים לבין שמירה על הקיים; הקונפליקט הקיים בכל יישוב ותיק בארץ, קיבוץ, מושב, ועיר בין העץ שהיכה שורשים ומסמל זהות וייחוד של המקום, ובין הפיתוח המחייב עקירה והתכחשות לעבר (סגל, 1984).
# raw = {'id': 1, 'text': 'אפרים היה איש של קונפליקט: קונפליקט בין צמחיית-הבר הטבעית לצמחי תרבות ואינטרודוקציה; קונפליקט בין צמחייה המחייבת טיפול והחזקה ובין זו שניתן לגדל במינימום דרישת מים; קונפליקט בין הבנייה וכל מה שנקרא במרכאות, פיתוח לצורכי היום־יום המתרחבים לבין שמירה על הקיים; הקונפליקט הקיים בכל יישוב ותיק בארץ, קיבוץ, מושב, ועיר בין העץ שהיכה שורשים ומסמל זהות וייחוד של המקום, ובין הפיתוח המחייב עקירה והתכחשות לעבר (סגל, 1984).', 'dspan': (0, 414), 'tokens': [{'id': 1, 'text': 'אפרים', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'nsubj', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'אפרים'}, {'id': 2, 'text': 'היה', 'upos': 'AUX', 'xpos': 'AUX', 'feats': 'Gender=Masc|Number=Sing|Person=3|Polarity=Pos|Tense=Past|VerbType=Cop', 'head': 3, 'deprel': 'cop', 'dspan': (6, 9), 'span': (6, 9), 'lemma': 'היה'}, {'id': 3, 'text': 'איש', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (10, 13), 'span': (10, 13), 'lemma': 'איש'}, {'id': 4, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 5, 'deprel': 'case:gen', 'dspan': (14, 16), 'span': (14, 16), 'lemma': 'של'}, {'id': 5, 'text': 'קונפליקט', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'nmod:poss', 'dspan': (17, 25), 'span': (17, 25), 'lemma': 'קונפליקט'}, {'id': 6, 'text': ':', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (25, 26), 'span': (25, 26), 'lemma': ':'}, {'id': 7, 'text': 'קונפליקט', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'appos', 'dspan': (27, 35), 'span': (27, 35), 'lemma': 'קונפליקט'}, {'id': 8, 'text': 'בין', 'upos': 'ADP', 'xpos': 'ADP', 'head': 12, 'deprel': 'case', 'dspan': (36, 39), 'span': (36, 39), 'lemma': 'בין'}, {'id': 9, 'text': 'צמחיית', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 12, 'deprel': 'nmod', 'dspan': (40, 46), 'span': (40, 46),