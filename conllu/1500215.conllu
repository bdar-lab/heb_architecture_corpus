# file = txt/1500215.txt
# filelineno = 251
# sentno = 5
# text = תכנון הנוף בהזורע כפי שתוכנן על ידי הופרט ומאירהוף כלל שילוב של צמחיית הכרמל כנצפית משטחי הקיבוץ, צמחיית־בר מקומית כנראית בתמונה 27 ו-28 (אולמוס, ערבה וצמח אברהם מהוואדי, כליל החורש מהכרמל, מילה סורית וכן צמחייה מיובאת, כגון ברוש הביצות ושיחי לילך כפי שמופיעים יחד בדשא הגדול שבין חדר האוכל למוזיאון בתמונה 29.
