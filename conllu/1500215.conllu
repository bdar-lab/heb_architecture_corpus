# file = txt/1500215.txt
# filelineno = 311
# sentno = 1
# text = כולנו היינו מאוד מושפעים מהספרות של ברית המועצות שעסקה בחקלאות וחשבה שהיא יכולה לשנות את הטבע, והוא (ישראל כספי), היה אוטודידקט, היה יושב בלילות ולומד מתוך הספרות של ליסנקו ומיצ׳ורין ורצה ליישם את הדברים הללו כאן (גל, 2015).
