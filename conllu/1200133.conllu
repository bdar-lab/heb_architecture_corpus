# file = txt/1200133.txt
# filelineno = 117
# sentno = 9
# text = בכל המצבים כושר הבידוד האקוסטי של מערכת הריצוף הנידונה שנבדקה כאשר נבנתה על חול גרוס SEZ, היה בממוצע 62dB והוא נמוך במעט מהערך של 63dB, הנדרש בתקן הישראלי הרלוונטי ודומה לזה של מערכת הייחוס שבוצעה על מצע של חול טבעי.
