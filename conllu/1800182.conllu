# file = txt/1800182.txt
# filelineno = 25
# sentno = 1
# text = ∗	כאמור, עקומות ספקטריות לתכן קובעות עומס סיסמי על מבנים כתלות בתקופה הבסיסית, וזאת גם כשמבנה נמצא בתחום אלסטי, וגם כאשר מותר, שמבנה יימצא בתחום לא אלסטי וניתן להשתמש במקדמי הקטנת הכוח עקב פעולה סיסמית.
