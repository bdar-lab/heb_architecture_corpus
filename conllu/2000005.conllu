# file = txt/2000005.txt
# filelineno = 205
# sentno = 1
# text = קורה ומתוך רצון לקרב את המרכז אל הכביסה לעיר, אין הוא מופיע באמצע הגיאוגרפי, כמו למשל בערים Harlow, Vallingby , Cidade Dos Motores, שם המרכז מוזז במקצת מהאמצע, נכוון לכניסת העיר (מצד הכביש הארצי), בתכנית ראוי׳ לציין נקודה נוספת באספקט זה, המרכז האזרחי—מסחרי נמצא לא רחוק ביותר מהאמצע הגיאוגרפי של איזורי המגורים ובצומת עורקי התחבורה הראשיים, השטחים בינו ובין הכניסה לעיר, כביש הגישה ותחנת הרכבת, מנוצלים כשטחי ספורט במקום לנצלם למגורים גרידא.
# raw = {'id': 1, 'text': 'קורה ומתוך רצון לקרב את המרכז אל הכביסה לעיר, אין הוא מופיע באמצע הגיאוגרפי, כמו למשל בערים Harlow, Vallingby , Cidade Dos Motores, שם המרכז מוזז במקצת מהאמצע, נכוון לכניסת העיר (מצד הכביש הארצי), בתכנית ראוי׳ לציין נקודה נוספת באספקט זה, המרכז האזרחי—מסחרי נמצא לא רחוק ביותר מהאמצע הגיאוגרפי של איזורי המגורים ובצומת עורקי התחבורה הראשיים, השטחים בינו ובין הכניסה לעיר, כביש הגישה ותחנת הרכבת, מנוצלים כשטחי ספורט במקום לנצלם למגורים גרידא.', 'dspan': (0, 442), 'tokens': [{'id': 1, 'text': 'קורה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 18, 'deprel': 'parataxis', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'קרה'}, {'id': (2, 3), 'text': 'ומתוך', 'expanded': [{'id': 2, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 1, 'deprel': 'dep', 'lemma': 'ו'}, {'id': 3, 'text': 'מתוך', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'מתוך'}], 'span': (5, 10), 'dspan': (5, 10)}, {'id': 4, 'text': 'רצון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'obl', 'dspan': (11, 15), 'span': (11, 15), 'lemma': 'רצון'}, {'id': 5, 'text': 'לקרב', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PIEL|VerbForm=Inf|Voice=Act', 'head': 4, 'deprel': 'acl', 'dspan': (16, 20), 'span': (16, 20), 'lemma': 'קירב'}, {'id': 6, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 8, 'deprel': 'case:acc', 'dspan': (21, 23), 'span': (21, 23), 'lemma': 'את'}, {'id': (7, 8), 'text': 'המרכז', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'מרכז', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'obj', 'lemma': 'מרכז'}], 'span': (24, 29), 'dspan': (24, 29)}, {'id': 9, 'text': 'אל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'dspan': (30, 32), 'span