# file = txt/2000005.txt
# filelineno = 279
# sentno = 1
# text = החלק הראשון,civic centre , מופיע בצודה ברורה, נפרדת ומגובשת בתכניות 1, 2, 7, 13, בשעה שבתכניות אחרות הוא מצורף לאגףיס אחרים או שאינו מגובש כלל, חלק זה, כאשר הוא קיים בצורה זו, כולל את *בכר •העיר" או ה״ככר האזרחית״ (town square), הנקודה המוקדית של המרכז, למעשה המונח civic centre בתרגום מלולי, פירושו "מרכז אזרחי", כלוטד הוא הוא המרכז לחברת אזרחי העיר, אולם נראה מהתכניות שה-civic centre נמצא לעתים במנה לא בולטת בתכנית המרכז ונשאלת השאלה באם באמת ימלא במבחן המציאות תפקיד מוקדי כזה.
