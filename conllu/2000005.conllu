# file = txt/2000005.txt
# filelineno = 159
# sentno = 4
# text = עלול להיצר אחד משני המצבים הבאים, בהתאם למסיבות: או שהמרכז החברתי של העיד ימשיך להיות במרכז הישן, המסורתי, וכל המאמצים להפיח חיים במרכז החדש לא ישאו פרי; או שהמרכז החדש יהדר, את המוקד לארכלוסיה החדשה בלבד בה בשעה שהמרכז הישן ישמש אך את האוכלוסיה הקיימת מלפני בן.
