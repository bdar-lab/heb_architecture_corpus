# file = txt/2300140.txt
# filelineno = 1050
# sentno = 5
# text = השימוש שעושה השילטון המקומי בתוכנית המיתאר ובתהליך התיקונים, ניצול התיקונים המפורטים בתוכנית על ידי יזמי הפיתוח ואישורם על ידי ועדות התיכנון המקומיות, ההפרה הנפוצה מאוד, יחסית למדינות מערביות, על ידי דיירים פרטיים של דרישות חוק התיכנון, וקיומה של בנייה בילתי חוקית רבה - כל אלה מוכיחים שמערכת התיכנון לא הצליחה לשעבד את המטרות הפרטיזניות למטרות חברתיות".
