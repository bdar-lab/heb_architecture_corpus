# file = txt/2500055.txt
# filelineno = 1607
# sentno = 1
# text = ההשוואה עם שיטות חישוב מקורבות הראתה כי החיזוי הקרוב ביותר לחישוב המדויק מתקבל ע״י שיטת החישוב לפי טורים, אך ברוב המקרים שיטה זו גורמת להערכת התנגדות ממוצעת גדולה במקצת מזו המתקבלת בחישוב המדויק, שיטת החישוב לפי שכבות גורמת תמיד לחיזוי התנגדות ממוצעת נמוכה מזו המתקבלת בחישוב המדויק, ובמקרים רבים לחיזוי ערך נמוך במיוחד.
