# file = txt/2500055.txt
# filelineno = 1131
# sentno = 1
# text = הפרמטרים הקובעים את רמת הרעש והכדור של המערכת חלוו/הצללה הם: מיקום הרמקול, מיקום המיקרופון, זוית הפתיחה של החלון" (הגדלים הרלבנטיים האחרים הם מדות המתרס, החלון והקיר ותכונותיהם, וכן נתוני חדר השדור וחדר הקליטה, אך אלה אינם משתנים ולכן לא יחשבו כפדמטרים בבעיה), המערך מתואר בציור 3, הן הרמקול והן המיקרופון מוקמו במרחק של 1,70 מ’ ממרכז פני הקיר מצד חדר הקליטה״ נוסו 5 עמדות עבור הראשון נדויות 30° עד 150°, בהפרשים של 30°) ו—3 עמדות עבור השני (זויות 510° 45°, 90°), עבור זויות פתיחה שובות, כן נמדד המצב בו החלון סגור.
