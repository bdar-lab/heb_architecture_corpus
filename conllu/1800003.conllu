# file = txt/1800003.txt
# filelineno = 562
# sentno = 1
# text = שכר עבודה כולל את כל התשלומים ברוטו (לפני הניכויים), החייבים במס הכנסה, ששולמו לשכירים בחודש הדיווח (כולל הפרשי שכר ומקדמות), כלומר: שכר יסוד ותוספות: יוקר, מקצועית, ותק, משפחה (ללא קצבת ילדים), פרמיות ובונוסים, תשלומים בעבור שעות נוספות ותנאי עבודה מיוחדים (תוספת שדה, ערכה וכדו׳), ״משכורת 13״, תשלומים בעבור ימי היעדרות (ימי מילואים, חופשה, חג, מחלה וכוי), דמי הבראה, ספרות מקצועית, תשלומים בעבור אחזקת רכב (לרבות זקיפה בעבור רכב של המעסיקים הנמצא ברשות העובד), טלפון, כלכלה ואש״ל (החייבים במס הכנסה בלבד), דמי נסיעה לעבודה ובחזרה, תשלומים בעין (שי, דיור וכוי) השתתפות בשכר לימוד של ילדי העובדים, וכוי.
