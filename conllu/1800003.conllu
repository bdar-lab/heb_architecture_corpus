# file = txt/1800003.txt
# filelineno = 192
# sentno = 2
# text = למעשה, בשנים 2001 עד 2009, החל להיווצר פער ביקוש בעוד עודפי הדירות מהעשור הקודם הלכו והתמעטו וקצב התחלות הבנייה ירד לכ- 32,000 יחידות דיור בשנה, החל משנת 2010, בעקבות עודף התחלות הבנייה השנתיות על תוספת משקי הבית, פער הביקוש הולך ומצטמצם.
