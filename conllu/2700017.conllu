# file = txt/2700017.txt
# filelineno = 208
# sentno = 1
# text = השינויים במבנה הענפי, כמפורט בלוח ו.ו להלן, יתבטאו בעלייה במשקלם בתוצר ובתעסוקה של הענפים היצרניים והענפים הסחירים, בעיקר בתחומי התעשייה והשירותים הפרטיים (בהבחנה מהשירותים המסופקים באמצעות המגזר הציבורי) וירידה במשקלם של הענפים הסחירים פחות, ירידה במשקל החקלאות (לכ-2% בתעסוקה), השירותים הציבוריים (משיעור של כ-30% לכ־24%) והבנייה וירד או יישאר קבוע חלקם היחסי של ענפי החשמל והמים, והתחבורה, אחסנה ותקשורת.
