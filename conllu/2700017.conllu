# file = txt/2700017.txt
# filelineno = 155
# sentno = 1
# text = הפיכת מערכת יישובית הטרוגנית - ערי פיתוח, פרברים ויישובים בדווים למטרופולין קומפקטי ומובנה היטב, בעל איכויות חיים גבוהות במיוחד, המתפתח בשילוב טוב עם משאבי נוף וטבע אזוריים ־ תחייב מעורבות ממשלתית וציבורית מעמיקה, הן בצורת מערכות רגולציה תכנונית ואדמיניסטרטיבית יעילות ובעלות כושר הכוונה ובקרה משמעותיים והן בצורת השקעות ציבוריות גדולות ההכרחיות ליצירת מטרופולין מגובש מרחבית, בעל נגישות גבוהה בין כל חלקיו והמחובר היטב אל המרחבים המעוירים האחרים ואל נמלי האוויר והים הבין־לאומיים.
