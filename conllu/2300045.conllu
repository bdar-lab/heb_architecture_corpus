# text = לעומתה, הגיאומטריה הפרקטאלית אשר הוגדרה ופותחה לראשונה על ידי המתמטיקאי Mandelbrot בשנת 1983, הופכת יותר ויותר לאחד הכלים העיקריים המשמשים לתיאור וניתוח תופעות בתחומי המדעים השונים ומקבלת בשנים האחרונות דגש מיוחד במחקר האורבאני.
# raw = {'id': 1, 'text': 'לעומתה, הגיאומטריה הפרקטאלית אשר הוגדרה ופותחה לראשונה על ידי המתמטיקאי Mandelbrot בשנת 1983, הופכת יותר ויותר לאחד הכלים העיקריים המשמשים לתיאור וניתוח תופעות בתחומי המדעים השונים ומקבלת בשנים האחרונות דגש מיוחד במחקר האורבאני.', 'dspan': (0, 228), 'tokens': [{'id': (1, 2), 'text': 'לעומתה', 'expanded': [{'id': 1, 'text': 'לעומת', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'לעומת'}, {'id': 2, 'text': 'ה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Prs', 'head': 22, 'deprel': 'obl', 'lemma': 'הוא'}], 'span': (0, 6), 'dspan': (0, 6)}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (6, 7), 'span': (6, 7), 'lemma': ','}, {'id': (4, 5), 'text': 'הגיאומטריה', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'גיאומטריה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 22, 'deprel': 'nsubj', 'lemma': 'גיאומטריה'}], 'span': (8, 18), 'dspan': (8, 18)}, {'id': (6, 7), 'text': 'הפרקטאלית', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'פרקטאלית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'amod', 'lemma': 'פרקטאלית'}], 'span': (19, 28), 'dspan': (19, 28)}, {'id': 8, 'text': 'אשר', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 9, 'deprel': 'mark', 'dspan': (29, 32), 'span': (29, 32), 'lemma': 'אשר'}, {'id': 9, 'text': 'הוגדרה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=HUFAL|Number=Sing|Person=3|Tense=Past|Voice=Pass', 'head': 5, 'deprel': 'acl:relcl', 'dspan': (33, 39), 'span': (33, 39), 'lemma': 'הוגדר'}, {'id': (10, 11), 'text': 'ופותחה', 'expanded': [{'id': 10, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 11, 