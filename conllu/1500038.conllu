# file = txt/1500038.txt
# filelineno = 168
# sentno = 2
# text = ארגון זה שהוקם בשנת 1965, שם לו למטרה להגן על הרקמה ההיסטורית של ערים ומדגיש כי אזורים היסטוריים מורכבים לא רק מאלמנטים פיסיים, אלא גם מפעילות אנושית ותרבותית ויחד הם יוצרים סך אינטגרטיבי (החשוב למורשת העולמית ולקיום תרבותי אינדיבידואלי גם בהווה).
