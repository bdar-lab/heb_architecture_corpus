# file = txt/1500038.txt
# filelineno = 1182
# sentno = 1
# text = לפי סעיף 69 וסעיף 63 (סעיף קטן 7) לחוק התכנון והבנייה ייקבע שהבינוי על פי תכנית זו ממצה את אפשרויות מתן ההקלות בגבול סטייה בלתי ניכרת וכל תוספת קומות , תוספת גובה בנייה ,תוספת שטחי בנייה או הקטנת מרווחים שלא בהתאם לתכנית זו, תיחשב לפי סעיף 1(סעיף קטן 1) לתקנות התכנון והבנייה כסטייה ניכרת מתכנית (תשכ״ז 1967).
