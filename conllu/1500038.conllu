# file = txt/1500038.txt
# filelineno = 419
# sentno = 5
# text = תכנית נוספת שיזמה קרן השימור ב-1983 היא גוף הנקרא National Main Street Center, שמטרתו לעודד גופים מקומיים לקיים פעילויות להחייאת מרכזי הערים, תוך שימור הרקמה ההסטורית של הרחוב, ובסיוע כלכלי למבצעי התכנית ולבעלי עסקים פרטיים השייכים לפרויקט.
