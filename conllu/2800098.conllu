# file = txt/2800098.txt
# filelineno = 139
# sentno = 1
# text = - טיפול מיוחד במסלולי המעבר הפנימי מהכניסה לדירה, וזוך התחשבות בהפרדת מעבר זה מחדר המגורים ומניעת הנישה הוויזואלית מאזור הכניסה אל אזור הפעילויות האינטימיות של המשפחה, ובסיכומו של דבר: להבטחת התאום הפרוגרמתי בין הטיפול התבנוני ב"כניסה לדירה" לבין צורכיהם של המשתכנים, ניראה שרצוי ליתד מקום מיוחד לנושא הנדון במסגרת הפרוגרמה - התדריך התכנוני שמקבל המתכנן, המדובר, בהכללתם של ההיבטים הנזכרים לעיל באיזו מערכת של "הנחיות איכותיות", לשם הפיכת הכניסה לדירה משאלה טכנית של הצבת הדלת למרכיב המבטא את הבטחת חופש הפרם והמשפחה בדירה,
