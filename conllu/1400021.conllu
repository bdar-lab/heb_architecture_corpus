# file = txt/1400021.txt
# filelineno = 220
# sentno = 1
# text = הסוג געדה כולל 12 מינים בארץ ומתוכם שלושה הנפוצים ביותר, היכולים לשמש כצמחים בפארקים, גינות וצידי דרכים, בשילוב עם מינים אחרים: געדה מצויה (Teucrium cap/tatum) (אשר גדלה גם באזור הצחיח), געדה כרתית (Teucrium creticuni) (תמונה מסי 19), וגעדה מפושקת (Teucrium divaricatum).
