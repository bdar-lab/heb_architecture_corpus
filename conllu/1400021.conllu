# file = txt/1400021.txt
# filelineno = 21
# sentno = 3
# text = הכנסת מינים זרים גורמת לבעיות אקולוגיות משום שהם לא משתלבים במערכות בהן הם הוכנסו: בעלי חיים כמו צמחים זרים, אם פולשים, יתחרו עם המינים המקומיים על המרחב ועל המשאבים הטבעיים, ובהיעדר טפילים ו/או טורפים מקומיים, אוכלוסיותיהם של המינים הזרים הפולשים גדלות ללא בקרה וגורמות נזק רב, לעיתים קרובות בלתי הפיך, למינים המקומיים.
