# file = txt/1400021.txt
# filelineno = 138
# sentno = 5
# text = המאמרים שפורסמו לאחרונה בסוגית הצמחים הפולשים באגן הים התיכון התמקדו במינים מסוימים, בשאלות הקשורות להערכת סיכון הפלישה, או בהערכת רמת רגישות בתי הגידול לחדירת צמחים זרים, עם דגש על איים ים תיכונים לעומת האזור הים תיכוני היבשתי.
