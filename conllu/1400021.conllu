# file = txt/1400021.txt
# filelineno = 88
# sentno = 1
# text = מניעת חדירת צמחים פולשים היא פעולה קלה יותר מפיתוח ויישום טיפולים, והיא מאפשרת לחסוך הוצאות כספיות גדולות ביותר: לשם דוגמא עלות הנזקים הסביבתיים בלבד, כלומר ללא עלויות הנזקים לחקלאות, הנגרמים מצמחים פולשים בארה"ב מגיעה ל-148 מיליון דולר לשנה (!); במדינת דרום אפריקה, הנפגעת קשות מצמחים פולשים, הנזקים הסביבתיים הנובעים ישירות מפלישת צמחים זרים עולים 95 מיליון דולר בשנה (2001 .Pimentel etal).
