# file = txt/2300014.txt
# filelineno = 67
# sentno = 1
# text = נביא דוגמא תיאורטית : באיזור מגורים על קרקע צבורית, אשר אין לגביו ציפיות כי יפותח ב-10 השנים הבאות, מגדירה התכנית אתר למרכז-מסחרי בגודל מסריים" כאשר מגיע מועד הפתוח, מסתבר כי דפוסי מגורים חדשים אשר לא נלקחו בחשבון מכתיבים מערךומיקום אחר־ לו היו המתכננים מזקקים את העקרונות אשר הינחום ומציגים אותם ככללים כתובים, ניתן היה להכתיב את הנורמה הכמותית של שטח מסחרי החזוי לאוכלוסיה נתונה, את עקרון הנגישות (למשל, ע״י שבילים להולכי-רגל), את המרחק המירבי המותר מקצות השכונה, הערוב הרצוי של סרגי שרותים, וכדי־ בבא העת, היה המתכנן של התכנית המפורטת מסרגל ליישם את העקרונרת ולהגיע לפתרון רלבנטי ולא שרירותי־ רק אם השתנו העקררנות - רזה כמובן אפשרי־-יהיה צורך בשינוי התכנית, אולם ההסתברות לכך נמוכה יותר מאשר לגבי שינוי במיקום־ דוגמאות מעין אלה ניתן לתת גם לתחומים של אופי תעשיות, כאשר העקרונות שינחו יהיו עקרונות תפעול (Performace Standards) ולא קביעות-ברסר באשר ל״סוג" התעשיה, שכן רמת הבקרה על מזהמים והתכנון האסתטי עשויים להשתכלל עד מועד הפיתוח־ הקביעות הפיזיות-גיאוגרפיות תשארנה לשלב של התכנית המפורטת־
