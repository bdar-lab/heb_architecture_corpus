# file = txt/2300014.txt
# filelineno = 59
# sentno = 1
# text = מתוך פסק דין אחרון זה, עדיין לא ניתן ללמוד על אימוץ מפורש של הגישה הפיזית-הרחבה, אולם נראה כי הכוון ברור־ אף המציאות בשטח צועדת בכוון זה וכמעט אין היום למצוא תכניות מיתאר אשר אינן כוללות מטרות כלכליות או חברתיות בין מטרותיהן, בין אם במפורש או באופן משתמע; ולא רק זאת, אלא שמספר תכניות מיתאר בשנים האחרונות קבלו סממנים של "תכנית אב" או תכנית מבנית, בה נכללים שיקולים חברתיים וכלכליים מפורשים הן כתשומה של נתונים והן כחלק מהיעדים־ נראה כי מציאות זו השפיעה על גישת בית-המשפט באור, אולם מבחינת המשפט הרצוי, אין להסתפק בפרשנות זו, מרחיבה ככל שתהיה, ורצוי לערוך שינויים בסעיפים 61 ו-63 הדנים במטרות תכנית מיתאר מקומית והוראותיה, כך שיכללו במפורש מטרות כלכליות וחברתיות כתשומה לתכנית הפיזית ויאפשרו נסות הוראות בדבר מדיניות פתוח ואיכות-חיים בתחומים שונים־
