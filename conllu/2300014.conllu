# file = txt/2300014.txt
# filelineno = 93
# sentno = 2
# text = שני פסקים אלה ניתנו עוד בימי פקודת בניו ערים ולכן אינם מטילים אור במישרין על צורת התכנית ע״פ החוק־ אולם מבג״צ אור משתמע ברורות כי מאחר וקביעת "עקרונות כלליים" אינה יכולה להיעשות בצורה משביעת-רצון על גבי תשריט בלבד, תותר הסבת הדגש למסמך הכתוב, אולם ברי כי תמיד יש לצרף לתכנית תשריט (ע״פ דרישת סי 83) וזאת בניגוד למצב בבריטניה באשר לתכנית המבנית־ אין בכך כדי להגביל את התפיסה של תכנית מיתאר כתכנית המציגה עקרונות, כיון שברוב המקרים קיימים נושאים אשר הסדרתם על-גבי מפה היא עינינית וחיונית; ואפילו אם לא יחולו במקרה מסויים, הרי ע״פ בג״צ אור גם "תכנית מסגרת" כמו זו המופיעה בעובדות המקרה והמסמנת רק גבולות להתיחסות, תכנית מיתאר תקפה היא.
