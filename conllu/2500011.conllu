# file = txt/2500011.txt
# filelineno = 150
# sentno = 1
# text = י אם נתייחס לםה״כ של ההוצאות, הכולל הוצאות הבנייה, הוצאות המהוונות לאנרגיה והוצאות למתקני הסקה (המהווה קריטריון להגדרת הכלכליות הכוללת), נראה שהפתרון של בלוקי בטון חלולים איננו כלכלי בהשוואה לפתרונות אחרים, המצטיינים בתכונות תרמיות טובות יותר, שמאפשרות חיסכון באנרגיה.
