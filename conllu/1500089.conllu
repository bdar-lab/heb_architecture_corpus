# file = txt/1500089.txt
# filelineno = 138
# sentno = 5
# text = רק בשנות ה- 70 וה-80 של המאה הקודמת יהודים בני המעמד הבינוני והמעמד הגבוה , (בהתאם להעדפות שלהם ), החלו לצאת ממרכזי הערים אל ישובים קהילתיים לא חקלאיים לאורך הגבולות ובאזורי ספר במרכז הגליל ובגדה המערבית במטרה לתפוס "חזקה יהוד ית" ( פרנקל ואשכנזי, 2005).
