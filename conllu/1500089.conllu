# file = txt/1500089.txt
# filelineno = 138
# sentno = 3
# text = בתקופת המהפכה התעשייתית ובניגוד לארצות המתועשות שרבים מכפריהן , בייחוד במקומות מרוחקים מהעיר , סבלו מעזיבה ואף מנטישה מוחל טת, הכפר בישראל הושפע אך במעט מתהליכי העיור והתיעוש (גרוסמן, 1994).
