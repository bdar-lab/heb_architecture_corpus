# file = txt/1500089.txt
# filelineno = 392
# sentno = 3
# text = כך לדוגמה בשני היישובים שהוצגו לעיל , הצפיפות הממוצעת של היישוב פורדיס, בו התקבל הרדיוס הקטן ביותר מבין כל יישובי המדגם, היא 1.67 בניין לדונם בשנת 1995 (כלומר ניתן לייחס שטח של 598 מ" 2רP2T1TP16F קרקע לבניין ביישוב פורדיס ) ואילו ביישוב טמרה התקבלה צפיפות של 1.06 בניין לדונם בשנת 2006 (כלומר ניתן לייחס שטח של 943 מ"ר קרקע לבניין ).
