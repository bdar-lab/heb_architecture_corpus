# file = txt/1500089.txt
# filelineno = 624
# sentno = 4
# text = לצד אלה, פעולות משולבות של תכנון ייזום על ידי הממשלה , מבנה הבעלות על קרקע , העדר שוק מקרקעין ותנאים גיאופוליטיים נוספים משפיעים ומשנים באופן משמע ותי את מאפייניהם הפיסיים- מרחביים, אשר התפתחו ונשמרו לאורך מאות שנים , ומעצבים מחדש את ה "חותמת הקרקעית " של המרקם הבנוי בהם .
