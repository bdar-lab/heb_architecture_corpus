# file = txt/1500089.txt
# filelineno = 143
# sentno = 2
# text = ציפוף הבנייה בערים הקיימות, שמירה על המרחב הפתוח וריכוז הפיתוח של שימושי קרקע עסקיים במספר מוגבל של אזורי תעסוקה גדולים, הפכו להיות חלק מעקרונות התכנון של התוכניות הארציות והמחוזיות שהוכנו בעשור האחרון (רזין וחזן, 1996).
