# file = txt/1800088.txt
# filelineno = 164
# sentno = 2
# text = שינויים ממשיים בתחזיות אלה חלו בעיקר באזורי רכס ההר המרכזי ומדרונותיו המערביים והמזרחיים, כפי שניתן לראות בציור 3.1 להלן, בו מוצגת השוואה בין שתי המפות, כאשר האיזוטכים (קווים שווי מהירות) הכלולים במפה הישנה משנת 1969, מומרים למהירות בסיסית על בסיס זהה לזה של המפה החדשה משנת 1998, קרי הממוצע של מהירות הרוח במשך 10 דקות, כמוגדר לעיל.
