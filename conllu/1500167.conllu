# file = txt/1500167.txt
# filelineno = 84
# sentno = 2
# text = דוגמאות לכך הן ההוספיס האוסטרי (שנקרא היום בית חולים "המשפחה הקדושה״) שנוסד בשנת 1880; בית החולים הצרפתי שנוסד בשנת 1880; הסמינר הרוסי שנוסד בשנת 1904 וכלל אכסנייה לצליינים והוספיס; בית הספר הסליזיאני והבזיליקה הניאו־גותית שלו, שניבנו בשנת 1918 על הגבעה המערבית הצופה למרכז העיר; ובית חולים נצרת (המכונה "בית החולים האנגלי״) שנוסד בשנת 1924 על ידי מיסיונרים אנגליקנים.
