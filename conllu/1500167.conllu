# file = txt/1500167.txt
# filelineno = 347
# sentno = 1
# text = החשיבה הפילוסופית של מגזין "אל־עמארה" הייתה להציג את התיאוריות האדריכליות המודרניות של המערב לציבור המצרי, למשל את האדריכלות האורגנית של פרנק לויד רייט, את הרציונליזם של מיס ון דר רוהה, את האקספרסיוניזם של אריך מנדלסון ואת הפונקציונליזם של לה-קורבוזיה.
