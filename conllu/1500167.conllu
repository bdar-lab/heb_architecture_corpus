# file = txt/1500167.txt
# filelineno = 242
# sentno = 1
# text = בין העבודות הראשונות של אל-ג׳אדירג׳י, שבהן יישם את תוצרי החיפוש שלו אחר צורה מופשטת שתיתן לבניין צביון מיוחד, אפשר לציין את קיר המסך שמאחוריו רשת מברזל, בחזית האחורית באזור הריוואק בווילה שבנה אל־ג׳אדירג׳י לחסן אל-כרבאסי בבגדד (איור 57) וכן את הווילה שבנה אל-ג׳אדירג׳י לחסין ג׳מיל (ראו איורים 55 ו- 56).
