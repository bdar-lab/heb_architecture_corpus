# text = לאחרונה פותחו טכניקות אקטיביות להנחתת רעש בלתי רצוי (Active Noise Control) שמזהות באמצעות מיקרופונים את אופייני הרעש הראשוני (ההפרעה) ובאמצעות מערכת בקרה אדפטיבית וממוחשבת מייצרות גלי קול בתמונת ראי לשדה המקורי ה״מרעיש", שעוברים התאבכות הורסת עם הגלים המקוריים ויוצרים "שקט" בשטח מוגדר.
# raw = {'id': 2, 'text': 'לאחרונה פותחו טכניקות אקטיביות להנחתת רעש בלתי רצוי (Active Noise Control) שמזהות באמצעות מיקרופונים את אופייני הרעש הראשוני (ההפרעה) ובאמצעות מערכת בקרה אדפטיבית וממוחשבת מייצרות גלי קול בתמונת ראי לשדה המקורי ה״מרעיש", שעוברים התאבכות הורסת עם הגלים המקוריים ויוצרים "שקט" בשטח מוגדר.', 'dspan': (372, 658), 'tokens': [{'id': 1, 'text': 'לאחרונה', 'upos': 'ADV', 'xpos': 'ADV', 'head': 2, 'deprel': 'advmod', 'dspan': (372, 379), 'span': (0, 7), 'lemma': 'לאחרונה'}, {'id': 2, 'text': 'פותחו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PUAL|Number=Plur|Person=3|Tense=Past|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (380, 385), 'span': (8, 13), 'lemma': 'פותח'}, {'id': 3, 'text': 'טכניקות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 2, 'deprel': 'nsubj:pass', 'dspan': (386, 393), 'span': (14, 21), 'lemma': 'טכניקה'}, {'id': 4, 'text': 'אקטיביות', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Plur', 'head': 3, 'deprel': 'amod', 'dspan': (394, 402), 'span': (22, 30), 'lemma': 'אקטיביות'}, {'id': (5, 6), 'text': 'להנחתת', 'expanded': [{'id': 5, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ל'}, {'id': 6, 'text': 'הנחתת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'nmod', 'lemma': 'הנחתה'}], 'span': (31, 37), 'dspan': (403, 409)}, {'id': 7, 'text': 'רעש', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'compound', 'dspan': (410, 413), 'span': (38, 41), 'lemma': 'רעש'}, {'id': 8, 'text': 'בלתי', 'upos': 'ADV', 'xpos': 'ADV', 'feats': 'Polarity=Neg|Prefix=Yes', 'head': 9, 'deprel': 'compound:affix', 'dspan': (414, 418), 'span': (42, 46), 'lemma': 'בלתי'}, {'id': 9, 'text': 'רצוי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'amod', 'dspan': (419, 423), 'span': (47, 51), 'lemma': 'רצוי'}, {'id': 10, 'text