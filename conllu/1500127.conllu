# file = txt/1500127.txt
# filelineno = 588
# sentno = 3
# text = לדוגמה, כדי לדעת האם הגישה יכולה להעריך את איכות הנגישות במקרי הבוחן, עלינו להבדיל ולהפריד את נתוני הבסיס כך שיציגו מחד את האוכלוסייה של אנשים עם מוגבלויות, קרי, אלה שלא יעלו במדרגות ושרק יגיעו ליתר המפלסים באמצעות המעלית, ואת אלו שיכולים לנוע במדרגות מאידך.
