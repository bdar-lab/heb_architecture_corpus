# filelineno = 265
# text = כאן, ידהר מאמר חלל בודד, עעמאי, מופיעה מבכר (כפי עבראח בתחילת חרכסכט) כשרשרת חללים, קשורים בינם לבין עפמם, ומוותרים על ידי חפוכקעית מריבאמית אותת מיו דריכיב למלא, ועל ידי התפתחויות בפגיאליוח מרסוביוה, בו בזמן ®נקומפוזיזיה חאקפיאלית על מפורום מרומי, מיו חבביביס חדבורייס מעברהיס למורת”חממוחתת" של מפורום, ממקום היחידי המקדר ביכימם.
# raw = {'id': 2, 'text': 'כאן, ידהר מאמר חלל בודד, עעמאי, מופיעה מבכר (כפי עבראח בתחילת חרכסכט) כשרשרת חללים, קשורים בינם לבין עפמם, ומוותרים על ידי חפוכקעית מריבאמית אותת מיו דריכיב למלא, ועל ידי התפתחויות בפגיאליוח מרסוביוה, בו בזמן ®נקומפוזיזיה חאקפיאלית על מפורום מרומי, מיו חבביביס חדבורייס מעברהיס למורת”חממוחתת" של מפורום, ממקום היחידי המקדר ביכימם.', 'dspan': (188, 518), 'tokens': [{'id': 1, 'text': 'כאן', 'upos': 'ADV', 'xpos': 'ADV', 'head': 3, 'deprel': 'advmod', 'dspan': (188, 191), 'span': (0, 3), 'lemma': 'כאן'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (191, 192), 'span': (3, 4), 'lemma': ','}, {'id': 3, 'text': 'ידהר', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PUAL|Number=Sing|Person=3|Tense=Fut|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (193, 197), 'span': (5, 9), 'lemma': 'ידהר'}, {'id': 4, 'text': 'מאמר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'obj', 'dspan': (198, 202), 'span': (10, 14), 'lemma': 'מאמר'}, {'id': 5, 'text': 'חלל', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'compound:smixut', 'dspan': (203, 206), 'span': (15, 18), 'lemma': 'חלל'}, {'id': 6, 'text': 'בודד', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'amod', 'dspan': (207, 211), 'span': (19, 23), 'lemma': 'בודד'}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (211, 212), 'span': (23, 24), 'lemma': ','}, {'id': 8, 'text': 'עעמאי', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 4, 'deprel': 'appos', 'dspan': (213, 218), 'span': (25, 30), 'lemma': 'עעמאי'}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (218, 219), 'span': (30, 31), 'lemma': ','}, {'id': 10, 'text': 'מופיעה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HIFIL|Number=Sing|Pers