# file = txt/2300013.txt
# filelineno = 61
# sentno = 2
# text = אין פלא כי כמענה הוצעו גישות רבות שונות לתכנון - מתכנון לטווח קצר ובינוני ובאופן שוטף (1965 Branch 1971 ;Robinson) דרך כלים שונים למעקב (1974, Haynes) ועד שלילה כמעט מוחלטת של הכנת תכניות ושאיפה לשילוב המתכנן כמעין יועץ אורבני המסייע בפתרון משברים (1973 Friedmann, 1971 ;Rondinelli)־
