# text = ולבסוף, שלושה שימושי הקרקע בעלי זיקה כלכלית-תעסוקתית - מסחר, מלאכה ותעשיה - מאופיינים ע״י מידת התאמה בינונית המשקפת, לדעתנו, מחד את עמידות ייעודים אלה בפני כרסום הנובע משקולים כלכליים, ומאידך את השינויים אשר חלו באופי הפתוח ואשר חייבו שינוי במיקום אזורי המסחר והתעשיה.
# raw = {'id': 2, 'text': 'ולבסוף, שלושה שימושי הקרקע בעלי זיקה כלכלית-תעסוקתית - מסחר, מלאכה ותעשיה - מאופיינים ע״י מידת התאמה בינונית המשקפת, לדעתנו, מחד את עמידות ייעודים אלה בפני כרסום הנובע משקולים כלכליים, ומאידך את השינויים אשר חלו באופי הפתוח ואשר חייבו שינוי במיקום אזורי המסחר והתעשיה.', 'dspan': (158, 426), 'tokens': [{'id': (1, 2), 'text': 'ולבסוף', 'expanded': [{'id': 1, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 20, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 2, 'text': 'לבסוף', 'upos': 'ADV', 'xpos': 'ADV', 'head': 20, 'deprel': 'advmod', 'lemma': 'לבסוף'}], 'span': (0, 6), 'dspan': (158, 164)}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (164, 165), 'span': (6, 7), 'lemma': ','}, {'id': 4, 'text': 'שלושה', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Gender=Masc|NumType=Card', 'head': 5, 'deprel': 'nummod', 'dspan': (166, 171), 'span': (8, 13), 'lemma': 'שלושה'}, {'id': 5, 'text': 'שימושי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 20, 'deprel': 'nsubj:pass', 'dspan': (172, 178), 'span': (14, 20), 'lemma': 'שימושי'}, {'id': (6, 7), 'text': 'הקרקע', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'קרקע', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'compound', 'lemma': 'קרקע'}], 'span': (21, 26), 'dspan': (179, 184)}, {'id': 8, 'text': 'בעלי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'acl', 'dspan': (185, 189), 'span': (27, 31), 'lemma': 'בעל'}, {'id': 9, 'text': 'זיקה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'compound', 'dspan': (190, 194), 'span': (32, 36), 'lemma': 'זיקה'}, {'id': 10, 'text': 'כלכלית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 9, 'deprel