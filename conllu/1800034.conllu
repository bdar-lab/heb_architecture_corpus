# file = txt/1800034.txt
# filelineno = 190
# sentno = 1
# text = לאמיתו של דבר נדרשת רק תשובה לשאלה, מהו הגודל הממוצע, בהווה, של מחזור גיל ("קוהורט") חרדי, אשר נולד לפני 21-18 שנה לערך, ואשר מהווה היום, קרוב לודאי, את הבסיס הביולוגי לקבוצת האנשים, אשר עם נישואיה מייצרת את הביקושים לדיור הרלוונטי, המעניין את משרד הבינוי והשיכון.
