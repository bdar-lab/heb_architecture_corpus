# file = txt/1500104.txt
# filelineno = 17
# sentno = 2
# text = בעקבות היווצרות מחסור בקרקעות לבנייה באזורי הביקוש בארץ, מחד, והרצון לשמור על שטחים פתוחים ירוקים ורציפים, מאידך, החליטה הממשלה (בשנת 1999 ובשנת 2000) לייעל את השימוש במשאב הקרקע, תוך שימוש בתת-הקרקע ובעל-הקרקע באופן מושכל יותר.
