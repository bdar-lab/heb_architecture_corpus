# file = txt/2300060.txt
# filelineno = 295
# sentno = 8
# text = מיידי - נטייה העלולה להביא לתופעה של שטחים ציבוריים הנותרים ללא פיתוח; השני, אחוז ההפקעה האחיד (הנתפש בדרך-כלל כאחוז מינימום ולא מקסימום) המביא לעתים ליצירת עודפי קרקע ציבורית דווקא באזורים שאינם מתאימים להפעלת שי ר ו ת י-צ י בו ר; והשלישי, הקלות היחסית של ביצוע הפקעות באזורים חדשים, והנטייה עקב כך למקם שם שירותי-ציבור המיועדים לשרת גס שכונות קיימות אשר לעתים אינן נמצאות בטווח נגישות נוח.
