# file = txt/2500002.txt
# filelineno = 5
# sentno = 2
# text = על—מנת להגשים מטרה זאת, הוחלט להתרכז בניתוח בעיות האיוורור בבניו טיפוסי בסביבה חופשית מבנינים אחרים, בתקוה שניתן יהיה לפתח שיטה להערכה כמותית של איכות האיוורור בדירות נתונות, ועל-ידי-כך להתוות דרך להמשך חקירה מקיפה על הנושא.
