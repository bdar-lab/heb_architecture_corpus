# file = txt/2000130.txt
# filelineno = 897
# sentno = 1
# text = הצורך לבחון את השפעת הגורמים השונים על תפיסות האדם את הנוף מוזכרת ע״י Kaplan & Kaplan (1989), הטוענים כי הגורמים האנושיים המשפיעים על תפיסות האדם את הנוף כוללים בין היתר: תרבות, רמה טכנולוגית, ונתונים דמוגרפיים שונים דוגמת מקצוע, גיל, מין, מידת היכרות עם הנוף, זמן הגעה וותק במקום.
