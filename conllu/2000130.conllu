# file = txt/2000130.txt
# filelineno = 948
# sentno = 1
# text = 2	למרות התייחסות הגבוהה יותר של הנשים למשאבים טבעיים כגון צמחי בר וחופי הים והחשיבות שהן נותנות בשמירה על אזור ההר, הן עדיין חושבות כי המדע והטכנולוגיה יוכלו לכפר על עוולות הפיתוח כיום, בכך זה מעמיד אותן מול הגברים החושבים כי לא ניתן לסמוך על אמצעים אלו בלבד.
