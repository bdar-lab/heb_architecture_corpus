# file = txt/2000130.txt
# filelineno = 908
# sentno = 1
# text = ממצא נוסף היכול להצביע על כך שהתושבים מעריכים את השטחים הפתוחים הירוקים הכוללים את שמורות הטבע הגנים הלאומיים והיערות הנטועים הוא שרוב המשיבים מעונינים כי הפיתוח יעשה באזור החוף - כאשר נראה כי הכוונה היא ליחידת הנוף של (המרזבה) (דבר זה אינו עולה במפורש, אם כי ניתן אולי להסיק זאת מכך שבנוסף סימנו התושבים כי המקום המועדף לשימור הוא החוף ולא אזור ההר -יחד עם זאת ראוי לבדוק שאלה זו במפורש יותר במחקר נוסף).
