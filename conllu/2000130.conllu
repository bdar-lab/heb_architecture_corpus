# file = txt/2000130.txt
# filelineno = 31
# sentno = 1
# text = מחקר זה מתבצע על רקע צמצום השטחים הפתוחים בישראל, אומנם אין צמצום בשמורות טבע וגנים לאומיים, אך חלק מהפיתוח חודר ליערות הנטועים (ולשטחים חקלאיים), דבר היכול להשפיע גם על המערכות האקולוגיות הסמוכות הנמצאות בשטחי השמורות והגנים.
