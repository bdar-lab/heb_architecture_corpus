# file = txt/2300174.txt
# filelineno = 778
# sentno = 2
# text = ניתן לשפר את תדמית התוכנית הממשלתית על ידי פעולות כגון: מתן משכורות כמקובל בסקטור הפרטי (אלטרנטיבית ניתן לגבות את העובדים הבכירים בפרוייקט במניות כפיצוי על המשכורות הנמוכות ולהגדיר זאת בתקנונים), דבר שיאפשר העסקה של אנשי מקצוע טובים יותר, על ידי הכנסת שינויים בתהליך הסינון והפיכתו לנוקשה וקפדני יותר (בייחוד בחממות הפריפריאליות), צמצום והגמשת המעגלים הביורוקרטים, ועל ידי הכנסה מובנית של נורמות וגישות עסקיות ושל מובילים עסקיים לחממות ולפרוייקטים כאחד.
