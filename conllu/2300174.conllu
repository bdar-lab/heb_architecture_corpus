# file = txt/2300174.txt
# filelineno = 254
# sentno = 1
# text = מסקנותיו של Roper הן, שלמרות שבתוכנית החממות הישראלית יש פוטנציאל לטווח ארוך כמקור לצמיחה וכמקור ליצירת מקורות תעסוקה, ולמרות שעדיין לא קיימים כלי הערכה מספקים ומספיק ידע וניסיון לשפוט את הישגי התוכנית כמכלול, עד היום התוכנית הובילה בעיקר להצלחות אינדיבידואליות.
