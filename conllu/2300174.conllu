# text = יש לציין, כי אחד ההבדלים המשמעותיים הקיימים בין החממות העסקיות והטכנולוגיות בארה״ב לחממות הטכנולוגיות בישראל הוא, שהחממות בארה״ב אינן עוסקות רק בהי־טק, ואינן מתמקדות אך ורק ברעיונות חדשים, כפי שעושות החממות בישראל.
# raw = {'id': 5, 'text': 'יש לציין, כי אחד ההבדלים המשמעותיים הקיימים בין החממות העסקיות והטכנולוגיות בארה״ב לחממות הטכנולוגיות בישראל הוא, שהחממות בארה״ב אינן עוסקות רק בהי־טק, ואינן מתמקדות אך ורק ברעיונות חדשים, כפי שעושות החממות בישראל.', 'dspan': (487, 701), 'tokens': [{'id': 1, 'text': 'יש', 'upos': 'ADV', 'xpos': 'ADV', 'head': 0, 'deprel': 'root', 'dspan': (487, 489), 'span': (0, 2), 'lemma': 'יש'}, {'id': 2, 'text': 'לציין', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PIEL|VerbForm=Inf|Voice=Act', 'head': 1, 'deprel': 'xcomp', 'dspan': (490, 495), 'span': (3, 8), 'lemma': 'ציין'}, {'id': 3, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (495, 496), 'span': (8, 9), 'lemma': ','}, {'id': 4, 'text': 'כי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 35, 'deprel': 'mark', 'dspan': (497, 499), 'span': (10, 12), 'lemma': 'כי'}, {'id': 5, 'text': 'אחד', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'nummod', 'dspan': (500, 503), 'span': (13, 16), 'lemma': 'אחת'}, {'id': (6, 7), 'text': 'ההבדלים', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'הבדלים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 28, 'deprel': 'nsubj:cop', 'lemma': 'הבדל'}], 'span': (17, 24), 'dspan': (504, 511)}, {'id': (8, 9), 'text': 'המשמעותיים', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'משמעותיים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 7, 'deprel': 'amod', 'lemma': 'משמעותי'}], 'span': (25, 35), 'dspan': (512, 522)}, {'id': (10, 11), 'text': 'הקיימים', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 11, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 11, 'text': 'קיימים', 'upos': 'VERB', 'xpos'