# file = txt/2300098.txt
# filelineno = 165
# sentno = 4
# text = שימו לב: רק באופן מיקרי דומה מיספר זה לנורמה שקבעה המועצה הארצית בישראל, שכן כאן אין מדובר, למעשה, בממוצע בין צפיפות נמוכה לגבוהה, אלא בסוג בינוי אחד עיקרי: הבינוי המומלץ על ידי רוב התוכניות הוא של בנייה טורית צמודת קרקע.
