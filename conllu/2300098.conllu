# file = txt/2300098.txt
# filelineno = 203
# sentno = 1
# text = מקור אפשרי אחר להגדרה הוא סעיף 158א(ג) לחוק התיכנון והבנייה, התשכ״ה־1965, אשר הוסף בו בתיקון התשמ״א (1991), ואשר קובע, כי: "שר הפנים יקבע בתקנות, בהתייעצות עם המועצה הארצית ובאישור ועדת הפנים ואיכות הסביבה של הכנסת, מהו בניין גבוה ובניין רב־ קומות לעניין סעיף זה".
