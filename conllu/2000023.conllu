# file = txt/2000023.txt
# filelineno = 316
# sentno = 1
# text = המבנה החברתי של הקיבוץ, וההכרעות לגבי סדר העדיפויות ברוח האידאות המיוחדות לו, בגלל התיחום הברור שלו (מעטפה אחת קומפקטית יחסית), מרבו אחד, בניה אחידה ועוד מספר מאפיינים פיסיים - ניתן לראות את הקיבוץ הבודד כמעין "בית גדול", שבו אזור המרכז וחדר האוכל תואמים את לב הדירה, בנייני - המגורים את חדרי השינה, אזור הילדים והנוער - חדרי ילדים, הנוי - הגינה הפרטית, אזור הספורט - בריכת השחיר.
