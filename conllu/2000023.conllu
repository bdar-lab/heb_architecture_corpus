# file = txt/2000023.txt
# filelineno = 379
# sentno = 1
# text = דרכו של חבה״ק בחינוך כפועל יוצא מהשקפת עולמו הפלורליסטית היתה שאין להפריד את ילדי הקבוצות, אלא ליצור בתי חינוך לילדי פועלים מכל צורות הישוב (במציאות הארץ ישראלית היו בתי ספר אלו משותפים לקבוצות, קיבוצים, מושבות ומושבים).
