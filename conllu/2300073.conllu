# file = txt/2300073.txt
# filelineno = 510
# sentno = 2
# text = חכיון שמקור הנתונים העיקרי הוא חפקר׳ הלישכה המרכזית לסטטיסטיקה (נתוני תפקד 1983, כולל פירוט נתוני חאוכלוסיח שנכנסה בחחש השנים שלפני ההפקר, וכן השוואה עם נתוני מפקר 1972) קבלנו על עצחנו את החלוקה לשכונות (־אזורים סטטיסטיים) שנקבעה בלישכה.
