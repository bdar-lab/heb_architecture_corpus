# file = txt/2300064.txt
# filelineno = 3
# sentno = 1
# text = פעילויות נוספות שהתקיימו בתחום זה היו יום עיון בנושא שימור גנים היסטוריים שנערך בחודש מרס 1993 מטעם המועצה לשימור מבנים ואתרי התיישבות, שלושה ימי עיון נוספים באותו נושא בחודש ינואר 1994; המרצה הראשי באלה האחרונים היה פרופסור אדוארד בנים, ראש המחלקה לאדריכלות נוף באוניברסיטת מנצ׳ססר ומומחה בשימור גנים, ויום עיון בחודש אפריל 1998 בנושא :״ שימור גנים היסטוריים" לזכרו של השופט לני רבינוביץ׳, בשיתוף המועצה לשימור מבנים ואתרי התיישבות , הפקולטה לארכיטקטורה - מסלול אדריכלות נוף, המרכז לחקר עיר ואזור, המרכז לחקר מורשת הארכיטקטורה בישראל מהטכניון והחברה להגנת הטבע.
