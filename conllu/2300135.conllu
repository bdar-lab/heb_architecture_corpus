# file = txt/2300135.txt
# filelineno = 284
# sentno = 1
# text = לאור שאלת המחקר שהצבנו מן הראוי לחזור ולהדגיש כי לא מצאנו קשרים משמעותיים בין מאפייני הבינוי שמדדנו (גובה מבניp מספר מבנים, מספר דירות בבנין, קומת מגורים וצפיפות הדירה ) לבין דפוסי השימוש בשט״פ־מכאן שממצאים אלה מצביעים על כך שהמאפיינים הפיזיים האלה של סביבת המגורים (זולת צפיפות הדיור ובתוך הדירה) הם בעלי חשיבות נמוכה בין המשתנים המשפיעים על הביקור, מימצאים אלה,אם יאומתו ע״י מחקר נוסף, יטילו ספק על המוסכמות הרווחות בקרב מתכננים פיזיים הנוטות ליחס לגובה הבנייה ומאסיביות הבינרי השפעה על הצורך בשט״פ־ לעומת זאת קיומו של שטח פרטי או פרטי למחצה הוא אומנם בעל חשיבות אולם יש להבחין בין סוגי הפעילות עבורן הוא משמש כתחליף לשטח ציבורי־ למשל בשכונה המאופיינת ע״י גינות פרטיות, שטחים ציבוריים קטנים המיועדים לפעוטות ומלוויהם הם כנראה פחות נחוצות בעוד שט״פ עם הצע של מגוון פעילויות הכולל ספורט וצפיה בעוברים ושבים, יהיה נחוץ.
