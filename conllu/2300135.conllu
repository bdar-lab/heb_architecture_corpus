# file = txt/2300135.txt
# filelineno = 149
# sentno = 7
# text = מגמות אלו ניתן אולי להסביר על פי היצע המתקנים הקיים בגנים השונים ותכונות האוכלוסיה־את הפעילות האקטיבית ניתן במידה רבה לקשור לקיומם של מתקני משחק לילדים בכל הגנים, פחות או יותר במידה שווה, פרט לגן דניאל ולגן קרית אליעזר: בראשון ישנם מתקני ספורט (בנוסף לדשא ועצים) ואילו באחרון מתקני המשחק לילדים מצומצמים מחד והאוכלוסיה יותר מבוגרת מאידך.
