# sentno = 1
# text = ו- 5-8 קומות) נוטים לבוא לבד לעומת הגרים בבניינים גבוהים הנוטים לבוא בלויית אחרים, לרוב ילדים או הורים / מטפלות, לפי המקרה־ שיעורם של אלה הגרים בבניינים גבוהים והבאים בליווי הוא פי שישה משל אלו הבאים לבד, ואילו שיעורם של הגרים בבניינים נמוכים והבאים לבד גדול פי שניים מאלו הבאים עם ליווי־ כמובן, בנוסף לגורם גובה הבניין יתכן ואנו רואים השפעת גורמים נוספים כגון הרכב גילאים שונה בין סוגי הגבהים־
