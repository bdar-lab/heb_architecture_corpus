# file = txt/2300135.txt
# filelineno = 286
# sentno = 3
# text = ממצא זה למעשה עשוי לעזורבבחירה בין תכנון מערכת שט״פ המורכבת ממספר יחידות מצומצם של שט״פ גדולים לבין זו המורכבת ממספר גדול של גנים קטנים־ בו בזמן שגנים גדולים יציעו מגוון רחב של פעילויות ויהוו מקום משיכה לכלל האוכלוסיה הרי האפשרות השניה תתאים לצרכי אוכלוסיה בעלת דרישות מוגדרות יותר־ הרצון ליצור מגוון (אשר פרושו יצירת שטחים פתוחים גדולים יותר) עשוי להתנגש עם הרצון להציע נגישות טובה ומרחק הליכה קצר (דבר המחייב פיזור של מספר גנים ולא ריכוזם).
