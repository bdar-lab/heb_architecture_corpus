# file = txt/2300135.txt
# filelineno = 60
# sentno = 1
# text = השערה זו מבוססת על ההנחה שהמשתמש הפוקוציאלי 1^ף מקום תחליפי פחות מתאים אולם יותר קרוב לפעילות מאשר להשקיע זמן בהליכה־ על פי הנחה זו תהיה נטיה לפקוד את הגן על אף המרחק ולעתים קרובות יותר למטרת פעילויות אקטיביות הקשורות במתקנים מסוימים־ כמו־כן, ככל שגדל המרחק הנחתנו היא שיגדל הצורך בפיקוח על פעוטות ולכן ידרש להם ליווי להגיע לגן־ גורם זה חשוב במיוחד כאשר ה״מרחק" בין קומת המגורים והיציאה מן הבנין מכתיב תלות במעליות או במדרגות רבות.
