# file = txt/1300036.txt
# filelineno = 106
# sentno = 1
# text = במהלך הדיונים שקיימנו עם מגוון רחב של אנשי מקצוע ניתן היה לזהות ארבע נקודות חולשה מרכזיות של תפקיד המתכנן/יועץ החברתי היום: אי בהירות של הגדרת התפקיד ותוצרי העבודה של המתכנן/היועץ החברתי; אי-הסכמה על הכישורים הנדרשים לביצוע התפקיד; היעדר ׳ארגז כלים׳ היכול לחבר בין שפת התכנון הפיזי והשפה של המתכננים החברתיים; והיעדר משאבים בהיקף הולם.
