# file = txt/1300036.txt
# filelineno = 186
# sentno = 1
# text = להלן אנו מביאות דוגמאות של כמה מן הכלים, ולבסוף טבלה המשווה בין תשעה כלים שונים על פי שלושה תבחינים: האם הכלי בודק תהליכים או השפעות, האם הוא מתרגם את התוצאות למונחים כספיים, והאם הוא מבוצע על ידי גוף למטרות רווח או גוף ללא מטרות רווח (2007 ,Dixon).
