# file = txt/1300036.txt
# filelineno = 429
# sentno = 1
# text = ״(12) נציג של הגופים הציבוריים שענינם בשמירת איכות הסביבה, שימנה שר הפנים בהתייעצות עם השר לאיכות הסביבה, מתוך רשימת מועמדים שיגישו לו גופים אלה; לענין זה, "הגופים הציבוריים שענינם בשמירת איכות הסביבה״ - הגופים המפורטים בתוספת לחוק ייצוג גופים ציבוריים שענינם בשמירת איכות הסביבה (תיקוני חקיקה), התשס״ג-2002.
