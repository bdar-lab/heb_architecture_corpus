# file = txt/1200005.txt
# filelineno = 139
# sentno = 2
# text = היות שמחקרים הראו שהתרומה היחסית של הגשר התרמי לאובדן האנרגיה גדלה ככל שרמת הבידוד התרמי גדולה יותר, החליטה וועדת התקינה לכלול בתקן רק ערכים עבור רמת בידוד גבוהה יחסית, של 10 ס"מ פוליסטירן מוקצף, והמבוטאת ע"י התנגדות תרמית של 2.5 m2K/W.
