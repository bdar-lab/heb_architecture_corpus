# file = txt/1200005.txt
# filelineno = 108
# sentno = 4
# text = המסקנה העיקרית שלהם היא שחישוב ליניארי של הגשרים התרמיים מטעה יתר על המידה, ולכן חייבים לחשבם בצורה מדויקת יותר באמצעות תוכנה מתאימה (לפחות דו-ממדית), וההמלצה העיקרית שלהם היא להמשיך ולפתח את מאגר הנתונים עבור ערכי ψ למצבים שונים של גשרים תרמיים ופתרונותיהם הקיימים בבניינים בטכנולוגיות בנייה שונות.
