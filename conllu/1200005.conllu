# file = txt/1200005.txt
# filelineno = 217
# sentno = 1
# text = על פי ניתוח הנתונים הנ"ל נקבע שהסימולציות של הגשרים התרמיים יבוצעו בתנאים הנקובים בטבלה 4.1, כאשר טמפרטורת אוויר הפנים היא 20°C, וההתנגדות התרמית הפנית היא כמקובל בתקן הישראלי (כלומר: 0.13, 0.1, ו- 0.17 מ"ר קלווין לוואט עבור קירות, תקרות בזרימת חום כלפי מעלה, ורצפות בזרימת חום כלפי מטה, בהתאמה).
