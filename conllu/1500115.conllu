# file = txt/1500115.txt
# filelineno = 447
# sentno = 3
# text = בניגוד לדעתו אני לא רואה באמנות האדמה האמריקאית חזרה רומנטית לטבע, אלא תגובה לתכנים אמנותיים ופוליטיים, ואילו את עבודתם בטבע של שלושת האמנים הישראלים אני מפרשת בראש ובראשונה כתגובה רומנטית לטבע, לעתים מתוך רצון ליצור קשר אל הארץ.
