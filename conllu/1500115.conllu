# file = txt/1500115.txt
# filelineno = 434
# sentno = 1
# text = השפעת אמנות האדמה העולמית מהותית להתפתחות התופעה בארץ, אם כי נראו ניצנים להופעתה בארץ לפני ״ירית הפתיחה״ של אמנות האדמה בעולם (התערוכה Earthworks באוקטובר 1968) ; תפיסת הפיסול כסביבה ביצירתו המוקדמת של דנציגר, בחינת הקשר בין העבודה לאתר בו היא נמצאת, הנטייה למקם את היצירה בטבע, להתייחס לזמן המעגלי שבו ולתופעות כגון אור וצל, היחס המורכב לזמן ולחלל, אפיינו את עבודות עיצוב הנוף שלו מתחילת שנות השישים ונראים כבר בהצעה לתכנון קבר הרצל משנת 1951.
