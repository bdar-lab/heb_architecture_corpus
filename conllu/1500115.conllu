# file = txt/1500115.txt
# filelineno = 439
# sentno = 1
# text = עבור האמנים המושג "מקום" והעיסוק בו שימש לחיזוק הקשר אל הארץ, אך בשנים מאוחרות יותר זכה לביקורת על הפיכתו לחלק מהאתוס הציוני הצברי-אשכנזי בטענה שאימוצו של אתוס זה על ידי הקאנון האמנותי, מבטל את המקומי האחר: המזרחי, הערבית והדתי (בריטברג סמל 1986 ; חינסקי 1993 ; בר-אור 1998 ; מנור 2005).
