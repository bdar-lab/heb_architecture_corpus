# text = אותה ׳אדמה-של-מעלה׳, שהצייר העברי נשא עימו כמורשת דורות סנטימנטאליים מתגעגעים, מתחילה לרדת מטה, מטה - וממילא כל הגרעינים והזרעונים של דמויות ואידיאות, שהיו מרחפים עד כה בחלל ריק מפני שטרם נולדה בשבילם ה׳אדמה׳ של האמן היהודי, יורדים עתה ונקלטים בנשמתו, שמפני הוא-עצמו, התלוש, הפך ונעשה אדמה, מתוך מגע-בראשית באדמת עמו הממשית״ (ארדון אצל עומר, 24,1998).
# raw = {'id': 3, 'text': 'אותה ׳אדמה-של-מעלה׳, שהצייר העברי נשא עימו כמורשת דורות סנטימנטאליים מתגעגעים, מתחילה לרדת מטה, מטה - וממילא כל הגרעינים והזרעונים של דמויות ואידיאות, שהיו מרחפים עד כה בחלל ריק מפני שטרם נולדה בשבילם ה׳אדמה׳ של האמן היהודי, יורדים עתה ונקלטים בנשמתו, שמפני הוא-עצמו, התלוש, הפך ונעשה אדמה, מתוך מגע-בראשית באדמת עמו הממשית״ (ארדון אצל עומר, 24,1998).', 'dspan': (294, 645), 'tokens': [{'id': 1, 'text': 'אותה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Definite=Def|Gender=Fem|Number=Sing|Person=3|PronType=Prs', 'head': 3, 'deprel': 'det', 'dspan': (294, 298), 'span': (0, 4), 'lemma': 'אותו'}, {'id': 2, 'text': '׳', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (299, 300), 'span': (5, 6), 'lemma': '׳'}, {'id': (3, 4), 'text': 'אדמה', 'expanded': [{'id': 3, 'text': 'אדמ', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 24, 'deprel': 'nsubj', 'lemma': 'אדמ'}, {'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'dep', 'lemma': 'ה'}], 'span': (6, 10), 'dspan': (300, 304)}, {'id': 5, 'text': '-', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 8, 'deprel': 'punct', 'dspan': (304, 305), 'span': (10, 11), 'lemma': '-'}, {'id': 6, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 8, 'deprel': 'case:gen', 'dspan': (305, 307), 'span': (11, 13), 'lemma': 'של'}, {'id': 7, 'text': '-', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 8, 'deprel': 'punct', 'dspan': (307, 308), 'span': (13, 14), 'lemma': '-'}, {'id': 8, 'text': 'מעלה', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'nmod:poss', 'dspan': (308, 312), 'span': (14, 18), 'lemma': 'מעלה'}, {'id': 9, 'text': '׳', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (312, 313), 'span': (18, 19), 'lemma': '׳'}, {'id': 10, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (313, 314), 'span': (19, 20), 'lemma': ','}, {'id': (11, 1