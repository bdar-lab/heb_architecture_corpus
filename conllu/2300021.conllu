# file = txt/2300021.txt
# filelineno = 136
# sentno = 2
# text = יש לשים לב כי הועדה לאיחוד רשויות לא פנתה לעיריית רמת-גן וכאשר נדרשה לאפיין את היישובים בבקעת אונו לא כללה את שטחה המזרחי של רמת-גן כחלק מהאזור, כך שאחרי החלטת הועדה לאיחוד הרשויות בדבר האיחוד, עדיין נותר הצורך לאפיינו ולבחון את התועלות שבצירוף המתחם המזרחי של רמת-גן לעיר החדשה, באופן שיצדיק את העלויות הכרוכות בהפרדתו מהעירייה אליה הוא משתייך עכשיו (פירוט נתונים לגבי רמת-גן ולגבי המתחם הנדון בפרט, הוצגו בסעיף 2.1 לעיל).
