# file = txt/2300021.txt
# filelineno = 257
# sentno = 3
# text = כשמדובר ברשויות מקומיות קטנות מאד, ובהעדר מסגרות אפקטיביות לשיתוף פעולה אזורי, העלות הציבורית לתושב גבוהה במיוחד, ולכן גוברת ההצדקה להתנגד להקמתן של רשויות קטנות מאד, וכן לחתור לאיחוד בין רשויות מסוג זה (רזין 1999).
