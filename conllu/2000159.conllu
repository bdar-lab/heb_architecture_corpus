# file = txt/2000159.txt
# filelineno = 593
# sentno = 2
# text = תכונות המשטח הטופולוגי משמשות אותו בכך: צורה המבוססת על חישוב נוסחה מתמטית בה ניתן להציב פרמטרים שונים ולקבל תוצאה שונה מבחינה צורנית, אלמנט חללי אשר ניתן לעבוד איתו באופן אינטראקטיבי, ברצף של שינויים ותגובות, ובמודל אשר מתקיימת בו תנועה המשמש לתכנון ארכיטקטורה אשר תעמוד לאחר בנייתה ללא תנועה.
