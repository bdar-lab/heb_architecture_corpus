# file = txt/2000159.txt
# filelineno = 13
# sentno = 10
# text = מתכננים של ארכיטקטורה דיגיטלית מתמודדים עם סוגיות רעיוניות של עידן המדיה, האינפורמציה המהירה, תיאוריות מורכבות מדעיות עכשוויות, וטכנולוגיות דיגיטליות משוכללות, ומטרתם להביא את כל אלו לידי ביט1י בתוצר האדריכל׳, הם מפתחים מונחים המתארים פרוצדורות עבודה חדשות, כמו בועות (Blobs), קיפולים (Folds), דיאגרמות, Hypersurfaces, היבריד (Hybrid) ויוצרים ארכיטקטורה בעלת מראה "אחר": נוזלית ומעוגלת, מורכבת ואניגמטית, מראה המבטא את הערכים החדשים שבבסיסה ואת הדרך השונה בה היא תוכננה.
