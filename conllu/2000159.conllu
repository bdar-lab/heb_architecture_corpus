# file = txt/2000159.txt
# filelineno = 8
# sentno = 4
# text = התכן הטופולוג׳ כולל ארבע גישות תכנון מרכזיות: תכנון בעזרת משטח טופולוגי (שילוב נושא המשטח בארכיטקטורה בנושאים של גיאומטריה טופולוגית), תכנון בעזרת גופים טופולוג״ם, הנקראים "ב1עות" (Blobs) אשר חוק׳ המניפולציות הצורניות אשר ניתן לבצע עליהן נחקרו ע"׳ מתכננים דיגיטליים, חקירת סוגייה הפילוסופית והצורנית כאחד של הקיפול (The Fold), ויצירת צורה בדרך פיסולית בעזרת הצורה החופשית.
