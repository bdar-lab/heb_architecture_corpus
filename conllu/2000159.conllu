# file = txt/2000159.txt
# filelineno = 735
# sentno = 2
# text = רוב המתכננים הדיגיטליים מחזיקים בדעה כ׳ אלמנט כלשהו של התנועה משתמר בצורה הבנויה או מבוטא על-ידה, כפי שיפורט בהמשך, אך המתנגדים טוענים שהצורה הבנויה הוצאה מתהליך האנימציה אשר נקטע, והיא סטטית, ומסכמים כ׳ הטכניקה של עיצוב בתהליך של תנועה נבגדת ע"י הקביעות של התוצר הסופי שלה (2001 Di Cristina).
