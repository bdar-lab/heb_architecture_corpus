# file = txt/2000159.txt
# filelineno = 752
# sentno = 1
# text = הקשר מתכנן־מחשב הינו שהמתכנן שולט בכל מרכיבי המודל ותהליך האנימציה: הוא מגדיר את הגופים בחלל, הוא מגדיר את הכוחות אשר יפעלו עליהם, ומה תהיה יכולת הג1פים להגיב לכוחות חללו, כל זאת בהתאם לכיוון היצירתי בו הוא בחר לפיתרון הפח״קט.
