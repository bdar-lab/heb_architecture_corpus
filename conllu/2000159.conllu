# file = txt/2000159.txt
# filelineno = 418
# sentno = 6
# text = Greg Lynn מוכיח נ׳ גיאומטריה מתמטית איננה מעדיפה גופים אידיאליים ומדבר בזכות השימוש בגיאומטריה המתארת מערכות צורניות גמישות, אמורפיות (1992 Lynn), מפתח את נושא הסימטריה האידילית לסימטריה מורכבת, יצירתית, ומביא דוגמאות של מוטציות מן הטבע, כאשר הגנים מתוארים כהוראות התפתחות, והמוטציות מתרחשות כאשר מידע חיצוני מתערבב בפרמטרים הקבועים של התפתחות האלמנט הביולוג׳ (Lynn1995A), וממשיך בחקר הצורניות שמקורה בטבע בתפיסה של Composition Through Differentiation, ובתגובות של מערכות ביולוגיות מתפתחות להשפעות חיצוניות דרך שינוי צורה בזמן הגדילה, והמקבילה הגיאומטרית לכך -הגיאומטריה הטופולוגית (Lynn 1995C).
# raw = {'id': 6, 'text': 'Greg Lynn מוכיח נ׳ גיאומטריה מתמטית איננה מעדיפה גופים אידיאליים ומדבר בזכות השימוש בגיאומטריה המתארת מערכות צורניות גמישות, אמורפיות (1992 Lynn), מפתח את נושא הסימטריה האידילית לסימטריה מורכבת, יצירתית, ומביא דוגמאות של מוטציות מן הטבע, כאשר הגנים מתוארים כהוראות התפתחות, והמוטציות מתרחשות כאשר מידע חיצוני מתערבב בפרמטרים הקבועים של התפתחות האלמנט הביולוג׳ (Lynn1995A), וממשיך בחקר הצורניות שמקורה בטבע בתפיסה של Composition Through Differentiation, ובתגובות של מערכות ביולוגיות מתפתחות להשפעות חיצוניות דרך שינוי צורה בזמן הגדילה, והמקבילה הגיאומטרית לכך -הגיאומטריה הטופולוגית (Lynn 1995C).', 'dspan': (806, 1401), 'tokens': [{'id': 1, 'text': 'Greg', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'nsubj', 'dspan': (806, 810), 'span': (0, 4), 'lemma': 'Greg'}, {'id': 2, 'text': 'Lynn', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'flat', 'dspan': (811, 815), 'span': (5, 9), 'lemma': 'Lynn'}, {'id': 3, 'text': 'מוכיח', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HIFIL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (816, 821), 'span': (10, 15), 'lemma': 'הוכיח'}, {'id': 4, 'text': 'נ׳', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 8, 'deprel': 'mark', 'dspan': (822, 824), 'span': (16, 18), 'lemma': 'נ׳'}, {'id': 5, 'text': 'גיאומטריה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'nsubj', 'dspan': (825, 834), 'span': (19, 28), 'lemma': 'גיאומטריה'}, {'id': 6, 'text': 'מתמטית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 104, 'deprel': 'amod', 'dspan': (835, 841), 'span': (29, 35), 'lemma': 'מתמטית'}, {'id': 7, 'text': 'איננה', 'upos': 'AUX', 'xpos': 'AUX', 'feats': 'Gender=Fem|Number=Sing|Polarity=Neg|VerbForm=Part', 'head': 8, 'deprel': 'aux', 'dspan': (842, 847), 'span': (36, 41), 'lemma': 'אינו'}, {'id': 8, 'text': 'מעדיפה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=H