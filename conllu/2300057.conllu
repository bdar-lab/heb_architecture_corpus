# file = txt/2300057.txt
# filelineno = 737
# sentno = 1
# text = אחד מפסקי הדין, בו נושא זה זכה לטפול ישיר ונרחב הוא פס״ד 318/75 ("תמרה") שם נפסק, כי במקרה הנדון פעלה הועדה כדין, כאשר אשרה שינוי שלא נבע מהתנגדויות, אולם: "את הסמכות לשנות תכנית שלא על פי התנגדות, בשלב האישור הסופי, ועל אחת כמה וכמה את הסמכות לדחות תכנית בשלב מאוחר זה, אחרי שכבר ניתן האשור להפקדה, יש להפעיל בזהירות רבה כדי לא לגרום לאזרח עוול, אם׳שינה את מעמדו לרעה בסמכו על אשור ההפקדה".
