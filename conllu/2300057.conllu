# file = txt/2300057.txt
# filelineno = 455
# sentno = 2
# text = במיוחד, מחייב החוק הקנדי את רשות התכנון המקומית לקיים אסיפה צבורית לפרסום אינפורמציה, למען קבלת השתתפות ושתוף פעולה אזרחי באזור התכנון בקביעת פתרון הבעיות (סעיף 12, חוק התכנון, אונטריו 1971) לפי הנוהג הקיים שם, לפני שרשות התכנון המקומית מגישה את התכנית לאזור, היא חייבת להוכיח שהצעת התכנית הוצגה לעיון האזרחים וכן איך ובאיזו מידה היא קבלה את ההערות ומה תגובותיה עליהן.
