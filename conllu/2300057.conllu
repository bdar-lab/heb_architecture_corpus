# filelineno = 673
# sentno = 1
# text = בג"צ 73/76 ("שניידר") מעלה את הצורך בפעולה לפי שקול דעת בנושא הפרסום בנסיבות מיוחדות: "למרות שפרסום ברבים היא הדרך הקבועה בחוק הרי ברור היה לכל הנוגעים בדבר, שהתכנית הזאת תפגע בראש ובראשונה בדיירי הבית מם‘ 24 ואולי במספר בתים סמוכים...בין ע״י הודעה אישית או הדבקה על לוח המודעות בבית מם‘ 24'•'.
