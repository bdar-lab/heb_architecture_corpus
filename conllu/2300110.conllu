# file = txt/2300110.txt
# filelineno = 85
# sentno = 2
# text = אמנם במרוצת העשורים האחרונים חלה מהפיכה בהשכלת האוכלוסייה הערבית שהקפיצה את חציון שנות הלימוד מ-1.2 ל-9.0, אך עדיין כמחצית מן האוכלוסייה הלא-יהודית (שבינהם גדול במיוחד שיעור הנשים) שייך לקבוצה שמספר שנות הלימוד שלה מגיע רק לכ-8 שנים (לעומת 20Z באוכלוסייה היהודית).
