# file = txt/2500059.txt
# filelineno = 96
# sentno = 1
# text = הערכה מדויקת טל העלויות הנגרמות על ידי זמני דמימה של ציוד הבנייה היא תהליך ארוך יחסית הדורש מעקבים ממושכים באתרי הבנייה" מעקבים מסוג זה לא נערכו מעולם בארץ וגם בחו״ל ידוע לנו רק על נסיונות מוגבלים שנעשו בכיוון זה" כדי לענית על שאלה זי, נערכו, במסגרת מחקר זה, בדיקות מדגמיות של השפעת זמן הדמימה על עלויות הייצור" בדיקות אלו כללו מעקבים אחר תקינות התפעול של מספר מצומצם של כלים ולתקופה של חודשיים בלבר" בחירת הכלים נעשתה במטרה לכסות תחום רחב ככל האפשר של גילים בכל אחד מסוגי הציוד הנידונים" זמני הדמימה שארעי בתקופת המעקב תורגמי ליחידות כספיות על ידי הערכה של העלות הנוספת שנבעה מזמני בטלה של הפועלים שעבודתם מותנית בפעולת הציוד ושל העלות הכרוכה בהבאת ציוד חלופי לאתר והפעלתו במשך זמן הדמימה"
