# file = txt/2500059.txt
# filelineno = 92
# sentno = 1
# text = מבין סוגי הציוד הנכללים במחקר זה, עגורני הצריח הם שגורמים לתוספות העלות הגבוהות ביותר בעקבות ומני הדמימה שלהם, דבר זה נובע מהיות העגורן ציוד מרכזי שחלק גדול מהעבודות, ובעיקר אלה של השלד, תלוי בפעילותו התקינה, ומהקושי להביא לאתר ציוד חלופי תוך זמן קצר, תוספת העלות תהיה גדולה יותר במקרה של בנייה מתועשת או טרומית שבה לא ניתן לבצע כמעט כל עבודה בשלב השלד ללא עזרת עגורן, מאשר בבנייה הקונבנציונלית שבה ביתן להתגבר על תקלות מסוג זה על ידי הבאת מעלית לאתר או על ידי שימוש במשאבת בטון ועבודת ידיים.
