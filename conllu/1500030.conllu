# file = txt/1500030.txt
# filelineno = 111
# sentno = 9
# text = עם זאת, יש להדגיש, כי גם עסקים שציינו את המדרחוב כסיבה עיקרית או כאחת הסיבות לעזיבתם את הדר או רצונם לעזוב, לא ייחסו זאת אך ורק לבעיות התחבורה שיצר המדרחוב (מחסור בחניה קרובה לעסק, בעיות גישה לעסק ברכב ועוד), אלא גם להשתנות אופי האוכלוסייה ואופי העסקים באזור המדרחוב, להזנחתו ע״י העירייה ולנזק התדמיתי ששני אלה יצרו (אברהם, 2000).
