# file = txt/2800044.txt
# filelineno = 57
# sentno = 1
# text = אולם, בפרוצה הזמן, כאשר פקודות האשראי האפותיקאי הלכו ונידלדלו ומצד שני עלו מחירי הבנינים פי כפה, ירד פשקלה של הפשכנתא כאחוז פפחירי הבניינים־ בשנים שלאחר פלחפת העולם השניה נהג הבנק האפותיקאי להלוות סכום השווה לכלל הוצאות הבניה במחירים שלפני המלחמה, בתוספת ^60 פפחיד הפגרש שלפני המלחמה־ כיוון שפחירי הבניינים התייקרו ביותר פפי 4, הדי שלפעשה לא עלה פשקל הפשכנתא על 0^2 ממחיר הבנין־ הידידה בחלקו של הסיפון האפדתיקאי בכלל פחידי הבתים פשתקפת בנתונים הבאים, הפשווים לגבי הכתים שנפכרובפכירה חופשית בשוק, את יתרה ההלוואות האפותיקאיות המוטלת על בחי□ אלה בזמן המכירה למחיר הבתים לפי עדך השוק;
