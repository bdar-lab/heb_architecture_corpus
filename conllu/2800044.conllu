# file = txt/2800044.txt
# filelineno = 51
# sentno = 1
# text = לפני קדם המדינה, ובמיוחד בשנות השלושים, פעלו הבנקים האפותיקאיים בארץ,כאמור לפי השיטה המקובלת ברוב ארצות אירופה היבשתית, דהיינו, על-ידי הפצת אגרות-חוב־ בסים חשוב לפעילותם של מוסדות אלה היהה העובדה, שהשוק לניירות-ערך בארץ נמצא אז בהתרחבות פהידה, ובעוד שבסוף 1932 היה השווי הנקוב של ניירות-הערך הא״י (אגרות חוב ופניות כאחד) כדי 5־3 פיליון לא"י, הרי בסוף 1937 הגיע כבד שוויים ל-6־10 פיליון לא"י־אם נביא בחשבון, כי רפת הפחירים כפעם לא השתנתה באותה התקופה, הדי שלפנינו התרחבות פהירה שפפנה ניזון, בפידה רבה, הפיפון האפותיקאי־
