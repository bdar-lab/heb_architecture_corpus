# file = txt/2800044.txt
# filelineno = 252
# sentno = 1
# text = אנו מעריכים איפוא, שההוצאה לדיור אינה צריכה לעלות על 20% מההוצאה נטו של המשתכן־ יש להביא בחשבון גם עובדה נוספת; המשתכן במסגרת הבנייה הפרטית, או מפעל החיסכון לבנין, מממן באמצעים שמחוץ למימון אפותיקאי כ-65% ממחיר הדירה־ אם עתה נניח ריבית של 5%־6 על השקעה עצמית בבנין (כפי שמניחה הלשכה המרכזית לסטטיסטיקה), הרי על יסוד חישוב פשוט יתברר, שעל חשבון המימון העצמי כלבד נושא המשתכן במעמסה של 9% מהכנסתו השנתית־ וכיוון שכלל ההוצאה לדיור אינה צריכה לעלות כאמור על 20% מההכנסה, הרי שמכאן המסקנה הברורה, כי נטל התשלומים ע"ח המשכנתא אינו צריך לעלות על 11% מההכנסה־
