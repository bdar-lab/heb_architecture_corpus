# file = txt/2800044.txt
# filelineno = 176
# sentno = 1
# text = הנתונים שלעיל לגבי תנאי המימון האפותיקאי בארצות חוץ, התיחסו בעיקרם לבניה הפרסית" עתה נבדוק את התנאים המקבילים במסגרת השיכון הנתמך ע״י הפדינה, דהייגו פה שמכונה בתור "שיכון סוציאלי,"" אינפורפציה פענינת בנידון פובאת בפרסום על הנושא; "סיפון השיכון הסוציאלי ב-11 מדינות אירופיות וישראל" שהופיע פסעם הפדרציה הבינלאומית לשיכון ותכנון וכן בפרסומים של פינהל השיכון הפדרלי של אדה״ב, והתמונה המתקבלת היא;
