# file = txt/2800044.txt
# filelineno = 234
# sentno = 1
# text = אם ההלוואה בהיקף 000־10 ל״י ניתנת ל-25 שנים הרי התשלום השנתיעל חשבון הקרן(בהנחה של תשלומי קרן שווים בכל שנה) הוא 400 ל" י, ובצרוף ריבית של 8% יגיע םה״כ התשלומים ל-937 ל"י־ לעומת זאת, אם תקופת הפרעון היא 10 שנים בלבד, הדי התשלום השנתי עייח הקרן מגיע ל-1,000 ל״י, ובצרוף הדבית ל- 1,490 ל״י־ וזהו סכום המהווה עומס דב על הכנסה שנתית רגילה של משפחה עירונית שהגיעה, לסי סקר החסכון משנת 1964/65 ל-6,790 ל״י בשנה ניטו.
