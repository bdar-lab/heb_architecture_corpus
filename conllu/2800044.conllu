# file = txt/2800044.txt
# filelineno = 274
# sentno = 1
# text = פרם לשני הגורמים האלה שיש לראותם כגורמי המפתח יש לחשוב על שיפוד תנאי האשראי האפותיקאי בדרכים נוספות" ראשית, צעד חשוב יכולה להיות הארכת תקופת ה פ רעון של ההלוואות האפותיקאיות, בפרט בבנייה הפרטית ובהלוואות מכספי בנקים לבנייה הציבורית" בישראל, כאמור, תקופת הפרעון של המשכנתאות מכספי בנקים היא 8 עד 10 שנים, דבר המכביד במידה ניכרת על המשתכנים, היות והוא מחייב אותם בתשלומים שוטפים גבוהים ע״ח הקרן" הארכה של תקופת הפדעון (עד ל-15 שנה, לדוגמה) היא, איפוא, חיונית, ובקשר לכך יש לציין כי בארצות תבל תקופת הפרעון של המשכנתאות נעה בין 15 עד 20 שנה לכל הפחות"
