# sentno = 4
# text = שנית, כספי ה"העברה" של ערלי מרכז אירופה אשר זדמו באותם שנים לארץ־ישדאל, היוו מקוד חשוב לגייוס הון ע״י הנפקת אגדות חרב (חברות "ביצורי', "נירי’ ועוד), ואמצעים אלה הופנו בחלקם הניכר למימון אפוחיקאי־נוסף לכך יש לציין, כי המשקיע באותם הימים חשב יותר על ריבית קבועה ובטוחה מאשר על דיבי-דנדות גבוהות - עובדה שגם היא עודדה את הביקוש לאגדות חוב־ ולבסוף, יש להעיר כי הממשלה המנדטורית לא הנפיקה ניירדת-ערך בשוק הכספים המקומי וממילא פנו רוב אמצעיו של שוק ניידות-הערך לסקטור הפרסי, ובתוך זה למימון אפותיקאי.
