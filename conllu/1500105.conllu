# file = txt/1500105.txt
# filelineno = 361
# sentno = 3
# text = העיטוף של הרייכסטאג התרחש בשלב שבו התקיימו דיונים וויכוחים ציבוריים, בשלב שבו נדרשה הכרעה על ההיבטים העיצוב״ם והפרקט״ם בהסבת הבניין: שאלות שנעו בין המכובדות של הבניין ("The dignity of the house") לבין האספירציות האמנותיות, אותו הלך רוח של התחדשות, שעמדו לראשונה על סדר היום בדיונים של חברי הפרלמנט (שם,שם).
