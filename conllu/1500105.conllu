# file = txt/1500105.txt
# filelineno = 43
# sentno = 3
# text = הולסטון ואפדורא׳ טוענים כ׳ בעולם הקפיטליסטי-גלובל׳, העיר היא מוקד המבטא מכלול של יחסים ומאבקים חברתיים, אתר "חוד׳ לניתוח ומחשבה מחודשת על אזרחות, דמוקרטיה ושייכות לאומית (3 ,1999 Holston and Appadurai) לא כמו שימור, הסבת מבנים אינה כפופה לתקנות כוללות, ולכן יכולה לשמש כלי משפיע ביד׳ האזרחים.
