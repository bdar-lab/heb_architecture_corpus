# file = txt/1500040.txt
# filelineno = 389
# sentno = 2
# text = התכנית תוכננה על ידי סר פטריק גדס וכללה את המרחב שבין רח' בוגרשוב לרח' הירקון, בין אזור רח' אבן גבירול לים, והציגה תכנון לעיר גדולה כבת 100,000 תושבים, ואף למעלה מכך, בתקופה שאוכלוסיית העיר מנתה כשלושים עד ארבעים אלף נפש.
