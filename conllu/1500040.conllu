# file = txt/1500040.txt
# filelineno = 19
# sentno = 1
# text = במאמץ ההבניה וגיבושה של דמות העיר נוטלים חלק חשוב מתכנני העיר, כמו גם יוצרי הסרטים: הן הארכיטקטורה והן הקולנוע הם מדיומים שבכוחם הרטורי (של אדריכלים, של מעצבי מדיניות, של קולנוענים) והוויזואלי, כטקסט אדריכלי או קולנועי, להבנות מציאות (זאת בניגוד לייצוג בדיעבד של מציאות נתונה).
