# file = txt/1500040.txt
# filelineno = 345
# sentno = 3
# text = פניה השונות של העיר מתגבשות מאותן אבני יסוד -החול, הים, השמש - ומקיימות כל העת דיאלוג ביניהן: חולות הזהב, המרחב הבתולי החופשי שממנו נבנתה העיר ועל סמלה כתוב "אבנך ונבנית" (אמירה המתכתבת בין השאר עם "תרבות העשייה" החלוצית) למול רצועת החוף הצרה, שעליה מוקמים מבנים ארעיים, מקום מפלטם של שולי החברה הממוסדת, "הולכי הבטל"; הים התיכון שהיה מקור לאישוש המקומיות הישראלית וייצג את התממשות חזון התחייה של העם בארצו למול הים כנקודת קצה, ועם חדירת שיח הביקורת גם כסמל לאירופוצנטריות; והשמש הקורנת, "האור הישראלי" למול השמש הקופחת המשטיחה את המבט.
