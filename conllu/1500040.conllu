# file = txt/1500040.txt
# filelineno = 564
# sentno = 3
# text = מהלך זה החותר תחת ההגדרות הסוציולוגיות המזהות את גודל הקהילה כמדד לעירוניות (וירת, 2004), טומן בחובו מסר כפול: ראשית, מציג את העיר כמעין שכונה של קבוצה חברתית מסוימת בעלת מאפיינים פרופסיונאליים ואישיותיים, ושנית מנתק את תל אביב מן ההקשר הישראלי הרחב.
