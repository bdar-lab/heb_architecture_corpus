# file = txt/1500040.txt
# filelineno = 282
# sentno = 1
# text = המכנה המשותף לסרטי "הרגישות החדשה", היה עיסוק בנושאים קיומיים יומיומיים, התמקדות בנוף האורבני, האנושי אדריכלי, כשתל אביב היוותה, לראשונה בתולדות הקולנוע הישראלי, זירת עלילות שהפנו עורף לאידיאולוגיה הציונית; הפקה בתקציב נמוך, צילום בשחור לבן, הסרטה באתרים קיימים, הופעה של שחקנים לא מקצועיים, אסטרטגיות נרטיב לא שגרתיות עם סוף פתוח, דיאלוג מאולתר ושפה מדוברת, גישה אקספרימנטאלית למבע הקולנועי והתעלמות משיקולים פיננסיים (נאמן, 1998 ; שוויצר, 2003).
