# file = txt/1500040.txt
# filelineno = 305
# sentno = 1
# text = מכאן היה המתח שבמפגש בין האדם למקום במובנו הפיזי וכעולם של משמעויות: שפה, זיכרון ואמונה, לנושא מרכזי ביצירה הישראלית ובשדות השיח אודותיה (ברייטברג סמל 1986; לוין, 1993; חינסקי, 1993; שוחט, 2005; גינתון, 1998; סוקר שווגר, 2000; שדר, 2006; אפרת, 2004).
