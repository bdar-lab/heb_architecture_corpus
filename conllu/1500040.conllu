# file = txt/1500040.txt
# filelineno = 339
# sentno = 1
# text = עבודותיהם של "התל אביביים" אמנם לא עסקו בהכרח בתל אביב אך הבחירות האסתטיות המשותפות לקבוצת יוצרים החיה ופועלת בעיר: חומרים דלים, היצירה חפה מדקורטיביות, שימוש בחומר באופן שיוצר הפשטה (העבודות נותרו דו-ממדיות), הרישול המכוון, מעידות על תודעה משותפת, בחירה להתחבר ל'כאן' - לתל אביב החילונית, לאתוס החלוצי סוציאליסטי ולהיבט הא-אסתטי שביהדות.
