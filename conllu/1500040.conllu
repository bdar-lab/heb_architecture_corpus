# file = txt/1500040.txt
# filelineno = 370
# sentno = 1
# text = רבים מן הפרויקטים והיוזמות התרבותיות שחוללו את השינוי בתודעה העירונית החלו כמיזמים ממסדיים בשלהי תקופת כהונתו השנייה (בבחירה ישירה) של שלמה להט כראש עיר בין השנים 1984-1981, וביתר שאת בשנת 1983 בשלהי תקופת הבחירות.
