# file = txt/1800067.txt
# filelineno = 206
# sentno = 1
# text = 1.	גובה עלויות פיתוח : במכרזים עם משרד השיכון , המשרד מבצע את הפיתוח כשהעלויות של שלב זה מושתות על הקבלן הזוכה, החייב להעביר את עלות הפיתוח הכוללת למשרד השיכון 50 יום אחרי הזכייה במכרז .
