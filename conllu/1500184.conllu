# file = txt/1500184.txt
# filelineno = 132
# sentno = 4
# text = תכנית האב לשבילי אופניים של עיריית תל אביב-יפו עוסקת ביצירת רציפות של שבילי האופניים בעיר, חיבורם למוקדי העניין ולערים הסובבות, וקביעת סטנדרט לבניית שבילי האופניים - שביל דו סטרי ברוחב 3-5 מ׳ המובדל מסביבתו בצורה בולטת (אביגדור ושות׳ 2012).
