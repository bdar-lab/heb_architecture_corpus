# file = txt/1500184.txt
# filelineno = 148
# sentno = 5
# text = החוק מסדיר את שילוב האופניים בתחבורה הציבורית, יוצר תמריצים כלכליים למעסיקים, עובדים ומשווקים, מחייב רשויות מקומיות הגדולות מ-30,000 תושבים להכין תכנית מתאר לאופניים, מחייב הקמת שבילי אופניים בתכניות דרכים חדשות, מחייב התקנת חניית אופניים בבנייני משרדים, מסדיר את החינוך התעברותי לרכיבת אופניים, ומסדיר אלמנטים שונים הקשורים לתחבורת אופניים בחוקים שונים (הכנסת ה-20 2016).
