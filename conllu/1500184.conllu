# file = txt/1500184.txt
# filelineno = 231
# sentno = 1
# text = עמדות רוכבי האופניים החשמליים כלפי התחושה כי יש מספיק שבילי האופניים, תחושת הביטחון ברכיבה על אופניים חשמליים, וההערכה כי רכיבה על אופניים חשמליים מצמצת את שימושם במכונית, הוצגה לפי מגורי המשיבים ברובעי העיר תל אביב - יפו (איור 4.3).
