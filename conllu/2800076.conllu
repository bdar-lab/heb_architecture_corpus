# file = txt/2800076.txt
# filelineno = 327
# sentno = 1
# text = כאן המקום להזכיר, כי בנורמות שנקבעו למבני ציבור על־ידי משרד השיכון ומשרד הפנים בשנת 1961 הייתה התייחסות לקבוצות מגורים בנות 1,000 תושבים (300-250 יחידות דיור), ואילו לדעת כותבי שורות אלה יחידות בגודל 1,000 ואפילו 2,000 נפש אינן עצמאיות; עליהן להיות חלק מיחידה גדולה יותר.
