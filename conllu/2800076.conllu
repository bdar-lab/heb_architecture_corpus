# file = txt/2800076.txt
# filelineno = 122
# sentno = 1
# text = י סלייפר הזמין את המחנכים להיות שותפים בתכנון הרחבתם של מכני חינוך בציינו, שדווקא נושא אפור לכאורה דוגמת זה, שמהנדסי ערים ואדריכלים לא ראו בו אתגר ופטרו אותו ב״הדבקת" תוספות למבנים קיימים, עשוי "להוות מנוף למודרניזציה, לארגון מחדש של כל מערכת החללים בבנין ישן, ולהתאמתו לשיטות החינוך המתחדשות.
