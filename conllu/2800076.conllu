# file = txt/2800076.txt
# filelineno = 852
# sentno = 1
# text = בשנים 1972-76 תהווה בנייה זו השקעה של קרוב לתשעה מיליארד ל״י (לפי מחירי 1970: 450 ל״י למ״ר בנייה לא כולל מחיר הקרקע), ואילו במסמך מס׳ 1 נחזתה השקעה גלמית של 19.7 מיליארד ל״י במחירי 1970 לעשור.
