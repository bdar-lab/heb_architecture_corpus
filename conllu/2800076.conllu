# file = txt/2800076.txt
# filelineno = 689
# sentno = 3
# text = אך בעקיפין משפיע מחיר השוק רבות על הבנייה הציבורית במרכז הארץ בכלל ועל כל אחד ממרכיבי העלות שלה בפרט, שכן התוצאה המיידית של עליית הביקוש במידה ניכרת על ההיצע היא עליית מחירים תלולה במערכת הבנייה כולה: קרקעות, חומרי בניין, שכר עבור עבודה מקצועית ואפילו רווחיו של הקבלן.
