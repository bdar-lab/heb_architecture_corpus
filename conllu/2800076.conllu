# file = txt/2800076.txt
# filelineno = 25
# sentno = 1
# text = איך אפשר לתאר ולהסביר את חלקו ואת השפעתו של אדם, שהיה חלק מן התהליכים אותם עברה המדינה, ממצב שבו מספר ה״נקלטים" בתוך שלוש שנים בלבד היה זהה למספר ה״קולטים״ (650,000 יהודים באמצע 1948 קלטו כ־687,000 נפש עד סוף 1951), למצב שבו מספיקה תוספת של כ־2% ממלאי הדירות לענות על הצרכים (בשנים 1988-1985 הסתיימה בנייתן של 22,000 דירות בממוצע שנתי על מלאי של יותר ממיליון דירות).
