# file = txt/2800076.txt
# filelineno = 271
# sentno = 3
# text = קיימת גם דעת מיעוט, בעיקר באנגליה, השוללת את מושג האינטגרציה כולו והגורסת, ששכונות סלקטיביות נפרדות הן הפתרון הרצוי משום ששכונות כאלה מועדפות על־ידי המעמד הבינוני, ולכן הדירות נמכרות או מושכרות בהן במחיר גבוה יותר (שיקול מכריע במערכת שיקוליו של בונה פרטי בכלכלת שוק), וכן משום שאחידות בסגנון החיים מקלה על האחזקה.
