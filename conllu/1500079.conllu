# file = txt/1500079.txt
# filelineno = 321
# sentno = 1
# text = •	אחוז הדגימה ביישובים יהודים בשנת 2006 גדול יותר מאחוז הדגימה ביישובם ערביים -בעוד שביישובים ערביים (דאליית אל כרמל, כאבול, אעלבין, עספייה, שפרעם וטמרה), חל גידול של כ- 30% במספר התושבים בין אותם שנים, מספר משקי הבית שנדגמו ביישובים אלה גדל רק בכ- 15% (מ- 147 ל- 169).
