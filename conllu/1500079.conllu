# text = פילוג נסיעות ובחירת מקום מגורים של משק הבית – נושאים אלה באים לידי ביטוי, בצורה עקיפה, בשל העובדה שלבעלי זמינות רכב יש את האפשרות לבחור את יעד הנסיעה או את מקום המגורים גם למקומות אשר אליהם אין נגישות טובה לתחבורה ציבורית, הליכה או רכיבה על אופניים, כלומר, מרחב האפשרויות של בעלי זמינות הרכב גדול יותר למעשה (Wrigley, 1990).
# raw = {'id': 1, 'text': 'פילוג נסיעות ובחירת מקום מגורים של משק הבית – נושאים אלה באים לידי ביטוי, בצורה עקיפה, בשל העובדה שלבעלי זמינות רכב יש את האפשרות לבחור את יעד הנסיעה או את מקום המגורים גם למקומות אשר אליהם אין נגישות טובה לתחבורה ציבורית, הליכה או רכיבה על אופניים, כלומר, מרחב האפשרויות של בעלי זמינות הרכב גדול יותר למעשה (Wrigley, 1990).', 'dspan': (0, 324), 'tokens': [{'id': 1, 'text': 'פילוג', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'פילוג'}, {'id': 2, 'text': 'נסיעות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 1, 'deprel': 'compound', 'dspan': (6, 12), 'span': (6, 12), 'lemma': 'נסיעה'}, {'id': (3, 4), 'text': 'ובחירת', 'expanded': [{'id': 3, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 4, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 4, 'text': 'בחירת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'conj', 'lemma': 'בחירה'}], 'span': (13, 19), 'dspan': (13, 19)}, {'id': 5, 'text': 'מקום', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'compound', 'dspan': (20, 24), 'span': (20, 24), 'lemma': 'מקום'}, {'id': 6, 'text': 'מגורים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'compound', 'dspan': (25, 31), 'span': (25, 31), 'lemma': 'מגורים'}, {'id': 7, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 8, 'deprel': 'case', 'dspan': (32, 34), 'span': (32, 34), 'lemma': 'של'}, {'id': 8, 'text': 'משק', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'nmod:poss', 'dspan': (35, 38), 'span': (35, 38), 'lemma': 'משק'}, {'id': (9, 10), 'text': 'הבית', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 10, 'deprel': 'det', 'lemm