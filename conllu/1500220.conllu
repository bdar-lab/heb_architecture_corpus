# file = txt/1500220.txt
# filelineno = 218
# sentno = 1
# text = לצורך מידול תרחיש אסון בקמפוס הטכניון ושימוש בו במסגרת ניסוי לבחינה קבלת החלטות והתנהגות פינוי מרחבית של יחידים תחת שני תנאים שונים (עם / ללא מידע חיצוני שמקורו בטכנולוגיות מידע ותקשורת), תוכנן מערך מחקר (תרשים 10) שכלל סקר ספרות, בחירת מקרה בוחן (קמפוס הטכניון), מידול קמפוס הטכניון בסביבה וירטואלית דו מימדית, מידול גרף נקודות החלטה על גבי רשת הרחובות של הקמפוס, מידול מבוסס זמן ומרחב של אסון עירוני בקמפוס הטכניון, מידול ה״סביבה החכמה", ניסוי מעבדה השוואתי שלצורך ביצועו גויסו נבדקים ולבסוף ניתוח הנתונים והסקת מסקנות.
