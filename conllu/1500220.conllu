# text = בעקבות הריאיון, הוחלט לבחון, במסגרת ניסוי המעבדה, ׳פינוי כללי׳ של כלל האוכלוסייה שבשטח הקמפוס בשעות השיא, אשר משתמע מדברי המומחה שצפוי שיתבצע באופן רגלי בעקבות היכולת המוגבלת של רשת הדרכים לתמוך בפינוי באמצעות מספרם הרב של הרכבים הפרטיים המשרתים את אוכלוסיית הטכניון.
# raw = {'id': 1, 'text': 'בעקבות הריאיון, הוחלט לבחון, במסגרת ניסוי המעבדה, ׳פינוי כללי׳ של כלל האוכלוסייה שבשטח הקמפוס בשעות השיא, אשר משתמע מדברי המומחה שצפוי שיתבצע באופן רגלי בעקבות היכולת המוגבלת של רשת הדרכים לתמוך בפינוי באמצעות מספרם הרב של הרכבים הפרטיים המשרתים את אוכלוסיית הטכניון.', 'dspan': (0, 267), 'tokens': [{'id': 1, 'text': 'בעקבות', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'dspan': (0, 6), 'span': (0, 6), 'lemma': 'בעקבות'}, {'id': (2, 3), 'text': 'הריאיון', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'ריאיון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'obl', 'lemma': 'ריאיון'}], 'span': (7, 14), 'dspan': (7, 14)}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (14, 15), 'span': (14, 15), 'lemma': ','}, {'id': 5, 'text': 'הוחלט', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HUFAL|Number=Sing|Person=3|Tense=Past|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (16, 21), 'span': (16, 21), 'lemma': 'הוחלט'}, {'id': 6, 'text': 'לבחון', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PAAL|VerbForm=Inf|Voice=Act', 'head': 5, 'deprel': 'xcomp', 'dspan': (22, 27), 'span': (22, 27), 'lemma': 'בחן'}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (27, 28), 'span': (27, 28), 'lemma': ','}, {'id': (8, 9), 'text': 'במסגרת', 'expanded': [{'id': 8, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ב'}, {'id': 9, 'text': 'מסגרת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'fixed', 'lemma': 'מסגרת'}], 'span': (29, 35), 'dspan': (29, 35)}, {'id': 10, 'text': 'ניסוי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'obl', 'dspan': (36, 41), 'sp