# file = txt/2300106.txt
# filelineno = 581
# sentno = 1
# text = בשנת 1977/8 היתה הסובסידיה לנפש באזור בקעת הירדן גבוהה במיוחד: 1800 ש"ח לנפש - פי 7 בהשוואה לאזור הגליל בו נמצאה הסובסידיה לנפש השניה בגודלה, ופי 25 בהשוואה לאזור עפולה אשר קיבל את הסובסידיה לנפש הנמוכה ביותר בקבוצת האזורים המסובסדים המובהקים.
