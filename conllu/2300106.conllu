# file = txt/2300106.txt
# filelineno = 177
# sentno = 3
# text = עמדת הביקורת היא שהשוואת מחירי המים לעלותם הריאלית היא הדרך למנוע החמרה מסוכנת של המשבר ההידרולוגי ואף לאפשר שיקום מקורות המים, תוך השגת התאמה מרבית של הרכב הגידולים החקלאיים, היקפם ומיקומם למציאות התידרולוגית של משק המים ולאינטרס הכלכלי הלאומי.
