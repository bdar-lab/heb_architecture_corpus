# file = txt/1500056.txt
# filelineno = 422
# sentno = 10
# text = דיירת ותיקה סיפרה שביקשה לראות את החלוקה הפנימית של הדירה אך התוכנית ששלחו לה לא דומה לדירה היום.54 כאשר נחתם החוזה בין הדיירים הותיקים וחברת מצלאווי, חברת מצלאווי עצמה עדיין לא ידעה איזו תוכנית תאושר לבסוף על ידי העירייה.
