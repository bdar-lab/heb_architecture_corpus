# file = txt/1500056.txt
# filelineno = 775
# sentno = 3
# text = שאלה זו נשאלה לגבי הדירה החדשה מאחר ובראיונות ה'פיילוט' נאמר לי שהדיירים הותיקים לא יכלו לבחור את הכיוון בו אליו תפנה דירתם – לכיוון הכביש לוי אשכול (צד מזרח) או לכיוון הפארק הפנימי (צד מערב) מאחר ובהסכם שהם ערכו עם הקבלן הם קיבלו את כיוון הדירה בהגרלה.
