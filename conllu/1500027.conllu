# file = txt/1500027.txt
# filelineno = 687
# sentno = 1
# text = מגמת ההבדלים שהתקבלו בין הקבוצות במבנה התהליכים ובאיכות התוצרים מתאפיינת במידת התאמה גבוהה יותר בין מבנה התהליך לאיכות תוצרו בקרב הסטודנטים המתקדמים ולדעתנו ניתן לראות בהם עדות ראשונית לנטייה לקשר בין מבנה התהליך לאיכות תוצרו בקרב המתקדמים: תהליכי עיצוב בעלי שיעור גבוה יותר של קשרי גומלין בין היגדים נטו להיות פרודוקטיביים יותר באופן עקבי עם החיזוי שמציעה התאוריה ולהתבטא באיכות מוערכת גבוהה יותר של תוצרים.
