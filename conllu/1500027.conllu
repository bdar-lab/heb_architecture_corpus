# file = txt/1500027.txt
# filelineno = 618
# sentno = 1
# text = תוצאות הבדיקות מציעות עדויות ראשוניות לכך, שלפחות מבחינת יכולתו של ברק לבטא באופן מילולי את הנושאים בהם הוא עוסק ולקשור ביניהם קשרים, 'חשיבה בקול' במהלך עשיית הסקיצה הניבה משמעותית פחות קשרים בממוצע להיגד והראתה מידה נמוכה יותר של השתתפות בקשרי הלינקוגרף ביחס לקטעים אחרים באותו הלינקוגרף.
