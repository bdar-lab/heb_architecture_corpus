# file = txt/1500007.txt
# filelineno = 435
# sentno = 4
# text = אין בהסבר ההיסטורי המעניק משמעות מכוננת לאירועי ואדי סאליב, ומותח קו ביניהם לעליית הפנתרים השחורים ומהפך 1977, מבנה היסטורי המצמצם את נוכחות המזרחים לנקודות העימות שלו עם השלטון המרכזי, יכולת להמשיג את האופן בו האתניות עצמה מתהווה לכדי קטגוריה חברתית וגורם מניע ביסוד פעולתם של פרטים וקבוצות בחברה, ולהסביר את מניעיו של הממסד להכיר בש"ס כחלק מהאליטה הפוליטית.
