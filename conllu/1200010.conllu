# file = txt/1200010.txt
# filelineno = 44
# sentno = 1
# text = מחקר נוסף אשר בדק את הגורמים השורשיים לחריגות בתקציב ולוח זמנים בפרויקטי בנייה (רוזנפלד ויוקלה, 2011) ואשר ניסה לאמוד את שיעורי החריגה באופן כמותי מצא כי בהערכה גסה, החריגה הממוצעת בתקציב פרויקטי מבנים היא לפחות 15%, ובפרויקטי תשתיות החריגה גבוהה אף יותר.
