# file = txt/1200010.txt
# filelineno = 188
# sentno = 1
# text = בהתאם לדרישות חברת הביטוח NHBC (החברה הוקמה ב 1985 והיתה הראשונה להפוך לחברת פיקוח עצמאית Approved Inspector) המחזיקה בכ-85% משוק הביטוח של מבנים, לקבלן המבצע, שברוב המקרים הוא גם היזם, יש אחריות מלאה על כל סוגי הליקויים – תכנון, ביצוע וחומרים היות והוא זה ששוכר את שירותי המתכננים ורוכש את החומרים ומבצע את התיקונים בשנתיים הראשונות ממסירת המבנה.
