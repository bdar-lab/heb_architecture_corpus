# file = txt/1200010.txt
# filelineno = 709
# sentno = 1
# text = אם מנגנון הפיקוח ההנדסי המנדטורי לא ייושם, והנוהג הקיים כיום בענף לפיו מנהל הפרויקט מטעם היזם ישאר הגורם שאחראי על הפיקוח ההנדסי הצמוד, הרי שתפקיד זה חייב להיות מוסדר בחקיקה "בכל בנייה, יהיה סוגה אשר יהיה..." כאמור במסקנות ועדת זיילר.
