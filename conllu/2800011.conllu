# file = txt/2800011.txt
# filelineno = 245
# sentno = 4
# text = משמעות של קיום המסדרון, איפוא, כפולה: הוא מפריד ביתר בהירות את התחום הבלעדי של הפרם לגבי התחום המשותף ומקיף אותו כמו חגורת הגנה; כן מוגדר באמצעותו את גבולות התת-מערכת הפרטית, שבתוכה תחושת הפרטיות הואוטונומיות היא המובטחת ביותר.
