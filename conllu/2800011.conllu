# text = בהקשר זה, כדאי להביא את הגדרתו של האדריכל הצרפתי קנדיליס אשר נתן ביטוי למה שעל הדירה לספק בה, בשתי מלים קולעות: "להתבודד ולהתכנס"; להתבודד כדי ליהנות מפרטיות, ולהתכנס כדי להינות מחברתיות - בשבי המקרים גם יחד, כשהדבר מלווה אינטימיות (כחיסון מול ההמוניות המופרזת הנכפית).
# raw = {'id': 1, 'text': 'בהקשר זה, כדאי להביא את הגדרתו של האדריכל הצרפתי קנדיליס אשר נתן ביטוי למה שעל הדירה לספק בה, בשתי מלים קולעות: "להתבודד ולהתכנס"; להתבודד כדי ליהנות מפרטיות, ולהתכנס כדי להינות מחברתיות - בשבי המקרים גם יחד, כשהדבר מלווה אינטימיות (כחיסון מול ההמוניות המופרזת הנכפית).', 'dspan': (0, 269), 'tokens': [{'id': (1, 2), 'text': 'בהקשר', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'הקשר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'obl', 'lemma': 'הקשר'}], 'span': (0, 5), 'dspan': (0, 5)}, {'id': 3, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Dem', 'head': 2, 'deprel': 'det', 'dspan': (6, 8), 'span': (6, 8), 'lemma': 'זה'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (8, 9), 'span': (8, 9), 'lemma': ','}, {'id': 5, 'text': 'כדאי', 'upos': 'ADJ', 'xpos': 'VERB', 'feats': 'Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (10, 14), 'span': (10, 14), 'lemma': 'כדאי'}, {'id': 6, 'text': 'להביא', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=HIFIL|VerbForm=Inf|Voice=Act', 'head': 5, 'deprel': 'csubj', 'dspan': (15, 20), 'span': (15, 20), 'lemma': 'הביא'}, {'id': 7, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 8, 'deprel': 'case', 'dspan': (21, 23), 'span': (21, 23), 'lemma': 'את'}, {'id': (8, 9), 'text': 'הגדרתו', 'expanded': [{'id': 8, 'text': 'הגדרת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'obj', 'lemma': 'הגדרה'}, {'id': 9, 'text': 'ו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Definite=Def|Gender=Masc|Number=Sing|Person=3|Poss=Yes|PronType=Prs', 'head': 8, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (24, 30), 'dspan': (24, 30)}, {'id': 10, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'h