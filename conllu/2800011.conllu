# file = txt/2800011.txt
# filelineno = 235
# sentno = 1
# text = באשר לאספקט הראשון, החומר התכנוני מאפשר ריכוז הפתרונות לגבי החללים הפרטיים בשתי קבוצות בסיסיות - הגירסה בעלת שני "חדרי שינה" הנמצאים סמוכים זה לזה, כלומר עם דלתות הכביסה בקירוב מידי - והגירסה בעלת שני החדרים הנמצאים בקצוות של מסדרון מיוחד, הנועד לתנועה הפנימית בין החללים הפרטיים; במקרה האחרון, הפתרון גורס כי המסדרון בין שני החדרים יוצר מרחק מסויים המפריד בין הכניסות ומסמן בשל זה את האופי הפרטי של השימוש בכל אחד מהחדרים.
