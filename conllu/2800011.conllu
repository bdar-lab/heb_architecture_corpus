# file = txt/2800011.txt
# filelineno = 202
# sentno = 1
# text = -	הצורך ב״פרטיות" יתכן טיהיה יותר טכיח במטפחות הנוטאות תכובות ודפוסי חיים כגון: המובות בבי נוער ומתבגרים; שני בבי זוג מועסקים; רמת הטכלה גבוהה יחסית; התבהגות יותר "מודרבית״ן בבי המטפחה המבהלים פעילויות יותר אוטובומיות; התכבסות כלל-מטפחתית הזדמבותית; הפרדה קבוצתית או איטית שכיחה; יתר מ שקל לחיים פרטיים; יחסים חיצוביים מרובים ומגוובים.
