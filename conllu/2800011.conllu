# file = txt/2800011.txt
# filelineno = 111
# sentno = 2
# text = זאת אומרת שאם הפתרונות התיכוביניים המיועדים להבטיח את המסגרת המשותפת מקבלים את החטיבות המכרעת ומטין את מאזן התוכניות בכיוונם (לרעת הסיפוק של המסגרת הפרטית) אז התוצאות יגרמו לאי-התאמה שיכולה לקפח את האיזון וההתנהגות המשפחתית־ אומנם, הנתוח הסוציולוגי עדיין לא גיבש אמצעים חד משמעותיים שמסוגלים למדוד ישירות ובאופן כמותי את הנזק הנגרם במקרה כזה, אך אין ספק שההשפעות השליליות יתפסו בתחומים השונים ביותר של החיים החברתיים.
