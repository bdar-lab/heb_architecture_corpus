# file = txt/2800011.txt
# filelineno = 104
# sentno = 2
# text = הנתונים שלהלן משכנעים במיוחד בשל המגמות המתבטאות: אם נחלק לפי המין את המועסקים בכוח העבודה האזרחי ונעקוב אחר כך אחר הגידול במספרם, נמצא שבשנת 1971 לעומת 1955 המספר הכללי של המועסקים גדל ב-66 אחוז: המועסקים הגברים ב-50 אחוז בעוד שלגבי נשים המועסקות, העליה היתה ב-112 אחוז.
