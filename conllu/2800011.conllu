# file = txt/2800011.txt
# filelineno = 449
# sentno = 1
# text = לבסוף, יש לחזור ולהדגיש שלמרות־שבכל מקרה הבחנו "ערך סף" כמותי של שטח הדרוש לביצוע הפעילויות, הערכת מידת ההתאמה בין טיפוסי דירה וצרכי המשפחה בשארה בשלב זה, בעצם, איכותית, בלא להגיע למימדים כמותיים של תקנים לתכנון.
