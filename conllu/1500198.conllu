# file = txt/1500198.txt
# filelineno = 118
# sentno = 1
# text = עיצוב ופיתוח של מערכת רב-חושיות לחדר ניתוח דורשים התבוננות באינטראקציות של משתמשי חדר ניתוח: הם מחייבים לבחון כיצד המשתמשים פועלים במקום העבודה, איך הם מתקשרים אחד עם השני, אילו חושים מעורבים בביצוע המשימות ובהעברת המסרים, כיצד הם מתנהגים במצבי חירום, כיצד הם מתקנים או מגיבים על תקלות וכוי.
