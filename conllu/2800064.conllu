# text = אכן, מתוך הסתכלות ומתוך שיחות חופשיות, הסתבר כי פעילותה של קבוצת המנהיגות המקומית בתקופת הסקר התבטאה בעיקר בכל הקשור לפעולות "ועדת-הפינוי": אנשי הקבוצה שימשו כ"כתובת" לברורים, טענות וסידורים מינהליים שונים, ומאידך פעלו כמשכנעים ומסבירים לגבי אותם הדיירים, אשר לא גילו נטיח לעבור מהשכונה.
# raw = {'id': 1, 'text': 'אכן, מתוך הסתכלות ומתוך שיחות חופשיות, הסתבר כי פעילותה של קבוצת המנהיגות המקומית בתקופת הסקר התבטאה בעיקר בכל הקשור לפעולות "ועדת-הפינוי": אנשי הקבוצה שימשו כ"כתובת" לברורים, טענות וסידורים מינהליים שונים, ומאידך פעלו כמשכנעים ומסבירים לגבי אותם הדיירים, אשר לא גילו נטיח לעבור מהשכונה.', 'dspan': (0, 287), 'tokens': [{'id': 1, 'text': 'אכן', 'upos': 'ADV', 'xpos': 'ADV', 'head': 10, 'deprel': 'advmod', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'אכן'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (3, 4), 'span': (3, 4), 'lemma': ','}, {'id': 3, 'text': 'מתוך', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'dspan': (5, 9), 'span': (5, 9), 'lemma': 'מתוך'}, {'id': 4, 'text': 'הסתכלות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 10, 'deprel': 'obl', 'dspan': (10, 17), 'span': (10, 17), 'lemma': 'הסתכלות'}, {'id': (5, 6), 'text': 'ומתוך', 'expanded': [{'id': 5, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 7, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 6, 'text': 'מתוך', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'מתוך'}], 'span': (18, 23), 'dspan': (18, 23)}, {'id': 7, 'text': 'שיחות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 4, 'deprel': 'conj', 'dspan': (24, 29), 'span': (24, 29), 'lemma': 'שיחה'}, {'id': 8, 'text': 'חופשיות', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Plur', 'head': 7, 'deprel': 'amod', 'dspan': (30, 37), 'span': (30, 37), 'lemma': 'חופשיות'}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (37, 38), 'span': (37, 38), 'lemma': ','}, {'id': 10, 'text': 'הסתבר', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HITPAEL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (39, 44), 'span': (39, 44), 'lemma': 'הסתבר'}, {'id': 11, 'text': 'כי', 'upos': 'SCONJ', 'xpos':