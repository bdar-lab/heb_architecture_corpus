# file = txt/1400078.txt
# filelineno = 85
# sentno = 1
# text = נושא פיתוח בר קיימא ככלל והתעדת מבנים לפי תקן לבניה ירוקה בפרט הנו נושא חדשני בעולם המערבי שתפס תאוצה ומודעות ציבורית בשנים האחרונות, כך שרשות בעלת אקלים יוזמה וחדשנות חזק יעודד את עובדי מנהל ההנדסה לפתח מנגנונים, וקווי מדיניות חדשים בתוך הרשות לקידום נושא זה, כגון: יצירת מנגנון פיקוח על בניה ירוקה על המבנים חדשים, כתיבת סדרת אמות מידה המהווים רשימה עבור היזמים כיצד לתכנן ולבנות מבנה ירוק, יצירת ועדת יעוץ /ליווי יזם באגף הרישוי, המנחה את היזם כיצד לעמוד בת"י 5281 לבניה ירוקה כתנאי בהיתר הבניה.
