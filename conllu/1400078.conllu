# file = txt/1400078.txt
# filelineno = 234
# sentno = 3
# text = דוגמא לתשובה היכולה להעיד על תפיסת פוליטיקה ארגונית חיצונית חזקה תהיה, כי קיימים כוחות חיצוניים רבים (כגון: יזמים, בעלי קרקעות, ארגונים חברתיים, ציבוריים וסביבתיים), המשפיעים על אופן קבלת ההחלטות של נבחרי הציבור, וכי על-פי לחציהם של כוחות חיצוניים אלה, ראש העיר מתווה את מדיניות העיר.
