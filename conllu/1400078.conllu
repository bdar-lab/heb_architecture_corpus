# file = txt/1400078.txt
# filelineno = 346
# sentno = 6
# text = כך, למשל, בשלוש הערים שבהן נמצאה תפיסת אקלים המנהיגות הגבוהה ביותר מבין הרשויות (רשויות מספר 6 ו-7, והעיר תל אביב), התבצע מיקור-חוץ לשם יישום ההטמעה של עקרונות פיתוח-קיימא בתוצרי התכנון.
