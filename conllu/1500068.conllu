# file = txt/1500068.txt
# filelineno = 749
# sentno = 1
# text = המודל הסופי הכיל ארבעה משתנים בלתי תלויים המנבאים את ההסתברות שאדם בודד יהיה מוכן לשלם תוספת של 1 ₪ עבור נסיעה במנהרה כדי לשמור על שטחים פתוחים, והם: מגדר, הגורם המממן את אגרת הנסיעה בכביש 6, תמיכה בפיתוח מול תמיכה בשימור, ועמדה כלפי ההיגד כי "הגנה על שטחים פתוחים אינה נוגעת לי".
