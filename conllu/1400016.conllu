# text = מגמת הפרבור, נדידת מוקדי המסחר, התעסוקה והבילוי מהמרכזים ההיסטוריים של העיר, גודש תחבורתי ורמת איכות סביבה מידרדרת, גרמו לאוכלוסיות החזקות לנטוש את מרכזי הערים והשכונות הוותיקות לטובת מגורים כפריים ושכונות חדשות בפאתי העיר (משרד הפנים, 2008).
# raw = {'id': 1, 'text': 'מגמת הפרבור, נדידת מוקדי המסחר, התעסוקה והבילוי מהמרכזים ההיסטוריים של העיר, גודש תחבורתי ורמת איכות סביבה מידרדרת, גרמו לאוכלוסיות החזקות לנטוש את מרכזי הערים והשכונות הוותיקות לטובת מגורים כפריים ושכונות חדשות בפאתי העיר (משרד הפנים, 2008).', 'dspan': (0, 242), 'tokens': [{'id': 1, 'text': 'מגמת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 32, 'deprel': 'nsubj', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'מגמה'}, {'id': (2, 3), 'text': 'הפרבור', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'פרבור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'compound', 'lemma': 'פרבור'}], 'span': (5, 11), 'dspan': (5, 11)}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (11, 12), 'span': (11, 12), 'lemma': ','}, {'id': 5, 'text': 'נדידת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'conj', 'dspan': (13, 18), 'span': (13, 18), 'lemma': 'נדידת'}, {'id': 6, 'text': 'מוקדי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'compound', 'dspan': (19, 24), 'span': (19, 24), 'lemma': 'מוקד'}, {'id': (7, 8), 'text': 'המסחר', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'מסחר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'compound', 'lemma': 'מסחר'}], 'span': (25, 30), 'dspan': (25, 30)}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 8, 'deprel': 'punct', 'dspan': (30, 31), 'span': (30, 31), 'lemma': ','}, {'id': (10, 11), 'text': 'התעסוקה', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'D