# filelineno = 316
# sentno = 1
# text = •	רצוי שריהוט הגן, הכולל בין השאר ספסלים, שולחנות פיקניק, שולחנות משחק ואשפתונים, יהיה מקובע ועשוי מחומרים עמידים לשחיקה והשחתה, ושאינם מתלהטים, כגון בטון, אבן, עץ, ואריחי קרמיקה או גרניט בעלי גוון בהיר.
