# file = txt/1500102.txt
# filelineno = 77
# sentno = 4
# text = עוד טוען בן־ישראל כי חשוב שקובעי המדיניות יהיו מודעים לכך כי ביצוע מחקר גינרי אשר מניב חדשנות אמיתית מצריך תקופה ממושכת של לפחות 10 שנים, התקציבים המושקעים הם גבוהים מאוד (לדוגמא כ- 1.5 מיליארד דולר בשנה מושקע במו״פ ביטחוני בישראל), ואחוזי ההצלחה של הפרויקטים השונים הם נמוכים (בן ישראל, 2004).
