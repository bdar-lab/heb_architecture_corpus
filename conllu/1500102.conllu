# file = txt/1500102.txt
# filelineno = 686
# sentno = 8
# text = יש לציין כי באזורי הפריפריה בקבוצה של המפעלים בהם אחוז התמיכה הוא בין 10% ל- 20% הוצאות המו״פ בממוצע למועסק הן הגבוהות ביותר, אולם ההבדל בין קבוצה זו לבין המפעלים המקבלים תמיכה ממשלתית עד 10% מההוצאה הכוללת לא נמצאה מובהקת סטטיסטית.
