# file = txt/1500102.txt
# filelineno = 743
# sentno = 9
# text = יתרה מכך הפחתת גובה התמיכה הממשלתית לערכים המפורטים לעיל יאפשר להקצות משאבים לחברות נוספות המשתייכות לסקטור העסקי (כאמור רק כ-39% מהמפעלים העוסקים במו״פ זכו לתמיכה ממשלתית) ובאופן זה להגדיל מעגל הנהנים ולהביא בעקיפין להגדלה של ההשקעות העצמיות ומכאן להגדלה של סה״כ הוצאות המו״פ במשק.
