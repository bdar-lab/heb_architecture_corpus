# file = txt/1500102.txt
# filelineno = 721
# sentno = 1
# text = מבחינה אזורית ממצאי המחקר מצביעים על כך כי באזורי הביניים ההכנסה של המפעל בממוצע לעובד היא הגדולה ביותר, בחינה תת-אזורית של הממוצע הענפי העלתה כי תת האזור בו ההכנסה הממוצעת לעובד הגדולה ביותר הוא אזור ביניים צפון כאשר בנוסף לתת אזור זה, מצאנו כי כל אזורי הצפון (דהיינו, אזור חיפה והפריפריה הצפונית) מציגים את הפדיון בממוצע לעובד הגבוה ביותר בחברות המשקיעות במו״פ בסקטור העסקי במשק .
