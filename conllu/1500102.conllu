# file = txt/1500102.txt
# filelineno = 453
# sentno = 1
# text = השוואה בין אחוז ההכנסות מסוגי המוצרים השונים מעלה כי בעוד שבתעשיות טכנולוגיה מעורבת ומסורתית ההכנסות שמקורן במוצרים חדשים ובמוצרים ששופרו בחמש השנים האחרונות מהוות נתח נמוך מכלל ההכנסות של המפעל (כ-21%) ואין הבדל משמעותי ביניהם, הרי שבתעשיות עתירות ידע, ושירותי מחקר ומחשוב הם מהווים נתח נכבד מהכנסות המפעל (כ-65% ו כ-79.5% בהתאמה) וקיים הבדל משמעותי ביניהם.
