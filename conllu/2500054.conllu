# file = txt/2500054.txt
# filelineno = 1515
# sentno = 3
# text = לעומת זאת, גישה בי מהירה ונוחה מאד לישום, אולם רמת הדיוק שלה נמוכה ביותר ובהעדר מידע על כמויות האלמנטים במבנה, היא מקנה אפשרויות מוגבלות בלבד להתאמת האומדן לשנויים במחירים, לשנויים טכנולוגיים, ולוריאציות תכנוניות לא-שגרתיות.
