# file = txt/2500054.txt
# filelineno = 1425
# sentno = 1
# text = ו" אין הקבלן יודע מראש את ערכם של כל הגורמים דלעיל המשפיעים על עלות הבנייה, קביעת המחיר על ידי הקבלן במצב זה תהייה תלוייה בגישתו לנטילת סיכונים" ככל שגישתו של הקבלן זהירה יותר כך יעדיף הוא לקבוע את מחיר הבנייה על פי צירוף המקרים הגרוע ביותר" ניתוח מספר גישות סבירות בפרויקט מצוי מורה שמצב של חוסר הודאות ביחס לערכם המדוייק של הפרמטרים העיקריים עלול להביא לייקור הבנייה בשיעור עד כ—15% מעלות התשומות לקבלו ביחס למצב האופטימלי (כמוגדר ב-אי).
