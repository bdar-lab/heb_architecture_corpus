# file = txt/2500054.txt
# filelineno = 1290
# sentno = 2
# text = בארץ מקובל להשתמש למטרה זו בנתונים מחוייל, בעיקר מגרמניה ומארצות הברית" אולם נתונים אלה, ובעיקר אורך־החיים הכלכלי של הציוד, תלויים בתנאים הכלכליים (הריבית על ההון, שיעורי מיטים והיטלים, עלות שכר עבודה וכדומה) ובתנאי העבודה (למשל אינטנסיביות השימוש בציוד, טיפול מונע).
