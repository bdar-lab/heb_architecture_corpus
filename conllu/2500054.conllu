# sentno = 2
# text = את הגורמים האלה והשפעתם על הרווח חייב הקבלן לקחת בחשבון בעת הכנת תחשיב העלות־ במצב האופטימלי - כאשר שיעור ההתייקרות ידוע מראש, התשלומים מתקבלים בעיתם, משך הביצוע אינו חורג מהמוסכם והתשומות בפרויקט מתייקרות בהתאם למדד מהווה עלות המימון הנוספת עקב האינפלציה בשיעוריה הנוכחיים (כ-120% לשנה), כ-15% מהעלות הכללית.
