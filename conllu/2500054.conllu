# file = txt/2500054.txt
# filelineno = 1579
# sentno = 1
# text = מקדמי השוני שהתקבלו בחשוב הערכים הממוצעים מגדירים אה מדה הפזור של אלמנט מסוים בתוך אוכלוסית המבנים שבמדגם, אך אין בהם כדי להצביע על הדיוק של האומדן הכולל־ דבר זה נובע מהעובדה שבבניו קימים אלמנטים חליפיים רבים היכולים לבוא אחד במקום השני, ולפיכך תלוי הדיוק של אומדן העלות במרה רבה בהפרשי העלויות ביניהם־ כך, למשל, רוחים קטנים יותר בין העמודים עלולים להגדיל את כמות הבטון הכוללת בהם (בעקר אם חלקם בעלי מדות מינימליות) ומצד שני להקטין את כמות הבטון בקורות; שנוי באחוז הזיון של אלמנט כלשהו מבטון מזוין יגרום לשנויים הפוכים בכמויות של פלדת הזיון והבטון; הגדלה של שטח הבטון החשוף בחזיתות תביא בעקבותיה להקטנה מתאימה בשטח טיח החוץ וכדומה־ מכיון שמתכננים שונים יכולים לקבל החלטות שונות בנושאים אלה ואחרים, עשויים להתקבל הבדלים בכמויות של האלמנטים בין מבנה אחד למשנהו גם אם אינם גורמים בהכרח להבדלים בעלות הכוללת של המבנה.
