# file = txt/1500042.txt
# filelineno = 741
# sentno = 2
# text = אמנם מדד אחד מן השבעה בתחום זה - "הצגת פתרונות לטיפול בביוב כתנאי לפיתוח" – המופיע בהוראות הוא אכן סוגיה סביבתית הקשורה לטיפול במטרדים, אך גם בהוראות נמצא כי נושא הפסולת, החומרים המסוכנים, המחצבות ואחרים, אינם בין הסוגיות הכלולות בכל התכניות, למרות שהם חלק מן הבעיות הסביבתיות המאפיינות את כל חלקי הארץ.
