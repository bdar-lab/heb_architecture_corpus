# file = txt/1500042.txt
# filelineno = 197
# sentno = 2
# text = בתחום סילוק הפסולת קיימת הוראה מצומצמת בעלת אופי של תכנון סביבתי מסדיר: "תכנית המייעדת שטח למגורים או למוסדות ציבור בטווח של 2,000 מי מהאתר לא תאושר, אלא אם-כן הוגש תסקיר השפעה על הסביבה"; בתחום הכרייה והחציבה, תמ"א 35 לא מוסיפה אלא מאמצת תמ"א קיימת (תמ"א 14) הדורשת שיקום שטחי כרייה וחציבה נטושים; בתחום מטרדי הרעש, מתייחסת התמ״א רק לרעש מטוסים (ולא למקורות רעש נוספים כגון תעשיות כבדות, כבישים ועוד), כשהכלי להתמודדות עם מטרדי רעש המטוסים דומה במהותו להתמודדות הנדרשת עם מטרדי הפסולת - התניית בנייה למגורים או מוסדות ציבור בשטחים אלה בבדיקת השפעות הרעש ע״י מוסדות התכנון; בתחום החומרים המסוכנים, מחייבת התמ"א הכנה של "סקר סיכונים" או "סקר התאמה"; בתחום זיהום הקרקע, קובעת התמ"א הוראה חדשנית המתנה מתן היתרי בניה בטיפול בזיהומי קרקע אם יתברר כי הקרקע אכן מזוהמת; ובתחום התחבורה, קיים ביטוי למתן עדיפות לתח״צ בדמות הוראות להקצאת נתיבים לתח"צ בדרכים ארציות או עירוניות ראשיות ובחיוב קביעת תקני חנייה מופחתים בסמוך לתחנות ראשיות של התחבורה הציבורית.
