# file = txt/1500042.txt
# filelineno = 1052
# sentno = 1
# text = מטרות עיקריות אלו פורטו למספר מטרות משנה והן: אפיון הסוגיות הסביבתיות הבאות לידי ביטוי בתכניות שימושי קרקע כוללניות, ארציות ומחוזיות; אפיון התכניות הכוללניות, הארציות והמחוזיות, על-פי מידת השילוב של סוגיות סביבתיות; אפיון סוגי המסמכים השונים של התכניות על-פי מידת שילובן של סוגיות סביבתיות; פיתוח קריטריונים ומדדים למדידת שילובן של הסוגיות; ופיתוח שיטה לאמידה ולהערכה של מידת הביטוי של מגוון סוגיות סביבתיות.
