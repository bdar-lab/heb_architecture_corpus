# file = txt/1500042.txt
# filelineno = 1162
# sentno = 3
# text = יחד עם זאת, את מרבית הממצאים ניתן לייחס לעובדה כי לא קיימת שיטתיות בהטמעת שיקולים סביבתיים, להעדר השפה האחידה של מונחים ושל סמלים גראפיים, וכפי הנראה גם לרמת הידע הסביבתי או המודעות המשתנה של המתכננים ושל הגורמים המלווים אותם בתהליך התכנון.
