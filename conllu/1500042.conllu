# file = txt/1500042.txt
# filelineno = 298
# sentno = 3
# text = בתחילתו (סי 4.3.1), נסקרים מאפיינים מרכזיים של מחקר איכותני ושל שיטת ניתוח התוכן, המורכבת מהערכת תכנים מילוליים וגראפיים המצויים בתכניות שימושי הקרקע; בחלקו השני (סי 4.3.2), מוצג תיאור התהליך של ביסוס רשימת הנושאים והמדדים הרלבנטית למחקר הנוכחי, ופירוט של התכנים המדויקים שנקבעו להיכלל בכל אחד מהם; בחלק השלישי (סי 4.3.3), מתואר תהליך איסוף הנתונים וארגונם; ובחלק הרביעי (סי 4.3.4) החותם את תיאור שיטת המחקר, מתוארת השיטה לדירוג הנתונים המורכבת ממספר סולמות מדידה (שיפורטו בהמשך).
