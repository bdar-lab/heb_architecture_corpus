# file = txt/1500042.txt
# filelineno = 992
# sentno = 4
# text = למרות זאת, בתמ"מ 9/2 נמצאו תשעה מדדים חדשניים, מדדים שלא הופיעו בדברי ההסבר של תמ"א 31, והם קשורים למגוון נושאים: שלושה מהם מתחום השמירה על השט"פ: "העדפת פיתוח מוקדים משותפים למספר יישובים", "חיזוק המרחבים העירוניים ומרכזי הערים בפרט", ו"ניצול מרבי של שטח מפותח קיים לפני פיתוח אזורים חדשים".
