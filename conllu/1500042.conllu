# file = txt/1500042.txt
# filelineno = 724
# sentno = 1
# text = המגמה העולה מבדיקת מגוון הסוגיות המצוינות בהוראות של התכניות דומה למגמה שנמצאה בקטגוריה הראשונה של "דברי ההסבר", אם כי בהיקפים נמוכים יותר; מגוון המדדים בהוראות של התכניות השונות שנבדקו, נע בין 23 מדדים בתכנית תמ"מ 9/2 – מחוז הצפון ל-51 בתמ"מ 6, כלומר בין 30.6% ל- 68% מכלל המדדים, ראה תרשים מס' 5.4 וטבלה מס' 5.11.
