# file = txt/1500042.txt
# filelineno = 991
# sentno = 1
# text = דברי ההסבר של תמ"א 31, אשר מבחינה כרונולוגית פורסמו ראשונים, כוללים רשימה של 37 מדדים חדשניים, ביניהם כל המדדים בנושאי השמירה על איכות וכמות המים, מדדים רבים בנושא השמירה על השטחים הפתוחים, השמירה על הנופים ונופי המורשה התרבותית, וכן מדדים רבים בנושא השמירה על איכות האוויר, הטיפול בשפכים, בפסולת, בחומרים מסוכנים ועוד.
