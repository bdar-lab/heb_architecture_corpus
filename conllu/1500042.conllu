# file = txt/1500042.txt
# filelineno = 994
# sentno = 3
# text = חמישה מבין המדדים האלו עוסקים בצמצום מטרדים סביבתיים (אוויר, פסולת, רעש, קרקע מזוהמת); שניים נוספים עוסקים בניצול יעיל יותר של הקרקע ("שיקום/מחזור/שימוש חוזר של קרקעות אפורות לשימושים חלופיים" ו"העדפת שדרוג תשתיות קיימות על פני הוספת חדשות"); ושלושה מדדים חדשניים הם מתחום השמירה על המגוון הביולוגי והתהליכים האקולוגיים: "הקצאת שטחים לשימור ושיקום מערכות טבעיות ביישובים", "הקצאת מים מושבים/שפירים לשימור טבע" ו"שמירת אזורי חיץ סביב שמורות ושטחים ערכיים אחרים".
