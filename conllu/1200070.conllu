# file = txt/1200070.txt
# filelineno = 73
# sentno = 1
# text = תהליך הטחינה של חומרי הגלם לאחר ייבוש בתנור כלל: טחינה כפולה של פרקציות דקות של פסולת בטון במטחנת דיסק; טחינת אבן גיר במטחנת הדיסק, טחינת בוקסיט בשלב ראשון במטחנת דיסק ובשלב שני במטחנת כדורים פלנטרית במשך 5 דקות ובמהירות של 550 סל"ד; תחמוצת ברזל נטחנה במטחנה כדורית פלנטרית במשך 10 דקות במהירות של 550 סל"ד.
