# file = txt/2000122.txt
# filelineno = 816
# sentno = 2
# text = האפשרויות שיכולות לבוא ליד ביטוי הן פיתוח חנייה במגרש ללא התחלת בנייה עם בעלות לא מוגדרת (ראה סעיף 8.1.1 וי) או שימוש בשצ״פ או חלק ממנו, שמסיבות כאלה או אחרות אינו מסוגל לעמוד בייעודו המקורי (ראה איורים 8-3 ב׳, ג׳), או בניית מבנה קומות לחניון (ראה איור 4־8) במגרש שיימצא לצורך כך (יכול להיות גם בבעלות פרטית) כדי.
