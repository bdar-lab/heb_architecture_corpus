# file = txt/2000122.txt
# filelineno = 182
# sentno = 2
# text = התפתחות מסוג זה בארה״ב קיבלה כינוי ״יחידת פיתוח מתוכננת״ (Planned Unit Development) שיושמה תוך בניית חלק משכונות פרבריות בשנות ה- 60 וה- 70 והתבססה על עיקרון קיום של מגוון שימושי קרקע שמשלימים זה את זה על מנת ליצור יתרונות כלכליים וחברתיים בקהילה חדשה.
