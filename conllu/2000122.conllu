# file = txt/2000122.txt
# filelineno = 173
# sentno = 1
# text = המודעות לנחיצותה של מדיניות פינוי-בינוי עלתה לקראת אמצע שנות ה- 90, כאשר תכניות שונות ברמה ארצית (״ישראל 2020״, תמ״א 31 - תכנית מתאר ארצית משולבת לבנייה, לפיתוח ולקליטת עלייה, וכן תמ״א 35 - תכנית מתאר ארצית חדשה לבנייה ולפיתוח) קבעו כי חלק גדול ככל הניתן מהבינוי העתידי של מדינת ישראל צריך להתבצע במסגרת השטחים המבונים על מנת לשמור על שטחים פתוחים ולאפשר שימוש יעיל בקרע, תשתיות ומוסדות ציבור (ראה פרק משנה 1.1.1).
