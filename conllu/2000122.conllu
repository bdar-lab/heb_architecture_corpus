# file = txt/2000122.txt
# filelineno = 218
# sentno = 2
# text = במסגרת הפרוייקט בוצעו הפעולות התכנוניות הבאות: ניקוי פני השטח העליונים בשיטת Phytoremediation (טיפול בעזרת נטיעת צמחים מיוחדים), ריבוד ״נושם״ (Porous paving) של מגרשי חנייה המאפשר חלחול מי גשם, הקמת מערכת מתקדמת לניקוז מי גשמים המאפשרת סינון וניקוי של המים, הקמת מערכת גשרים להולכי רגל במתחם, טיפול בכל המבנים הקיימים ויצירת סביבה נאותה לרווחת העובדים, הוספת כ- 80 דונמים של שטחים ירוקים כולל נטיעות של אלפי עצים וצמחים אחרים להצללת המבנים, הקמת מבנה ייצור ראשי חדש שתוכנן תוך התחשבות מירבית בנושאים סביבתיים (כולל היבטי חסכון באנרגיה).
