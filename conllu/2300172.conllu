# text = לפיכך, התועלת הפוטנציאלית של תכנון עירוני רגיש למים ביישובים שעל פני אקוויפר החוף הישראלי כוללת את כלל האומדן שצוין בטבלה 3.1 עבור שנת 2020, היינו: תוספת של כ־150 מליון מ״ק מים לשנה, שערכם 30־100 מליון דולר (לפי חישובים על בסיס שונה), ובנוסף לכך - איכות משופרת של המים המוחדרים לאקוויפר וחיסכון ניכר בעלויותיהן של מערכות ניקוז עירוניות.
# raw = {'id': 4, 'text': 'לפיכך, התועלת הפוטנציאלית של תכנון עירוני רגיש למים ביישובים שעל פני אקוויפר החוף הישראלי כוללת את כלל האומדן שצוין בטבלה 3.1 עבור שנת 2020, היינו: תוספת של כ־150 מליון מ״ק מים לשנה, שערכם 30־100 מליון דולר (לפי חישובים על בסיס שונה), ובנוסף לכך - איכות משופרת של המים המוחדרים לאקוויפר וחיסכון ניכר בעלויותיהן של מערכות ניקוז עירוניות.', 'dspan': (405, 741), 'tokens': [{'id': 1, 'text': 'לפיכך', 'upos': 'ADV', 'xpos': 'ADV', 'head': 23, 'deprel': 'advmod', 'dspan': (405, 410), 'span': (0, 5), 'lemma': 'לפיכך'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (410, 411), 'span': (5, 6), 'lemma': ','}, {'id': (3, 4), 'text': 'התועלת', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'תועלת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 23, 'deprel': 'nsubj', 'lemma': 'תועלת'}], 'span': (7, 13), 'dspan': (412, 418)}, {'id': (5, 6), 'text': 'הפוטנציאלית', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'פוטנציאלית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'amod', 'lemma': 'פוטנציאלית'}], 'span': (14, 25), 'dspan': (419, 430)}, {'id': 7, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 8, 'deprel': 'case:gen', 'dspan': (431, 433), 'span': (26, 28), 'lemma': 'של'}, {'id': 8, 'text': 'תכנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'nmod', 'dspan': (434, 439), 'span': (29, 34), 'lemma': 'תכנון'}, {'id': 9, 'text': 'עירוני', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 8, 'deprel': 'amod', 'dspan': (440, 446), 'span': (35, 41), 'lemma': 'עירוני'}, {'id': 10, 'text': 'רגיש', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats'