# file = txt/2300172.txt
# filelineno = 273
# sentno = 1
# text = 4)	חומרי ריצוף וסלילה חדירים למים - בשוק קיימים חומרים אחדים, כמו "אספלט שקט" (נקבובי), המשמש לסלילת דרכים, וכמו פסי פלסטיק קשיח, שאותם אפשר להניח כתשתית לשטחי חנייה (פרטיים או ציבוריים) ובריבועים הפתוחים ביניהם לגדל דשא.
