# file = txt/2300172.txt
# filelineno = 194
# sentno = 2
# text = התוצאה שקיבלנו בעזרתו ־ נגר על־קרקעי ממוצע, הנחשב גם להפסד חלחול ממוצע, של 14% מן הגשם השנתי הממוצע ־ נראתה מתקבלת על הדעת בהשוואה לתוצאות של מחקרים אחרים (ראה טבלה ד׳ 1 אצל מירון־פיסטינר וחובריה 1996, עמוד 137): אהוד סימון וחובריו (1988) חישבו מקדם נגר על־קרקעי שנתי בגבולות 6% עד 11% עבור ערים אחדות במישור החוף בישראל; השירות ההידרולוגי (1994) הגיע למקדם נגר על־קרקעי בתחום שבין 90/0 ל־15% עבור כל שטח הניקוז המערבי (9,000 קמ״ר) (חישובים אלה מתייחסים לשטחים נרחבים יותר משלנו, אשר רק חלקם עירוני, וכנראה שזו אחת הסיבות למקדם הנמוך שקיבלו).
