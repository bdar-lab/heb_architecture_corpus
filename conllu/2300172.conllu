# file = txt/2300172.txt
# filelineno = 205
# sentno = 2
# text = לצורך חישוב וניתוח המשמעות של תוצאות אלה עבור אקוויפר החוף כולו (ר׳ הפרק הבא), נתייחס לערך אמצעי, כלהלן: אם מודל SCS הורה על הפסד חלחול של 14% מן הגשם השנתי, השווים בערך ל־70,000 מ׳׳ק בממוצע שנתי, בעוד שמודל SWMM הורה על הפסד ממוצע של 49°/0, השווים לכ-ססס,250 מ״ק בממוצע שנתי, הערך האמצעי שנתייחס אליו יהיה הפסד חלחול של 160,000 מ״ק בממוצע שנתי עבור כל קמ״ר בבנייה עירונית מקובלת (המשך החישוב בפרק 3.2).
