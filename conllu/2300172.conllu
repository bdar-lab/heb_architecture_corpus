# file = txt/2300172.txt
# filelineno = 133
# sentno = 1
# text = - במשך הזמן חלה עליה בריכוזי כלורידים וניטרטים, כתוצאה מפעילויות שונות בשטח, ביניהן: סילוק שפכים באמצעות בורות סופגים (שעתה כבר הוצאו משימוש), דישון חקלאי, השקייה במים מיובאים מן הכנרת, שמליחותם גבוהה ממליחות מי האקוויפר, השקייה בקולחים, וגם חדירת מי-ים במערב האקוויפר, כתוצאה משאיבת היתר.
