# file = txt/2000133.txt
# filelineno = 550
# sentno = 1
# text = לעמדתו, תהליכי השינוי בקיבוץ מלווים בסיכונים לעתיד הקהילה הקיבוצית: אובדן עוצמה ועצמאות של הקהילה, תלות גדלה בגורמים חיצוניים, איבוד שליטה על עתידו של הקיבוץ בכלל ועתידם האישי של חבריו בפרט ־ במקרה של השתלטות גורמים כלכליים ונדל״ניים על הפעילות הקיבוצית, סכסוכים פנימיים שימנעו קבלת החלטות בקיבוץ ועלולים להביא להחלשות המנהיגות ולהתפוררות הקהילה.
