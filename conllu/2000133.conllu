# file = txt/2000133.txt
# filelineno = 341
# sentno = 1
# text = יצויין, כי המגמה הרווחת לשיתוף התושבים בקבלת החלטות הנוגעות לאזור או לישוב מגוריהם, מעניקה יתרון לישוב הקטן על פני הישוב הגדול, ולכן הגישה המעודדת מעורבות פוליטית של התושבים מעודדת קיומם של ישובים קטנים דווקא, ברובד השלטוני הנמוך, מה גם שתושבי ישובים קטנים נוטים בדרך כלל להתנדב למילוי תפקידים מוניציפליים ולתרום להרחבת הפעילות המקומית.
