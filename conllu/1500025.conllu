# file = txt/1500025.txt
# filelineno = 891
# sentno = 1
# text = המשך בחינת ההקשרים המשוערים בין מאפייני תכניות לבין מאפייני התנגדויות שהוגשו בגינן עשויה להאיר סוגים שונים של קונפליקטים שתכנית עשויה לעורר, על-פי טיבה ומאפייניה ולהצביע בהמשך, אף על דרכים למיתונם ואולי אף להסדרתם של קונפליקטים אלו, כולל בדרך של הגדרת שלב סטטוטורי נוסף של שיתוף הציבור טרם הפקדת התכנית.
