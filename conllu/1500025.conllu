# file = txt/1500025.txt
# filelineno = 280
# sentno = 3
# text = מכל מקום יהא אשר יהא היקף הפרשנות המרחיבה לבעל זכות ההתנגדות לפי סעיף 100 הנ"ל, הרי יש גם לתת את הדעת לכך שאין בהכרח זהות בין זכות ההתנגדות בפני מוסדות התכנון או זכות הטיעון בפני רשות מנהלית, לבין זכות העמידה בבית המשפט הגבוה לצדק, או בבית המשפט המנהלי, על אף הקרבה הרבה בין שתי הסוגיות (ראו: יי זמיר הסמכות המנהלית (התשנ״ו, כרך ב) 1 80 ה"ש 23)".
