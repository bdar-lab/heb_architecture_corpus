# text = בהקשר זה יצויין, כי על תיקון חקיקה זה שהביא להקמת הועדה לתשתיות לאומיות הגישה אגודת "אדם טבע ודין״ עתירה לבית המשפט העליון (בג״ץ 4128/02, אדם טבע ודין - אגודה ישראלית להגנת הסביבה נ' ראש ממשלת ישראל ואח', פ״ד נח (3) 503, בטענה, בין השאר, כי אין בפרק הזמן שנקבע להגשת השגה לתכנית (30 יום) כדי לאפשר לימוד התכנית וגיבוש חוות דעת מקצועית לשם הגשת התנגדות, ויש בכך אף פגיעה בכבוד האדם, בשלמות חייו וגופו ובזכות הקניין שלו.
# raw = {'id': 1, 'text': 'בהקשר זה יצויין, כי על תיקון חקיקה זה שהביא להקמת הועדה לתשתיות לאומיות הגישה אגודת "אדם טבע ודין״ עתירה לבית המשפט העליון (בג״ץ 4128/02, אדם טבע ודין - אגודה ישראלית להגנת הסביבה נ\' ראש ממשלת ישראל ואח\', פ״ד נח (3) 503, בטענה, בין השאר, כי אין בפרק הזמן שנקבע להגשת השגה לתכנית (30 יום) כדי לאפשר לימוד התכנית וגיבוש חוות דעת מקצועית לשם הגשת התנגדות, ויש בכך אף פגיעה בכבוד האדם, בשלמות חייו וגופו ובזכות הקניין שלו.', 'dspan': (0, 418), 'tokens': [{'id': (1, 2), 'text': 'בהקשר', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'הקשר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'obl', 'lemma': 'הקשר'}], 'span': (0, 5), 'dspan': (0, 5)}, {'id': 3, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Dem', 'head': 2, 'deprel': 'det', 'dspan': (6, 8), 'span': (6, 8), 'lemma': 'זה'}, {'id': 4, 'text': 'יצויין', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PUAL|Number=Sing|Person=3|Tense=Fut|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (9, 15), 'span': (9, 15), 'lemma': 'יצויין'}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (15, 16), 'span': (15, 16), 'lemma': ','}, {'id': 6, 'text': 'כי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 20, 'deprel': 'mark', 'dspan': (17, 19), 'span': (17, 19), 'lemma': 'כי'}, {'id': 7, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'dspan': (20, 22), 'span': (20, 22), 'lemma': 'על'}, {'id': 8, 'text': 'תיקון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'obl', 'dspan': (23, 28), 'span': (23, 28), 'lemma': 'תיקון'}, {'id': 9, 'text': 'חקיקה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'compound:smixut', 'dspan': (29, 34), 'span': (29, 34), 'lemma'