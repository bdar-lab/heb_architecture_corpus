# file = txt/1500025.txt
# filelineno = 620
# sentno = 1
# text = ■	ביחס לתשתיות תחבורתיות - הרי ששיעור התכניות עם התנגדויות בנושא זה (50.9%) גבוה בשיעור ניכר ביחס להתפלגות הכללית שהתקבלה לכלל אוכלוסיית המחקר (9.6% 2), וממצא זה מייחס "פוטנציאל" התנגדויות גבוה, יחסית, לתכניות שנושאן "תשתיות תחבורתיות".
