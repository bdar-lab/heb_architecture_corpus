# file = txt/1500025.txt
# filelineno = 74
# sentno = 1
# text = במספר מחקרים אשר בוצעו בשנים האחרונות בישראל (ורנסקי, 1994; ורנסקי, אלתרמן, צירצימן, 1994 ; צירצימן, אלתרמן, ורנסקי, 1996 ), פותח מודל טיפולוגי לתיאור נושא הקונפליקטים בתכנון בישראל - וזאת בהתבסס הן על מידע בין-תחומי של חקר הקונפליקט וההתמודדות אתו, והן על ניתוח המאפיינים הארגוניים והמשפטיים של מערכת התכנון הממוסד בישראל.
