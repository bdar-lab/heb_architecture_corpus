# file = txt/1500025.txt
# filelineno = 140
# sentno = 2
# text = כך לדוגמה, נדרש יועץ סביבתי בוועדה הארצית לתכנון ולבניה של תשתיות לאומיות28; ועדה מחוזית רשאית להוועץ בעניין מסויים עם יועץ מקצועי שתקבע, וכן למנות לה יועץ מקצועי של קבע29; כל אימת שהועדה לתשתיות לאומיות או הועדה המחוזית דנה בתכנית שבתחום רשות מקומית, היא חייבת להזמין את מהנדס הרשות המקומית לדיון ולאפשר לו (או לנציגו) להשמיע דברם לפני שתחליט בעניין30, וכן את מגיש התכנית, ככל הניתן 31; תוקם בכל רשות מקומית ועדה לשימור, שתפקידה לייעץ, בין היתר, למועצת הרשות המקומית, לועדה המקומית ולועדה המחוזית בכל עניין הנוגע לשימור אתרים32; נקבע הצורך בהוועצות עם שר הדתות בדבר שמירת מקומות קדושים, ועם שר החינוך והתרבות בדבר שמירה על בנינים או אתרים שיש להם חשיבות הסטורית או ארכיאולוגית33 ועוד.
# raw = {'id': 2, 'text': 'כך לדוגמה, נדרש יועץ סביבתי בוועדה הארצית לתכנון ולבניה של תשתיות לאומיות28; ועדה מחוזית רשאית להוועץ בעניין מסויים עם יועץ מקצועי שתקבע, וכן למנות לה יועץ מקצועי של קבע29; כל אימת שהועדה לתשתיות לאומיות או הועדה המחוזית דנה בתכנית שבתחום רשות מקומית, היא חייבת להזמין את מהנדס הרשות המקומית לדיון ולאפשר לו (או לנציגו) להשמיע דברם לפני שתחליט בעניין30, וכן את מגיש התכנית, ככל הניתן 31; תוקם בכל רשות מקומית ועדה לשימור, שתפקידה לייעץ, בין היתר, למועצת הרשות המקומית, לועדה המקומית ולועדה המחוזית בכל עניין הנוגע לשימור אתרים32; נקבע הצורך בהוועצות עם שר הדתות בדבר שמירת מקומות קדושים, ועם שר החינוך והתרבות בדבר שמירה על בנינים או אתרים שיש להם חשיבות הסטורית או ארכיאולוגית33 ועוד.', 'dspan': (225, 910), 'tokens': [{'id': 1, 'text': 'כך', 'upos': 'ADV', 'xpos': 'ADV', 'head': 5, 'deprel': 'advmod', 'dspan': (225, 227), 'span': (0, 2), 'lemma': 'כך'}, {'id': (2, 3), 'text': 'לדוגמה', 'expanded': [{'id': 2, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'lemma': 'ל'}, {'id': 3, 'text': 'דוגמה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'obl', 'lemma': 'דוגמה'}], 'span': (3, 9), 'dspan': (228, 234)}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (234, 235), 'span': (9, 10), 'lemma': ','}, {'id': 5, 'text': 'נדרש', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (236, 240), 'span': (11, 15), 'lemma': 'נדרש'}, {'id': 6, 'text': 'יועץ', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'nsubj', 'dspan': (241, 245), 'span': (16, 20), 'lemma': 'יועץ'}, {'id': 7, 'text': 'סביבתי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'amod', 'dspan': (246, 252), 'span': (21, 27), 'lemma': 'סביבתי'}, {'id': (8, 9), 'text': 'בוועדה', 'expanded': [{'id': 8, 'text':