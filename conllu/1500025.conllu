# file = txt/1500025.txt
# filelineno = 494
# sentno = 2
# text = המערכת מכילה הן את הנתונים הנוגעים למאפייני התכנית, דוגמת מיקום התכנית (גוש, חלקה, מחוז, תחום ועדה מקומית וכדי), מטרות התכנית (כפי שהוגדרו בהוראות התכנית), זהות בעלי העניין בתכנית (מגיש התכנית, יזם התכנית, בעל הקרקע וכדי), וכן נתונים ביחס להליך הסטטוטורי שהתכנית עברה (תאריכי מעבר משלב לשלב, תאריכי דיונים סטטוטוריים, כולל קישור לפרוטוקול הדיון, פרטי המתנגדים - ככל שהיו, וכדי).
