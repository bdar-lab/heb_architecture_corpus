# file = txt/1500025.txt
# filelineno = 139
# sentno = 2
# text = הסדרים אלו באים לידי ביטוי בהרכב מוסדות התכנון הכולל נציגים מקצועיים כחברים בו (ראו טבלה מס' 1), בשיתוף יועצים מקצועיים, בהליכי הוועצות עם גורמים מקצועיים, בהליך הבדיקה התכנונית המוקדמת טרם דיון בתכנית במוסד התכנון, בתסקירי השפעה על הסביבה ועוד.
