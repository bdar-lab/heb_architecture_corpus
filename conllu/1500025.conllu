# file = txt/1500025.txt
# filelineno = 890
# sentno = 2
# text = כך לדוגמה, ניתן לבחון השערות שונות, דוגמת הקשר בין תכניות אשר עוסקות בחלוקה של "עוגת זכויות" לטענות דוגמת אי-שוויון, קיפוח ואפלייה ועוד; הקשר בין תכנון נקודתי, המציע פתרון אד-הוק שלא על בסיס מדיניות תכנונית כוללת לטענות סביבתיות, חברתיות ומשפטיות הנוגעות לתכנון נקודתי; הקשר בין תכניות המאפשרות גמישות ביחס לפיתרון שימומש לטענות הנוגעות לאי-וודאות , עיכוב מימוש, הפעלת שיקולים זרים, תכנון הנסתר מעיני הציבור וכד'.
