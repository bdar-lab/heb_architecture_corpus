# file = txt/1500025.txt
# filelineno = 853
# sentno = 2
# text = כך לדוגמה, מרבית פתרונות הדיור הקיימים והמבוקשים בישובים שבמרחב העירוני-כפרי הינם צמודי קרקע בצפיפויות שונות בדר״כ131, ולאור רצון התושבים ופרנסי הישוב שלא לשנות את תדמית הישוב, ואולי אף כביטוי לחוסר בביקוש פתרונות דיור החורגים, בישובים אלו, מהקיים והמקובל - לא מוגשות כנראה תכניות רבות המציעות פריצת מסגרת נורמטיבית זו.
