# file = txt/1500025.txt
# filelineno = 745
# sentno = 1
# text = בחינת התפלגות שיעורי השינוי המוצעים בתכנית ביחס לכל אחד ממיקומי התכנית השונים (טבלה מס' 22) מעלה כי בעוד ש 66.7% מהתכניות המציעות שיעור שינוי "קטן" מצויות בתחום ה"עירוני", הולך שיעור זה ופוחת: בשינוי "בינוני" רק 54.3% מהתכניות מצויות בתחום ה"עירוני", ו33.5% בתחום ה"עירוני – כפרי", ובשינוי "קטן" – רק 43.7% מהתכניות מצויות בתחום ה"עירוני", ויתרתן מתחלקת בין התחום ה"כפרי" (28.3%), ו23.0% בתחום ה"עירוני – כפרי".
