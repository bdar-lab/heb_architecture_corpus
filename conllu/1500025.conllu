# file = txt/1500025.txt
# filelineno = 501
# sentno = 2
# text = כך לדוגמה יכול מתנגד לטעון כי התכנית המופקדת עומדת בסתירה להתחייבות כלשהי אשר ניתנה לו מטעם יזמי אותה תכנית או הרשויות, בעוד שלהתחיבויות אלו אין זכר במסמכי התכנית המופקדת, ולא ניתן ללמוד על הימצאותן מעיון במסמכים המופקדים; או אחר הטוען כנגד תנאים למתן תוקף לתכנית, לדוגמה, שנקבעו בעת החלטת מוסד התכנון לעת הפקדתה, ותנאים אלו אינם ניכללים במסגרת מסמכי התכנית המופקדת, אלא רק בהחלטת מוסד התכנון ביחס אליהם, וכדי.
