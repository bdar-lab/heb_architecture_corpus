# file = txt/1500025.txt
# filelineno = 778
# sentno = 1
# text = ■	ביחס למשתנה הבלתי תלוי "יזם התכנית" - הרי שעל-פי מבחני ההתפלגות שנערכו לאוכלוסיית המחקר נמצא כי 93.1% מהן היו ביוזמת פרטיים וועדות תכנון, ורק יתרתן התחלקה בין משרדי וגורמי ממשלה ו"אחר".
