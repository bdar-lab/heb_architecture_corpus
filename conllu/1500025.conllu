# file = txt/1500025.txt
# filelineno = 141
# sentno = 1
# text = עוד יצויין בהקשר זה כי במסגרת הצעת חוק העיריות, התשס"ו-2005, מוצע כי תהה חובה לזמן את מהנדס העיר והיועץ המשפטי שלה לכל ישיבות המועצה ולכל ישיבות הועדות העוסקות בנושאים שבאחריותם, ובישיבות אלו תינתן להם האפשרות להשמיע דעתם, בכתב או בעל פה, לפני קבלת החלטה בכל עניין שבתחום תפקידיהם.
# raw = {'id': 1, 'text': 'עוד יצויין בהקשר זה כי במסגרת הצעת חוק העיריות, התשס"ו-2005, מוצע כי תהה חובה לזמן את מהנדס העיר והיועץ המשפטי שלה לכל ישיבות המועצה ולכל ישיבות הועדות העוסקות בנושאים שבאחריותם, ובישיבות אלו תינתן להם האפשרות להשמיע דעתם, בכתב או בעל פה, לפני קבלת החלטה בכל עניין שבתחום תפקידיהם.', 'dspan': (0, 281), 'tokens': [{'id': 1, 'text': 'עוד', 'upos': 'ADV', 'xpos': 'ADV', 'head': 2, 'deprel': 'advmod', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'עוד'}, {'id': 2, 'text': 'יצויין', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PUAL|Number=Sing|Person=3|Tense=Fut|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (4, 10), 'span': (4, 10), 'lemma': 'יצויין'}, {'id': (3, 4), 'text': 'בהקשר', 'expanded': [{'id': 3, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ב'}, {'id': 4, 'text': 'הקשר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'obl', 'lemma': 'הקשר'}], 'span': (11, 16), 'dspan': (11, 16)}, {'id': 5, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Dem', 'head': 4, 'deprel': 'det', 'dspan': (17, 19), 'span': (17, 19), 'lemma': 'זה'}, {'id': 6, 'text': 'כי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 19, 'deprel': 'mark', 'dspan': (20, 22), 'span': (20, 22), 'lemma': 'כי'}, {'id': (7, 8), 'text': 'במסגרת', 'expanded': [{'id': 7, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ב'}, {'id': 8, 'text': 'מסגרת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'fixed', 'lemma': 'מסגרת'}], 'span': (23, 29), 'dspan': (23, 29)}, {'id': 9, 'text': 'הצעת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 21, 'deprel': 'obl', 'dspan': (30, 34), 'span': (30, 34), 'lemma': 'הצעה'}, {'id': 10, 'text': 'חוק', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 9, 'depre