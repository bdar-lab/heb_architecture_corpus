# file = txt/1500025.txt
# filelineno = 192
# sentno = 1
# text = מאחר שקונפליקטים אלו מתגלים לעיתים במלוא עוצמתם רק לאחר הפקדת התכנית ומתן האפשרות לציבור להגיש התנגדויות (ואף עשויים להחריף בשלב זה) - דרך מרכזית למיתונם באופן יעיל הינה בשילוב הציבור בהליך התכנון טרם הפקדת התכנית, וגיבוש הפתרון התכנוני כבר בשלבים המוקדמים תוך התייחסות לעמדת הציבור ביחס לפתרון המתגבש.
