# file = txt/1500025.txt
# filelineno = 134
# sentno = 3
# text = לדעת ברק-ארז (2000), יש בכך כדי להמחיש את הטיפול הבלתי מספק בשאלת ייצוג הציבור, שהרי הסתפקות בנציגים אלו בלבד משמעותם ייצוג סמלי בלבד, או תת-ייצוג בפועל, וזאת מאחר שנציגים אלו לא נקבעו על רקע בחינה כוללת לנושא הייצוג המשמעותי והמשקף של אוכלוסיות או ציבורים שראוי כי ייוצגו באופן פרטני במוסדות התכנון.
