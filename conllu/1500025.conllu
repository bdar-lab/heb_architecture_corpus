# file = txt/1500025.txt
# filelineno = 851
# sentno = 7
# text = לו דיברנו בחקיקת משנה, כי-אז, דומני, הכרזנו עליה חקיקת משנה בלתי סבירה בעליל ובטלה מעיקרה בהיותה חקיקה הפוגעת בזכויות יסוד של היחיד לחיים במדינה מתוקנת, ואולם הואיל ומדברים אנ1 בחוק של הכנסת, ואין פגיעה לכאורה בזכויות יסוד הקבועות בחוק-סוד: כבוד האדם 1היר1ת1 ובחוק-סוד: חופש העיסוק, נכוף ראשינו וכך נאמר: הסדרי החוק הם בלתי סבירים בעליל , אך מתוך שהפרי צמח על עץ המחוקק הראשי , החוק הוא חוק ומחייב הוא את הכול.
