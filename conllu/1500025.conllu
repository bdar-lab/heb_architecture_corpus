# text = מעבר לכל אלו, נבעה החלטה זו גם מסיבה מעשית: סקר התכניות שנערך במסגרת חיבור זה כלל אוכלוסיית תכניות גדולה יחסית (717 תכנית, לעומת 201 תכניות בסקר של ורנסקי, אלתרמן וצ'רצ'מן, 1986), והוספת משתנים נוספים היתה מרחיבה היקפו של הסקר מעבר להיקף סביר במסגרת חיבור זה.
# raw = {'id': 1, 'text': "מעבר לכל אלו, נבעה החלטה זו גם מסיבה מעשית: סקר התכניות שנערך במסגרת חיבור זה כלל אוכלוסיית תכניות גדולה יחסית (717 תכנית, לעומת 201 תכניות בסקר של ורנסקי, אלתרמן וצ'רצ'מן, 1986), והוספת משתנים נוספים היתה מרחיבה היקפו של הסקר מעבר להיקף סביר במסגרת חיבור זה.", 'dspan': (0, 259), 'tokens': [{'id': 1, 'text': 'מעבר', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'מעבר'}, {'id': (2, 3), 'text': 'לכל', 'expanded': [{'id': 2, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 1, 'deprel': 'fixed', 'lemma': 'ל'}, {'id': 3, 'text': 'כל', 'upos': 'DET', 'xpos': 'DET', 'head': 4, 'deprel': 'det', 'lemma': 'כול'}], 'span': (5, 8), 'dspan': (5, 8)}, {'id': 4, 'text': 'אלו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Plur|Person=3|PronType=Dem', 'head': 6, 'deprel': 'obl', 'dspan': (9, 12), 'span': (9, 12), 'lemma': 'זה'}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (12, 13), 'span': (12, 13), 'lemma': ','}, {'id': 6, 'text': 'נבעה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PAAL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (14, 18), 'span': (14, 18), 'lemma': 'נבע'}, {'id': 7, 'text': 'החלטה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'nsubj', 'dspan': (19, 24), 'span': (19, 24), 'lemma': 'החלטה'}, {'id': 8, 'text': 'זו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Dem', 'head': 7, 'deprel': 'det', 'dspan': (25, 27), 'span': (25, 27), 'lemma': 'זה'}, {'id': 9, 'text': 'גם', 'upos': 'ADV', 'xpos': 'ADV', 'head': 11, 'deprel': 'advmod', 'dspan': (28, 30), 'span': (28, 30), 'lemma': 'גם'}, {'id': (10, 11), 'text': 'מסיבה', 'expanded': [{'id': 10, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'lemma': 'מ'}, {'id': 11, 'text': 'סיבה', 'upos': 'NOUN', 'xpos': 'NOUN'