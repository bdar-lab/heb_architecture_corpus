# file = txt/1500025.txt
# filelineno = 795
# sentno = 2
# text = מאחר שתכנית שבגינה הוגשה התנגדות מחוייבת בהליך סטטוטורי נוסף - של שמיעת המתנגדים והכרעת מוסד התכנון בהתנגדויות, ומאחר שקיים סיכוי רב שהתכנית תשונה בעקבות הליך זה (ולעיתים אף תידחה) - למרות שכבר הגיעה לשלב מתקדם יחסית בהליך האישור הסטטוטורי - קיימת חשיבות והצדקה רבה, הן מבחינת האינטרס הציבורי ובוודאי שמבחינת יזמי התכנית, לנסות להקטין מראש את הקונפליקט התכנוני ולהימנע ככל הניתן ממצב בו מוגשת התנגדות לתכנית.
