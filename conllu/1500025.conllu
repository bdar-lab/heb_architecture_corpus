# file = txt/1500025.txt
# filelineno = 815
# sentno = 1
# text = ■	בנוסף להשערות אלו, הנוגעות בעיקרן לנושא התכנית (תשתיות תחבורתיות) הרי שככל שתכניות מסוג זה מתפרסות על פני שטח גדול יותר - גדל הסיכוי לפגיעה אפשרית כתוצאה מהתכנית, וזאת הן ביחס לבעלי זכויות במקרקעין הכלולים בתכנית,והן ביחס לבעלי מקרקעין בשטחים הגובלים ו/או הסמוכים לתכנית.
