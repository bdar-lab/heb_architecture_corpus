# file = txt/1500025.txt
# filelineno = 475
# sentno = 1
# text = ■	נסיון לאבחן את המחוזות השונים מעלה כי בהכללה, ניתן, לסווג את חלקם כמחוזות "עירוניים" בעיקרם (דוגמת מחוז תל-אביב, חיפה וירושלים) - שעיקר פעילותם מושפעת מהפעילות העירונית המרכזית שבתחומם, וחלקם כמחוזות "אזוריים" (דוגמת מחוז צפון ודרום) - שחלק ניכר מפעילותם התכנונית נוגעת למרחבים הפתוחים על סוגיהם השונים המצויים בתחומם.
