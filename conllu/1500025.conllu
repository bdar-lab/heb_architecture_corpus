# file = txt/1500025.txt
# filelineno = 854
# sentno = 1
# text = ■	הסבר זה תומך בהשערה, לפיה במקום בו נקבעה מדיניות תכנונית כוללת (בתכנון מתארי למשל), ניתן לממש מדיניות זו באופן פרטני, בדרך של הגשת תכניות מפורטות למשל, מבלי שהדבר יהיה כרוך בקונפליקט תכנוני רחב היקף.
