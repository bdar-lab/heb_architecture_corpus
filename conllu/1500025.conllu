# file = txt/1500025.txt
# filelineno = 823
# sentno = 1
# text = ■	קשיים אלו בדרכי אישורן של תכניות שנושאן תשתיות תחבורתיות היזומות על ידי משרדי וגורמי ממשלה עמדו גם לנגד עיני המחוקק128, ועל רקע זה אף בוצעו שני תיקונים מרכזיים בחוק התכנון והבניה לנושא זה: תיקון מספר 37 לחוק התכנון והבניה, משנת 1994, אשר הגדיר סוג מסויים של תכניות כ "תכנית דרך" וייחד הליך נפרד לתכניות מסוג זה, ותיקון מס' 60 לחוק התכנון והבניה, משנת 2002, אשר קבע הסדרים חדשים בכל הנוגע לפרויקטי תשתיות לאומיות, ובכלל זה גם לתשתיות תחבורתיות המהוים פרויקטי תשתית לאומית.
