# file = txt/1500025.txt
# filelineno = 155
# sentno = 1
# text = מעבר לעובדה שבמצב זה עיקר ההסדרים המכתיבים את חייהם של אזרחי המדינה המודרנית אינם יצירי כפיו של הגוף המחוקק, שנבחר על ידי הציבור, אלא של פקידים שלא ניבחרו על ידו - גם הליך קבלת ההחלטות המינהלי אינו הליך מקצועי וניטראלי, הפועל אך למען "אינטרס כלל הציבור", אלא משרת לעיתים אינטרסים ספציפיים של הדרג הפוליטי-מינהלי, של האליטה השלטת, או של קבוצות לחץ כאלו ואחרות.
