# file = txt/1500025.txt
# filelineno = 771
# sentno = 1
# text = ■	מאחר שכל התכניות המשתייכות לחלק זה של אוכלוסיית המחקר מאופיינות בכך שלא הוגשו התנגדויות בגינן - ניתן להניח שככל שתכנית כלשהי תיבחן מראש בעזרת מודל הרגרסיה שהוגדר - וזאת ביחס לפוטנציאל ההתנגדויות הצפוי בגינה -יוכל מודל זה לחזות, בשיעורי הצלחה גבוהים את "פוטנציאל התנגדויות" - ככל שיתברר בהמשך כי אכן לא הוגשה התנגדות בגין תכנית זו.
