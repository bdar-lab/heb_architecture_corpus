# text = לאור העובדה שתכנית הינה דבר חקיקה48, יש בכך כדי להוות דוגמה יוצאת דופן להליך פורמאלי בו מתאפשר לפרט להשפיע על מעשה החקיקה, כאשר השפעה פורמאלית של הפרט על חקיקת הכנסת הינה רק בדרך הבחירות, ואילו ביחס לחקיקת המשנה אין כל דרך פורמלית ישירה לפרט להביע התנגדותו (רויטל, 2006).
# raw = {'id': 3, 'text': 'לאור העובדה שתכנית הינה דבר חקיקה48, יש בכך כדי להוות דוגמה יוצאת דופן להליך פורמאלי בו מתאפשר לפרט להשפיע על מעשה החקיקה, כאשר השפעה פורמאלית של הפרט על חקיקת הכנסת הינה רק בדרך הבחירות, ואילו ביחס לחקיקת המשנה אין כל דרך פורמלית ישירה לפרט להביע התנגדותו (רויטל, 2006).', 'dspan': (393, 664), 'tokens': [{'id': 1, 'text': 'לאור', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'dspan': (393, 397), 'span': (0, 4), 'lemma': 'לאור'}, {'id': (2, 3), 'text': 'העובדה', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'עובדה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 11, 'deprel': 'obl', 'lemma': 'עובדה'}], 'span': (5, 11), 'dspan': (398, 404)}, {'id': (4, 5), 'text': 'שתכנית', 'expanded': [{'id': 4, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 7, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 5, 'text': 'תכנית', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'nsubj', 'lemma': 'תוכנית'}], 'span': (12, 18), 'dspan': (405, 411)}, {'id': 6, 'text': 'הינה', 'upos': 'AUX', 'xpos': 'AUX', 'feats': 'Gender=Fem|Number=Sing|Person=3|Polarity=Pos|VerbForm=Part|VerbType=Cop', 'head': 7, 'deprel': 'cop', 'dspan': (412, 416), 'span': (19, 23), 'lemma': 'הינו'}, {'id': 7, 'text': 'דבר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'acl:relcl', 'dspan': (417, 420), 'span': (24, 27), 'lemma': 'דבר'}, {'id': 8, 'text': 'חקיקה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'compound:smixut', 'dspan': (421, 426), 'span': (28, 33), 'lemma': 'חקיקה'}, {'id': 9, 'text': '48', 'upos': 'NUM', 'xpos': 'NUM', 'head': 8, 'deprel': 'nummod', 'dspan': (426, 428), 'span': (33, 35), 'lemma': '48'}, {'id': 10, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 11, 'deprel': 'punct', 'ds