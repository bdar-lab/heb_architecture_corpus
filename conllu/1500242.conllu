# file = txt/1500242.txt
# filelineno = 370
# sentno = 2
# text = במפה המנטלית הרגילה, הפרשנות והחשיבה שמביאה להחלטה בתת מודע לאחסן ולסדר את המידע והגדרת החלל כמקום, וכמקום שחשוב לו שיחליט על ציונו בעת הכנתו למפה המנטלית האישית שלו לגבי המרחב , קשורה באדם עצמו באופן סובייקטיבי (בר-גל, 2003), אם זה מתוך השפעה של חוויה אישית שעובר האדם במקום מסוים, זיכרון אמוציונאלי ועוד ,Altman & Low)
