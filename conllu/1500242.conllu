# file = txt/1500242.txt
# filelineno = 254
# sentno = 1
# text = לינץ׳ מגדיר את "הרובעים" דרך הייחודיות שלהם המבדילה אותם מסביבתם, אם זה מבחינה צורנית (בניה גבוה או בניה נמוכה), או מבחינת המצב הסוציו-אקונומי של תושבי הרובע, או כל הומוגניות פנימית או מאפיין אחר נתפס, כאשר המילה החשובה המהווה מילת מפתח להגדרתו של לינץ׳ היא תפיסה ופרספציה (1960 ,Lynch).
