# file = txt/1500242.txt
# filelineno = 59
# sentno = 2
# text = מכך מתקבלת התובנה שישנה הרגשה חיובית הקשורה לרוח המקום, אך תובנה נוספת היא שיכולה להיווצר הרגשה שלילית הקשורה עם רוח המקום, לדוגמא, בהגדרתו של רוז, ברגע שמקצים את כל מי שהם לא שייכים ל״אנחנו", יכולה להתפתח ריאקציה שלילית של קבוצת המוקצים לגבי אותו המקום, ובכך נוצרת אצלם הרגשה רעה של רוח המקום, דוגמא נוספת הינה אזורים מסוכנים של פשע, כאשר לקבוצה שגרה שם ומשתייכת לקבוצת "הפשע" יכולה להתפתח תחושה חיובית של רוח המקום, כמקום מוגן, זרים לא נכנסים אליו ועוד, כאשר לגבי אותו המקום נוצרת תחושה שלילית של רוח המקום אצל אנשים שלא שייכת לקבוצה הזו.
