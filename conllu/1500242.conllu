# file = txt/1500242.txt
# filelineno = 379
# sentno = 1
# text = המפה הווירטואלית תכלול כל הנתונים הקיימים בעולם הווירטואלי, למשל מיקום של מסעדה שיש לה פרופיל או עמוד באחת הרשתות החברתיות, או אפילו אתר רגיל, היא אמורה להופיע במיפוי שנוצר מהעולם הווירטואלי, גם אם אנשים לא הולכים למסעדה הזו או שהיא מסעדה במיקום טוב ובטוח, ויתרה מכן, מיפוי כזה עלול להטעות, במקרים רבים, במיוחד במגזר העסקי, מקומות נפתחים ונסגרים לאחר תקופה, אך הם עדיין ממשיכים להתקיים בעולם הווירטואלי, כי להחזיק בעמוד פייסבוק או טוויטר לדוגמא, לא עולה לבעליו כסף.
