# file = txt/1500242.txt
# filelineno = 293
# sentno = 1
# text = ההבדל המשמעותי שנראה בין החודשים נובמבר ופברואר נראה במיפוי "פיש־נט" המפורט ביותר, בגודל תא של 100X100 מ׳, בו רואים איך מצד אחד נחלשות ואף נעלמות חלק מנקודות הציון במפה בחודש פברואר, וזאת בשל היחלשות השיתופים מאותם מקומות, ומצד שני מתהוות נקודות חדשות במקומות אחרים בתוך העיר (איורים 20 ו 21).
