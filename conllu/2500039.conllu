# file = txt/2500039.txt
# filelineno = 252
# sentno = 1
# text = האמולסיה נשפכה על פני הגג בעזרת קופסא מחוברת למקל עץ (תצלום מס' 2) ופוזרה עם מטאטא (תצלום מס* 3)־ לחיצת לוח הברוד לגג נעשית ע״י דריכה, ולפעמים גם ע״י כריעת ברך של הפועל שהניח את הלוחות־ כדי להבטיח הדבקת המישק נמרחה עליו בתחילה אמולסיה־ בהמשך י ועל התהליך בכך שפשוט טבלו את המישק בחומר שנמרח ע"ג התקרה (תצלום מסי 4) הוכחה למלוי המישק היתה בכך שבזמן הלחיצה של הלוח אל הבטון חדרה ועלתה אמולסיה דרך המישק כלפי מעלה ונשארה שם ־ קושי מיוחד היה בהדבקת קצה הלוחות על ה״רולקה"־ רולקה זו נעשית כמובן בעבודה ידנית ולא היתה לשרה־ לכן נדרשו כמויות גדולות של אמולסיה ובכל זאת לא נדבקו הפסים בכל שטחם־
# raw = {'id': 1, 'text': 'האמולסיה נשפכה על פני הגג בעזרת קופסא מחוברת למקל עץ (תצלום מס\' 2) ופוזרה עם מטאטא (תצלום מס* 3)־ לחיצת לוח הברוד לגג נעשית ע״י דריכה, ולפעמים גם ע״י כריעת ברך של הפועל שהניח את הלוחות־ כדי להבטיח הדבקת המישק נמרחה עליו בתחילה אמולסיה־ בהמשך י ועל התהליך בכך שפשוט טבלו את המישק בחומר שנמרח ע"ג התקרה (תצלום מסי 4) הוכחה למלוי המישק היתה בכך שבזמן הלחיצה של הלוח אל הבטון חדרה ועלתה אמולסיה דרך המישק כלפי מעלה ונשארה שם ־ קושי מיוחד היה בהדבקת קצה הלוחות על ה״רולקה"־ רולקה זו נעשית כמובן בעבודה ידנית ולא היתה לשרה־ לכן נדרשו כמויות גדולות של אמולסיה ובכל זאת לא נדבקו הפסים בכל שטחם־', 'dspan': (0, 586), 'tokens': [{'id': (1, 2), 'text': 'האמולסיה', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'אמולסיה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'nsubj', 'lemma': 'אמולסיה'}], 'span': (0, 8), 'dspan': (0, 8)}, {'id': 3, 'text': 'נשפכה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (9, 14), 'span': (9, 14), 'lemma': 'נשפכה'}, {'id': 4, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'dspan': (15, 17), 'span': (15, 17), 'lemma': 'על'}, {'id': 5, 'text': 'פני', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem,Masc|Number=Plur', 'head': 140, 'deprel': 'obl', 'dspan': (18, 21), 'span': (18, 21), 'lemma': 'פנים'}, {'id': (6, 7), 'text': 'הגג', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'גג', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'compound', 'lemma': 'גג'}], 'span': (22, 25), 'dspan': (22, 25)}, {'id': (8, 9), 'text': 'בעזרת', 'expanded': [{'id': 8, 'text': 'ב', 'upos': '