# sentno = 1
# text = בגג הבלתי מבודד נמוכה הטמפרטורה הממוצעת של פני הבטון ב-° 7 מזו של אוויר פנים, זהו גם ההפרש הממוצע בין אויר פנים וחוץ, ההפרש המקסימלי היה 10,5° שזה קצת פחות מההפרש המקסימלי בין אויר חוץ ופנים (12%), בגג מבודד נמדדה הטמפרטורה מעל ללוחות הבדרד ומתחת לחצץ, כאשר הצמד הטרמי מודבק ללוח הנדוד בנקודת מדידה זו היתה הטמפרטורה נמוכה ב- 2° מטמפרטורת אויר חוץ, בימים רגילים היה התחום מ״1° - עד 3° ובמקרה קצוני בודד הגיעה הטמפרטורה ל״4° מתחת לטמפרטורת אדיר החוץ, תופעה זו יכולה לנבוע מקרינה לחלל בלילות בהירים.
# raw = {'id': 1, 'text': 'בגג הבלתי מבודד נמוכה הטמפרטורה הממוצעת של פני הבטון ב-° 7 מזו של אוויר פנים, זהו גם ההפרש הממוצע בין אויר פנים וחוץ, ההפרש המקסימלי היה 10,5° שזה קצת פחות מההפרש המקסימלי בין אויר חוץ ופנים (12%), בגג מבודד נמדדה הטמפרטורה מעל ללוחות הבדרד ומתחת לחצץ, כאשר הצמד הטרמי מודבק ללוח הנדוד בנקודת מדידה זו היתה הטמפרטורה נמוכה ב- 2° מטמפרטורת אויר חוץ, בימים רגילים היה התחום מ״1° - עד 3° ובמקרה קצוני בודד הגיעה הטמפרטורה ל״4° מתחת לטמפרטורת אדיר החוץ, תופעה זו יכולה לנבוע מקרינה לחלל בלילות בהירים.', 'dspan': (0, 497), 'tokens': [{'id': (1, 2), 'text': 'בגג', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'גג', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'obl', 'lemma': 'גג'}], 'span': (0, 3), 'dspan': (0, 3)}, {'id': (3, 4), 'text': 'הבלתי', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'בלתי', 'upos': 'ADV', 'xpos': 'ADV', 'feats': 'Prefix=Yes', 'head': 5, 'deprel': 'compound:affix', 'lemma': 'בלתי'}], 'span': (4, 9), 'dspan': (4, 9)}, {'id': 5, 'text': 'מבודד', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'amod', 'dspan': (10, 15), 'span': (10, 15), 'lemma': 'מבודד'}, {'id': 6, 'text': 'נמוכה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (16, 21), 'span': (16, 21), 'lemma': 'נמוך'}, {'id': (7, 8), 'text': 'הטמפרטורה', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'טמפרטורה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'nsubj', 'lemma': 'טמפרטורה'}], 'span': (22, 31), 'dspan': (22, 31)}, {'id': (9, 10), 'text': 'הממוצעת', 'expanded': [{'id': 9, 'text': 'ה',