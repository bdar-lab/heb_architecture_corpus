# text = יתר על כן, היועץ המישפטי של הוועדה המחוזית שדעתו התקבלה בתוכנית זו כבר לא משמש בתפקידו, והרושם הכללי בעיני המתכננים בת״א, הוא שהנוהג של הענקת תוספת זכויות תמורת מטלות ציבוריות לא ייחשב עוד כנוהג פסול על ידי הוועדה המחוזית (ראיון עם מנהלת תיכנון שוטף בעירייה, ספטמבר 1995).
# raw = {'id': 4, 'text': 'יתר על כן, היועץ המישפטי של הוועדה המחוזית שדעתו התקבלה בתוכנית זו כבר לא משמש בתפקידו, והרושם הכללי בעיני המתכננים בת״א, הוא שהנוהג של הענקת תוספת זכויות תמורת מטלות ציבוריות לא ייחשב עוד כנוהג פסול על ידי הוועדה המחוזית (ראיון עם מנהלת תיכנון שוטף בעירייה, ספטמבר 1995).', 'dspan': (371, 643), 'tokens': [{'id': 1, 'text': 'יתר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 23, 'deprel': 'obl', 'dspan': (371, 374), 'span': (0, 3), 'lemma': 'יתר'}, {'id': 2, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 1, 'deprel': 'fixed', 'dspan': (375, 377), 'span': (4, 6), 'lemma': 'על'}, {'id': 3, 'text': 'כן', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Person=3|PronType=Dem', 'head': 1, 'deprel': 'fixed', 'dspan': (378, 380), 'span': (7, 9), 'lemma': 'כן'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 23, 'deprel': 'punct', 'dspan': (380, 381), 'span': (9, 10), 'lemma': ','}, {'id': (5, 6), 'text': 'היועץ', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'יועץ', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 23, 'deprel': 'nsubj', 'lemma': 'יועץ'}], 'span': (11, 16), 'dspan': (382, 387)}, {'id': (7, 8), 'text': 'המישפטי', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'מישפטי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'amod', 'lemma': 'מישפטי'}], 'span': (17, 24), 'dspan': (388, 395)}, {'id': 9, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 11, 'deprel': 'case:gen', 'dspan': (396, 398), 'span': (25, 27), 'lemma': 'של'}, {'id': (10, 11), 'text': 'הוועדה', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 11, 'deprel': 'det', 'lemma': 'ה'}, {'