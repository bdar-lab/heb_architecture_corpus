# file = txt/2000167.txt
# filelineno = 131
# sentno = 5
# text = בנוגע לרעשי תחבורה היה מקובל לתכנן על פי תקנים זרים, למשל זה של ה - fhwa בארה״ב, כאשר הקריטריון הנהוג היה 67dBA מחוץ לדירה ו־ 62dBA מחוץ למבנים רגישים לרעש (יש לציין שבעוד שהתקן בארא כחשב כמטרה תכנונית, בארה״ב רמת רעש בשיעור 1dBA פחות מהתקן נחשבת כהריגת רעש המחייבת פתרון).
