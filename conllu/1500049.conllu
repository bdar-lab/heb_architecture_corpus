# file = txt/1500049.txt
# filelineno = 92
# sentno = 1
# text = הגוף עשוי להזדקק לשלושה עד עשרה ימים כדי להסתגל למקצב אחר של פעילות ושינה; ותוך כדי כך מתחוללים שינויים לא רק בטמפרטורת הגוף אלא גם בדופק בלחץ הדם, בספירת תאי הדם, בחילוף החומרים, בתפקוד הכליות ובשורה ארוכה של תופעות פיסיולוגיות אחרות (פארקר & פארקר, 1988).
