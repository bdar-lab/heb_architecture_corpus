# file = txt/1200074.txt
# filelineno = 8
# sentno = 5
# text = לאור זאת ניתן לומר כי תוצאות מחקר בשלב זה, למרות חשיבותן והמידע החדש שהן מספקות, מהוות אינדיקציות ראשוניות ובכדי להגיע להמלצות להיתכנות שימוש באגרגט ממוחזר מבטון בבטון של אלמנטים קונסטרוקטיביים נדרשת חקירת המשך בנושא ההידבקות שתכלול בחינה במספר רמות חוזק של בטון בלחיצה ובמתיחה, שימוש באגרגט ממוחזר מבטון ממקורות שונים ובגדלים שונים ובאחוזי החלפה שונים.
