# file = txt/1400007.txt
# filelineno = 48
# sentno = 2
# text = הגברת הידע והמודעות כאמור הינה נדבך חשוב ביכולת לחסוך באנרגיה: ללא ידע באשר לאופן שבו ניתן להפעיל את מערכות הבניין בצורה החסכונית ביותר, וללא מודעות ומחויבות מצד העובדים לחסכון באנרגיה, החסכון באנרגיה בפועל יהיה נמוך יחסית, גם אם המבנה תוכנן כראוי וצויד במערכות המאפשרות חסכון מרבי באנרגיה.
