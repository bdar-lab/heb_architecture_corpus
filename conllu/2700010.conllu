# file = txt/2700010.txt
# filelineno = 28
# sentno = 1
# text = מרכיב של החדר הוא מלבבי־ בין שבי חללי החדר יש לדרוש קשר סמיכות גבוה ביותר על מבת להבטיח הצמדות שבי חלקי החדר־ בהתאם למסקבות הדו"ח מאפריל 1971 הוחלט להשתמש באלגוי־יתם של החלפה בדידה בלבד ולא בהחלפות בסריות, כיון והפתרון האופטימלי בשבי המקריב היה כמעט זהה, ואילו בהחלפה בדידה פשטות התכבסות ה פ ת ר"ן גרמה להוזלה ביכרת במחיר שיש לשלם לשם קבלת הפתרון האופטימלי־ כמר כן בקבע להשאיר כאופציה פתוחה את האפשרות להריץ את התכבית מספר פעמים רצובי, כאשר הבחוש הבקודתי הראשון משתבה בצורה אקראית ומאפשר יציאה במקרה הצורך מפתרון שהוא אופטימום לוקלי־ כן קיימת האפשרות להכתיב את הבחוש הראשון לארגון הפעילויות בצורה רצובית־ כלומר הארכיטקט בובה את הפתרון הטוב ביותר עבור הפרויקט, ומהשלב הב״ל מבסה לשפר את התכבית בעזרת המודל־ בפתרון הבקודתי כבחיבת זמן מחשב וערך הפתרון
