# file = txt/1500209.txt
# filelineno = 736
# sentno = 2
# text = בדומה, גדר בית-הספר היא אמנם אלמנט סטנדרטי המעוגן בהנחיות חוזר מנכ״ל משרד החינוך (2005), אבל ניתוח על-פי המודל העלה כי כל קבוצה מגיבה לאלמנט זה באופן שונה: קבוצות תלמידים בבית-הספר A מתקרבים אל הגדר על מנת ליצור7<א׳קג עם הסביבה (לפירוט ראו סעיף 3.2.3.8 לעיל), בעוד בבית־ הספר C עוטה הקהילה על הגדר יריעה אטומה שנועדה למנוע חדירה של מבטים פנימה אל המרחב הבית-ספרי וזליגה של כוונות ותחושות החוצה (לפירוט ראו סעיף 3.2.3.5 לעיל).
