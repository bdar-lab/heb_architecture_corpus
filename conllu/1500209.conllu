# file = txt/1500209.txt
# filelineno = 159
# sentno = 1
# text = ההיסטוריה של חיפה משקפת גם עם את ההרכב המגוון של אוכלוסייתה ואת הקשר שלה להיסטוריה הישראלית בכלל: עם קום מדינת ישראל ב-1948, לאחר מאבק בין אוכלוסייתה הערבית והיהודית, נטשו רבים מבני האוכלוסייה הערבית את העיר ובמשך תקופה מסוימת התיישבו במקומם עולים יהודים; בשנות ה-60׳ פרצו "מאורעות ואדי סליב" שהפכו ברבות הימים לאחד מסמלי השסע העדתי בישראל; בשנת 1991, בעת מלחמת המפרץ הראשונה, נורו מספר טילים על חיפה; בעת האינתיפאדה השנייה, עם תחילת המאה הנוכחית, ספגה חיפה ארבעה פיגועים גדולים; ובשנת 2006, בעת מלחמת לבנון השנייה, חיפה הייתה שוב יעד לירי טילים מלבנון, מאורע שהשפיע על "תודעת העורף" העירוני במלחמה ושינה אותה באותה תקופה לתודעה של חזית.
