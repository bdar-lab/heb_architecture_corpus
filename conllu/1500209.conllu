# file = txt/1500209.txt
# filelineno = 288
# sentno = 3
# text = גבולות הזמן מתייחסים לזמני הפגישות (אורך המפגשים, מועדם ותכיפותם במהלך השבוע) ולמשך הכללי של חיי הקבוצה; גבולות המקום הפיזי מתייחסים למרחב הפיזי, ול־Setting בכלל, כולל ה״מכל" הדמיוני המסומל על-ידי הכיסאות ואופי החלל על כל המשתמע מכך (צורה, חומר, מרקם, צבע, תאורה, פרופורציות, אביזרים והיחסים בין כל אלה); ואילו גבולות העצמי מתייחסים לאפשרות הניתנת לחברי הקבוצה לחשוף את עצמם על-פי רצונם בהתאם לקודים פנימיים של הקבוצה (בר והרסט, 2010).
