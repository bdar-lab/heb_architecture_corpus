# file = txt/1500209.txt
# filelineno = 683
# sentno = 2
# text = כך למשל תואר כיצד במסדרון הונחו שטיחים צבעוניים ונתלו עבודת יצירה של התלמידים במטרה ליצור אווירה נעימה ותחושת ביתיות (המבטאות נטייה לפתיחות); אולם הקשבה לדברי המנהלת העלתה כי השטיחים גם מקשים על התלמידים לרוץ במסדרונות וכך שומרים על בטיחותם.
