# file = txt/1500209.txt
# filelineno = 327
# sentno = 2
# text = החרדות מופיעות באמצעות החזות והחומריות של האובייקטים במרחב (למשל, גדר בית־הספר כאלמנט מתכתי ורטיקלי רשתי בצבע אפור כסוף); החרדות מתבטאות באמצעות משמעויות הניתנות לאובייקטים אלה (למשל, גדר בית-הספר כמגדירה ומתחמת וזהות, כמשקפת חשש מפני פלישה או זליגה מהמרחב הבית-ספרי, או, במקרים אחרים, כבעלת משמעויות נוספות הקשורות באירועים או מצבים ספציפיים, למשל: כמסמלת את בית־הספר עבור ילד זועם שבועט בגדר וכך עושה בה שימוש שונה ממה שיועדה לו); ולבסוף, החרדות מתממשות בפועל בעת השימוש/ים באובייקטים (למשל, הגדר משמשת בעיקר כדי לתחום את המרחב הפיזי של בית-הספר, אולם לאורכה נעשים בה שימושים מקומיים וספציפיים כמו הצצה דרכה, זריקת כדורי משחק כנגדה, תליית שלטים עליה וכיוצא בזה).
