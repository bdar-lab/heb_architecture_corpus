# file = txt/1500209.txt
# filelineno = 314
# sentno = 1
# text = החוויות החושיות שחווה התינוק עם אמו במסגרת העמדה המגעית־אוטיסטית הן דו־ משמעיות: מן הצד האחד, הטיפול הצמוד והיניקה יוצרים מקצבים משותפים על משטח חושי משותף ואחדותי לאם ולתינוק; מן הצד השני, המגעים הגופניים מחזקים אצל התינוק את תחושת התיחום, אשר יוצרת את התשתית להכרה בנפרדות בין התינוק לאם - הכרה שתלך ותעמיק עם המשך ההתפתחות.
