# file = txt/1500209.txt
# filelineno = 338
# sentno = 2
# text = מנגנוני הגבול והדיאלוג הוזכרו אמנם במהלך סקירת הגישות התיאורטיות בפסיכואנליזה (למשל בסעיף 2.3.2.2 דרך סוגיית גבולות הקבוצה, ובעקיפין בסעיף 2.3.3 דרך סוגיית הפונקציה הנפשית של העור), אולם נוכחותם בלטה יותר בחלק האמפירי של המחקר שהתנהל במקביל וכלל תיעוד, ניתוח אדריכלי, ראיונות עומק ותצפיות ממוקדות בבתי-הספר (ראו בסעיף 1.6 לעיל, וכן בהמשך בפרק 4).
