# file = txt/1500130.txt
# filelineno = 191
# sentno = 3
# text = התקנת הגג הירוק נעשתה בין היתר מתוך תפיסה שפעולה זו עשויה להועיל לשיפור תדמיתה הציבורית של החברה ולשינוי דעת הציבור לגביה: מחברה האחראית באופן ישיר להגדלת זיהום האוויר התחבורת׳ ולפגיעה סביבתית בסמיכות לאזור׳ הייצור בהם היא פועלת, לחברה הפועלת לשיפור תנאי הסביבה ולמזעור הנזקים הסביבתיים הקשורים לתהליכי הייצור שלה.
