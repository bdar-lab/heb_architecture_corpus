# file = txt/1800159.txt
# filelineno = 561
# sentno = 2
# text = מחד גיסא, האוכלוסייה החרדית יכולה להמשיך ולשמר את חיי הקהילה בשכונה בעלת אופי ייחודי התואם את אורחות חייה, ומאידך גיסא, אין מדובר בעיר הומוגנית שמצמצמת את יכולות התעסוקה, אלא בעיר פסיפס המעניקה אפשרויות תעסוקתיות וחינוכיות רחבות יותר, וכן מעורבות רבה יותר של חברי הקהילה החרדית בציבור הישראלי הכללי.
