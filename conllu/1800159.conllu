# text = שלישית, בשונה מהקמת אזורים חדשים הנתקלים בקושי משפטי לשיווקם לאוכלוסייה החרדית (כך למשל שיווק העיר חריש), שיווקן של יחידות דיור באזורים החרדים הקיימים איננו מתמודד עם קושי זה, משום שאזורים אלו "צבועים" כחרדים, ובשל כך קיימת ודאות שוקית שהם יאוכלסו בחרדים.
# raw = {'id': 2, 'text': 'שלישית, בשונה מהקמת אזורים חדשים הנתקלים בקושי משפטי לשיווקם לאוכלוסייה החרדית (כך למשל שיווק העיר חריש), שיווקן של יחידות דיור באזורים החרדים הקיימים איננו מתמודד עם קושי זה, משום שאזורים אלו "צבועים" כחרדים, ובשל כך קיימת ודאות שוקית שהם יאוכלסו בחרדים.', 'dspan': (273, 528), 'tokens': [{'id': 1, 'text': 'שלישית', 'upos': 'ADV', 'xpos': 'ADV', 'head': 41, 'deprel': 'advmod', 'dspan': (273, 279), 'span': (0, 6), 'lemma': 'שלישית'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (279, 280), 'span': (6, 7), 'lemma': ','}, {'id': (3, 4), 'text': 'בשונה', 'expanded': [{'id': 3, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ב'}, {'id': 4, 'text': 'שונה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'fixed', 'lemma': 'שונה'}], 'span': (8, 13), 'dspan': (281, 286)}, {'id': (5, 6), 'text': 'מהקמת', 'expanded': [{'id': 5, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'fixed', 'lemma': 'מ'}, {'id': 6, 'text': 'הקמת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 41, 'deprel': 'obl', 'lemma': 'הקמה'}], 'span': (14, 19), 'dspan': (287, 292)}, {'id': 7, 'text': 'אזורים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 6, 'deprel': 'compound', 'dspan': (293, 299), 'span': (20, 26), 'lemma': 'אזור'}, {'id': 8, 'text': 'חדשים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 7, 'deprel': 'amod', 'dspan': (300, 305), 'span': (27, 32), 'lemma': 'חדש'}, {'id': (9, 10), 'text': 'הנתקלים', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 10, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 10, 'text': 'נתקלים', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Plur|Person=3|Tense=Pres|VerbForm=Part|Voice=Mid', 'head': 7, 'deprel': 'acl:relcl', 'lemma': 'נתקלים'}], 'span': (33