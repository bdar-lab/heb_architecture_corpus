# raw = {'id': 3, 'text': 'לעתים, במהלך העשייה השוטפת במועצות, מתקיים במקביל גם הליך תכנון "מטה-מעלה", שבו צרכים שונים של אוכלוסיית המושבים מועלים על ידי התושבים עצמם, או בתיווך של וועדי המושבים או פעילי שטח מטעם הפרויקט; בעקבות הצרכים שהועלו, מתכנסת וועדת משנה בתחום הרלוונטי, הדנה ומגבשת תכנית פעולה שתספק מענה לצרכים אלה.', 'dspan': (318, 615), 'tokens': [{'id': 1, 'text': 'לעתים', 'upos': 'ADV', 'xpos': 'ADV', 'head': 12, 'deprel': 'advmod', 'dspan': (318, 323), 'span': (0, 5), 'lemma': 'לעתים'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 12, 'deprel': 'punct', 'dspan': (323, 324), 'span': (5, 6), 'lemma': ','}, {'id': (3, 4), 'text': 'במהלך', 'expanded': [{'id': 3, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ב'}, {'id': 4, 'text': 'מהלך', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'fixed', 'lemma': 'מהלך'}], 'span': (7, 12), 'dspan': (325, 330)}, {'id': (5, 6), 'text': 'העשייה', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'עשייה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 12, 'deprel': 'obl', 'lemma': 'עשייה'}], 'span': (13, 19), 'dspan': (331, 337)}, {'id': (7, 8), 'text': 'השוטפת', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'שוטפת', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'amod', 'lemma': 'שוטפת'}], 'span': (20, 26), 'dspan': (338, 344)}, {'id': (9, 10), 'text': 'במועצות', 'expanded': [{'id': 9, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ב'}, {'id': 10, 'text': 'מועצות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 6, 'deprel': 'nmod', 'lemma': 'מועצה'}], 'span': (27, 34), 'dspan': (345, 352)}, {'i