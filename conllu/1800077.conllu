# file = txt/1800077.txt
# filelineno = 635
# sentno = 1
# text = בהינתן כי תחומי העשייה של הפרויקט פרושים על-פני מחלקות ובעלי תפקידים שונים, אשר על-פי רוב אינם עוסקים באופן שוטף בפרויקט, קיימת חשיבות רבה לקיומו של מנהל פרויקט אשר יבצע תכלול ואינטגרציה של כלל העשייה המועצתית בתחום שיקום שכונות חברתי ואשר יתווך כהלכה בין מדיניות הצוות הבין־מוסדי לבין גורמי התכנון והביצוע ברמת המועצה; מתוך כך, עליו להיות בעל יכולת ראייה מערכתית, יכולת בין־אישית גבוהה,יכולת ניהול והאצלת סמכויות.
