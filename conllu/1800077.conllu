# file = txt/1800077.txt
# filelineno = 794
# sentno = 1
# text = במטרה לבחון אלו מבין הגורמים, שצוינו במודל המחקרי כמשפיעים פוטנציאליים על מידת האפקטיביות של הפרויקט בתחומיו השונים (ראה תרשים 1), השפיעו על הערכתם הכללית של בעלי התפקידים בפרויקט את חיוניותו ותרומתו, נעשה ניתוח רגרסיה שהעלה כי מאפייני הפרויקט השונים מסבירים כ-39% מהשונות בהערכתם הכללית של בעלי התפקידים את חיוניותו ותרומתו של הפרויקט במועצות (39=R2), וכי הגורמים המשפיעים ביותר על הערכה זו הנם: מידת היעילות בהקצאת המשאבים והתקציב והתאמתם לצרכי התושבים	.
