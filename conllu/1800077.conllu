# file = txt/1800077.txt
# filelineno = 779
# sentno = 1
# text = כאמור, במודל המחקרי שהוצג בתחילת הדו״ח (ראה תרשים מס׳ 1), צוינו מספר גורמים היכולים להשפיע על תפוקותיו של הפרויקט בתחומים השונים, בהם: אופן יישום ודפוסי פעולה (התאמת היישום למדיניות משרד השיכון, יעילות ניהול התקציב והקצאת המשאבים, ותהליכי בקרה), המבנה בארגוני-מקצועי של הפרויקט במועצות, המאפיינים של בעלי התפקידים בפרויקט (מקצועיות, מעורבות ומחויבות), מידת הקיום של תכניות הפרויקט בתחומים השונים, התאמת התכניות לאוכלוסיות היעד השונות של הפרויקט, והאילוצים ביישום הפרויקט.
