# file = txt/1800077.txt
# filelineno = 770
# sentno = 1
# text = 6.2.3.3.	השוואה ביו הערכות התושבים את תרומת הפרויקט לפיתוח ההון החברתי במועצות השונות במטרה לבחון האם קיים הבדל בהערכת האפקטיביות של התושבים את הפרויקט בתחום פיתוח ההון החברתי בין המועצות האזוריות המשתתפות בפרויקט, נעשו ניתוחי שונות חד-כיווניים ( One Way ANOVAs) שבחנו הבדל זה לגבי כל אחד מבין האספקטים של פיתוח ההון החברתי: פיתוח קהילתי, שיפור התדמית ואיכות החיים במושב, ותפוקות בתחום הבריאות (כאמור, מידת מעורבות התושבים בפרויקט לא נכללה בין ניתוחים השוואתיים אלה).
