# file = txt/1800077.txt
# filelineno = 780
# sentno = 1
# text = במטרה לבחון אלו מבין הגורמים הללו משפיעים על הערכותיהם של בעלי התפקידים במועצות בפרויקט את תפוקותיו בתחום פיתוח ההון החברתי, מעבר לגורמים האחרים, נעשה בתחילה ניתוח רגרסיה בצעדים (Stepwise), שהעלה כי הגורמים המשפיעים על הערכות אלה באופן מובהק הנם זהים לאלו שנמצאו כתורמים ביותר לפיתוח ההון האנושי (ראה סעיף 6.1.3.4), והם: מידת ההתאמה של תכניות הפרויקט לאוכלוסיות היעד שלהם (000.>3= 34, p]) והמבנה המקצועי-מקצועי של הפרויקט
