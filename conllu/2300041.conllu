# file = txt/2300041.txt
# filelineno = 157
# sentno = 2
# text = שכונות שיש בקרבתן שטחי קרקע פנויים מתאימים (כמו בערים הקטנות במרכז הארץ ובערי פיתוח שבפריפריה) רצוי שתשמשנה יעד למשיכת פעילות עסקית ענפה, פעילות של ייצור ו/או שירותים, בהתאם לנסיבות, ובלבד שיתקיימו שלושה תנאים: שתהא זו פעילות שסביר לקיימה בקרבת מגורים, שתהא זו פעילות שיש בה יוקרה (ולא תעשייה מפגרת), ושהתכנון יביא בחשבון מראש הבאת תועלות לא רק ליזמים ולרשות המקומית, אלא גם לתושבים הקבועים במקום, במיוחד התושבים הוותיקים.
