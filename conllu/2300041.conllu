# file = txt/2300041.txt
# filelineno = 61
# sentno = 1
# text = התהליך של השבחת באמצעות תושבים ותיקים הוצג לראשונה על-ידי פיליפ קלי (1979 ,Clay), שהבחין בין הג׳נטריפירים הבאים מן החוץ, לבין מקומיים, שמחליטים להשקיע מאמצעיהם הצנועים בשיפור תנאי המגורים שלהם, ולעתים מצליחים לשכנע אחרים לסייע להם במקצת.
