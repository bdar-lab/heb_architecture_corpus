# file = txt/2300041.txt
# filelineno = 39
# sentno = 2
# text = פרויקט השיקום ותהליכי יישומו מעניינים לא רק את הישראלים, אלא את כל המתעניינים בנושאים של חידוש עירוני ופיתוח קהילתי, וזאת מכמה סיבות: עקרונות הפרויקט מבטאים את מה שהיה מקובל כרצוי ונכון על רבים מאד מן המתכננים בעולם המערבי; הפרויקט נחשב לאחד הגדולים מסוגו בעולם - הוא יושם באופן נרחב והחזיק מעמד שנים רבות (באופן פורמלי, הוא עדיין חי בשנת 1996); הפרויקט בכללו ושכונות הפרויקט שימשו כר נרחב למחקר, וככל הנראה זהו הפרויקט הנחקר ביותר מסוגו במדינות המערב (בקרוב תראה אור ביבליוגרפיה, הכוללת כמה מאות פריטים: כרמון, 1996).
