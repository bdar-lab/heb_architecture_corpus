# raw = {'id': 3, 'text': '׳אור ירוק׳ זה הוא שאפשר לו בחודשים עד יוני 1967 (וביתר שאת לאחריה), לרתום את הידע המקצועי ואת אנשי אמונו ברשות הגנים הלאומיים גם לטיפול בתחומים מוניציפליים מובהקים, כגון טיפוח צדי הדרך של כבישים עירוניים.', 'dspan': (305, 509), 'tokens': [{'id': 1, 'text': '׳', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (305, 306), 'span': (0, 1), 'lemma': '׳'}, {'id': 2, 'text': 'אור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 8, 'deprel': 'dep', 'dspan': (306, 309), 'span': (1, 4), 'lemma': 'אור'}, {'id': 3, 'text': 'ירוק', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'amod', 'dspan': (310, 314), 'span': (5, 9), 'lemma': 'ירוק'}, {'id': 4, 'text': '׳', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (314, 315), 'span': (9, 10), 'lemma': '׳'}, {'id': 5, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3', 'head': 8, 'deprel': 'nsubj', 'dspan': (316, 318), 'span': (11, 13), 'lemma': 'זה'}, {'id': 6, 'text': 'הוא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|Polarity=Pos', 'head': 8, 'deprel': 'cop', 'dspan': (319, 322), 'span': (14, 17), 'lemma': 'הוא'}, {'id': (7, 8), 'text': 'שאפשר', 'expanded': [{'id': 7, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 8, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 8, 'text': 'אפשר', 'upos': 'ADV', 'xpos': 'ADV', 'head': 0, 'deprel': 'root', 'lemma': 'אפשר'}], 'span': (18, 23), 'dspan': (323, 328)}, {'id': (9, 10), 'text': 'לו', 'expanded': [{'id': 9, 'text': 'ל_', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ל'}, {'id': 10, 'text': '_הוא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Prs', 'head': 8, 'deprel': 'obl', 'lemma': 'הוא'}], 'span': (24, 26), 'dspan': (329, 331)}, {'id': (11, 13), 'text': 'בחודשים', 'expanded': [{'id': 11, 'text': 'ב', 'upos': 'AD