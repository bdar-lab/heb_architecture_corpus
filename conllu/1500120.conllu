# text = בין אם מקור ההפרדה הוא אותו "רעיון מבריק" של קולק או רצונו של ינאי לשחרר את המחלקה מכבלי הביורוקרטיה המשרדיים, ולפעול ישירות תחת קולק (לוינסון־וילקוף, 2010), הרי שעצמאות המחלקה וקרבתה למוקדי הכח במשרד ראש הממשלה הן שאפשרו חופש פעולה וגמישות מירבית של השניים לקידום מפעלי התיירות.
# raw = {'id': 2, 'text': 'בין אם מקור ההפרדה הוא אותו "רעיון מבריק" של קולק או רצונו של ינאי לשחרר את המחלקה מכבלי הביורוקרטיה המשרדיים, ולפעול ישירות תחת קולק (לוינסון־וילקוף, 2010), הרי שעצמאות המחלקה וקרבתה למוקדי הכח במשרד ראש הממשלה הן שאפשרו חופש פעולה וגמישות מירבית של השניים לקידום מפעלי התיירות.', 'dspan': (166, 445), 'tokens': [{'id': 1, 'text': 'בין', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'dspan': (166, 169), 'span': (0, 3), 'lemma': 'בין'}, {'id': 2, 'text': 'אם', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 9, 'deprel': 'mark', 'dspan': (170, 172), 'span': (4, 6), 'lemma': 'אם'}, {'id': 3, 'text': 'מקור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 9, 'deprel': 'nsubj:cop', 'dspan': (173, 177), 'span': (7, 11), 'lemma': 'מקור'}, {'id': (4, 5), 'text': 'ההפרדה', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'הפרדה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'compound:smixut', 'lemma': 'הפרדה'}], 'span': (12, 18), 'dspan': (178, 184)}, {'id': 6, 'text': 'הוא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|Polarity=Pos', 'head': 9, 'deprel': 'cop', 'dspan': (185, 188), 'span': (19, 22), 'lemma': 'הוא'}, {'id': 7, 'text': 'אותו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Definite=Def|Gender=Masc|Number=Sing|Person=3|PronType=Prs', 'head': 9, 'deprel': 'det', 'dspan': (189, 193), 'span': (23, 27), 'lemma': 'אותו'}, {'id': 8, 'text': '"', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 9, 'deprel': 'punct', 'dspan': (194, 195), 'span': (28, 29), 'lemma': '"'}, {'id': 9, 'text': 'רעיון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 62, 'deprel': 'advcl', 'dspan': (195, 200), 'span': (29, 34), 'lemma': 'רעיון'}, {'id': 10, 'text': 'מבריק', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Numb