# file = txt/1500120.txt
# filelineno = 569
# sentno = 1
# text = מעשה הקמת הפארק נתפס כ׳הזדמנות היסטורית׳ לא רק על ידי הדמויות המעורבות בהקמתו, כי אם גם בקרב מעגלים מקצועיים וציבוריים רחבים ביותר: על רקע המחלוקת הגיאופוליטית הסוערת באותן שנים, בדבר גורל פיתוח העיר על האדמות הירדניות לשעבר, נתפס הפארק כמעשה א-פוליטי וכמעט כמעשה היחיד "הנכון" שנעשה בירושלים, גם בקרב מבקרים חריפים של המדיניות הישראלית בעיר, כדוגמת בנזימן (ראו עמ׳ 131).
