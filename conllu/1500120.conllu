# file = txt/1500120.txt
# filelineno = 107
# sentno = 4
# text = שני גופים וולונטריים אלה - באמצעות פונקציות שמילאו כזרוע ציבורית מייעצת וכזרוע פיננסית בהתאמה, כמו גם באמצעות אישים שפעלו בהם - יבואו לידי ביטוי גם בשנות הפעילות המאוחרות יותר של רשות הגנים הלאומיים, ובפרט בכל הקשור לתכנון והקמה של הגן הלאומי סובב חומות ירושלים.
