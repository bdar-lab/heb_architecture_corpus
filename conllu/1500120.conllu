# text = שתי זרועות אלה, יחד עם ינאי כראש המחלקה, מהוות למעשה את ראשיתו של מנגנון קולק, אשר בא לידי ביטוי גם בתפקידו כראש העיר ירושלים ופיתוח ירושלים המאוחדת אחרי יוני 1967 : זרוע פיננסית עוקפת תקצוב ממשלתי, זרוע מייעצת-מקצועית וזרוע ביצועית תחת הנהגתו התקיפה של ינאי.
# raw = {'id': 1, 'text': 'שתי זרועות אלה, יחד עם ינאי כראש המחלקה, מהוות למעשה את ראשיתו של מנגנון קולק, אשר בא לידי ביטוי גם בתפקידו כראש העיר ירושלים ופיתוח ירושלים המאוחדת אחרי יוני 1967 : זרוע פיננסית עוקפת תקצוב ממשלתי, זרוע מייעצת-מקצועית וזרוע ביצועית תחת הנהגתו התקיפה של ינאי.', 'dspan': (0, 259), 'tokens': [{'id': 1, 'text': 'שתי', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 2, 'deprel': 'nummod', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'שתי'}, {'id': 2, 'text': 'זרועות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 13, 'deprel': 'nsubj', 'dspan': (4, 10), 'span': (4, 10), 'lemma': 'זרוע'}, {'id': 3, 'text': 'אלה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Plur|Person=3|PronType=Dem', 'head': 2, 'deprel': 'det', 'dspan': (11, 14), 'span': (11, 14), 'lemma': 'זה'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 7, 'deprel': 'punct', 'dspan': (14, 15), 'span': (14, 15), 'lemma': ','}, {'id': 5, 'text': 'יחד', 'upos': 'ADV', 'xpos': 'ADV', 'head': 7, 'deprel': 'case', 'dspan': (16, 19), 'span': (16, 19), 'lemma': 'יחד'}, {'id': 6, 'text': 'עם', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'fixed', 'dspan': (20, 22), 'span': (20, 22), 'lemma': 'עם'}, {'id': 7, 'text': 'ינאי', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 2, 'deprel': 'nmod', 'dspan': (23, 27), 'span': (23, 27), 'lemma': 'ינאי'}, {'id': (8, 9), 'text': 'כראש', 'expanded': [{'id': 8, 'text': 'כ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'כ'}, {'id': 9, 'text': 'ראש', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'nmod', 'lemma': 'ראש'}], 'span': (28, 32), 'dspan': (28, 32)}, {'id': (10, 11), 'text': 'המחלקה', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 11, 'deprel': 'det', 'lemma': 'ה'}, {'id': 11, 'text': 'מחלקה', 'upos': 'NOUN', 'xpos': 'NOUN',