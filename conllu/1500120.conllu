# text = הפרוייקט הלאומי, כפי שנחווה דרך עיניו של הילד דביר וכפי שבחר דביר המבוגר להציגו כיום, התמזג בטבעיות ובאגביות ביומיום של ילדי תל אביב המנדטורית, והוא מוצג דרך אותו מבט נוסטלגי, הומוריסטי המכיל דידקטיות מרומזת, שמאפיין את התערוכה בכללותה.
# raw = {'id': 4, 'text': 'הפרוייקט הלאומי, כפי שנחווה דרך עיניו של הילד דביר וכפי שבחר דביר המבוגר להציגו כיום, התמזג בטבעיות ובאגביות ביומיום של ילדי תל אביב המנדטורית, והוא מוצג דרך אותו מבט נוסטלגי, הומוריסטי המכיל דידקטיות מרומזת, שמאפיין את התערוכה בכללותה.', 'dspan': (638, 874), 'tokens': [{'id': (1, 2), 'text': 'הפרוייקט', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'פרוייקט', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 29, 'deprel': 'nsubj', 'lemma': 'פרוייקט'}], 'span': (0, 8), 'dspan': (638, 646)}, {'id': (3, 4), 'text': 'הלאומי', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'לאומי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'amod', 'lemma': 'לאומי'}], 'span': (9, 15), 'dspan': (647, 653)}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (653, 654), 'span': (15, 16), 'lemma': ','}, {'id': 6, 'text': 'כפי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 8, 'deprel': 'mark', 'dspan': (655, 658), 'span': (17, 20), 'lemma': 'כפי'}, {'id': (7, 8), 'text': 'שנחווה', 'expanded': [{'id': 7, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 6, 'deprel': 'fixed', 'lemma': 'ש'}, {'id': 8, 'text': 'נחווה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 2, 'deprel': 'acl:relcl', 'lemma': 'נחווה'}], 'span': (21, 27), 'dspan': (659, 665)}, {'id': 9, 'text': 'דרך', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'dspan': (666, 669), 'span': (28, 31), 'lemma': 'דרך'}, {'id': (10, 12), 'text': 'עיניו', 'expanded': [{'id': 10, 'text': 'עין_', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Def|Gender=Fem|Number=Plur', 'head': 8, 'deprel': 'obl', 'lemma