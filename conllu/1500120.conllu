# file = txt/1500120.txt
# filelineno = 423
# sentno = 2
# text = איום זה היה ממשי במיוחד משום שתוכנית האב הייתה התוכנית המובילה לפיתוח ירושלים בתקופה שלפני 1967 ובשנים הראשונות לאחר המלחמה (מעמדה החל לדעוך רק בשנות השבעים, ללא שתורגמה לתוכנית בעלת תוקף סטטוטורי, כפי שמתאר עמירב, 2007: 154-158).
