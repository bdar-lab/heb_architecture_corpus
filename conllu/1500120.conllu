# file = txt/1500120.txt
# filelineno = 497
# sentno = 3
# text = 256 דוד קרויאנקר, אולי הדמות המזוהה ביותר עם המחקר האדריכלי הישראלי-ממסדי על ירושלים, הגדיר במבט רטרוספקטיבי את הקמת פארק הטבעת כלא פחות מ״התגשמותו של חלום" מנדטורי, וראה בכך ניצול של "הרגע ההיסטורי" אשר אפשר "להגשים את רעיון הגן הלאומי, משאת נפשם של המתכננים במשך שנים רבות" (קרויאנקר, 1988: 176).
