# file = txt/2700001.txt
# filelineno = 37
# sentno = 3
# text = מבחינה מקרו כלכלית תיווצר במשקים הללו התופעה של חסרונות לגודל (של מפעלים יצרניים) ומגמה ליצירת משקים של 2 מגזרים - מגזר היוצר מקומות תעסוקה ומתמקד בייצור רכיבים לתעשיות שונות, והוא יעיל הרבה פחות, יחסית, ומגזר המפעלים הגדולים המייצר את המכלולים (הרכבה) ומשווקם בשווקים הבינלאומיים, והוא יעיל ממוכן חדשני ומכניס מטבע זר למשק.
