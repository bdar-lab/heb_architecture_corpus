# text = לדשא ולצמחי הכיסוי יש מספר יתרונות נוספים: הם מעכבים את זרימת מי הנגר ואוצרים בתוכם כמות מסוימת של מי גשמים, אשר מצטברים בין העלים ובחללים שבין הצמחים, נאגרים ומחלחלים לאיטם לתוך הקרקע במקום לזרום במהירות אל מחוץ לשטח; הם יוצרים חיפוי על פני הקרקע, המונע מטיפות הגשם להכות ישירות על האדמה ולגרום להידוקה; והם עוזרים בסינון המזהמים המצויים במי הנגר, ועוזרים במניעת חדירתם למאגרי מי התהום.
# raw = {'id': 1, 'text': 'לדשא ולצמחי הכיסוי יש מספר יתרונות נוספים: הם מעכבים את זרימת מי הנגר ואוצרים בתוכם כמות מסוימת של מי גשמים, אשר מצטברים בין העלים ובחללים שבין הצמחים, נאגרים ומחלחלים לאיטם לתוך הקרקע במקום לזרום במהירות אל מחוץ לשטח; הם יוצרים חיפוי על פני הקרקע, המונע מטיפות הגשם להכות ישירות על האדמה ולגרום להידוקה; והם עוזרים בסינון המזהמים המצויים במי הנגר, ועוזרים במניעת חדירתם למאגרי מי התהום.', 'dspan': (0, 387), 'tokens': [{'id': (1, 2), 'text': 'לדשא', 'expanded': [{'id': 1, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Definite=Def|PronType=Art', 'head': 2, 'deprel': 'case', 'lemma': 'ל'}, {'id': 2, 'text': 'דשא', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 8, 'deprel': 'obl', 'lemma': 'דשא'}], 'span': (0, 4), 'dspan': (0, 4)}, {'id': (3, 5), 'text': 'ולצמחי', 'expanded': [{'id': 3, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 5, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 4, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'ל'}, {'id': 5, 'text': 'צמחי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'conj', 'lemma': 'צמח'}], 'span': (5, 11), 'dspan': (5, 11)}, {'id': (6, 7), 'text': 'הכיסוי', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'כיסוי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'compound', 'lemma': 'כיסוי'}], 'span': (12, 18), 'dspan': (12, 18)}, {'id': 8, 'text': 'יש', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Polarity=Pos', 'head': 0, 'deprel': 'root', 'dspan': (19, 21), 'span': (19, 21), 'lemma': 'יש'}, {'id': 9, 'text': 'מספר', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Cons', 'head': 10, 'deprel': 'det', 'dspan': (22, 26), 'span': (22, 26), 'lemma': 'מספר'}, {'id': 10, 'text': 'יתרונות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'G