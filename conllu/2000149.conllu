# file = txt/2000149.txt
# filelineno = 715
# sentno = 4
# text = הוא הניח שפרופיל הקרקע של חצר או גינה במישור החוף מורכב משתי שכבות בעלות עובי של 30 ס״מ, כאשר השכבה העליונה היא חמרה חולית ואילו השכבה התחתונה היא קרקע חולית מהודקת, המועשרת באבק, מלט׳ ושאריות חומרי בניין.
