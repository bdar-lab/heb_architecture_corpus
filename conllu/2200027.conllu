# file = txt/2200027.txt
# filelineno = 244
# sentno = 1
# text = בתחום הארגון והניהול, הבעיות כוללות את הכשרת וכישורי המנהלים עצמם, את מערכות הניהול (נחלים, מערכות המידע, שימוש בכלי ניהול, מערכות ממוחשבות ועוד) ופילוסופיות ניהול המאמצות אחת משתי הדרכים הקיצוניות: התעלמות מוחלטת (הכחשה) מאי הוודאות, המביאה לידי שימוש בשיטות וכלים לא מתאימים, או תפיסה כי הכל לא ודאי ולא אמין באופן מוחלט, המביאה לידי חעדר כל נסיון לתכנון ובקרח שיטתיים, ובמקומם לטיפות חתגובתיות וחאילתור.
