# file = txt/2200027.txt
# filelineno = 146
# sentno = 2
# text = יש להעיר שבעוד ששתי תשובות שונות בשתי פזות עוקבות, עבור אותו משתתף ואותה תוכנית, לכאורה מאמתים את יכולת חמתושאל לבצע הבחנה בין שני שלבים אלה, הרי שאין כך הדבר לגבי שתי תשובות זהות: כאן יתכן שמדובר, אכן, בשתי פזות שונות שקיבלו תשובות זהות, ללא קשר ביניהן, או שתי פזות שנתפסו כאחת, ללא יכולת הבחנה ביניהן.
