# file = txt/2300023.txt
# filelineno = 119
# sentno = 3
# text = האפלייה צורמת גם במישור של ״התרומה הלאומית״: דווקא בין היישובים בפריפריה יש רבים אשר חשים, מן הסתם, שתרמו, מהבחינה הלאומית, יותר מיישובי המרכז בכך שישבו בסמוך לגבולות ובכך שוויתרו במשך שנים רבות על הנאות שונות עקב מיקומם בפריפריה.
