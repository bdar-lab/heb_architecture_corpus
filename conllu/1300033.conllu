# sentno = 3
# text = תהליך מסוג זה התרחש בשלהי שנות ה-70 ותחילת ה-80 במושבות הוותיקות ראשון לציון, רעננה, כפר-סבא ופתח תקוה - שהתפתחותן עד אז היתה בקצב מסחרר, עפ״י תוכניות שאיפשרו בנייה צפופה, ובשלב מאוחר יותר עברו תהליכי הורדת צפיפות מגורים ודיור, צמצום זכויות הבניה והגדלת שטחי ציבור שכונתיים.
