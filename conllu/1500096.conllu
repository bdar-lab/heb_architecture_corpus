# file = txt/1500096.txt
# filelineno = 137
# sentno = 2
# text = קידום האינטראקציה בלמידה המקוונת נבע לא רק מהזמינות הקיימת באינטרנט אלא גם עקב האמונה שרמות גבוהות של אינטראקציה, במיוחד חברתית, יכולות להיות בעלות השפעה חיובית על חווית הלמידה ( ,Woods & Baker 2004).
