# file = txt/2800031.txt
# filelineno = 9
# sentno = 1
# text = המחקר השימושי השיטתי נועד לגבש גישה יסודית יותר לבעיית מיקום הישובים החדשים וכן לאפשר הנהגת שיטות של תכנון פיסי וכלכלי משולב, קביעת גדלים אופטימליים של הישובים והפקת לקחים על "התשומה" הנדרשת לישוב מבחינת הון-השקעה וכוח-אדם.
