# file = txt/1500122.txt
# filelineno = 16
# sentno = 3
# text = הדבר שאולמן כן זוכר הוא שמעולם לא דנו איתו נציגי העירייה על הסרת הפסלים, כאשר פנה אל הממונים על פיסול החוצות בעיר, נאלצו אנשי העירייה להתנצל על פועלם בפניו והציעו לו בו במקום להעביר את הפסלים כמאה מטרים מזרחה משם, מול המגרש הריק בו היה בעבר קולנוע "מוגרבי".
