# text = אדריכל איתי הורביץ, במחקרו "ביטוי הזהות המקומית בנוף העירוני: ראש העין הותיקה כמקרה לדוגמא", טוען כי ניתן לחזק זהות מקומית עלי ידי "מתן ייצוג וביטוי בנוף העירוני, להיבטים של אופי המקום, זיכרונות עבר, קהילה וזהות", אמצעים אלו יהוו על כן "תרומה לסביבה ייחודית ומעניינת, להזדהות וחיבור התושבים למקום, להעצמה אישית וקהילתית, ולאסתטיקה של העיר״ (הורביץ 2006).
# raw = {'id': 5, 'text': 'אדריכל איתי הורביץ, במחקרו "ביטוי הזהות המקומית בנוף העירוני: ראש העין הותיקה כמקרה לדוגמא", טוען כי ניתן לחזק זהות מקומית עלי ידי "מתן ייצוג וביטוי בנוף העירוני, להיבטים של אופי המקום, זיכרונות עבר, קהילה וזהות", אמצעים אלו יהוו על כן "תרומה לסביבה ייחודית ומעניינת, להזדהות וחיבור התושבים למקום, להעצמה אישית וקהילתית, ולאסתטיקה של העיר״ (הורביץ 2006).', 'dspan': (792, 1146), 'tokens': [{'id': 1, 'text': 'אדריכל', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 30, 'deprel': 'nsubj', 'dspan': (792, 798), 'span': (0, 6), 'lemma': 'אדריכל'}, {'id': 2, 'text': 'איתי', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'flat:name', 'dspan': (799, 803), 'span': (7, 11), 'lemma': 'איתי'}, {'id': 3, 'text': 'הורביץ', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'flat:name', 'dspan': (804, 810), 'span': (12, 18), 'lemma': 'הורביץ'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (810, 811), 'span': (18, 19), 'lemma': ','}, {'id': (5, 7), 'text': 'במחקרו', 'expanded': [{'id': 5, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ב'}, {'id': 6, 'text': 'מחקר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 30, 'deprel': 'obl', 'lemma': 'מחקר'}, {'id': 7, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'feats': 'Case=Gen|Definite=Def|Gender=Masc|Number=Sing|Person=3|Poss=Yes|PronType=Prs', 'head': 6, 'deprel': 'nmod:poss', 'lemma': 'ו'}], 'span': (20, 26), 'dspan': (812, 818)}, {'id': 8, 'text': '"', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 9, 'deprel': 'punct', 'dspan': (819, 820), 'span': (27, 28), 'lemma': '"'}, {'id': 9, 'text': 'ביטוי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'appos', 'dspan': (820, 825), 'span': (28, 33), 'lemma': 'ביטוי'}, {'id': (10, 11), 'text': 'הזהות', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': '