# file = txt/1500122.txt
# filelineno = 8
# sentno = 1
# text = הפסל שכמעט המעיד את הקשישה נקרא "יסוד" והוא מהווה חלק מרצף פיסול והנצחה הממוקם בשדרה "התרבותית" של העיר תל-אביב, תחילתו היא באנדרטה למקימי העיר, על גבול שכונת נווה צדק, וסופו של הרצף הוא בפסל "התרוממות" של האמן מנשה קדישמן שהוצב במקום בשנת 1974.
