# file = txt/1500122.txt
# filelineno = 240
# sentno = 3
# text = דרורה דומיני אשר בתהליך ביצוע פסלה ״אביב״ (1989 שד׳ רוטשילד), דרשה לשקם בריכת נוי הסמוכה לפסל, טוענת כי "פיסול חוצות הוא רק גבשושיות במרחב, אבל טובות" ואז מוסיפה כי "פסל יכול להתחיל מגבשושית ולהפוך למקום עליה לרגל".
