# text = נאווה דיסנצ׳יק טוענת כי תפקידה כיועצת ראש העירייה לענייני תרבות ואמנות, הוגדר, ובעצם "הומצא" על ידה, וכמו כן מרבית פיסול החוצות שהופיע בעיר באותה תקופה קשור בעבודתה ("עבודה שלי, עם כל הצניעות")55, כאשר הדבר אשר הביא לריבוי הופעות של פיסול חוצות בעיר באותה תקופה, קשור לנכונותם של מממנים שונים (בעיקר משולם ריקליס), לתרום מכספם עבור הצבת אמנות בעיר.
# raw = {'id': 5, 'text': 'נאווה דיסנצ׳יק טוענת כי תפקידה כיועצת ראש העירייה לענייני תרבות ואמנות, הוגדר, ובעצם "הומצא" על ידה, וכמו כן מרבית פיסול החוצות שהופיע בעיר באותה תקופה קשור בעבודתה ("עבודה שלי, עם כל הצניעות")55, כאשר הדבר אשר הביא לריבוי הופעות של פיסול חוצות בעיר באותה תקופה, קשור לנכונותם של מממנים שונים (בעיקר משולם ריקליס), לתרום מכספם עבור הצבת אמנות בעיר.', 'dspan': (552, 900), 'tokens': [{'id': 1, 'text': 'נאווה', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'nsubj', 'dspan': (552, 557), 'span': (0, 5), 'lemma': 'נאווה'}, {'id': 2, 'text': 'דיסנצ׳יק', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'flat:name', 'dspan': (558, 566), 'span': (6, 14), 'lemma': 'דיסנצ׳יק'}, {'id': 3, 'text': 'טוענת', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PAAL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (567, 572), 'span': (15, 20), 'lemma': 'טען'}, {'id': 4, 'text': 'כי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 19, 'deprel': 'mark', 'dspan': (573, 575), 'span': (21, 23), 'lemma': 'כי'}, {'id': (5, 7), 'text': 'תפקידה', 'expanded': [{'id': 5, 'text': 'תפקיד_', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Def|Gender=Masc|Number=Sing', 'head': 19, 'deprel': 'nsubj', 'lemma': 'תפקיד'}, {'id': 6, 'text': '_של_', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case:gen', 'lemma': 'של'}, {'id': 7, 'text': '_היא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Gender=Fem|Number=Sing|Person=3|PronType=Prs', 'head': 5, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (24, 30), 'dspan': (576, 582)}, {'id': (8, 9), 'text': 'כיועצת', 'expanded': [{'id': 8, 'text': 'כ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'כ'}, {'id': 9, 'text': 'יועצת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'nmod', 'lemma': 'יועץ'}], 'span': (31, 37), 'dspan': (583, 589)}, {'id': 10, 'text': 'ראש', 'upos': 'NOUN', 'xpo