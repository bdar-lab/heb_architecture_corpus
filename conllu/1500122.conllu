# file = txt/1500122.txt
# filelineno = 188
# sentno = 4
# text = בינואר 2006 הוצגה בשדרות רוטשילד תערוכה של שוורים אשר עוצבו על ידי אמנים בתחילת דרכם ונשאו לעיתים מסר פרסומי של חברות בורסאיות שמימנו אותם, ואילו בתערוכה באותו מקום, בחודשים ספטמבר ואוקטובר 2007, שנקראה "שער לעולם" הוצבו מאה גלובוסים שעוצבו באותו האופן.
