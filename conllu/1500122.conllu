# text = בין היצירות הידועות ביותר שהוצבו בעיר באותה תקופה ניתן למנות את "אנדרטת הטייסים" של בנימין תמוז ואבא אלחנני, שהוצבה בגן העצמאות ב-1952 ואת אנדרטת "המייסדים" שכללה תבליט בעיצובם של אהרון פריבר וחנה אורלוף, ואשר הוצבה בשדרות רוטשילד מול בית דיזינגוף ב-1951 (תוכננה החל מ-1949) ביום הולדתו התשעים של ראש העיר הראשון.
# raw = {'id': 6, 'text': 'בין היצירות הידועות ביותר שהוצבו בעיר באותה תקופה ניתן למנות את "אנדרטת הטייסים" של בנימין תמוז ואבא אלחנני, שהוצבה בגן העצמאות ב-1952 ואת אנדרטת "המייסדים" שכללה תבליט בעיצובם של אהרון פריבר וחנה אורלוף, ואשר הוצבה בשדרות רוטשילד מול בית דיזינגוף ב-1951 (תוכננה החל מ-1949) ביום הולדתו התשעים של ראש העיר הראשון.', 'dspan': (548, 861), 'tokens': [{'id': 1, 'text': 'בין', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'dspan': (548, 551), 'span': (0, 3), 'lemma': 'בין'}, {'id': (2, 3), 'text': 'היצירות', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'יצירות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 15, 'deprel': 'obl', 'lemma': 'יצירה'}], 'span': (4, 11), 'dspan': (552, 559)}, {'id': (4, 5), 'text': 'הידועות', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'ידועות', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Plur', 'head': 3, 'deprel': 'amod', 'lemma': 'ידוע'}], 'span': (12, 19), 'dspan': (560, 567)}, {'id': 6, 'text': 'ביותר', 'upos': 'ADV', 'xpos': 'ADV', 'head': 5, 'deprel': 'advmod', 'dspan': (568, 573), 'span': (20, 25), 'lemma': 'ביותר'}, {'id': (7, 8), 'text': 'שהוצבו', 'expanded': [{'id': 7, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 8, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 8, 'text': 'הוצבו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem,Masc|HebBinyan=HUFAL|Number=Plur|Person=3|Tense=Past|Voice=Pass', 'head': 3, 'deprel': 'acl:relcl', 'lemma': 'הוצב'}], 'span': (26, 32), 'dspan': (574, 580)}, {'id': (9, 11), 'text': 'בעיר', 'expanded': [{'id': 9, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'lemma': 'ב'}, {'id': 10, 'text': 'ה_', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 11, 'deprel': 'det', 'le