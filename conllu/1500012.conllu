# file = txt/1500012.txt
# filelineno = 663
# sentno = 1
# text = 1997)	Chernichko) כותב כי כדי למשוך את הקהל הרחב יותר ולעשות את התצוגה מעניינת יותר למבקרים צעירים או ילדים, מוזיאונים רבים משתדלים לארגן את חלל התצוגה עם יצירת אזורים : אזור מנוחה (ישנם מוזיאונים שבעקבות הצפיפות חוסמים את המקום וצופים עייפים עוזבים את המוזיאון מוקדם יותר מאשר תכננו), אזור של תפיסה ומישוש של מוצג במוזיאון (במקרים רבים זה בלתי אפשרי בגלל שמירת האוביקט ובדרך כלל אסור לגעת במוצג, אך אפשרות מישושית יוצרת קשר הדוק עם המוצג), אזור של יצירה (מעניק לא רק חקירה ויזיואלית של המוצג, אלא גם השתתפות אקטיבית בתהליך יצירתי, כמו ציור ועיצוב), אזור של משחק (מפתח כיוונים חדשים ביצוג מסורתי ומסר חינוכי של המוזיאון).
