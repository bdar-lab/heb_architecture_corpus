# file = txt/1500012.txt
# filelineno = 619
# sentno = 2
# text = סביבה אידאלית אינטראקטיבית מגיבה ב"זמן האמת" לקלט של המשתמש ; מאפשרת מידת התאמה בין סוג הקלט של המשתמש לבין סוג תגובה של הסביבה (לחיצה על סדר של מקשים במקלדת כדי לכוון מסך ויזואלי וסיבובי ראש במערכת וירטואלית כדי לראות חלק מתאים של הסביבה) ; מאפשרת למשתמש לראות כל כיוון, לנוע ממקום למקום מעל ומעבר למרחק, להתקדם בכל צעד ובכל רצף הרצוי, לאסוף, להרגיש ולהניע אוביקטים שונים רבים עם טקסטורה שונה, לשנות סוג ועוצמת הקול של צלילי רקע; מספר של קלטים שסביבה מגיבה (קלט קולי/ שמיעתי, קלט מישושי, קלט תנועת הגוף, קלט של הבעת פנים/ תנועת עיניים/ פסיכולוגי), סדר של אירועים בסביבה המוצגת - אירגון מרחבי (מיקום האוביקטים), עוצמה (של קול, בהירות, צבע, תאורה וכוי) ותדירות של המאפינים.
