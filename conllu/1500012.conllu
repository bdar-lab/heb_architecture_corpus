# file = txt/1500012.txt
# filelineno = 577
# sentno = 2
# text = עם מסך לבוש על הראש, המשתתפים קודם חווים את החושך ואחר כך מוצאים את עצמם בתוך מערה "וירטואלית" שבה יצורים שונים - עכביש, פרה, נחש, ודג - היצורים מדברים ומפתים את המבקר לנוע לכיוון מיקומם כפטרוגליפים (petroglyphs) על הקיר של המערה.
