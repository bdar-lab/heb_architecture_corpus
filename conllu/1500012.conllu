# file = txt/1500012.txt
# filelineno = 662
# sentno = 1
# text = 2001) Staniszewski) טוענת כי ארגון מרחבי במוזיאונים תלוי בצורת ארגון החלל במוזיאון, אירגון מרחבי של התצוגה השתנה באופן עיקרוני ויסודי, מהתקופה בה שלט סדר של חדרים רציפים אין סופיים, כאשר הצופה אינו יכול להיחלץ מהם לסדר החדש בו רצף החדרים הוחלף במספר חללים פתוחים וחופשיים לתנועה.
