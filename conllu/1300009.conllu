# file = txt/1300009.txt
# filelineno = 492
# sentno = 2
# text = עם זאת, העברת מקרקעין, מכירתם, מכירת זכות בהם, החלפתם, מישכונם והשכרתם מחויבים באישור הממונה על המחוז במשרד הפנים (סע׳ 11 לפקודה107); ההתקשרות תעשה על ידי ראש המועצה המקומית ובד״כ באישור מועצת הרשות (סע׳ 190 לצו המועצות המקומיות א׳ תשי״א- 1950) ; ואולם החלטה על מכירת מקרקעין או החלפתם טעונה אישור של משרד הפנים ובנוסף, אישור מקדים של רוב חברי המועצה (סע׳ 190א(א) לצו המועצות המקומיות); העברת מקרקעין וטובין, ביצוע עבודות עבור הרשות והזמנת טובין כפופים גם הם לביצוע מכרז (סע׳ 192 לצו המועצות המקומיות); כמו כן קיימת סמכות מסויגת להתקשר
