# file = txt/1900049.txt
# filelineno = 252
# sentno = 1
# text = (ד)	על אף האמור בתקנת משנה (ג), נקבע בתקנות גורמים מאשרים כי לגבי העבודה או הבניין נושא הבקשה להיתר נדרשת חוות דעת של הגורם המאשר לפי סעיף 158כג(ו) לחוק, רשאי מכון הבקרה להגיש דוח ביניים כאמור בתקנת משנה (ג) במועד מאוחר יותר, אם דרש הגורם המאשר בחוות דעתו כאמור את תיקון הבקשה, ובלבד שיגיש את דוח הביניים כאמור לא יאוחר מעשרה ימים לפני תום תקופת בקרת התכן ורשאי עורך הבקשה להגיש בקשה מתוקנת למכון בקרה, אחת או יותר, ובלבד שהבקשה המתוקנת האחרונה, תוגש למכון הבקרה, לא יאוחר מחמישה ימים לפני תום תקופת בקרת התכן.
