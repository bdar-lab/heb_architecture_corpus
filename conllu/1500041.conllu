# file = txt/1500041.txt
# filelineno = 462
# sentno = 4
# text = במגרש המשחקים מתגלה הצבע כגורם עצמאי שאינו מעיד על מהות או איכות, אינו בעל תפקיד קיומי, כפי שקיים בטבע; הצבע מופיע ללא כל התחשבות בנושאים של רגישות העין לאורכי גל שונים; יחסי צבעי הטבע שהעין האנושית הורגלה בהם במהלך האבולוציה; תאום בין מרכיבי הסביבה; השפעתו בהתחשב בגילאי הילדים, השפעתו על קשב וריכוז של הילדים, תהליך הסחת תשומת העין וכתוצאה הבטיחות של הילדים.
