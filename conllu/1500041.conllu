# file = txt/1500041.txt
# filelineno = 746
# sentno = 2
# text = הקבוצה הראשונה והשכיחה ואופיינית של מגרשי המשחקים היא אלה שמאופיינים בצבעוניות אינטנסיבית - הכוללת צבעים רוויים, ניגודי צבע וניגודי בהירות - קבוצה (א) לעיל; והקבוצה השנייה היא קבוצה של מגרשי המשחקים המאופיינת בצבעוניות מופחתת, שצבעיהם הינם מספר צבעים אנלוגיים, לא רוויים, או נעשה שימוש בצבעי טבע, כגון: ירוקים ו/או כחולים ו/או חומים או בעזרת צביעה מונוכרומטית - קבוצה (ג) לעיל.
