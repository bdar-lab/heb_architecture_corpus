# file = txt/1500041.txt
# filelineno = 523
# sentno = 1
# text = הפעילות על המתקנים מלווה בהנאה: מבילוי משותף עם ההורים, חברים; או הנאה מאינטימיות מסוימת ללא התערבות של מבוגרים; הנאה מן הפעילות עצמה; מהרגשת ההצלחה בפעילות חדשה ואתגרית המחזקת את העצמאות של הילד; או מהתגברות על פחד כלשהו המחזקת את הביטחון העצמי של הילד; או מהנאה של לקיחת סיכון כדי לאתגר את המיומנויות שלהם ואת אומץ הלב (בשן-חכם, 2006).
