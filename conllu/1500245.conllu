# file = txt/1500245.txt
# filelineno = 4
# sentno = 4
# text = בניגוד לדעה הרווחת בספרות האקדמית האדריכלית המתייחסת למודרנה כתופעה שהחלה באזור זה בעיקר עם התחלת שלטון המנדט הבריטי, או על ידי התיישבות קולוניאלית אחרת- קרי הטמפלרים או הציונים, מראה מחקר זה כי תהליכים אלו התרחשו מוקדם יותר, על ידי האימפריה העות׳מאנית ועל ידי התושבים המקומיים.
