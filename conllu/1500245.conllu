# file = txt/1500245.txt
# filelineno = 356
# sentno = 16
# text = בניו שהצטרפו לעבוד אתו כבר בגיל צעיר המשיכו את העבודה אחריו ובמהלך השנים שמם קשור בפרויקטים שונים שתכנן שומאכר, כמו המזח מול המושבה הגרמנית, תחנות רכבת בבאר שבע ובעמק יזרעאל, מכלול מבני חקלאות בזיכרון יעקוב עבור פקידי הברון, המבנים החקלאיים של הקונסול הגרמני קלר, מלון במרכז הכרמל עבור פרידריך פרוס, את בית החולים הסקוטי בטבריה (היום "המלון הסקוטי") ועוד.
