# file = txt/1500245.txt
# filelineno = 72
# sentno = 4
# text = לאחר הכשרה מקצועית בהנדסה וארכיטקטורה, חזר ב1885 וזכה במינוי למהנדס מחוז עכו (סנג׳וק עכו) של האימפריה העות׳מאנית, תפקיד זה אפשר לו חופש תנועה במרחב הלבנט, אותו ניצל למיפוי ותיעוד של האזור והאתרים הארכאולוגים בו.
