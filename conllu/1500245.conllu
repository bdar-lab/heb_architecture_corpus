# file = txt/1500245.txt
# filelineno = 13
# sentno = 5
# text = בשל סיבות אידיאולוגיות ורעיונות הקשורים בביסוס הרעיון הציוני והקמתה של מדינת ישראל, התקבעה תפיסה אוריינטליסטית המתארת את חבל הארץ כשומם(Said 2004 1979, Morris), אשר רק הגעתם של קבוצות אירופאיות, כגון הציונים והטמפלרים בסוף התקופה העות׳מאנית, הביאו אליו תהליכים של מודרניזציה ועיור (1996 ,1992 Ben-Artzi ,בן־ארצי 1998, אלכסנדרוביץ׳ 2013), בעוד שהמקומיים המעטים שחיו במרחבי הלבנט באותו זמן נתפשו כחלק מקבוצות לא מפותחות ולא מאורגנות (2011 Bozdogan 2015, Yazbak & Weiss).
