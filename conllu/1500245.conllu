# file = txt/1500245.txt
# filelineno = 256
# sentno = 6
# text = יעקוב מייזלין, שווייצרי שסייר בארץ באמצע המאה ה19 מונה שבעה נמלים חשובים בסוריה, שניים בתחומי פלסטין־ארץ ישראל: יפו וחיפה, מיפו יוצאו לפיו הסחורות ממרכז ודרום הארץ, ומחיפה יוצאו התבואות, בעיקר כותנה ושומשום מהצפון, ומאזור שכם (כרמל 1969).
