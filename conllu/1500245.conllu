# file = txt/1500245.txt
# filelineno = 12
# sentno = 2
# text = חקר המרחב האורבאני והאדריכלי המקומי נוטה עדיין להניח כי התחלת המודרנה בארץ היא תוצר של התרבות המערבית אשר הובאה לכאן מבחוץ בידי מתיישבים מערביים (כמו הטמפלרים והציונים), וביתר שאת עם החלת המנדט הבריטי.
