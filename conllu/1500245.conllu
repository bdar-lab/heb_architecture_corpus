# sentno = 3
# text = מדיווחים של עולי רגל ותיירים אירופאים עולה עדות כי חיפה שתפקדה תחילה כאסם תבואות עורפי לעכו, בעיקר דגנים וכותנה, שהובאו אליה מעמק יזרעאל, ומהחוראן, שירתה את הצבאות שישבו בה ועם התדרדרות עכו לא רק הסחורות קובצו בה, גם הקונסולים הזרים קבעו בה את משכנם (איש־שלום 1956).
