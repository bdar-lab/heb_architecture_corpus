# file = txt/1500245.txt
# filelineno = 143
# sentno = 3
# text = בצילומים ישנים כמו גם בצילומים מהשנים האחרונות ניתן לראות שמודל זה מופיע בקני מידה שונים, מיחידה בודדת, בה קומת מסד לשרות (חנות/ מחסן) בעלת פתח קשתי רחב ומעלייה יחידת דיור בודדת המאופיינת בפתח משולש קשתות, עד וילה גדולת ממדים ורבת חדרים כמו בית מוסטפא פאשה אל ח׳ליל (ראש העיר הרביעי של חיפה, 1903-1885).
