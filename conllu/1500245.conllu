# file = txt/1500245.txt
# filelineno = 94
# sentno = 5
# text = רבאט ואלסייד מראים שהכתיבה האקדמית על האדריכלות האיסלמית מתוך ראית עולם, רציונל ואסתטיקה ויזואלית מערבית פיתחה שתי גישות עקרוניות: האחת פרטיקולארית, בה החוקרים בחנו עיר מסוימת והכילו ממנה אמירות כלליות על האדריכלות המוסלמית, והשנייה אשר בחנה את האדריכלות האיסלמית דרך הפריזמה הסופית, כתפיסה סימבוליסטית טרנסצנדנטלית- אוניברסלית.
