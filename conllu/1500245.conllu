# file = txt/1500245.txt
# filelineno = 275
# sentno = 1
# text = חזית הים נראית בגלויה המתפקדת כפונקטום- בתוך מכלול הצילומים המתארים את העיר, עולה חשיבותה של גלויה זו בשל העובדה שהיא מאששת את עובדת יישום תוכניותיו של שומאכר להקמת מזח מודרני באמצעות יישור קו החוף והרחקתו פנימה אל מי המפרץ על ידי ייבוש רצועת ים, הקמת קיר אנכי לאורך אותה חזית אשר יוצר דירוג וגבול בנוי בין הים ליבשה־ מצד אחד, מעמיק את המים במעגן ומהצד השני יוצר רמה אופקית ישרה המאפשרת סלילת דרך רחבה והקמת מחסני הסחורות בצידה הדרומי.
