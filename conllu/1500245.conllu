# file = txt/1500245.txt
# filelineno = 94
# sentno = 7
# text = ג׳בארין ודביאת ממפים את החוקרים, ומציגים פרדיגמה חדשה של החוקרים הפוסט-אוריינטליסטיים, לפיה הם בוחנים את העיר האסלאמית ובפרט את הערים החדשות על פי מקורות אסלאמיים מודרניים : הפיקה-ספרות משפטית, סיפרי החיסבה-תיאורי השווקים ותיאורים של גיאוגרפים בתקופות שונות, והשריעה- החוק האיסלמי.
