# file = txt/1500245.txt
# filelineno = 269
# sentno = 6
# text = בתוכנית החדשה נוספה בריכת עגינה גדולה על ידי בניית שני שוברי גלים ארוכים-האחד באורך 1,660 מטר, יצא מאזור חיפא אל עתיקה (בת גלים) לכיוון צפון ואחרי 350 מטר יפנה בזווית קהה מזרחה וימשך 1,310 מטר מקביל לחוף, ושובר גלים נוסף, ניצב לקו החוף באורך 430 מטר שבסיסו באזור בית הקברות היווני (כיום דרך העצמאות 120-140).
