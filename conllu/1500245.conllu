# file = txt/1500245.txt
# filelineno = 21
# sentno = 2
# text = כבר בשנות ה40 קמו יוזמות ראשוניות ליצור ארכיון של אדריכלות מקומית לצרכים אקדמיים באקדמיה הראשונה שעסקה באדריכלות בארץ (הטכניון הוקם בחיפה ב1912), אולם רק בשנת 1975 הוקמה "היחידה לתיעוד אדריכלי" בפקולטה לארכיטקטורה ובינוי ערים בטכניון.
