# file = txt/1500245.txt
# filelineno = 366
# sentno = 13
# text = מכיוון שהאריחים באוסף טוני אשקר מאופסנים על פי שטיחי חדרים- בחדר ספציפי אחד שנבדק (לצורך התערוכה ״אדריכלות ערבית, חיפה 1860-1930״, בעת הכנתם וניקויים לשם תצוגה) נמצאו אריחים משלושה מקורות שונים באותו חדר המשלימים את שטיח הבלטות באותה דוגמא - חותמת אחת הייתה של מפעל בדראן שבאב חיפה, השני עם חותמת מדמשק והחותמת השלישית לא הצלחנו, (טוני ואני) לזהות, אולי טמפלרית, מכיוון שהחותמת הייתה באותיות לטיניות אבל לא באיכות מאוד טובה, ויש לחפש חותמות נוספות איכותיות יותר בשביל לפענחה.
