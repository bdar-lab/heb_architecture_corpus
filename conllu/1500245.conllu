# text = אפשר לראות מבצע זה כהרחבה, רעיונית ופיזית, של התוכנית מנדטורית, תכנית יצירת "שדרות ג׳ורג׳ החמישי" של מהנדס העיר ווטסון מ1936, לפתיחת ציר תנועה מרכזי שאמור היה לחצות את העיר ממזרח למערב, ובו בזמן לחסל את ״הסמטאות הצרות והמלוכלכות״ של העיר הישנה (2008 Kolodney & Kallus).
# raw = {'id': 2, 'text': 'אפשר לראות מבצע זה כהרחבה, רעיונית ופיזית, של התוכנית מנדטורית, תכנית יצירת "שדרות ג׳ורג׳ החמישי" של מהנדס העיר ווטסון מ1936, לפתיחת ציר תנועה מרכזי שאמור היה לחצות את העיר ממזרח למערב, ובו בזמן לחסל את ״הסמטאות הצרות והמלוכלכות״ של העיר הישנה (2008 Kolodney & Kallus).', 'dspan': (116, 385), 'tokens': [{'id': 1, 'text': 'אפשר', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'VerbType=Mod', 'head': 0, 'deprel': 'root', 'dspan': (116, 120), 'span': (0, 4), 'lemma': 'אפשר'}, {'id': 2, 'text': 'לראות', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PAAL|VerbForm=Inf|Voice=Act', 'head': 1, 'deprel': 'csubj', 'dspan': (121, 126), 'span': (5, 10), 'lemma': 'ראה'}, {'id': 3, 'text': 'מבצע', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'obj', 'dspan': (127, 131), 'span': (11, 15), 'lemma': 'מבצע'}, {'id': 4, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Dem', 'head': 3, 'deprel': 'det', 'dspan': (132, 134), 'span': (16, 18), 'lemma': 'זה'}, {'id': (5, 6), 'text': 'כהרחבה', 'expanded': [{'id': 5, 'text': 'כ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'כ'}, {'id': 6, 'text': 'הרחבה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'obl', 'lemma': 'הרחבה'}], 'span': (19, 25), 'dspan': (135, 141)}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 8, 'deprel': 'punct', 'dspan': (141, 142), 'span': (25, 26), 'lemma': ','}, {'id': 8, 'text': 'רעיונית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'amod', 'dspan': (143, 150), 'span': (27, 34), 'lemma': 'רעיוני'}, {'id': (9, 10), 'text': 'ופיזית', 'expanded': [{'id': 9, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 10, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 10, 'text': 'פיזית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'conj', 'lemma': 'פיזי'