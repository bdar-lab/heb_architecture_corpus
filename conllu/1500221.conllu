# file = txt/1500221.txt
# filelineno = 286
# sentno = 2
# text = מסגרת זו מבוססת על הגישות התיאורטיות המתייחסות לאינטרס הציבורי - הגישה התועלתנית-תוצאתנית והגישה הנורמטיבית-ערכית, והיא שימשה לניתוח הפרויקט התחבורתי הנבחר כחקר מקרה מעמיק -הרכבת הקלה בירושלים.
