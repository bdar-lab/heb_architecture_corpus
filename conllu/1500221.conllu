# text = "הרכבת הקלה בנויה על ציר שהוא לא באמת הציר של ירושלים... זה קו של ירושלים הלאומית, של העם היהודי - הוא מתחיל מהר הרצל שזו אמירה מאוד לאומית,נוסע דרך רחוב יפו, ממשק על כביש מס' 1 שהיה בזמנו קו הגבול, עובר בכפר חנינא ומסתיים בפסגת זאב״ (י. ס., ממייסדי ארגון צרכני התחבורה הציבורית 15 דקות, כתבה של רוני דורי באתר מאקו באינטרנט, 05/08/2015).
# raw = {'id': 1, 'text': '"הרכבת הקלה בנויה על ציר שהוא לא באמת הציר של ירושלים... זה קו של ירושלים הלאומית, של העם היהודי - הוא מתחיל מהר הרצל שזו אמירה מאוד לאומית,נוסע דרך רחוב יפו, ממשק על כביש מס\' 1 שהיה בזמנו קו הגבול, עובר בכפר חנינא ומסתיים בפסגת זאב״ (י. ס., ממייסדי ארגון צרכני התחבורה הציבורית 15 דקות, כתבה של רוני דורי באתר מאקו באינטרנט, 05/08/2015).', 'dspan': (0, 338), 'tokens': [{'id': 1, 'text': '"', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (0, 1), 'span': (0, 1), 'lemma': '"'}, {'id': (2, 3), 'text': 'הרכבת', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'רכבת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'nsubj:pass', 'lemma': 'רכבת'}], 'span': (1, 6), 'dspan': (1, 6)}, {'id': (4, 5), 'text': 'הקלה', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'קלה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'amod', 'lemma': 'קל'}], 'span': (7, 11), 'dspan': (7, 11)}, {'id': 6, 'text': 'בנויה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PAAL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (12, 17), 'span': (12, 17), 'lemma': 'בנה'}, {'id': 7, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'dspan': (18, 20), 'span': (18, 20), 'lemma': 'על'}, {'id': 8, 'text': 'ציר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'obl', 'dspan': (21, 24), 'span': (21, 24), 'lemma': 'ציר'}, {'id': (9, 10), 'text': 'שהוא', 'expanded': [{'id': 9, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 14, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 10, 'text': 'הוא', 'upos': 'PRON', 'xpos': 'PRON', 'fe