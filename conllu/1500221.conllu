# file = txt/1500221.txt
# filelineno = 553
# sentno = 2
# text = היו כאן שתי פילוסופיות - אחת אומרת בוא נתחיל לתת לחפש שיפויים במשאבים שאין, לחליפין הדרך שבחרנו זה לייצר תנועה, לייצר מאסה של פעילויות בתוך מרכז העיר על מנת להתחיל להחיות את מרכז העיר ולהתחיל להביא לשם תנועה, כי בסוף הסוחר תן לו הנחה כזו או אחרת בארנונה זה בטל בשישים לעומת לייצר תנועה ולייצר לו קופה בסוף היום" (ניר ברקת, ראש עיריית ירושלים, פרוטוקול ישיבת ועדת הכלכלה של הכנסת, 30/03/2011).
