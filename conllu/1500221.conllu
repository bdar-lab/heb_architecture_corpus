# file = txt/1500221.txt
# filelineno = 1099
# sentno = 1
# text = מהתיאוריה הפילוסופית העוסקת במשמעות האינטרס הציבורי במשטר הדמוקרטי עלו שתי גישות דיכוטומיות: האינטרס הציבורי כמצפן ערכי, מוסרי ושיפוטי המכוון החלטות של מדיניות ציבורית מול אינטרס ציבורי שהוא תוצאה של החלטת מדיניות שמיטיבה עם מספר גדול של אנשים ומצדיקה בדיעבד את פעולתה, במובן התועלתני.
