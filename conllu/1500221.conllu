# sentno = 1
# text = "התוכנית הנוכחית לא לקחה בחשבון אפשרות שבאם תוקם הרכבת היא עלולה להוות מוקד משיכה לטרור, שעלול להביא לשיתוקה, ומאחר וכל האלטרנטיבות הנוספות לתחבורה למרכז העיר ייעלמו, במקרה של בעיה ביטחונית תיסגר התנועה למרכז העיר לחלוטין ואין יוצא ואין בא״ (התנגדות מספר 19/03/2002,212).
