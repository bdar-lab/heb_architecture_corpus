# file = txt/1500221.txt
# filelineno = 581
# sentno = 2
# text = אישרנו ועושים את זה בשיתוף הסוחרים אנחנו עוזרים להם בפרסום לעשות 'סטוק-דיי' שיהיה אחת לחודש במרכז העיר... אנחנו מנהלים דיונים עם תושבי מרבז העיר ,זאת אומרת, המנהיגים של מרכז העיר על תפיסת ההפעלה של מרכז... ברגע שנתחיל את השאטל אפילו לפניו נתחיל להפעיל את אותו למידה משותפת וחמ״ל משותף במשך כל יום כדי לראות ולתקן ולשפר בכל יום ביחד עם האנשים, ביחד עם הסוחרים, ביחד עם התושבים את מה שצריך לתקן כדי שהרכבת הזאת שנכנסת תגיע למצב הטוב שלה הכי מהר שאפשר כי תקופה של הפעלה היא תקופה קשה" (יוסי היימן, מנכ״ל עיריית ירושלים, פרוטוקול ישיבת ועדת הכלכלה של הכנסת, 30/03/2011).
