# file = txt/1500221.txt
# filelineno = 977
# sentno = 2
# text = כשמתכננים רשת בלי ניסיון, בלי פרספקטיבה בהיקפים כאלה והולכים לבנות איקס קווים, הדבר הנבון ביזמות קלסית זה להתחיל מהקו הקל, להתגלח על הזקן של המערכת, לצבור ניסיון ולהגיע לקו הכי מסובך ובעייתי עם ניסיון מצטבר גם של המגזר הפרטי וגם של הציבורי... צוברים ניסיון לפני שמגיעים ללב העיר שהוא עורק התחבורה העיקרי" (ניר ברקת, ראש עיריית ירושלים, פרוטוקול ישיבת ועדת הכנסת לביקורת המדינה, 01/06/2009).
