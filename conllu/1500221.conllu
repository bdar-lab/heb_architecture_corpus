# file = txt/1500221.txt
# filelineno = 613
# sentno = 2
# text = בהתנגדותם נטען שהליך קבלת ההחלטות בנוגע לחלופת הגשר לא היה תקין עד כדי עבירה פלילית, מכיוון שלא נבחנו חלופות ראויות לעומקו, לא הוצגו לציבור חלופות ומסמכים המעידים על הליך מסודר, ובכך גם נפגעה זכות ההתנגדות (מכתב שכותרתו ׳הקמת גשר למעבר הרכבת הקלה בכניסה לירושלים עמדת אט״ד׳, מתאריך 07/07/2002).
