# file = txt/1500221.txt
# filelineno = 515
# sentno = 1
# text = ״... בסופו שלדבר, במהלך של 12 שנים, מרכז עיר שממילא רם כך עיריית ירושלים לפני כן דאגה לקבור אותו עם קניונים ועם לבנות כביש בנין בשביל מר עז ריאלי שיבנה לנו עוד קניון, ועוד קניונים בשכונות, דאגה שבמהלך של ה-12 שנים האלה יימחק לגמרי... מרכז העיר זה מרכז כירת מדינת ישראל, תסלחו לק הוא נראה כמו בית שימוש ציבורי אחד גדול" (א. מ., חבר ועד הסוחרים בירושלים, פרוטוקול ישיבת ועדת הכלכלה של הכנסת, 30/03/2011).
