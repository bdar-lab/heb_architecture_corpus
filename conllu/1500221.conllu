# file = txt/1500221.txt
# filelineno = 979
# sentno = 2
# text = בכל העולם אין פרויקטים של תחבורה ציבורית שבהם הכסף ישר מצלצל בקופה,זה פרויקט שעניינו בעיקר הטובה לציבור, ולכן גם בפרויקט עצמו אני ממליץ שהוא לא יהיה נטו הנדסי, כמה יותר מהר, כמה יותר זול, כמה יותר רווחי, אלא שרווחת הציבור סביב תקופת ההקמה וההפעלה יהיו חלק ממרכיבי התכנון של הפרויקט" (יאיר נווה, מנכ״ל סיטיפס, פרוטוקול ישיבת ועדת הכלכלה של הכנסת, 22/06/2009).
