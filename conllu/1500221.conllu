# file = txt/1500221.txt
# filelineno = 793
# sentno = 2
# text = טיעון זה יובא באמצעות פרישה של חמש משפחות של קטגוריות שקודדו בתהליך הניתוח ונוגעות לעיתוי ולשיקולים שהניעו את היציאה לפרויקט; לגורמים האנושיים שהובילו את הפרויקט; לאי־ תקינות תהליך קבלת ההחלטות; ולהקרבת צורכי הציבור, גם אם באופן זמני, לטובת קידומו של הפרויקט.
