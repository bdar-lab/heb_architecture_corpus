# text = ב.	קידום הקו הראשון של הרכבת הקלה, כולל בחירת התוואי באוקטובר 1997, התרחש לפני שהתקבלה החלטת ממשלה להכנת תוכנית המבוססת על טכנולוגיה של רכבת קלה (ביוני 1998), ולפני שהסתיימה בדיקת הכדאיות הכלכלית הראשונה שהמליצה על חלופה זו (בינואר 1998) :
# raw = {'id': 1, 'text': 'ב.\tקידום הקו הראשון של הרכבת הקלה, כולל בחירת התוואי באוקטובר 1997, התרחש לפני שהתקבלה החלטת ממשלה להכנת תוכנית המבוססת על טכנולוגיה של רכבת קלה (ביוני 1998), ולפני שהסתיימה בדיקת הכדאיות הכלכלית הראשונה שהמליצה על חלופה זו (בינואר 1998) :', 'dspan': (0, 239), 'tokens': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 22, 'deprel': 'advmod', 'dspan': (0, 1), 'span': (0, 1), 'lemma': 'ב'}, {'id': 2, 'text': '.', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (1, 2), 'span': (1, 2), 'lemma': '.'}, {'id': 3, 'text': 'קידום', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 22, 'deprel': 'nsubj', 'dspan': (3, 8), 'span': (3, 8), 'lemma': 'קידום'}, {'id': (4, 5), 'text': 'הקו', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'קו', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'compound', 'lemma': 'קו'}], 'span': (9, 12), 'dspan': (9, 12)}, {'id': (6, 7), 'text': 'הראשון', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'ראשון', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'amod', 'lemma': 'ראשון'}], 'span': (13, 19), 'dspan': (13, 19)}, {'id': 8, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 10, 'deprel': 'case', 'dspan': (20, 22), 'span': (20, 22), 'lemma': 'של'}, {'id': (9, 10), 'text': 'הרכבת', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 10, 'deprel': 'det', 'lemma': 'ה'}, {'id': 10, 'text': 'רכבת', 'upos': 'NOUN', 'xpos': 'NOUN', 'head': 5, 'deprel': 'nmod:poss', 'lemma': 'רכבת'}], 'span': (23, 28), 'dspan': (23, 28)}, {'id': (11, 12), 'text': 'הקלה', 'ex