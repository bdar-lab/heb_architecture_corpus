# file = txt/1500221.txt
# filelineno = 423
# sentno = 1
# text = במשך כל הזמן שבו התגבשה התוכנית עד כדי בחירת טכנולוגיה של רכבת קלה (Light - LRT Rail Transit), בחירה באסטרטגיה מימונית ותפעולית של שיתוף הסקטור הפרטי (BOT), ואף תחילת עבודות פיזיות בשטח - ההשפעה היחידה שיכלה להיות לציבור על התוכנית היא בייצוג של הציבור בוועדות התכנון השונות שבהן עברה התוכנית בדרך לאישור.
