# file = txt/1500221.txt
# filelineno = 676
# sentno = 1
# text = הדרישה של מתנגדים מסוג זה היא לפיצוי בגין פגיעות אפשריות ("במידה והתנגדותנו לא תתקבל אנו מבקשים מהוועדה להתנות את העבודה בהתחייבות העירייה לפצות את בעלי העסקים עבור בל הנזקים שהעבודה תגרום", התנגדות מספר 19/3/2002,212), לצמצום השפעות הבנייה וההפעלה ("כיוון שכבר החלטתם להתחיל בהציבה עוד לפני הדיון בהתנגדויות אנו דורשים להקים כבר עכשיו קירות מגן אקוסטיים קבועים״, התנגדות מספר 3/3/2002,210), ואף להטבות ושיפור דירות המגורים על חשבון הרשות המקומית (״... מאד היינו מבקשים שעיריית ירושלים תאפשר לנו להרחיב את הדירות... אף רצוי שהעירייה תבצע בחזית דירותינו 'שיקום שכונות הכולל הוספת חדרים ומרפסות, בחזית יפה ובעלות העירייה עם תוספת מינימלית של הדיירים...״, 25/6/2003).
