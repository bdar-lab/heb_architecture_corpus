# file = txt/1500221.txt
# filelineno = 548
# sentno = 1
# text = "הוועדה קיימה סיור במהלך השבוע... היה סיור לא קל לשמוע סוחרים אחרי עשרות שנים של עשייה ופעילות מסחרית משגשגת לדבריהם, שנקלעו למצב שכבר אין להם חמצן, דברים שלא קרו להם במשך עשרות שנים קורים להם לאחרונה, אנשים שאין להם כבר בסף לקנות סחורה, או שאין להם בסף לשלם תשלומי חובה למדינה או לעירייה" (ח״כ כרמל שאמה, יו״ר הוועדה, פרוטוקול ישיבת ועדת הכלכלה של הכנסת, 30/03/2011).
