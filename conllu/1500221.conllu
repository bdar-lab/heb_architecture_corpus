# text = אדר׳ דוד קרויאנקר, אשר ליווה את תכנון הרכבת הקלה בין השנים 2004־1999 והוציא מספר דוחות המתארים את תהליך קבלת ההחלטות, כותב כי לאחר חתימת הסכמי Wye Plantation בשנת 1998 חלק מהדיונים סביב הרכבת הקלה קיבלו גוון פוליטי-לאומי, ועסקו בשאלת מקומה של הרכבת הקלה במעמדה של ירושלים ובחיזוקה במסגרת המשא-ומתן עם הפלסטינים על עתיד העיר.
# raw = {'id': 1, 'text': 'אדר׳ דוד קרויאנקר, אשר ליווה את תכנון הרכבת הקלה בין השנים 2004־1999 והוציא מספר דוחות המתארים את תהליך קבלת ההחלטות, כותב כי לאחר חתימת הסכמי Wye Plantation בשנת 1998 חלק מהדיונים סביב הרכבת הקלה קיבלו גוון פוליטי-לאומי, ועסקו בשאלת מקומה של הרכבת הקלה במעמדה של ירושלים ובחיזוקה במסגרת המשא-ומתן עם הפלסטינים על עתיד העיר.', 'dspan': (0, 324), 'tokens': [{'id': 1, 'text': 'אדר׳', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 30, 'deprel': 'nsubj', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'אדר׳'}, {'id': 2, 'text': 'דוד', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'flat', 'dspan': (5, 8), 'span': (5, 8), 'lemma': 'דוד'}, {'id': 3, 'text': 'קרויאנקר', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'flat', 'dspan': (9, 17), 'span': (9, 17), 'lemma': 'קרויאנקר'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (17, 18), 'span': (17, 18), 'lemma': ','}, {'id': 5, 'text': 'אשר', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 6, 'deprel': 'mark', 'dspan': (19, 22), 'span': (19, 22), 'lemma': 'אשר'}, {'id': 6, 'text': 'ליווה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PIEL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 1, 'deprel': 'acl:relcl', 'dspan': (23, 28), 'span': (23, 28), 'lemma': 'ליווה'}, {'id': 7, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 8, 'deprel': 'case', 'dspan': (29, 31), 'span': (29, 31), 'lemma': 'את'}, {'id': 8, 'text': 'תכנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'obj', 'dspan': (32, 37), 'span': (32, 37), 'lemma': 'תכנון'}, {'id': (9, 10), 'text': 'הרכבת', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 10, 'deprel': 'det', 'lemma': 'ה'}, {'id': 10, 'text': 'רכבת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'compoun