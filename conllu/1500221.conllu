# text = בכללי המינהל התקין של נציבות שירות המדינה (2013) נכתב כי הכלל בדבר איסור על ניגוד עניינים נובע משני טעמים - מהטעם הפרגמטי, לפיו עובד ציבור חייב להפעיל את סמכותו מתוך שיקולים הנוגעים לסמכות זו ולא משום אינטרסים אחרים; ומהטעם הערכי, לפיו אמון הציבור ניתן למערכות הפועלות בשמו על סמך הידיעה כי החלטות עובדי הציבור נעשות ביושר ובהגינות וכי הן ענייניות ונקיות משיקולים זרים.
# raw = {'id': 1, 'text': 'בכללי המינהל התקין של נציבות שירות המדינה (2013) נכתב כי הכלל בדבר איסור על ניגוד עניינים נובע משני טעמים - מהטעם הפרגמטי, לפיו עובד ציבור חייב להפעיל את סמכותו מתוך שיקולים הנוגעים לסמכות זו ולא משום אינטרסים אחרים; ומהטעם הערכי, לפיו אמון הציבור ניתן למערכות הפועלות בשמו על סמך הידיעה כי החלטות עובדי הציבור נעשות ביושר ובהגינות וכי הן ענייניות ונקיות משיקולים זרים.', 'dspan': (0, 369), 'tokens': [{'id': (1, 2), 'text': 'בכללי', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'כללי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 15, 'deprel': 'obl', 'lemma': 'כלל'}], 'span': (0, 5), 'dspan': (0, 5)}, {'id': (3, 4), 'text': 'המינהל', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'מינהל', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'compound:smixut', 'lemma': 'מנהל'}], 'span': (6, 12), 'dspan': (6, 12)}, {'id': (5, 6), 'text': 'התקין', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'תקין', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'amod', 'lemma': 'תקין'}], 'span': (13, 18), 'dspan': (13, 18)}, {'id': 7, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 8, 'deprel': 'case:gen', 'dspan': (19, 21), 'span': (19, 21), 'lemma': 'של'}, {'id': 8, 'text': 'נציבות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'nmod', 'dspan': (22, 28), 'span': (22, 28), 'lemma': 'נציבות'}, {'id': 9, 'text': 'שירות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 8, 'deprel': 'compound:smixut', 'dspan': (29, 34), 'span': (29, 34