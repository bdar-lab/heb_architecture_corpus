# file = txt/1500221.txt
# filelineno = 865
# sentno = 1
# text = בקטגוריה של ׳אי שמירה על כספי הציבור׳ כללתי את החריגות הגדולות שחלו מאומדן עלויות הפרויקט בתחילת דרכו; את הבעייתיות שהתגלתה בתהליך בדיקת הכדאיות הכלכלית של הפרויקט; ואת סעיפי מענק ההקמה ורשת הביטחון שהוענקו לזכיין בחוזה והכבידו על קופת המדינה הן בפוטנציה והן בפועל (ראו תרשים 9.2 בעמוד 140 לעיל).
