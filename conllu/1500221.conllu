# text = אני חושב שחריגה של 28% (על פי תחשיב של משרד התחבורה, שלא עמד במבחן ביקורת המדינה - צ״צ) בפרויקט שהוא ראשוני בארץ, עם טכנולוגיות לא ידועות, ולא מוכרות, הרבה יותר מובנת מאשר בפרויקט כמו למשל כבישים שבהם יש חריגות שלכאורה יותר פשוט לאמוד את ההוצאות שם... לשיטתנו לא ראינו חריגה כזו גדולה..." (אלכס לנגר, סמנכ״ל מינהל יבשה במשרד התחבורה, פרוטוקול ישיבת ועדת הכנסת לביקורת המדינה, 06/07/2004).
# raw = {'id': 2, 'text': 'אני חושב שחריגה של 28% (על פי תחשיב של משרד התחבורה, שלא עמד במבחן ביקורת המדינה - צ״צ) בפרויקט שהוא ראשוני בארץ, עם טכנולוגיות לא ידועות, ולא מוכרות, הרבה יותר מובנת מאשר בפרויקט כמו למשל כבישים שבהם יש חריגות שלכאורה יותר פשוט לאמוד את ההוצאות שם... לשיטתנו לא ראינו חריגה כזו גדולה..." (אלכס לנגר, סמנכ״ל מינהל יבשה במשרד התחבורה, פרוטוקול ישיבת ועדת הכנסת לביקורת המדינה, 06/07/2004).', 'dspan': (145, 533), 'tokens': [{'id': 1, 'text': 'אני', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem,Masc|Number=Sing|Person=1|PronType=Prs', 'head': 2, 'deprel': 'nsubj', 'dspan': (145, 148), 'span': (0, 3), 'lemma': 'הוא'}, {'id': 2, 'text': 'חושב', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Sing|Person=1|Tense=Pres|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (149, 153), 'span': (4, 8), 'lemma': 'חשב'}, {'id': (3, 4), 'text': 'שחריגה', 'expanded': [{'id': 3, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 46, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 4, 'text': 'חריגה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 46, 'deprel': 'nsubj', 'lemma': 'חריגה'}], 'span': (9, 15), 'dspan': (154, 160)}, {'id': 5, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 6, 'deprel': 'case', 'dspan': (161, 163), 'span': (16, 18), 'lemma': 'של'}, {'id': 6, 'text': '28%', 'upos': 'NUM', 'xpos': 'NUM', 'head': 4, 'deprel': 'nmod:poss', 'dspan': (164, 167), 'span': (19, 22), 'lemma': '28%'}, {'id': 7, 'text': '(', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 10, 'deprel': 'punct', 'dspan': (168, 169), 'span': (23, 24), 'lemma': '('}, {'id': 8, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'dspan': (169, 171), 'span': (24, 26), 'lemma': 'על'}, {'id': 9, 'text': 'פי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 8, 'deprel': 'fixed', 'dspan': (172, 174), 'span': (27, 29), 'lemma': 'פה'}, {'i