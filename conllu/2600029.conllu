# file = txt/2600029.txt
# filelineno = 21
# sentno = 6
# text = נראה הדבר, שאם כי בתחלה תתקן התושבת הכדורית כל אי־מקבילות בין שטחי־העמס של הדגם, יהיה החכוך בתנאי־העמסה גדול מכדי לאפשר כל תנועה נוספת, ואם כתוצאה של ישור לקוי או אסימטריה של מסגרת המכונה יחול בה עוות מסוים, לא תוכל התושבת הכדורית לתקנו ותתפתח חלוקה בלתי שוה של העמס.
