# raw = {'id': 1, 'text': 'בדרך כלל, ישררו במבנה תנאים שבהם הסכוי לגרימת שבר, בהשפעת עמם מסוים ליחידת החתך, גדול יותר מאשר במקרה של קוביה, ומסבה זו עלול להדרש׳ בהתחשב בצורת הקוביה׳ בתנאי האחיזה בקצותיה ובקצב העמסתה׳ מקדם בטחון של 1.5—2; וזאת כתוספת למקדם הדרוש עבור חמר מאיכות נמוכה או יתרת־עמס, או מסבות דומות אפשריות אחרות.', 'dspan': (0, 298), 'tokens': [{'id': (1, 2), 'text': 'בדרך', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'advmod', 'lemma': 'ב'}, {'id': 2, 'text': 'דרך', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'fixed', 'lemma': 'דרך'}], 'span': (0, 4), 'dspan': (0, 4)}, {'id': 3, 'text': 'כלל', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'fixed', 'dspan': (5, 8), 'span': (5, 8), 'lemma': 'כלל'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (8, 9), 'span': (8, 9), 'lemma': ','}, {'id': 5, 'text': 'ישררו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HITPAEL|Number=Plur|Person=3|Tense=Past', 'head': 0, 'deprel': 'root', 'dspan': (10, 15), 'span': (10, 15), 'lemma': 'ישררו'}, {'id': (6, 7), 'text': 'במבנה', 'expanded': [{'id': 6, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'ב'}, {'id': 7, 'text': 'מבנה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'obl', 'lemma': 'מבנה'}], 'span': (16, 21), 'dspan': (16, 21)}, {'id': 8, 'text': 'תנאים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'nsubj', 'dspan': (22, 27), 'span': (22, 27), 'lemma': 'תנאי'}, {'id': (9, 11), 'text': 'שבהם', 'expanded': [{'id': 9, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 11, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 10, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'lemma': 'ב'}, {'id': 11, 'text': 'הם',