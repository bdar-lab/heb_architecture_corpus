# file = txt/1500224.txt
# filelineno = 508
# sentno = 1
# text = מחקר היסטורי, בהמשך למחקר שניוני ומרחבי איפשר הבנה עמוקה יותר של הנעשה באזור היהודי בלודז', שימוש בנדבכים נוספים - חומרים ארכיונים אשר כללו מידע תכנוני, מסמכים רשמיים ואישיים, תמונות וכתבות עיתון - על גבי המחקר המרחבי איפשרו את ראיית הפרטים החסרים בתכניות עיר ובניין ואת הבנת התכניות.
