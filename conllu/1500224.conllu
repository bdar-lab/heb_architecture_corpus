# text = חיי האינטיליגנטים אינם מצטיינים במאומה מחיי כל אחינו בארצות המערב, וחיי כל אלה מתאימים ומקבילים אל חיי הנוצרים האינטילגנטים; כיהודים כנוצרים נושאים את נפשם אל הרעות והשטות, אשר יש או אשר יהיו להן מהלכים בעולם האצילות, ורק לעתים מזמנות יבואו היהודים האינטיליגנטים על כרחם אל עולם היהודים, אך גם אז הם מתנהגים כמתוקנים שבנוצרים... כי לא רק המתים, כ״א גם האינטיליגנטים החיים פטורים מן המצות... אולם לא כן מתנהגים המשכילים הבינונים.
# raw = {'id': 2, 'text': 'חיי האינטיליגנטים אינם מצטיינים במאומה מחיי כל אחינו בארצות המערב, וחיי כל אלה מתאימים ומקבילים אל חיי הנוצרים האינטילגנטים; כיהודים כנוצרים נושאים את נפשם אל הרעות והשטות, אשר יש או אשר יהיו להן מהלכים בעולם האצילות, ורק לעתים מזמנות יבואו היהודים האינטיליגנטים על כרחם אל עולם היהודים, אך גם אז הם מתנהגים כמתוקנים שבנוצרים... כי לא רק המתים, כ״א גם האינטיליגנטים החיים פטורים מן המצות... אולם לא כן מתנהגים המשכילים הבינונים.', 'dspan': (104, 532), 'tokens': [{'id': 1, 'text': 'חיי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'nsubj', 'dspan': (104, 107), 'span': (0, 3), 'lemma': 'חיים'}, {'id': (2, 3), 'text': 'האינטיליגנטים', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'אינטיליגנטים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'compound:smixut', 'lemma': 'אינטיליגנטים'}], 'span': (4, 17), 'dspan': (108, 121)}, {'id': 4, 'text': 'אינם', 'upos': 'AUX', 'xpos': 'AUX', 'feats': 'Gender=Masc|Number=Plur|Person=3|Polarity=Neg|VerbForm=Part|VerbType=Cop', 'head': 5, 'deprel': 'cop', 'dspan': (122, 126), 'span': (18, 22), 'lemma': 'אינו'}, {'id': 5, 'text': 'מצטיינים', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HITPAEL|Number=Plur|Person=1,2,3|VerbForm=Part', 'head': 0, 'deprel': 'root', 'dspan': (127, 135), 'span': (23, 31), 'lemma': 'הצטיין'}, {'id': (6, 7), 'text': 'במאומה', 'expanded': [{'id': 6, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'ב'}, {'id': 7, 'text': 'מאומה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'obl', 'lemma': 'מאומה'}], 'span': (32, 38), 'dspan': (136, 142)}, {'id': (8, 9), 'text': 'מחיי', 'expanded': [{'id': 8, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'מ'}, {'id': 9, 'te