# file = txt/1500224.txt
# filelineno = 465
# sentno = 6
# text = יש ויש מקצעות, אשר היהודי לא ימצא בהם ידיו ורגליו, כמו מלאכת הטויה, מלאכת התקנה והערכה, גם הפעם בגלל קדושת יום השבת, כי בהיות פה כל בתי המטוה וכל בתי התקנה והערכה רק בידי נוצרים ישמר יום הראשון מחללו, וע״כ אין היהודים רואים כל תכלית בלמוד המלאכות האלה, אחרי כי גם אם תמצא להם עבודה כזאת הן לא יזידו לחלל את השבת..." (בן־צבי, המגיד, 25.1.1900)
