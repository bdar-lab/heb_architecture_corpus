# file = txt/1400040.txt
# filelineno = 581
# sentno = 6
# text = מעניין לציין, כי בניגוד למרקמים טבעיים, בהם מדד הרכב שימושי הקרקע נחשב כמשתנה מסביר חזק לתופעות אקולוגיות מסויימות, במרקמים עירוניים ישנה ככל הנראה חשיבות פחותה להיבט זה, שכן משקל שימוש הקרקע למגורים הוא דומיננטי מאד במרקם העירוני ושיעורו הוא לפחות מחצית משטחו.
