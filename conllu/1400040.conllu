# file = txt/1400040.txt
# filelineno = 593
# sentno = 1
# text = אחת הסיבות לשוני זה היא, שבעבודה זו נבדקו צפיפויות ברוטו ונטו עירוניות, בעוד שבמחקרים אחרים נהוג למדוד צפיפויות ברוטו אזוריות או ארציות, הכוללות מגזרי התיישבות צפופים פחות (כמו למשל יישובים כפריים), וכן שטחים מבונים בינעירוניים שאינם משוייכים לרשויות מקומיות.
