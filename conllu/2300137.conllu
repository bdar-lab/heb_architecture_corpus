# file = txt/2300137.txt
# filelineno = 628
# sentno = 1
# text = לעומת זאת התבסס הליך הפנייה לוועדת הערר על סירוב ולק״ח לעניין קרקע חקלאית של המועצה הארצית, והדבר הגביר עוד יותר את ההליך, שהחל עוד בשנות ה-70 והתגבר בשנות ה-80, של שיחרור שטחים מוכרזים על ידי וועדת הערר.
