# file = txt/2300137.txt
# filelineno = 319
# sentno = 1
# text = השופטים רואים בחיוב את הנימוקים התיכנוניים שהציגה המועצה ושהתקבלו על ידי וועדת הערר:..."אלה דברי טעם... ואם כך סברה וועדת הערר, איו אנו סבורים שמתפקידו של בית המשפט זה הוא להיות יותר אפיפיורי מן האפיפיור ולעמוד בכל תוקף על הפעלה קיצונית של עקרון ההגנה על קרקע חקלאית... יש לזכור, שלפי סעיף 12 (ה) ...אין אחרי וועדת הערר ולא כלום... אין להתעלם מרצונו של המחוקק שבנושא זה, יותר מאשר באחרים יכובד שיקול דעתה של הרשות המנהלית"... (השופט לנדוי, עם, 136).
