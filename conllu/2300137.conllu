# file = txt/2300137.txt
# filelineno = 1417
# sentno = 1
# text = (5)	על אף האמור בסעיף 102 לחוק התכנון, המועד להגשת התנגדויות לתכנית, יהיה בתוך 20 ימים מהמועד שבו פורסמה ההודעה בדבר ההפקדה בעתון נפוץ, לפי מועד הפרסום המאוחר מבין הפרסומים בעתונים, והסמכות של הועדה להאריך את המועד להגשת התנגדויות תהיה לתקופה שלא תעלה על 10 ימים נוספים;
