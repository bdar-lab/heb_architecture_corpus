# file = txt/2300137.txt
# filelineno = 1167
# sentno = 1
# text = יש לזכור כי הנתונים שהוצגו בהערכה נותנים אינדיקציה בלבד למידת השגת המטרות המשותפות וכי היו מטרות נוספות (שהוצגו בחלקן בפרק 7) לכל אחד מהחברים בולק"ח, וכי על אף ההיענות לשאלות המנסות לחשוף את מדיניות הולק״ח, יש להניח שהיו מטרות סמויות נוספות שקשה היה לגלותן ולבודדן.
