# file = txt/1800009.txt
# filelineno = 183
# sentno = 2
# text = יש לציין כי בשנת 2013 היה היקף העסקאות גבוה במיוחד (למעלה מ-114 אלף עסקאות), על רקע הקדמת עסקאות עקב החלת שינויים במס שבח החל מ-1 לינואר 2014, וכן בעקבות רכישה מוגברת של דירות חדשות שנכללו במבצעי סיוע (מענק לדירה בפריפריה ומענק ירושלים).
