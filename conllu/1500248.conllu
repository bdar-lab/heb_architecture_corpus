# file = txt/1500248.txt
# filelineno = 174
# sentno = 1
# text = אמנם לא נמצא במחקר זה קיום קשר ממשי חזק בין תחנות רכבת לאזורי תעסוקה באזורים פריפריאליים, אך נוכחנו כי קיימים קשרים בין אזורי תעסוקה המתאפיינים בריבוי חברות עסקים ושכירים כמו גם בעוצמה טכנולוגית גבוהה, עם משתנים כגון: קרבה למוקד אקדמי מוביל, אשר מושך אליו ולאזור בכלל אוכלוסיות המהוות כוח עבודה צעיר בעל ידע ומיומן, וכמו כן קרבה לדרכים ראשיות, שכן יתכן ויוממי אותם אזורי תעסוקה נשענים בעיקר על אמצעי התחבורה הפרטית, במיוחד באזורי פריפריה.
