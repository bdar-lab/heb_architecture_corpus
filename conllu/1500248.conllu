# sentno = 7
# text = הבחירה במחקר זה לבחון את הקשר בין תחנות רכבת לאזורי תעסוקה על בסיס מדד המרחק מבוססת דווקא על התחשבות בממד מרחב המחקר אשר אמנם ממוקד במחוז הצפון כמקרה הבוחן, אך מכליל גם אזורי מחקר נוספים לשם השוואה, כגון מחוזות המרכז, מחוזות הפריפריה בכללותם והמרחב הכלל ארצי - ועל כן מייצר אתגר בבחינת מדדי זמן נסיעת יוממות אשר הינם משתנים התלויים במרחב ובזמן בבחינת שימוש בכלי רכב, באיכות והיקף התחבורה הציבורית ובשעות השיא - ואינם אחידים בין אזורי המחקר השונים ובהתפלגויות העובדים והתעסוקות האופייניים לכל אזור ואזור.
