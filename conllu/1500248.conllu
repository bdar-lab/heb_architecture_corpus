# file = txt/1500248.txt
# filelineno = 93
# sentno = 2
# text = חישוב הרגרסיה התבצע בתוכנת SPSS בין המשתנה התלוי - אחוז התעשייה העילית באזור התעסוקה, לבין המשתנה הבלתי תלוי - מרחק נסיעה מתחנת רכבת קרובה, ובנוסף משתנים בלתי תלויים שהם בעיקרם מאפייני מיקום וסביבה - מספר העסקים הדיירים בא.ת., מספר המועסקים בא.ת., סיווג אזור התעסוקה, מדד סוציו-אקונומי של תחום השיפוט בו ממוקם אזור התעסוקה, גודל אזור התעשייה נטו וברוטו (דונם), מרחק הנסיעה הקצר ביותר מהמרכז המטרופוליני הקרוב, ממרכז אקדמי מוביל ומדרך ראשית על רשת הדרכים.
