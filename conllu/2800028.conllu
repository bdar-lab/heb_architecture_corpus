# text = עובדה זו מלמדת, שהחוסכים-הרוכשים דירות במפעלי השיכון בחסכון - אינם נמנים אך ורק עם האוכלוסייה הוותיקה של הישוב, או עם הקטגוריה של זוגות צעירים או עולים חדשים שקיבלו את הדירות באמצעות המוסדות הקולטים, אלא יש גם "מהאוכלוסיה הצעירה" עולים שהגיעו בשנים 1956-1948, המבקשים להיטיב את תנאי המגורים.
# raw = {'id': 4, 'text': 'עובדה זו מלמדת, שהחוסכים-הרוכשים דירות במפעלי השיכון בחסכון - אינם נמנים אך ורק עם האוכלוסייה הוותיקה של הישוב, או עם הקטגוריה של זוגות צעירים או עולים חדשים שקיבלו את הדירות באמצעות המוסדות הקולטים, אלא יש גם "מהאוכלוסיה הצעירה" עולים שהגיעו בשנים 1956-1948, המבקשים להיטיב את תנאי המגורים.', 'dspan': (400, 691), 'tokens': [{'id': 1, 'text': 'עובדה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'nsubj', 'dspan': (400, 405), 'span': (0, 5), 'lemma': 'עובדה'}, {'id': 2, 'text': 'זו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Dem', 'head': 1, 'deprel': 'det', 'dspan': (406, 408), 'span': (6, 8), 'lemma': 'זה'}, {'id': 3, 'text': 'מלמדת', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PIEL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (409, 414), 'span': (9, 14), 'lemma': 'לימד'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (414, 415), 'span': (14, 15), 'lemma': ','}, {'id': (5, 7), 'text': 'שהחוסכים', 'expanded': [{'id': 5, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 20, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'חוסכים', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Plur|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 20, 'deprel': 'nsubj', 'lemma': 'חסך'}], 'span': (16, 24), 'dspan': (416, 424)}, {'id': 8, 'text': '-', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 10, 'deprel': 'punct', 'dspan': (424, 425), 'span': (24, 25), 'lemma': '-'}, {'id': (9, 10), 'text': 'הרוכשים', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 10, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 10, 'text': 'רוכשים', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Num