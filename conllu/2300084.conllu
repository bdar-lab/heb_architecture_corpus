# text = מאחר ומרבית עיירות הפיתוח מוקמו באזורים פריפריאליים, שאינם מועדפים מצד משקיעים פרטיים, היתה התפתחותן תלויה במידה רבה, במדיניות ציבורית שביטויה בהבטחת תמיכה ממלכתית שעשויה היתה ליצור, באופן מלאכותי, יתרונות מקומיים ברורים ביחס לאזורים במרכז הארץ, שבאופן טבעי מועדפים ע״י אוכלוסיה ומשקיעים (שפר ופרנקל, 1987).
# raw = {'id': 1, 'text': 'מאחר ומרבית עיירות הפיתוח מוקמו באזורים פריפריאליים, שאינם מועדפים מצד משקיעים פרטיים, היתה התפתחותן תלויה במידה רבה, במדיניות ציבורית שביטויה בהבטחת תמיכה ממלכתית שעשויה היתה ליצור, באופן מלאכותי, יתרונות מקומיים ברורים ביחס לאזורים במרכז הארץ, שבאופן טבעי מועדפים ע״י אוכלוסיה ומשקיעים (שפר ופרנקל, 1987).', 'dspan': (0, 307), 'tokens': [{'id': 1, 'text': 'מאחר', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 7, 'deprel': 'mark', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'מאחר'}, {'id': (2, 3), 'text': 'ומרבית', 'expanded': [{'id': 2, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 1, 'deprel': 'fixed', 'lemma': 'ו'}, {'id': 3, 'text': 'מרבית', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Cons', 'head': 4, 'deprel': 'det', 'lemma': 'מרבית'}], 'span': (5, 11), 'dspan': (5, 11)}, {'id': 4, 'text': 'עיירות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 7, 'deprel': 'nsubj', 'dspan': (12, 18), 'span': (12, 18), 'lemma': 'עיירה'}, {'id': (5, 6), 'text': 'הפיתוח', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'פיתוח', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'compound:smixut', 'lemma': 'פיתוח'}], 'span': (19, 25), 'dspan': (19, 25)}, {'id': 7, 'text': 'מוקמו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem,Masc|HebBinyan=PUAL|Number=Plur|Person=3|Tense=Fut|Voice=Pass', 'head': 22, 'deprel': 'advcl', 'dspan': (26, 31), 'span': (26, 31), 'lemma': 'מוקם'}, {'id': (8, 9), 'text': 'באזורים', 'expanded': [{'id': 8, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ב'}, {'id': 9, 'text': 'אזורים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 7, 'deprel': 'obl', 'lemma': 'אזור'}], 'span': (32, 39), 'dspan': (32, 39)}, {'id': 10, 'text': 'פריפריאליים', 'upos': 'ADJ', 'xpos': 'ADJ', 'fea