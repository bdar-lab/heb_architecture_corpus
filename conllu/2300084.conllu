# text = הגדרה אחרת המבטאת את האלמנט הדינמי בהתפתחותם של מוסדות ניתנת ע״י (1981) Schotter, המגדיר מוסדות כמבנים בעלי סדירות בהתנהגות המקובלת על ידי כל הפרטים בחברה, סדירות זו מכתיבה את דפוסי ההתנהגות במצבים ספציפיים החוזרים ונשנים, והנתונים לפיקוח עצמי או חיצוני של סמכות מסוימת.
# raw = {'id': 1, 'text': 'הגדרה אחרת המבטאת את האלמנט הדינמי בהתפתחותם של מוסדות ניתנת ע״י (1981) Schotter, המגדיר מוסדות כמבנים בעלי סדירות בהתנהגות המקובלת על ידי כל הפרטים בחברה, סדירות זו מכתיבה את דפוסי ההתנהגות במצבים ספציפיים החוזרים ונשנים, והנתונים לפיקוח עצמי או חיצוני של סמכות מסוימת.', 'dspan': (0, 270), 'tokens': [{'id': 1, 'text': 'הגדרה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 16, 'deprel': 'nsubj', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'הגדרה'}, {'id': 2, 'text': 'אחרת', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'amod', 'dspan': (6, 10), 'span': (6, 10), 'lemma': 'אחר'}, {'id': (3, 4), 'text': 'המבטאת', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 4, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 4, 'text': 'מבטאת', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=HIFIL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 1, 'deprel': 'acl:relcl', 'lemma': 'ביטא'}], 'span': (11, 17), 'dspan': (11, 17)}, {'id': 5, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 7, 'deprel': 'case:acc', 'dspan': (18, 20), 'span': (18, 20), 'lemma': 'את'}, {'id': (6, 7), 'text': 'האלמנט', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'אלמנט', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'obj', 'lemma': 'אלמנט'}], 'span': (21, 27), 'dspan': (21, 27)}, {'id': (8, 9), 'text': 'הדינמי', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'דינמי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'amod', 'lemma': 'דינמי'}], 'span': (28, 34), 'dspan': (28, 34)}, {'id': (10, 13), 'text': 'בהתפתחותם', 'expanded': [{'id': 10, 'text': 'ב', 'upos