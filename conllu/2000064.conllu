# file = txt/2000064.txt
# filelineno = 352
# sentno = 1
# text = בכל אזור הצפון מתגוררים כ ־ 1,400,000 איש; באות□ שני□ נבנו תשתיות פיזיות של מבנים לתעשיות מתקדמות עם עישות לצירי תחבורה ראשיים; יזמים נעשו מודעים ועישים לגורמי מימון והון סיכון ציבוריים ופרטיים ואלה חיפשו פירמות חדשות בהן להשקיע; מדיניות השלטון המרכזי והמקומי עודדה יזמות טכנולוגית; באזור מצויים מוסדות להשכלה גבוהה בתחומים טכנולוגיים כמו הטכניון בחיפה (מוסד מגובש ומבוסס עם מסורת של יותר מ ־ 80 שנה), אורט בראודה בכרמיאל ואחרים וכן מכוני מחקר טכנולוגיים המכשירים כוח עבודה מיומן מקומי; סביבת המגורים ברכס הכרמל וביישובים הפריפריאליים ידידותית ואיכותית; נוצר מקבץ של תעשיות היי-טק מתוכננות היטב ליד רשת כבישים, רכבות ומחלפים.
