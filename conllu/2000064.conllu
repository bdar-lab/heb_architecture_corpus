# file = txt/2000064.txt
# filelineno = 139
# sentno = 3
# text = מספר נתונים ימחישו את היקף התופעה של ריבוי חברות הזנק באותה תקופה: זרם אדיר של השקעות זרות במיליארדי דולרים לשנה שהגיעו לישראל במחצית השנייה של שנות ה- 90; גידול נמרץ של הייצוא של תעשיות היי-טק; ייסוף השקל כתוצאה מזרם ההשקעות וההכנסות מייצוא; גידול עצום בביקוש לעובדים במקצועות היי־טק; מיליארדי דולרים שזרמו לקופת המדינה כתוצאה מחברות היי-טק משגשגות; אווירת שגשוג בענפי הטכנולוגיה הביא לצמיחה והתחדשות של הכלכלה הישראלית בכללותה (טל, 200a).
