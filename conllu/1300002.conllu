# text = במקרים בהם הדבר בלתי אפשרי, ניסתה המועצה המתכננת, ביחד עם הרשות המוניציפלית, להגן על המערכת ‘הירוקה’ בעזרת מיספר אמצעים: גידול בצפיפויות; הפחתה או שינוי במרכיבים של צורכי ציבור באמצעות שינוי של נורמות פיתוח; ארגון מחדש במרחב של שימושים ציבוריים; שימושים מעורבים; והסדרים כספיים, שעשויים לכלול פיצויים על מנת להגן על מערכת הקרקע הירוקה באמצעות הסכמים מקיפים עם היזמים.
# raw = {'id': 5, 'text': 'במקרים בהם הדבר בלתי אפשרי, ניסתה המועצה המתכננת, ביחד עם הרשות המוניציפלית, להגן על המערכת ‘הירוקה’ בעזרת מיספר אמצעים: גידול בצפיפויות; הפחתה או שינוי במרכיבים של צורכי ציבור באמצעות שינוי של נורמות פיתוח; ארגון מחדש במרחב של שימושים ציבוריים; שימושים מעורבים; והסדרים כספיים, שעשויים לכלול פיצויים על מנת להגן על מערכת הקרקע הירוקה באמצעות הסכמים מקיפים עם היזמים.', 'dspan': (576, 943), 'tokens': [{'id': (1, 2), 'text': 'במקרים', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'מקרים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 10, 'deprel': 'obl', 'lemma': 'מקרה'}], 'span': (0, 6), 'dspan': (576, 582)}, {'id': (3, 4), 'text': 'בהם', 'expanded': [{'id': 3, 'text': 'ב_', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ב'}, {'id': 4, 'text': '_הם', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Plur|Person=3|PronType=Prs', 'head': 8, 'deprel': 'obl', 'lemma': 'הוא'}], 'span': (7, 10), 'dspan': (583, 586)}, {'id': (5, 6), 'text': 'הדבר', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'דבר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 8, 'deprel': 'nsubj', 'lemma': 'דבר'}], 'span': (11, 15), 'dspan': (587, 591)}, {'id': 7, 'text': 'בלתי', 'upos': 'ADV', 'xpos': 'ADV', 'feats': 'Prefix=Yes', 'head': 8, 'deprel': 'compound:affix', 'dspan': (592, 596), 'span': (16, 20), 'lemma': 'בלתי'}, {'id': 8, 'text': 'אפשרי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'acl:relcl', 'dspan': (597, 602), 'span': (21, 26), 'lemma': 'אפשרי'}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 10, 'deprel': 'punct', 'dspan': (602, 603), 'span': (26, 27), 'lemma': ','}, {'id': 10, 'text': 'ניסתה', 'upos': 'VERB', 'xpos': 'VERB'