# file = txt/1300002.txt
# filelineno = 789
# sentno = 2
# text = הכוונה היא לצפיפות הגבוהה במטרופולינים של טוקיו - יוקוהמה, שבהם רבע מאוכלוסיית המדינה (המונה 125 מיליון תושבים) גרים על 2% משיטחה, למרות שצפיפות האוכלוסייה הכוללת ביפן גבוהה רק בשליש מזו שבמערב גרמניה, ונמוכה מזו שבדרום קוריאה או בטיוואן, ומעט גבוהה מזו של סינגפור.
