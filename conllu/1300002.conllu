# file = txt/1300002.txt
# filelineno = 789
# sentno = 5
# text = הגבלות אלה כוללות מניעת שימושי קרקע למגורים, לפארקים או לבנייני משרדים בערך במחצית מהקרקע הלא הררית הנדירה של יפן (שטח המשמש לגידול אורז), וחוקי מס רכוש הגורמים לכך שעדיף להשאיר קרקע ריקה מאשר למכור אותה, דבר שמסביר את הימצאותם של מגרשים פנויים באמצע טוקיו או אוסקה.
