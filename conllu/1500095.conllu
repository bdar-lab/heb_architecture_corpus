# file = txt/1500095.txt
# filelineno = 133
# sentno = 1
# text = בהיות המודלים המנטאליים תוצר של תפיסת האינדיבידואל את עצמו ואת סביבתו, ומאחר ובניית מודל מנטאלי משותף תלויה במידה רבה בקיומה של תחושה מוקדמת של לכידות (1994 ,Klimoski & Mohammed), ניתן להניח כי בנוסף לאופיו של האינדיבידואל, גם לרקע התרבותי שלו השפעה לא קטנה על בניית המודלים המנטאליים שלו ועל תוכנם.
