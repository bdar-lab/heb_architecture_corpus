# file = txt/1500095.txt
# filelineno = 102
# sentno = 7
# text = הבה נתאחד כולנו על מנת לחפוץ, להגות וליצור יחדיו את הבניין החדש של העתיד אשר יחבר לאחת את כל האמנויות – ארכיטקטורה, פיסול וציור – לצורת ביטוי אחת, אשר, יום אחד, תעלה לשמיים מתוך ידיהם של מיליוני עמלים, כסמל גבישי של האמונה החדשה" (מתוך מניפסט הבאוהאוס, גרופיוס, 1919, 1998 ,Droste).
