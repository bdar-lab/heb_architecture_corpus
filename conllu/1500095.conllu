# file = txt/1500095.txt
# filelineno = 344
# sentno = 5
# text = משמעותו של מתאם זה היא שאכן, כפי שהוצע בסעיף 5.3.1.4 לעיל בניתוח השאלות המרכיבות את הגורם "פתרון בי"ס", קיים קשר, לפחות בקרב הנבדקים במסגרת מחקר זה, בין מאפייני תרבות לימוד קולקטיביסטית וקונפורמיסטית כפי שהיא הבאה לידי ביטוי בהעדפת הגורם "פתרון בית ספר" לתרבות לימוד הסולדת מתחרות וביטוי עצמי כפי שהיא באה לידי ביטוי בגורם "הרגשת תחרותיות [מוגזמת] בכיתה".
