# file = txt/1500095.txt
# filelineno = 9
# sentno = 2
# text = מכיוון שתוכן המודל המנטאלי הוא בעל השלכה על יכולת העבודה בצוות, יעילות העבודה ותוצאותיה (Cannon-Bowers, Salas & Converse, 1993), ניתן להסיק כי לרקע התרבותי של הסטודנט ושל המנחה בקורס לתכנון אדריכלי יש השפעה על תוצאותיו של הקורס ועל מידת הצלחתו, קרי: התקדמות הסטודנט ברכישת ידע וכישורים בתכנון אדריכלי.
