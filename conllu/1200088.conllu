# text = בהתאם לכך, החקירה חולקה לשלושה שלבים עיקריים: שלב ראשון – חקירת התגובה המבנית והחשמלית של קורות פוסמנט משוריין בטקטסיל ובסיבים קצרים והשוואת יעילותן ביחס לקורות TRC באמצעות ניסויי כפיפה בהעמסה מונוטונית, שלב שני – חקירת יכולות הניטור של הקורות להבחין בנזק וברמות נזק משתנות באמצעות ניסויי כפיפה בהעמסה מחזורית, ושלב שלישי- חקירת הקורלציה המבנית-חיישנית של הקורות באמצעות גישה המבוססת על רוחב הסדקים כמדד כמותי למצב הנזק המבני.
# raw = {'id': 3, 'text': 'בהתאם לכך, החקירה חולקה לשלושה שלבים עיקריים: שלב ראשון – חקירת התגובה המבנית והחשמלית של קורות פוסמנט משוריין בטקטסיל ובסיבים קצרים והשוואת יעילותן ביחס לקורות TRC באמצעות ניסויי כפיפה בהעמסה מונוטונית, שלב שני – חקירת יכולות הניטור של הקורות להבחין בנזק וברמות נזק משתנות באמצעות ניסויי כפיפה בהעמסה מחזורית, ושלב שלישי- חקירת הקורלציה המבנית-חיישנית של הקורות באמצעות גישה המבוססת על רוחב הסדקים כמדד כמותי למצב הנזק המבני.', 'dspan': (448, 874), 'tokens': [{'id': (1, 2), 'text': 'בהתאם', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'התאם', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'fixed', 'lemma': 'התאם'}], 'span': (0, 5), 'dspan': (448, 453)}, {'id': (3, 4), 'text': 'לכך', 'expanded': [{'id': 3, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 1, 'deprel': 'fixed', 'lemma': 'ל'}, {'id': 4, 'text': 'כך', 'upos': 'PRON', 'xpos': 'PRON', 'head': 8, 'deprel': 'obl', 'lemma': 'כך'}], 'span': (6, 9), 'dspan': (454, 457)}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (457, 458), 'span': (9, 10), 'lemma': ','}, {'id': (6, 7), 'text': 'החקירה', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'חקירה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'nsubj:pass', 'lemma': 'חקירה'}], 'span': (11, 17), 'dspan': (459, 465)}, {'id': 8, 'text': 'חולקה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PUAL|Number=Sing|Person=3|Tense=Past|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (466, 471), 'span': (18, 23), 'lemma': 'חולק'}, {'id': (9, 10), 'text': 'לשלושה', 'expanded': [{'id': 9, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'lemma': 'ל'}, {'id': 10, 'text': 'שלושה', '