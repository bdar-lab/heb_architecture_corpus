# file = txt/1200088.txt
# filelineno = 64
# sentno = 3
# text = המחקרים התמקדו בניטור של פרמטרים מבניים כגון תכולת הלחות על ידי שימוש בקיבול החשמלי של הבטון (2016 .Voss et al), מיפוי שדות העיבורים על ידי ניטור העכבה החשמלית (2014 Hou and Lynch 2009, Hallaji and Pour-Ghaz), וזיהוי מיקומם של סדקים שהתפתחו בבטון על ידי ניטור ההתנגדות החשמלית (2011 Pour-Ghaz and Weiss).
