# file = txt/2800001.txt
# filelineno = 205
# sentno = 1
# text = באזורים עירוניים מוקמים בתי-קומות• בחפשם פתרונות לשמירת הצביון המיוחד של המשפחה, ראו המתכננים צורך להקים את הבית המשותף בצורה שלא תפגע באופיה האינטימי והסגור של המשפחה• חדר המדרגות הסגור, הפנימי והמשותף לכמה משפחות — פינה את מקומו למדרגות חיצוניות, המבטיחות כניסה נפרדת לכל דירה ודירה•
