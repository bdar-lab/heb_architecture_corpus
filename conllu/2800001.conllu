# file = txt/2800001.txt
# filelineno = 56
# sentno = 1
# text = הועמדה הקרקע הדרושה לרשות מפעלים אלה• מפעל השיכון ההסתדרותי מושתת על יסודות קואופרטיביים• מפעלי השיכון מאורגנים ב־9ג2 אגודות, ובהם כ־ססס,150 חברים — גברים ונשים• עובדה מעודדת היא, כי הנטיה בדרך כלל בין המשתכנים, אינה רק לשמירת המסגרת הקואופרטיבית, אלא אף לביצורה וחיזוקה• האגודות הקואופרטיביות הן בגדלים שונים• הקטנות שביניהן כוללות כ־20 דירות, ואילו הגדולות מגיעות עד 2,000 משפחות ויותר (ובמקרה אחד עולה מספר המשפחות ל־5,000)• כל האגודות מאורגנות במסגרת ברית פיקוח לאגודות שיכון — ארגון ארצי, המורכב מנציגי האגודות, המקיים מדי שנה ועידה ארצית בה נקבעים קווי המדיניות הכוללת ונבחרים המוסדות המרכזיים, ע״י ברית הפקוח• קיימת קרן לעזרה הדדית בשם "אבן העזר"• כל אגודה מטפלת בהחזקה השוטפת של המבנים והשכונה• הבעלות הקואופרטיבית מבטיחה שיווי זכויות נם ברכוש לבעל ולאשה, ואף מאפשרת העברת הזכות על הדירה לאדם אחר•
# raw = {'id': 1, 'text': 'הועמדה הקרקע הדרושה לרשות מפעלים אלה• מפעל השיכון ההסתדרותי מושתת על יסודות קואופרטיביים• מפעלי השיכון מאורגנים ב־9ג2 אגודות, ובהם כ־ססס,150 חברים — גברים ונשים• עובדה מעודדת היא, כי הנטיה בדרך כלל בין המשתכנים, אינה רק לשמירת המסגרת הקואופרטיבית, אלא אף לביצורה וחיזוקה• האגודות הקואופרטיביות הן בגדלים שונים• הקטנות שביניהן כוללות כ־20 דירות, ואילו הגדולות מגיעות עד 2,000 משפחות ויותר (ובמקרה אחד עולה מספר המשפחות ל־5,000)• כל האגודות מאורגנות במסגרת ברית פיקוח לאגודות שיכון — ארגון ארצי, המורכב מנציגי האגודות, המקיים מדי שנה ועידה ארצית בה נקבעים קווי המדיניות הכוללת ונבחרים המוסדות המרכזיים, ע״י ברית הפקוח• קיימת קרן לעזרה הדדית בשם "אבן העזר"• כל אגודה מטפלת בהחזקה השוטפת של המבנים והשכונה• הבעלות הקואופרטיבית מבטיחה שיווי זכויות נם ברכוש לבעל ולאשה, ואף מאפשרת העברת הזכות על הדירה לאדם אחר•', 'dspan': (0, 805), 'tokens': [{'id': 1, 'text': 'הועמדה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=HUFAL|Number=Sing|Person=3|Tense=Past|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (0, 6), 'span': (0, 6), 'lemma': 'הועמד'}, {'id': (2, 3), 'text': 'הקרקע', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'קרקע', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'nsubj', 'lemma': 'קרקע'}], 'span': (7, 12), 'dspan': (7, 12)}, {'id': (4, 5), 'text': 'הדרושה', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 5, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 5, 'text': 'דרושה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'acl:relcl', 'lemma': 'דרש'}], 'span': (13, 19), 'dspan': (13, 19)}, {'id': (6, 7), 'text': 'לרשות', 'expanded': [{'id': 6, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'ל'}, {'id': 7, 'text': 'רשות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Ge