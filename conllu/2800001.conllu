# file = txt/2800001.txt
# filelineno = 73
# sentno = 1
# text = הדלילים שבגליל ובנגב• הערים החדשות תוכננו ברובן כערים קטנות או בינוניות ונועדו תחילה להיות מרכזי תעשיה, מלאכה ושירותים לאיזורים החקלאיים שבסביבתן• מערכת הישובים הארצית בהתאם לתיפקוד כל ישוב, היתה מבוססת על היירארכיה ישובית, אולם משהושם הדגש, במידה הולכת וגוברת, על ההתישבות העירונית המתוכננת, הוגדרו רוב עיירות העולים והערים החדשות כערי־פיתוח• המדיניות שהשתנתה הביאה לתכנון התישבות איזורית משולבת, הכוללת צורות ישוב כפריות ועירוניות ; החבל כולל : ישובים חקלאיים, מרכז כפרי־ עירוני למחצה, שמתפקידו לספק לישובים אלה שירותים (כגון: תחנת טרקטורים, בית־ספר, מרפאה וכר), ועיר המבוססת על תעשיה וכוללת שירותים מדרג גבוה : בית־ספר תיכון, בית־ספר מקצועי, מרפאה איזורית, מוסדות בידור וכר• דוגמא לצורה זו הוא חבל לכיש•
