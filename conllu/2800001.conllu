# file = txt/2800001.txt
# filelineno = 116
# sentno = 1
# text = גני ילדים ובתי ספר יסודיים נפרדים בדרך כלל לכל קבוץ ואילו כתות ההמשך (בית הספר התיכוני) משותפות לעיתים למספר קבוצים• טפוסי בתי המגורים בקבוצים שונים זה מזה• שכיחים בתים בני קומה אחת, המכילים, כרגיל, 4 יחידות דיור• כל יח׳ דיור היא בת 29—31 מ״ר המכילה חדר מגורים, פינת שינה, נוחיות, מטבחון ומרפסת• בקבוצים הותיקים והמבוססים יותר יח׳ הדיור גדולה יותר — 36—38 מ״ר• במספר קבוצים, בונים את הבתים בשתי קומות ואפילו בשלוש, בגלל גידול האוכלוסיה והרצון להפחית בהוצאות הפיתוח•
