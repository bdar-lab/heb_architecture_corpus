# file = txt/2800001.txt
# filelineno = 48
# sentno = 1
# text = בישובים אלה הונהג בפעם הראשונה בארץ מס פרוגרסיבי שהיה גבוה יחסית בהיותו חייב לכסות גם את הוצאות החינוך• באין מוסד מוניציפלי, נגבה חמס באמצעות הקואופרטיב או מפעל המים שהיה שייך לתושבי המקום• גם בשאלת תכנון הבית והדירה, ניצב השיכון ההסתדרותי בפני בעיות קשות• בארץ רווח סגנון הבניה הערבי, וזה עתה רק הופיעו ניצנים ראשונים של סגנון הבניה המזרח אירופאי•
