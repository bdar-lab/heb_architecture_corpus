# text = ההון הפרטי■ בניה זו לא היתה מותאן לצרכים החיוניים של פועלים בשכבות עממיו; היא רוכזה בעיקרה במקומות בהם ההט5 למשקיע היתה מובטחת• גם היקפה של זו היה מצומצם• לא היה ספק, כי ה» הפרטי אינו מסוגל לפתור את בעיית הו; של ההמונים• 1 החלטת ההסתדרות להקים מפעל שיכון משנן עיקר כוונתה — לפתור את מצוקת הדיור, 1 היו שרויים אלפי עובדים בארץ• מלכתחיז היה ברור, כי מפעל יה חייב להיות מושתת י עקרונות קואופרטיביים• המטרות, אשר הוא בפני חברת השיכון ההסתדרותית בראשית דו< — הושגו והוגשמו ,במפעלים הרבים, טווזוקו על ידה במשך השנים, מאז ועד היום• המס• של עשרת אלפים דירות, ובהן 45,000 נפשו! — שנבנו על ידי חברת השיכון החסתדרותיג עד לקום מדינת ישראל — נראה זעום ביותר אולם בתנאים של הימים ההם, כשהארץ היו* נתונה תחת שלטון זר והאוכלוסיה היהוד?
# raw = {'id': 1, 'text': 'ההון הפרטי■ בניה זו לא היתה מותאן לצרכים החיוניים של פועלים בשכבות עממיו; היא רוכזה בעיקרה במקומות בהם ההט5 למשקיע היתה מובטחת• גם היקפה של זו היה מצומצם• לא היה ספק, כי ה» הפרטי אינו מסוגל לפתור את בעיית הו; של ההמונים• 1 החלטת ההסתדרות להקים מפעל שיכון משנן עיקר כוונתה — לפתור את מצוקת הדיור, 1 היו שרויים אלפי עובדים בארץ• מלכתחיז היה ברור, כי מפעל יה חייב להיות מושתת י עקרונות קואופרטיביים• המטרות, אשר הוא בפני חברת השיכון ההסתדרותית בראשית דו< — הושגו והוגשמו ,במפעלים הרבים, טווזוקו על ידה במשך השנים, מאז ועד היום• המס• של עשרת אלפים דירות, ובהן 45,000 נפשו! — שנבנו על ידי חברת השיכון החסתדרותיג עד לקום מדינת ישראל — נראה זעום ביותר אולם בתנאים של הימים ההם, כשהארץ היו* נתונה תחת שלטון זר והאוכלוסיה היהוד?', 'dspan': (0, 719), 'tokens': [{'id': (1, 2), 'text': 'ההון', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'הון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 177, 'deprel': 'nsubj', 'lemma': 'הון'}], 'span': (0, 4), 'dspan': (0, 4)}, {'id': (3, 4), 'text': 'הפרטי■', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'פרטיי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'amod', 'lemma': 'פרטיי'}], 'span': (5, 11), 'dspan': (5, 11)}, {'id': (5, 6), 'text': 'בניה', 'expanded': [{'id': 5, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ב'}, {'id': 6, 'text': 'ניה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'nmod', 'lemma': 'ניה'}], 'span': (12, 16), 'dspan': (12, 16)}, {'id': 7, 'text': 'זו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Dem', 'head': 6, 'deprel': 'det', 'dspan': (17, 19), 'span': (17, 19), 'lemma': 'זה'}, {'id': 8, 'text': 'לא'