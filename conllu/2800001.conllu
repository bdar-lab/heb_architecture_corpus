# file = txt/2800001.txt
# filelineno = 15
# sentno = 1
# text = התפתחות החברתית והתרבותית• המרכזים, שבנייתם הושלמה עד 63-31-1 כוללים כ־300 חנויות, דוכנים ובתי מלאכה, כ־100 חדרי משרדים; 4 בתי קולנוע ו־7 מבנים אחרים לשירותים ציבוריים• מרכזים אלה נמצאים, בין השאר, בשכונת רמת־יוסף בבת־ים, בדרום חולון (ג׳סי כהן) ובשכונת תל־ גיבורים בחולון, בנתיבות, בשכונת שמשון באשקלון, בעפולה עילית, בשכונת עמידר בנהריה, בבית־שמש ובדימונה • בתכנית החברה לשנת 1963/1964
