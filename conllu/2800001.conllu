# file = txt/2800001.txt
# filelineno = 138
# sentno = 1
# text = בעבר, לפני קום המדינה היתה מגמת המתכננים להצמיד את שדות המתישב לביתו• התוצאה מכך היתה הקמת כפרים המתמשכים על פני שטח גדול כשבית אחד מרוחק מהשני מרחק ניכר• תכנון זה הביא לעתים גם לריחוק בתי המגורים ממרכז הכפר עם שירותיו השונים• בשנים האחרונות גברה המגמה להקים מושבים מגובשים יותר כמתואר לעיל• בעקבות זה חלק משדות המתישבים אינו צמוד לבית אלא נמצא בגוש של שדות הנפרד מבית המגורים• גודל החלקה שליד הבית הוא עתה שונה• בכמה ישובים כמו, למשל, במושבי ההר, מצויה ליד הבית חלקת שדה של 2,5 — 2 דונם• ואילו במקרים אחרים, בשפלה, חלקה של 7—10 ד׳, יתר השדות אינם צמודים לביתו של המתישב• גודל השדות ומיקומם שונה ותלוי בטיפול המשק• קיימים בדרך כלל בישראל ארבעה טיפוסים עיקריים של משקים מושביים:
