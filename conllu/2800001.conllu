# sentno = 1
# text = להקל על התושבים המרוחקים מהעיר המרכזים המסחריים בשכונות נועדו ולאפשר להם ריכוז קניות במקום• החנויות נמסרות לסוחרים בשכירות או ברכישה• המרכז מתוכנן באופן שיכיל חנויות ובתי עסק מכל הסוגים שהתושבים נזקקים להם כגון: מכבסות, בתי מרקחת, חנויות למצרכי מזון, הלבשה, הנעלה, ספרות וכר• כדי לייעל את השירותים ולתאמם בודקת החברה מראש — לפני מסירת החנויות ובתי העסקים לידי השוכרים או הרוכשים למה נועדו החנויות ובתי העסק• ברוב המרכזים נמצאים גם משרדים, אולמות תרבות, בתי קולנוע ובתי קפה• כל מרכז מוקף מדשאות גדולות• הודות לתכנון זה משמש המרכז המסחרי מרכז לשירותים וגם מקום הבילוי העיקרי של תושבי השכונות, ועוזר לגיבושם ול־
# raw = {'id': 1, 'text': 'להקל על התושבים המרוחקים מהעיר המרכזים המסחריים בשכונות נועדו ולאפשר להם ריכוז קניות במקום• החנויות נמסרות לסוחרים בשכירות או ברכישה• המרכז מתוכנן באופן שיכיל חנויות ובתי עסק מכל הסוגים שהתושבים נזקקים להם כגון: מכבסות, בתי מרקחת, חנויות למצרכי מזון, הלבשה, הנעלה, ספרות וכר• כדי לייעל את השירותים ולתאמם בודקת החברה מראש — לפני מסירת החנויות ובתי העסקים לידי השוכרים או הרוכשים למה נועדו החנויות ובתי העסק• ברוב המרכזים נמצאים גם משרדים, אולמות תרבות, בתי קולנוע ובתי קפה• כל מרכז מוקף מדשאות גדולות• הודות לתכנון זה משמש המרכז המסחרי מרכז לשירותים וגם מקום הבילוי העיקרי של תושבי השכונות, ועוזר לגיבושם ול־', 'dspan': (0, 608), 'tokens': [{'id': 1, 'text': 'להקל', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=HIFIL|VerbForm=Inf|Voice=Act', 'head': 16, 'deprel': 'xcomp', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'הקל'}, {'id': 2, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'dspan': (5, 7), 'span': (5, 7), 'lemma': 'על'}, {'id': (3, 4), 'text': 'התושבים', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'תושבים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'obl', 'lemma': 'תושב'}], 'span': (8, 15), 'dspan': (8, 15)}, {'id': (5, 6), 'text': 'המרוחקים', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 6, 'text': 'מרוחקים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'acl:relcl', 'lemma': 'מרוחקים'}], 'span': (16, 24), 'dspan': (16, 24)}, {'id': (7, 9), 'text': 'מהעיר', 'expanded': [{'id': 7, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'מ'}, {'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'