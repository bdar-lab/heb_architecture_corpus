# file = txt/2800001.txt
# filelineno = 102
# sentno = 1
# text = לנים• בישראל אין כל הגבלה לגבי בניה זו, המבוצעת בעיקר בערים הגדולות ובסביבתן, ומיועדת כולה למכירה• היקף הבניה הפרטית הגיע בשנים האחרונות ל־16,000 דירות, לעומת כ־23,000 דירות בבניה הציבורית• עם זאת הגיע שטח הבניה הפרטית למגורים ל־50% בקירוב מכלל שטח הבניה, בגלל גודל הדירות העולה על הממוצע הארצי• ההשקעה במגורים תופסת מקום נכבד בכלל השקעות־ההון הגולמיות במשק, אך עם זאת חלה ירידה הדרגתית במשקל ההשקעות בבניה למגורים• בשנים 1950—1951, הוותה ההשקעה בבניה למגורים 46% עד 47-5% ; בחמש השנים האחרונות הוותה השקעה זו 30% בממוצע• היקף ההשקעה בבניה למגורים ובענפי משק הבניה האחרים מגיע ל־60% מכלל ההשקעה במשק• חשיבותו של ענף זה מובנת, לאור התפקיד שהוא משמש כמכשיר ביישוב הארץ ובעיצוב דמות החברה המתגבשת בה •
