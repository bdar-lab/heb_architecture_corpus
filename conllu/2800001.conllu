# text = רביעית, היצור הגובר של גידולי תעשיה בישראל נשנים האחרונות חייב שילוב תעשיה באיזור החקלאי והקמת מפעלי עיבוד התעשיה בסמוך לשדות• קירוב מפעלי העיבוד — לאיזור החקלאי — כמו ביח״ר לסוכר, מנפשות לכותנה, בתי חרושת לשימורי ירקות וכו׳ — מביאים לחסכון בהוצאות ובדרך זו להוזלה של תהליך הייצור החקלאי•
# raw = {'id': 1, 'text': 'רביעית, היצור הגובר של גידולי תעשיה בישראל נשנים האחרונות חייב שילוב תעשיה באיזור החקלאי והקמת מפעלי עיבוד התעשיה בסמוך לשדות• קירוב מפעלי העיבוד — לאיזור החקלאי — כמו ביח״ר לסוכר, מנפשות לכותנה, בתי חרושת לשימורי ירקות וכו׳ — מביאים לחסכון בהוצאות ובדרך זו להוזלה של תהליך הייצור החקלאי•', 'dspan': (0, 288), 'tokens': [{'id': 1, 'text': 'רביעית', 'upos': 'ADV', 'xpos': 'ADV', 'head': 15, 'deprel': 'advmod', 'dspan': (0, 6), 'span': (0, 6), 'lemma': 'רביעית'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (6, 7), 'span': (6, 7), 'lemma': ','}, {'id': (3, 4), 'text': 'היצור', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'יצור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 15, 'deprel': 'nsubj', 'lemma': 'יצור'}], 'span': (8, 13), 'dspan': (8, 13)}, {'id': (5, 6), 'text': 'הגובר', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'גובר', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'amod', 'lemma': 'גבר'}], 'span': (14, 19), 'dspan': (14, 19)}, {'id': 7, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 8, 'deprel': 'case', 'dspan': (20, 22), 'span': (20, 22), 'lemma': 'של'}, {'id': 8, 'text': 'גידולי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'nmod:poss', 'dspan': (23, 29), 'span': (23, 29), 'lemma': 'גידולי'}, {'id': 9, 'text': 'תעשיה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'compound', 'dspan': (30, 35), 'span': (30, 35), 'lemma': 'תעשייה'}, {'id': (10, 11), 'text': 'בישראל', 'expanded': [{'id': 10, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'de