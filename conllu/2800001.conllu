# file = txt/2800001.txt
# filelineno = 42
# sentno = 1
# text = במדינה, מלאה תפקיד חלוצי בהקמת מפעלי השיכון הגדולים, בבנותה את שיכוני הוותיקים, בהקימה את רוב השיכון העממי, חלק משיכון העולים, השיכון לזוגות צעירים, לחיילים, למפונים ועוד• תמונת מפעל השיכון ההסתדרותי תהא שלמה, כאשר נבדוק כמה עובדות בקשר לפיזור הבניה ברחבי הארץ, ולריכוז שכונות המגורים בתוך הערים והמושבות• "שכון עובדים־ לא הצטמצם ולא התרכז בערים הגדולות בלבד• מפעליו פזורים בכל חלקי הארץ : מצפת וטבריה בצפון, ועד אילת בדרום• עם זאת נעשתה פעולה בכל אזור בצורה מרוכזת• כך נבנו יותר מ־75% של בתי שיכון עובדים במסגרת מפעלי שיכון גדולים (11 ערי גנים לפועלים ו־100 שכונות פועלים גדולות)• בראש משימותיו של ״שכון עובדים־ — דאגה לשיכון המוני עובדים חברי הסתדרות בתנאים נאותים מחד, ושקידה על יצירת דמות חברתית מיוחדת במסגרת מפעלי השיכון, מאידך• אפיק נוסף בפעילות החברה היה קליטת העליה ושיכונה• השיכון ההסתדרותי לא הלך בדרך של הקמת
