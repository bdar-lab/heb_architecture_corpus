# text = עים שונים —י הכל לפי אופיים, מוצאם וצרכיהם של התושבים־העולים, מחדירים העובדים הקהילתיים — הפועלים ביותר מ־50 שיכונים — את תודעת אחריות הדיירים לגבי ביתם, והשפעתם רבה• האזרחים מטפחים את גינותיהם, שומרים על בתיהם, ונוצרים שיתוף פעולה ועזרה הדדית בין השכנים• העולים לומדים לדעת, כי לצרכים משותפים אפשר לדאוג בדרכים משותפות• המדריכים הקהילתיים דואגים לפגישות חברתיות בין העולים, מפרסמים חומר הסברה בתחומים המענינים
# raw = {'id': 1, 'text': 'עים שונים —י הכל לפי אופיים, מוצאם וצרכיהם של התושבים־העולים, מחדירים העובדים הקהילתיים — הפועלים ביותר מ־50 שיכונים — את תודעת אחריות הדיירים לגבי ביתם, והשפעתם רבה• האזרחים מטפחים את גינותיהם, שומרים על בתיהם, ונוצרים שיתוף פעולה ועזרה הדדית בין השכנים• העולים לומדים לדעת, כי לצרכים משותפים אפשר לדאוג בדרכים משותפות• המדריכים הקהילתיים דואגים לפגישות חברתיות בין העולים, מפרסמים חומר הסברה בתחומים המענינים', 'dspan': (0, 410), 'tokens': [{'id': 1, 'text': 'עים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 25, 'deprel': 'nsubj', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'עים'}, {'id': 2, 'text': 'שונים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'amod', 'dspan': (4, 9), 'span': (4, 9), 'lemma': 'שונה'}, {'id': 3, 'text': '—', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (10, 11), 'span': (10, 11), 'lemma': '—'}, {'id': 4, 'text': 'י', 'upos': 'X', 'xpos': 'X', 'head': 2, 'deprel': 'dep', 'dspan': (11, 12), 'span': (11, 12), 'lemma': 'הוא'}, {'id': 5, 'text': 'הכל', 'upos': 'NOUN', 'xpos': 'NOUN', 'head': 7, 'deprel': 'conj', 'dspan': (13, 16), 'span': (13, 16), 'lemma': 'הכיל'}, {'id': 6, 'text': 'לפי', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'dspan': (17, 20), 'span': (17, 20), 'lemma': 'לפי'}, {'id': (7, 9), 'text': 'אופיים', 'expanded': [{'id': 7, 'text': 'אופי_', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Def|Gender=Masc|Number=Plur', 'head': 25, 'deprel': 'obl', 'lemma': 'אופי'}, {'id': 8, 'text': '_של_', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case:gen', 'lemma': 'של'}, {'id': 9, 'text': '_הם', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Gender=Masc|Number=Plur|Person=3|PronType=Prs', 'head': 7, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (21, 27), 'dspan': (21, 27)}, {'id': 10, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 7, 'deprel': 'punct', 'dspan': (27, 28), 'span':