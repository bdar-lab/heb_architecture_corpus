# file = txt/2800001.txt
# filelineno = 154
# sentno = 1
# text = (מעל 400 מ׳ מעל פני הים) היא בדרן כלל 18—12 דונם ואילו באיזור הגבעות (400—300 מטר) עולה המכסה על 20 דונם ומגיעה בכמה איזורים עד ל־30 דונם• בהר הגבוה מיועד השטח ברובו לעצי פרי נשירים וגפן; מטע זה הוא בדרן כלל בהשקאה• מיעוטו של השטח מיועד לגידולי שדה בבעל או בהשקאה• בין גידולי הבעל יש לציין את הטבק ובין גידולי ההשקאה בעיקר ירקות וגידול ירקות לזרעים• אף כי תכנונו הפיסי של המושב שונה בהתאם לטיפוס המשק הרי שבכל המקרים מתוכנן במרכז הכפר שטח נוי פתוח, בו מותקנים שרותים כגון צרכניה, גן ילדים ובי״ס -, מועדון, חדרי מזכירות וכדומה•
# raw = {'id': 1, 'text': '(מעל 400 מ׳ מעל פני הים) היא בדרן כלל 18—12 דונם ואילו באיזור הגבעות (400—300 מטר) עולה המכסה על 20 דונם ומגיעה בכמה איזורים עד ל־30 דונם• בהר הגבוה מיועד השטח ברובו לעצי פרי נשירים וגפן; מטע זה הוא בדרן כלל בהשקאה• מיעוטו של השטח מיועד לגידולי שדה בבעל או בהשקאה• בין גידולי הבעל יש לציין את הטבק ובין גידולי ההשקאה בעיקר ירקות וגידול ירקות לזרעים• אף כי תכנונו הפיסי של המושב שונה בהתאם לטיפוס המשק הרי שבכל המקרים מתוכנן במרכז הכפר שטח נוי פתוח, בו מותקנים שרותים כגון צרכניה, גן ילדים ובי״ס -, מועדון, חדרי מזכירות וכדומה•', 'dspan': (0, 526), 'tokens': [{'id': 1, 'text': '(', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (0, 1), 'span': (0, 1), 'lemma': '('}, {'id': 2, 'text': 'מעל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'dspan': (1, 4), 'span': (1, 4), 'lemma': 'מעל'}, {'id': 3, 'text': '400', 'upos': 'NUM', 'xpos': 'NUM', 'head': 4, 'deprel': 'nummod', 'dspan': (5, 8), 'span': (5, 8), 'lemma': '400'}, {'id': 4, 'text': 'מ׳', 'upos': 'NOUN', 'xpos': 'NOUN', 'head': 119, 'deprel': 'parataxis', 'dspan': (9, 11), 'span': (9, 11), 'lemma': 'מ׳'}, {'id': 5, 'text': 'מעל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'dspan': (12, 15), 'span': (12, 15), 'lemma': 'מעל'}, {'id': 6, 'text': 'פני', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem,Masc|Number=Plur', 'head': 4, 'deprel': 'nmod', 'dspan': (16, 19), 'span': (16, 19), 'lemma': 'פנים'}, {'id': (7, 8), 'text': 'הים', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'ים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'compound:smixut', 'lemma': 'ים'}], 'span': (20, 23), 'dspan': (20, 23)}, {'id': 9, 'text': ')', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (23, 24), 'span': (23, 24), 'lemma': ')'}, {'id': 10, 'text': 'היא', 'upos': 'PRON', '