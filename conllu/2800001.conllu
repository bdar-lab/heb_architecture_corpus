# text = מתכנון כפרים בודדים לתכנון איזורי תכנון הכפרים החקלאיים בישראל בעבר נעשה על בסיס של תכנון נפרד לכל ישוב ללא ראיה כוללת של האיזור או של השתלבות הישובים בסביבתם• תכנון זה נבע בעיקר מסבות גיאופוליטיות וחברתיות שהיו קיימות לפני שנוסדה מדינת ישראל ואשר לא איפשרו אפילו להקים גושי התישבות מרוכזים מחוסר קרקע שעמדה לרשות ההתישבות היהודית• משום כן הווה כל ישוב מעין יחידה כלכלית־חברתית סגורה ללא קשר עם סביבתה• יחידה זו הכילה את רוב השרותים הכלכליים והחברתיים הדרושים לה-
# raw = {'id': 1, 'text': 'מתכנון כפרים בודדים לתכנון איזורי תכנון הכפרים החקלאיים בישראל בעבר נעשה על בסיס של תכנון נפרד לכל ישוב ללא ראיה כוללת של האיזור או של השתלבות הישובים בסביבתם• תכנון זה נבע בעיקר מסבות גיאופוליטיות וחברתיות שהיו קיימות לפני שנוסדה מדינת ישראל ואשר לא איפשרו אפילו להקים גושי התישבות מרוכזים מחוסר קרקע שעמדה לרשות ההתישבות היהודית• משום כן הווה כל ישוב מעין יחידה כלכלית־חברתית סגורה ללא קשר עם סביבתה• יחידה זו הכילה את רוב השרותים הכלכליים והחברתיים הדרושים לה-', 'dspan': (0, 463), 'tokens': [{'id': 1, 'text': 'מתכנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 17, 'deprel': 'nsubj', 'dspan': (0, 6), 'span': (0, 6), 'lemma': 'מתכנון'}, {'id': 2, 'text': 'כפרים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'compound:smixut', 'dspan': (7, 12), 'span': (7, 12), 'lemma': 'כפר'}, {'id': 3, 'text': 'בודדים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'amod', 'dspan': (13, 19), 'span': (13, 19), 'lemma': 'בודד'}, {'id': (4, 5), 'text': 'לתכנון', 'expanded': [{'id': 4, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'ל'}, {'id': 5, 'text': 'תכנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'nmod', 'lemma': 'תכנון'}], 'span': (20, 26), 'dspan': (20, 26)}, {'id': 6, 'text': 'איזורי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'compound:smixut', 'dspan': (27, 33), 'span': (27, 33), 'lemma': 'איזור'}, {'id': 7, 'text': 'תכנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'compound:smixut', 'dspan': (34, 39), 'span': (34, 39), 'lemma': 'תכנון'}, {'id': (8, 9), 'text': 'הכפרים', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {