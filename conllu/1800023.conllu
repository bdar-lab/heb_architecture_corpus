# text = על אף השוני הקיים לכאורה בין תהליכי הבנייה לבין תהליכי הייצור, וחרף הטענה כי החשיבה הרזה מתאימה אך ורק לתעשייה, ניתן בכל זאת לאתר קווי דמיון מרובים בין התהליכים, ובאמצעות מספר התאמות תפיסתיות ניתן לגשר על הפער (1998 Crowley 1998; Mikulina).
# raw = {'id': 1, 'text': 'על אף השוני הקיים לכאורה בין תהליכי הבנייה לבין תהליכי הייצור, וחרף הטענה כי החשיבה הרזה מתאימה אך ורק לתעשייה, ניתן בכל זאת לאתר קווי דמיון מרובים בין התהליכים, ובאמצעות מספר התאמות תפיסתיות ניתן לגשר על הפער (1998 Crowley 1998; Mikulina).', 'dspan': (0, 240), 'tokens': [{'id': 1, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'dspan': (0, 2), 'span': (0, 2), 'lemma': 'על'}, {'id': 2, 'text': 'אף', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 1, 'deprel': 'fixed', 'dspan': (3, 5), 'span': (3, 5), 'lemma': 'אף'}, {'id': (3, 4), 'text': 'השוני', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'שוני', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 34, 'deprel': 'obl', 'lemma': 'שוני'}], 'span': (6, 11), 'dspan': (6, 11)}, {'id': (5, 6), 'text': 'הקיים', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 6, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 6, 'text': 'קיים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'acl:relcl', 'lemma': 'קיים'}], 'span': (12, 17), 'dspan': (12, 17)}, {'id': 7, 'text': 'לכאורה', 'upos': 'ADV', 'xpos': 'ADV', 'head': 6, 'deprel': 'advmod', 'dspan': (18, 24), 'span': (18, 24), 'lemma': 'לכאורה'}, {'id': 8, 'text': 'בין', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'dspan': (25, 28), 'span': (25, 28), 'lemma': 'בין'}, {'id': 9, 'text': 'תהליכי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 6, 'deprel': 'obl', 'dspan': (29, 35), 'span': (29, 35), 'lemma': 'תהליך'}, {'id': (10, 11), 'text': 'הבנייה', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 11, 'deprel': 'det', 'lemma': 'ה'}, {'id': 11, 'text': 'בנייה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 9, 'de