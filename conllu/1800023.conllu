# file = txt/1800023.txt
# filelineno = 386
# sentno = 4
# text = לדוגמא, במחקר שנערך בארצות הברית אשר התעמק בשלב הייצור במפעל של אותן תעלות הנחקרות כאן, נמצא כי מחזור הזמן הנדרש כדי לקבל הזמנה, לייצר ולספק רכיב תעלה טיפוס לאתר היה 32 יום – אך זמן העיבוד בפועל של אותו רכיב היה רק 20.1 דקות (2005 .Alves et al).
