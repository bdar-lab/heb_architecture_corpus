# file = txt/2500069.txt
# filelineno = 66
# sentno = 1
# text = כפי שכתוב לעיל, החוקרים רואים דו״ח מחקר זה כמהדורה ראשונית של מדריך לביצוע עבודות לבידוד תרמי של בניינים קיימים וגם לבניינים בתיכנון ומצפים שבעתיד ימצאו המשאבים כדי להשלים את העבודה שמתכננים ובונים מצפים, בעיקר מאז שמוסד נושא הבידוד התרמי עם הפיכת "התקן לבידוד תרמי של בנייני מגורים" ת.י. 1045 לחלק בלתי נפרד מקובץ התקנות" "תקנות התכנון והבנייה" (בקשה להיתר, תנאיו ואגרות־ תיקון מם' 2 - 1985).
