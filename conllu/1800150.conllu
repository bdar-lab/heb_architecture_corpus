# sentno = 1
# text = 6.2.2	שילוב שגרתי של מודד מוסמך – בממצאי המחקר כי בשלב השלד נוצרו מירב הליקויים (ראה ציור וטבלה 4.1), והם אלה אשר גורמים למירב השיבוש בפעולות עתידיות, אע"פ שהובהר כי בשלב זה ניתן לזהות בקלות יחסית את הליקויים.
