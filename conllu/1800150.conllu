# sentno = 1
# text = 2.1.2	איכות בבנייה – האיכות בבנייה קשה עוד יותר להגדרה מאשר איכות של מוצרי צריכה, היות ואין היא נגזרת של התכן בלבד, אלא גם של תהליכי הביצוע והשימוש הכוללים שימוש בחומרי גלם שונים, התקנת מערכות רבות, קבלנים רבים, ציוד ומיכון, ולבסוף – לאחר קבלת המוצר – שימוש בפועל לאורך תקופת חייו של הבניין.
