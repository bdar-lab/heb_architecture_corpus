# file = txt/2300026.txt
# filelineno = 266
# sentno = 1
# text = (ג)	לא יתן המפקח צר כאמור בפיסקה (א) אלא לאחר שהבעל או החוכר לתקופה העולה על 25 שנים של הקרקע, שאליה מתייחס הצו, נתץ את הסכמתו לביצוע הפעולות האמורות בצו ולאחר שניתנה הזדמנות לכל בעל זכות באותה קרקע, הרשומה בפנקסי המקרקעין, להשמיע את טענותיו.
