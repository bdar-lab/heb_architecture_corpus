# text = לבסוף רצוננו להביע את תודתנו לחברי החברה אשד ענו על השאלונים; לעובדי החברה אשר שיתפו עמנו פעולה; למרואיינים השונים אשר ספקו לנו מידע על החברה; לשרות לשמירת איכות הסביבה ולקרן סוופ של הטכניון על מימון חלק מעבודה זו; ליעקב שודר על הערותיו בתכנון השאלון; לרחל אלתרמן ולשי יעקבץ על הערותיהם החשובות לגבי חלקיו השונים של החיבור; לדוד גבאי על הייעוץ בתכנות לעיבוד הנתונים בעזרת המחשב; ולבסוף, לצעירה יריב על עבודתה המסורה בהגהה, הדפסה והוצאה לאור של העבודה.
# raw = {'id': 4, 'text': 'לבסוף רצוננו להביע את תודתנו לחברי החברה אשד ענו על השאלונים; לעובדי החברה אשר שיתפו עמנו פעולה; למרואיינים השונים אשר ספקו לנו מידע על החברה; לשרות לשמירת איכות הסביבה ולקרן סוופ של הטכניון על מימון חלק מעבודה זו; ליעקב שודר על הערותיו בתכנון השאלון; לרחל אלתרמן ולשי יעקבץ על הערותיהם החשובות לגבי חלקיו השונים של החיבור; לדוד גבאי על הייעוץ בתכנות לעיבוד הנתונים בעזרת המחשב; ולבסוף, לצעירה יריב על עבודתה המסורה בהגהה, הדפסה והוצאה לאור של העבודה.', 'dspan': (439, 890), 'tokens': [{'id': 1, 'text': 'לבסוף', 'upos': 'ADV', 'xpos': 'ADV', 'head': 13, 'deprel': 'advmod', 'dspan': (439, 444), 'span': (0, 5), 'lemma': 'לבסוף'}, {'id': (2, 3), 'text': 'רצוננו', 'expanded': [{'id': 2, 'text': 'רצונ', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 13, 'deprel': 'nsubj', 'lemma': 'רצון'}, {'id': 3, 'text': 'נו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Definite=Def|Gender=Masc|Number=Plur|Person=1|Poss=Yes|PronType=Prs', 'head': 2, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (6, 12), 'dspan': (445, 451)}, {'id': 4, 'text': 'להביע', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=HIFIL|VerbForm=Inf|Voice=Act', 'head': 2, 'deprel': 'xcomp', 'dspan': (452, 457), 'span': (13, 18), 'lemma': 'הביע'}, {'id': 5, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 6, 'deprel': 'case', 'dspan': (458, 460), 'span': (19, 21), 'lemma': 'את'}, {'id': (6, 7), 'text': 'תודתנו', 'expanded': [{'id': 6, 'text': 'תודת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'obj', 'lemma': 'תודת'}, {'id': 7, 'text': 'נו', 'upos': 'PRON', 'xpos': 'PRON', 'head': 6, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (22, 28), 'dspan': (461, 467)}, {'id': (8, 9), 'text': 'לחברי', 'expanded': [{'id': 8, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ל'}, {'id': 9, 'text': 'חברי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gend