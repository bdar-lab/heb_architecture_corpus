# file = txt/2300012.txt
# filelineno = 189
# sentno = 3
# text = מציאותם של מרכיבים אלו מעידה על יכולת של החברה, כגוף בעל ארגון קבוע וכח אדם מאומן, לבצע משימות תוך שימוש מתואם במרכיבים שונים יש לציין במיוחד את מבנה החברה המאפשר לה להגיע לחבריה ולציבור הרחב המפוזר בחלקי הארץ השונים ולשתף פעולה עם הממשל המקומי דרך סניפיה ובתי הספר השונים.
