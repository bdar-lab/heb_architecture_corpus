# file = txt/2300000.txt
# filelineno = 184
# sentno = 1
# text = בנוסף לתחזיות התפוקות השונות שתדרשנה מענפי המשק יש לתת את הדעת לתפוקות בלתי רצויות המתקבלות כ"מוצרי לואי" מתהליכי הייצור השונים; הכוונה היא לפליטת זיהומים סביבתיים שונים לאויר למים ולקרקע, זיהומים אלה אשר מהווים השפעות חיצוניות שליליות על איכות החיים בעיר אינם באים לידי בטוי במערכת ההחלטות והמחירים של היחידות היצרניות, אי-לכך מחובתו של גוף התכנון הציבורי לוודא שההשלכות החיצוניות הללו תהיינה מינימליות ותתבטאנה בתחשיבי היחידות היצרניות על ידי הטלת קנסות וכו'.
