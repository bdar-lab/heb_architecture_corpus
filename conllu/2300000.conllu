# file = txt/2300000.txt
# filelineno = 28
# sentno = 1
# text = לוחות תשומה-תפוקה משמשים לתיאור מערכת שלמה של פעילות כלכלית ומהווים מכשיר כמותי למדידת זרימת התשומות והתפוקות בין ענפים שונים במערכת הכלכלית, לוח תשומה-תפוקה מתאר מערכת המצויה במצב של שווי משקל כללי, המערכת הכלכלית המתוארת בעזרת לוח תשומה-תפוקה מחולקת ביסודה לשני חלקים עיקריים: האחד אקסוגני - המושפע מגורמים חיצוניים ונקרא "הביקוש הסופי" והשני אנדוגני - המושפע מתהליכים פנימיים של יחסי הגומלין שבין הסקטורים השונים של הכלכלה ונקרא "הסקטור היצרני", מבנהו של הלוח מאפשר ניחוח כמותי של השינויים שיחולו בסקטור היצרני כתוצאה משינויים חזויים בסקטור האקסוגני, כלומר הביקוש הסופי.
