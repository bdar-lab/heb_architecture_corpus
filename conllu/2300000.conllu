# file = txt/2300000.txt
# filelineno = 165
# sentno = 3
# text = התוצאות שנתקבלו מצביעות על השקעה של כ-790 מיליון ל"י שתדרש בתעשיה עד שנת 1981 ושל כ-1,640 מיליון עד שנת 1992, שמחי קרקע לתעשיה שידרשו לשנות המטרה 1981, 1992 יהיו 532 דונם (נטו) ו-1093 דונם (נטו) בהתאם, היות והשטח נטו מהווה כ-25% מהשטח ברוטו (כאשר מתחשבים בשטחי ציבור כגון שטחים פתוחים, דרכים, שטחים בלתי מפותחים וכו') אזי םה״כ השטח שידרש לתעשיה, יהיה כ-2,128 דונם לשנת 1981 ו—4,371 דונם לשנת 1998, כלומר סה״כ הקרקעות שתדרשנה לפיתוח התעשיות ב-20 השנים הבאות יהיו כ-4,500 דונמים.
