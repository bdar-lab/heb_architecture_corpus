# sentno = 1
# text = 1.2.2	הקצאת מימון ממשלתי לפעילות בשני תחומי הידע לעיל בהתאם לסדרי העדיפויות התקופתיים, כולל הסדרת מסגרת תקציבית ייעודית למימון של שימוש בספינות ובתשתיות מחקר מתקדמות ("ימי ים") ע״י הקהילייה המדעית, על בסיס תחרותי, וזאת מעבר להקצבות של משרדי הממשלה הייעודיים לפעילות בתחומי האחריות שלהם (כגון מימון תכנית הניטור הלאומית ע״י המשרד להגנת הסביבה ומשרד התשתיות הלאומיות, האנרגיה והמים)'.
