# file = txt/1500118.txt
# filelineno = 521
# sentno = 1
# text = המושג הראשון אליו אתייחס הוא אתנוצנטריות, שהוגדר בצורה צרה על ידי סמוחה (1987) כתחושת עליונות, אי אמון, והימנעות או אי רצון להעניק שוויון זכויות והזדמנויות לקבוצה אתנית אחרת מעבר לנחוץ על מנת להשיג מטרות קולקטיביות לגיטימיות (1987 ,Samooha).
