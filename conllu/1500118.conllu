# file = txt/1500118.txt
# filelineno = 165
# sentno = 1
# text = באין בן-זוג כאמור בסעיף קטן (א) יהיו ילדי הדייר לדיירים, ובאין ילדים — קרוביו האחרים,כל אלה בתנאי שהיו מתגוררים בדירה יחד אתו לפחות שישה חודשים סמוך לפטירתו, ולא הייתה להם בזמן פטירתו דירה אחרתלמגוריהם״ (חוק הגנת הדייר נוסח משולב תשל״ב (1972)).
