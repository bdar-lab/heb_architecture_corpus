# file = txt/1500118.txt
# filelineno = 582
# sentno = 1
# text = בחירת הכלים המרכזיים נעשתה על בסיס השערה אודות הרלוונטיות של הכלים למקרה היפואי, כאשר נלקחו בחשבון היבטים שונים להתאמתם כגון: מידת הרלוונטיות לאור תנאי שוק הדיור ביפו, מידת האפשרות ליישמם בהינתן המבנה הסטטוטורי של התכנון המרחבי בישראל, מידת ההשפעה שתהיה ליישום הכלי והעלות הכלכלית הציבורית ליישומם.
