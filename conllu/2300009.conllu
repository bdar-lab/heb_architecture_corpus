# text = מאפיין המשותף למספר ניכר של נשים הוא מצוקה כלכלית, הרווחת במיוחד בקבוצות-משנה ספציפיות באוכלוסיית הנשים: א) נשים שהן ראשי משפחות חד-הוריות, המתקשות למלא את כל התפקידים ולפרנס את משפחתן; ב) נשים לאחר גיל פרישה עם מעט אמצעים כלכליים, בגלל מאפייני תעסוקתן בעבר שנתאר להלן; ג) נשים קשישות בודדות - תוחלת החיים הארוכה יותר של נשים לעומת גברים, בהפרש די קבוע של כ-3 שנים, משאירה קבוצה גדולה למדי שלהן בגפן ולעתים
# raw = {'id': 1, 'text': 'מאפיין המשותף למספר ניכר של נשים הוא מצוקה כלכלית, הרווחת במיוחד בקבוצות-משנה ספציפיות באוכלוסיית הנשים: א) נשים שהן ראשי משפחות חד-הוריות, המתקשות למלא את כל התפקידים ולפרנס את משפחתן; ב) נשים לאחר גיל פרישה עם מעט אמצעים כלכליים, בגלל מאפייני תעסוקתן בעבר שנתאר להלן; ג) נשים קשישות בודדות - תוחלת החיים הארוכה יותר של נשים לעומת גברים, בהפרש די קבוע של כ-3 שנים, משאירה קבוצה גדולה למדי שלהן בגפן ולעתים', 'dspan': (0, 406), 'tokens': [{'id': 1, 'text': 'מאפיין', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 10, 'deprel': 'nsubj:cop', 'dspan': (0, 6), 'span': (0, 6), 'lemma': 'מאפיין'}, {'id': (2, 3), 'text': 'המשותף', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'משותף', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'amod', 'lemma': 'משותף'}], 'span': (7, 13), 'dspan': (7, 13)}, {'id': (4, 5), 'text': 'למספר', 'expanded': [{'id': 4, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'ל'}, {'id': 5, 'text': 'מספר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'nmod', 'lemma': 'מספר'}], 'span': (14, 19), 'dspan': (14, 19)}, {'id': 6, 'text': 'ניכר', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'amod', 'dspan': (20, 24), 'span': (20, 24), 'lemma': 'ניכר'}, {'id': 7, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 8, 'deprel': 'case:gen', 'dspan': (25, 27), 'span': (25, 27), 'lemma': 'של'}, {'id': 8, 'text': 'נשים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 5, 'deprel': 'nmod:poss', 'dspan': (28, 32), 'span': (28, 32), 'lemma': 'איש'}, {'id': 9, 'text': 'הוא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Polarity=Pos|PronType=Prs', 'head': 10, 'deprel': 'cop', 'dsp