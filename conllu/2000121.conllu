# file = txt/2000121.txt
# filelineno = 213
# sentno = 3
# text = שימוש רחב בסקיצות על ידי אדריכלים מודרניים בשלבים מוקדמים של תכנון מאשר את טענתו של לאונרדו, אשר טען לפני חמש מאות שנה שעשיית רישומי עזר מהירים ולא שלמים במשך עבודתו על קומפוזיציה אומנותית עוררה את התהליך של המצאה ויזואלית (& Fish 1990 ,Scrivene).
