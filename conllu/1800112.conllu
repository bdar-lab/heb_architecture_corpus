# file = txt/1800112.txt
# filelineno = 284
# sentno = 1
# text = •	המחקר מראה כי עבור תצורת החיזוק הכוללת יריעות, בחירת כיווניות סיבים נכונה מאפשרת ניצול והטרחה יעילים יותר של מערכת החיזוק מחד, אולם כתלות בכיוון הסיבים, עשויה, להביא להתפתחות כוחות לחיצה במערכת החיזוק ולחשוף אותה לכשלי קריסה וכשלי קילוף אשר עלולים להיגרם כתוצאה מהקריסה.
