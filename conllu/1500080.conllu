# file = txt/1500080.txt
# filelineno = 529
# sentno = 3
# text = העובדה שמשתנים הקשורים לפעילות הפירמה לא דורגו כחשובים בהשפעתם על בחירת המיקום, מצטרפת לכך שלא מצאנו הבדלים מובהקים רבים בין האזורים במשתנים אלו, כגון גודל הפירמה, תחום הפעילות ועוד (ראה פרק 5 סעיף 5.4).
