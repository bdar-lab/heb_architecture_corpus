# file = txt/1800140.txt
# filelineno = 18
# sentno = 4
# text = בהתבסס על ממצאי השלב הנוכחי של המחקר ניתן לקבוע שיעדי שלב בי של המחקר, קרי השלמת הניסויים שתוכננו במקור להתבצע בשלב א' של המחקר, גיבוש מתכונת שדרוג משופרת המבטיחה אי כשל של המחברים בין העמודים לקורות במסגרות בטון מזויין משודרגות והעברת אזור הכשל אל הקורות משני צידי העמודים (מעבר לאזור המשודרג), כמו גם בחינה של אפשרויות שדרוג במתכונת מצומצמת יחסית הושגו במלואם.
