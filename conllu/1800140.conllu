# file = txt/1800140.txt
# filelineno = 76
# sentno = 1
# text = תכן שידרוג העמודים מבוסס על המומנט בקורה בפעולת העומס הקריטי, במטרה למנוע כשל בעמוד הן בחתך המשודרג הקריטי – בפני הקורה – והן בחתך הבלתי משודרג – בקצה השידרוג, כל זאת במטרה ליצור שדרוג המסגרות כך שהן תהפוכנה למסגרות מסוג " עמוד חזק-קורה חלשה", שתפקודן ברעידת אדמה ולאחריה הינו משופר, בהשוואה למסגרות מסוג "עמוד חלש-קורה חזקה".
