# file = txt/1500212.txt
# filelineno = 37
# sentno = 4
# text = אם לפני 40 שנים מחוות נחשבו רק לכאלה המעורבים בהם אביזרים חיצוניים וכלים מסורתיים (מסכי מגע, מקלדות ועכברים), הרי שטכנולוגיות זיהוי מחוות ידיים התקדמה משמעותית בשנים האחרונות, עם הניסיונות ליצור ממשקים יותר טבעיים ומתקדמים (2008 ,Jacob), והשימוש בהם במערכות צבאיות, רגישות ומסווגות משולב בשנים האחרונות במערכות שונות.
