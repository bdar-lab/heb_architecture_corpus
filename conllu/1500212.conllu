# file = txt/1500212.txt
# filelineno = 51
# sentno = 5
# text = תנועות ידיים לבחירה ולהזזת אובייקטים משמשות כאחת הפעולות השכיחות בה (איור 3) (2004 ,Buchmann), טכניקות ראיית מחשב כבר מזהות מילים כתובות באוויר על ידי מחוות ידיים בעזרת עיבוד נתונים מראש בהן מחליפים תבניות גיאומטריות במילים כתובות באוויר ומזהה בדיוק של יותר מ-90% את המילים שנכתבו ומציג אותן על מסך המחשב (2017 ,Khan).
