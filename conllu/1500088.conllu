# file = txt/1500088.txt
# filelineno = 260
# sentno = 3
# text = בשנת 2000 פיתחה USGBC את מערכת הדירוג לבניה ירוקה (LEED), מסגרת כוללת לתכנון בנייה ירוקה, שהיוותה זרז משמעותי לגידול בתנועת הבניה הירוקה ושמשה בסיס לפיתוח המדריך הירוק לשרותי הבריאות ( GGHC .(Green Guide 2007 ,for Health Care מאוחר יותר, כדי לתמוך במעבר של תעשיית הרפואה לאסטרטגיה של קיימות, USGBC פיתחה LEED במיוחד עבור תעשיית הרפואה (2008 ,Guenther & Vittori).
