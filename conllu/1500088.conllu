# file = txt/1500088.txt
# filelineno = 214
# sentno = 2
# text = התמונה הכללית היא מסובכת הרבה יותר, לא רק בגלל העולם העצום של רעלנים אליהם יצור חי עלול להיות חשוף בכל נקודת או משך זמן, כי אם עקב המוני משתנים אחרים כגון רמת החשיפה, דרך החשיפה (פנימית, נשימתית, עורית), עיתוי החשיפה ("חלונות פגיעות", לדוגמא שלב התפתחותי), היסטוריה של חשיפות קודמות, משך חשיפות קודמות,תזונה, גיל, מין, גנטיקה, גורמי פגיעות אחרים (טמפרטורה, עקה גופנית או מטבולית, רעש, קרינה אלקטרומגנטית, גורמי מחלה).
