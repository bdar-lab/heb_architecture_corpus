# file = txt/1500088.txt
# filelineno = 119
# sentno = 1
# text = מאחר ותעשיית הרפואה נסמכת על מוצרים אלקטרוניים בהרבה מאוד תחומים, ובהתחשב בעובדה שיצרני ציוד אלקטרוני יכולים לקחת בחזרה את המוצרים שלהם בתום חייהם לשם התאמתם הבטוחה לשימוש מחדש ולשם ִמחזור המרכיבים למוצרים חדשים תוך שימוש מינימאלי בחומרים מזיקים, הרי שמוסדות בריאות יכולים וצריכים לנהל הסכמי רכש או חכירה רק עם יצרני אלקטרוניקה המחויבים לטיפול זהיר במוצרים בתום חייהם, כלומר שימוש מחדש ו ִמחזור מקסימאליים, ללא יצוא פסולת אלקטרונית מסוכנת למדינות מתפתחות, ולסילוק בטוח של כל הפסולת שאינה מתאימה ל ִמחזור או לשימוש מחדש (2003 ,Gould).
