# file = txt/1500088.txt
# filelineno = 23
# sentno = 5
# text = החל מבקמינסטר פולר (Buckminster Fuller), אשר הטביע את המונח Spaceship Earth, מושג המבטא את האחריות ההדדית שיש לאנושות לכדור הארץ, לשיפור חיי בני האדם והסביבה ( ,Fuller 1971), דרך ויקטור פפנק (Victor Papanek), אשר הטיף לעיצוב מתוך מחויבות לסביבה, למשאבי הטבע ולאוכלוסיות נזקקות, ועד מרגולין (Margolin) הטוען בספרו The Politics of the Artificial שחלקם הגדול של האתגרים הסביבתיים נותר ללא מענה עיצובי, מכיוון שהם אינם נופלים בתחומי העניין של קהל הלקוחות המסורתי של המעצב.
