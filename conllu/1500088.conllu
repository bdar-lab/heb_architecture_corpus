# file = txt/1500088.txt
# filelineno = 716
# sentno = 1
# text = פער דומה מתגלה בין המטרות שהציב לעצמו משרד הבריאות לעומת המטרות שהציבו לעצמם משרדי ממשלה אחרים; משרד התשתיות הלאומיות - הטמעת עלויות חיצוניות, סביבתיות וחברתיות בבחינת פרויקטים, התעשייה, המסחר והתעסוקה - קידום תהליכי ייצור נקי, משרד החקלאות - עידוד חקלאות אורגנית, שר הבינוי והשיכון - ייזום, תכנון והקמת פרויקטים בהתבסס על שיקולי פיתוח בר קיימא, שר התחבורה - קידום שימוש בדלקים נקיים ועידוד מערכות תחבורה לא ממונעות, שרת החינוך, התרבות והספורט - הטמעת עקרונות פיתוח בר קיימא וקידום החינוך הסביבתי בתוכניות הלימוד במדעי הטבע, במדעי החברה ובפעילויות מוסדות החינוך, ושר המדע והטכנולוגיה - ייזום ומימון מחקרים בעלי פוטנציאל ליישום פיתוח בר קיימא.
# raw = {'id': 1, 'text': 'פער דומה מתגלה בין המטרות שהציב לעצמו משרד הבריאות לעומת המטרות שהציבו לעצמם משרדי ממשלה אחרים; משרד התשתיות הלאומיות - הטמעת עלויות חיצוניות, סביבתיות וחברתיות בבחינת פרויקטים, התעשייה, המסחר והתעסוקה - קידום תהליכי ייצור נקי, משרד החקלאות - עידוד חקלאות אורגנית, שר הבינוי והשיכון - ייזום, תכנון והקמת פרויקטים בהתבסס על שיקולי פיתוח בר קיימא, שר התחבורה - קידום שימוש בדלקים נקיים ועידוד מערכות תחבורה לא ממונעות, שרת החינוך, התרבות והספורט - הטמעת עקרונות פיתוח בר קיימא וקידום החינוך הסביבתי בתוכניות הלימוד במדעי הטבע, במדעי החברה ובפעילויות מוסדות החינוך, ושר המדע והטכנולוגיה - ייזום ומימון מחקרים בעלי פוטנציאל ליישום פיתוח בר קיימא.', 'dspan': (0, 642), 'tokens': [{'id': 1, 'text': 'פער', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'nsubj', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'פער'}, {'id': 2, 'text': 'דומה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'amod', 'dspan': (4, 8), 'span': (4, 8), 'lemma': 'דומה'}, {'id': 3, 'text': 'מתגלה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HITPAEL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (9, 14), 'span': (9, 14), 'lemma': 'התגלה'}, {'id': 4, 'text': 'בין', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'dspan': (15, 18), 'span': (15, 18), 'lemma': 'בין'}, {'id': (5, 6), 'text': 'המטרות', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'מטרות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 3, 'deprel': 'obl', 'lemma': 'מטרה'}], 'span': (19, 25), 'dspan': (19, 25)}, {'id': (7, 9), 'text': 'שהציב', 'expanded': [{'id': 7, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 9, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 8, 'text': 'ה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gende