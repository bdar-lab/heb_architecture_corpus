# file = txt/2800081.txt
# filelineno = 60
# sentno = 1
# text = מאז שנת 1972 חלה עליה כללית בישראל ברווחת הדיור, ברמת ההכנסה הממוצעת וברמת ההשכלה, מכאן שהנתונים המתקבלים לגבי היקפה ועוצמתה של המצוקה באזורים השונים הינם יחסיים והשוואתיים ואין בהם כדי להצביע על הדמה האבסולוטית של המצוקה באזור הסטטיסטי המסויים (מקובל לפיכך לחשב את המשפחות הנמצאות מתחת לקו העוני כמשפחות שרמת הכנסתן נמוכה מ-50% מההכנסה החציונית לשכיר במשק).
