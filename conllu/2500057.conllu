# file = txt/2500057.txt
# filelineno = 44
# sentno = 1
# text = לפי המחקרים והערכות שבוצעו בעבר, מהוות הוצאות התקורה בחברות קבלניות, העובדות בשיטה הקונבנציונלית כ-20%-10% מעלויות הבנייה" לגבי הבנייה הקלה חסרים עדיים נתונים בדוקים בנושא זה, אולם לאור הנתונים החלקיים שנתקבלו מאחת החברות והשוואתם עם הנתונים של הבנייה הקונבנציונלית, ניתן להניח שהגדלת הוצאות התקורה בבנייה הקלה בסעיף "מבנים וציוד במפעל" מתאזנת בערך עם החסכון בהוצאות לציוד באתר הבנייה, ובעבודה בלתי ישירה והוצאות כלליות באתר" בהתחשב עם כך הנחנו בשתי האלטרנטיבות שעור תקורה אחיד של 12% מעלויות הבנייה, ולא התייחסנו אליו בחישוב השוואתי של הוצאות.
