# file = txt/2500057.txt
# filelineno = 25
# sentno = 1
# text = ואשר לגגות ולתקרות - לא התייחסנו כהשוואה כלכלית לפתרון הגגות השטוחים מבטון מזויין האפשרי בבנייה הקונבנציונלית, בהתחשב עם כך, שרובם של בניינים בני קומה אחת מוקמים היום בארץ עם גגות קלים (מאסבסט או רעפים) משופעים, וההפרש בעלויות של שני סוגי גגות אלה אינו משמעותי לגבי ההשוואה הכוללת של הוצאות הבנייה.
