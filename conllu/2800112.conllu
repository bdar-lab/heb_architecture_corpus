# file = txt/2800112.txt
# filelineno = 6
# sentno = 2
# text = מטרת מסמך זה הינה לבדוק האם וכיצד ממשיכות לפעול תוכניות חברתיות שהוקמו ביוזמת פרויקט שיקום השכונות ובתקציביו ב-24 שכונות, בהן הפרויקט סיים פעולתו, עפ"י החלשות הממשלה, בשנים 1991 ו- 1993 (החלשה מסי 1481 מתאריך 23.6.91 והחלטה מסי 1294 מתאריך 23.5.91).
