# file = txt/1500189.txt
# filelineno = 56
# sentno = 2
# text = פלזמה מדבר על כך שהיצירה כתוצאה של מגע והפעלת החושים השונים היא המשך של גוף היוצר, ומביא את המחשב כגורם המרחיק ומנתק בין היוצר ליצירה, בכך אותו יוצר מאבד את קרבתו הבלתי אמצעית אל יצירתו, והתוצאה מסתכמת באסתטיקה שמחד אמנם נראית טוב לעין אך מאידך היא מאבדת את העושר החווייתי שלה- החוויה הופכת לשטוחה, והאובייקט מסווג כ"יפה"
