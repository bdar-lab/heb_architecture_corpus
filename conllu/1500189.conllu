# file = txt/1500189.txt
# filelineno = 337
# sentno = 1
# text = שפה תכנות זאת שיועדה מראש לצרכים אומנותיים ויצירתיים, נכתבה בקוד פתוח במעבדת המדיה שבאוניברסיטת MIT ע"י בן פרי (Ben Fry), וקייס׳ ריאס (Casey Reas) ונולדה מתוך רצון של השניים לפתח כלי שיאפשר שימוש בסקיצות במדיום הקרוב ככל האפשר למדיום הסופי בו מוצג המוצר המוגמר, בשל כך נבנתה שפת התכנות באופן שישמש כספר סקיצות ממוחשב המאפשר לחקור ולזקק רעיונות רבים בתקופה קצרה.
