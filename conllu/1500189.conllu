# file = txt/1500189.txt
# filelineno = 211
# sentno = 1
# text = בעבודה ששמה מרמז על קשר למוסיקה, ופרושו הוא ספר תווים הכולל את כל תפקידי הכלים והקולות המשתתפים ביצירה מוזיקלית, מנסים האמנים לבנות מערכת חדשה לתרגום מוסיקה לצורה ויזואלית בהשפעתם אמנים כמו ואסילי קנדינסקי (Vasily Kandinsky), פול קלי (Paul Klee), אוסקר פישינגר (Oscar Fischinger) ונורמן מאקלארן( Norman McLaren) באמצעות יצירת תמונה גראפית המבוססות על מערכת מדויקת ועקבית של יחסים בין סוגים שונים של גיאומטריות.
