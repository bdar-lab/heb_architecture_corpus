# text = Cinder נכתבה במקור ע"י אנדרו בל (Andrew Bell) וחי נגויין (Hai Nguyen) במהלך עבודתם בחברת "The Barbarian Group" שבמקור פיתחה את Cinder עבור עבודתה עם לקוחותיה בלבד, אך שחררה אותה כמקור פתוח וזמין לציבור בשנת 2010 במטרה לעודד אמנים וחברות ליצור ולייצר בקוד.
# raw = {'id': 1, 'text': 'Cinder נכתבה במקור ע"י אנדרו בל (Andrew Bell) וחי נגויין (Hai Nguyen) במהלך עבודתם בחברת "The Barbarian Group" שבמקור פיתחה את Cinder עבור עבודתה עם לקוחותיה בלבד, אך שחררה אותה כמקור פתוח וזמין לציבור בשנת 2010 במטרה לעודד אמנים וחברות ליצור ולייצר בקוד.', 'dspan': (0, 255), 'tokens': [{'id': 1, 'text': 'Cinder', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 2, 'deprel': 'nsubj', 'dspan': (0, 6), 'span': (0, 6), 'lemma': 'Cinder'}, {'id': 2, 'text': 'נכתבה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (7, 12), 'span': (7, 12), 'lemma': 'נכתב'}, {'id': (3, 4), 'text': 'במקור', 'expanded': [{'id': 3, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'case', 'lemma': 'ב'}, {'id': 4, 'text': 'מקור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'obl', 'lemma': 'מקור'}], 'span': (13, 18), 'dspan': (13, 18)}, {'id': 5, 'text': 'ע"י', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Abbr=Yes', 'head': 6, 'deprel': 'case', 'dspan': (19, 22), 'span': (19, 22), 'lemma': 'ע"י'}, {'id': 6, 'text': 'אנדרו', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 2, 'deprel': 'obl', 'dspan': (23, 28), 'span': (23, 28), 'lemma': 'אנדרו'}, {'id': 7, 'text': 'בל', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 6, 'deprel': 'flat', 'dspan': (29, 31), 'span': (29, 31), 'lemma': 'בל'}, {'id': 8, 'text': '(', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 9, 'deprel': 'punct', 'dspan': (32, 33), 'span': (32, 33), 'lemma': '('}, {'id': 9, 'text': 'Andrew', 'upos': 'X', 'xpos': 'X', 'head': 7, 'deprel': 'appos', 'dspan': (33, 39), 'span': (33, 39), 'lemma': 'Andrew'}, {'id': 10, 'text': 'Bell', 'upos': 'X', 'xpos': 'X', 'head': 9, 'deprel': 'flat', 'dspan': (40, 44), 'span': (40, 44), 'lemma': 'Bell'}, {'id': 11, 'text': ')', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 9, 'deprel': 'punct', 'dspan': (