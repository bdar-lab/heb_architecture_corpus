# file = txt/1500119.txt
# filelineno = 311
# sentno = 2
# text = נוסף על כך, תושבי המקום לא תמכו בהבחנה זו וקשרו את גורל הוותיקים עם גורל הפולשים: "ההמצאה האחרונה של ספסרים וסחטנים ותופסים כפי יכולתם ושודדי קרקעות היא המצאה שפלה והתגרות גסה באזרחים שקשרו את גורלם באדמה זו מאז 1948 ברציפות ועד היום (ועד כפר שלם, 1978).
