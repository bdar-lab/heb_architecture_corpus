# file = txt/1500119.txt
# filelineno = 653
# sentno = 2
# text = למרות הקשיים, אף לא אחד מהמרואיינים הללו הביע כוונה למכור את הבית - אחדים סיפרו שהם מחזיקים בנכס כירושה לילדיהם, ונראה היה כי לאחרים, בייחוד לקשישים ולעניים מביניהם, חסרים הידע והכלים להתמודד עם תהליך המכירה או עם מעבר לדירה חדשה והם למעשה "כבולים" לבית.
