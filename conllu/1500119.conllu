# file = txt/1500119.txt
# filelineno = 241
# sentno = 2
# text = בספטמבר 949 1 כבר מנתה אוכלוסיית סלמה 14,650 תושבים, הנחלקים ל-3 אזורי מגורים: שיכון עולים, בו גרו בבתי הכפר הערבי כ- 6,000 תושבים, שיכון פליטים בו גרו כ-7,000 פליטים יהודים משכונת הספר ששוכנו בבתי הכפר הערבי ושיכון צריפונים בו גרו כ-1,650 תושבים במבנים ארעיים (גולן, 2001; יבין ופביאן, 2007).
