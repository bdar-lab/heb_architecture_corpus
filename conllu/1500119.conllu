# file = txt/1500119.txt
# filelineno = 310
# sentno = 4
# text = בשנת 1975 גיבשה העירייה מדיניות פינוי, הנוהגת עד היום, המתייחסת לשתי אוכלוסיות: אוכלוסיית הוותיקים, הזכאים לדיור חלוף, ואוכלוסיית ה"פולשים" נגדה תנקוט העירייה בצעדים של פינוי בכוח, ללא מתן פיצוי.
