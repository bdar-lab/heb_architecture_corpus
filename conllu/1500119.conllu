# file = txt/1500119.txt
# filelineno = 669
# sentno = 13
# text = מן התשובות מסתמן כי פרט לקירבה למשפחה, אשר עלתה כמרכיב מרכזי בראיונות, היו ההיבטים הכלכליים־פרקטיים והיבטים של איכות חיים בעלי משקל רב יותר מאשר ההיבטים החברתיים (2006 ,Joseph) יוצא מכלל זה הקשר לבית הכנסת המעיד על החשיבות המיוחסת לקהילה בעיקר עבור המבוגרים.
