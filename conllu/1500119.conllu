# text = חלק גדול מהמשפחות שנותרו בכפר היו מקרב יוצאי אסיה ואפריקה, אלו היו משפחות שהאפשרות שלהם להשתכן ב"סידור עצמי" היתה נמוכה יותר, אך תנאי הפיצוי שהציעה חלמיש נתפסו בעיניהם כ"הרעת תנאי החיים מבחינה כלכלית וחינוכית לדורות, ההופכים את המפונים לנזקקי סעד בעתיד" (ועד כפר שלם, גילוי דעת מ 1973).
# raw = {'id': 4, 'text': 'חלק גדול מהמשפחות שנותרו בכפר היו מקרב יוצאי אסיה ואפריקה, אלו היו משפחות שהאפשרות שלהם להשתכן ב"סידור עצמי" היתה נמוכה יותר, אך תנאי הפיצוי שהציעה חלמיש נתפסו בעיניהם כ"הרעת תנאי החיים מבחינה כלכלית וחינוכית לדורות, ההופכים את המפונים לנזקקי סעד בעתיד" (ועד כפר שלם, גילוי דעת מ 1973).', 'dspan': (277, 563), 'tokens': [{'id': 1, 'text': 'חלק', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 12, 'deprel': 'nsubj', 'dspan': (277, 280), 'span': (0, 3), 'lemma': 'חלק'}, {'id': 2, 'text': 'גדול', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'amod', 'dspan': (281, 285), 'span': (4, 8), 'lemma': 'גדול'}, {'id': (3, 5), 'text': 'מהמשפחות', 'expanded': [{'id': 3, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'מ'}, {'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'משפחות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 1, 'deprel': 'nmod', 'lemma': 'משפחה'}], 'span': (9, 17), 'dspan': (286, 294)}, {'id': (6, 7), 'text': 'שנותרו', 'expanded': [{'id': 6, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 7, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 7, 'text': 'נותרו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem,Masc|HebBinyan=NIFAL|Number=Plur|Person=3|Tense=Past|Voice=Mid', 'head': 5, 'deprel': 'acl:relcl', 'lemma': 'נותר'}], 'span': (18, 24), 'dspan': (295, 301)}, {'id': (8, 9), 'text': 'בכפר', 'expanded': [{'id': 8, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ב'}, {'id': 9, 'text': 'כפר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'obl', 'lemma': 'כפר'}], 'span': (25, 29), 'dspan': (302, 306)}, {'id': 10, 'text': 'היו', 'upos': 'AUX', 'xpos': 'AUX', 'feats': 'Gender=Fem,Masc|Number=Plur|Person=3|Polarity=Pos|Tense=Past|VerbType=Cop', 'h