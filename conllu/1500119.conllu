# file = txt/1500119.txt
# filelineno = 471
# sentno = 6
# text = בשנת 2008, בעקבות מחאות מצד תושבים על קצב הפינוי האיטי, הורה שר הבינוי והשיכון על ניסוח קריטריונים חדשים לפינוי, ומבקר המדינה הוזמן לבדוק את הנושא (דו"ח מבקר המדינה 2008, פרוטוקול מסי 658 מישיבת ועדת הכלכלה של הכנסת, 28.7.08) תהליכי הפינוי נעצרו שוב, עד לגיבוש הקריטריונים החדשים, תהליך שנכון לכתיבת עבודה זו, טרם הושלם.
