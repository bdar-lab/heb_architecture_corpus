# file = txt/1500119.txt
# filelineno = 389
# sentno = 1
# text = מניתוחים פרוגרמטיים של הצרכים הנורמטיביים לשירותי ציבור בכפר שלם רבתי ומרכז כפר שלם (עיריית תל אביב יפו, 1997; עיריית תל אביב יפו, 2006), עולה כי קיים מחסור נורמטיבי בשטחי הציבור עבור האוכלוסייה הקיימת, וכי בטווח הארוך, בעת מימוש מלא, צפוי מחסור של כ 50 דונם במבני ציבור וכ 40 דונם בשטח ציבורי פתוח בכפר שלם רבתי.
