# file = txt/1500119.txt
# filelineno = 223
# sentno = 4
# text = בשטחי המינהל וחלמיש נבנו ארבע שכונות שנועדו לספק פתרונות דיור למפונים: נווה אליעזר, שנבנתה ואוכלסה בשנות השישים עבור מפוני כפר שלם; חלקים משכונת ליבנה, שבה תוכננו יחידות צמודות קרקע עבור משפחות המפונים הגדולות; כפיר מערב, שנבנתה ואוכלסה בראשית שנות השמונים עבור מפוני אבו כביר; ומרכז כפר שלם וכפיר מזרח (מתחמים מי וש) שפותחו בשנות ה-90, ובהם שולבה בנייה לשיווק בשוק החופשי עם בנייה עצמית של "בנה ביתך" על ידי מפוני מרכז הכפר (תכנית החומש).
