# file = txt/1500119.txt
# filelineno = 242
# sentno = 2
# text = באותן שנים היו בכפר מספר אזורים השונים זה מזה מבחינה דמוגרפית וגיאוגרפית: המעברה, שכללה שני מחנות עולים מארצות מוצא רבות, אזור הכביש, בו התגוררו בעיקר עולים ממזרח אירופה ובולגריה אשר יושבו במקום על ידי הסוכנות או קנו דירה בדמי מפתח, ולב הכפר, ששכן בראש הגבעה ועל מורדותיה, האזור שבו נערך המפקד.
