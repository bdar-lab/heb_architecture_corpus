# file = txt/1500119.txt
# filelineno = 37
# sentno = 3
# text = התכנית קובעת כי "פינוי שיש עמו פתרון קבע, מחייב לא רק להסתפק בתשלום פיצויים, אלא להבטיח למפונים דיור אלטרנטיבי נאות" (אלמוגי, 1963, עמי 23), והיא מגדירה פיצוי הולם כפיצוי מלא, במקום שני שלישים מדמי המפתח כפי שנקבע בחוק הגנת הדייר, תשט"ו - 5 95 1 (כרמון, 997 1).
