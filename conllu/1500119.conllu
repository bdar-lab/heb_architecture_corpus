# file = txt/1500119.txt
# filelineno = 256
# sentno = 1
# text = עם תחילת פעולות השיקום והקמת החברות המשכנות החלה להתגבש מדיניות לאומית לטיפול בבעיית משכנות העוני: בשנת 963 ו הוכנה על ידי שר הבינוי והשיכון דאז, יוסף אלמוגי, תכנית ארצית לבינוי ופינוי משכנות עוני, (אלמוגי, 1963), בה נקבע כפר שלם כאחד משלושת הפרויקטים הראשונים לפינוי ובינוי במסגרת התכנית הארצית (יחד עם שכונת נחלאות בירושלים, שפינוייה לא מומש, והרובע היהודי בצפת, שטופל חלקית).
