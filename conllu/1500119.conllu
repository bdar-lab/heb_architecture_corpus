# file = txt/1500119.txt
# filelineno = 367
# sentno = 1
# text = תכנית תא\1909 שאושרה ב 1986 (והיא חלה על מתחם "מ", מרכז כפר שלם), היא התב״ע המאפשרת יישום פיסי של המדיניות המובאת ב"תכנית החומש" לשיקום מרכז כפר שלם"9ו, ומכוחה בוצעו הפינויים ונבנו המבננים הראשונים של "בנה ביתך" (שיווק הקרקעות לבנייה רוויה החל מספר שנים מאוחר יותר).
