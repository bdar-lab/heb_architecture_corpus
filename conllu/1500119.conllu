# file = txt/1500119.txt
# filelineno = 408
# sentno = 9
# text = כדי למנוע זאת, הוצע במסמכי תכנית החומש כי זכויות הפינוי של משפחה יוקפאו ברגע שהאזור שבו היא מתגוררת יהיה מוכן לפינוי, ושמעבר למועד זה לא יוסיפו שינויים דמוגרפיים שחלו בהרכב המשפחה זכויות לפינוי (יבין, 1990, 1993).
