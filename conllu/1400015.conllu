# file = txt/1400015.txt
# filelineno = 6
# sentno = 16
# text = בעשורים האחרונים יש עליה בפעולות הננקטות בערים בעולם כתגובה לאתגרי האקלים, אולם מקרי בוחן מדגימים שההפחתה וההסתגלות זכו לעדיפות רק כאשר הייתה הבנה של ההשפעה המקומית של שינויי האקלים, או כאשר הפעולות היו קשורות לנושאים שעלו כבר על סדר היום המקומי, כגון אנרגיה או איכות האוויר.
