# file = txt/1400015.txt
# filelineno = 327
# sentno = 1
# text = לשימוש בעצים לצורך הצללה יתרונות רבים: עצים מקטינים את עומס החום ואת ׳יחס בוהן׳ (עצים מורידים את הטמפרטורה בשיעור בבוה יותר מזה שבו הם מעלים את הלחות היחסית, ובאופן זה חלק בדול יותר מקרינת השמש מתורבם לחום כמוס ופחות לחום מוחשי); עצים פולטים חמצן ובולעים פחמן דו-חמצני מהאוויר; עצים מטילים צל על מבנים ומקטינים את כמות הקרינה הנקלטת בקירותיהם (עדיפות לעצים נשירים); הצללה מעצים מעודדת תנועה רבלית ורכיבה על אופניים; נוף העצים בולע רעש ומאפשר יצירת הפרדה בין אזורי שימוש שונים; עצים משפרים החדרת מי בשמים לקרקע; עצים מאפשרים התפתחות בעלי חיים בעיר; עצים תורמים לריכוך המראה החד והקשה של הרחוב העירוני ויוצרים תחושה רבועה יותר של המרחב הפתוח.
