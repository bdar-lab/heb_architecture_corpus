# file = txt/1400015.txt
# filelineno = 16
# sentno = 1
# text = תצפיות - בניתוח מרמות שינויי הטמפרטורה היומית הממוצעת בישראל בעשורים האחרונים מצביע דו״ח השירות המטאורולורי (שינויים אקלימיים בישראל, דצמבר 2014,2011) על ירידה מממוצע רבוה יחסית בשנות ה-50 לממוצע נמוך יותר בשנות ה-70 וה-80 ועלייה משמעותית מאמצע שנות ה-90 לממוצע רבוה בשנות ה-2000.
