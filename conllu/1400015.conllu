# file = txt/1400015.txt
# filelineno = 375
# sentno = 1
# text = בבדיקות שערכו בעיריית תל אביב, שכבר היום מחייבת בנייה לפי תו תקן ירוק במבני ציבור, משרדים ומבני מגורים גבוהים לפי תקן שקיים מאז אפריל 2011 בעשרות תב״ע, מצאו שהתקן מוביל לחיסכון של 24 מיליון שקל בחשבונות החשמל וכ-40 אלף מ״ק מים בשנה, כאשר שימוש חוזר במי המזגנים חוסך עוד כ-200 אלף מ״ק מים.
