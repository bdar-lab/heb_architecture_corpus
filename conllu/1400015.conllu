# file = txt/1400015.txt
# filelineno = 335
# sentno = 1
# text = השיסות והאססרסדיות לניהול נרר עילי כוללות: (1) איסוף או קציר מי רשמים מעות ומפני שסח (ראה איור 4.3); (2) תפיסת מי נדר עילי ושיטפונות, אגירתם במאדרים קסנים והחדרתם למי התהום; (3) תכנון שימושי קרקע, החל ממיקום של שכונות ותשתיות, וכלה במיקום שטחים פתוחים, מבנים וחצרות, המתחשבים במערכת הדיאוהידרולודית של המקומית והאזורית, ובאפשרויות להשהיית הנדר, טיובו והחדרתו לקרקע.
