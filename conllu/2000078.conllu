# filelineno = 603
# text = אולם דעה זו נכונה רק במקרים מסריימים ר- WALTON עצמר טוען שהמבנים בעלי הגגוח הגמלוניים הס עתיקים ממט כמו המבנים העגולים, ולכו אין המבנים האובליים הלב התפתחות הכרקי אלא מלב התפתחות אפשרי □נוצל ע״י אנשים שחיו במבנים עגולים ושסכניקת הבניה שלהם היתה סל מבנים עגולים והם רצר להסיג חלל מחיה רחב יותר, כמו מביתן להסיג במבנים המלבניים.
