# filelineno = 318
# text = נאמר בדיעבד, כיוון שהתפתחות האדם ופעילויותיו איבן־ נובעות מקיום הבית, אלא הן פעילויות בעלות מביעים ותוצאות בכיוונים סוגים, אולם מכיוון מהבית מסמס כעין "מיכל" לאדם ולפעילותו הרי שהוא עלול להיות בחזקת מסגרת כובלת ולהפריע להתפתחות פעילות כל שהיא,או להיפך, 'לסמש מסגרת מעודדת ולסייע לה, ובכר הוא משחק תפקיד חשוב בהתפתחות הפעי לו ת האנושית לענפיה השובים.
