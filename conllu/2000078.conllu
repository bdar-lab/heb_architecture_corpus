# filelineno = 683
# text = כאער חדלו בני אדם להסתפק בם ער ות, ב נקיקי סלע ובענפים קלועים כמחסה בפני כוחות האיתנים, סמלסדו לבנות צריפים, בגו אותם תחילה בצורת סוכות כגולות... הכרתם הפריסיסינד, ותפיסתם את החלל בסו מלכתחילה לצורת המעגל (וכן כתוב בתלכוד: "איך רבוע מפסת ימי בראשית").
