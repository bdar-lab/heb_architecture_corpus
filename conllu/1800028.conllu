# file = txt/1800028.txt
# filelineno = 356
# sentno = 1
# text = שאלת מקורות הפרנסה צריכה להילקח בחשבון לשלושה טווחי זמן: בטווח המידי, צריך לתת מענה לשאלה במה וכיצד יתפרנסו החברים מיד עם הגעתם ליישוב; בטווח הביניים, מצופה יציבות מסוימת בעבודת החברים ובמקורות ההכנסה שלהם; הטווח הארוך מתייחס לתקופה שבה תחול התבגרות וראשית הזדקנות אנשי הקהילה – ואזי צפויה ירידה בהעסקה בפרנסות זמניות ושאיפה ליהנות מפרות ההשקעה.
