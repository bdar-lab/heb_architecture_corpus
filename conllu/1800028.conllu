# file = txt/1800028.txt
# filelineno = 158
# sentno = 2
# text = היות שהתכנית מבקשת לתמוך בגרעינים בהקשר רחב יותר מיצירת פעילות או שירות, יש מקום לכלול במחוונים לשיקולי התמיכה בפעילויות שיקולים נוספים ולדרוש התייחסות עבורם, כגון: מה מידת המעורבות הצפויה של חברי הגרעין בפרויקט (לא רק עובדי הפרויקט), מה תרומת הפרויקט לחיזוק הקשר בין הגרעין לקהילה, איזה מעורבות של בני המקום צפויה בפרויקט, ועוד.
