# file = txt/1400079.txt
# filelineno = 341
# sentno = 1
# text = סקר שבוצע בנושא תמריצים לבנייה ירוקה בעולם והתאמתם לישראל (גארב ואחרים, 2015), מציין אמצעים נוספים לשינו׳ התנהגות׳ בישראל, כגון: חשבון חשמל מדורג המציע תעריפי חשמל גבוהים על רמות צריכה גבוהות, ומתגמל על רמות צריכה נמוכות; מיקוד בתועלות הלא-כלכליות בשיווק הבנייה הירוקה, כגון הפחתת הפליטות או התחושה הנעימה והשפעתה על הבריאות ועל הפרודוקטיביות הכרוכים בה וכן המלצה לשינו׳ נורמות התנהגות תוך עבודה עם סוכני שינוי בקהילה.
