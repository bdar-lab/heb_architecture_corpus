# file = txt/1400079.txt
# filelineno = 22
# sentno = 1
# text = סקירת המודלים והקריטריונים לאיפוס אנרגיה בעולם לימדה שהחלוקה המקובלת לארבעה מודלים - איפוס עלות האנרגיה (COST), איפוס אנרגיה באתר (SITE), איפוס אנרגיה במקור (SOURCE) ואיפוס פליטות פחמן (ZERO CARBON), נמצאה פחות רלוונטית, וכיום המיקוד מתבצע בשני מודלים עיקריים: במודל איפוס האנרגיה במקור - מודל שבו ההתחשבנות בין "צור האנרגיה לצריכתה מתבצע בהמרת יחידות האנרגיה במקדם המבטא את העלויות האנרגטיות הכרוכות בכרייה, בהפקה ובשינוע של הדלקים עד למשתמש הקצה; ובמודל איפוס פליטות הפחמן הנפיץ במדינות שבהן נהוגה מתודולוגיה של הערכת מחזור ח״ם וכן ראייה רחבה להתחשבנות אנרגטית.
