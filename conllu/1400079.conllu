# file = txt/1400079.txt
# filelineno = 652
# sentno = 2
# text = העיתוי מצוין לשילוב תחום איפוס האנרגיה בדיון הסביבתי שכן הדיון באחריות התכנונית בין המחוז לרשות המוניציפאלית מצו׳ בעיצומו110 וכך גם המדיניות הסביבתית הנכתבת כיום שנועדה להגשים את היעדים שנקבעו לא מכבר (במסגרת ועידת האקלים בפריס בדצמבר 2015).
