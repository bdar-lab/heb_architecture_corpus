# file = txt/1400079.txt
# filelineno = 45
# sentno = 1
# text = ניתוח הרגישות אפוא מחד גיסא הצביע על האתגר לאיפוס אנרגיה הכרוך בהבדלים המשמעותיים במאזן האנרגטי שבין טיפולוגיות ושימושי מבנה שונים, אך מאידך גיסא סימן את ההזדמנות הטמונה בסינרגיה אנרגטית בין מבנים, במיוחד לאור מבנה העיר הישראלית הכולל תצרף של מבנים בשימושים ובטיפולוגיות שונים הפועלים במרחב עירוני אחד ושלכל אחד מהם פוטנציאל אחר לייצור ולהתייעלות אנרגטית.
