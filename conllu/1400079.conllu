# file = txt/1400079.txt
# filelineno = 279
# sentno = 2
# text = מודלים יצירתיים של איפוס אנרגיה בתגיות ירוקות (Renewable Energy Certificate), אשראי פחמני או איפוס אנרגיה במצב שהתשתית כולה מוזנת מאנרגיה מתחדשת,36 נחשבים לעדיפים פחות, עלולים ליצור בעיות ניטור, מפרידים בין עקרון ההתייעלות לייצור ובכך במקרים רבים מדכאים מוטיבציה להתייעלות ומנטרלים את הפוטנציאל לצמצום התלות בתשתית מזהמת ויקרה אנרגטית.
