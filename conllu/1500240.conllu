# file = txt/1500240.txt
# filelineno = 299
# sentno = 2
# text = החווה סיפקה מזון לפועלי מפעל הנחושת של Hirsch (לטה 8:1955), ושימשה מוקד הכשרה לפועלים חלוצים בדרכם לישראל, דבר שתאם את חזונו של אורן-וינברג שראה את עתידו של העם היהודי כקשור לעבודת האדמה: "...זו הדרך לעתידו של הנוער היהודי, השתדל להכירה וללכת בה..." (משה 3:1955).
