# file = txt/1500240.txt
# filelineno = 252
# sentno = 2
# text = כך, הגינות המוקדמות שהוקמו מחוץ לחומת העיר העתיקה בירושלים נבנו בחלקן כבוסתן, ושימשו בעיקר לצרכי תועלת, גינות המושבות שהוקמו זמן קצר לאחר מכן הושפעו במעט מסגנון הגן הצרפתי ושימשו בעיקר לצרכי נוי (בן ערב 22:1981), ואילו גינות בתי התושבים בתל אביב שימשו למגוון מטרות בהם נוי, פנאי וקיום (אלון־מוזס 173:2002).
