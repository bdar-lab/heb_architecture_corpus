# file = txt/1500240.txt
# filelineno = 106
# sentno = 6
# text = הגדרה נוספת מתייחסת להיבטים הפיזיים של המודרניזם, אותם היא רואה כגורם מקשר להופעתם של אובייקטים ואירועים חדשים, אשר עם הופעתם מביאים עימם תפישות חדשות המשנות את הקשר בין האובייקט, היצרן, הקהל והלקוחות (1992:4 Hays in Hays, Meyer, & Hilberseimer).
