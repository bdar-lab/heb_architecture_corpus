# file = txt/1300025.txt
# filelineno = 388
# sentno = 1
# text = מהתמונה הכוללת שמתקבלת מהמחקר עולה כי ההתפתחות של כלי ההסכמים, בעיקר באנגליה, אשר מבוססת על שימוש רב שנים בכלי ההסכמים, הצטברות ידע ומידע על פרקטיקה טובה, פסיקה שקבעה גבולות להסדרים אלה, וכן רמת לגיטימציה גבוהה הנשענת על אמו! בשילטון המקומי וביזמים עצמם, יכולה לתרום גם להשגת מטרות מורכבות חברתיות ולאומיות.
