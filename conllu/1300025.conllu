# text = ההסכם היחידי המותר כיום למעשה בהסכמי פיתוח, הוא על פי תקנה 3 לתקנות העיריות (מיכרזים), התשמ"ח-1987 המתירות להטיל על יזם לבצע את עבודות התשתית במתחם הנבנה על ידו, ללא צורך במיכרז לבצוע העבודות, אולם זאת רק במתחמים למגורים או רק בהתקיים תנאים מסויימים, כלומר השימוש בתקנת הפטור על פי די! הוא מצומצם, לעומת הפרשנות הרחבה שהופעלה עד הלכת דירות יוקרה.
# raw = {'id': 2, 'text': 'ההסכם היחידי המותר כיום למעשה בהסכמי פיתוח, הוא על פי תקנה 3 לתקנות העיריות (מיכרזים), התשמ"ח-1987 המתירות להטיל על יזם לבצע את עבודות התשתית במתחם הנבנה על ידו, ללא צורך במיכרז לבצוע העבודות, אולם זאת רק במתחמים למגורים או רק בהתקיים תנאים מסויימים, כלומר השימוש בתקנת הפטור על פי די! הוא מצומצם, לעומת הפרשנות הרחבה שהופעלה עד הלכת דירות יוקרה.', 'dspan': (167, 513), 'tokens': [{'id': (1, 2), 'text': 'ההסכם', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'הסכם', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 16, 'deprel': 'nsubj', 'lemma': 'הסכם'}], 'span': (0, 5), 'dspan': (167, 172)}, {'id': (3, 4), 'text': 'היחידי', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'יחידי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'amod', 'lemma': 'יחידי'}], 'span': (6, 12), 'dspan': (173, 179)}, {'id': (5, 6), 'text': 'המותר', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 6, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 6, 'text': 'מותר', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PUAL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Pass', 'head': 2, 'deprel': 'acl:relcl', 'lemma': 'הותר'}], 'span': (13, 18), 'dspan': (180, 185)}, {'id': 7, 'text': 'כיום', 'upos': 'ADV', 'xpos': 'ADV', 'head': 6, 'deprel': 'advmod', 'dspan': (186, 190), 'span': (19, 23), 'lemma': 'כיום'}, {'id': 8, 'text': 'למעשה', 'upos': 'ADV', 'xpos': 'ADV', 'head': 6, 'deprel': 'advmod', 'dspan': (191, 196), 'span': (24, 29), 'lemma': 'למעשה'}, {'id': (9, 10), 'text': 'בהסכמי', 'expanded': [{'id': 9, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ב'}, {'id': 10, 'text': 'הסכמי', 'upos': 'NOUN'