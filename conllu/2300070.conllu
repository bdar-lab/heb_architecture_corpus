# file = txt/2300070.txt
# filelineno = 294
# sentno = 2
# text = הפרה זו בובעת מצורות התישבות וחקלאות היסטוריות,אשר השפיעו על הנופים בישראל בכלל, וסמפעלי פיתוח שנעשו בתקופה האחרונה, בין הבעיות הבולטות של האזור ביתן להזכיר את: בעיות הניקוז והשטפונות בחלקו התחתון של האגן; נטישת קרקעות חקלאיות באזורי כפרי המיעוטים; רעיית יתר, המהווה הגורם העיקרי להדם וניוון צמחיה, בעיקר באזורי הגבעות וההדים, כתוצאה מחוסר איזון ברעיה ומכדיתה קיימת בעית סחף מדרונות, אשר מהווה גם גודם בזיהום מי נחלים, בנוסף לגורמי זיהום מיסאסרים.
