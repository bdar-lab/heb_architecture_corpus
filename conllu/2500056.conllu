# file = txt/2500056.txt
# filelineno = 125
# sentno = 1
# text = יש לזכור כי הבדיקות הנ״ל נעשו אומנם על אלמנטים מלבניים חסומים בפני תנועה בכיוון האורכי, אשר מייצגים את התופעה ברוב שטחו של לוח הכיסוי, אך אינם מלמדים על המתרחש באיזורי הפינה של הפנל, מקום בו ההצטמקות במישור הלוח חסומה בשני הכיוונים, ובפינות של פתחי חלונות, מזגנים, צנרת וכיו״ב,
