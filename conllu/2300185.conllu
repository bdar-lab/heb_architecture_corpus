# file = txt/2300185.txt
# filelineno = 218
# sentno = 4
# text = דאגת המדינה לחינוך, אם דרך משרד החינוך או האגפים האחראים בשלטון המקומי, הובילה למירכוז המערכת, אולם — "בעשור האחרון ניכרים סימנים להתפתחותם של תהליכי שינוי במערכת החינוך בארץ, ביניהם דרישה לביזור המערכת ולהגברת כוחן של רשויות החינוך בקהילות השונות בעיצוב מדיניות החינוך שלהן, קריאה לקידום האוטונומיה של בתי הספר, להעצמת כוחם של המורים, לגיוון בתכניות לימודים ובדרכי הוראה, להגברת שיתופם של ההורים בעשייה החינוכית ועוד״ (רשף, 1984 ; פור, 1985 ; Kashti, 1991; 1991 ,Arieli, Shapira, אצל: גולן, היימן ושפירא, 1993, 211).
