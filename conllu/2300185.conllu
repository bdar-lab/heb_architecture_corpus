# file = txt/2300185.txt
# filelineno = 58
# sentno = 1
# text = בין תיפקודיה של הקהילה מתאר פרנק (1983), את הניסיון לתת מענים ייחודיים לפרטים ולקבוצות המרכיבים אותה, באותם צרכים אשר אינם באים על סיפוקם באמצעות המערכת החברתית הרחבה או באמצעות מערכת השירותים הפורמלית הקיימת בקהילה; להתאים ולשנות את השירותים ואת מערכות הרווחה השונות כדי לענות בצורה הולמת על צרכים משתנים של הקהילה; לחזק באמצעות השתתפות אזרחים את יכולת הקהילה להכיר בצורכיה, לפתח תחושת כוח וביטחון לפעול לפיתרון בעיותיהם; לפתח יחסי גומלין משמעותיים •בין הפרטים, הקבוצות והארגונים לפיתרון הבעיות או להקלתן, וזאת כדי להגביר את שליטת היחיד על גורלו במידה המירבית.
