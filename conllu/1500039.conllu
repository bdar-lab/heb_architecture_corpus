# sentno = 7
# text = לכן יש לומר – היתר בנייה יבחן לפי התאמתו לתכניות החלות על המקרקעין ולהוראות התקנות וכל דין, ומשיקולים תיכנוניים המסורים לוועדה המקומית, ואילו הסוגיה של השיפוי, תוקפו, ותוכנו תוכרע במקום המתאים לה, שכן ממילא הכרעה בעניין זה אינה הכרח לתהליך הרישוי ואינה נדרשת כחלק חיוני בתהליך זה".
