# sentno = 1
# text = *	לוינסון-זמיר אינה מכוונת, ככל הנראה, לכך שוועדה מקומית תוכל לדרוש כתב-שיפוי, כתנאי למתן היתר בניה, מקום בו התוכנית עצמה אינה מאפשרת זאת; זאת, כיוון שהכלל הוא שהוועדה המקומית חייבת ליתן היתר לבנייה ולשימוש כל מקום שההיתר המבוקש תואם את הוראות התוכנית.
