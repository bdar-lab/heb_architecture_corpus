# file = txt/1500039.txt
# filelineno = 589
# sentno = 1
# text = חלק מן המרואיינים (פתח תקוה; עמק חפר) העלו טענה, לפיה הואיל והוועדה המקומית אינה מי שמאשרת את מרבית התכניות, אלא הוועדה המחוזית – גוף של המדינה – אין מקום להטיל את האחריות לתוצאות אישורן של תכניות אלו (לאמור: לפגיעות התיכנוניות הנגרמות ממנה) על הוועדה המקומית; לפחות לא על הוועדה המקומית לבדה.
