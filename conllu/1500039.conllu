# file = txt/1500039.txt
# filelineno = 661
# sentno = 3
# text = דווח, עם זאת, ששני הצדדים אינם מייחסים משקל רב לוויתור אפשרי על כתב-השיפוי בתמורה להתחייבות יזמית אחרת, או שהוועדה המקומית אינה רואה מקום לוותר על חיוב זה בכל מקרה; זאת, ביסודם של דברים, בשל כך, שנכון להיום, שוויו הכספי הממשי של כתב-השיפוי אינו וודאי.
