# file = txt/1500039.txt
# filelineno = 37
# sentno = 1
# text = הוראה זו נתפשת כמקדמת את האיזון בין זכות הקניין של היחיד-הפרט לבין ההנאה החברתית מתיכנון עירוני בשני מובנים: ראשית, היא משמשת להפנמתו של היבט הפגיעה בקניין הפרטי – שבלעדי הוראה זו נותרת בגדר "עלות חיצונית שלילית" – בשיקול דעתם של המוסדות האחראים על התיכנון העירוני ובכך מתמרצת אותם לבחור בחלופה התיכנונית שהיא הפוגעת-פחות-האפשרית, ומשפרת את איכותו של התיכנון; שנית, פיצויים הם תחליף ותרופה לפגיעה התיכנונית בקניין הפרטי שלא נמנעה.
