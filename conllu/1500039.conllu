# file = txt/1500039.txt
# filelineno = 339
# sentno = 5
# text = אין לשלול כלל וכלל את האפשרות, ולהפך מן הראיות שכן היו בפנינו נראה כי אפשרות זו סבירה יותר, כי הייתה הסכמה בין כל העוסקים במלאכת הכנת התמ"א, אשר איש לא פקפק בה או הרהר אחריה, כי התמ"א תאושר בהתבסס על קיומה של חובת שיפוי מלאה, בת תוקף ומחייבת, אחרת לא הייתה המועצה הארצית מאשרת את התמ"א".
