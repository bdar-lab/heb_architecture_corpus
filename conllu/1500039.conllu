# file = txt/1500039.txt
# filelineno = 244
# sentno = 2
# text = זינגר, אם כן, בדומה ללוינסון-זמיר לפניו, משקיף על השאלה של פגיעות תיכנוניות עקיפות (ופיצויים בגינן) כעל סכסוך בין פרטים – היזם-הנהנה מזה ובעל המקרקעין הנפגעים מזה – שאין לו מקום במסגרת חוק התיכנון והבנייה, אלא צריך להתברר בהתאם לדיני המטרדים; גישתו העקרונית היא שאין מקום להכיר בזכות לפיצויים בגין פגיעות תיכנוניות, אך מקום בו כן יש להכיר בכזו – כגון, ביחס לפגיעות תיכנוניות ישירות – נראה שעמדתו של זינגר תהיה כי יש גם הצדקה לוועדה המקומית להשתפות על כספים אלו מהיזם-הנהנה מהתוכנית.
