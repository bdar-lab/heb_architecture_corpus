# file = txt/1500039.txt
# filelineno = 283
# sentno = 7
# text = שנית, מכך שבית המשפט רואה בוועדה המקומית ובחברה הקבלנית משום צדדים שווי-כוח יחסית, שמתקיים ביניהם משא ומתן אמיתי; זאת, להבדיל, לדוגמה, ממצב בו החברה הקבלנית רק נכנעת לתכתיבים של הוועדה המקומית.
