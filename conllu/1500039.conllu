# file = txt/1500039.txt
# filelineno = 399
# sentno = 1
# text = וועדת-הערר דחתה את הטענה אך ציינה שכתב-שיפוי יכול היה להיות פתרון צודק בנסיבות העניין: כתב-שיפוי היה מעביר את נטל הפיצויים אל היזם, ובכך מספק את הוועדה המקומית, מחד גיסא, והיה נותן מענה לפגיעות התיכנוניות שנגרמו לעוררים, שאין הצדקה כי יישאו בהן לבדם, מאידך גיסא.
