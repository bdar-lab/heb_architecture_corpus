# text = המרואיינים הוסיפו, כי שאלת מיהותו של יוזם התוכנית משנית בעיניהם לשאלת מהותו של הרווח מהתוכנית; במלים אחרות: הוועדה המקומית, כך דווח, בוחנת האם התוכנית היא "ציבורית" באופייה – לאמור: מניבה רווח ותועלת לציבור המקומי או הרחב – או "פרטית" – לאמור: כזו שיש עימה רווח כלכלי-כספי שניתן לזהות "כיס" מסויים הנהנה ממנו במיוחד, אפילו אם "כיס" זה הוא של גוף שמקובל לסווגו כ"ציבורי" לצרכים אחרים, כגון מינהל מקרקעי ישראל או חברת החשמל.
# raw = {'id': 1, 'text': 'המרואיינים הוסיפו, כי שאלת מיהותו של יוזם התוכנית משנית בעיניהם לשאלת מהותו של הרווח מהתוכנית; במלים אחרות: הוועדה המקומית, כך דווח, בוחנת האם התוכנית היא "ציבורית" באופייה – לאמור: מניבה רווח ותועלת לציבור המקומי או הרחב – או "פרטית" – לאמור: כזו שיש עימה רווח כלכלי-כספי שניתן לזהות "כיס" מסויים הנהנה ממנו במיוחד, אפילו אם "כיס" זה הוא של גוף שמקובל לסווגו כ"ציבורי" לצרכים אחרים, כגון מינהל מקרקעי ישראל או חברת החשמל.', 'dspan': (0, 422), 'tokens': [{'id': (1, 2), 'text': 'המרואיינים', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'מרואיינים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 3, 'deprel': 'nsubj', 'lemma': 'מרואיין'}], 'span': (0, 10), 'dspan': (0, 10)}, {'id': 3, 'text': 'הוסיפו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem,Masc|HebBinyan=HIFIL|Number=Plur|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (11, 17), 'span': (11, 17), 'lemma': 'הוסיף'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (17, 18), 'span': (17, 18), 'lemma': ','}, {'id': 5, 'text': 'כי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 13, 'deprel': 'mark', 'dspan': (19, 21), 'span': (19, 21), 'lemma': 'כי'}, {'id': 6, 'text': 'שאלת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 13, 'deprel': 'nsubj', 'dspan': (22, 26), 'span': (22, 26), 'lemma': 'שאלה'}, {'id': (7, 8), 'text': 'מיהותו', 'expanded': [{'id': 7, 'text': 'מיהות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'compound:smixut', 'lemma': 'מיהות'}, {'id': 8, 'text': 'ו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Definite=Def|Gender=Masc|Number=Sing|Person=3|Poss=Yes|PronType=Prs', 'head': 7, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (27, 33), 'dspan': (27, 33)}, {'id': 9, 'text': 'של',