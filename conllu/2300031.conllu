# text = את סמכות שר האוצר להפקיע למטרת בניה לעולים תקפו לא פעם בבתי המשפט, וכבר בשנת 1952 בבג״צ דור, התבקש ביטול הפקעת קרקע ליד שפרעם למטרת שיכון לעולים חדשים, בנימוק: "אדמת המבקשים אינה דרושה לצורכי ציבור כלל, ואין כאן אלא 'תכנית סוציאליסטית' (בלשונם ממש) ערוכה ומכוונת מראש להפקיע קרקע מידי אדם אחד כדי למסרה לידי אחר...".
# raw = {'id': 1, 'text': 'את סמכות שר האוצר להפקיע למטרת בניה לעולים תקפו לא פעם בבתי המשפט, וכבר בשנת 1952 בבג״צ דור, התבקש ביטול הפקעת קרקע ליד שפרעם למטרת שיכון לעולים חדשים, בנימוק: "אדמת המבקשים אינה דרושה לצורכי ציבור כלל, ואין כאן אלא \'תכנית סוציאליסטית\' (בלשונם ממש) ערוכה ומכוונת מראש להפקיע קרקע מידי אדם אחד כדי למסרה לידי אחר...".', 'dspan': (0, 316), 'tokens': [{'id': 1, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 2, 'deprel': 'case:acc', 'dspan': (0, 2), 'span': (0, 2), 'lemma': 'את'}, {'id': 2, 'text': 'סמכות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 13, 'deprel': 'obj', 'dspan': (3, 8), 'span': (3, 8), 'lemma': 'סמכות'}, {'id': 3, 'text': 'שר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'compound:smixut', 'dspan': (9, 11), 'span': (9, 11), 'lemma': 'שר'}, {'id': (4, 5), 'text': 'האוצר', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'אוצר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'compound:smixut', 'lemma': 'אוצר'}], 'span': (12, 17), 'dspan': (12, 17)}, {'id': 6, 'text': 'להפקיע', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=HIFIL|VerbForm=Inf|Voice=Act', 'head': 13, 'deprel': 'xcomp', 'dspan': (18, 24), 'span': (18, 24), 'lemma': 'הפקיע'}, {'id': (7, 8), 'text': 'למטרת', 'expanded': [{'id': 7, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ל'}, {'id': 8, 'text': 'מטרת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'obl', 'lemma': 'מטרה'}], 'span': (25, 30), 'dspan': (25, 30)}, {'id': 9, 'text': 'בניה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'compound:smixut', 'dspan': (31, 35), 'span': (31, 35), 'lemma': 'בנייה'}, {