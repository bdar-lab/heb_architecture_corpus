# file = txt/2300031.txt
# filelineno = 171
# sentno = 7
# text = דרך ארוכה עבר כוח ההפקעה מאז השימוש החסכני בו, בתחילתו, ועד לשימוש הנרחב בו במסגרת התכנון הפוזיטיבי, ובגירסאות השונות של החוק, היחס לנושא זה נע בין גמישות לנוקשות, בין העדפת זכות הקנין הפרטי לבין צורכי התכנון והחברה, בהתאם לאירועים שברקע ולמפלגת השלטון.
