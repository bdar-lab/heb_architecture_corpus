# text = שינויים טכניים ואדמיניסטרטיביים בהסדרים הקיימים, אשר יוצעו במסגרת מסקנות אלה, ניתנים לבחינה בקני-מידה של תרומתם ליעילות ההסדרים, אולם מובן, כי כל שינוי מהותי אשר יוצע, בדרך הטבע איננו משקף עמדה אוביקטיבית לחלוטין (אם קיימת בכלל עמדה כזו), אלא הוא נובע מהשקפת עולם ואופן ראיית פני הדברים ע״י מציע השינוי.
# raw = {'id': 1, 'text': 'שינויים טכניים ואדמיניסטרטיביים בהסדרים הקיימים, אשר יוצעו במסגרת מסקנות אלה, ניתנים לבחינה בקני-מידה של תרומתם ליעילות ההסדרים, אולם מובן, כי כל שינוי מהותי אשר יוצע, בדרך הטבע איננו משקף עמדה אוביקטיבית לחלוטין (אם קיימת בכלל עמדה כזו), אלא הוא נובע מהשקפת עולם ואופן ראיית פני הדברים ע״י מציע השינוי.', 'dspan': (0, 303), 'tokens': [{'id': 1, 'text': 'שינויים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 17, 'deprel': 'nsubj', 'dspan': (0, 7), 'span': (0, 7), 'lemma': 'שינוי'}, {'id': 2, 'text': 'טכניים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'amod', 'dspan': (8, 14), 'span': (8, 14), 'lemma': 'טכניים'}, {'id': (3, 4), 'text': 'ואדמיניסטרטיביים', 'expanded': [{'id': 3, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 4, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 4, 'text': 'אדמיניסטרטיביים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'conj', 'lemma': 'אדמיניסטרטיביים'}], 'span': (15, 31), 'dspan': (15, 31)}, {'id': (5, 6), 'text': 'בהסדרים', 'expanded': [{'id': 5, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ב'}, {'id': 6, 'text': 'הסדרים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'nmod', 'lemma': 'הסדר'}], 'span': (32, 39), 'dspan': (32, 39)}, {'id': (7, 8), 'text': 'הקיימים', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'קיימים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 6, 'deprel': 'amod', 'lemma': 'קיים'}], 'span': (40, 47), 'dspan': (40, 47)}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (47, 48), 'span': (47, 48), 'lemma': ','}, {'id': 10, 'text': 'אשר', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 11, 'deprel': 'mark', 'dspan': (49, 52), 's