# file = txt/2300031.txt
# filelineno = 64
# sentno = 3
# text = ביקורת חריפה במוסד ההפקעה מטיחים Lowi & Ginsberg בסיפרם 1976) Poliscide), בו הם טוענים כי הציבור בוחר להתעלם מנושא זה, בהיותו בלתי נוח ומטריד, ולפיכך, תחת מעטה חשאיות, נוטלות לעצמן הרשויות המפקיעות "תפקיד של אלוהים", ללא בקרה שיטתית של התהליך, ומבלי שמישהו יערער על מעשיהן.
