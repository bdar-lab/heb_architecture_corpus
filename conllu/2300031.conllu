# file = txt/2300031.txt
# filelineno = 171
# sentno = 5
# text = דבר זה בא על תיקונו רק ב- 1953 ע״י ממשלה שמרנית, שכוננה הסדר של פיצוי בלתי מוגבל בזמן, ובשנת 1961 נקבע כי בעת הפקעה יש לשלם פיצויים לא רק עבור השימוש הקיים, אלא גם עבור פוטנציאל הפיתוח המלא של הקרקע, ובהערכת פיצויי ההפקעה הוכללו גם "הנחות פיתוח" planning assumptions (עליהן נעמוד בהמשך).
