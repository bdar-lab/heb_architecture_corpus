# file = txt/2000055.txt
# filelineno = 72
# sentno = 1
# text = גלנור (1985) מסביר שהסדרים קורפורטיסטים שנעשו בעת שהמדינה נקלעה למשברי משילות, בשל חולשת המערכת השלטונית, אפשרו לקבוצות האינטרס שהשתתפו בהם להמשיך ולהנות מהעדפה סקטוריאלית, למרות שהסיבות לעשיית ההסדרים שוב לא היו תקפות (אצל אריאן 1998:53).
