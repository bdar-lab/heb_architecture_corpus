# file = txt/2000055.txt
# filelineno = 1136
# sentno = 3
# text = דורון רוזנבלום מתאר זאת כך: "...כבר שנו חכמי מפא״י: ׳אל תחסום שור בדישו׳, וכן: ׳מוטב סוסים דוהרים מאשר פרים עצלים"... וכי הייתה לנו ברירהי וכי יש לנו שליטה על זהי כתאומתה "האינרציה הביטחונית" גם "תנופת ההתיישבות" היא בת זקונים ל״שוונג הציוני״ ול״עשייה התנועתית״: היא רואה שטח משוחרר ־ ומיד היא מתחילה בהכשרת הקרקע; וכיוון שהקרקע הוכשרה ־ מתחילה הכשרת הלבבות ומועלית למקום הכשרה של איזה מאחז, המבשיל לאיטו והופך לגרעין, הצומח והופך לקיבוץ העוסק בהכשרת עופות, המבשיל למרכז אזורי המתפתח לאגד ערים, אם לא לנמל עמוק מים״ (רוזנבלום 1994).
