# text = לערבים בישראל אין עדיין מנגנון לפעולה מתואמת בתחום התכנון (בימים אלה נעשה ניסיון להקים את המרכז הערבי לתכנון, לשם כך (ראיון: חנא סוויד)), אך יש מודעות גבוהה לחשיבותו, יש ציבור אנשי מקצוע שפועלים בתחומי התכנון (מקצוע התכנון הוא אחד מערוצי המוביליות הפתוחים בפני צעירים ערבים), ויש לגיטימציה רבה יותר מצד מערכת התכנון עצמה להשתתפותם של ערבים.
# raw = {'id': 4, 'text': 'לערבים בישראל אין עדיין מנגנון לפעולה מתואמת בתחום התכנון (בימים אלה נעשה ניסיון להקים את המרכז הערבי לתכנון, לשם כך (ראיון: חנא סוויד)), אך יש מודעות גבוהה לחשיבותו, יש ציבור אנשי מקצוע שפועלים בתחומי התכנון (מקצוע התכנון הוא אחד מערוצי המוביליות הפתוחים בפני צעירים ערבים), ויש לגיטימציה רבה יותר מצד מערכת התכנון עצמה להשתתפותם של ערבים.', 'dspan': (676, 1016), 'tokens': [{'id': (1, 3), 'text': 'לערבים', 'expanded': [{'id': 1, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'lemma': 'ל'}, {'id': 2, 'text': 'ה_', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'ערבים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 6, 'deprel': 'obl', 'lemma': 'ערבי'}], 'span': (0, 6), 'dspan': (676, 682)}, {'id': (4, 5), 'text': 'בישראל', 'expanded': [{'id': 4, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'ב'}, {'id': 5, 'text': 'ישראל', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 3, 'deprel': 'nmod', 'lemma': 'ישראל'}], 'span': (7, 13), 'dspan': (683, 689)}, {'id': 6, 'text': 'אין', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Polarity=Neg', 'head': 0, 'deprel': 'root', 'dspan': (690, 693), 'span': (14, 17), 'lemma': 'אין'}, {'id': 7, 'text': 'עדיין', 'upos': 'ADV', 'xpos': 'ADV', 'head': 6, 'deprel': 'advmod', 'dspan': (694, 699), 'span': (18, 23), 'lemma': 'עדיין'}, {'id': 8, 'text': 'מנגנון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'nsubj', 'dspan': (700, 706), 'span': (24, 30), 'lemma': 'מנגנון'}, {'id': (9, 10), 'text': 'לפעולה', 'expanded': [{'id': 9, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ל'}, {'id': 10, 'text': 'פעולה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 8, 'deprel': 'nmod', 'lemma': 'פעולה'}], 'span': (31, 37), 'dspan': (707, 713)}, {'id': 11, 'text': 'מתואמת', 'upo