# file = txt/2000055.txt
# filelineno = 984
# sentno = 2
# text = בדיונים לקראת הכנת תמ״א/35 אמר חבר המועצה ד״ר חנא סוויד, שהמצב בקרב הערבים מחייב אפליה מתקנת, טיפול בבעיית הישובים הלא־מוכרים, במחסור בשטחים לפיתוח, ובמחסור במקורות תעסוקה בישובים הערבים (ישיבת המועצה הארצית מס׳ 8.10.1996,353).
