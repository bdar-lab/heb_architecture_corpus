# file = txt/2000055.txt
# filelineno = 682
# sentno = 2
# text = אולם המחלוקת החריפה מאד עם המשבר הפיננסי של שנות ה-80׳ מכיוון שהתנועה מצאה עצמה במלכוד: יכולתה לממן פעילות התיישבותית פחתה מאוד בשל הירידה בהעברות מהמדינה, אך מאידך חששה שצמצום פעילותה ההתישבותית תפגע עוד יותר ביכולתה לדרוש משאבים מהמדינה (אברהמי 1993:22-31).
