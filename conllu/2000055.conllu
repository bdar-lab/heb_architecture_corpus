# file = txt/2000055.txt
# filelineno = 839
# sentno = 4
# text = בנוגע לסוגיית ההתיישבות מעבר לקו הירוק, מציין אליעזר ברוצקוס שעורכי התכנית השתדלו להימנע מסוגיות הנתונות למחלוקת פוליטית, ובנושאים בהם הנחיות הממשלה לא היו ברורות דיין פעלו על פי מיטב שיפוטם המקצועי (ישיבת המועצה הארצית מס׳ 7.12.1971,69).
