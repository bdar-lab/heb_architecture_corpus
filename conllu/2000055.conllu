# file = txt/2000055.txt
# filelineno = 781
# sentno = 5
# text = הקשרים עם ממלאי תפקידים במגזר הציבורי ־ הממונה על המחוז, ראשי רשויות, מנהלים ומתכננים - מאפשרים לחברה להטמיע את תפיסותיה התכנוניות בקרב אנשי המקצוע (כמו הצורך בריכוז הפיתוח ושמירת שטחים פתוחים, המושג "כביש נופי", העדפת מנהור על פגיעה בנוף, ועוד) ואף להטמיע תפיסות אלו בתכניות סטטוטוריות (כמו ההשפעה על תמ״א/31 ושינוי 7 לתמ״א/3).
