# file = txt/2000055.txt
# filelineno = 1143
# sentno = 3
# text = שיתוף הפעולה בין הון פרטי וציבורי נמשך לאחר הקמת המדינה כאשר שרי האוצר מטעם מפא״י עודדו השקעות פרטיות ופעלו לריסון עצמתו של המשק הקואופרטיבי (במיוחד ידוע מאבקה של מפא״י לפרוק סולל בונה) אך בה בעת הגדילו את הסקטור הציבורי הממלכתי על ידי הקמת מפעלים תעשייתיים( כמו התעשיה האווירית) והלאמתם של אחרים (כמו תעשיית מחצבי ישראל שנעשתה לכימיקלים לישראל) (הורוביץ וליסק 1990:168-170, לוי־פאור 1994).
