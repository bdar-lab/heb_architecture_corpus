# file = txt/2000055.txt
# filelineno = 894
# sentno = 1
# text = עם זאת, בעוד תמ״א/6 הציבה יעדי אוכלוסייה לא ריאליים לערבים בצפון הארץ, מתוך צפיה להגירה שלהם למישור החוף, תמ״א/1/6 כבר מכירה ביציבות המרחבית של הערבים ומותירה את "הטיפול" בהם לתכניות אזוריות שנועדו למנוע מהם רצפים טריטוריאליים (כמו תכנית המצפים בגוש שגב) (חמאיסי 64־1990:63, ראיון: ראסם חמאיסי).
