# file = txt/2000055.txt
# filelineno = 12
# sentno = 1
# text = חקרי הארוע משתרעים לפיכך על תקופה של כמעט עשרים שנה, ומאפשרים משום כך להבחין במגמות ארוכות טווח כמו: שינויים בדפוס עיצוב המדיניות המרחבית (דפוס אליטיסטי, קורפורטיסטי או פלורליסטי), תזוזות במיקומן החברתי של קבוצות האוכלוסייה ביחס למרכז, הקמתן והתפתחותן של קבוצות אינטרס, ושינויי□ בתכנון המרחבי עצמו (בתפישת תפקידו של התכנון, במטרותיו ובמתודה המקצועית).
