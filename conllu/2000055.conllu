# file = txt/2000055.txt
# filelineno = 358
# sentno = 2
# text = עזרא סדן, מעורכי תמ״א/31, אף מכליל ואומר שהאמצעים שיש בידי מערכת התכנון הטטוטורית הם אמצעים מנהליים בולמים בלבד, ואלו מטיבם יוצרים "קשיחויות" הפוגעות בהקצאה מיטבית של המשאבים (ישיבת המועצה הארצית מס׳ 14.4.1990,296).
