# file = txt/2300019.txt
# filelineno = 8
# sentno = 2
# text = הן מבוססות בעיקרן על מחקרים שערכתי בשיתוף עם עמיתי, בתמיכת מוסד שמואל נאמן למחקר מתקדם במדע ובטכנולוגיה, תוך ליווי פרויקט השיקום לאורך כל שנותיו; החל מניתוח מאפייני שכונות המצוקה והגורמים להידרדרותן, דרך בחינתן של אלטרנטיבות פעולה שעמדו בפניו, בעיקר בתחום שיפור הדיור, ועד מחקרי הערכה כוללניים (רשימת המחקרים ועיקרי ממצאיהם בספר חדש: כרמון, 1989).
