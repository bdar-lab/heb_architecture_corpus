# sentno = 3
# text = לדעתו, התפתחות העיר חיפה פנתה בעיקרה למילוי השטח הצר לאורך רצועת החוף תוך התקדמות כלפי דרום־מערב או כלפי צפון־מזרח, ורק מאוחר יותר, החל משנות ה־20, היא פנתה לעבר מדרגת ההר הנמוכה בין ואדי סאליב לואדי ניסנאס, כאשר החלה התפתחות מואצת של שכונת הדר.
