# text = ניתוח מודלים תלת ממדים מורכבים: את עקרון המודל הספרתי של פני השטח ניתן לנצל בדרכים מגוונות -כגון בעת הכנת התה״ס לשדה התעופה השני של מינכן, נבחנו והוצגו תחומי הרעש והשפעתם ע״י המרת תחומי הרעש והצגתם במודל תלת ממדי, כאשר נתון הגובה יצג את רמת הרעש המקומית, תוך התחשבות בצפיפות האוכלוסיה וסוג שימושי הקרקע (1990 ,Schaller) .
# raw = {'id': 1, 'text': 'ניתוח מודלים תלת ממדים מורכבים: את עקרון המודל הספרתי של פני השטח ניתן לנצל בדרכים מגוונות -כגון בעת הכנת התה״ס לשדה התעופה השני של מינכן, נבחנו והוצגו תחומי הרעש והשפעתם ע״י המרת תחומי הרעש והצגתם במודל תלת ממדי, כאשר נתון הגובה יצג את רמת הרעש המקומית, תוך התחשבות בצפיפות האוכלוסיה וסוג שימושי הקרקע (1990 ,Schaller) .', 'dspan': (0, 321), 'tokens': [{'id': 1, 'text': 'ניתוח', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'ניתוח'}, {'id': 2, 'text': 'מודלים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'compound', 'dspan': (6, 12), 'span': (6, 12), 'lemma': 'מודלים'}, {'id': 3, 'text': 'תלת', 'upos': 'ADV', 'xpos': 'ADV', 'feats': 'Prefix=Yes', 'head': 4, 'deprel': 'compound:affix', 'dspan': (13, 16), 'span': (13, 16), 'lemma': 'תלת'}, {'id': 4, 'text': 'ממדים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'amod', 'dspan': (17, 22), 'span': (17, 22), 'lemma': 'ממד'}, {'id': 5, 'text': 'מורכבים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'amod', 'dspan': (23, 30), 'span': (23, 30), 'lemma': 'מורכב'}, {'id': 6, 'text': ':', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 17, 'deprel': 'punct', 'dspan': (30, 31), 'span': (30, 31), 'lemma': ':'}, {'id': 7, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 8, 'deprel': 'case', 'dspan': (32, 34), 'span': (32, 34), 'lemma': 'את'}, {'id': 8, 'text': 'עקרון', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 17, 'deprel': 'obj', 'dspan': (35, 40), 'span': (35, 40), 'lemma': 'עיקרון'}, {'id': (9, 10), 'text': 'המודל', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 10, 'deprel': 'det', 'lemma': 'ה'}, {'id': 10, 'text': 'מודל', 'upos': 'NOUN', 'x