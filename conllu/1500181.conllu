# file = txt/1500181.txt
# filelineno = 424
# sentno = 3
# text = 93 ביקורת זו מתקשרת ל"חיבוק הדוב" הממסדי שעשוי לטרפד התהוותן של התאגדויות פוליטיות אשר יהוו אלטרנטיבה אמיתית (ראה פרק 7.5, החל מעמי 73) דעות מסוג זה ממחישות את הפולמוס האידיאולוגי הער שמתקיים בשכונת הדר, בעיקר בקרב צעירים אקטיביסטים.
