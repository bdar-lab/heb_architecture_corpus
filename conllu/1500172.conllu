# text = ממצאי הבדיקה יאפשרו הפעלה של אמצעי פיקוח ואכיפה עירוניים, אשר בקריית שמונה, לשמל, יגבילו את הקמת יחידות המשנה לאירוח תיירותי והשכרתן לסטודנטים ־ תופעה נפוצה שהיקפה מתרחב ועשוי להגיע לממדים גדולים במיוחד (כפי שעולה מראיונות 5א ו-27א, וכן לאור ׳הפוטנציאל התב״עי׳ העומד על 2,500 יחידות דיור בכל רחבי העיר - היקף הגבוה מסך הסטודנטים הגרים כיום בעיר בכל צורות וסוגי המגורים).
# raw = {'id': 2, 'text': 'ממצאי הבדיקה יאפשרו הפעלה של אמצעי פיקוח ואכיפה עירוניים, אשר בקריית שמונה, לשמל, יגבילו את הקמת יחידות המשנה לאירוח תיירותי והשכרתן לסטודנטים ־ תופעה נפוצה שהיקפה מתרחב ועשוי להגיע לממדים גדולים במיוחד (כפי שעולה מראיונות 5א ו-27א, וכן לאור ׳הפוטנציאל התב״עי׳ העומד על 2,500 יחידות דיור בכל רחבי העיר - היקף הגבוה מסך הסטודנטים הגרים כיום בעיר בכל צורות וסוגי המגורים).', 'dspan': (136, 506), 'tokens': [{'id': 1, 'text': 'ממצאי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'nsubj', 'dspan': (136, 141), 'span': (0, 5), 'lemma': 'ממצא'}, {'id': (2, 3), 'text': 'הבדיקה', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'בדיקה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'compound:smixut', 'lemma': 'בדיקה'}], 'span': (6, 12), 'dspan': (142, 148)}, {'id': 4, 'text': 'יאפשרו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem,Masc|HebBinyan=PIEL|Number=Plur|Person=3|Tense=Fut|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (149, 155), 'span': (13, 19), 'lemma': 'אפשר'}, {'id': 5, 'text': 'הפעלה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'obj', 'dspan': (156, 161), 'span': (20, 25), 'lemma': 'הפעלה'}, {'id': 6, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 7, 'deprel': 'case:gen', 'dspan': (162, 164), 'span': (26, 28), 'lemma': 'של'}, {'id': 7, 'text': 'אמצעי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'nmod:poss', 'dspan': (165, 170), 'span': (29, 34), 'lemma': 'אמצע'}, {'id': 8, 'text': 'פיקוח', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'compound:smixut', 'dspan': (171, 176), 'span': (35, 40), 'lemma': 'פיקוח'}, {'id': (9, 10), 'text': 'ואכיפה', 'expanded': [{