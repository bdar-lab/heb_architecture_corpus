# file = txt/1500172.txt
# filelineno = 219
# sentno = 1
# text = 2005) Frierson), אשר בחן לעומקו נושא זה בערי אוניברסיטה בארה״ב, קנדה ואנגליה, מצא כי ניסיונות חקיקה ואכיפה אלה מבקשים להסדיר אחד משניים: הסדרה של מגורים בשוק הדיור הפרטי בכדי להגביל את ריכוזי הסטודנטים בשכונות, או הקמה של מגורים ייעודיים לסטודנטים (מעונות), על מנת להגדיל את היצע המגורים של סטודנטים בתחומי הקמפוסים, במקום מגוריהם בשכונות.
