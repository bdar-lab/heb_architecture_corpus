# raw = {'id': 1, 'text': 'הגידול המשמעותי במספר הסטודנטים, השוכרים דירות בעיירה Loughborough, הוביל למתח והתנגדות בקרב התושבים המקומיים, אשר התאגדו במטרה להעלות את המודעות הציבורית להשלכות השליליות של מגורי הסטודנטים והפרת האיזון והסדר הציבורי בעיר.', 'dspan': (0, 223), 'tokens': [{'id': (1, 2), 'text': 'הגידול', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'גידול', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 18, 'deprel': 'nsubj', 'lemma': 'גידול'}], 'span': (0, 6), 'dspan': (0, 6)}, {'id': (3, 4), 'text': 'המשמעותי', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'משמעותי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'amod', 'lemma': 'משמעותי'}], 'span': (7, 15), 'dspan': (7, 15)}, {'id': (5, 6), 'text': 'במספר', 'expanded': [{'id': 5, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 6, 'text': 'מספר', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Cons', 'head': 8, 'deprel': 'det', 'lemma': 'מספר'}], 'span': (16, 21), 'dspan': (16, 21)}, {'id': (7, 8), 'text': 'הסטודנטים', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'סטודנטים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'nmod', 'lemma': 'סטודנט'}], 'span': (22, 31), 'dspan': (22, 31)}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 8, 'deprel': 'punct', 'dspan': (31, 32), 'span': (31, 32), 'lemma': ','}, {'id': (10, 11), 'text': 'השוכרים', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 11, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 11, 'text': 'שוכרים', 'upos': 'VERB', 'xpos': 'VERB', 'f