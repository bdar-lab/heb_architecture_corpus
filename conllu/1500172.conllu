# file = txt/1500172.txt
# filelineno = 727
# sentno = 2
# text = בחלק גדול מן המקרים אירועים אלה פונים לציבור הרחב, אשר הסטודנטים מהווים חלק ממנו, תורמים להגדלת הקהל ומאפשרים קיומם או תורמים לרווחיות הפעילות המתקיימת, למשל: הופעות של אמנים, המוזמנים על-ידי הרשות המקומית (ראיון א17) או על־ ידי גורמים פרטים (בתי עסק), בהם הסטודנטים מהווים אחוז ניכר מקהל הצופים.
