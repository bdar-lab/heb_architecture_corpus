# file = txt/1500172.txt
# filelineno = 171
# sentno = 2
# text = מצב זה מייצר מציאות בה הסטודנטיות (studenthood) עצמה עוברת תהליכי ג׳נטרפיקציה (2009 ,Hubbard), במסגרתה משתנה תפקידם של הסטודנטים: הם אינם עוד יצרנים אקטיביים והרפתקנים של תהליכי ג׳נטרפיקציה מסורתיים, אלא מהווים צרכנים, מובלים, המקבלים על עצמם סדר מרחבי שמישהו אחר ייעד עבורם, מבלי שהם נוטים לחרוג ממנו.
