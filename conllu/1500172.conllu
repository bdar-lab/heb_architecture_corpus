# file = txt/1500172.txt
# filelineno = 57
# sentno = 2
# text = באופן מסורתי, תרומתם החברתית יכולה להתבטא במתן שירותי רפואה טובים יותר, בשיפור רמת החינוך, בהגדלת מגוון השירותים הציבוריים ואף בעידוד הגירה של אוכלוסייה חיצונית לאזור (מאיר ודואניאס, 2006; פרנקל וישראל, 2007; דהן, 2011).
