# text = בניית מגורים ייעודיים לסטודנטים עשויה להביא לשינוי באופי הבנייה באזור, כגון: גובה המבנים, גודל וסגנון יחידות הדיור, מאפיינים ארכיטקטוניים וכדומה ( ,Fincher and Shaw 2009), או לשינויים במרחב הציבורי, כגון: שינוי בשטחי ציבור, גידור מתחמים ואף סגירת רחובות תוך בקרת מעברם של אנשים בהם (אלפסי ואחרים, 2012).
# raw = {'id': 3, 'text': 'בניית מגורים ייעודיים לסטודנטים עשויה להביא לשינוי באופי הבנייה באזור, כגון: גובה המבנים, גודל וסגנון יחידות הדיור, מאפיינים ארכיטקטוניים וכדומה ( ,Fincher and Shaw 2009), או לשינויים במרחב הציבורי, כגון: שינוי בשטחי ציבור, גידור מתחמים ואף סגירת רחובות תוך בקרת מעברם של אנשים בהם (אלפסי ואחרים, 2012).', 'dspan': (252, 555), 'tokens': [{'id': 1, 'text': 'בניית', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'nsubj', 'dspan': (252, 257), 'span': (0, 5), 'lemma': 'בנייה'}, {'id': 2, 'text': 'מגורים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'compound:smixut', 'dspan': (258, 264), 'span': (6, 12), 'lemma': 'מגורים'}, {'id': 3, 'text': 'ייעודיים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'amod', 'dspan': (265, 273), 'span': (13, 21), 'lemma': 'ייעודי'}, {'id': (4, 5), 'text': 'לסטודנטים', 'expanded': [{'id': 4, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'ל'}, {'id': 5, 'text': 'סטודנטים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'nmod', 'lemma': 'סטודנט'}], 'span': (22, 31), 'dspan': (274, 283)}, {'id': 6, 'text': 'עשויה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (284, 289), 'span': (32, 37), 'lemma': 'עשוי'}, {'id': 7, 'text': 'להביא', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=HIFIL|VerbForm=Inf|Voice=Act', 'head': 6, 'deprel': 'xcomp', 'dspan': (290, 295), 'span': (38, 43), 'lemma': 'הביא'}, {'id': (8, 9), 'text': 'לשינוי', 'expanded': [{'id': 8, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ל'}, {'id': 9, 'text': 'שינוי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 7, 'deprel': 'obl', 'lemma': 'שינוי'}], 'span': (44, 50), 'dspan': (296, 302)}, {'id': (10, 11), 'text': 'בא