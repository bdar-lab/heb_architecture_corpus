# file = txt/1500172.txt
# filelineno = 413
# sentno = 2
# text = מראיון שנערך עם תווך דירות ממשרד תיווך המתמחה בשוק הסטודנטיאלי בעיר (ראיון א5) עולה כי קיימים שלושה אזורים המועדפים על סטודנטים: 1) שכונת יגאל אלון וסביבתה, 2) שכונות א׳, ב׳, ו-ו׳ שבהן "יש המון צמודי קרקע שנעשו בהם הרחבות לא חוקיות...עבור יחידות דיור המשמשות כיום סטודנטים", ו־3) אזור רחוב שפרינצק שבו "אין אפילו בניין אחד שאין בו לפחות 3־2 דירות סטודנטים״ ובו אף קיים בניין שכל 7 הדירות בו נקנו על ידי משקיעים אשר הפכו את כולו לבניין סטודנטים בלבד.
