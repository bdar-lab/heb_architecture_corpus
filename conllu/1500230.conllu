# file = txt/1500230.txt
# filelineno = 414
# sentno = 4
# text = במקום שעתוק בלוק המגורים האורכני של שנות ה-50, מלאה הארץ במציאות בת זמננו שוב שמלת בטון ומלט, בשעתוק טיפולוגית "העיר הקורנת" (1935 Corbusier), במגדלים מנותקים בני עשרות קומות, דוגמת שכונות עכשווית: נווה שרת תל אביב לאחר פינוי בינוי (איורים 6.4, 6.5), עיר ימים בנתניה, אם המושבות בפתח תקווה.
