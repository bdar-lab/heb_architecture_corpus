# file = txt/1500230.txt
# filelineno = 267
# sentno = 9
# text = תערוכת שיכונים מבפנים (שדר 2010) ומכונת המגורים המזרחית (יעקובי 2007), בחרו להביט על ארגז הכלים תלוי התרבות באופן ספציפי של קבוצת המהגרים המזרחיים, למרות שאופני הטיפוח בחומרים אקראיים נצפים באופן רחב בעשייה מרחבית של התושבים.
