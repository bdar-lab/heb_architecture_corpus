# text = רק לאחר המלחמה הגדולה באו להכרה של פיתוח קרקע מכוון ותעודתי והעמדת בתי דירה בשורות פתוחות (Zeilenbau) המרחקים הנקבעים ע"י הזוית של השמש המקרינה, ובתוך שטחי ירק וגנים.......בגישתנו להקמת בתים משותפים ביטלנו אמנם את המגרשים הפרטיים הקטנים והעמדנו את הדירות שורות שורות במרחקים מכסימאליים... באופן יותר עקבי נפתרה השאלה במעונות עובדים חי... במקום שהבתים עומדים בו שורות שורות בתוך גינת ירק..." (חוברת הבניין אוגוסט 1937 בתוך: תיק תיעוד מעונות עובדים חי)
# raw = {'id': 2, 'text': 'רק לאחר המלחמה הגדולה באו להכרה של פיתוח קרקע מכוון ותעודתי והעמדת בתי דירה בשורות פתוחות (Zeilenbau) המרחקים הנקבעים ע"י הזוית של השמש המקרינה, ובתוך שטחי ירק וגנים.......בגישתנו להקמת בתים משותפים ביטלנו אמנם את המגרשים הפרטיים הקטנים והעמדנו את הדירות שורות שורות במרחקים מכסימאליים... באופן יותר עקבי נפתרה השאלה במעונות עובדים חי... במקום שהבתים עומדים בו שורות שורות בתוך גינת ירק..." (חוברת הבניין אוגוסט 1937 בתוך: תיק תיעוד מעונות עובדים חי)', 'dspan': (151, 601), 'tokens': [{'id': 1, 'text': 'רק', 'upos': 'ADV', 'xpos': 'ADV', 'head': 4, 'deprel': 'advmod', 'dspan': (151, 153), 'span': (0, 2), 'lemma': 'רק'}, {'id': 2, 'text': 'לאחר', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'dspan': (154, 158), 'span': (3, 7), 'lemma': 'לאחר'}, {'id': (3, 4), 'text': 'המלחמה', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'מלחמה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'obl', 'lemma': 'מלחמה'}], 'span': (8, 14), 'dspan': (159, 165)}, {'id': (5, 6), 'text': 'הגדולה', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'גדולה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'amod', 'lemma': 'גדול'}], 'span': (15, 21), 'dspan': (166, 172)}, {'id': 7, 'text': 'באו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PAAL|Number=Plur|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (173, 176), 'span': (22, 25), 'lemma': 'בא'}, {'id': (8, 9), 'text': 'להכרה', 'expanded': [{'id': 8, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ל'}, {'id': 9, 'text': 'הכרה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 7, 'deprel': 'obl', 'lem