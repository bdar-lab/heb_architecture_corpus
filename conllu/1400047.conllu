# file = txt/1400047.txt
# filelineno = 35
# sentno = 3
# text = "תכן כ׳ המסגרות השכיחות כיום לשיפוץ אינן מספיקות או מתאימות לצרכי שיפורים אנרגטיים של בניינים קיימים (retrofitting) או לשיפוצים במסגרת בנייה ירוקה ויש מקום לחשוב על מודל חדש, כמו שנעשה בעבר עם תמ"א 38, על מנת להטמיע בצורה רחבה שיפורים אלו שכן הדבר עולה בקנה אחד עם הצורך הלאומי בהתייעלות אנרגטית ועם התחייבות הממשלה להפחתת פליטות.
