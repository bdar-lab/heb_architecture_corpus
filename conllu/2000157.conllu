# text = בינוי המגורים שמציע לה קורבוזייה מנסה אף הוא לענות לצרכים העכשוויים, שלא זכו למענה במבנים הקיימים; הסידור מכוון לפתוח דירות לחיי יומיום באוויר הצח, אור השמש והירוק - שלא התאפשרו בעיר המאה ה-19; (גם כשהשמש דרי־ חדרה פנימה, החזיתות פנו אחת אל השניה ומנעו פרטיות).
# raw = {'id': 1, 'text': 'בינוי המגורים שמציע לה קורבוזייה מנסה אף הוא לענות לצרכים העכשוויים, שלא זכו למענה במבנים הקיימים; הסידור מכוון לפתוח דירות לחיי יומיום באוויר הצח, אור השמש והירוק - שלא התאפשרו בעיר המאה ה-19; (גם כשהשמש דרי־ חדרה פנימה, החזיתות פנו אחת אל השניה ומנעו פרטיות).', 'dspan': (0, 261), 'tokens': [{'id': 1, 'text': 'בינוי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 9, 'deprel': 'nsubj', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'בינוי'}, {'id': (2, 3), 'text': 'המגורים', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'מגורים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'compound:smixut', 'lemma': 'מגורים'}], 'span': (6, 13), 'dspan': (6, 13)}, {'id': (4, 5), 'text': 'שמציע', 'expanded': [{'id': 4, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 5, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 5, 'text': 'מציע', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HIFIL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 1, 'deprel': 'acl:relcl', 'lemma': 'הציע'}], 'span': (14, 19), 'dspan': (14, 19)}, {'id': (6, 7), 'text': 'לה', 'expanded': [{'id': 6, 'text': 'ל_', 'upos': 'ADP', 'xpos': 'ADP', 'head': 7, 'deprel': 'case', 'lemma': 'ל'}, {'id': 7, 'text': '_היא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Prs', 'head': 5, 'deprel': 'obl', 'lemma': 'הוא'}], 'span': (20, 22), 'dspan': (20, 22)}, {'id': 8, 'text': 'קורבוזייה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'nsubj', 'dspan': (23, 32), 'span': (23, 32), 'lemma': 'קורבוזייה'}, {'id': 9, 'text': 'מנסה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PIEL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (33, 37), 'span': (33, 37), 'lem