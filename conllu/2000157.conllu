# text = בהסתמך על מידע שקיים לגבי השכלתו האדריכלית של לאנג והעניין שגילה במקצועות האדריכלות, סביר להניח כי הכיר פרסומים פופולריים של אדריכלים בני זמנו, דוגמת (1914) Elia: Citta Futurista ׳Sant (1922) Le Corbusier: Plan Voisin, קתדרלות הזכוכית וערי הגנים של אדריכלי האקספרסיוניזם הגרמני, וחזונות העתיד של (1922-29) Hugh Ferriss לעיר ניו יורק.
# raw = {'id': 3, 'text': 'בהסתמך על מידע שקיים לגבי השכלתו האדריכלית של לאנג והעניין שגילה במקצועות האדריכלות, סביר להניח כי הכיר פרסומים פופולריים של אדריכלים בני זמנו, דוגמת (1914) Elia: Citta Futurista ׳Sant (1922) Le Corbusier: Plan Voisin, קתדרלות הזכוכית וערי הגנים של אדריכלי האקספרסיוניזם הגרמני, וחזונות העתיד של (1922-29) Hugh Ferriss לעיר ניו יורק.', 'dspan': (364, 697), 'tokens': [{'id': (1, 2), 'text': 'בהסתמך', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'הסתמך', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 24, 'deprel': 'obl', 'lemma': 'הסתמך'}], 'span': (0, 6), 'dspan': (364, 370)}, {'id': 3, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'dspan': (371, 373), 'span': (7, 9), 'lemma': 'על'}, {'id': 4, 'text': 'מידע', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'nmod', 'dspan': (374, 378), 'span': (10, 14), 'lemma': 'מידע'}, {'id': (5, 6), 'text': 'שקיים', 'expanded': [{'id': 5, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 6, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 6, 'text': 'קיים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'acl:relcl', 'lemma': 'קיים'}], 'span': (15, 20), 'dspan': (379, 384)}, {'id': 7, 'text': 'לגבי', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'dspan': (385, 389), 'span': (21, 25), 'lemma': 'לגבי'}, {'id': (8, 9), 'text': 'השכלתו', 'expanded': [{'id': 8, 'text': 'השכלת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'obl', 'lemma': 'השכלת'}, {'id': 9, 'text': 'ו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Definite=Def|Gender=Masc|Number=Sing|Person=3|Poss=Yes|PronType=Prs', 'head': 8, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (26, 32), 'dspan': (390, 396)}, {'id': (10, 11), 'text': 'האדריכלית', 'expanded': [{'id': 10, 'text'