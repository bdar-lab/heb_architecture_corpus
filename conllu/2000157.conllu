# file = txt/2000157.txt
# filelineno = 1054
# sentno = 3
# text = לעומת הרחוב המסחרי של העתיד (The strip) היושב על רצועות כבישים מהירים, מרובי-נתיבים, עמוסי שלטים (Billboards), מחלפים, חניוני ענק ומבני מסחר - הפעילויות המסורתיות של הכיכר נכנסות לחיו קזינו בצורה של פטיו הנמצא מאחור, אשר מהווה מעין נווה מדבר מלאכותי המכיל מים וירק, כמו גם מקומות אינטימיים וחללים מוגדרים (1977:34-48 venturi & Scott Brown & izenour).
