# file = txt/2000157.txt
# filelineno = 243
# sentno = 2
# text = (1992:10 ,Jencks) הוא מבדיל בין פוסט-מודרניזם קונסטרוקטיבי לפוסט-מודרניזם דה-קונסטרוקטיבי (1992:33 ,jencks); ומסכם במסקנה כי אחת הסיבות שפוסט-מודרניזם הפך למשפיע רב עוצמה התבטאה בדו-משמעותו המשכנעת; ובאופן בו ידע להגדיר את נקודת המוצא, אולם השאיר את היעד הסופי - פתוח (1992 ,jencks).
