# file = txt/2000157.txt
# filelineno = 1248
# sentno = 1
# text = מתחת לפני השטח, מהווה המחשה עיצובית זו, שנוטה להאדיר את המימדים העצומים - ביקורת על אופי החיים העירוני, הן ברמת המעמדות החברתיים והן ברמה האלגורית: העיר (על גודלה העצום, ומת הפיתות הטכנולוגית המתקדמת והמערכת המשוכללת בה היא מתוכננת לעבוד) כמעט וקורסת, כ’ייו שלא ניתנה תשומת לב לפרטים הקטנים: לקשר המתווך בין הידיים לבין למח; כלומר, בין הבעלים, המתפעלים את המכונות, אשר בזכותם יכולה העיר להמשיך ולתפקד, לבין האדונים -הנהנים מתפוקת המכונות המשפיעות על התפקוד התקין של העיר.
