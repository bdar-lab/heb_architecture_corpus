# file = txt/2000157.txt
# filelineno = 530
# sentno = 1
# text = החל משנות ה-30 המאוחרות וביתר שאת בשנות ה-40 וה-50 החל להתפתח בכיוון זה גם תחום הקולנוע הדוקומנטרי, העוסק בתכנון עירוני; תחום הקולנוע התיעודי בשנים שלאחר מלחמת העולם ה-11, צמח בעקבות צורך לפעול תחת הגבלות של אחוות המלחמה, כזרוע רשמית של הרשות השלטונית, הפועלת במטרה להציג את העניין הלאומי לצבור, בבית ובחוץ.
