# file = txt/2000157.txt
# filelineno = 1066
# sentno = 2
# text = טבע נכנם פנימה אל הקומפלקס הבנוי■ לעומת הרחוב המסחרי של העתיד (The strip) היושב על רצועות כבישים מהירים, מרובי-נתיבים, עמוסי שלטים (Billboards), מחלפים, חניוני ענק ומבני מסחר - הפעילויות המסורתיות של הכיכר נכנסות לתוך קזינו בצורה של פטיו הנמצא מאחור, אשר מהווה מעין נווה מדבר מלאכותי המכיל מים וירק, כמו גם מקומות אינטימיים וחללים מוגדרים (1977:34-48 Venturi & Scott Brown & izenour).
