# file = txt/1200106.txt
# filelineno = 243
# sentno = 3
# text = משתמשים בשיטות וכלים שונים בבדיקות פטרוגרפיות של בטון, לדוגמא אור פלורוסנט מיקרוסקופי ועיבוד תמונה לקביעת המיקרו-מבנה ויחס מים/צמנט בבטון, בדיקות של דוגמיות רטובות ומעקב אחרי הידרציה של צמנט באמצעות מיקרוסקופיים אלקטרונים סורקים סביבתיים (environmental scanning electron microscopes), בדיקות מיקרו-מבנה בהגדלת אולטרה גבוהה במיקרוסקופ אלקטרוני סורק חודר ( transmission electron microscope) עם התאמות לאלמנטים ובדיקות מורפולוגיות, מיקרוסקופיה אינפרה-אדומה, מיקרוסקופיה ממוקדת (confocal microscopy), מידול מיקרו-מבנה לחיזוי של תכונות הבטון ומיקרוסקופיה של X-ray.
