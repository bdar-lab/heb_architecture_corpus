# file = txt/2300147.txt
# filelineno = 552
# sentno = 2
# text = מורכבות זו נובעת ממספר רב של צירופים שמקורם בטיפוסים שונים של צירי אופניים (שבילים ונתיבים מסוגים שונים) וכן טיפוסים שונים של צמתים - צומת ״T״, צומת צלב, מספר ופילוג הנתיבים, מיקום הצומת באזור העירוני או הבין־עירוני, מהירות התכן בצומת, מדרג הכביש בהיררכיות הדרכים, צומת מרומזר או לא וכד׳.
