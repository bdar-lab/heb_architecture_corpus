# file = txt/1500188.txt
# filelineno = 489
# sentno = 9
# text = הצורך בכדאיות כלכלית בתכנית מגביל את יישומה רק לערים חזקות דוגמת תל אביב, בהם השוק פועל ללא צורך בהתערבות המדינה, בעוד שהפריפריה נותרת ללא מענה אמיתי לחיזוק בפני רעידות אדמה והתחדשות מצאי הדירות (מבקר המדינה, 2011).
