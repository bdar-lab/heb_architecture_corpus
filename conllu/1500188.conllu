# file = txt/1500188.txt
# filelineno = 436
# sentno = 4
# text = אולם, למעט מקרים אלו, מצאתי שההיגיון הבסיסי שמנחה את שיתוף הפעולה בין הבעלים ליזם בתכנית הוא כלכלי גרידא, ומוגדר על ידי תכתיבי "העסקה התכנונית"- עסקה בעלת אופי כלכלי, שמביאה לתהליך את ההיגיון של השוק, והגיון זה מכתיב פעולה במושגים של תחרותיות, אינטרסים, רווחים ומאבקים.
