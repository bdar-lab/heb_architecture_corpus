# file = txt/1500188.txt
# filelineno = 138
# sentno = 1
# text = חוסר השוויון מתבטא גם בין הרשויות המקומיות: כוחן של הרשויות במשטרים עירוניים נבדל על פי מעמדן הכלכלי, כאשר ככל שבתחומן מתקיימת פעילות כלכלית ענפה יותר, כך כוחה של הרשות ביחס למגזר העסקי בקואליציה גדל ויש ביכולתה לעמוד בפרץ הלחץ העסקי ולקדם צרכים עירוניים (1994 ,stoker & Mossberger).
