# file = txt/1500188.txt
# filelineno = 404
# sentno = 3
# text = מכיוון שהגינה נתפסת כרכוש משותף, המהלך דורש הסכמה של כל בעלי הדירות בבניין, שלרוב ניתנת מתוך הבנה שזה יוריד חסם מהמיזם: "אם התשלום לו (לבעל הדירה מקומת הקרקע) ייגמר בשטח בגינה אני בטוח שהם (יתר הבעלים) יהיו בסדר עם זה" (נאמר בריאיון עם בעל דירה בבניין ממרכז העיר).
