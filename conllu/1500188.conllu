# file = txt/1500188.txt
# filelineno = 277
# sentno = 7
# text = 74 מכיוון שמספר הקומות המקסימלי שהעירייה מאפשרת בתכנית ליזם הוא 2 קומות מלאות וקומה אחת בנסיגה (משמע הוספה של 12 יחידות בכל בניין), מציעה התכנית לנייד את הזכויות הנותרות למימוש (במסגרת תמ״א 38 יחד עם זכויות תב״עיות קיימות), לארבעה בניינים ברחוב הסמוך, שיעברו הריסה ובנייה מחודשת של בניינים בגובה 12 קומות מלאות (יחד עם קומת גג בנסיגה), משמע 260 יחידות דיור (במקום 48 יחידות כיום).
