# file = txt/1500188.txt
# filelineno = 381
# sentno = 6
# text = בשלב זה הדיון התלהט והתפתח וויכוח חריף בין השניים, שבמהלכו הורמו קולותיהם וניתן היה לראות את הכעס והתסכול בפנים של שניהם: בעל הדירה המתגורר בבניין התגונן "אתה לא סומך על ד׳ (בעל הדירה השני שמטפל בנושא) ועליי?!" בעל הדירה המשכיר את דירתו ענה לו בתקיפות "לא- אין לי שום סיבה לסמוך עליכם.
