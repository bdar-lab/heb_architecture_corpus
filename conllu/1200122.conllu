# file = txt/1200122.txt
# filelineno = 207
# sentno = 1
# text = •	לאור התוצאות החד-משמעיות של ניסויי המתיחה של מחברים מסוגים שונים, כמפורט בפרק 3 לעיל, מומלץ להימנע משימוש בפרטי חיבור המבוססים על שימוש בחישוקים, עם לולאות לא חופפות, בכל המחברים בהם צפויות הטרחות מתיחה, כתוצאה של פעולת עומסים חיצוניים על בניינים בהם משולבים מרחבים מוגנים טרומים.
