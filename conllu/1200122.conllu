# file = txt/1200122.txt
# filelineno = 187
# sentno = 1
# text = •	התסבולת (התחילית) של מחברי פנלים טרומים נמוכה משמעותית מזו של הדגמים המונוליתיים – בכ- 30% למחברים משוננים וביותר מ- 50% למחברים בלתי משוננים, אולם בהשלכה לחוזק תכן יש להתחשב במשיכות המשופרת, בעיקר של דגמים בלתי משוננים.
