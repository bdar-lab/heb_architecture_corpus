# file = txt/1200122.txt
# filelineno = 149
# sentno = 6
# text = בהשוואה להתנהגות דגם טרום שנבדק בשלב א' של המחקר (ראו ציור 3.31), בו היה שימוש במוטות שיגום בקוטר 12 מ"מ, הדגמים שנוסו בשלב הנוכחי של המחקר, הן אלה עם מוטות שיגום בקוטר 14 מ"מ והן אלה עם מוטות שיגום בקוטר 16 מ"מ התאפיינו בתסבולת משופרת לאחר הסדיקה הראשונית של הבטון במחבר, לפחות בטווח הזזות מוגבל עד 8 מ"מ בקירוב (שיפור של 10%-40% בדגמים עם מוטות שיגום בקוטר 14 מ"מ ו- 50%-70% בדגמים עם מוטות שיגום בקוטר 16 מ"מ).
