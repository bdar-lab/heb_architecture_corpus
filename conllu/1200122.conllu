# file = txt/1200122.txt
# filelineno = 296
# sentno = 2
# text = תסבולת התכן בגזירה בניצב למישורי הרכיבים הטרומים – VRd1, של חתך הבטון במחברים בין הרכיבים הטרומים, שאינם כוללים זיון גזירה מיוחד, אשר נבדקו במסגרת מחקר זה, הינה נמוכה בכ- 30% מתסבולת התכן בגזירה של רכיב בטון מזויין מונוליתי בעל מאפיינים חומריים וגיאומטריים זהים, הכולל מנת זיון מתיחה זהה למנת זיון המתיחה של המחבר, הנקבעת תוך התחשבות בשטח החתך של ענף אחד של לולאות החיבור בין הרכיבים הטרומים.
