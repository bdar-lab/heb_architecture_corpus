# file = txt/1200122.txt
# filelineno = 297
# sentno = 2
# text = תסבולת התכן בגזירה במישורי הרכיבים הטרומים – VRd1, של חתך הבטון במחברים משוננים בלא זיון גזירה מיוחד (מישקים משופרים ע"פ הגדרות הכלולות בת"י 466 – חלק 4 [17]), אשר נבדקו במסגרת מחקר זה, הינה נמוכה בכ- 30% מתסבולת התכן בגזירה של רכיב בטון מזויין מונוליתי בעל מאפיינים חומריים וגיאומטריים זהים, הכולל מנת זיון מתוח זהה למנת הזיון המתוח של המחבר, הניצב למישור המחבר הנגזר, הנקבעת תוך התחשבות בשטח החתך של שני הענפים של לולאות החיבור המתוחות בחתך הנגזר הנדון.
