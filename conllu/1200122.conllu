# file = txt/1200122.txt
# filelineno = 201
# sentno = 1
# text = •	המשיכות בכפיפה ובגזירה של דגמים מונוליתיים הכוללים רשתות זיון קשורות ממוטות פלדה מצולעים בעלי קוטר נומינלי של 8 מ"מ, אשר נבדקו בשלב הנוכחי של המחקר, הינה משופרת במידה מסוימת בהשוואה למשיכות של דגמים מונוליתיים תואמים, בהם היה שימוש ברשתות פלדה משוכות בקר בקוטר 6.5 מ"מ, אשר נבדקו בשלב הנוכחי ובשלב אי של מחקר זה, אם כי היא נחותה מזו של הדגמים הטרומים השונים שנבדקו בהטרחות אלה.
