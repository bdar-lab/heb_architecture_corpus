# text = שלב ראשון של מחקר זה, שתוצאותיו סוכמו בדו"ח שפורסם בשנת 2005 [9], התמקד בעיקר בסימולציה ובבחינה ניסויית ראשונית של מחברי לולאות טרומים אופייניים, בהטרחות עיקריות הצפויות לפעול עליהם, בכוונה ללמוד את עיקרי ההתנהגות שלהם, על מנת לשמש בסיס להמשך המחקר בשלביו הבאים.
# raw = {'id': 1, 'text': 'שלב ראשון של מחקר זה, שתוצאותיו סוכמו בדו"ח שפורסם בשנת 2005 [9], התמקד בעיקר בסימולציה ובבחינה ניסויית ראשונית של מחברי לולאות טרומים אופייניים, בהטרחות עיקריות הצפויות לפעול עליהם, בכוונה ללמוד את עיקרי ההתנהגות שלהם, על מנת לשמש בסיס להמשך המחקר בשלביו הבאים.', 'dspan': (0, 262), 'tokens': [{'id': 1, 'text': 'שלב', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 23, 'deprel': 'nsubj', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'שלב'}, {'id': 2, 'text': 'ראשון', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'amod', 'dspan': (4, 9), 'span': (4, 9), 'lemma': 'ראשון'}, {'id': 3, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 4, 'deprel': 'case:gen', 'dspan': (10, 12), 'span': (10, 12), 'lemma': 'של'}, {'id': 4, 'text': 'מחקר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'nmod', 'dspan': (13, 17), 'span': (13, 17), 'lemma': 'מחקר'}, {'id': 5, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Dem', 'head': 4, 'deprel': 'det', 'dspan': (18, 20), 'span': (18, 20), 'lemma': 'זה'}, {'id': 6, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 4, 'deprel': 'punct', 'dspan': (20, 21), 'span': (20, 21), 'lemma': ','}, {'id': (7, 10), 'text': 'שתוצאותיו', 'expanded': [{'id': 7, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 11, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 8, 'text': 'תוצאה_', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Def|Gender=Fem|Number=Plur', 'head': 11, 'deprel': 'nsubj', 'lemma': 'תוצאה'}, {'id': 9, 'text': '_של_', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case:gen', 'lemma': 'של'}, {'id': 10, 'text': '_הוא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Gender=Masc|Number=Sing|Person=3|PronType=Prs', 'head': 8, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (22, 31), 'dspan': (22, 31)}, {'id': 11, 'text': 'סוכמו