# file = txt/1200122.txt
# filelineno = 10
# sentno = 1
# text = תוצאות של ניסויים אלה, יחד עם תוצאות הניסויים שבוצעו בעבר במסגרת שלב אי של המחקר, שימשו, בין היתר, גם כרקע לפיתוח של כלי חישוב אנליטי המיועד לאפשר לנתח ולהעריך בצורה אמינה את ההתנהגות החזויה של בניינים המשלבים בתוכם פירי מרחבים מוגנים טרומים, הן בהשפעת איומים מלחמתיים והן בהשפעת עומסים אופקיים אחרים, כגון עומסי רוח או עומסים סיסמיים, ולהתחשב במאפיינים ייחודיים של המחבר הטרום.
