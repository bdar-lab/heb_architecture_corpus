# file = txt/2800065.txt
# filelineno = 229
# sentno = 3
# text = מבחינה העצמה היחסית של הרשת המקומית (יחסית לגודל העיר), מן הראוי להוסיף כי אילת מתבלטת בהשוואה לערי הפיתוח שבצפון: רק בנהריה ועפולה הגיוון של הרשת המקומית גדול יותר במקצת (9 ענפי משנה לעומת 8 באילת), ובמספר העסקים המקומיים של ש.ע.כ., רק נהריה ועכו עולות עליה .
