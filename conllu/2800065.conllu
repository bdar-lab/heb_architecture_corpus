# file = txt/2800065.txt
# filelineno = 76
# sentno = 1
# text = פרום נתוני משרד השיכון לגבי התפלגות בניית יחידות דיור חדשות בסקטור הציבורי שבניתן הסתימה במשך העשור בין המחוזות, מלמד כי לקראת סופו של העשור (1967-1970) חל שיפור ניכר בחלקו היחסי של מחוז הצפון בסה״כ הבנייה הציבורית, בדומה לשיפור שחל בחלקו היחסי של מחוז ירושלים מאז מלחמת ששת הימים.
