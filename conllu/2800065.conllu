# file = txt/2800065.txt
# filelineno = 177
# sentno = 1
# text = כפי שניתן להשוות עם נתוני לוח מם' 22, גם בתוך כל אחת מהקבוצות ה"סדר העולה" של שעור הגידול הדיפרנציאלי תואם, כמעט ללא חריגים, את הסדר העולה של עוצמה שרותי העזר המקומיים; נפות באר-שבע ואשקלון מתבלטות בסידרה כולה בשעור הגידול הדיפרנציאלי הגבוה שלהן, הנופן רק מזה של נפת תל-אביב, ומהוות חריג בולט עוד יותר בהתחשב בכך ששיעור עסקי שרותי העזר הכלכליים בתחומיהן ל-1,000 תושב מקומי הוא מן הנמוכים שבקבוצת "מוקדי המשנה".
