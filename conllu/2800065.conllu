# file = txt/2800065.txt
# filelineno = 278
# sentno = 2
# text = כך, יישוב שתושבי-חוץ רבים מגיעים אליו לצורך עבודה, קניות או צריכת שרותים שונים: כנגד ההוצאות הנגרמות לו ע״י שרותי התשתית הנוספים הדרושים (כגון בתחום הכבישים, מקומות חנייה, מים וכו'), נוצרת בתחומיו הכנסה נוספת הן ישירות (מסים מעסקים שחלק ניכר ממחזורם מקורו בתושבי החוץ), והן בעקיפין (עליית הכנסתם של תושבים מקומיים בעלי עסקים ושל שכיריהם, וכן לגבי בעלי מפעלים מקומיים וכדומה).
