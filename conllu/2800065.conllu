# file = txt/2800065.txt
# filelineno = 58
# sentno = 2
# text = הנתונים אשר נציג בסעיפים הבאים "נקיים", לפחות במידה מסויימת, מהשפעת גורם זה - ונתונים אלה מצביעים על "מידת העדפה" של מחוזות הפיתוח, שאינה קטנה מזו שהתקבלה מהשוואת חלקם היחסי בסה״ב ההשקעות בענפי המשק בשנים 1963-1967 למשקלם היחסי באוכלוסיה.
