# file = txt/2800065.txt
# filelineno = 179
# sentno = 3
# text = כאן נתרכז בגורם הריכוזיות הפנים—ענפית ברשת הארצית של שרותי-העזר הכלכליים: בשמונה מתוך עשרים ושלושה ענפי-המשנה של השרותים מסוג זה, סה״כ מספר המפעלים העסקיים בכל הארץ מסתכם, לרוב, בבמה עשרות ואף פחות מכך (המדובר, כזכור, בכל מקרה במפעל-האם, להבדיל מסניפים, או ביחידה כלכלית עצמאית בהתאם להגדרות ה"סיווג האחיד של ענפי הכלכלה").
