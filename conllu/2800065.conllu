# file = txt/2800065.txt
# filelineno = 34
# sentno = 3
# text = אולם לצורך סיכום התהליך של פיזור האוכלוסיה היהודית בין אזורי הארץ השונים במונחים ריאליים - השינויים במספר האבסולוטי של התושבים בכל אחד מהאזורים, מבחינת היקף השרותים הדרושים; המימדים של המערכים ההתישבותיים על נפחי התנועה המיוצרים בהם וכדומה - יש חשיבות רבה יותר, בהרבה, לנתונים המבטאים את חלקם היחסי של האזורים השונים בסה״ב התוספת לאוכלוסיה היהודית בישראל (על מגמות ההתפתחות הדיפרנציאלית המשתמעת מנתונים אלה), ולנתונים המצביעים על שינויים במגמות אלו בתקופה זו או אחרת מאז הקמת המדינה.
