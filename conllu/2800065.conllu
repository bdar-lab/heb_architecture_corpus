# file = txt/2800065.txt
# filelineno = 149
# sentno = 3
# text = עובדה זו בלטה ביותר במפעלים המהווים חלק אינטגרלי מ"מפעל-אם": במפעל נוסף (מפעל מם' 6), משלם המפעל המקומי שבאיזור הפיתוח למפעל האם שבמרכז הארץ 2.5% מהסה״ב של המחזור השנתי כתשלום קבוע תמורת שרותי העזר; במפעל מם' 7 כל שרותי העזר חושבו כחלק מפעולות מפעל האם שבמרכז הארץ,"(לגבי שני אלה חסרו לנו נתונים מפורטים, כאמור, ובמפעל נוסף שנבחר הסתבר כי הוא עדין בהרצה ולכן לא כללנו אותו בהדגמה).
