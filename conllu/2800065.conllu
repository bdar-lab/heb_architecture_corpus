# file = txt/2800065.txt
# filelineno = 252
# sentno = 1
# text = יעדי האוכלוסיה הגבוהים יותר לשנת המטרה 1993, בהתאם לדו"ח הנזכר (195 - 185 אלף, םה״כ בחמשת היישובים), גם הם עדיין יכולים להחשב כנמוכים מנקודת המבט שאנו מתרכזים בה בעבודה הנוכחית - במיוחד כאשר ניתן להניח כי כושר התחרות של "כוח משיכה" עדיף במוקדים שבמרכז הארץ יגבר עוד יותר׳ כלומר, תוספת מתוכננת של כ-110 אלף תושבים עירוניים במשך עשרים שנה במרחב שאנו דנים בו אינה עשוייה - בהתאם להנחת היסוד שלנו בדבר חשיבותה של מערכת אורבנית מפותחת לגבי "כוח המשיכה" של איזור נתון - לשנות באופן דרסטי את המצב הנוכחי.
