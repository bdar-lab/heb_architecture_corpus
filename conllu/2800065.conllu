# file = txt/2800065.txt
# filelineno = 91
# sentno = 2
# text = תלות כזו נמצאה גם לגבי אזורים שבתוך חלקי המדינה המבוססים יותר שבמרכז, ולא רק לגבי החלקים השונים של אזורי הפיתוח, ניתן להסיק, לכן, כי אותם אלמנטים בתפרושת המערך העירוני אבן השפיעו - ומשפיעים - על "מידת ההצלחה" של מדיניות פיזור האוכלוסיה בחלקי הארץ השונים מעל ומעבר להשפעתם של גורמים אחרים, הן כאלה שבשליטת הממשלה (כגון ההפנייה ה"סלקטיבית" של משאבים לאזורים מועדפים), והן כאלה שאינם בשליטתה, (כגון בעיית הבטחון השוטף המתמקדת מאז מלחמת ששת הימים באזורי הצפון, אך אינה מטרידה אותם אזורים במרכז הארץ שגם בהם ה"גידול הדיפרנציאלי" של האוכלוסיה נמוך יחסית לאזורים אחרים).
