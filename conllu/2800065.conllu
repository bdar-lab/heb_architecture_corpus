# file = txt/2800065.txt
# filelineno = 48
# sentno = 1
# text = פיזור האוכלוסייה, כיעד של מדיניות ממשלתית מוצהרת, התמיד למצוא את ביטויו ב"קווי היסוד" של הממשלות בישראל מראשית הקמת המדינה - החל מ"קווי היסוד לתוכנית הממשלה" אשר הוגשו לאישור הכנסת הראשונה בז' באדר תש"ט (8.3.1949), בהם נקבע יעד זה כסעיף הראשון במגמותיה של תוכנית הפיתוח והקליטה אשר תקבע ע״י הממשלה:
