# file = txt/2800065.txt
# filelineno = 239
# sentno = 4
# text = המפה המצורפת(מפה מס, 3) מבליטה את פיצולו של מחוז הצפון, מבחינת מערכים התישבותיים שבתחומיו, לשלוש חטיבות נפרדות הנבדלות זו מזו הן טופוגרפית וגיאוגרפית, והן לגבי "חלקן" היחסי בתהליך של פיזור האוכלוסיה היהודית בחלקי הארץ השונים: שטחים מישוריים במצויים במרחק-גישה של עד 50 ק״מ מהמוקד הראשי של חיפה, בעלי רוב ניכר של אוכלוסיה יהודית - מישור עכו ועמק-יזרעאל, שאליהם נוסף (מבחינת התיחום המינהלי של המחוז) שטח הגבעות של רמת מנשה.
