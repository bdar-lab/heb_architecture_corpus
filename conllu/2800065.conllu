# file = txt/2800065.txt
# filelineno = 261
# sentno = 1
# text = ההרחבה המשמעותית יותר בהרבה המשתמעת במסקנה ממימצאי העבודה הנוכחית עבור המערך העירוני שבגליל המזרחי ניתן לראותה, לדעתנו, כיעד ריאלי במסגרת של מדיניות מוגדרת (כפוף, כאמור, לבדיקה מפורטת של פוטנציאל הקרקעות לפיתוח לשימושיהם השונים, ושל מיבלול הגורמים הכלכליים והגיאוגרפיים בתחומי האיזור).
