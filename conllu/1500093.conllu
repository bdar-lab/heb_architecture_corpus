# file = txt/1500093.txt
# filelineno = 855
# sentno = 4
# text = בקנה מידה ארצי יש חשיבות לבחון האם כדאי יותר להמשיך לפתח את המוצרים התיירותיים בשתי הערים כמוצרים מתחרים (ואז לחזק בכל עיר גם את המאפיינים הפחות דומיננטיים) או לחזק את המאפיינים הדומיננטיים בכל עיר, ועל ידי כך לחזק אותן יותר כשני מוצרים משלימים: תל אביב – עיר חוף, בילוי וצריכה, וירושלים – עיר דת והיסטוריה.
