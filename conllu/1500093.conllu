# file = txt/1500093.txt
# filelineno = 764
# sentno = 1
# text = בראיון עם התיירים הם אמנם לא נשאלו על עמדתם לגבי היצע המוצרים לתיירות עסקים, אולם ניתן ללמוד מן המחקר מספר דברים בעלי השלכות תכנוניות לגבי תיירי העסקים: ראשית, מבין הדברים והצרכים החשובים להם ביותר - ההתמצאות בדרכים היא באופן משמעותי גבוהה יותר מהאחרים, ויש לחזק את הקריאות בעיר לטובתם, כמו גם לטובת התיירים האחרים.
