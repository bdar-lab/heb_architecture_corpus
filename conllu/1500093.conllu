# file = txt/1500093.txt
# filelineno = 742
# sentno = 1
# text = בתל אביב ישנו מספר רב של אירועים בשנה, אולם רק שניים מהם בקנה מידה תיירותי – על פי ארבעת הפרמטרים: במועד קבוע, מדי שנה, בחוצות העיר (כלומר – אין תשלום עבור כניסה לאירוע), ושהאירוע מספיק גדול וייחודי כדי להיכלל בדימוי של העיר.
