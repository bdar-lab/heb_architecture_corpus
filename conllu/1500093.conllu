# file = txt/1500093.txt
# filelineno = 226
# sentno = 6
# text = למרות שהתכנון נמצא בטווח רחב של נושאים (למשל תכנון פיננסי, תכנון חברתי או תכנון עסקי) התחום של תכנון עיר ואזור מספק ניתוח יעיל של הגדרת התכנון: התכנון עוסק בעתיד; צובר ידע על מנת לאתר את הגישה הטובה ביותר להתערבות ממשלתית; עוסק בחיזוי שינויים ומגמות בתנאים שבדרך כלל אינם וודאיים; עוסק בפיתוח חזון אסטרטגי; התכנון הוא ערכי ופוליטי במהותו.
