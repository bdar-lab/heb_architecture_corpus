# file = txt/1500093.txt
# filelineno = 262
# sentno = 1
# text = 1998)	Van Der Borg and Russo) טענו כי האתגר הגדול כיום הוא לשמור על הייחודיות של מקום היעד, אך בתנאים של סטנדרטיזציה של התקופה הנוכחית, אשר מחייבת את היעדים להעמיד לרשות התיירים גם מתקנים ואתרים שייצרו אצלם תחושת מקום – כמו רשתות מפורסמות של מסעדות ומלונות.
