# file = txt/1500158.txt
# filelineno = 443
# sentno = 2
# text = בשנת 2009 התקיים בספרייה הלאומית של הולנד בהאג ובמכון אדריכלות הולנד nai ברוטרדם הכנס Hybrid Architectural Archives, שנועד למפות את המחקר ואת הניסיון המעשי־ המקצועי ביצירה, בצריכה ובשימוש של ארכיוני אדריכלות היברידיים בני־זמננו, מסורתיים ודיגיטליים במקביל.
