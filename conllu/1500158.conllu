# text = שכן, התסוויגים (טקסונומיות Taxonomies) האדריכליים המקובלים - קרי שיטות המיון והסיווג הקנוניות של מידע אדריכלי היסטורי בדרך־כלל על־פי תקופה, מקום גיאוגרפי, סיגנון, לאום וכן הלאה - המבוססים על הייררכיות טקסונומיות של יחסים בין קבוצת־על ותתי־פריטים, אין עוד בכוחם לספק את המחקר הרב־תחומי והבין־תחומי בן־זמננו של חוקרים, היסטוריונים, תאורטיקנים ומבקרים, הן מתחומי האדריכלות והן מתחומים אחרים.
# raw = {'id': 1, 'text': 'שכן, התסוויגים (טקסונומיות Taxonomies) האדריכליים המקובלים - קרי שיטות המיון והסיווג הקנוניות של מידע אדריכלי היסטורי בדרך־כלל על־פי תקופה, מקום גיאוגרפי, סיגנון, לאום וכן הלאה - המבוססים על הייררכיות טקסונומיות של יחסים בין קבוצת־על ותתי־פריטים, אין עוד בכוחם לספק את המחקר הרב־תחומי והבין־תחומי בן־זמננו של חוקרים, היסטוריונים, תאורטיקנים ומבקרים, הן מתחומי האדריכלות והן מתחומים אחרים.', 'dspan': (0, 388), 'tokens': [{'id': 1, 'text': 'שכן', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 62, 'deprel': 'mark', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'שכן'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 62, 'deprel': 'punct', 'dspan': (3, 4), 'span': (3, 4), 'lemma': ','}, {'id': (3, 4), 'text': 'התסוויגים', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'תסוויגים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 62, 'deprel': 'dislocated', 'lemma': 'תסוויגים'}], 'span': (5, 14), 'dspan': (5, 14)}, {'id': 5, 'text': '(', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (15, 16), 'span': (15, 16), 'lemma': '('}, {'id': 6, 'text': 'טקסונומיות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 4, 'deprel': 'appos', 'dspan': (16, 26), 'span': (16, 26), 'lemma': 'טקסונומיות'}, {'id': 7, 'text': 'Taxonomies', 'upos': 'X', 'xpos': 'X', 'head': 6, 'deprel': 'flat:name', 'dspan': (27, 37), 'span': (27, 37), 'lemma': 'Taxonomies'}, {'id': 8, 'text': ')', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (37, 38), 'span': (37, 38), 'lemma': ')'}, {'id': (9, 10), 'text': 'האדריכליים', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 10, 'deprel': 'det', 'lemma': 'ה'}, {'id': 10, 'text': 'אדריכליים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 4, 'deprel': '