# file = txt/1500158.txt
# filelineno = 260
# sentno = 2
# text = הספרייה והמוזיאון היו המושאים המועדפים לסלידתם האינטנסיבית של רבים מן הסופרים והאמנים המודרניים, למן ז׳ן־ז׳ק רוסו שהתפעם מהרם ספריית אלכסנדריה העתיקה, דרך פאוסט של גתה ועד למינשרים של אמנים ותאורטיקנים מחוגי האוונגרד של ראשית המאה ה־20, כגון הזרם הפוטוריסטי, שאנשיו תיארו את המוזיאון כבית־קברות לאמנות וקראו להחריבו עד יסוד.
