# file = txt/1500158.txt
# filelineno = 90
# sentno = 1
# text = ואולם, מדו״ח שפורסם בשנת 1943 בקובץ הראשון של מחקרי ׳המוסד לחקר הבניה והתכניקה׳ עולה שבהמשך למפעל התערוכה ובמסגרת המוסד (ולא כחלק מארכיון העבודה) הוקם ארכיון הנדסי שנועד לרכז את חומרי התערוכה וכאלה שניתוספו לו אחריה, בינהם חומרים אדריכליים שנמסרו לארכיון על־ידי מתכננים שונים ובינהם חומרים מקוריים שעובדו על־ידי אנשי הוועדה האחראית לארכיון ב׳מוסד לחקר הבניה והתכניקה׳.
