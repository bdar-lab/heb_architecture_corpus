# file = txt/1500158.txt
# filelineno = 131
# sentno = 2
# text = 65 עם זאת, מן הדיווחים על פעילויות וועדות האגודה השונות שהתפרסמו תדיר בפירסומי האגודה השוטפים (כתבי־העת והביולטינים שהופיעו בינהם) ניתן בכל־זאת לעקוב אחר קורות האגודה, הישגיה, פולמוסיה ומאבקיה ולעניין מחקר זה - אחר התפתחות ספרייתה.
