# file = txt/1500158.txt
# filelineno = 634
# sentno = 1
# text = נקודות החפיפה הרשמיות של בעלי־סמכות אלה ׳עם המציאות הממשית (בין אם זו המציאות הישנה־ המסורתית בין אם זו המציאות הרבודה ושטופת המידע של ימינו) ועם מיגוון המשתמשים הפוטנציאליים בחומרים הנאצרים על־ידי בעלי־סמכות אלה - מתרחשות עדיין רק בקצותיו של התהליך הארכיוני: בעת קליטתו של חומר אל תוך הארכיון (לרוב קליטה סבילה של חומרים הנמסרים למוסד) ובעת הנגשתו של החומר למשתמש (בדרך־כלל באתר הפיזי של הארכיון).
