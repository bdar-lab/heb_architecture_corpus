# file = txt/1500158.txt
# filelineno = 372
# sentno = 1
# text = Records ראה אור בשנת 2006 בהוצאת איגוד הארכיונאים האמריקאי וכשמו עוסק בהיבטים הטכניים־המקצועיים של ניהול חומרי ארכיון בתחומי האדריכלות, ההנדסה והעיצוב וכולל הנחיות וסטנדרטים מפורטים לגבי סיווגם של חומרים אלה, הערכתם, סידורם, תיאורם, שימורם ותחזוקתם השוטפת כמו גם לגבי נוהלי העיון בהם, השאלתם, תצוגתם וכיו״ב (2006 Lowell & Nelb) ספר זה כלל אמנם סקירה היסטורית מקוצרת של תולדות הפרקטיקה האדריכלית במערב ושל התהליכים שבהם מיוצרים מסמכים אדריכליים קודם הפקדתם בארכיונים אולם כמעט ולא נכללו בו היבטים תאורטיים של ארכיונאות אדריכלית, אפשרויות השימוש הנרחבות הגלומות בה וכן הלאה.
