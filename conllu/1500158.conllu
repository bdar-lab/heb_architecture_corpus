# file = txt/1500158.txt
# filelineno = 320
# sentno = 3
# text = במקביל לפעילותו של ג׳ונסון ולעלייה המתמדת במודעות הציבורית לאדריכלות ובהכרה התרבותית כלפיה נוסדו ברחבי העולם במחצית השנייה של המאה ה־20 שורה של אוספים גדולים ובהן חומרים אדריכליים שרוכזו בארכיונים, במוזיאונים ובמרכזי מחקר.
