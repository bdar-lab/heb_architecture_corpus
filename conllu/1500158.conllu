# file = txt/1500158.txt
# filelineno = 711
# sentno = 1
# text = היות ומדובר במחקר על תהליכי הארכיונאות האדריכלית (ולא על הפעילות האדריכלית של יוצרו) ובמחקר על פוטנציאל המידע הנחבא בשולי הארכיון האדריכלי האישי, הוחלט בשלב הקליטה שלא לבער מתוך ארכיון ארמוני בשלב זה ולו פריט בודד, שכן התהליך הרב־הקשרי מתבסס על כך שגם פריטים שוליים לכאורה ישמשו עדויות במסד המידע הכללי של הארכיון התיעודי שבהקשרו נקלט האוסף, ארכיון העוסק באדריכלות ישראל.
