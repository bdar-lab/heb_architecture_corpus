# file = txt/1500158.txt
# filelineno = 669
# sentno = 2
# text = באפריל 2010, תוך תהליך פיתוח התהליך הרב־ הקשרי לארכיונאות אדריכלית וניסיונות לאתר מקרה־מבחן לצורך בדיקתו, נודע בדרך המקרה על שירטוטים אדריכליים מקוריים של בית־הספרים הלאומי והאוניברסיטאי בירושלים, אחד המבנים המרכזיים באדריכלות ישראל של מחצית המאה ה־20, שהושלכו על מדרכה ברחוב צייטלין בתל־אביב.
