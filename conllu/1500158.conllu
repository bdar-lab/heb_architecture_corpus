# text = מוקדי החשיבה והעשייה של הארכיונאות האדריכלית ההיברידית בת־זמננו - זו המאופיינת בכמות הולכת וגדלה של חומרי ארכיון אדריכליים מסורתיים לצד חומרים שעברו דיגיטציה או חומרים דיגיטליים מראשיתם - שרויים כיום בתקופה של ׳ניסוי וטעייה׳ (Trial and Error) וחשיבה מחדש על אופני קליטתם, שמירתם והנגשתם של חומרי ארכיון אדריכליים (שם).
# raw = {'id': 1, 'text': 'מוקדי החשיבה והעשייה של הארכיונאות האדריכלית ההיברידית בת־זמננו - זו המאופיינת בכמות הולכת וגדלה של חומרי ארכיון אדריכליים מסורתיים לצד חומרים שעברו דיגיטציה או חומרים דיגיטליים מראשיתם - שרויים כיום בתקופה של ׳ניסוי וטעייה׳ (Trial and Error) וחשיבה מחדש על אופני קליטתם, שמירתם והנגשתם של חומרי ארכיון אדריכליים (שם).', 'dspan': (0, 318), 'tokens': [{'id': 1, 'text': 'מוקדי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 0, 'deprel': 'root', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'מוקד'}, {'id': (2, 3), 'text': 'החשיבה', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'חשיבה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'compound', 'lemma': 'חשיבה'}], 'span': (6, 12), 'dspan': (6, 12)}, {'id': (4, 6), 'text': 'והעשייה', 'expanded': [{'id': 4, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 6, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'עשייה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'conj', 'lemma': 'עשייה'}], 'span': (13, 20), 'dspan': (13, 20)}, {'id': 7, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 9, 'deprel': 'case', 'dspan': (21, 23), 'span': (21, 23), 'lemma': 'של'}, {'id': (8, 9), 'text': 'הארכיונאות', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'ארכיונאות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'nmod:poss', 'lemma': 'ארכיונאות'}], 'span': (24, 34), 'dspan': (24, 34)}, {'id': (10, 11), 'text': 'האדריכלית', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': 'D