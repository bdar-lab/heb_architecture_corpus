# file = txt/1500158.txt
# filelineno = 527
# sentno = 1
# text = •	שיכלול מערכות ארכיונאיות קיימות, פיתוח והרחבה של מערכות ניהול המידע הארכיוני־ האדריכלי הקיימות, זאת בעיקר על מנת לשכלל את אפשרויות חיפושו, איחזורו ולבסוף הנגשתו של המידע החבוי באוספים הקיימים, ובאלה שייקלטו בארכיון בעתיד: פעולות אלה נעשות במסגרת ניסיונות בין־תחומיים לפיתוח טרמינולוגיה בינלאומית אחידה לארכיונאות האדריכלית ההיברידית; מערכת מושגית־סמנטית לתיאור ארכיוני־אדריכלי; חיבור ׳פנורמי׳ של ארכיון האדריכלות עם מאגרי מידע אחרים (ארכיוניים, אדריכליים או אחרים) באירגון או מחוץ לו; הפצה של האוספים באמצעות הרשת על מנת ליצור קהילות משתמשים לחומרי הארכיון; ועוד
