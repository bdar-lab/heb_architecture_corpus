# file = txt/1500158.txt
# filelineno = 173
# sentno = 1
# text = שכן, מלאכת המיפוי והמחקר הנוכחיים זיהו כי אוספים אדריכליים אישיים כוללים לא רק את החומרים האדריכליים המובנים מאליהם הצפויים להימצא באוסף - כלומר אלה העוסקים ישירות בעבודתם של היוצרים - אלא גם שלל חומרי לווין סמויים, ולעיתים נדירים ומשמעותיים ביותר, שהצטברו אצל בעלי האוספים בדרכים מדרכים שונות (מסירה, רכישה, השאלה וכו׳) ונשמרו באוספיהם או בעיזבונם.
