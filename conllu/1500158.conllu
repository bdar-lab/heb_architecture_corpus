# file = txt/1500158.txt
# filelineno = 226
# sentno = 2
# text = תוך כך, ובמקביל לזיהוי בעיות המחקר וניסוחן, התעכב לימוד זה על נקודות מפתח בתהליך הארכיוני, כאלה אשר יש בהן פוטנציאל לשינוי או לשיכלול התהליך על־מנת שתכולת הארכיון הנקלט תמופה באופן רב־הקשרי לשם ניצולה בעתיד באופן האופטימלי על־ידי משתמשים שונים, ולאו־דווקא מתחומי האדריכלות.
