# file = txt/1500158.txt
# filelineno = 712
# sentno = 1
# text = קליטה כזו, הנבחנת כתחילתו של תהליך רב־הקשרי, איפשרה לבחון את החומרים שבדרך־ כלל מקובל לסווגם כחומרי־ארכיון משניים או שוליים ביחס לגרעין העיקרי של הארכיון האישי (ובמקרה זה - שוליים לפועלו התכנוני־האדריכלי של ה׳גוף יוצר׳), ואת הפוטנציאל של חומרים שוליים־לכאורה אלה דווקא כנשאים של מידע חשוב, משלים ומשמעותי, בסיפורו הרחב והחסר של תחום התיעוד העיקרי של הארכיון שבו נקלט האוסף, במקרה זה ׳אדריכלות ישראל׳, שסיפורה החסר נידון בהרחבה לעיל <ר׳ 2.2) ושימש אחד ממניעיו העיקריים של פיתוח התהליך הארכיוני הרב־הקשרי.
