# file = txt/1500158.txt
# filelineno = 101
# sentno = 1
# text = מטעם ׳הסתדרות המהנדסים׳ (1940) - הרי נושא חשיבות התיעוד האדריכלי והקריאה להקמת ארכיון מרכזי לבנייה ואדריכלות עלו בשלישית מספר שנים לאחר הקמת המדינה, לראשונה מתוך אגודת האינג׳ינרים והארכיטקטים (מאז ייסודה שלושים שנה קודם לכן).
