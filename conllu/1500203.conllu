# file = txt/1500203.txt
# filelineno = 564
# sentno = 1
# text = המשתתפים בקבוצת מעוטי היכולת הגרים בשכירות חופשית, תיארו שמחירי השכירות ההולכים ועולים משנה לשנה מכבידים עליהם, וטענו כי עליה זו אינה מוצדקת, שכן בעלי הדירות לא דואגים לשימור ערך הדירה, לא משפצים פגמים ובלאי ולא דואגים לתיקון מפגעים עליהם מדווחים הדיירים: "הם לוקחים המון המון כסף, אבל לא דואגים" (ר, קבוצת מעוטי הכנסה).
