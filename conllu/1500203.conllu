# file = txt/1500203.txt
# filelineno = 333
# sentno = 3
# text = מתוך הראיונות עלה כי רבים מן המומחים אינם מכירים את בסיסי רעיון הקואופרציה ומטרותיו, ואינם בקיאים בתכונותיו השונות, גם כאשר הינם בחזית הידע בתחומם ונבחרו להשתתף במחקר זה בצורה מכוונת כאנשי מקצוע וכבעלי ניסיון מחקרי בתחומי הכלכלה, המשפט, התרבות או הדיור (על כך הרחבה בפרק הדיון 10.1).
