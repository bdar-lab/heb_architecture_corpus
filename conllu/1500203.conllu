# file = txt/1500203.txt
# filelineno = 730
# sentno = 1
# text = אף כי הממשלה הנוכחית תומכת במדיניות ניאו-ליברלית והמשך ההפרטה של שירותים שבעבר היו ציבוריים, ייתכן כי בשל מצוקת מחירי הדיור, המטרידה כה רבים במדינה, ומהווה קודקוד לתהליכי שינוי מבניים משמעותיים במוסדות הממשלה, היא גם הנואשת ביותר לפתרונות דיור ועל כן פתוחה להצעות חדשות.
