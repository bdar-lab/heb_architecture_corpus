# file = txt/1500203.txt
# filelineno = 559
# sentno = 6
# text = כך גם תיארו כל הנשים החד-הוריות את דירותיהן וסביבות מגוריהן: דירות הקטנות מלהכיל את גודל משפחתן, מחסור תמידי בחדרי שינה לילדים, סביבות ללא גנים ובתי ספר התואמים את גילאי ילדיהן, קומות גבוהות ללא מעלית לצד מצב בריאותי ירוד, דירות בערים רחוקות בהן הן וילדיהן אינם מכירים אדם ואין להם חברים, וכיו״ב.
