# sentno = 1
# text = על אף שכל קואופרטיב הוא עצמאי בכל המובנים, לאור ריבוי היוזמות הקואופרטיביות לדיור בקנדה - הן בצד ההיצע והן בצד הביקוש - קמו מספר ארגוני-גג, המייצרים רשת פדרטיבית של קואופרטיבים לדיור ומקדמים את האינטרסים של הקואופרטיבים לדיור ברמות אזוריות וברמה הארצית.
