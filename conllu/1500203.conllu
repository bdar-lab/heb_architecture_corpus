# file = txt/1500203.txt
# filelineno = 185
# sentno = 3
# text = באותן שנים בניינים רבים אוכלסו על ידי ׳סקוואטינג׳ (squatting - ׳פלישה׳), והמדינה, אשר לא הצליחה להתמודד עם הפינוי של כולם, החליטה להסדיר את בעלותם על הבניינים, וכך רבים מהם קיבלו לידיהם בעלות על דירות בסכומים נמוכים במיוחד.
