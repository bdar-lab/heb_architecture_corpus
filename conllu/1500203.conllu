# text = אחת המשתתפות אמרה באופן נחרץ וחד-משמעי כי אין בכלל על מה להתלבט, האפשרות המוצעת קוסמת לה יותר מכל דיור בו התנסתה עד היום: "אם מישהו היום היה בא ואומר לי, קחי מותק יש בניין כזה, ולא משנה מי יגור שם: ערבים, חילונים, דתיים, חד הוריות, מרובות ילדים, מבוגרים, כולם שיהיו, ואני אסתדר עם כולם, עם כל הסוגים של האנשים אני אסתדר״ (א׳, קבוצת נשים חד-הוריות).
# raw = {'id': 2, 'text': 'אחת המשתתפות אמרה באופן נחרץ וחד-משמעי כי אין בכלל על מה להתלבט, האפשרות המוצעת קוסמת לה יותר מכל דיור בו התנסתה עד היום: "אם מישהו היום היה בא ואומר לי, קחי מותק יש בניין כזה, ולא משנה מי יגור שם: ערבים, חילונים, דתיים, חד הוריות, מרובות ילדים, מבוגרים, כולם שיהיו, ואני אסתדר עם כולם, עם כל הסוגים של האנשים אני אסתדר״ (א׳, קבוצת נשים חד-הוריות).', 'dspan': (223, 571), 'tokens': [{'id': 1, 'text': 'אחת', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'nsubj', 'dspan': (223, 226), 'span': (0, 3), 'lemma': 'אחת'}, {'id': (2, 3), 'text': 'המשתתפות', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'משתתפות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 4, 'deprel': 'nsubj', 'lemma': 'משתתפות'}], 'span': (4, 12), 'dspan': (227, 235)}, {'id': 4, 'text': 'אמרה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PAAL|Number=Sing|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (236, 240), 'span': (13, 17), 'lemma': 'אמר'}, {'id': (5, 6), 'text': 'באופן', 'expanded': [{'id': 5, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ב'}, {'id': 6, 'text': 'אופן', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'obl', 'lemma': 'אופן'}], 'span': (18, 23), 'dspan': (241, 246)}, {'id': 7, 'text': 'נחרץ', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'amod', 'dspan': (247, 251), 'span': (24, 28), 'lemma': 'נחרץ'}, {'id': (8, 9), 'text': 'וחד', 'expanded': [{'id': 8, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 11, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 9, 'text': 'חד', 'upos': 'ADV', 'xpos': 'ADV', 'feats': 'Prefix=Yes', 'head': 11, 'deprel': 'compound:affix', 'lemma': 'חד'}], 'span': (29, 32), 'dspan': (252, 255)}, {'id'