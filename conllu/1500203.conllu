# file = txt/1500203.txt
# filelineno = 214
# sentno = 1
# text = ׳סינדיקט הדיירים׳ אינו מייעד עצמו למעמד או לאוכלוסיה ספציפית, אך מעיד על עצמו, כי על מנת להקימו נדרשים תנאים כמו זמן רב פנוי, יכולת התמודדות עם בירוקרטיה פיננסית ומשפטית, ואלו, על פי רוב, מצויים בידי מעמדות הביניים ולא בידי בעלי הכנסות נמוכות או אוכלוסיות קשות-יום.
