# file = txt/1500203.txt
# filelineno = 60
# sentno = 3
# text = דיור בהישג-יד הוא דיור הנותן מענה הולם לצורכי הדיור של אוכלוסיות ברמות הכנסה נמוכה-בינונית, שהכנסתן אינה מאפשרת להן לרכוש או לשכור דיור מבלי שהדבר יפגע בהוצאות חיוניות אחרות כגון מזון, בריאות וחינוך, תוך שהוא עושה שימוש בכלים שמטרתם להוריד את מחיר הדיור אל מתחת למחיר השוק (מרכז הגר, 2014, עמי 12).
