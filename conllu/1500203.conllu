# file = txt/1500203.txt
# filelineno = 260
# sentno = 2
# text = רבים מהם עשויים לאבד את דירותיהם עקב צורך בשיפוץ או תיקון, או הוצאות רפואיות לא צפויות; נשים חד-הוריות, אשר מהוות את הקבוצה העיקרית הנתמכת בתכניות הסיוע לדיור ומכאן שקואופרטיב דיור, על כל יתרונותיו החברתיים־כלכליים והקהילתיים, עשוי להתאים לרבות מהן; צעירים בין גילאי 25-34, אשר נדחקים גם הם מחוץ לשוק הדיור עקב מחירי השוק, וכתוצאה מכך חוזרים לגור בבית ההורים; תושבי מרכז העיר, אשר אחוזים גבוהים מהם שוכרים את דירותיהם, ולכן מושפעים רבות מתנודות השוק, אשר במרכזי הערים נוטים לעלות בעקומה
