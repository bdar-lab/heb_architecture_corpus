# file = txt/1500203.txt
# filelineno = 31
# sentno = 1
# text = כתגובה לתהליכי האורבניזציה, המנוהלים ומעוצבים על ידי שיקולי הון גלובליים, החלו מספר תנועות ברחבי העולם לקראת סוף העשור הראשון של המילניום החדש, במידה רבה בעקבות המשבר הכלכלי של 2008, לאמץ את רעיון ״הזכות לעיר״ (The Right to the City), אשר טבע הפילוסוף הצרפתי אנרי לפבר ב- 1968.
