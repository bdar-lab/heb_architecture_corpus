# file = txt/1500203.txt
# filelineno = 475
# sentno = 2
# text = הוא מציג תמונה דואלית, בה מחד גיסא, ישראל הינה חברה שבטית אתנו-לאומית המתקבצת בקבוצות המוגדרות, על פי רוב לפי מוצא ודת, ומאידך גיסא אימצה את ערכי הניאו-ליברליזם עד כדי ״אינדיוידואליזם קיצוני״, לדבריו, בו כל ביטוי של שיתוף - בין אם בבעלות ובין אם בשימוש - "נתפס כמשהו שרצוי להימנע ממנו".
