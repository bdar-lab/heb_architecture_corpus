# file = txt/1500203.txt
# filelineno = 90
# sentno = 2
# text = המלצה זו נשענת על ההכרה בחשיבותם של הקואופרטיבים ביצירת מקומות עבודה, גיוס משאבים, יצירת השקעות ותרומתם לכלכלה בכל מדינות העולם; ההכרה שקואופרטיבים, על שלל תחומיהם, מקדמים באופן המלא ביותר את ההשתתפות האזרחית בכלכלה ובפיתוח החברתי עבור הכלל; וההכרה בכך שהגלובליזציה יצרה תנאים חדשים ועימם לחצים ואתגרים חדשים עבור קואופרטיבים וכלכלה מקומית, ושנדרשים מבנים חזקים יותר לביסוס הסולידריות, על מנת לחלק באופן שוויוני את תוצרי ופירות הגלובליזציה (www.ilo.org).
