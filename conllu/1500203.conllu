# file = txt/1500203.txt
# filelineno = 731
# sentno = 2
# text = מחקר זה חידד עד כמה כלי זה עשוי לחולל מהפיכות קטנות בתחומים רבים בחיי הדיור והמגורים בישראל: קואופרטיב דיור כאמצעי להרחבת שליטת הדיירים על תנאי וסביבות מגוריהם; כמקום בו מתרגלים פרקטיקה דמוקרטית ופוגשים בשכנים כשותפים; קואופרטיב דיור כמענה לקהילתיות ותחושת שייכות, וכאמצעי יעיל להנעת תהליכי התחדשות עירוניים, הן מבחינה פיזית והן מבחינה חברתית; קואופרטיב דיור כאמצעי להעצמת דיירים ותושבים; קואופרטיב דיור כאמצעי ליצירת מלאי דיור בר-השגה ולאורך זמן, והגברת היציבות של הדיירים וביטחונם.
