# file = txt/1500203.txt
# filelineno = 681
# sentno = 2
# text = רתימת החברות המשכנות - ייתכן שניתן ליצור חיבורים ושיתופי פעולה עם החברות המשכנות, בחשיבה ויישום של תכניות קואופרטיביות בדיור הציבורי, על מנת להרחיב את שליטת הדיירים במגוריהם וסביבתם, ועל מנת לייעל את סיפוק הצרכים של הדיירים ואת תחזוקת המבנים, אותם מתקשות החברות המשכנות למלא בטווח הזמן הנדרש (צברי, 2014).
