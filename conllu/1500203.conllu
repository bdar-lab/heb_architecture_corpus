# file = txt/1500203.txt
# filelineno = 618
# sentno = 2
# text = רעיון הקואופרציה מבוסס על פילוסופיה חברתית-כלכלית, המעמידה במרכז המערכת הכלכלית צורת ארגון, המבוסס על שיתוף באמצעי הייצור או בכוח הקנייה של חברי הארגון, תוך שיוויון בין החברים הן בהשקעה והן בפירותיה.
