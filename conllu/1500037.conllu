# file = txt/1500037.txt
# filelineno = 11
# sentno = 4
# text = בנוסף לעצם קיום דפוס התנהגות מקומי של נסיעה על אופניים, העדר מדיניות מוצהרת והעדר מערכת מוסדרת של נתיבים ושבילים המסדירים את תנועת רוכבי האופניים בעיר, מציבים תנאים המאפשרים ללמוד את העדפותיהם של רוכבי האופניים בתנאים בסיסים "ללא תכנון", ללא התערבות מיוחדת מצד מתכננים ומקבלי החלטות.
