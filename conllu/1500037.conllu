# file = txt/1500037.txt
# filelineno = 326
# sentno = 1
# text = בתשובות לשאלות הישירות שבדקו את הדעות לגבי השפעת מאפיינים שונים על חווית הרכיבה באופניים, התבקשו המרואיינים לציין האם מאפיין מסוים משפיע על רכיבה על אופניים בעיר, מה היא מידת ההשפעה-חזקה או חלשה, ומה הוא כיוון ההשפעה: חיובי או שלילי מבחינת רוכבי האופניים (ראה טבלה 41 בעמ' 77).
