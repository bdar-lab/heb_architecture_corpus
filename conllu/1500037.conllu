# file = txt/1500037.txt
# filelineno = 150
# sentno = 1
# text = כדי להסיק מסקנות בנוגע לשאלות אלה תוך שמירה על קשר בין ממצאי המחקר לדיון המקובל במקצועות התכנון השונים כגון, הנדסת תחבורה, עיצוב עירוני וארכיטקטורה, מאופיינת הסביבה הבנויה כמורכבת משתי מערכות: מערכת פנויה, המתייחסת למערכת הדרכים, ומערכת בנויה, הכוללת את המבנים ושימושי הקרקע השונים לאורך הרחובות.
