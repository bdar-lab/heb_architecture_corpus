# file = txt/2700005.txt
# filelineno = 95
# sentno = 3
# text = זאת משום שהתעשיות העשויות להוביל את הצמיחה המחוזית בחלופה זו הן תעשיות בעלות גמישות מיקומית נמוכה יחסית, כגון תעשיות המנצלות משאבי אנרגיה טבעיים (שדות אנרגיה, חומרים מינרליים, כוח גרעיני או הידרו-תרמי וכדומה); תעשיות הנלוות לענף החקלאות, כגון אגרוטכנולוגיה; תעשיות הצורכות שטחים נרחבים; ותעשיות מזהמות או ניסוייות הדורשות ריחוק ממרכזי אוכלוסייה.
