# file = txt/2700005.txt
# filelineno = 365
# sentno = 3
# text = ניתן לראות לדוגמה שמוצרי המזון והביגוד הם את רוב הביקוש לצריכה בארצות מתפתחות (בין 40% ל־ 70%), ואילו בארצות עם רמת הכנסה גבוהה שיעורם יורד ל־ 18% עד 25%, ורוב הביקוש מתרכז במוצרי צריכה מתקדמים יותר (ראה 1992 ,w.d.r, לוח 10).
