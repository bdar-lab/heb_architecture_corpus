# file = txt/1800032.txt
# filelineno = 312
# sentno = 1
# text = העדר תעסוקה איכותית, בצורה מספקת, הגירה שלילית במיוחד של צעירים ומשכילים (כולל סטודנטים שרובם אינם נשארים בעיר), תחרות מיישובי הלוויין בסביבה (עומר, מיתר ולהבים), שוק נדל״ן חלש המאופיין במחירי קרקע נמוכים, תשתית תחבורתית ותחבורה ציבורית לכיוון מרכז הארץ אשר עדיין איננה עונה על הצרכים (למרות השיפור המשמעותי שכבר הושג), מערך שירותים חסר, תשתית לבילוי ותרבות הפנאי, בעיות איכות סביבה וכן מערך אורבאני שטרם גובש דיו (פער בין שכונות ותיקות לבין שכונות חדשות, היעדר רצף של בנייה צפופה במרכז העיר וצורך בחיזוק של אזור המע״ר).
