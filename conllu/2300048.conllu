# file = txt/2300048.txt
# filelineno = 148
# sentno = 2
# text = בהקשר לכך ניתן לציין כי התחרות ההולכת וגדלה בין רשויות מקומיות הגדילה את הפערים בין רשויות מקומיות מבוססות הנהנות מבסיס מם גדול יותר ומיתרונות ראשוניים בתחומים שונים לבין רשויות מקומיות חלשות, שאין להם את האמצעים הכספיים הנדרשים על מגת להתחרות על משאבי פיתוח ולעתים, אף מתחרות זו בזו (רזין, 1991).
