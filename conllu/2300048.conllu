# file = txt/2300048.txt
# filelineno = 443
# sentno = 1
# text = הניתוח ברמת המיקרו מבוצע כשתי דרכים עיקריות: הראשונה, חקר המערכות העירוניות הקיימות וזיהוי בעיות מצד העומדים בראשן, השנייה, מבטאת גישה של "שיתוף הציבור" כשני מובנים: זיהוי בעיות בערים לוד ורמלה; וזיהוי העמדות של קבוצות אוכלרטיה שונות שהוגדרו כמושפעות אר כמשסיערת על האיחרד.
