# file = txt/2300048.txt
# filelineno = 1016
# sentno = 1
# text = חלקו הגדול של המימון הממשלתי מכלל הכנסות הרשות המקומית, והעובדה כי לא ניתן להצביע על קריטריונים ברורים של העברת משאבים לרשויות המקומיות תוך עידוד והגדלת ההכנסה ממקורות פנימיים (אלעזר, קלכהיים, 1987) מביאים אותנו למסקנה כי במציאות הנוכחית משרד הפנים אינו יכול להסתמך על קריטריון היעילות הכלכלית לשם בחינת מיזוגן של ערים מסדר גודל בינוני בישראל.
