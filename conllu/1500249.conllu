# sentno = 7
# text = ראוי לציין כי אחת הקבוצות שאותה חקר כרכבי הינה קבוצת JAZAR CREW, שחלק מחבריה הקימו בהמשך את כבארית, כניסיון לגשר על המגבלות והקשיים בהם דן כרכבי, למשל: התקרית שהתרחשה בין אותה קבוצה לבין אחד המועדונים בעיר התחתית בחיפה, בו הם הפיקו מסיבה בעלת אופי פרו-פלסטיני, כאשר בעקבותיה הם התבקשו לא לערבב תוכן פוליטי במסיבות, על ידי בעלות המועדון (שם).
# raw = {'id': 7, 'text': 'ראוי לציין כי אחת הקבוצות שאותה חקר כרכבי הינה קבוצת JAZAR CREW, שחלק מחבריה הקימו בהמשך את כבארית, כניסיון לגשר על המגבלות והקשיים בהם דן כרכבי, למשל: התקרית שהתרחשה בין אותה קבוצה לבין אחד המועדונים בעיר התחתית בחיפה, בו הם הפיקו מסיבה בעלת אופי פרו-פלסטיני, כאשר בעקבותיה הם התבקשו לא לערבב תוכן פוליטי במסיבות, על ידי בעלות המועדון (שם).', 'dspan': (908, 1249), 'tokens': [{'id': 1, 'text': 'ראוי', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (908, 912), 'span': (0, 4), 'lemma': 'ראוי'}, {'id': 2, 'text': 'לציין', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PIEL|VerbForm=Inf|Voice=Act', 'head': 1, 'deprel': 'csubj', 'dspan': (913, 918), 'span': (5, 10), 'lemma': 'ציין'}, {'id': 3, 'text': 'כי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 13, 'deprel': 'mark', 'dspan': (919, 921), 'span': (11, 13), 'lemma': 'כי'}, {'id': 4, 'text': 'אחת', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'nummod', 'dspan': (922, 925), 'span': (14, 17), 'lemma': 'אחת'}, {'id': (5, 6), 'text': 'הקבוצות', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'קבוצות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 13, 'deprel': 'nsubj:cop', 'lemma': 'קבוצה'}], 'span': (18, 25), 'dspan': (926, 933)}, {'id': (7, 9), 'text': 'שאותה', 'expanded': [{'id': 7, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 10, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 8, 'text': 'אותו_', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Definite=Def', 'head': 9, 'deprel': 'case:acc', 'lemma': 'אותו'}, {'id': 9, 'text': '_היא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Person=3|PronType=Prs', 'head': 10, 'deprel': 'obj', 'lemma': 'הוא'}], 'span': (26, 31), 'dspan': (934, 939)}, {'id': 10, 'text': 'חקר', 'upos': 'VERB', 'xpos': '