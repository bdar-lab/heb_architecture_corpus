# text = במקרה של ח׳שבי, לאחר שהבחירה הערכית גברה על הפונקציונלית, ו״הבית" הפך ל״תיאטרון", אתר הזיכרון הפסיק להיות אובייקט פסיבי, והפך לסוכן אקטיבי המעורר שאלות מהותיות הן על עצם השימוש בו, והן על משמעויות וצורת הבניית העירוניות הפלסטינית העכשווית בישראל: האם העירוניות הפלסטינית העכשווית צריכה להתקיים במבנה, אתר או מרחב עם זיקה לעירוניות הפלסטינית לפני 1948?
# raw = {'id': 1, 'text': 'במקרה של ח׳שבי, לאחר שהבחירה הערכית גברה על הפונקציונלית, ו״הבית" הפך ל״תיאטרון", אתר הזיכרון הפסיק להיות אובייקט פסיבי, והפך לסוכן אקטיבי המעורר שאלות מהותיות הן על עצם השימוש בו, והן על משמעויות וצורת הבניית העירוניות הפלסטינית העכשווית בישראל: האם העירוניות הפלסטינית העכשווית צריכה להתקיים במבנה, אתר או מרחב עם זיקה לעירוניות הפלסטינית לפני 1948?', 'dspan': (0, 351), 'tokens': [{'id': (1, 2), 'text': 'במקרה', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'מקרה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 29, 'deprel': 'obl', 'lemma': 'מקרה'}], 'span': (0, 5), 'dspan': (0, 5)}, {'id': 3, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 4, 'deprel': 'case', 'dspan': (6, 8), 'span': (6, 8), 'lemma': 'של'}, {'id': 4, 'text': 'ח׳שבי', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 2, 'deprel': 'nmod:poss', 'dspan': (9, 14), 'span': (9, 14), 'lemma': 'ח׳שבי'}, {'id': 5, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (14, 15), 'span': (14, 15), 'lemma': ','}, {'id': 6, 'text': 'לאחר', 'upos': 'ADP', 'xpos': 'ADP', 'head': 12, 'deprel': 'case', 'dspan': (16, 20), 'span': (16, 20), 'lemma': 'לאחר'}, {'id': (7, 9), 'text': 'שהבחירה', 'expanded': [{'id': 7, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 12, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 8, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 9, 'deprel': 'det', 'lemma': 'ה'}, {'id': 9, 'text': 'בחירה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 12, 'deprel': 'nsubj', 'lemma': 'בחירה'}], 'span': (21, 28), 'dspan': (21, 28)}, {'id': (10, 11), 'text': 'הערכית', 'expanded': [{'id': 10, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 11, 'deprel': 'det', 'lemma': 'ה'}, {'id': 11, 'text': 'ערכית', 'upos': 'ADJ', 'xpos': '