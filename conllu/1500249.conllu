# file = txt/1500249.txt
# filelineno = 240
# sentno = 3
# text = מעבר לכך, לאחר שנפתח המתג׳ר, פטוש הפך לאחת חנויות הספרים החשובות ביותר בקרב החברה הפלסטינית, דבר זה בא לידי ביטוי בעיקר בזמן יריד הספרים המתקיים במקום, שאותו פקדו בשנתה השנייה למשל, כ-4000 איש.
