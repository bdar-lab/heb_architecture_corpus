# file = txt/1500249.txt
# filelineno = 38
# sentno = 6
# text = לטענת רבינוביץ׳ ואבו בקר (2002), המרכיב ״ערבים״ אינו מאיים על הפרויקט האתני-טריטוריאלי הישראלי: "ערב" הוא חצי אי מרוחק שתחת חסותו ישנן קבוצות מגוונות המונות מאות מיליוני אנשים, לפיכך אנשים אלה הם בעלי מכנה משותף תרבותי ולא טריטוריאלי, ללא זיקה לארץ בה הוקמה ישראל, בניגוד ל״פלסטינים".
