# file = txt/1500249.txt
# filelineno = 498
# sentno = 1
# text = המחקר עקב אחר התפתחותה של סצנת התרבות הפלסטינית העצמאית בחיפה מתחילת הירקמות התגלמותה המרחבית והפיזית, אשר התחילה לקבל אפיונים מובהקים בשנת 2015 עם פתיחת אתרי התרבות הראשונים והתגבשות צורות העשייה התרבותית העכשוויים, והוא מסתיים עם תופעות המסמנות לכאורה את תחילת התפוררותה בצורתה הנוכחית בסוף שנת 2019.
