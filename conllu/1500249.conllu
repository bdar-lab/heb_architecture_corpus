# text = במישור השני, מחקר זה מוסיף היבט מרחבי ואדריכלי, המעמיק את חקר העירוניות הפלסטינית ברבדיה השונים: המגדריים (חסן, 2008,2005, 2017 ; 2009 ,Herzog) החברתיים (ח׳מאיסי, 2018 ; ג׳בארין, 2009) התרבותיים והאמנותיים (סלע, 2013 ; 2013 ,Karkabi), בהקשר של הזהות הפלסטינית העירונית, סוכני התרבות הפלסטינים, המרחב הפיזי הבנוי, זירות הפעולה הקיימות והופעת זירות חדשות כגון: זירות פעולה נשית, זירות קוויריות וזירות ווירטואליות.
# raw = {'id': 4, 'text': 'במישור השני, מחקר זה מוסיף היבט מרחבי ואדריכלי, המעמיק את חקר העירוניות הפלסטינית ברבדיה השונים: המגדריים (חסן, 2008,2005, 2017 ; 2009 ,Herzog) החברתיים (ח׳מאיסי, 2018 ; ג׳בארין, 2009) התרבותיים והאמנותיים (סלע, 2013 ; 2013 ,Karkabi), בהקשר של הזהות הפלסטינית העירונית, סוכני התרבות הפלסטינים, המרחב הפיזי הבנוי, זירות הפעולה הקיימות והופעת זירות חדשות כגון: זירות פעולה נשית, זירות קוויריות וזירות ווירטואליות.', 'dspan': (616, 1027), 'tokens': [{'id': (1, 3), 'text': 'במישור', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'ה_', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'מישור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 9, 'deprel': 'obl', 'lemma': 'מישור'}], 'span': (0, 6), 'dspan': (616, 622)}, {'id': (4, 5), 'text': 'השני', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'שני', 'upos': 'NUM', 'xpos': 'NUM', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'amod', 'lemma': 'שני'}], 'span': (7, 11), 'dspan': (623, 627)}, {'id': 6, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 9, 'deprel': 'punct', 'dspan': (627, 628), 'span': (11, 12), 'lemma': ','}, {'id': 7, 'text': 'מחקר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 9, 'deprel': 'nsubj', 'dspan': (629, 633), 'span': (13, 17), 'lemma': 'מחקר'}, {'id': 8, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Dem', 'head': 7, 'deprel': 'det', 'dspan': (634, 636), 'span': (18, 20), 'lemma': 'זה'}, {'id': 9, 'text': 'מוסיף', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HIFIL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (637, 642), 'span': (21, 26), 'le