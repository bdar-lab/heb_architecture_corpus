# file = txt/1500249.txt
# filelineno = 426
# sentno = 6
# text = במפגש עם סנא ג׳מאליה שהיתה בעלת ה-SCENE לצד שותפתה היבא סלאמה, היא שיתפה אותי בקשיים הכרוכים בהתמודדותה עם החברה מצד אחד, ועם אנשי חיי הלילה מצד אחר, אך מנגד, היא גם שיתפה סיטואציה מפתיעה: לאור העובדה שהבר מנוהל על ידי שתי נשים, רמת האלימות במקום היתה נמוכה וכמעט אפסית ביחס לברים פלסטינים אחרים בעיר.
