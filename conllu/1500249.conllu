# file = txt/1500249.txt
# filelineno = 482
# sentno = 4
# text = הוא זוקף לזכות המדיה החברתית את האפשרות להפקת מוזיקה פלסטינית, לעומת הקושי בהפקת הופעות חיות ומסיבות: כאשר הדבר מתרגם לעולם הפיזי, יוצרי התרבות והמוזיקה עומדים מול קשיים בעיקר לאור ההגבלות על ביטויים לאומיים פלסטיניים במרחב הישראלי, במקביל לנורמות חברתיות ותרבותיות מגבילות בתוך החברה הפלסטינית עצמה(,Karkabi 2013).
