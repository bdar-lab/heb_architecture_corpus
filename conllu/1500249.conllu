# file = txt/1500249.txt
# filelineno = 470
# sentno = 2
# text = ההשתנות וההתחדשות העיקרית טמונה בתפיסתם של סוכניה ויוזמותיהם המתנערות מהזירה הפוליטית המפלגתית, הממסד הישראלי וההגבלות החברתיות הפלסטיניות, אל מול עשייה עצמאית ויצירה של מצע תרבות עירוני פלסטיני המבנה זהות פלסטינית עירונית עכשווית, ומבוסס על ערכים חברתיים ליברלים ופרוגרסיביים כמו שוויון מיני ומגדרי.
