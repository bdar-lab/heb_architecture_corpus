# file = txt/1500249.txt
# filelineno = 193
# sentno = 3
# text = בנוסף, כבארית אירח את פסטיבל Globalvision, שהופק כאקט מחאתי הקורא להחרים את האירוויזיון בתל אביב בשנת 2019, והציע אלטרנטיבה שדרכה שודרו הופעות חיות של אמנים בלונדון, דבלין, חיפה (כבארית) ובית לחם באופן סימולטני.
