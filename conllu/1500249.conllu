# file = txt/1500249.txt
# filelineno = 410
# sentno = 2
# text = הכמיהה לעירוניות פלסטינית מקבלת ביטויים במישורים שונים: אורח חיים המתנגד למוסכמות החברתיות המסורתיות, תהליכי אינדיבידואליזציה בחברה הפלסטינית (ג׳מאל, 2017), המעבר של זוגות צעירים רבים אל הערים,59 ביטויים בפרקטיקות הזיכרון, האומנות והיצירה, ביטויים בתוכן התרבותי, בעשייה התרבותית בשטח, וגם בשיח החברתי והאקדמי.
