# file = txt/1500249.txt
# filelineno = 509
# sentno = 1
# text = במהלך המחקר, הזדמן לי להעביר כמה הרצאות בנושא העירוניות הפלסטינית המתחדשת בחיפה, דבר אשר תרם לי רבות להבנה מעמיקה ורחבה של תופעת העירוניות הפלסטינית ומשמעותיה, ודרכן נחשפתי לפרספקטיבות ותגובות שונות בתכלית השוני, הן מהקהל הישראלי והן מהקהל הפלסטיני.
