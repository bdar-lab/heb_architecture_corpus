# file = txt/1500201.txt
# filelineno = 244
# sentno = 5
# text = בניגוד לשיח הרחב הקיים בנושא בעולם ולמרות מגמת ההשתלבות של שותפויות אקדמיה-קהילה במסגרת האקדמית, המחקר בישראל על שותפויות אקדמיה-קהילה באקדמיה הישראלית, באופן כללי (גולן ורוזנפלד, 2015, 14; גולן־עגנון ואחי, 2005) ובהכשרת מתכנני ערים בפרט (2000 ,Weinberg ; טל, 2012), נמצא עדיין בראשיתו והכתיבה אודותיו מעטה.
