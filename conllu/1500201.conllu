# file = txt/1500201.txt
# filelineno = 300
# sentno = 2
# text = הקמת הדיסציפלינה בישראל הושפעה ממגמות שהתרחשו בעולם המדעי במערב, התפתחות מחשבת התכנון התהליכית והמערכתית (אי, 2015), ולוותה בהתנגדות חריפה של ארגונים מקצועיים מקבילים (אדריכלים ומהנדסים) ואקדמיים (תכניות אחרות בפקולטה), אשר חששו למקומם בזירה התכנונית בישראל (בי, 2015 ; ג', 2015).
