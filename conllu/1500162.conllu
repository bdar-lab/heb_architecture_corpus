# file = txt/1500162.txt
# filelineno = 106
# sentno = 1
# text = כמו-כן, מתאר Miron ארבע גישות הנהוגות לקביעת הוצאות הדיור או "הוצאות המכסה״ (עמוד 110): תקציב מינימום, הכולל את ההוצאות המינימליות הדרושות לדיור ומוצרים אחרים להם זכאים משקי בית בהרכבים שונים; חיתוך משקי בית בעלי ההכנסות הנמוכות, המוגדרים ככאלה המוציאים על דיור והוצאות אחרות יותר מאשר סכום מסוים; היחס בין "הוצאות המכסה" לבין ההכנסה נדרש להיות מעל לשיעור מסוים; "הצורך הבסיסי" של משק-בית מוגדר כ״הוצאות המכסה" אך אליו מתווספת התייחסות בו-זמנית אל התאמת הדיור לצורכי המשק-בית.
