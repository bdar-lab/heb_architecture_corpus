# file = txt/1500162.txt
# filelineno = 36
# sentno = 2
# text = בניגוד לעבודות אלו המחקר האמפירי המתואר בחלק ד׳ לא רק שמציע שיטה לתיקון תת־ ועל־צריכת מגורים אפשרית בהערכת היכולת לרכוש דיור של משקי בית, אלא גם אומדת את הקשר שבין היכולת לרכוש דיור ותת- ועל-צריכת דיור ובין סדרה של משתנים חברתיים־דמוגרפיים (כגון, מספר שנות לימוד, דת, תעשייה, ומגדר) ומיקומיים (כגון, מדד נגישות פוטנציאלית ומדד חברתי־כלכלי של מקום מגורי משק הבית), בהתבסס על תקופה ממושכת של נתוני חתך המצורפים יחדיו לפנל.
