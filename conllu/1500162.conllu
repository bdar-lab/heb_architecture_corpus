# file = txt/1500162.txt
# filelineno = 314
# sentno = 2
# text = ניתן לראות שבמהלך שנות התשעים של המאה העשרים חלה הרעה במצבם של עשירוני ההכנסה הנמוכים - מגמה שהתייצבה בשנים 2000-2005 בהן משקי הבית משלושת עשירוני ההכנסה הנמוכים נמצאו מעל לרף ה- 30% (דהיינו, הוצאות הדיור גבו למעלה מ- 30% מהכנסת משק הבית נטו).
