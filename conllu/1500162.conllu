# file = txt/1500162.txt
# filelineno = 450
# sentno = 2
# text = ניתן להבחין שבזמן שסימני המקדמים ומובהקותם הסטטיסטית באופן כללי נשמרת בהשוואה לאלו שנתקבלו מוקדם יותר, תחת מדד היכולת לרכוש דיור האפקטיבית (השווה עם עמוד 1 טבלה 16), הערכים של האומדים, באופן כללי פוחתים במונחים אבסולוטיים—ובכך מצביעים על הערכת חסר של הקשר בין היכולת לרכוש דיור ובין מאפיינים סוציו־דמוגרפיים, בהעדר תקנון צריכת הדיור של משקי הבית.
