# file = txt/1500162.txt
# filelineno = 451
# sentno = 1
# text = ניתן בעיקר להבחין שבהשוואה לשכירות של יחידת הדיור, הבעלות עליה תואמת עם הפחתה של רק 3 חודשים ביחס מחיר הדיור להכנסה נטו של משק הבית (בהשוואה עם 11 חודשים לפי המדד המתוקנן); בהשוואה לקטגוריית 0 שנות לימוד של ראש משק הבית, רמות ההשכלה השונות של ראש משק הבית תואמות עם הפחתה של 15-59 חודשים ביחס מחיר הדיור להכנסת משק בית נטו (בהשוואה עם 21-89 חודשים תחת המדד המתוקנן); בהשוואה לראש משק בית יהודי או אחר, ראש משק בית ערבי מתקשר עם גידול של 16 חודשים ביחס מחיר דיור להכנסת משק בית נטו (בהשוואה עם 27 חודשים תחת המדד המתוקנן); ועלייה של סטיית תקן אחת במדד הנגישות הפוטנציאלית של היישוב בו מתגורר משק הבית, תואם לעלייה של 25.6 חודשים ביחס שבין מחיר הדיור לבין הכנסת משק בית נטו (בהשוואה עם 30.7 חודשים תחת המדד המתוקנן).
# raw = {'id': 1, 'text': 'ניתן בעיקר להבחין שבהשוואה לשכירות של יחידת הדיור, הבעלות עליה תואמת עם הפחתה של רק 3 חודשים ביחס מחיר הדיור להכנסה נטו של משק הבית (בהשוואה עם 11 חודשים לפי המדד המתוקנן); בהשוואה לקטגוריית 0 שנות לימוד של ראש משק הבית, רמות ההשכלה השונות של ראש משק הבית תואמות עם הפחתה של 15-59 חודשים ביחס מחיר הדיור להכנסת משק בית נטו (בהשוואה עם 21-89 חודשים תחת המדד המתוקנן); בהשוואה לראש משק בית יהודי או אחר, ראש משק בית ערבי מתקשר עם גידול של 16 חודשים ביחס מחיר דיור להכנסת משק בית נטו (בהשוואה עם 27 חודשים תחת המדד המתוקנן); ועלייה של סטיית תקן אחת במדד הנגישות הפוטנציאלית של היישוב בו מתגורר משק הבית, תואם לעלייה של 25.6 חודשים ביחס שבין מחיר הדיור לבין הכנסת משק בית נטו (בהשוואה עם 30.7 חודשים תחת המדד המתוקנן).', 'dspan': (0, 714), 'tokens': [{'id': 1, 'text': 'ניתן', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|VerbType=Mod|Voice=Pass', 'head': 0, 'deprel': 'root', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'ניתן'}, {'id': 2, 'text': 'בעיקר', 'upos': 'ADV', 'xpos': 'ADV', 'head': 1, 'deprel': 'advmod', 'dspan': (5, 10), 'span': (5, 10), 'lemma': 'בעיקר'}, {'id': 3, 'text': 'להבחין', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=HIFIL|VerbForm=Inf|Voice=Act', 'head': 1, 'deprel': 'csubj:pass', 'dspan': (11, 17), 'span': (11, 17), 'lemma': 'הבחין'}, {'id': (4, 6), 'text': 'שבהשוואה', 'expanded': [{'id': 4, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 18, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 5, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'ב'}, {'id': 6, 'text': 'השוואה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'fixed', 'lemma': 'השוואה'}], 'span': (18, 26), 'dspan': (18, 26)}, {'id': (7, 8), 'text': 'לשכירות', 'expanded': [{'id': 7, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'fixed', 'lemma': 'ל'}, {'id': 8, 'text': 'שכירות', 'upos': 'NOUN', 'xpos': 'NOUN'