# text = 5 למרות תצוגת העמידות המרשימה של כלכלת ישראל למשבר הפיננסי העולמי, וכתוצאה מעלייה מתמדת של מחירי הדיור, חלה החמרה משמעותית ביכולת לרכוש דיור של משקי בית לאורך התקופה הנבחנת בעבודה זאת וביתר שאת בשנים 2012־2007 ; למרות המחאה החברתית שהגיעה לשיאה במדינת ישראל בקיץ 2011, ההחמרה ביכולת לרכוש דיור בישראל ממשיכה בימים אלה ומהווה נושא מרכזי בשיח הכלכלי-חברתי גם בשנת 2015.
# raw = {'id': 2, 'text': '5 למרות תצוגת העמידות המרשימה של כלכלת ישראל למשבר הפיננסי העולמי, וכתוצאה מעלייה מתמדת של מחירי הדיור, חלה החמרה משמעותית ביכולת לרכוש דיור של משקי בית לאורך התקופה הנבחנת בעבודה זאת וביתר שאת בשנים 2012־2007 ; למרות המחאה החברתית שהגיעה לשיאה במדינת ישראל בקיץ 2011, ההחמרה ביכולת לרכוש דיור בישראל ממשיכה בימים אלה ומהווה נושא מרכזי בשיח הכלכלי-חברתי גם בשנת 2015.', 'dspan': (155, 522), 'tokens': [{'id': 1, 'text': '5', 'upos': 'NUM', 'xpos': 'NUM', 'head': 29, 'deprel': 'punct', 'dspan': (155, 156), 'span': (0, 1), 'lemma': '5'}, {'id': 2, 'text': 'למרות', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'dspan': (157, 162), 'span': (2, 7), 'lemma': 'למרות'}, {'id': 3, 'text': 'תצוגת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 29, 'deprel': 'obl', 'dspan': (163, 168), 'span': (8, 13), 'lemma': 'תצוגת'}, {'id': (4, 5), 'text': 'העמידות', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'עמידות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'compound', 'lemma': 'עמידות'}], 'span': (14, 21), 'dspan': (169, 176)}, {'id': (6, 7), 'text': 'המרשימה', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'מרשימה', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'amod', 'lemma': 'מרשים'}], 'span': (22, 29), 'dspan': (177, 184)}, {'id': 8, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 9, 'deprel': 'case', 'dspan': (185, 187), 'span': (30, 32), 'lemma': 'של'}, {'id': 9, 'text': 'כלכלת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'nmod:poss', 'dspan': (188, 193), 'span': (33, 38), 'lemma': 'כלכלה'}, {'id': 