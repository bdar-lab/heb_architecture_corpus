# sentno = 1
# text = בתקופה בה היכולת לרכוש דיור ממשיכה לתפוס מקום מרכזי בשיח הפוליטי, השיטה אותה פיתחנו לאמידת אי-שוויון ביכולת לרכוש דיור והתוצאות המציגות את ההתאמה החיובית בין אי-השוויון ביכולת לרכוש דיור לבין ממוצע מחירי הדיור, ובנוסף, היכולת לזהות פילוח סוציו-דמוגראפי ביכולת לרכוש דיור, יכול לסייע לקובעי המדיניות בתכנון מדיניות דיור שתגביר את היכולת לרכוש דיור היכן שצריך במיוחד, וכתוצאה מכך תפחית באופן אפקטיבי את אי־ השוויון והריבוד ביכולת לרכוש דיור.
