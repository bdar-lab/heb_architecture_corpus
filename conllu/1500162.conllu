# file = txt/1500162.txt
# filelineno = 279
# sentno = 4
# text = תוצאות אלה מצביעות על-כך ששוק הדיור המקומי לא רק שנמנע ממעידה בתקופת המשבר הפיננסי העולמי, בשנים 2007-2009, אלא, כפי שניתן לטעון, מראה סימנים מדאיגים ראשונים של מחירי דיור בועתיים, שנצפו בעבר בשווקים אחרים בעולם, לפני המשבר הפיננסי העולמי.
