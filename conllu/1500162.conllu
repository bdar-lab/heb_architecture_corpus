# sentno = 3
# text = בהקשר זה של ההפגנות החברתיות הנרחבות שהתרחשו בערים מערביות שונות (ובכללן תל-אביב), שהתעוררו בעיקר לאור הביקוש לשיפור ביכולת משקי בית לרכוש דיור, המצב המתואר של עלייה חדה ביחס מחירי הדיור להכנסת משק בית, החל משנת 2007, של 40 חודשי הכנסה נטו, צריך לעניין ולהדאיג, במיוחד בהיבט של מדיניות הדיור הממשלתית.
# raw = {'id': 3, 'text': 'בהקשר זה של ההפגנות החברתיות הנרחבות שהתרחשו בערים מערביות שונות (ובכללן תל-אביב), שהתעוררו בעיקר לאור הביקוש לשיפור ביכולת משקי בית לרכוש דיור, המצב המתואר של עלייה חדה ביחס מחירי הדיור להכנסת משק בית, החל משנת 2007, של 40 חודשי הכנסה נטו, צריך לעניין ולהדאיג, במיוחד בהיבט של מדיניות הדיור הממשלתית.', 'dspan': (326, 627), 'tokens': [{'id': (1, 2), 'text': 'בהקשר', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'הקשר', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 71, 'deprel': 'obl', 'lemma': 'הקשר'}], 'span': (0, 5), 'dspan': (326, 331)}, {'id': 3, 'text': 'זה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Dem', 'head': 2, 'deprel': 'det', 'dspan': (332, 334), 'span': (6, 8), 'lemma': 'זה'}, {'id': 4, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 6, 'deprel': 'case', 'dspan': (335, 337), 'span': (9, 11), 'lemma': 'של'}, {'id': (5, 6), 'text': 'ההפגנות', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'הפגנות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 2, 'deprel': 'nmod:poss', 'lemma': 'הפגנה'}], 'span': (12, 19), 'dspan': (338, 345)}, {'id': (7, 8), 'text': 'החברתיות', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'חברתיות', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Plur', 'head': 6, 'deprel': 'amod', 'lemma': 'חברתיות'}], 'span': (20, 28), 'dspan': (346, 354)}, {'id': (9, 10), 'text': 'הנרחבות', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 10, 'deprel': 'det', 'lemma': 'ה'}, {'id': 10, 'text': 'נרחבות', 'upos': 'ADJ'