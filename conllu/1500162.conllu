# file = txt/1500162.txt
# filelineno = 24
# sentno = 4
# text = בנוסף לכך, מצאנו שבעוד שהיכולת לרכוש דיור ירדה בצורה ניכרת בקרב כל המגזרים החברתיים־דמוגראפיים בין השנים 1992-2011, קיים שינוי משמעותי ביכולת לרכוש דיור בעיקר בפילוח לפי מגדר ראש משק הבית, מצב משפחתי של ראש משק הבית, מצב תעסוקתי של ראש משק הבית, מספר המפרנסים במשק הבית והמיקום הגיאוגרפי של משק הבית.
