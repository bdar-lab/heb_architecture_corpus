# text = ראשית, 156,583 תצפיות של משקי בית שונים, ברמת המיקרו, באשר למאפיינים כלכליים־חברתיים, דמוגראפיים ומאפייני יחידת דיור, התקבלו מיתוך סקרי הכנסות והוצאות של משק בית, אשר נערכו על ידי הלשכה המרכזית לסטטיסטיקה בין השנים 1992-2011 (ראו פירוט של הנתונים על-פי מילון קובצי משקי בית של סקרי ההכנסות בנספחים ג׳ ו-ד׳).
# raw = {'id': 2, 'text': 'ראשית, 156,583 תצפיות של משקי בית שונים, ברמת המיקרו, באשר למאפיינים כלכליים־חברתיים, דמוגראפיים ומאפייני יחידת דיור, התקבלו מיתוך סקרי הכנסות והוצאות של משק בית, אשר נערכו על ידי הלשכה המרכזית לסטטיסטיקה בין השנים 1992-2011 (ראו פירוט של הנתונים על-פי מילון קובצי משקי בית של סקרי ההכנסות בנספחים ג׳ ו-ד׳).', 'dspan': (42, 349), 'tokens': [{'id': 1, 'text': 'ראשית', 'upos': 'ADV', 'xpos': 'ADV', 'head': 29, 'deprel': 'advmod', 'dspan': (42, 47), 'span': (0, 5), 'lemma': 'ראשית'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (47, 48), 'span': (5, 6), 'lemma': ','}, {'id': 3, 'text': '156,583', 'upos': 'NUM', 'xpos': 'NUM', 'head': 4, 'deprel': 'nummod', 'dspan': (49, 56), 'span': (7, 14), 'lemma': '156,583'}, {'id': 4, 'text': 'תצפיות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 29, 'deprel': 'nsubj:pass', 'dspan': (57, 63), 'span': (15, 21), 'lemma': 'תצפית'}, {'id': 5, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 6, 'deprel': 'case', 'dspan': (64, 66), 'span': (22, 24), 'lemma': 'של'}, {'id': 6, 'text': 'משקי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'nmod:poss', 'dspan': (67, 71), 'span': (25, 29), 'lemma': 'משק'}, {'id': 7, 'text': 'בית', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'compound', 'dspan': (72, 75), 'span': (30, 33), 'lemma': 'בית'}, {'id': 8, 'text': 'שונים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 6, 'deprel': 'amod', 'dspan': (76, 81), 'span': (34, 39), 'lemma': 'שונה'}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 11, 'deprel': 'punct', 'dspan': (81, 82), 'span': (39, 40), 'lemma': ','}, {'id': (10, 11), 'text': 'ברמת', 'expanded': [{'id': 10, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'lemma': 'ב'}, {'id': 11, 'text': 'רמת