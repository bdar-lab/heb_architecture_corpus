# file = txt/1500162.txt
# filelineno = 383
# sentno = 3
# text = ניתן לקשר את העלייה החדה ביחס ממוצע מחיר דיור-הכנסה נטו בירושלים ותל אביב (בהשוואה לצפון וקריות), בין סיבות אפשריות אחרות, עם העלייה החדה במחירי הנדל״ן באזורים ספציפיים אלו מאז שנת 2007. 93 בנוסף, תל אביב וירושלים מובילות את כל האזורים ברמת אי־השוויון ביכולת לרכוש דיור, עם מדד ג׳יני של 0.32 בשנת 2011.
