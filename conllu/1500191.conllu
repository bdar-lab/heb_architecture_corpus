# file = txt/1500191.txt
# filelineno = 197
# sentno = 9
# text = חתכים בהם נמצא עושר מיני צומח מעוצה גבוה במיוחד נמצאו בחלקות 6,19,17,21,22 , חלקות אלו כללו חלקת אורן קנר׳ בוגר צפופה מאוד, חלקת אורן ברוטיה וותיקה ודלילה עם תת יער מפותח, חלקת חורש ים תיכוני בתצורת גריגה עם אורנים בצמוד לחניית מרכז המבקרים וחלקה נוספת בצמוד למצור אל עקב, חלקה של בתה ים תיכונית מפותחת, בבחינת הדמיון בין שלשת חתכי הצומח שבוצעו בכל אחת מחלקות המחקר עולה כ׳ רק בחלקה אחת נמצאו הבדלים משמעותיים בין החתכים השונים.
