# file = txt/1500191.txt
# filelineno = 197
# sentno = 11
# text = כאשר בוחנים את עושר מיני הצומח המעוצה בחלקות השונות עולה כ׳ החלקה בה היה עושר המינים הגבוה ביותר- חלקה מסי 12 ( 15 מינים ) (איור 11) וחלקות נוספות בהן היה עושר המינים גבוה מיוחד - חלקות 19,17, 21, 22 ( 13 מינים) היו חלקות בהן הייתה צמחיית בתה וגריגה מפותחות בשילוב של אורנים ( להוציא חלקה 22 בה לא נמצאו עצי אורן).
