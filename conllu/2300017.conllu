# file = txt/2300017.txt
# filelineno = 29
# sentno = 3
# text = במקביל החלה להסתמן ההכרה כי היעדים לתכנון הפיזי שאובים כמעט תמיד, במודע או שלא במודע, מהתחומים הכלכליים והחברתיים, אף אם האמצעים הם בעיקרם פיזיים (ראה המעגל האמצעי באיור 1)יכן הורחבה ההתיחסות כך שאיפשרהלכלול בתכנית מספר אמצעים שאינם פיזיים, אשר השפעתם החזויה פיזית: למשל, מיסוי כתמריץ וכסנקציה להכוונת פתוח .
