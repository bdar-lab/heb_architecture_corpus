# file = txt/2300017.txt
# filelineno = 111
# sentno = 1
# text = על פי רוח דברים אלה ועל אף ציטוט סי 63 והמלה "כמקובל", ניתן לשער כי גם תכנית אשר עיקרה מדיניות או עקרונות פיתוח ואשר רק חלקה מבוטא במפה (כגון, רשת הדרכים המרכזיות ואזורים ירוקים עיקריים), והמשאירה לתכנון המפורט את הגדרת זכויות הבנייה, תתקבל על-ידי בתי-המשפט -אם תועלה השאלה -כתכנית מיתאר.
