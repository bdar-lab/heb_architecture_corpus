# file = txt/2300082.txt
# filelineno = 189
# sentno = 1
# text = אי אפשר שלא לראות את הדמיון הרב בכווני ההגירה כלפי תל אביב ומתל אביב למודל ההגירה הקלאסי בגיאוגרפיה שבו במדינות המאופיינות במבנה של גלעין־שוליים מתקיימת הגירה בעלת טווח הגירה גבוה מאיזורי הפריפריה של המדינה אל האיזורים המטרופוליטניים ובמיוחד אל הגלעינים שלהם מצד אוכלוסיות בעלות סטטוס סוציו-כלכלי נמוך, הגירה שלאחר תקופת הסתגלות וביסוס כלכלי שבה להשתלב במגמות ההגירה בעלות טווח קצר מהמרכזים המטרופוליניים אל שוליהם.
