# file = txt/2300082.txt
# filelineno = 374
# sentno = 1
# text = תהליך השיפוץ התמקד ברוב תת-הרובעים של איזור המרכז אם כי בתת-הרובעים הצפוניים יותר שכיחות השיפוצים גבוהה יותר זאת בדומה לתפרוסת של הבנייה החדשה, המפות מלמדות (איור43-41) שאיזורי המרכז הפכו למוקדי השיפוץ החשובים ביותר בתל אביב להוציא את אזור השיקום ביפו.
