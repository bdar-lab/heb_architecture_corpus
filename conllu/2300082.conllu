# file = txt/2300082.txt
# filelineno = 390
# sentno = 1
# text = - תופעת "החזרה אל העיר" קשורה בארצות המערב, ובמיוחד בצפון אמריקה, גם במעורבות של יזמים ומתווכחים בשוק הדיור במרכז העיר ( 1982 Smith תהליך ההתדרדרות שמאפיין חלקים נרחבים במרכזי הערים הממרופוליטניות גורם לכניסתם של יזמים ומשקיעים הרוכשים את הרכוש הבנוי בשכונות הוותיקות והמתדרדרות במחירים נמוכים, משקמים אל בתי המגורים ומוציאים אותם למכירה.
