# file = txt/2300082.txt
# filelineno = 150
# sentno = 5
# text = לסיכום, ניתן למיין את איזורי תל-אביב לשלושה איזורים עיקריים על פי מגמותיהם במאזני ההגירה: איזורי מרכז העיר בהם השתנו שיעורי מאזן ההגירה ממאזנים שליליים במחצית הראשונה של שנות השבעים למאזנים חיוביים בשנות השמונים, איזורים שהפכו למוקדי צמיחה עיקריים בעיר, איזורי הבניה החדשה מצפון לירקון (רובע 2,1) במזרח ובדרום מזרח העיר (רובע 9) באיזורים אלו, בהתאם לתקופות הבניה נשמרים מאזני הגירה קרובים ל- 0, כלומר מספר הנכנסים והיוצאים מאיזורים אלו כמעט ומשתווה, איזורי דרום תל-אביב, השומרים על מאזני הגירה שליליים גבוהים יחסית עד לאמצע שנות השמונים ורק לאחרונה מראים מגמה של צמצום הפער ביניהם לבין שאר איזורי העיר, מגמה הבולטת במיוחד בתת-רובעים 73 ו-74 ביפו, ובמספר תת-רובעים אחרים בדרום העיר.
