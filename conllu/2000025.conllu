# file = txt/2000025.txt
# filelineno = 704
# sentno = 2
# text = מאורעות בטחוני ים קשים, כמו "השבת השחורה" בשנת 1946, עת נכנסו חיילים בריטיים עם טנקים לקיבוץ יכור, הוכרז עוצר ונעצרו חברי קיבוץ רבים, כרמו כם למחסור חמור במים, ולהפסקת העבודה בכן . כם בתקופת "מלחמת העצמאות", נכרמו נזקים קשים לכן בקיבוץ (יומן יכור, 29.6.1946; יומן יכור, 23.7.1946) ולאחר המלחמה הוכנה תכנית לתיקון ההזנחה, כפי שדיווח איש הנוי בעלון הקיבוץ, "חודשה העבודה ויש לקוות שבזמן הקרוב יוסרו הסימנים למצב שהיינו שרויים בו מאז חודש אפריל" (ידיעות משמר-העמק, 24.11.1940).
# raw = {'id': 2, 'text': 'מאורעות בטחוני ים קשים, כמו "השבת השחורה" בשנת 1946, עת נכנסו חיילים בריטיים עם טנקים לקיבוץ יכור, הוכרז עוצר ונעצרו חברי קיבוץ רבים, כרמו כם למחסור חמור במים, ולהפסקת העבודה בכן . כם בתקופת "מלחמת העצמאות", נכרמו נזקים קשים לכן בקיבוץ (יומן יכור, 29.6.1946; יומן יכור, 23.7.1946) ולאחר המלחמה הוכנה תכנית לתיקון ההזנחה, כפי שדיווח איש הנוי בעלון הקיבוץ, "חודשה העבודה ויש לקוות שבזמן הקרוב יוסרו הסימנים למצב שהיינו שרויים בו מאז חודש אפריל" (ידיעות משמר-העמק, 24.11.1940).', 'dspan': (69, 543), 'tokens': [{'id': 1, 'text': 'מאורעות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 128, 'deprel': 'nsubj', 'dspan': (69, 76), 'span': (0, 7), 'lemma': 'מאורע'}, {'id': 2, 'text': 'בטחוני ים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'amod', 'dspan': (77, 86), 'span': (8, 17), 'lemma': 'בטחוני ים'}, {'id': 3, 'text': 'קשים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'amod', 'dspan': (87, 91), 'span': (18, 22), 'lemma': 'קשה'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (91, 92), 'span': (22, 23), 'lemma': ','}, {'id': 5, 'text': 'כמו', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'dspan': (93, 96), 'span': (24, 27), 'lemma': 'כמו'}, {'id': 6, 'text': '"', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 8, 'deprel': 'punct', 'dspan': (97, 98), 'span': (28, 29), 'lemma': '"'}, {'id': (7, 8), 'text': 'השבת', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'שבת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'nmod', 'lemma': 'שבת'}], 'span': (29, 33), 'dspan': (98, 102)}, {'id': (9, 10), 'text': 'השחורה', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 10, 'deprel': 'det', 'lemma': 