# file = txt/2000025.txt
# filelineno = 689
# sentno = 1
# text = נם בעת ויכוחים פנימיים בנושאים הקשורים לאופי השטחים הפתוחים והנוי בקיבוץ ניסו חברים לשכנע את הציבור ע״י הבאת דונמאות מן הנעשה בקיבוצים אחרים, למשל במאמר בשם "דברי חברים", שהתפרסם בעלון קיבוץ ינור והיה חלק מדיון ציבורי ארוך בדבר נטיעת עצי פרי בשטחים הפתוחים בקיבוץ, הביא אחד החברים דונמאות בנושא דה מקיבוץ אחר (אורן א., 195B).
