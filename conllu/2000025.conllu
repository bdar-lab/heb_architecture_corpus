# file = txt/2000025.txt
# filelineno = 516
# sentno = 3
# text = קשה ליחס טיפוס זה לתקופה מונדרת בתולדות הקיבוץ משום שבחלק מן התקופה שהתאפיינה בקיבוצים מטיפוס "קהילה", נמצאו לא מעט קיבוצים שהיו, למעשה, מטיפוס של "קהילה פדרטיבית", ובכך היוו תת-קבוצה בתוך הטיפוס הסוציולוני של "קהילה״ (1976 ,C0HEN).
