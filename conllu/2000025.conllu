# sentno = 1
# text = כמצא כי חברים אחדים בעלי יכולת וביטוחים מקצועיים בולטים, שפעלו בתקופות בהן פוטגציאל ההשפעה של היחיד על התפתחות הגוי והנוף היו גבוהים, השפיעו פחות מן המצופה; ולעומתם, חברים אחרים בעלי כישורים מקצועיים פחותים, אבל בעלי אופי ותכונות אישיות שאפשרו לתקשר היטב עם מוסדות הקיבוץ ועם ציבור החברים, הצליחו להשפיע ולקדם את ענף הנוי, ואף לחולל מהפיכות חיוביות בתחום השטחים הפתוחים (עשת, 1389).
