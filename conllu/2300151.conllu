# text = אופי הפעילות שהוזכרה על-ידי התושבים בתשובה לשאלה הפתוחה - "מה את/ה עושה בדרך כלל בשעות הפנאי שלך" ניתן לסיווג לחמש קטגוריות (ראה טבלה 6.3א'): 1) פעילות ביתית - הכוללת קריאה, התבוננות בטלויזיה, עבודות בית וכדי, 2) פעילות חברתית לא פורמלית - עם משפחה, שכנים, חברים.
# raw = {'id': 1, 'text': 'אופי הפעילות שהוזכרה על-ידי התושבים בתשובה לשאלה הפתוחה - "מה את/ה עושה בדרך כלל בשעות הפנאי שלך" ניתן לסיווג לחמש קטגוריות (ראה טבלה 6.3א\'): 1) פעילות ביתית - הכוללת קריאה, התבוננות בטלויזיה, עבודות בית וכדי, 2) פעילות חברתית לא פורמלית - עם משפחה, שכנים, חברים.', 'dspan': (0, 263), 'tokens': [{'id': 1, 'text': 'אופי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 32, 'deprel': 'nsubj:outer', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'אופי'}, {'id': (2, 3), 'text': 'הפעילות', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'פעילות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 1, 'deprel': 'compound', 'lemma': 'פעילות'}], 'span': (5, 12), 'dspan': (5, 12)}, {'id': (4, 5), 'text': 'שהוזכרה', 'expanded': [{'id': 4, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 5, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 5, 'text': 'הוזכרה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=HUFAL|Number=Sing|Person=3|Tense=Past|Voice=Pass', 'head': 3, 'deprel': 'acl:relcl', 'lemma': 'הוזכר'}], 'span': (13, 20), 'dspan': (13, 20)}, {'id': 6, 'text': 'על', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'dspan': (21, 23), 'span': (21, 23), 'lemma': 'על'}, {'id': 7, 'text': '-', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (23, 24), 'span': (23, 24), 'lemma': '-'}, {'id': 8, 'text': 'ידי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 6, 'deprel': 'fixed', 'dspan': (24, 27), 'span': (24, 27), 'lemma': 'יד'}, {'id': (9, 10), 'text': 'התושבים', 'expanded': [{'id': 9, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 10, 'deprel': 'det', 'lemma': 'ה'}, {'id': 10, 'text': 'תושבים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|N