# file = txt/1500179.txt
# filelineno = 57
# sentno = 9
# text = 2009) Fellner, Guth and Maciejovsky) הבוחנים במעבדה את המודל האלטרנטיבי של 1955) Simon) סוברים שפעילות מוכוונת-מטרה הינה אמנם דרך טבעית יותר לקבל החלטות מאשר אופטימיזציה; יחד עם זאת, גם ייחוס רציונליות מוגבלת למקבלי החלטות עשוי להיות מרחיק לכת.
