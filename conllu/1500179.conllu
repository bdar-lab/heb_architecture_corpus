# file = txt/1500179.txt
# filelineno = 27
# sentno = 1
# text = ספרי הלימוד במיקרו־כלכלה (ראו למשל, 1999 ,Boyes and Melvin ; 1990 ,Kreps) מפרטים את התנאים המקובלים כיום הדרושים לקיומה של תחרות משוכללת: המוצר הנסחר בשוק הוא הומוגני; בשוק ישנה כמות גדולה של יצרנים (או סוחרים) ושל צרכנים; לצרכן אין העדפה לגבי זהות היצרן (או הסוחר), באופן דומה היצרן (או הסוחר) אינו מעדיף למכור לצרכן זה או אחר; לצרכן וליצרן מידע מלא על כלל המחירים המוצעים בשוק; היצרן מעוניין למכור במחיר הגבוה ביותר האפשרי, הצרכן, מנגד, לא ירכוש מוצר אלא במחיר הנמוך ביותר המוצע (כלומר, הם רציונלים - ראו על כך בהמשך סקירת הספרות); אין עלויות עסקה, ולבסוף, צרכן יכול להפוך לסוחר ולמכור מוצר שרכש.
