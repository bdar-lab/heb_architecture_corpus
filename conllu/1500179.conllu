# file = txt/1500179.txt
# filelineno = 338
# sentno = 2
# text = המשתנים המסבירים במשוואה (1) כוללים את Treatmentt, המציין תקופות זמן לאחר השיפור ברמת המידע (משתנה דמי השווה ל־1 לאחר אוקטובר 2010 ו-ס לפני אפריל 2010) וסדרה של משתני בקרה ובכללם הערך החזוי של מספר העסקאות בחודש t בעיר Ntc ,c המיוצר במשוואה (3) (ראו פרטים בהמשך), המייצג את רמת המידע שמיוצרת על ידי עומקו של השוק המקומי ;APtc, שיעור השינוי במחירים בששת החודשים שקדמו לתקופה t, כבקרה על הקשר בין גובה המחירים לבין SD_Ptc; SD, סטיית התקן של מחירי הדירות מתואמות האיכות בעיר c בששת החודשים שקדמו לכל תקופה חודשית t, לשם בקרה על שינויי מחירים לאורך זמן בעיר שעשויים לגרום לפיזור מחירים בין עסקאות שונות בזמן נתון (להרחבה על האופן בו חישבנו את APtc-> $D_Ptc ראו נספח א׳);SD_Stockt, סטיית התקן של התשואה היומית של מדד תל אביב 100 בשלושת החודשים שקדמו ל^, אשר מייצגת את מידת אי-הוודאות במשק; SD_Attributestc-'i Avg_Attrib11testc ׳ הינם בהתאמה וקטורים של ממוצעי וסטיות תקן של המאפיינים הפיסיים של נכסים שנמכרו בעיר c בחודש t, לשם בקרה על שינויים בהרכב מאפייני
