# file = txt/1800026.txt
# filelineno = 21
# sentno = 1
# text = בחוק שירות התעסוקה (1959), הנמצא באחריותו של שר העבודה, נקבע כי לגבי עובד או העומד להתקבל כעובד שאינו אזרח ישראלי או תושב ישראל, בענפי העבודה, במקצועות ובעבודות המפורטים בתוספת השניה לחוק לא יקבל אדם עובד, ולא יתחיל אדם לעבוד אצל מעביד, אלא אם העובד נשלח על-ידי לשכת שירות התעסוקה וניתן ממנה על כך אישור בכתב.
