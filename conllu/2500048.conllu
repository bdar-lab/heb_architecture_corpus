# file = txt/2500048.txt
# filelineno = 285
# sentno = 2
# text = רכיבים טרומיים בבנייה הקונבנציונלית להצדיק את עצמו מבחינה כלכלית גם באתרים הקטנים האופייניים למגזר הפרטי, ולהביא לקבלן המשתמש יתרונות בנוחיות תיאום ואירגון, קיצור משך הביצוע, והשגת איכות בנייה גבוהה יותר" אם כי אין הוא מבטיח יתרונות כלכליים בתנאי המשק הנוכחיים יש לשילוב מוגבר של רכיבים טרומיים יתרון בולט במצב של גיאות, כאשר קיים מחסור בבעלי מקצועות קריטיים ושכרם עולה" מעבר לכך יש ליצירת הביקוש לרכיבים טרומיים בבנייה הפרטית תועלת כלכלית כלל מישקית בהיותו תורם לרווחיות הייצור במפעלים טרומיים הנמצאים במצב של תת-תעסוקה" יש להניח שעם הגדלת נפח הייצור ניתן יהיה להקטין את המרכיב של הוצאות עקיפות בייצור הרכיבים המהווה היום תוספת נכבדה לעלות"
