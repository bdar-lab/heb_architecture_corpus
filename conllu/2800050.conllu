# text = באופקים ישנם 19 בחי כנסת רבניים ובית כנסת קראי אחד, בעוד בית כנסת מרכזי נמצא בבנייה, קיימת במקום "חברה קדישא", שהיא אחת הצורות הספציפיות של פעולה וולונטרית של אנשים דתיים, מועצת הפועלים היא בתחום השפעתה העיקרית של מפלגת העבודה; המועצה הדתית - בהשפעת מפד״ל; ואילו במועצה המקומית - מתחרות ומתמודדות שתי המפלגות.
# raw = {'id': 1, 'text': 'באופקים ישנם 19 בחי כנסת רבניים ובית כנסת קראי אחד, בעוד בית כנסת מרכזי נמצא בבנייה, קיימת במקום "חברה קדישא", שהיא אחת הצורות הספציפיות של פעולה וולונטרית של אנשים דתיים, מועצת הפועלים היא בתחום השפעתה העיקרית של מפלגת העבודה; המועצה הדתית - בהשפעת מפד״ל; ואילו במועצה המקומית - מתחרות ומתמודדות שתי המפלגות.', 'dspan': (0, 309), 'tokens': [{'id': (1, 2), 'text': 'באופקים', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'אופקים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 3, 'deprel': 'obl', 'lemma': 'אופק'}], 'span': (0, 7), 'dspan': (0, 7)}, {'id': 3, 'text': 'ישנם', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|Number=Plur|Person=3|Polarity=Pos', 'head': 0, 'deprel': 'root', 'dspan': (8, 12), 'span': (8, 12), 'lemma': 'יש'}, {'id': 4, 'text': '19', 'upos': 'NUM', 'xpos': 'NUM', 'head': 5, 'deprel': 'nummod', 'dspan': (13, 15), 'span': (13, 15), 'lemma': '19'}, {'id': 5, 'text': 'בחי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 3, 'deprel': 'nsubj', 'dspan': (16, 19), 'span': (16, 19), 'lemma': 'בחי'}, {'id': 6, 'text': 'כנסת', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 5, 'deprel': 'compound', 'dspan': (20, 24), 'span': (20, 24), 'lemma': 'כנסת'}, {'id': 7, 'text': 'רבניים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 5, 'deprel': 'amod', 'dspan': (25, 31), 'span': (25, 31), 'lemma': 'רבניים'}, {'id': (8, 9), 'text': 'ובית', 'expanded': [{'id': 8, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 9, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 9, 'text': 'בית', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'conj', 'lemma': 'בית'}], 'span': (32, 36), 'dspan': (32, 36)}, {'id': 10, 'text': 'כנסת', 'upos': 'NOUN', 'xpos': 'NOUN', 'head': 9, 'deprel': 'compound', 'dspan': (37, 41), 'span': (37