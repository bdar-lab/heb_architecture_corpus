# file = txt/2800050.txt
# filelineno = 221
# sentno = 1
# text = בלוח סס' 2.4 ניתנת השוואה בין הרכב האוכלוסייה, מבחינת יבשת המוצא, באופקים, במדינת ישראל (יהודים) וב-21 עיירות פיתוח, על יסוד הסקר "כח אדם בעיירות הפיתוח" משרד העבודה, דצמבר 1964, נתוני "מפקד האוכלוסין והדיור", 1961, ונתוני הלשכה המרכזית לסטטיסטיקה לסוף שנת 1967.
