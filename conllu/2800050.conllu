# text = גרף מס. 1־5 מתאד את תנועת האובלוסיה בכל שגה, לפי המקורות, ואילו -גרף מס. 5.2 מראה את התנועה במספרים קומולטיביים; בגרף מס. 5.1 בולטות השנים 1956/57 ו—19G2/63 של גלי עלייה גדולים, שגת שפל העלייה 1959 ובן השנים 1965 ו-1966, כשמאזן ההגירה שלילי וגידול האוכלוסייה איטי, כולו על חשבון הריבוי הטבעי.
# raw = {'id': 1, 'text': 'גרף מס. 1־5 מתאד את תנועת האובלוסיה בכל שגה, לפי המקורות, ואילו -גרף מס. 5.2 מראה את התנועה במספרים קומולטיביים; בגרף מס. 5.1 בולטות השנים 1956/57 ו—19G2/63 של גלי עלייה גדולים, שגת שפל העלייה 1959 ובן השנים 1965 ו-1966, כשמאזן ההגירה שלילי וגידול האוכלוסייה איטי, כולו על חשבון הריבוי הטבעי.', 'dspan': (0, 292), 'tokens': [{'id': 1, 'text': 'גרף', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'nsubj', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'גרף'}, {'id': 2, 'text': 'מס.', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 1, 'deprel': 'compound', 'dspan': (4, 7), 'span': (4, 7), 'lemma': 'מס.'}, {'id': 3, 'text': '1־5', 'upos': 'NUM', 'xpos': 'NUM', 'head': 2, 'deprel': 'nummod', 'dspan': (8, 11), 'span': (8, 11), 'lemma': '1־5'}, {'id': 4, 'text': 'מתאד', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=HIFIL|Number=Sing|Person=3|Tense=Pres|VerbForm=Part|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (12, 16), 'span': (12, 16), 'lemma': 'מתאד'}, {'id': 5, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'dspan': (17, 19), 'span': (17, 19), 'lemma': 'את'}, {'id': 6, 'text': 'תנועת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'obj', 'dspan': (20, 25), 'span': (20, 25), 'lemma': 'תנועה'}, {'id': (7, 8), 'text': 'האובלוסיה', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'אובלוסיה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'compound', 'lemma': 'אובלוסיה'}], 'span': (26, 35), 'dspan': (26, 35)}, {'id': (9, 10), 'text': 'בכל', 'expanded': [{'id': 9, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 11, 'deprel': 'case', 'lemma': 'ב'}, {'id': 10, 'text': 'כל', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Cons', 'head': 11, 'depre