# file = txt/2500050.txt
# filelineno = 720
# sentno = 1
# text = כל השיטות הלא פעילות משתמשות בגבס כחומר גלם וכפי שתואר מקודם, ישנם קשיים בהשגת חומר זה בארץ, למרות שיש - או לפחות היו - מרבצים גדולים של מחצבים עשירים במספר מקומות בארץ, וכן מפעלים לקלית הגבס, אך מפעלים אלה קיימים כבר שנים רבות ללא חדוש ציודם.
