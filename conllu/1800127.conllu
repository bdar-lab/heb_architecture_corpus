# file = txt/1800127.txt
# filelineno = 9
# sentno = 4
# text = לבסוף, חיזוק או ייצוב זמני של מבנים שספגו נזק ניכר באירוע כמו שריפה, פיצוץ, או רעידת אדמה והחזרתם לתפקוד מוגבל או לשם בטיחות פעולות החילוץ וההצלה, וחיזוק מבנים כחלק מתהליך שימור מבנים ישנים בעלי ערך אמנותי, דתי, לאומי או היסטורי הנם גורמים נוספים אשר מצריכים פעולות חיזוק ושדרוג מבני.
