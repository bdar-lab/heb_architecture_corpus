# file = txt/1500238.txt
# filelineno = 488
# sentno = 1
# text = במסגרת הדיונים בתכניות השונות בשטח אזור התעשייה, הנתונות תחת סמכותן, ניכר כי מעורבותן מתבטאת בפיקוח ובקרה שנועדו להבטיח שמירה על מהלך תכנון תקין51, בדרישות להוספת מגבלות, תנאים ודרישות שונות לתכנית הנתפסות כהכרחיות לשמירה על האינטרס הציבורי, בבחינת מידת ההלימה בין התכניות המוצעות לבין תכניות בהיררכיה גבוהה יותר כמו גם מסמכי מדיניות המייצגים יעדים תכנוניים שנקבעו ברמה העירונית, המחוזית והארצית.
