# file = txt/1500238.txt
# filelineno = 488
# sentno = 2
# text = בקרית ביאליק ובבת ים מעורבותה של הועדה המחוזית אף מתבטאת בנקיטת צעדים שנועדו לזרז את תהליך פיתוח המתחם, מתוך ההכרה בחשיבותם על מנת לאפשר מימוש מהיר של הפרויקט: בקרית ביאליק, אישרה הועדה המחוזית היתר לשימוש חורג במפעל אתא הקיים, אשר אפשר ליזם להתחיל בבניית הקניון, טרם הגשת התכנית המסדירה את שינוי הייעוד בקרקע.
