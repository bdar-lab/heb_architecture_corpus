# file = txt/1500238.txt
# filelineno = 193
# sentno = 1
# text = ההתמקדות המוגברת בסוגיות סביבתיות וכלכליות (דוגמת שיקום הקרקע ומימון) בשיח העוסק ב״בראוניפלדס", מובילה לעתים להתייחסות אל מרחבים אלו כאל "טאבולה ראסה" ולפיתוח מחודש שלהם כמרחבים הנתפסים כמנותקים מבחינה כלכלית, תרבותית ופיזית מהשכונות הגובלות בהם.
