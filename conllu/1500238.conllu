# file = txt/1500238.txt
# filelineno = 385
# sentno = 4
# text = בפועל, מלבד בניין משרדים אחד שהוקם, שהוסב בהמשך למגורים, התוכנית נותרה "על הנייר" ובשטח נותר מרחב עירוני הכולל מבני תעשייה שנבנו מתוקף תכניות ישנות יותר ומאופיין בניצולת קרקע נמוכה, זכויות בניה שאינן ממומשות במלואן, בינוי ותשתיות באיכות ירודה, חיבור לוקה בחסר למרקם העירוני ולים ותדמית שלילית (אליקים אדריכלים, 2010 ; בכיר בעיריית בת ים, ראיון, ספטמבר 2016).
