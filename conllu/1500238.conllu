# file = txt/1500238.txt
# filelineno = 254
# sentno = 2
# text = המניעים מאחורי רצון זו מגוונים ונובעים הן מהשאיפה לפתח מרחב עירוני קומפקטי ובר קיימא, המצמצם שימוש במשאבים ועומס סביבתי (2015 ,Unsworth), הן מהרצון לספק מענה לצרכי דיור והן במטרה לייצר רקמה עירונית חיה שתמשוך אוכלוסייה "רצויה", אשר תגרור אחריה השפעות חיוביות כולל הבאת עסקים, חברות ותעשיות מתקדמות אל אזור התעשייה והעיר (2008 ,Korthals Aites & Tambach).
