# file = txt/1500238.txt
# filelineno = 298
# sentno = 1
# text = במטרה לשפוך אור על מקרי הבוחן הנבחרים ולהעמיק את הבנתם, הוצלבו נתונים שנאספו במספר כלים איכותניים: ראיונות מובנים למחצה עם גורמים בעלי מעורבות ישירה בתהליך חידוש אזור התעשייה בכל מקרה בוחן, ניתוח פרוטוקולים של ישיבות ועדות תכנון ברמה המקומית, המחוזית והארצית, שעסקו במקרי הבוחן הנבחנים במסגרת המחקר, וניתוח תכניות ומסמכי מדיניות.
