# file = txt/1500238.txt
# filelineno = 194
# sentno = 3
# text = במישור הכלכלי, חידושם של אזורים אלו נתפס כאמצעי להעצמת פיתוח ותעסוקה באזורים מקופחים, במישור הסביבתי - כאמצעי לצמצום זחילה עירונית ולשיקום קרקעות מזוהמות; ובמישור החברתי - ככלי להחייאה מחדש של אזורים עירוניים וכאמצעי להעצמת הקהילה המקומית (2004 ,Pahlen & Glockner).
