# file = txt/1500238.txt
# filelineno = 540
# sentno = 1
# text = כדי שזה יקרה בדרך יותר מהירה ,כי יש מלא תכניות שקובעים בהן אחוזי בנייה ולא קורה בהן שום דבר,קכענו כמסגרת התכנית מנגנון שקראנו לו ״כל הקודם זוכה״ -זאת אומרת כמה שאתה בא יותר מוקדם, אתה מקבל יותר זכויות ... אם תבוא ראשון לחבילה הזאת תוכל לקחת x מטרים, אם תבוא שני תוכל לקחת Y מטרים, אם אתה בא מאזור שהוא מוטה מגורים - אתה יכול לקחת את זה [הכוונה ל-ע מטרים - ל.מ], ואם אתה בא מאזור מוטה תעסוקה - אתה יכול לקחת את זה [הכוונה ל-ע מטרים - ל.מך וככה יצרנו מין מערכת שהולכת ונעלמת, כי הראשון שבא יכול היה למשל לקחת 50% מהזכויות, השני רק 50% ממה שנשאר אז וכך הלאה.
