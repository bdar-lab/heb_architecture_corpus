# file = txt/1500238.txt
# filelineno = 665
# sentno = 1
# text = על אף ששלושת מקרי הבוחן נבדלים ביניהם בחזון התפקודי והמרחבי למתחם המחודש (להרחבה ראה סעיף 2.5), תמה משותפת לשלושתם היא הרצון להפוך אותו מאזור המיועד לשימוש אחד -תעשייה - שברובה כבר אינה מתקיימת באזור, אשר פעיל במהלך שעות היום בלבד ונחווה כמנותק מיתר העיר על אף סמיכותו הגבוהה אליה, למוקד משיכה בין־עירוני, הכולל מגוון שימושים ומהווה חלק בלתי נפרד מהפעילות העירונית בכל שעות היממה62 (להרחבה ראה סעיפים 3.1.1.2 ו- 3.1.1.3).
