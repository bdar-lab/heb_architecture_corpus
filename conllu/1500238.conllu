# file = txt/1500238.txt
# filelineno = 396
# sentno = 5
# text = החל משנת 1997, בה אושרה כאמור תכנית בי/400 אשר היוותה את הניסיון הראשון לחידוש המתחם, אושרו בשטח הנבחן 36 תכניות (הנתונים נכונים למאי 2017) : שלוש תכניות שמהותן התוויה ושינוי דרכים וצירי תחבורה העוברים בין היתר בשטח הנבחן, 10 תכניות העוסקות בתיקונים/ שינויים נקודתיים כגון שינוי קווי בניין, איחוד וחלוקה ושינוי חלוקה למגרשים ללא תוספת זכויות בנייה או שינויי יעודים מותרים, 21 תכניות הנוגעות לתוספת זכויות בנייה ו/או שינוי ייעודי קרקע מותרים, ו-2 תכניות שמהותן הארכת תוקפם של תמריצים שניתנו בתכניות מוקדמות יותר (למספר תכניות מאושרות משנת 1997 ואילך, ע״פ גודל השטח אליו מתייחסת התכנית והשינוי אותו היא מציעה ראה איור 17).
