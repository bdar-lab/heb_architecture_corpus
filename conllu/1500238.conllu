# file = txt/1500238.txt
# filelineno = 668
# sentno = 4
# text = הפער שנפער לאורך השנים בין המדיניות התכנונית הקשיחה שאפיינה את הגדרת ייעודי הקרקע המותרים באזור התעשייה לבין הצורך והרצון לשלב בו שימושים אחרים (להרחבה ראה סעיף 3.1.1.2 וסעיף 3.3.1), כמו גם ניסיונות כושלים לייצר שינוי בשטח באמצעים סטטוטוריים בלבד63 הובילו לאימוץ אסטרטגיות וכלים נוספים בכדי להבטיח את מימוש פרויקט ההתחדשות, ועד כמה שניתן את הצלחתו הכלכלית לאורך זמן אל מול תנודות שוק עתידיות (לפירוט על כלים אלו, ראה סעיף 3.2.2).
