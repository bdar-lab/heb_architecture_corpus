# file = txt/1500238.txt
# filelineno = 636
# sentno = 2
# text = בדיון שעסק בתכנית בי/528, למשל, חלק משמעותי מהדיון עסק באופי המסחר שהיזם מבקש לפתח ובהשלכות של פיתוח מסחר מסוג זה על המרחב הציבורי ואופיו של הרובע כולו: "פה יש חילוקי דעות מהותיים כאשר אנחנו ב-בי/600 מדברים בעקרון על חזיתות מסחריות,על פיזור של מסחר לאורך הרחובות בכל התכנית והתכנית הזאת{הכוונה לתכנית בי/528]זה סגר גדול של מסחר של קניון...אז זה מאוד מאוד בעייתי, יהיה עוד קניון בת ים ובאמת לא באופי שמדובר עליו ב-בי/600 אז אנחנו ,יש פה נושא שבהחלט הוא ראוי לדיון..." (אדר׳ נעמי אנג׳ל, מתכננת המחוז, תמליל ישיבה מספר 828 של הועדה המחוזית לתכנון ולבנייה מחוז תל אביב, 19.10.15, עמוד 245).
