# file = txt/1500238.txt
# filelineno = 158
# sentno = 4
# text = יכולת זו מתבטאת לטענתו ב:(1) יכולת לקבוע חזון ומטרות ברורים עבור המתחם המתוכנן, (2) יכולת להתבונן ולקדם את המתחם לטווח הארוך ו-(3) יכולת לחבר בין החזון והמטרות של בעלי העניין השונים לכדי תכנית מגובשת אחת, בהירה וברת יישום.
