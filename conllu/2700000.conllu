# file = txt/2700000.txt
# filelineno = 518
# sentno = 5
# text = 8’ יתרונות גישה־ זו על פני הפיתוח הזוחל הם: ראשית, הפיתוח מתבצע בצפיפויות גבוהות יותר מהצפיפות המאפיינת פיתוח פרברי זוחל; שנית, נשמרים רצפים פתוחים גדולים יותר מאלה המתקבלים בפיתוח הפרברי הזוחל; שלישית, הבינוי המתקבל הוא רצוף ואינטנסיבי ומאפשר את קיומם של ספי כניסה גבוהים לשירותים, לתשתיות ולתחבורה ציבורית.
