# file = txt/1500055.txt
# filelineno = 136
# sentno = 2
# text = עתה לצד התפתחות תאוריות שימור במהלך המאה ה-20, כדוגמת 'תאורית הערכים' שפיתח אלויס ריגל ( Alois Riegl [1858-1905]) בראשית המאה ו"התאוריה של השיחזור" של צ'זרה ברנדי (-1906] Cesare Brandi [1988) שפורסמה בשנת 1963, החלו להכתב מסמכי מדיניות שימור והתפתחו מתודות ופרקטיקות מקצועיות של שימור.
