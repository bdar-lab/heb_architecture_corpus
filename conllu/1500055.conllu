# file = txt/1500055.txt
# filelineno = 521
# sentno = 2
# text = בעוד המקום הקטן והיומיומי – הנוף הבנוי של הארץ – היה ברובו בניה ערבית מסורתית ובמקצתו בניה מנדטורית בערים ובישובים יהודיים, המקום הגדול – הנוף המיתי הקדום, התנ"כי – נמצא בשכבות קרקע שעל פי רוב אינן נראות.
