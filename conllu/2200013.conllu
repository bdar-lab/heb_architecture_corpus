# file = txt/2200013.txt
# filelineno = 100
# sentno = 2
# text = היא מופיעה גם במדגמים שעברו אשפרה במים$/ ההתייבשות העצמית משמעותית יותר בבטונים המכילים מיקרוסיליקה בשל שטח הפנים הספציפי הגדול של חלקיקי חמיקרוסיליקה^20/ ההצטמקות העצמית בבטונים החזקים במדגמים אטומים (ז.א. שאינם מפסידים מים באיוד) היא יותר מחצי ההצטמקות הכוללת של מדגמים זהים החשופים לתנאי יובש חיצוניים^26/ התכווצות מסוג זה, בתנאי ריסון, היא גורם אפשרי להופעת סדקים.
