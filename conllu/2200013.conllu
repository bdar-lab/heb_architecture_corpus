# file = txt/2200013.txt
# filelineno = 333
# sentno = 2
# text = מאמצי הריסון הפנימיים של תערובת 1 (מנת-מים 0.33 ,T=20°c) ו־11 (מנת-מיס 0.5 ,T=30°c) היו נמוכים ועם ערכים די דומים; מאמצי הריסון הפנימיים של תערובת 10 (מנת-מים 0.33 ,T=30°C) גבוהים יותר משל תערובת 1, זאת למרות שההצטמקות החופשית של תערובת 1 היתה גדולה יותר; כנראה ששינויי הנפח לא לוו בהתפתחות מאמצים משום שמועד תום ההתקשרות חל בשלב מאוחר יותר (בהשפעת הטמפרטורה).
