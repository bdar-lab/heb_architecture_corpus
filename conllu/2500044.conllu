# file = txt/2500044.txt
# filelineno = 144
# sentno = 1
# text = גדלים אינדיקטיביים אחרים הם: (א) עומס ההטייה (tipping load), שהוא המשקל הגבולי המורם בכף הגורם להינתקות הגלגלים האחוריים של המעמיס מהקרקע; (ב) עומס תפעולי (operating load), הנמדד עם כף במצב של טווח הגעה קדמי מכסימלי וכאשר מונעים אפשרות להינתקות הגלגלים האחוריים.
