# file = txt/2500044.txt
# filelineno = 196
# sentno = 1
# text = השוואה בין טבלאות 1.6 ו-1.9 מלמדת על השוני בתחום הגדלים של הכלים: הוא רחב בהרבה במעמיס האופני מאשר בזחלי, כאשר המעמיסים הזחליים מיוצרים רק במקביל לתחום המעמיסים האופניים הבינוניים, ולא מיוצרים מעמיסים זחליים בעלי מידות, כוח ותכונות אחרות של מעמיסים אופניים הן כבדים וכבדים ביותר, והן קטנים ביותר.
