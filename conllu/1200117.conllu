# file = txt/1200117.txt
# filelineno = 125
# sentno = 1
# text = •	בין הכלים הטכנולוגיים התומכים ב- LC ניתן למצוא תכנות מחשב לתמיכה בשיטת המתזמן האחרון, כדוגמת תכנת vPlanner המטפלת בחיבור בין תכנון העבודה ברמת אבני הדרך לבין תכניות העבודה האופרטיביות השבועיות, ובנוסף, מגבירה את הניהול הויזואלי ואת שיתוף הפעולה בבניית לוחות הזמנים ותכניות העבודה של הפרויקט כמוצג באיור 12.
