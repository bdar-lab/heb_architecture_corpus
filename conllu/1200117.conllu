# file = txt/1200117.txt
# filelineno = 133
# sentno = 3
# text = שיטות התקשרות המבוססות על חוזים יחסיים בענף הבניה מציגים גישה שונה לניהול הפרויקט, וחותרות ליצור אינטרס משותף בין היזם, הקבלן הראשי והמתכננים הראשיים, על מנת להגביר את הערך המיוצר בפרויקט תוך התמודדות משותפת עם אי הוודאות והסיכונים (2014 Boukendour and Hughes).
