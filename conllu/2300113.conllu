# file = txt/2300113.txt
# filelineno = 581
# sentno = 1
# text = המכשולים בפני מדידה תקפה ומהימנה של השפעת שימושי הקרקע על איכות מי התהום חמורים עוד יותר: מיון וקיטלוג שימושי הקרקע הוא בעייתי, וטעות בהליך זה עשוייה לפגוע במהימנות התוצאות; גודל אזור ההשפעה הנבחר סביב באר הדגימה משפיע על תוצאות הבדיקה; וחשוב מכל: מורכבות תהליך הזיהום גורמת לעיכוב p שנים רבות בהגעת המזהמים למי התהום, ומשום כך קשה עד בלתי אפשרי להוכיח יחס סיבתי בין שימושי הקרקע מעל פניה לבין איכות מי התהום שמתחתיה בזמן נתון (ר׳ 2.2.2 לעיל).
