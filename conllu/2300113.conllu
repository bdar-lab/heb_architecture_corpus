# file = txt/2300113.txt
# filelineno = 367
# sentno = 1
# text = הדבר העיקרי שאינו ידוע ביחס לתרומתם של השטחים הפתוחים למי התהום הוא: מהו הדגם הרצוי לפרישת השטחים הפתוחים, למען הגברת ההעשרה הטבעית ומניעת הפסדים למי התהום; אם נניח ש-50% מן השטח נשאר פתוח, האם חשוב שיהיו מחולקים בין הבניינים, או שהשפעתם על חדירת מים לקרקע תהא דומה גם אם ירוכזו בגוש אחדי
