# file = txt/2300004.txt
# filelineno = 217
# sentno = 6
# text = סביר כי מצב משפטי זה, אם יובן לאשורו, ישמש תמריץ למתכננים להפקיע את השיעור המירבי כבר בהפקעה הראשונה, בין אם השטח הגדול יותר נחוץ ובין אם לאו, לדעת המחברת מן הראוי לשנות את החוק לתיקון דיני הרכישה ולבסס אותו על יחידת המגרש.
