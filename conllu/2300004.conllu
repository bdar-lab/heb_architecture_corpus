# file = txt/2300004.txt
# filelineno = 230
# sentno = 2
# text = המצב הנוכחי משתקף בהעדר מודעות בקרב הרשויות המקומיות לצורך לפתח מדיניות קרקעית משלהן - הכוללת אמצעים כגון מדיניות רכישת קרקעות שטרם יועדו לפיתוח, כפי שנהוג בארצות מערביות רבות; ייעוד תקציבים והכנסות מסויימות להפקעה בתמורה, כגון כספי היטל ההשבחה; השגת קרקעות במסגרת הסכמים; ושימוש בכלים חליפיים בהקף מורחב, כאשר מתאים הדבר , כגון בחלוקה חדשה (רפרצלציה).
