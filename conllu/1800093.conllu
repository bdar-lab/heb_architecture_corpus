# file = txt/1800093.txt
# filelineno = 9
# sentno = 2
# text = ייצוג זה מקטין את הסיכון כתלות ישרה בקרבה להעתקים הגדולים; השימוש במקורות פוליגונליים בלבד יוצר הערכת חסר של הסיכון בקרבת ההעתקים הראשיים, במיוחד כאשר האתר ממוקם בתוך פוליגון של אזור סיסמוגני; באזורים תוך לוחיים התרומה היחסית של ההעתקים הראשיים (על ידי דיסאגרגציה של המקורות) קטנה באופן שאינו ריאלי.
