# sentno = 6
# text = 16 אחד השיקולים המרכזיים בבחירת השטחים לפיתוח היה היותם מספיק רחוקים מן הירקון, כדי שלא יהיו נתונים להצפות עד להסדרת אפיק הירקון בחלקיו השונים היות והתכנית למתקני מים בפארק נתנה מענה לנושא ההצפות רק בשטחים במרכז הפארק (אעת״י, 25.12.1967).
