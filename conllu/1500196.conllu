# file = txt/1500196.txt
# filelineno = 677
# sentno = 1
# text = עד חודש פברואר 1970 הושלמו חפירת האגם, קידוח הבאר ששימשה להזרמת מים לאגם, חפירת התעלה המחברת בין האגם לאפיק הירקון, שיקום המפל בשבע טחנות, הקמת הסכר להפרדה בין המים המתוקים של הנחל למי הים המלוחים (שיצר גם אגם קטן סגור להשטת סירות) והקמת שני גשרים למעבר מעל הירקון (אעת״י, 16.2.1970).
