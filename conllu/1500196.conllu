# file = txt/1500196.txt
# filelineno = 717
# sentno = 3
# text = עם התפתחות השיח הסביבתי בארץ בשנות התשעים, כתוצאה מתהליכי העיור המואצים, גם חשיבותם של השטחים הפתוחים העירוניים עלתה ובשנים אלו ועד היום ניתן לזהות מספר מגמות עיקריות: תכנון פארקים מטרופוליניים בשטחי תווך בין מרכזים עירוניים, הטמעת תפיסות סביבתיות בתכנון פארקים עירוניים, הפיכת שטחי שוליים לפארקים ואימוץ מודלים חדשים לטיפול בשטחים פתוחים עירוניים דוגמת שטחי טבע עירוני וגינות קהילתיות (שם).
