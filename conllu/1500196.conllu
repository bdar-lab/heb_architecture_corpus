# sentno = 1
# text = במאה ה-19, עם התעצמות תהליכי העיור בעקבות המהפכה התעשייתית ובהשפעת רעיונות של המהפכה המדעית, העיר המודרנית נתפסה בתווך שבין שתי דיכוטומיות מרכזיות, אשר כללו גם מימד מוסרי: הראשונה ראתה בעיר מקום טכנולוגי, יציר האדם, מקום הרווי במפגעים, זיהום ומתחים חברתיים, מנוגד לטבע הטהור והמוסרי, ואילו השנייה ראתה את העיר כסמל לפסגת התרבות האנושית (כחלק מפרויקט המודרנה), בניגוד לטבע הפראי והמאיים שהפך מושא לאילוף
