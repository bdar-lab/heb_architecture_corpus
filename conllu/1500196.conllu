# file = txt/1500196.txt
# filelineno = 428
# sentno = 1
# text = מאמצע שנות העשרים, בעקבות סלילת הכביש להרצליה בשנת 1925 שחצה את הירקון בגשר הבטון הראשון מעל הנחל ושהגביר את התנועה באזור, החל הירקון להיחשב כחלק מן התחום העירוני ו״לא נראה כבר מעבר ל׳הררי החושך״ (אביצור 1980:193).
