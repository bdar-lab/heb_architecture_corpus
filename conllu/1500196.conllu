# file = txt/1500196.txt
# filelineno = 509
# sentno = 1
# text = באופן כללי תוכנית מזור כללה שלושה יעדים תכנוניים לעיר: (1) פיתוח העיר כעיר מגורים הטרוגנית והתאמת הפיתוח לשימור ערכי נוף ועיצוב עירוני (דגש על שימור מבנים, אתרים ונקודות ציון אחרות במרחב העירוני) (2) הקטנת הפער בין צפון לדרום על ידי הקצאה שיוויונית יותר של שטחים ומשאבים לפיתוח (3) שמירה על מרכזיותה של העיר מבחינת מגוון ההיצע של פעילויות תרבות, בידור, ספורט ונופש, תןך הפרדה סביבתית מתאימה בין הפעילויות והסדר בעיות תנועה (עיריית תל אביב יפו, 1985).
