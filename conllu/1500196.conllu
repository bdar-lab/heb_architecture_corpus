# sentno = 3
# text = 13 הנחת המוצא של התכנית הייתה כי "אפיק הירקון על פיתוליו הם נבטי טבע העשויים להוות תרומה חשובה לפארק אם יישמרו ויפותחו לשם כך, אך יכולים ליהפך למטרדים ולגורמים המפחיתים מערכו של הפארק אם יוזנחו או אם לא יתואם פיתוחם לצרכיו״ (אעת״י, אוקטובר 1:1967).
