# file = txt/1500196.txt
# filelineno = 780
# sentno = 5
# text = במסמך מסכם של כלל ההתנגדויות לתכנית קבעה הוועדה המחוזית של מחוז מרכז עקרונות תכנון חדשים לתכנון הנחל, ביניהם שמירה מרבית על אופיו של הנחל מבחינת צורת האפיק והגדות באמצעות תכנון משולב של ניקוז נוף ואקולוגיה, הגדלת מרחב התכנון לכלל אגן ההיקוות של הנחל ומציאת פתרונות להקטנת הספיקות במורד הנחל על ידי השהיית המים במעלה (בתחומי מרחב התכנון של ועדה מחוזית מרכז), שילוב תכנית הניקוז בתכנית הפיתוח של פארק הירקון תוך מתן עדיפות לשימור הנחל כעמוד השדרה המרכזי של הפארק וצורכי הפארק ככלל (אמג״ש, 25.1.2005).
# raw = {'id': 5, 'text': 'במסמך מסכם של כלל ההתנגדויות לתכנית קבעה הוועדה המחוזית של מחוז מרכז עקרונות תכנון חדשים לתכנון הנחל, ביניהם שמירה מרבית על אופיו של הנחל מבחינת צורת האפיק והגדות באמצעות תכנון משולב של ניקוז נוף ואקולוגיה, הגדלת מרחב התכנון לכלל אגן ההיקוות של הנחל ומציאת פתרונות להקטנת הספיקות במורד הנחל על ידי השהיית המים במעלה (בתחומי מרחב התכנון של ועדה מחוזית מרכז), שילוב תכנית הניקוז בתכנית הפיתוח של פארק הירקון תוך מתן עדיפות לשימור הנחל כעמוד השדרה המרכזי של הפארק וצורכי הפארק ככלל (אמג״ש, 25.1.2005).', 'dspan': (699, 1197), 'tokens': [{'id': (1, 3), 'text': 'במסמך', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 3, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'ה_', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'מסמך', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 11, 'deprel': 'obl', 'lemma': 'מסמך'}], 'span': (0, 5), 'dspan': (699, 704)}, {'id': 4, 'text': 'מסכם', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'amod', 'dspan': (705, 709), 'span': (6, 10), 'lemma': 'מסכם'}, {'id': 5, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 6, 'deprel': 'case:gen', 'dspan': (710, 712), 'span': (11, 13), 'lemma': 'של'}, {'id': 6, 'text': 'כלל', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'det', 'dspan': (713, 716), 'span': (14, 17), 'lemma': 'כלל'}, {'id': (7, 8), 'text': 'ההתנגדויות', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'התנגדויות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 6, 'deprel': 'compound:smixut', 'lemma': 'התנגדויות'}], 'span': (18, 28), 'dspan': (717, 727)}, {'id': (9, 10), 'text': 'לתכנית', 'expanded': [{'id': 9, 'text': 'ל', 'upos': 'ADP', 'xpos'