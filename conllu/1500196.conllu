# file = txt/1500196.txt
# filelineno = 779
# sentno = 2
# text = 13 לאחר השיטפונות של חורף 1992-1991 שגרמו לנזקים כבדים באזור רמת גן, בני ברק והרחובות הסמוכים לנחל הירקון, החל שריג לשלב בתכנון הפארק סוללות עפר שמטרתן הגנה על הבתים הסמוכים בזמן שיטפון, זאת כדי לשמור על חתך ותוואי הנחל המקורי ועל צמחיית הגדות.
