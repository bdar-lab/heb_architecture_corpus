# file = txt/1500196.txt
# filelineno = 735
# sentno = 3
# text = בהתאם לתכנית האב הוגדרו נקודות החיבור הרצויות לצירי תנועה עירוניים ולצירי יוממות במגוון אמצעי תנועה - רכבים, הולכי רגל ורוכבי אופניים: "תכנון הפארק חייב לשרת את הקשרים בצירים השונים על ידי התייחסות תכנונית ונופית למערכות הכבישים בצירים השונים ופיתוח מערכות של גשרים וצירים להולכי רגל ורוכבי אופניים " (שם).
