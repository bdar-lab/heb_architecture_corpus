# file = txt/2300005.txt
# filelineno = 261
# sentno = 1
# text = (6)	פגיעה בחטיבת נוף־ מבחינת ערכה לסיורים לימודיים ולטיולים של אזרחי הארץ ותיירים, יש ערך רב לחטיבת החוף שבין אתר העתיקות בקיסריה לבין עתלית־ חלקה הדרומי של חטיבה זו מתקשר באופן טבעי ע"י נחל התנינים והאקוודוקט הרומי למצוקי הכרמל ולפארק רמת הנדיב אשר אושר ע"י חוק כנסת מיוחד להנצחת זכרו של הברון אדמונד דה רוטשילד־ הקמת התחנה מכניסה תריז במרכז איזור זה, קוטעת את חלקו הדרומי מההר ומחוף הכרמל ובכך פוגעת בערכו של כל האיזור למטרה לה הוא מתאים באופן טבעי־ מצב זה יכול לשמש דוגמא כיצד תפישת שטח קטן יחסית מפחיתה מערכו של שטח נרחב סביבו־ המתקנים הנלוים לתחנה — כגון עמודי מתח גבוה, תחנת מיתוג, שובר גלים להגנה על מתקני השאיבה - יגבירו את הפגיעה.
