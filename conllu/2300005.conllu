# file = txt/2300005.txt
# filelineno = 767
# sentno = 1
# text = הועלו טענות שבאזור חפצי בה (גוש 10005) יהיה קשה לאתר חלק ניכר מבעלי הקרקעות באזור, אולם העובדה שהכתובות בספרי מם רכוש וקרן פצויים אינן מעודכנות או שאין כתובת בכלל, אינה בהכרח מקשה על הליכי ההפקעה, שהרי ניתן לשער שאם אמנם נבצר לאתר בעלים רבים (כפי שהושמעו טענות), אזי יש להניח שבעלים אלה מפגרים בתשלומי המיסים.
