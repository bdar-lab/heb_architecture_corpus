# file = txt/2300005.txt
# filelineno = 260
# sentno = 3
# text = כבר היום כתוצאה מקרבת המשק של מעגן מיכאל מצפון לשמורה יש התדלדלות במספר המינים הדוגרים בשמורה־ הקמת מרכז בניה נוסף בדרום השטח עלולה להקטין את מספר המינים הדוגרים, (ע"י חומרי זיהום, ע"י פלישת חיות המלוות את האדם וכו') עד למרחק של 2 ק״מ צפונה לתחנה־ השפעת חמרי הזיהום הנפלטים לים וממנו ליבשה כגון שמנים מינרליים עלולה להגיע למרחק רב יותר־ לכלוך הצפרים בשמנים מינרליים הנפלטים לחוף גורם למותן ע״י כך שהוא פוגע בכסות הנוצות והופך אותה לכסות אשר אינה מגינה מקור.
