# file = txt/1800197.txt
# filelineno = 21
# sentno = 2
# text = קבלת המלצה זו תתרום להשגתן של שלוש מטרות עיקריות: תוספת משמעותית למשאבי המים של ישראל, כתוצאה מהחדרה של נגר עירוני באיכות טובה למי התהום, משימוש ישיר במי גשם ובנגר עירוני ומחיסכון במים; תרומה לאיכות החיים בערים, באמצעות שיקום נחלים, מקווי מים וערוצי מים (כולל צומח וחי), העשרת הצומח העירוני לשיפור איכות האוויר ולנוי, ושילוב מים גלויים בנוף העירוני; הקטנת השכיחות, העוצמה והנזקים של הצפות בעיר, באמצעות ניהול חדשני של נגר עירוני.
