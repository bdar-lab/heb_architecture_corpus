# raw = {'id': 7, 'text': 'במילים אחרות, ניכרת כאן הזדמנות, כי מדובר במשקי בית שקנו דירות בירוחם, אבל כדי לוודא שיגורו בהן עכשיו ולא ישכירו אותן, וכדי שלא יעזבו את הדירות האלה בעוד שנים אחדות, כשיותר להם למכור אותן, יש לדאוג כעת, בחלון הזמן שנוצר, למענה ראוי לצורכיהם.', 'dspan': (893, 1134), 'tokens': [{'id': (1, 2), 'text': 'במילים', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'מילים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 5, 'deprel': 'obl', 'lemma': 'מילה'}], 'span': (0, 6), 'dspan': (893, 899)}, {'id': 3, 'text': 'אחרות', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Plur', 'head': 2, 'deprel': 'amod', 'dspan': (900, 905), 'span': (7, 12), 'lemma': 'אחר'}, {'id': 4, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (905, 906), 'span': (12, 13), 'lemma': ','}, {'id': 5, 'text': 'ניכרת', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=NIFAL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (907, 912), 'span': (14, 19), 'lemma': 'ניכר'}, {'id': 6, 'text': 'כאן', 'upos': 'ADV', 'xpos': 'ADV', 'head': 5, 'deprel': 'advmod', 'dspan': (913, 916), 'span': (20, 23), 'lemma': 'כאן'}, {'id': 7, 'text': 'הזדמנות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 5, 'deprel': 'nsubj', 'dspan': (917, 924), 'span': (24, 31), 'lemma': 'הזדמנות'}, {'id': 8, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 5, 'deprel': 'punct', 'dspan': (924, 925), 'span': (31, 32), 'lemma': ','}, {'id': 9, 'text': 'כי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 10, 'deprel': 'mark', 'dspan': (926, 928), 'span': (33, 35), 'lemma': 'כי'}, {'id': 10, 'text': 'מדובר', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=PUAL|Number=Sing|Person=1,2,3|VerbForm=Part|Voice=Pass', 'head': 5, 'deprel': 'advcl', 'dspan': (929, 934), 'span': (36,