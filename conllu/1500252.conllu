# sentno = 2
# text = ביקורת נוספת נשמעה בקרב ארגונים ירוקים, אשר טענו כי "משמעות הליך זה היא שכל הכוח ירוכז בידיו של שר האוצר או ראש מנהל התכנון, והם אלו שיורידו את המשימות ׳מלמעלה׳, משמעות הדבר - דיקטטורה, מפני שמערכת התכנון, אשר הייתה עד כה היררכית ושיקפה קולות שונים במרחב הציבורי - ממשלה, שלטון מקומי, ארגונים ציבוריים וכד׳ - עומדת לשנות פניה לחלוטין ולמעשה לאבד לגמרי מכוחה ומיכולת השיפוט העצמאי והמושכל שהיום בידיה״ (אתר מגמה ירוקה, 2015).
