# file = txt/2500105.txt
# filelineno = 114
# sentno = 3
# text = אם מוכנים להסתפק בקריטריונים של העלאת טמפרטורת המשטחים בשעות הבוקר והערב בלבד, ולהתיר טמפרטורת מינימום נמוכה יחסית בלילה, אזי דפוס החימום היעיל ביותר, עבור מבנה עם קירות מבודדים היטב, הוא הדפוס המפוצל הכולל כ-7 שעות בערב (מ-16.00 עד 23.00), ותוספת של 3, 4 שעות בבוקר (מ-04.00, 05.00 עד 08.00), ועבור מבנה פחות מבודד, דפוס מפוצל הכולל כ-5, 6 שעות בערב (מ-17.00, 18.00 עד 23.00) בתוספת אותן 3, 4 השעות בבוקר.
