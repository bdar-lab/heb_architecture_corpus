# file = txt/2500105.txt
# filelineno = 37
# sentno = 1
# text = מן הציור 2.1 רואים כי טמפרטורת המשטחים הפנימיים של המחיצות וקירות החוץ גדלה אומנם עם הפעלת החימום, אך העלייה מתונה הרבה יותר מזו של טמפרטורת האוויר, וגורמת לגידול של 3°C לכל היותר בסוף תקופת החימום, בעוד שטמפרטורת אוויר הפנים גדלה מייד בשעה הראשונה בשיעור של כ-4°0 - 17.3-8.3) 5°C).
