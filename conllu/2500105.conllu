# file = txt/2500105.txt
# filelineno = 98
# sentno = 5
# text = להפעלת החימום במשך 16 עד 17 שעות מ-06.00 בבוקר עד 23.00 בערב, או מ-16.00 אחה"צ עד 08.00 בבוקר למחרת השפעה דומה על ההסטה הכללית כלפי מעלה, אך כשהחימום הוא בשעות היום בלבד הטמפרטורה מחצות עד צהרי היום קטנה יותר (בכ-0.5°0 לכל היותר) ומהצהריים עד חצות גדולה יותר (בכ-0.2°0 לכל היותר), כלומר, דפוס החימום הכולל את שעות הלילה יעיל יותר מבחינת הפחתת הניודים של טמפרטורת קירות החוץ והעלאת הטמפרטורה המינימלית בשעות הבוקר, בעוד שדפוס החימום הכולל את כל שעות היום יעיל יותר מבחינת העלאת טמפרטורת קירות החוץ בשעות הערב.
