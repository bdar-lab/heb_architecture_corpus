# file = txt/2500105.txt
# filelineno = 101
# sentno = 9
# text = ולכן, אף על פי שהפעילות מוסיפה הלחות שישנה בשעות אלה היא הקטנה ביותר, ונובעת אך ורק מנוכחות של בני אדם ישנים (המוסיפים פחות מ-50 גרם אדי מים לשעה לאדם), אזי קיים סיכון מסויים כי דווקא הן תהיינה הקריטיות מבחינת בעיית העיבוי.
