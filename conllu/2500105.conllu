# file = txt/2500105.txt
# filelineno = 68
# sentno = 1
# text = ההשוואות של התוצאות המדודות עם ערכים מחושבי□ לפי המצב היציב ובאמצעות התוכנית הדינמית TARP מראות כי, לגבי הערכת הסיכון לעיבוי והבידוד התרמי המינימלי במעטפת, בדירות עם חימום רצוף אפשר להסתמך, לצורך הפשטות על חישובים לפי המצב היציב, אשר יהיו קונסרבטיביים באופיים ולכן מקובלים מבחינה הנדסית, בעוד שבדירות עם חימום לסירוגין הטעות הנובעת מחישוב כזה גדולה מאד וגורמת להערכת חסר ניכרת (הטמפרטורה המחושבת גבוהה בהרבה מן הקיים בפועל), ולכן אינה מקובלת מבחינה הנדסית.
