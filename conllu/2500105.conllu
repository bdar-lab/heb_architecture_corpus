# file = txt/2500105.txt
# filelineno = 59
# sentno = 2
# text = כאשר לוקחים בחשבון שדיוק המדידה באמצעות הצמדים התרמיים הוא ±0.5°C, אזי זו דרגת התאמה טובה מאד, המעידה כי למטרות של המחקר הנוכחי אין כל ספק כי החישוב הדינמי באמצעות TARP מתאים, על אף אי הדיוק שמתקבל בחישוב טמפרטורת המקסימום של המשטחים החיצוניים של קירות החוץ.
