# file = txt/2000117.txt
# filelineno = 249
# sentno = 1
# text = פונקציונליזם - הפונקציונליזם היה מגמה מרכזית באדריכלות הישראלית בשנות ה־50 וה־60 של המאה ה-20, כאחת מהמגמות המרכזיות במודרניזם המאוחר (הסגנון האדריכלי המוביל בישראל בתקופה זו) וכחלק מהצרכים החברתיים והכלכליים של התקופה - בניה המונית באמצעים כלכליים מוגבלים (כרמי, 1999; אפרת, 2004).
