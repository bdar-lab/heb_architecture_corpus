# file = txt/2000117.txt
# filelineno = 563
# sentno = 1
# text = ראוי לציין כי התפיסה של בניין התחנה כמחולק לשלוש שכבות - מסוף עירוני, קומה מסחרית, ומסוף בינעירוני, מופיעה כבר בתכניות של ויטקובר, באומן, זלקינד והראל מ־1962, לשדרוג והרחבה של התחנה המרכזית הישנה (ראו תת-פרק 4.2).
