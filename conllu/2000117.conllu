# file = txt/2000117.txt
# filelineno = 688
# sentno = 1
# text = לכאורה, על פי החזון האדריכלי, התחנה הינה מקום מתוכנן מראש, שהאדריכל סיפק "הוראות הפעלה" מושלמות לבאים בשעריו; בפועל, האדריכלים מתארים את מגבלות שליטתם על המקום, ומכירים בכך שרבים השחקנים שהינם בעלי כוח ונכונות להשתתף במאבק על שינוי המקום על פי מאווייהם, ואף מצליחים בכך.
