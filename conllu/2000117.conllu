# file = txt/2000117.txt
# filelineno = 548
# sentno = 3
# text = לדבריו המקומות הציבוריים בשכונת נווה שאנן הינם בית הספר ניאליק (הסמוך לתחנה) ומסוף התחנה המרכזית הישנה, שאמור להפוך לפארק ציבורי, ולאו דווקא התחנה המרכזית החדשה (תפיסה זו מבוטאת גם בתכנית "מתחם התחנות" שנערכה על ידי עיריית תלאביב־יפו ב-2004, כפי שהוצגה בפרק 4.2).
