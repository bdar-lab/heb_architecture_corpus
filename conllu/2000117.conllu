# file = txt/2000117.txt
# filelineno = 1019
# sentno = 1
# text = הסביבה הפיסית - אמצעי רטורי מרכזי לתיאור הסביבה הפיסית בתחנה הוא ציור הלשון: "מערות" או "מחילות" לתיאור התחנות בקומות הראשונות במבנה (אלו שתוכננו להיות "שרוולי־עליה־ למטוס"); "פיל לבן" או "בניין מפלצת" לתיאור הגודל המוגזם והעדר שימוש הולם במבנה; "טלאי על טלאי" לתיאור התכנון הלקוי בבניין.
