# file = txt/1500143.txt
# filelineno = 194
# sentno = 1
# text = המשתנים שנמצאו רלוונטיים ביותר לנושא בחירה באמצעי תחבורה הם מידת עירוב שימושי הקרקע שלרוב מחושבת על פי מספר השימושים השונים (מסחר, מגורים, משרדים וכדומה) הקיימים בשטח נתון; צפיפות הפעילות (מידת ריכוז הפעילות לתא שטח) המחושבת למשל על ידי מספר המועסקים לשטח ריצפה, צפיפות האוכלוסייה, צפיפות המגורים, היחס בין שטח הרצפה של שימושים שונים לבין השטח הנתון וכדומה; ועיצוב עירוני היוצר סביבה ידידותית להולכי רגל ומתבטא במאפיינים כגון מדרכות רחבות, תאורה, עצי רחוב וצמחייה מטופחת & Crane)
