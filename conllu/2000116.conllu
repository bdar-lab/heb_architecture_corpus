# file = txt/2000116.txt
# filelineno = 291
# sentno = 1
# text = לטענת הירש, 'ניתן לראות בגן העצמאות מרחב קווירי לא רק משום שמתקיימת בו פעילות מינית לא נורמטיבית במרחב הציבורי, אלא במובן חזק יותר: משום שבאופן שבו הוא פועל על המבקרים בו הוא מערער את השליטה ההטרוסקסואלית במרחב הציבורי, גם אם באופן מקומי בלבדי (הירש, 2005 עמי 289).
