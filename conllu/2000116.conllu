# file = txt/2000116.txt
# filelineno = 169
# sentno = 10
# text = בנוסף, הסכימה העירייה למסור לגרינבלט את שטחי המחלול שהכרה מהממשלה ומגרשים נוספים שברשותה, להגדלת שטח התוכנית ל-225 אלף מ״ר, 'ליצירת מרכז רחצה וסידורו לפי השקפת בניין עיר מודרנית אשר יוכל למשוך ולעכב תיירים מבקרים ומתרחצים לשהייה נוחה וממושכת', גרינבלט התחייב להקצות 112 דונם לשימושים ציבוריים כמו דרכים וטיילת, ו-143 הדונם הנותרים יועדו לבנייה של מבנים בני ארבע וחמש קומות.
