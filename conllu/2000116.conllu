# file = txt/2000116.txt
# filelineno = 256
# sentno = 1
# text = העובדה הראשונה שנקבעה בשטח עם כיבוש מנשייה בשנת 1948 הייתה ניכוס ופיתוח שטחו של גן הכובשים - אשר נפתח לציבור במאי 1957 - כשטח ציבורי עירוני בתוך השכונה ההרוסה, ששטחה הכבוש היה שייך למנהל מקרקעי ישראל.
