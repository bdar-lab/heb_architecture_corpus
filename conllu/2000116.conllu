# file = txt/2000116.txt
# filelineno = 275
# sentno = 9
# text = האשמה המוטלת בממסד העירוני על 'מכירתי נכסי הציבור לבעלי הון, לא מוצדקת בעיני הממסד מאחר וכוונתו להשתמש ביזמים בכדי 'להציל' שטח השייך 'לציבור הרחב' מפני ניכוסו בידי ציבורים בעלי אינטרסים אחרים - וילהחזירו לציבורי (אברמוב, 2000).
