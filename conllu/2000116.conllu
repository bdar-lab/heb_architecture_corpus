# file = txt/2000116.txt
# filelineno = 306
# sentno = 2
# text = מתוך סצנות היומיום שצילם הצלם החובב קורבמן בשנות העשרים והשלושים ניתן לראות כי החוף, יותר מכל אזור אחר בעיר, אפשר מגעים בין גברים על בסיס ארוטי ומיני (כרמיאל, 2004), במיוחד סביב כיכר הרברט סמואל (כמו גם מתחם לאינטראקציה על בסיס רומנטי-מיני בין גברים ונשים).
