# file = txt/2000116.txt
# filelineno = 157
# sentno = 2
# text = השאיפה הייתה להסדיר את החוף מבחינה מוסרית אך גם מבחינה פונקציונאלית - בעיקר בהיבט של תנועה, מאחר השביל לאורך שפת הים היה, כפי שתיאר בראוור (1936) שביל האורך החשוב והקדום ביותר במרחב של תל אביב, מצב שהתנגש עם הצרכים של רחיצה וטיול נינוח.
