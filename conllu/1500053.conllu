# file = txt/1500053.txt
# filelineno = 167
# sentno = 3
# text = 108 ואכן, המודרניזם האדריכלי, אשר עוצב מלכתחילה בארצות הברית על ידי מהגרים אירופיים, בעיקר גולים מגרמניה כמו מיס ואן דה רוחה, ואלטר גרופיוס, מארסל ברוייר ואחרים, איבד את משמעויותיו החברתיות ואומץ על ידי החברה הקפיטליסטית הממוסדת, שגילתה דימוי חדש שכולו אומר יעילות, חסכנות, נקיון וטכנולוגיה, והפכה אותו לסגנון השליט בבתי משרדים, בתי מלון ובנייני ציבור (איתן, 1982).
