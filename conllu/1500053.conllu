# file = txt/1500053.txt
# filelineno = 422
# sentno = 1
# text = הכרונולוגיה של התהליך בו הצליחה תערוכה אדריכלית להמיר ידע מקצועי להון תרבותי ולפעפע אל מחוץ לזירה המוזיאלית ואל מחוץ לגבולות השיח האדריכלי מסמנת קפיצות של עשור; החל מהופעתה של "עיר לבנה" ב-1984 כאירוע פנים דיסציפלינארי המציג מחקר אדריכלי הסטורי, אל המרחב הציבורי הלאומי באירועי הבאוהאוס ב-1994 ומשם אל הענין הבינלאומי אשר ליווה את חגיגות ההכרזה על תל-אביב כאתר מורשת עולמית ב-2004.
