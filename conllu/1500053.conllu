# file = txt/1500053.txt
# filelineno = 118
# sentno = 1
# text = "דלות החומר" רלוונטית לדיון ב"עיר לבנה" לא רק מפאת האוריינטציה התרבותית שהיא מייצגת כי אם גם מכמה טעמים נוספים; בדומה ל"עיר לבנה", כוננה "דלות החומר" מבט הסטורי- רטרוספקטיבי על האמנות הישראלית ואגב כך השתתפה באופן פעיל במאבק על ההגמוניה בשדה האמנות בישראל; מאבק שבמרכזו היו שתי הערים הגדולות ושני המוזיאונים הגדולים; מוזיאון ישראל ומוזיאון תל-אביב לאמנות.
