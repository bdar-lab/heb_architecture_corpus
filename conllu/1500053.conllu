# file = txt/1500053.txt
# filelineno = 141
# sentno = 4
# text = 90 הביקוש לדירות עלה ומחירי הדירות ברחובות השקטים של מרכז העיר החלו מתקרבים לאלו שבצפון העיר עד שבתום שלש שנים, כשכבר לא היה בכך צורך, הופסק הסיוע ממשרד השיכון ומהעיריה (ארז וכרמון, 1996; מזור ודוידוב-קרמר, 2007).
