# file = txt/1500053.txt
# filelineno = 282
# sentno = 2
# text = 173 הצגתן של שתי הערים זו כניגודה של זו חלחלה, כאמור, אל התרבות הישראלית כאשר אל מול ירושלים הטעונה כל כך, מסמלת תל-אביב את מעוז הנורמאליות והשפיות הישראלית, את החילוניות, האוניברסאליות וההתמקדות בהווה, את הניתוק מהנרטיבים הגדולים המבנים את החיים הישראליים (עזריהו, 2005, פייגה, 2005; וניצקי סרוסי, 2000) או כפי שמנסחים זאת גורביץ' וארן "תל-אביב... היא כולה 'ישראלית', כולה 'שלנו'"... (גורביץ' וארן, 1991).
