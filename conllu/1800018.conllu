# file = txt/1800018.txt
# filelineno = 287
# sentno = 6
# text = השיטה אינה שכיחה עדיין בארץ משיקולים של שיווק ומכירות- מדובר בשיטה בה עלות השינוי (כגון בתשתית האינסטלציה והחשמל שתחת הרצפות) הינה גבוהה, לכן במקרה שקבלן לא מכר את כל היחידות מראש, הוא לא מרצף בשיטה של הדבקה, וכך חוסך את עלות ביצוע השינויים הגבוהה, בהתאם לטעמי הצרכנים.
