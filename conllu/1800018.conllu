# text = ג.	בארצות הברית, שבה הבניה למגורים נעשית בחומרים מגוונים, כגון: עץ, פלדה ובטון, ניתן לראות שרוב הבניה צמודת הקרקע נעשית בעץ־פלדה או בטון, בשיטות המיוחדות בארה״ב, אך באזורים שבהם יש בניה רוויה לגובה של מגורים, כגון: קליפורניה, לונג-איילנד, ניו ג׳רסי ובפרברי שיקגו, לא קיימת בניה קונבנציונאלית, אלא אך ורק בניה מתועשת, ומהירות הבניה גדולה מאוד, ואין ספרות מקצועית שעוסקת בהשוואת בניה קונבנציונאלית לבניה מתועשת, ואין מדדים כלכליים לנושא הזה, משום שזה כמעט מובן מאליו שהבניה חייבת להתבצע בשיטות מתועשות.
# raw = {'id': 1, 'text': 'ג.\tבארצות הברית, שבה הבניה למגורים נעשית בחומרים מגוונים, כגון: עץ, פלדה ובטון, ניתן לראות שרוב הבניה צמודת הקרקע נעשית בעץ־פלדה או בטון, בשיטות המיוחדות בארה״ב, אך באזורים שבהם יש בניה רוויה לגובה של מגורים, כגון: קליפורניה, לונג-איילנד, ניו ג׳רסי ובפרברי שיקגו, לא קיימת בניה קונבנציונאלית, אלא אך ורק בניה מתועשת, ומהירות הבניה גדולה מאוד, ואין ספרות מקצועית שעוסקת בהשוואת בניה קונבנציונאלית לבניה מתועשת, ואין מדדים כלכליים לנושא הזה, משום שזה כמעט מובן מאליו שהבניה חייבת להתבצע בשיטות מתועשות.', 'dspan': (0, 500), 'tokens': [{'id': 1, 'text': 'ג', 'upos': 'NUM', 'xpos': 'NUM', 'head': 0, 'deprel': 'root', 'dspan': (0, 1), 'span': (0, 1), 'lemma': 'ג'}, {'id': 2, 'text': '.', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 1, 'deprel': 'punct', 'dspan': (1, 2), 'span': (1, 2), 'lemma': '.'}, {'id': (3, 4), 'text': 'בארצות', 'expanded': [{'id': 3, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'ב'}, {'id': 4, 'text': 'ארצות', 'upos': 'PROPN', 'xpos': 'PROPN', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 1, 'deprel': 'nmod', 'lemma': 'ארץ'}], 'span': (3, 9), 'dspan': (3, 9)}, {'id': (5, 6), 'text': 'הברית', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'ברית', 'upos': 'PROPN', 'xpos': 'PROPN', 'feats': 'Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'compound', 'lemma': 'ברית'}], 'span': (10, 15), 'dspan': (10, 15)}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 15, 'deprel': 'punct', 'dspan': (15, 16), 'span': (15, 16), 'lemma': ','}, {'id': (8, 10), 'text': 'שבה', 'expanded': [{'id': 8, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 15, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 9, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ב'}, {'id': 10, 'text': 'ה', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Fem|Number=Sing|Per