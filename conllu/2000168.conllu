# file = txt/2000168.txt
# filelineno = 379
# sentno = 3
# text = החל בהיסטוריה העתיקה מסיפורי התנ״ך ועוד קודם שמעלה השם "מגידו" (וגם בהיסטוריה העתידית של סוף העולם "ארמגדון"), דרך הסיטואציה הגיאוגראפית לה מעבר חד וברור בין שני נופים שונים במובהק, זה של הגבעות הנמוכות וזה של העמק השטוח - יחד עם המבט הרחוק להר התבור והרי נצרת, וגם ההתחלפות של שני דימויים מרחביים רחוקים מאוד אחד מהשני : הנוף הערבי המתפרס של כפרי וואדי ערה ואום־אל פאחם שמתחלף באחת בנופים הפתוחים של העמק.
