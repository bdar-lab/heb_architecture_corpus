# file = txt/2000168.txt
# filelineno = 424
# sentno = 1
# text = התפקיד האחרון - החקלאים הם קבוצה קטנה יחסית לאחרות שהקשר שלה לקרקע ולמקום הוא לכאורה העמוק ביותר, בעצם עבודת האדמה שמחדשת בהתמדה את הקשר שבין החקלאי לקרקע, ששומרת את המרחב כולו כמרחב של יצירה ושיוצר את הדימוי המרחבי עבור רבים ממי שגרים במרחב, פעילים בו או חולפים בו.
