# file = txt/2000168.txt
# filelineno = 200
# sentno = 1
# text = הדימוי המרחבי הזה מקבץ אוסף של מקומות ושל דימויים שכמעט כל אחד מהם שייך גם לקטגוריה אחרת: נוף חקלאי, נוף כפרי, פרבר -- בתי מגורים, מבני דת, מבני ציבור, חנויות מוסכים ודוכני מכירה, מסעדות ״מזרחיות״, שלטי פרסום ומודעות - אבל בתוך כל אחת מהקבוצות האלו אפשר להצביע על הבדלים מרחביים וחזותיים ניכרים בין הביטויים של הנוף הערבי ובין הביטויים של הנוף הכללי (היהודי?), הנובעים מתוך הצורה התכנים או ההקשר.
