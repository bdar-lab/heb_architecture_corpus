# file = txt/2000168.txt
# filelineno = 374
# sentno = 2
# text = חנויות של חברות בינלאומיות כמו איקאה שמתוכננות תמיד לפי סכימות ארגון קבועות וצבעים מייצגים, ומיקומם במרחב הבינעירוני אינו מקרי אלא נובע מקנה המידה הגדול של החנויות שמשרתות קונים הפרוסים על מרחב מעבר לעיר אחת - וגם בנייני עסקים של חברות בינלאומיות וגם ישראליות שנבנים בארכיטקטורה נייטרלית, בלא התייחסות למקום ספציפי -והרבה פעמים גם תוך שימוש באלמנטים מיובאים של חיפויים וקירות מסך.
