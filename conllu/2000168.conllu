# file = txt/2000168.txt
# filelineno = 4
# sentno = 1
# text = במבט אל המרחב הבינעירוני בישראל מאופיינות עשר קטגוריות של דימויים מרחביים המכונות "ערוצים נושאיים", שיכולים להתקיים בחפיפה ובו זמניות ומתוכם נבנית הדמות של המרחב הבינעירוני: עיר ישנה, טבע ושטחים פתוחים, נוף התיישבות, פרברים, נוף ערבי, צבא ובטחון, תשתיות, היסטוריה ודת, תכנים ציבוריים ועירוניות חדשה שהיא הביטוי לתהליכי להתפרסות השימושים והמרכזים העירוניים.
