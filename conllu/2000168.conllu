# file = txt/2000168.txt
# filelineno = 363
# sentno = 1
# text = תהליך ההיווצרות וההתפתחות של המרחב הבינעירוני יכול להיות מוצג כתהליך ארוזיה בו "המקום הקטן" שמובל על ידי שימושים בנאליים ויומיומיים כמו מסעדות, חנויות קטנות, צימרים, וגני אירועים, זוחל לאיטו אל ״המקום הגדול״ - נופי התנ״ך, נופי ההתיישבות החלוצית, קווי הגבול והתפר.
