# file = txt/1800123.txt
# filelineno = 515
# sentno = 1
# text = ההשוואות שנערכו מלמדות שההליך המקורב מאפשר לנבא באופן סביר את התנהגות פאנל קיר בני בודד הכלוא במסגרת בטון מזויין ביחסי אורך/רוחב שונים במגוון קונפיגורציות ובעלי תכונות ונתוני העמסה שונים, אשר מאפיינים את הבנייה הקיימת למגורים בישראל.
