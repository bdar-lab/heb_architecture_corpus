# file = txt/1800123.txt
# filelineno = 18
# sentno = 3
# text = מן הראוי לציין ששיטות הערכה ראשוניות אלה מחייבות אבחון בפועל של נתונים גיאומטריים וחומריים, בסיסיים לכל הפחות, של רכיבי מערכות ההקשחה של הבניינים הנבדקים, אם כי אין הן מחייבות אבחון בפועל של נתונים מבניים מפורטים לגביהם, כגון כמויות של זיון כפיפה וגזירה ברכיבים המבניים השונים ו/או פרטי זיון שלהם.
