# file = txt/1200085.txt
# filelineno = 219
# sentno = 5
# text = ההבדל בתסבולת האופקית של שני הדגמים אלה נובע בעיקר מתסבולת האופקית הגדולה יותר של מסגרת הבטון המזוין של דגם 00001 הכולל עמודים קשיחים, אשר נבדק בשלב הנוכחי של המחקר, בהשוואה לתסבולת האופקית של מסגרת הבטון המזוין הכוללת עמודים גמישים, אשר נבדקה בשלב א' של מחקר זה [27].
