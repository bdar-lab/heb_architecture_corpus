# file = txt/1200085.txt
# filelineno = 19
# sentno = 15
# text = בשנים האחרונות נערכים במכון הלאומי לחקר הבנייה מספר מחקרים המיועדים לפיתוח גישה חישובית כוללת לבחינת התנהגות מבנה הכולל קירות מילוי מבלוקי בני מסוגים שונים, כאמור לעיל, (לישק, יאגוסט [22]), והוחל בפעילות מחקרית המיועדת לגבש הבנה עמוקה יותר של מנגנוני הכשל במישקים של קיר בני, על מנת לנתח בצורה כמותית מעמיקה את תהליך התפתחות הכשל בקיר בני בהטרחה נתונה (לישק, יאגוסט, ינקלבסקי [23]).
