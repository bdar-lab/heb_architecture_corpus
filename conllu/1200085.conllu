# file = txt/1200085.txt
# filelineno = 391
# sentno = 1
# text = •	גישות התכן וההערכה התפקודיים המודרניות, המוזכרות לעיל, מאפשרות להתייחס למבנה חדש מתוכנן, או למבנה קיים נבדק, לא רק מהיבט של קביעת התסבולת הגבולית של המבנה והשוואתה לעומסים החזויים לפעול על המבנה, אלא גם מהיבט של אופי התגובה של המבנה במקרה של חשיפתו לעומסים חזויים שונים, לרבות עומסים קיצוניים בלתי צפויים (תגובה אלסטית או לא אלסטית, אופי הנזקים המבניים החזויים ומידת חומרתם), כמו גם מהיבטים תפקודיים ישימים שונים של הבניינים הנדונים, התלויים כמובן בייעודם ובאופי המערכות המשלימות השונות המותקנות בהם.
