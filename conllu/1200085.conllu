# file = txt/1200085.txt
# filelineno = 179
# sentno = 6
# text = הגדלת אמפליטודות ההזזה בסדרות ההעמסה מבוקרי הזזה של דגמים אלה על פי המוצע ע"י 14] Park], כמפורט לעיל, הייתה גורמת לכך שהמספר הכולל של מחזורי ההעמסה של דגמים אלה היה יכול להגיע לעשרות ואף למאות מחזורי העמסה, דבר שהיה גורם הן להארכה משמעותית של משך הניסויים, והן לעיוות של הערכת המשיכות המצטברת של דגמים אלה, כמפורט בפסקה 3 להלן.
