# file = txt/1200085.txt
# filelineno = 27
# sentno = 1
# text = המאפיינים הצפויים להשפיע על התנהגות מערכות מבניות מסוג זה ניתן למנות את סוג הבלוקים המשמשים לבניית ספיני קירות הבני, את שיטת הבנייה של ספיני קירות הבני, את היחסים הגיאומטריים גובה/רוחב של תאי המסגרות, את המידות הגיאומטריות ופרטי הזיון של רכיבי המסגרות העשויים מבטון מזוין, את רמת ההטרחה של עמודי המסגרות ושל קירות הבני ע״י עומסי כבידה או על ידי דריכתם מראש, את קיומם או היעדרם של פתחים בספיני קירות הבני, לרבות מיקום וגודל פתחים אלה, החגורות בהיקפן וכוי.
