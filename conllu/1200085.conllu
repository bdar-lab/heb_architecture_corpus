# file = txt/1200085.txt
# filelineno = 49
# sentno = 1
# text = מן הראוי לציין שבניית קירות הבני כקירות מילוי לאחר יציקת המסגרות נעשית בדגמים השונים ללא שום קשר מיכני בין הקירות לעמודי המסגרת (למעט מילוי מלט, ככל הניתן, במישקים האנכיים בין הבלוקים לעמודי הבטון, כמו גם במישק האופקי בין חלקם העליון של קירות המילוי לתחתית הקורות - המשקופים העליונים של המסגרות), זאת על מנת לייצג מצבים שכיחים מאוד של בניית קירות בני באיכות ירודה בבניינים קיימים, אשר נבנו שלא בהתאם לדרישות המפרט הכללי מטעם הועדה הבין משרדית לסטנדרטיזציה של מסמכי חוזה ומיכונם, המחייב שימוש באמצעי חיבור מיכניים לחיבור בין ספיני קירות בני לשלד הבטון העוטף אותם (למשל מוטות פלדה מעוגנים בעמודים ובמישקים אופקיים מסוימים לגובה הקיר).
