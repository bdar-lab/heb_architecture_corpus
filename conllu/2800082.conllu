# file = txt/2800082.txt
# filelineno = 436
# sentno = 1
# text = יש להעיר, כי יתכן ויש במגמות הג״ל כדי לרמוז על השפעת המתרחש בשכונה בכיוון השלילי, לגבי חלק מהתושבים "המצליחים" פחות בהשוואה לNחרים; דבר המחריף זאת עמדותיהם ביחס לתלות בקידום שזאיפותיהם הזאישיות בNחרימ.
