# file = txt/2800082.txt
# filelineno = 53
# sentno = 1
# text = צירוף המי מצא ים משתי הבחינות שנערכו! מצד אחד, התשומות - ניתוח התוכנית החברתית והתקציבית לאורך השנים 1981/82 - 1986/87; ומצד שני, התפוקות - ניתוח התמורות לפי עמדות התושבים בשנים 1983, 1986 -(מלמדים גם על פרוייקט השיקום בכלל ועל יישום עקרונותיו בשטח.
