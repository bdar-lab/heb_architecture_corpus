# file = txt/2800082.txt
# filelineno = 169
# sentno = 1
# text = השיקולים בפיתוח שירותי העשרה הושפעו לא רק מן הצורך להביא לשינוי הדימוי של הפרט, הקהילה ותדמית השכונה בטווח הזמן המיידי (ראה אסטרטגית השיקום לעיל), או מן הצורך להחדיר את הפרוייקט על יעדיו בשכונה, כדי ליצור אמינות בין התושבים ו המי מסד העירוני לבין גורמי הפרוייקט - מצד אחד, ובין הקהילה המאמצת לבין הקהילה השכונתית - מצד שגי, דבר שהצריך עשייה מיידית שתורגש בשטח - אלא גם משיקולי□ חיצוניים כמו: טיב□ של משאבי הפרוייקט ורמת המידע ה מ צ ו י .
