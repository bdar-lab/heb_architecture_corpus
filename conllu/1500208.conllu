# file = txt/1500208.txt
# filelineno = 12
# sentno = 3
# text = בשנים האחרונות עם התפתחות כלכלת המידע והשירותים, האגלומרציה מביאה לידי ביטוי את החשיבות של אינטראקציה האנושית, זרימה של רעיונות והתמחות מתגברת, ולעומת זאת היא בעלת השפעה פחותה בתחומי תעסוקה הדורשים כישורים פיזיים (אם כי גם במקצועות אלו יש לעיתים רבות יתרון לגודל ויתרונות בקרבה למרכזי תעסוקה גדולים).
