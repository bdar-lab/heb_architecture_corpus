# file = txt/1500208.txt
# filelineno = 97
# sentno = 1
# text = גם בישראל נמצאת שאלת האי שוויון הכלכלי-חברתי בלב השיח הכלכלי והפוליטי כאשר צמצום האי שוויון בין פריפריה למרכז בישראל היא מדיניות מוצהרת של קובעי מדיניות בשנים האחרונות (למשל כפי שמשתקף בהצהרות רה״מ בנימין נתניהו (2015) במהלך דיון בכנסת: "אנחנו מבטלים את הפריפריה").
