# file = txt/1500237.txt
# filelineno = 11
# sentno = 1
# text = ״בשנת 2017 משרד האוצר המשיך לפעול על-מנת להגדיל את היצע הדירות בשוק, ובתוך כך לשתק עשרות אלפי דירות... בשנת2017 שווקו קרקעות מעל ליעדים שנקבעו,נחתמו עסקאות מעל ליעדים שנקבעו ותוכננו יחידות דיור בשיעור שליותר מ- 20% מעל ליעדים שנקבעו,׳ (שר האוצר משה כחלון, תכנית עבודה לשנת 2018, משרד הבינוי והשיכון)1.
