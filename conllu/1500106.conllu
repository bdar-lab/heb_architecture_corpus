# file = txt/1500106.txt
# filelineno = 713
# sentno = 1
# text = פעילות מחאה של תושבי העיר כנגד ריכוז של מספר הוסטלים ברחוב אחד בעיר (כפי שיפורט בסעיף 6.1.3.2), אשר לוותה בהפגנות מחאה ופניות חוזרות ונשנות אל הנהלת העירייה, הובילה לפנייתה של מנכ״לית העירייה למשרד הרווחה והשירותים החברתיים בחודש פברואר 2007,
