# file = txt/1500106.txt
# filelineno = 268
# sentno = 5
# text = עובדה זו קיבלה חיזוק בשיחה עם רכזת "סל שיקום" מחוזית, אשר אמרה כי לא קיים גורם המאגד תחתיו את כלל המידע הרלוונטי וכי לא מתקיימת העברת מידע בין האגפים השונים (ראיון עם מפקחת סל שיקום במשרד הבריאות מחוז חיפה, 13.5.2007), וגם בישיבות הוועדה הבין משרדית לנושא השיקום בקהילה (ישיבות הוועדה הבין משרדית, 27.6.2007, 3.3.2008).
