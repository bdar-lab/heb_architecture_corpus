# file = txt/1500106.txt
# filelineno = 295
# sentno = 6
# text = ניסיון למפות את השירותים השונים המסופקים במסגרת הקהילה במסגרת עבודה זו, נתקל בקושי רב ליישום, כתוצאה ממספר סיבות: ריבוי גופים מטפלים, פיצול תחומי האחריות על אוכלוסיית המטופלים, ומבנה בלתי אחיד של המחלקות לשירותים חברתיים ברשויות המקומיות.
