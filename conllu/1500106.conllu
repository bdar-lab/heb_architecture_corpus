# file = txt/1500106.txt
# filelineno = 996
# sentno = 2
# text = התשתית החוקית המגדירה את זכותן של אוכלוסיות בעלות צרכים מיוחדים לצרוך שירותים במסגרת הקהילה, מעוגנת במספר חוקים, כאשר סעיף 63(א) לחוק התכנון והבנייה הישראלי מעניק את הכלים ליישום הזכות למגורים במסגרת הקהילה, באמצעות הגדרה על פיה כל מקום המיועד למגורים בתכנית תקפה, יש לראות בו גם מקום המתאים למגורי חוסים (חוק התכנון והבנייה, התשכ״ה-1965).
