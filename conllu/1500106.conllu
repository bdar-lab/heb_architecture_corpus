# text = האירועים גררו פעילות של גורמים אזרחיים כנגד תופעת ההתנגדות לשיכון אוכלוסייה בעלת מוגבלויות בשכונה: עמותת "קרן שלם לפיתוח שירותים לאדם המפגר ברשויות המקומיות" החלה פרויקט הסברה עירוני בנושא שילוב אוכלוסייה בעלת פיגור בקהילה (YnetActivism, 11.7.2006) ועמותת "מעגלי צדק" יזמה עצרת מחאה אל מול בניין העירייה בה השתתפו כ-500 בני נוער ונציגי ארגוני הנכים (תחאוכו, 18.9.2006).
# raw = {'id': 4, 'text': 'האירועים גררו פעילות של גורמים אזרחיים כנגד תופעת ההתנגדות לשיכון אוכלוסייה בעלת מוגבלויות בשכונה: עמותת "קרן שלם לפיתוח שירותים לאדם המפגר ברשויות המקומיות" החלה פרויקט הסברה עירוני בנושא שילוב אוכלוסייה בעלת פיגור בקהילה (YnetActivism, 11.7.2006) ועמותת "מעגלי צדק" יזמה עצרת מחאה אל מול בניין העירייה בה השתתפו כ-500 בני נוער ונציגי ארגוני הנכים (תחאוכו, 18.9.2006).', 'dspan': (402, 771), 'tokens': [{'id': (1, 2), 'text': 'האירועים', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'אירועים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 3, 'deprel': 'nsubj', 'lemma': 'אירוע'}], 'span': (0, 8), 'dspan': (402, 410)}, {'id': 3, 'text': 'גררו', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem,Masc|HebBinyan=PAAL|Number=Plur|Person=3|Tense=Past|Voice=Act', 'head': 0, 'deprel': 'root', 'dspan': (411, 415), 'span': (9, 13), 'lemma': 'גרר'}, {'id': 4, 'text': 'פעילות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'obj', 'dspan': (416, 422), 'span': (14, 20), 'lemma': 'פעילות'}, {'id': 5, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 6, 'deprel': 'case', 'dspan': (423, 425), 'span': (21, 23), 'lemma': 'של'}, {'id': 6, 'text': 'גורמים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'nmod:poss', 'dspan': (426, 432), 'span': (24, 30), 'lemma': 'גורם'}, {'id': 7, 'text': 'אזרחיים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 6, 'deprel': 'amod', 'dspan': (433, 440), 'span': (31, 38), 'lemma': 'אזרחי'}, {'id': 8, 'text': 'כנגד', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'dspan': (441, 445), 'span': (39, 43), 'lemma': 'כנגד'}, {'id': 9, 'text': 'תופעת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 4, 'deprel': 'nmod',