# file = txt/1500106.txt
# filelineno = 389
# sentno = 6
# text = אולם לצד קביעה זו, בהתייחס לשימוש בקומת הקרקע ועליית הגג לצרכי מגורים, ציין השופט כי "הבין מחייב את המבקשים לשאת בנטל מסוים (אירוח "קהילת משתקמים" בשכונת המגורים), ואולם אין משמעות הדבר שעליהם לשאת בנטל נוסף, במיוחד כאשר מדובר בנטל הנובע מהפרת הדין - משמע, עצם הפעלת ההוסטל אינה מהווה חריגה מהיתר, אולם עליה להיעשות בהתאם לחוק ועל אכלוס המבנה להיעשות תוך התאמה מלאה להיתר המבנה למגורים (בש״א(י-ם)2007,5853/07).
