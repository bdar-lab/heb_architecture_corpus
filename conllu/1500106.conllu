# text = מאפיינים חברתיים־כלכליים ויחס הציבור לשירותי השיקום בקהילה - המחקרים העוסקים במאפייני האוכלוסייה בעלת הפוטנציאל הגבוה ביותר להביע התנגדות כלפי מיקום שירותי שיקום בקהילה מצאו, בין היתר, כי קיים קשר ישיר בין רמת ההשכלה והבעלות על נכס מגורים, לבין ההתנגדות לפעילות שירותי השיקום בקהילה (1989 ,Yankelovits אצל 2002 ,Jimenez ; 1998 ,Takahashi and Gber ; 1992 ,Dear) וכי קיים קשר ישיר בין החתך החברתי-כלכלי של תושבי שכונת המגורים לבין מידת ההתנגדות לשירותי השיקום בקהילה (2000 ,Wolch ; יהל, 2002).
# raw = {'id': 2, 'text': 'מאפיינים חברתיים־כלכליים ויחס הציבור לשירותי השיקום בקהילה - המחקרים העוסקים במאפייני האוכלוסייה בעלת הפוטנציאל הגבוה ביותר להביע התנגדות כלפי מיקום שירותי שיקום בקהילה מצאו, בין היתר, כי קיים קשר ישיר בין רמת ההשכלה והבעלות על נכס מגורים, לבין ההתנגדות לפעילות שירותי השיקום בקהילה (1989 ,Yankelovits אצל 2002 ,Jimenez ; 1998 ,Takahashi and Gber ; 1992 ,Dear) וכי קיים קשר ישיר בין החתך החברתי-כלכלי של תושבי שכונת המגורים לבין מידת ההתנגדות לשירותי השיקום בקהילה (2000 ,Wolch ; יהל, 2002).', 'dspan': (3, 494), 'tokens': [{'id': 1, 'text': 'מאפיינים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 0, 'deprel': 'root', 'dspan': (3, 11), 'span': (0, 8), 'lemma': 'מאפיין'}, {'id': 2, 'text': 'חברתיים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'amod', 'dspan': (12, 19), 'span': (9, 16), 'lemma': 'חברתי'}, {'id': 3, 'text': '־', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (19, 20), 'span': (16, 17), 'lemma': '־'}, {'id': 4, 'text': 'כלכליים', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Plur', 'head': 2, 'deprel': 'dep', 'dspan': (20, 27), 'span': (17, 24), 'lemma': 'כלכלי'}, {'id': (5, 6), 'text': 'ויחס', 'expanded': [{'id': 5, 'text': 'ו', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 6, 'deprel': 'cc', 'lemma': 'ו'}, {'id': 6, 'text': 'יחס', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'conj', 'lemma': 'יחס'}], 'span': (25, 29), 'dspan': (28, 32)}, {'id': (7, 8), 'text': 'הציבור', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'ציבור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 6, 'deprel': 'compound:smixut', 'lemma': 'ציבור'}], 'span': (30, 36), 'dspan': (33, 39)}, {'id': (9, 10), 'text': 'לשירותי', 'expanded': [{'id': 9, 'text': 'ל', 'upos