# file = txt/1500106.txt
# filelineno = 347
# sentno = 2
# text = חוסים, על פי חוק התכנון והבנייה, מוגדרים באמצעות חוק הפיקוח על מעונות תשכ״ה-1965 כילדים שטרם מלאו להם 14 שנה, זקנים שהגיעו לגיל הפרישה, בעלי מום גופני, הלוקים בשכלם או משתמשים בסמים על פי חוק הפיקוח על מוסדות לטיפול במשתמשים בסמים, התשנ״ג - 1993 (סעיף 1 לחוק הפיקוח על מעונות תשכ״ה - 1965).
