# file = txt/1800162.txt
# filelineno = 177
# sentno = 5
# text = יצוין כי כיום לאור השינוי בחוק שחל בחודש ינואר 2011, שלטונות המס דורשים תשלום מס רכישה על מלוא עלות הקרקע והבניה ולעיתים אף על שווי הדירה כגמורה, אולם הקרקע בפרויקטים שנכללו במחקר, נרכשה לפני השינוי האמור בחוק, ולפיכך לא חל עליהם השינוי האמור.
