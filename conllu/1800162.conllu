# file = txt/1800162.txt
# filelineno = 224
# sentno = 2
# text = הסבר אפשרי לכך הינה העובדה שבמחוזות האמורים, קיימת תחרות גבוהה יותר של קבלנים/יזמים מהאזור לעומת מחוזות המרכז ות"א בהם הצורך בסיווג קבלני גבוה (בין היתר לבניית מגדלים רבי קומות), מקטין את היצע הקבלנים באזורים אלו, כמו כן במחוזות המרכז ות"א הבניה של רבי קומות מגדילה את רמת הסיכון והמורכבות של הפרויקטים ואת הרווח היזמי הנדרש, בהתאמה.
