# file = txt/1500098.txt
# filelineno = 89
# sentno = 10
# text = באמצעות ניתוח משתנים כגון תאריך הכניסה והיציאה של יחידות הדיור משוק הדיור למכירה, המחיר שנדרש ביום הכניסה לשוק, סוג העסקה שהוביל ליציאה משוק המכירה ומחיר העסקה הסופי עבור כל יחידת דיור בשכלול תכונות שונות של הנכסים (כגון מיסים, הלוואות והקלות ממשלתיות ומוניציפאליות), שני החוקרים הגיעו למסקנה כי בעלי הבתים מציגים פרופיל של ״שונאי הפסד״, וכי המחיר בו רכשו המוכרים העכשוויים את נכסיהם בעבר מהווה עבורם את מחיר העוגן, כאשר מחיר נמוך ממנו (גם אם הוא תואם יותר למצב השוק הנוכחי), מהווה עבורם הפסד שהם מתקשים לספוג.
