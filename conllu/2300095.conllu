# file = txt/2300095.txt
# filelineno = 672
# sentno = 2
# text = אולם בעירייה כמו תל- אביב- יפו, אשר פיתחה מחלקות לתכנון־עיר טובות מאד, נראה לנו שאימוץ גישות חדשות לניהול קונפליקטים לא ידרש כח אדם נוסף, אלא שינוי מסוים בחלוקה של הזמן הנוכחי וכמובן - הכשרה מתאימה של חלק מהמתכננים העובדים כיום במערכת.
