# file = txt/2300130.txt
# filelineno = 44
# sentno = 4
# text = האמצעים התכנוניים בהם ניתן לנקוט על מנת להבטיח תפקוד של המרכז כוללים ריכוז פעילויות ועירוב שימושים במרכז השכונתי, כלומר, ריכוז של מגוון פעילויות במרכז השכונה שיבטיח את הימצאותם של אנשים במקום לאורך רוב שעות היום והערב, מיקום המרכז הזה במרחק הליכה ברגל (כמרכז תפקודי של השכונה), שיאפשר לכל קבוצות האוכלוסיה הגרות בשכונה להגיע אליו, כולל ילדים, קשישים ואנשים שאין בבעלותם רכב.
