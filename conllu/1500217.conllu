# file = txt/1500217.txt
# filelineno = 691
# sentno = 4
# text = ברגסון, שהיה בן דורו של הפנומנולוג אדמונד הוסרל(Edmund Gustav 1859-1938 ,Albrecht Husserl), השפיע רבות על הפילוסופיה הצרפתית הקונטיננטלית והפוסט סטרוקטורלית במאה ה-20: מז׳אן פול סארטר (1905-1980,Jean-Paul Sartre) , עמנואל לוינס (1906-1995,Emmanuel Levinas) לז׳ילדלז.
