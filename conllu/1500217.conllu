# file = txt/1500217.txt
# filelineno = 114
# sentno = 1
# text = הרעיון המתמטי שבבסיסו ,עומד בזיקה לפורמליזם של החושים ולגוף האדם המשתנה, והוא מבטא "רצון לסדר" ולשליטה נומרית בגוף האדם, לצד רדוקציה של יחסים ופרופורציות (איור 10) (2001,Kwinter) .
