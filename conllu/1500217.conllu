# text = בספרו ״Space, Time and Architecture״ משנת 1941, גדיון מבחין בין שלוש תקופות עיקריות המאופיינות בתפישת חלל שונה: תקופת מצרים ויוון העתיקה- בה נתפשו הנפחים כמכלול היחסים ביניהם, כלומר מבחוץ; ימי שלטון רומא ועד נפלית הבארוק במאה ה-18 - בה חלל הפנים של המונומנט הוא הדומיננטי; המאה ה-19 כתקופת מעבר אקלקטית; ואחריה מתחילה התקופה השלישית -התקופה המודרנית - בה האדריכלות שואפת ליצור סינתזה בין החיצוני לפנימי.
# raw = {'id': 3, 'text': 'בספרו ״Space, Time and Architecture״ משנת 1941, גדיון מבחין בין שלוש תקופות עיקריות המאופיינות בתפישת חלל שונה: תקופת מצרים ויוון העתיקה- בה נתפשו הנפחים כמכלול היחסים ביניהם, כלומר מבחוץ; ימי שלטון רומא ועד נפלית הבארוק במאה ה-18 - בה חלל הפנים של המונומנט הוא הדומיננטי; המאה ה-19 כתקופת מעבר אקלקטית; ואחריה מתחילה התקופה השלישית -התקופה המודרנית - בה האדריכלות שואפת ליצור סינתזה בין החיצוני לפנימי.', 'dspan': (286, 689), 'tokens': [{'id': (1, 4), 'text': 'בספרו', 'expanded': [{'id': 1, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 2, 'deprel': 'case', 'lemma': 'ב'}, {'id': 2, 'text': 'ספר_', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Def|Gender=Masc|Number=Sing', 'head': 17, 'deprel': 'obl', 'lemma': 'ספר'}, {'id': 3, 'text': '_של_', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case:gen', 'lemma': 'של'}, {'id': 4, 'text': '_הוא', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Case=Gen|Gender=Masc|Number=Sing|Person=3|PronType=Prs', 'head': 2, 'deprel': 'nmod:poss', 'lemma': 'הוא'}], 'span': (0, 5), 'dspan': (286, 291)}, {'id': 5, 'text': '״', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (292, 293), 'span': (6, 7), 'lemma': '״'}, {'id': 6, 'text': 'Space', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 2, 'deprel': 'appos', 'dspan': (293, 298), 'span': (7, 12), 'lemma': 'Space'}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 6, 'deprel': 'punct', 'dspan': (298, 299), 'span': (12, 13), 'lemma': ','}, {'id': 8, 'text': 'Time', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 6, 'deprel': 'conj', 'dspan': (300, 304), 'span': (14, 18), 'lemma': 'Time'}, {'id': 9, 'text': 'and', 'upos': 'CCONJ', 'xpos': 'CCONJ', 'head': 10, 'deprel': 'cc', 'dspan': (305, 308), 'span': (19, 22), 'lemma': 'and'}, {'id': 10, 'text': 'Architecture', 'upos': 'PROPN', 'xpos': 'PROPN', 'head': 8, 'deprel': 'conj', 'dspan': (309, 321), 'span': (23, 35), 'lemma': 'Architecture'}, {'id': 11, 'text': '״', 'upos': 'PUNCT',