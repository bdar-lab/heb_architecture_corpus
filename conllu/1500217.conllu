# file = txt/1500217.txt
# filelineno = 817
# sentno = 1
# text = את היחס בין מוסיקה (בפרט זו של ג׳ון קייג׳) לשפה אדריכלית המתורגמת למקצב ואור, ניתן לבחון בפרויקטים נוספים של הול כגון ״Daeyang Gallery amd House״ משנת 2012, ואף בכוריאוגרפיה שיצר יחד עם הכוראוגרפית ג׳סיקה לאנג (Jessica Lang) הנקראת Tesseracts of Time משנת 2015, כאשר הפסקול המלווה הוא של ג׳ון קייג׳.
