# file = txt/2000162.txt
# filelineno = 411
# sentno = 1
# text = השינויים היו גם בפונקציות בתוך הדירה , כך שבגין התרחבות והתפשטות המשפחה מבחינה מספרית היה מחסור בתדרים ובפונקציות הנלוות, על-כן היה צורך בהרחבת מתחם הדירה, מאוחר יותר כשהבנים מתחתנים ללא תכנון מוקדם אז הדירה חולקה לשניים בין המשפחה לבן ואחייב לשלושה בין המשפחה לשני הבנים הנשואים וכך הלאה עד שהדירה המקורית נהפכה למפלצת של חדרים שהודבקו אחת ליד השניה והדירה בכללותה משרתת כמה משפחות גרעיניות , בנייה זו יצרה מבנה מכוער ובלתי אסתיטי של שכונות הכפר .
