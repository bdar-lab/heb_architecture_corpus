# file = txt/2800036.txt
# filelineno = 9
# sentno = 1
# text = יצויין, כי בפידסום הנוכחי משתקפות עובדות מאלפות המתייחסות לכל התחומים הללו, כך, לפשל, העלו המיסצאים, כי לגבי רוב הטיפוסים של גודל דידה, המחיר הממוצע בתל-אביב, עולה בהרבה - תכופות פי שניים ויותר - על הסחיר המקביל ביישובי הטבעת החיצונית (פתח-תקוה, ראשון-לציון, נתניה ורחובות).
