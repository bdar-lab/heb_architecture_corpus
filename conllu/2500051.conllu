# file = txt/2500051.txt
# filelineno = 73
# sentno = 1
# text = מרשגרת שתי תוצאות: ראשית גדלה כמרת החרם המרעברת עם זרם הדם מחלקי הגרף הפבימיים החמים יותר אל שטת העור הקריר יותר, ושבית גדלה המרליכרת התרמית של שככת הערר* בגלל הגדלת כמרת הברזלים שבה, רפרחת ערך הבדרד התרמי שלו• כתוצאה משבי הגורמים הללר גדלה כמרת החרם הזררמת מפבים הגרף אל שמחר הרדיצרבי־ הגברת מחזור הדם דרך העור גורמת לעלית הטמפרטורה של הערר דדבר זה מחיש את אברד החרם ע״י הקרברקציה רהקריבה לסביבה (אר מפחית את קליטת החרם כאשד הסביבה חמה ירתר מהגרף) רכן מעלה את לחץ האדים של הערר רבכך מסייע להתאדרת הזיעה.
