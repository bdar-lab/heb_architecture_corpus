# sentno = 1
# text = בחדש ירבי גדלה יעילות הצללה הוריזובטלית בכל שגדל עומק ההצללה♦ אפקט דרסה, אמכי קטן ירתר, ישגר לעומק ההצללה בחודש ספטמבר• לערמת זאת באוקטובר ובדצמבר ישבה השפעה לעומק ההצללה רק עד לעומק הטור, לשבי שליש מגובה החלון, ואילו להגדלה ברספת של עומק ההצללה כמעט ואין השפעה• תרפעה זר בגרסת על ידי כך שהשמש זורחת בחורף בדררם מזרח וחרדרת מתחת לצד ההצללה, כך שהגדלת הער מק מעל לשבי שליש הגובה והרוחב כמעט ואיבה משפיעה על החדירה• מכירן שבחורף אבד מערביבים בהגדלת חדירת השמש, הרי שבשיטת ההצללה הזר רצוי להגדיל את עומק ההצללה במידת האפנר מבחיבה כלכלית כירן שהגדלת העומק תפחית את עצמת הקריבה בקיץ, אך לא תפחית את
