# file = txt/2500051.txt
# filelineno = 269
# sentno = 2
# text = בציור מם* 26 ניתנות התוצאות של מהלכי טמפרטורה מחושבים על סמך המדידות הג״ל בבגין כבד הבנוי מקיר לבנים כפול בעובי כולל של 2772 ם״מ עם חלל של ל ס"מ, ובבין קל הבנוי מבטון בעובי ל ס״ם (הטפוסי לסבבים טרומיים מסוימים)• מציור זה ביתן לראות שבבבין ”כבד” טמפרטורות היום במוכות במידה ביכרת, טמפרטורות הלילה בו הן יותר גבוהות מאשר בבבין ”קל"• המהלך הממשי של טמפרטורות הפבים ביום ובלילה תלוי בתבאי האורור, ועל ידי שלוב של בחירת תמרי המבנה וסגידה ופתיחה מכוובת של החלובות ביתן לכוון במידה מרובה את מהלך הטמפרטורות בהתאם לדרישות הפיזיולוגיות באזור מסוים.
