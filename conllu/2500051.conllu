# file = txt/2500051.txt
# filelineno = 142
# sentno = 1
# text = כפי שנראה מציור מס* 11, הרי עבור אנשים במנוחה בתנאי אויר שקט ולחץ אדים של ל1 ם״מ כספית, טמפרטורת הסביבה הגורמת לקצב הזעה כזה היא כ~27 מעלות" תכבון הבבין צריך איפוא להעשות בצורה כזאת שיאפשר למבוע עלית טמפרטורת הפבים בתבאי חלובות ותריסים סגורים מעל לגבול של 27 מעלות, עד לאותה שעה שבה טמפרטורת אויר החוץ יורדת לטמפרטורה קרובה לכך, ז״א עד לשעה ל אחה״צ בערך• בוסף על כך יש לדאוג שהתקררות הבבין תהיה מהירה במידה מספקת כדי להבטיח תבאי שיבה בוחים בלילה, בשכוך הרוח החיצובית, דכן להבטיח טמפרטורת המיבימום במוכה דיה שתטבע הצטברות חום בבבין ועלית הטמפרטורה בו במהלך חדשי הקיץ.
# raw = {'id': 1, 'text': 'כפי שנראה מציור מס* 11, הרי עבור אנשים במנוחה בתנאי אויר שקט ולחץ אדים של ל1 ם״מ כספית, טמפרטורת הסביבה הגורמת לקצב הזעה כזה היא כ~27 מעלות" תכבון הבבין צריך איפוא להעשות בצורה כזאת שיאפשר למבוע עלית טמפרטורת הפבים בתבאי חלובות ותריסים סגורים מעל לגבול של 27 מעלות, עד לאותה שעה שבה טמפרטורת אויר החוץ יורדת לטמפרטורה קרובה לכך, ז״א עד לשעה ל אחה״צ בערך• בוסף על כך יש לדאוג שהתקררות הבבין תהיה מהירה במידה מספקת כדי להבטיח תבאי שיבה בוחים בלילה, בשכוך הרוח החיצובית, דכן להבטיח טמפרטורת המיבימום במוכה דיה שתטבע הצטברות חום בבבין ועלית הטמפרטורה בו במהלך חדשי הקיץ.', 'dspan': (0, 566), 'tokens': [{'id': 1, 'text': 'כפי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 3, 'deprel': 'mark', 'dspan': (0, 3), 'span': (0, 3), 'lemma': 'כפי'}, {'id': (2, 3), 'text': 'שנראה', 'expanded': [{'id': 2, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 1, 'deprel': 'fixed', 'lemma': 'ש'}, {'id': 3, 'text': 'נראה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Sing|Person=3|Tense=Past|Voice=Mid', 'head': 102, 'deprel': 'advcl', 'lemma': 'נראה'}], 'span': (4, 9), 'dspan': (4, 9)}, {'id': (4, 5), 'text': 'מציור', 'expanded': [{'id': 4, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'מ'}, {'id': 5, 'text': 'ציור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'obl', 'lemma': 'ציור'}], 'span': (10, 15), 'dspan': (10, 15)}, {'id': 6, 'text': 'מס* 11', 'upos': 'NUM', 'xpos': 'NUM', 'head': 151, 'deprel': 'nummod', 'dspan': (16, 22), 'span': (16, 22), 'lemma': 'מס* 11'}, {'id': 7, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 3, 'deprel': 'punct', 'dspan': (22, 23), 'span': (22, 23), 'lemma': ','}, {'id': 8, 'text': 'הרי', 'upos': 'ADV', 'xpos': 'ADV', 'head': 40, 'deprel': 'advmod', 'dspan': (24, 27), 'span': (24, 27), 'lemma': 'הרי'}, {'id': 9, 'text': 'עבור', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'dspan': (28, 3