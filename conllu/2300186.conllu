# file = txt/2300186.txt
# filelineno = 179
# sentno = 1
# text = היררכיה במוסדות התכנון כאשר החלטות הדרג המקומי כפופות לאישור הדרג שמעליו - מצב המוכר לנו בישראל כמובן מאליו - אינו כה שיגרתי בחלק מהארצות המערביות, המותירות שיקול דעת רב יותר, לעיתים כמעט מוחלט, למישור המקומי (ראו אלתרמן 1991).
