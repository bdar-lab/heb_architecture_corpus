# sentno = 3
# text = הגידול העירוני וההתפרשות על פני שטחים רחבים יותר הביאו את המחוזות השונים - לדוגמא עיריית בריזב״ן במחוז דרום מזרח וו״לס ועיריית סידני, לתכנון עירוני הוליסטי המתייחס למשאב הנהר העובר בעיר לשימורו ולניצולו, להגברת מודעות התושבים לערכיו של הנהר ולשיתוף קהילות עירוניות בתהליך השיקום והפיתוח של הנחל וסביבתו בתווך האורבאנ׳, חקר ארוע זה הובא, למרות שהוא חורג מגבולות ישראל ומן התנאים הפיסיים בה, בשל התפיסה הכוללת והקומפלקס הארצי ואף הגלובלי בה נדון הנחל העירוני.
