# file = txt/1400022.txt
# filelineno = 557
# sentno = 2
# text = תכנית האב לירוחם ניסתה לקשור את אפיקי הנחל הזורמים בגבולות העיירה, כתומכים ומסייעים לאיכויות אלו -לקשירת חלקיה של העיירה להתהוות צירים "קהילתיים" קושרים בין חלקיה, ולדו קיום משמעות׳ בין הסביבה העירונית לסביבה המדברית - שביטוייה בנחלים העירוניים.
