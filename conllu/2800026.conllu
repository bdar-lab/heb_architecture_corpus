# file = txt/2800026.txt
# filelineno = 9
# sentno = 3
# text = ואילו מבחינה עיונית יש בהבחנה זו משום נסיון רציני למנוע את ערבוב המושגים השכיח אצלנו והמביא תכופות לכך שאין מבחינים בין הוצאות שוטפות בתחום השיכון( בגון הוצאות תכנון ומחקר, הוצאות מינהליות וכיו״ב), אשד מקומן למעשה בתקציב הרגיל, לבין השקעות הון ממשיות השייכות לתקציב הפיתוח; או בין השקעות משתלמות, אשד אותן מקבלת המדינה בחזדה במדוצת השנים, בצודת פדעון הלוואות ודפי שכירות, לבין הענקות בלתי-חוזדות לצורך הוזלת הדיור.
