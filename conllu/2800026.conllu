# file = txt/2800026.txt
# filelineno = 287
# sentno = 10
# text = יש להניח, אמנם, כי הבתים שנרכשו בשנים האחרונות נכנסו למאזן לפי מחירי הקרן האמיתיים, על אחת כמה וכמה תוך התחשבות בקרן הפחת הניכרת, אשד נוצרה בצד השני של המאזן, אולם קדוב לודאי, כי הפלאי הישן, ז״א הבתים שנרכשו לפני 1956, מעון הערכה מתוקנת.
