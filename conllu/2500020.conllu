# text = יש להניח כי לא ניתן למנוע לחלוטין את בעיות הקורוזיה הכרוכות בשימוש באלומיניום בסביבה ימית, אך יש גם לקבוע כי ניתן לתכנן ולייצר את־ מוצרי האלומיניום, ולהשתמש בהם בבניה כך - שתימנע החרפה מיותרת של הבעיות־ תיבנון, ייצור והתקנה נכונים של מוצר האלומיניום בבניה באטמוספירה קורו-זיבית - די בהם כדי להבטיח לו קים ותיפעול תקין לתקופה שאינה נופלת מתקופת הקים הצפוי לבנין עצמו, והעולה ללא ספק על זו של חומרים אחרים המשמשים לצרכי פנסטרציה.
# raw = {'id': 1, 'text': 'יש להניח כי לא ניתן למנוע לחלוטין את בעיות הקורוזיה הכרוכות בשימוש באלומיניום בסביבה ימית, אך יש גם לקבוע כי ניתן לתכנן ולייצר את־ מוצרי האלומיניום, ולהשתמש בהם בבניה כך - שתימנע החרפה מיותרת של הבעיות־ תיבנון, ייצור והתקנה נכונים של מוצר האלומיניום בבניה באטמוספירה קורו-זיבית - די בהם כדי להבטיח לו קים ותיפעול תקין לתקופה שאינה נופלת מתקופת הקים הצפוי לבנין עצמו, והעולה ללא ספק על זו של חומרים אחרים המשמשים לצרכי פנסטרציה.', 'dspan': (0, 427), 'tokens': [{'id': 1, 'text': 'יש', 'upos': 'ADV', 'xpos': 'ADV', 'head': 0, 'deprel': 'root', 'dspan': (0, 2), 'span': (0, 2), 'lemma': 'יש'}, {'id': 2, 'text': 'להניח', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=HIFIL|VerbForm=Inf|Voice=Act', 'head': 1, 'deprel': 'xcomp', 'dspan': (3, 8), 'span': (3, 8), 'lemma': 'הניח'}, {'id': 3, 'text': 'כי', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 5, 'deprel': 'mark', 'dspan': (9, 11), 'span': (9, 11), 'lemma': 'כי'}, {'id': 4, 'text': 'לא', 'upos': 'ADV', 'xpos': 'ADV', 'feats': 'Polarity=Neg', 'head': 5, 'deprel': 'advmod', 'dspan': (12, 14), 'span': (12, 14), 'lemma': 'לא'}, {'id': 5, 'text': 'ניתן', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'advcl', 'dspan': (15, 19), 'span': (15, 19), 'lemma': 'ניתן'}, {'id': 6, 'text': 'למנוע', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebBinyan=PAAL|VerbForm=Inf|Voice=Act', 'head': 5, 'deprel': 'csubj', 'dspan': (20, 25), 'span': (20, 25), 'lemma': 'מנע'}, {'id': 7, 'text': 'לחלוטין', 'upos': 'ADV', 'xpos': 'ADV', 'head': 6, 'deprel': 'advmod', 'dspan': (26, 33), 'span': (26, 33), 'lemma': 'לחלוטין'}, {'id': 8, 'text': 'את', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Acc', 'head': 9, 'deprel': 'case:acc', 'dspan': (34, 36), 'span': (34, 36), 'lemma': 'את'}, {'id': 9, 'text': 'בעיות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 6, 'deprel': 'obj', 'dspan': (37, 42), 'span': (37, 42), 'lemma': 'בעיה'}, {'id': (10, 11), 't