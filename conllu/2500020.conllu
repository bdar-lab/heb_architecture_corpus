# file = txt/2500020.txt
# filelineno = 5
# sentno = 1
# text = הבדיקה התיחסה לעצם השימוש בסגסוגות האלומיניום מבחינת החומר ,לטיב הגנתו מפני קורוזיה על ידי אילגון, לאופן ייצור והרכבת האלמנטים מאלומיניום והתאמת פירזולם ואביזריהם, לשיטת התקנתם באתרי הבנייה ולדרכי אחזקתם וניקויים" ניתוח מימצאי הבדיקה והתצפיות שנערכו, וכן מסקנות הבדיקות המעבדתיות, שכולן יפורטו להלן - שימשו בסיס למסקנות המחקר ולהמלצות המפורטות על אופן השימוש והטיפול במוצרי אלומיניום בבנינים בסביבה ימית בארץ.
# raw = {'id': 1, 'text': 'הבדיקה התיחסה לעצם השימוש בסגסוגות האלומיניום מבחינת החומר ,לטיב הגנתו מפני קורוזיה על ידי אילגון, לאופן ייצור והרכבת האלמנטים מאלומיניום והתאמת פירזולם ואביזריהם, לשיטת התקנתם באתרי הבנייה ולדרכי אחזקתם וניקויים" ניתוח מימצאי הבדיקה והתצפיות שנערכו, וכן מסקנות הבדיקות המעבדתיות, שכולן יפורטו להלן - שימשו בסיס למסקנות המחקר ולהמלצות המפורטות על אופן השימוש והטיפול במוצרי אלומיניום בבנינים בסביבה ימית בארץ.', 'dspan': (0, 409), 'tokens': [{'id': (1, 2), 'text': 'הבדיקה', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'בדיקה', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'nsubj', 'lemma': 'בדיקה'}], 'span': (0, 6), 'dspan': (0, 6)}, {'id': 3, 'text': 'התיחסה', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=HITPAEL|Number=Sing|Person=3|Tense=Past', 'head': 0, 'deprel': 'root', 'dspan': (7, 13), 'span': (7, 13), 'lemma': 'התיחסה'}, {'id': (4, 5), 'text': 'לעצם', 'expanded': [{'id': 4, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 5, 'deprel': 'case', 'lemma': 'ל'}, {'id': 5, 'text': 'עצם', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 3, 'deprel': 'obl', 'lemma': 'עצם'}], 'span': (14, 18), 'dspan': (14, 18)}, {'id': (6, 7), 'text': 'השימוש', 'expanded': [{'id': 6, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 7, 'deprel': 'det', 'lemma': 'ה'}, {'id': 7, 'text': 'שימוש', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 5, 'deprel': 'compound:smixut', 'lemma': 'שימוש'}], 'span': (19, 25), 'dspan': (19, 25)}, {'id': (8, 9), 'text': 'בסגסוגות', 'expanded': [{'id': 8, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 9, 'deprel': 'case', 'lemma': 'ב'}, {'id': 9, 'text': 'סגסוגות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Plur', 'head': 7