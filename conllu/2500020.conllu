# file = txt/2500020.txt
# filelineno = 232
# sentno = 2
# text = מאידך יש להקפיד שלא יישאר רווח גדול מדי בין מעטפת הבורג לדפנות הקדח, כדי למנוע הצטברות רטיבות ברווחים כאלה, והתפתחות קורוזית-סדקים שם, למרות ההמלצה העקרונית להשתמש בברגי אלומיניום -אין להשתמש בהם לחיבור אלומיניום אל אלמנטים מפלדה, אפילו היא מגולוונת, כי בקדח שבפלדהאין ציפוי אבץ, ובורג האלומיניום שם יבוא במגע ישיר ובלתי מוגן עם הפלדה, וייפגע עקב הקורוזיה הגלוונית שתתפתח שם.
