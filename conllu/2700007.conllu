# file = txt/2700007.txt
# filelineno = 256
# sentno = 1
# text = בד בבד עם הצורך בחזון כולל ל׳שלום מזרח תיכוני" ועם השאיפות להאצת שיתוף הפעולה הכלכלי בין מדינות האזור, יש להיזהר מהזונות אוטופיים, שיש בהם התעלמות מכשלים בסיסיים הקיימים באזור, כמו למשל: היחס החשדני הבסיסי של העמים הערביים־מוסלמים לקיומה של מדינת ישראל כמדינה יהודית ריבונית במזרח התיכון; המאפיינים וההבדלים הכלכליים והחברתיים המשמעותיים בין ישראל לבין שכנותיה; השוני במשטרים הכלכליים והפוליטיים ובאורינטציה התרבותית-מסורתית בין ישראל לשכנותיה.
