# file = txt/2700007.txt
# filelineno = 284
# sentno = 2
# text = הערכות שנעשו לאחרונה על בסיס היתרונות היחסיים הנגלים של כל ארץ על-ידי (1995) Halbach וחובריו מצביעות על ההערכה, שפרט למספר ענפים, ניתן להשיג, במקרה הטוב, סחר תוך־אזורי בינוני בהיקפו, ואת הסחר שאכן יתפתח יש לראות בעיקרו כתומך בפתיחות כלפי חוץ של האזור.
