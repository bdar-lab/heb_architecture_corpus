# file = txt/2700007.txt
# filelineno = 265
# sentno = 2
# text = אף כי האינטרס המדיני של שני הצדדים הוא לשנות את טבעם של היחסים האלה, הרי שהפרדה מהירה תביא רק להידרדרות נוספת במצבו של המשק הפלסטיני, וכתוצאה מכך להגדלת הפוטנציאל לאי-יציבות פוליטית ולהתגברות הטרור.
