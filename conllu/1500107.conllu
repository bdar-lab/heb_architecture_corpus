# file = txt/1500107.txt
# filelineno = 605
# sentno = 2
# text = מטרה כוספת של מחקר זה מושגת באמצעות בכיית מורל רגרסייה מרובת משתכים, אשר מתאר ומסביר את תהליך ההשתכות של שימושי הקרקע תוך התיחסות למספר גורמים הפועלים באופן משולב ביכיהם: גורם הכגישות (מידת הקרבה לכתיבי איילון); מדר חברתי - כלכלי (המשקף גם את איכות השכובה ואת הביקוש לקרקע למגורים, בעקיפין); משתכה מיקום בחלוקה רוחבית לצפון - מרכז - דרום (קיימים הבדלים בחלוקה לרוחב העיר);
