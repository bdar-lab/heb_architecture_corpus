# file = txt/1500107.txt
# filelineno = 143
# sentno = 1
# text = במחקר של (1991) Deakin, שנערך בקליפורניה שבארה״ב, נמצא שלגורש התנועה יש השלכות שליליות על הכלכלה האזורית, ואחת הסיבות המרכזיות לתופעה היא חוסר התאום ביו מדיניות תכנוו עירונית של שימושי קרקע לביו תכנוו כושר הנשיאה של מערכות התחבורה.
