# file = txt/1500107.txt
# filelineno = 273
# sentno = 10
# text = לסיכום, מע״ר מטרופולין תל אביב, המהווה גם את מרכז הפעילות הכלכלית הגלובאלית של ישראל, מורכב כיום משלושה גלעינים מתמחים: המע״ר המסורתי שהתפתח באחוזת בית ושלוחותיו לשדרות רוטשילד; מע״ר האיילון הכולל גם את רחוב שאול המלך ואזור הקרייה, את מתחם הבורסה ברמת גן, ואת 'גבעתיים סיטי'; ומע״ר 'הסיטי' הנושק לחוף הים, באזור מנשיה, המאכלס בעיקר משרדי ארגונים, מוסדות ומשרדי אם של חברות תעשייה.
