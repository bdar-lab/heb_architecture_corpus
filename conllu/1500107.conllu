# file = txt/1500107.txt
# filelineno = 380
# sentno = 1
# text = לסיכום, מניתוח התחלות הבנייה בת"א-יפו בשנים 1982-2007, לפי רובעים, ניתן לקבוע כי תהליכי צמיחה ובנייה מתרחשים בכל רחבי העיר על תשעת הרובעים שלה, אך לא באופן אחיד, וככל הנראה מושפעים מגורמים מורכבים הקשורים במגוון של תחומים, למשל : נגישות, ערכי קרקע, כוחות השוק והיזמות, זמינות של קרקע פנויה לבנייה, היצע של תוכניות בנין עיר ומדיניות תכנונית של העירייה ואף של המחוז.
