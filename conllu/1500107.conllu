# text = גם בעיתונות הפופולארית מתפרסמות ידיעות המשקפות את תמונת העתיד של המערך הבנוי הצפוי להתהוות לאורך האיילון: "בשנים הקרובות יקומו 12 מגדלי משרדים חדשים בסמיכות למגדלי עזריאלי...כיום קיים מחסור בשטחי משרדים בתל אביב..."41 ניתן להרחיב את שטח הבדיקה לכלול, לא רק את תל אביב, אלא ערים נוספות במטרופולין כמו: רמת גן, הרצליה, ראשון לציון ועור.
# raw = {'id': 4, 'text': 'גם בעיתונות הפופולארית מתפרסמות ידיעות המשקפות את תמונת העתיד של המערך הבנוי הצפוי להתהוות לאורך האיילון: "בשנים הקרובות יקומו 12 מגדלי משרדים חדשים בסמיכות למגדלי עזריאלי...כיום קיים מחסור בשטחי משרדים בתל אביב..."41 ניתן להרחיב את שטח הבדיקה לכלול, לא רק את תל אביב, אלא ערים נוספות במטרופולין כמו: רמת גן, הרצליה, ראשון לציון ועור.', 'dspan': (524, 858), 'tokens': [{'id': 1, 'text': 'גם', 'upos': 'ADV', 'xpos': 'ADV', 'head': 3, 'deprel': 'advmod', 'dspan': (524, 526), 'span': (0, 2), 'lemma': 'גם'}, {'id': (2, 3), 'text': 'בעיתונות', 'expanded': [{'id': 2, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'case', 'lemma': 'ב'}, {'id': 3, 'text': 'עיתונות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 6, 'deprel': 'obl', 'lemma': 'עיתונות'}], 'span': (3, 11), 'dspan': (527, 535)}, {'id': (4, 5), 'text': 'הפופולארית', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'פופולארית', 'upos': 'ADJ', 'xpos': 'ADJ', 'feats': 'Gender=Fem|Number=Sing', 'head': 3, 'deprel': 'amod', 'lemma': 'פופולארית'}], 'span': (12, 22), 'dspan': (536, 546)}, {'id': 6, 'text': 'מתפרסמות', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=HITPAEL|Number=Plur|Person=3|Tense=Pres|VerbForm=Part|Voice=Mid', 'head': 0, 'deprel': 'root', 'dspan': (547, 555), 'span': (23, 31), 'lemma': 'מתפרסמות'}, {'id': 7, 'text': 'ידיעות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 6, 'deprel': 'nsubj:pass', 'dspan': (556, 562), 'span': (32, 38), 'lemma': 'ידיעה'}, {'id': (8, 9), 'text': 'המשקפות', 'expanded': [{'id': 8, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 9, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 9, 'text': 'משקפות', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Fem|HebBinyan=PIEL|Number=Plur|Person=3|Tense=Pres|VerbForm=Par