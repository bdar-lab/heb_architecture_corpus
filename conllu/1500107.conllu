# file = txt/1500107.txt
# filelineno = 635
# sentno = 1
# text = ממצאי המחקר הנוכחי תואמים גם את ממצאי הספרות מן העולם: הקשר בין השקעה בתחבורה להשתנות שימושי הקרקע בעקבות השקעה זו, נמדדת לאורך שנים, קשורה בסדר גודל של הפרוייקט ובהיקף ההשקעה, במצב כלכלי, חברתי, בזמינות של קרקע לבנייה, בתוכניות בנין - עיר שניתן לממש, בפעולת כוחות השוק, ובגורמים נוספים הפועלים במערכת, כשהמניע לתהליכים אלה הוא מרכיב השיפור בנגישות.
