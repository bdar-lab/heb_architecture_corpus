# file = txt/1500226.txt
# filelineno = 255
# sentno = 2
# text = ההשערה הראשונה היתה כי המשתתפים יצמדו לנתיבים שיתפסו אצלם כמרכזיים, כדי לא לחוש בלבול ולהסתכן באיבוד הדרך גם אם פירושו הדבר כי המסלול יתארך וזאת בהסתמך על מחקרים על פיהם אנשים יחפשו צירים מרכזיים במרחב, מתוך מחשבה כי הם תמיד יהיו מחוברים ליציאות (2003 ,Shen).
