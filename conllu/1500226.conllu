# file = txt/1500226.txt
# filelineno = 312
# sentno = 3
# text = שילוט הכוונה מסוגים שונים (חיצים, שלטי אינדקס המפרטים אלו עסקים מצויים בכל קומה ועוד) יכול להשפיע על קבלת החלטות של אדם במצב של תנועה שגרתית, לא כל שכן במצב חירום, אולם מחקר זה לא בדק האם אנשים במצב של לחץ נעזרים בהכוונה מסוג זה, או מעדיפים לנווט בעצמם ולהסתמך על אלמנטים אחרים.
