# file = txt/2300176.txt
# filelineno = 476
# sentno = 2
# text = מתקני ההחדרה בפני הקרקע המתוארים הם: ריצוף חדיר, אגני חלחול (infiltration basins) או בריכות ההשהיה (dry retention ponds) ותעלות עשב (swales), ואילו מתקני ההחדרה התת־קרקעיים המתוארים הם: קולטן מחדיר (soakway), תעלות החדרה (infiltration trenches), מטיפוסים שונים, ושמיכות החדרה (infiltration blankets) ־ מתקנים הדומים לריצוף חדיר למעט העובדה שהם מכוסים בקרקע או משטח אחר.
