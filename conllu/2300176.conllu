# file = txt/2300176.txt
# filelineno = 468
# sentno = 1
# text = פרגוסון מתאר בספרו, את התנאים והאפשרויות להתקנת אמצעי החדרה, וממליץ שלכל אמצעי או שיטה להחדרת מי הער יהיו שתי מערכות: מערכת' ראשונית, המתוכננת לקלוט ולהחדיר את המים בהתאם לתקופת חזרה כלשהי, ומערכת משנית, שמטרתה לוודא שבסופות גדולות במיוחד, או כאשר קיימת בעיה במתקני ההחדרה (כמו סתימה לדוגמא), לא ייגרם נזק באזור, והמים יוזרמו על פני הקרקע ולמערכת הניקוז האזורית.
