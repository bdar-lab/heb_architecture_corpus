# file = txt/2300176.txt
# filelineno = 587
# sentno = 3
# text = נמליץ לממונה על עיצוב השטח החדיר בחצרו של המבנה לדאוג לכך, שתעוצב בחצר רצועה חדירה, בגודל מינימלי של 15 מ״ר שטח חדיר על כל 100 מ״ר שטח אטום בחצר, ששיפועה יהיה מתון מאד (עד 2%) והקרקע בה תהיה בעלת מקדם חדירות של 30 מ״מ לשעה לפחות, והיא תמוקם כך שניתן יהיה להזרים אליה את מי הנגר מן השטח האטום.
