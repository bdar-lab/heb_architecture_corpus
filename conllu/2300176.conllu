# file = txt/2300176.txt
# filelineno = 252
# sentno = 2
# text = אומדן שטחים אטומים (שטחי גגות בצרוף שטחים סלולים ומרוצפים) וחרירים למי גשמים, בתוך השטח המפותח הנ״ל - לכל אחד משימושי הקרקע הנזכרים לעיל, (מגורים תעשייה, מוסדות ציבור, דרכים בין עירוניות וכר) ייחסנו אחוזי אטום/חדיר (ר׳ טור תכסית אטומה בטבלה שלהלן); ייחוס זה נעשה בהסתמך על התייעצויות שקיימנו עם מתכננים ותיקים של בנייה לשימושים שונים, ובהתבסס על השלכותינו מן הידע שצברנו, במהלך ביצוע מדידות מדויקות של שטחים אטומים וחדירים של מגורים ושירותים למיניהם, בשכונה אופיינית אחת (ר׳ פרק 2 דלעיל).
