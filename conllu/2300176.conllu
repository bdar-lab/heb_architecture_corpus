# file = txt/2300176.txt
# filelineno = 25
# sentno = 3
# text = למדנו שקיימים טיפוסים שונים של מתקנים אלה, שאפשר לשלבם בדפוסי הבנייה המקובלים בישראל, תוך התאמת הטיפוסים לתנאים הפיסיים־טבעיים המקומיים ולרצונות המתכננים והדיירים, שעלות הקמתם (במחירי 1995) מוסיפה רק מעט לעלות הכוללת של הבנייה, ושיעילותם ההידרולוגית הפוטנציאלית גבוהה מאוד.
