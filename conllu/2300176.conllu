# file = txt/2300176.txt
# filelineno = 334
# sentno = 4
# text = בין הכלים המשמשים למטרה זו נזכיר: זהירות בטיפול בקרקע המקורית של המגרש (הימנעות מערבוב חומרי בנייה, מהידוק מיותר וכוי), מיקום שטחים מרוצפים וחדירים בהתייחס למרזבים היורדים מן הגג, תכנון קפדני של שיפוע המשטחים האטומים והחדירים, תוספת של אדמת גן מסוגים ועוביים מסוימים, וכמובן: תכנון נאות של צמחיית הגן.
