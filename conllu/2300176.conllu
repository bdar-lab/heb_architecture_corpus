# file = txt/2300176.txt
# filelineno = 263
# sentno = 1
# text = דרך אחת לאמוד את הפסדי החלחול לקרקע, המהווים בעיקרם אובדן למי התהום באקוויפר החוף, מבוססת על מכפלה של אומדן ההפסד לקמ״ר של בנייה עירונית, שקיבלנו בעזרת החישוב לדוגמה בקרית גנים שבראשון לציון (ר׳ פרק 2), במספר הקמ״ר שתופסים היישובים העירוניים מעל אקוויפר החוף (עפ״י טבלה 3.1).
