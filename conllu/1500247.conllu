# file = txt/1500247.txt
# filelineno = 545
# sentno = 5
# text = המסגדים נתרמים לוואקף מתוך ידיעה שהעיריות לא יעזו להרוס אותם וכל הסקטורים מרוויחים מהקמת המסגד: העירייה משוחררת מהחובה לדאגה למוסדות לקהילה הגדלה, היזמים מרוויחים כסף היות והקמת המסגד מאפשרת מהרחבה של היישוב, ועצם הקמת המסגד מבטיחה לתושבים במידה מסוימת שהעירייה תקבל את היישוב הא-פורמלי ולא תהרוס אותו.
