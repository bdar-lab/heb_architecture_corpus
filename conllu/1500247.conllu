# file = txt/1500247.txt
# filelineno = 510
# sentno = 2
# text = ככאלה, יש להם חלק גדול בתהליך ההתחרדות של השכונה - אמנם חרדים עברו לשכונה עוד לפני קיום מוסדות הציבור של הקהילה, תוך הסתמכות על מוסדות ציבור סמוכים בסנהדריה מורחבת (קלופפר 2018; זריצקי 2019 - ראיונות), אך ספק אם המסה הגדולה של התושבים החרדים היתה ממשיכה להגיע ללא הקמת מוסדות ציבור חרדיים בשכונה.
