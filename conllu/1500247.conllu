# file = txt/1500247.txt
# filelineno = 497
# sentno = 1
# text = בשנת 2007, לאחר שהוגשה תביעה על ידי עיריית ירושלים נגד נציג בית הכנסת שהקים את הגנרטור ללא היתר, מוגשת בקשה להיתר על ידי עמותת בית מדרש "בני תורה" המדידה את מיקום הגנרטור למגרש אחר בשכונה ומתחייבת להטמין את כבלי החשמל היוצאים ממנו.
