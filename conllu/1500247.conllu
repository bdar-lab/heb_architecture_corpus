# sentno = 2
# text = תדמית זו נתמכת הן על ידי הפרופיל הקהילתי של רמת אשכול בו נטען די"המאפיינים הס1צי1אק1ממיים של ת1שבי התנהל הקהילתי הם יחסית נב1הים 1אכן נמצאים בסקאלה של מעמד בינוני עד בינוני גבוה" (בכור 2007), והן על ידי נתונים סטטיסטיים ממפקד האוכלוסין האחרון משנת 2008, המראים כי תושבי השכונה נמצאים מעל לממוצע העירוני במדדי ההכנסה ואיכות החיים.
