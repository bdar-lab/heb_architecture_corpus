# file = txt/1500247.txt
# filelineno = 484
# sentno = 4
# text = המנגנונים התכנוניים והפוליטיים בעירייה זיהו את הפוטנציאל בפעולות של התושבים החרדיים, ומכיוון שהם היו מעוניינים לקדם את השינוי, הם מאמצים את הכלים של התושבים ומפתחים את המנגון של תכנית הצל המקל על התושבים החרדיים הבאים שיכנסו לבניין העובר שינוי, ומאפשר שינוי מהיר של כל הבניין.
