# file = txt/1500247.txt
# filelineno = 85
# sentno = 1
# text = הדרישה לדירות במגזר החרדי גבוהה מזו של הציבור הכללי וזאת מכמה סיבות: ראשית, הריבוי הטבעי הגבוה וגיל הנישואין הנמוך (גורוביץ וכהן־קסטרו 2004); שנית הנורמה שהתמסדה בקרב הציבור החרדי, בעיקר ב־“חברת הלומדים", ולפיה הורי הכלה (לבדם או יחד עם הורי החתן) רוכשים דירה לזוג הצעיר (מ. פרידמן 1991; זיכרמן 2016), עובדה שהביאה למצב בו 77% מהאוכלוסייה החרדית מחזיקים דירה בבעלותם, שיעור דומה לאוכלוסייה היהודית הלא-חרדית (מלאך 2016); שלישית, הגבלת גובה הבינוי בשל רצון להימנע משימוש במעלית שבת, שנזכרה קודם (צ׳רצ׳מן 1992; זיכרמן 2016); ורביעית, מחירי הדירות בגרעינים החרדיים עולים בהתאם לביקוש הגבוה ורבים לא יכולים להרשות לעצמם לרכוש דירה באזורים המבוקשים.
