# file = txt/1500247.txt
# filelineno = 333
# sentno = 2
# text = החלק הראשון עוסק בעירוב ובקהילה שהוא יוצר - מדובר על פעולה בקנה המידה השכונתי הנובעת מהממסד הרבני, ללא כל גיבוי רשמי מהעירייה; החלק השני עולה בקנה המידה ועוסק בגבולות המנהל הקהילתי השכונתי הכולל בתוכו כמה שכונות - שרטוט גבולות המנהלים הקהילתיים נעשה על ידי הדרג המקצועי בעירייה אך הושפע הן מעמדת הסיעות החרדיות והן מעמדת ראש העיר; לבסוף החלק השלישי עוסק בקנה המידה העירוני ומתמקד בתכנית ברקת לחלוקת השכונות בין חרדים לחילוניים - הסכם שנחת□ בשיתוף פעולה עם נציגי וועד הרבנים העומד מאחורי סיעת דגל התורה החרדית-ליטאית.
