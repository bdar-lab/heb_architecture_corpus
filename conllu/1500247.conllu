# sentno = 9
# text = החלטתו של ברקת לא להכליל את מתחם החינוך במפרק המחבר בין השכונות גם אם הייתה אמורה למנוע התחרדות של גבעת המבתר, מתגלה כשש שנים לאחר מכן, עם חשיפת התכנית לשמירת ציביון השכונות, כהשארה של קלף למיקוח במשא ומתן עתידי עם החרדים.
