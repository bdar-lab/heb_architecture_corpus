# file = txt/1500247.txt
# filelineno = 342
# sentno = 3
# text = העירוב המהודר נבנה רק מסביב לשכונות חרדיות ולעיתים סביב כל שכונה בנפרד, כקו גבול מפריד בין קהילות ושכונות - ככזה הוא לא רק מגדיר אילו שכונות וקהילות הן חלק מהמרחב החרדי אלא גם אילו שכונות הן מחוץ למרחב שנתפס כחרדי לפי וועד העירובין (2005 Fonrobert).
