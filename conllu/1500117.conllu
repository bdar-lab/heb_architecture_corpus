# file = txt/1500117.txt
# filelineno = 575
# sentno = 3
# text = ממצאי המחקר היו כי הן לגיל הנבדק והן לרמת האנתרופומורפיות של הדמות (שני המשתנים הבלתי-תלויים במחקר) יש קשר עם אופן תפישת הדמויות: נבדקים מבוגרים העניקו ציונים גבוהים יותר מהנבדקים הצעירים למרכיבי הפרסונה השונים של הדמויות, ובפרט לאלה של דמות האדם.
