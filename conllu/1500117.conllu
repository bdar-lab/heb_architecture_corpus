# file = txt/1500117.txt
# filelineno = 208
# sentno = 1
# text = אך דומה כי הקשר שבין הנבדק ל-ECA עמוק מכך: מחקרים הראו כי גם לאופיו של הנבדק יש השפעה על העדפתו לגבי 0-ECA תכונות כמו "מוחצנות" ו״מופנמות" אצל הנבדקים השפיעו על העדפתם EC AS, כאשר זו היתה ל-ECA בעל תכונות אופי דומות לשלהם (,Reeves & Nass 2001 ,1996 ; Bickmore & Cassell).
