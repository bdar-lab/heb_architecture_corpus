# file = txt/1500117.txt
# filelineno = 566
# sentno = 4
# text = כי זה עדיף על הפתק הקטן שמגיע עם התרופה שממילא אף אחד לא טורח לקרוא בעיון״ (אלעד, 34), ״יותר נוח להקשיב 3 דקות מאשר לקרוא את העלון״ (מאיה, 32), ״זה במקום לקרוא את האותיות הקטנות הנלוות לתרופות ״ (עדה, 74), "הסרטון עדיף על עלון, כי הוא ממוקד יותר בדברים העיקריים והחשובים״ (בני, 68), וגם - "הסרטון יותר משכנע מהעלון" (מיכאל, 82).
