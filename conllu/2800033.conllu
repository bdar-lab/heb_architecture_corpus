# file = txt/2800033.txt
# filelineno = 434
# sentno = 2
# text = עליית מחירי הדירות בשיעור גבוה מהתייקרות המבנים מתבטאת בעליה מתאימה של מחירי הקרקע, ולהיפך, יש לזכור, שבמדידת שווי שרותי הדיור הנחנו, שהרבית העצמית על הקרקע מגיעה ל-3% בלבד, לעומת 6,5% דבית עצמית על ההון המושקע במבנה; וזאת הואיל ולגבי הקדקע נמצאה מגמת השתבחות, שלפי הנחתנו תהיה 3,5% לשנה, למעשה זוהי שיטת החישוב של הלשכה המרכזית לסטטיסטיקה.
