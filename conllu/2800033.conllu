# file = txt/2800033.txt
# filelineno = 137
# sentno = 1
# text = את הדירות השכורות בדמי-מפתח יש לראות בקרובות יותר לקטגוריה של דידות בבעלותמאשר לדירות שכורות רגילות, וזאת משום ששכר הדירה המשולם על דירות שכורות המוגנות ע״י "חוק הגנת הדייר", אינו מבטא את מלוא השווי של שרותי הדיור בדירות אלו, אין ספק, ששכר הדירה שהיה נקבע לדירות אלו בתנאי שוק חפשי לדירות בהשכרה, היה גבוה יותר מאשד שכד הדירה המשולם בפועל לבעלי-הבתים ע״י הדיירים.
