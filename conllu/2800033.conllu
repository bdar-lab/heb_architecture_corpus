# file = txt/2800033.txt
# filelineno = 417
# sentno = 1
# text = הואיל והתנהגות בעלי-הקדקע בתקופה של גאות פתירים נוטה להיות מונופוליסטית, וכתוצאה סכך היצע הקרקע לבינוי הופך לבלתי-גפיש - הרי שהוצאות הפיתוח הגבוהות, ההתחייבות פההת-פתחות האורבנית, וכן גם הפסים והאגרות השונות, הבאים לאפשר את הארגון הרב יותר הדרוש לאיזור אורבני, פתבטאים אף הם בייקור של הקרקע, וזאת הואיל וההיצע של גודפי הייצור האחרים הפשפשים לבניה (בגון כוח-אדם והפרי בניה) הוא הרבה יותד גמיש.
