# sentno = 1
# text = שנת 1962 יוצאת דופן מבחינה זו, הן כאשד מחשבים את אחוז ההשקעה במגורים מתוך םה״כ ההשקעה בנכסים קבועים והן כאשר מחשבים אותו מתוך בלל ההכנסה הלאומית, בשני המקרים מתקבל אחוז (34% ו-14% בהתאמה), והגבוה במידה ניבדת מהאחוזים המתאימים בשנים הסמוכות.
