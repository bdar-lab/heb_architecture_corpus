# file = txt/1500170.txt
# filelineno = 339
# sentno = 1
# text = המודלים אשר לא ענו לתנאי המשוואה המתמטית שפיתח Tachi, אכן לא הצליחו להיפרש אלא בסיוע טריאנגולציה של הפנלים (משולשים במקום ריבועים), תהליך זה היווה ניסוי ביקורת לנכונות המשוואה שפיתח Tachi עבור הסימולטור לתכנון מבני אוריגמי קשיחים פרישים (Rigid Origami).
