# file = txt/2000126.txt
# filelineno = 28
# sentno = 11
# text = הסיבות העיקריות הן ירידת קרנו של מע״ר הדר כמקרה פרטי של דעיכת מרכזי הערים בארץ ובעולם, כאשר תרמו לכך התיישנות המקום, קיום בעיות נגישות חמורות ומצוקת חניה קשה; סיום הבנייה בדיוק במועד שהמשק נכנס למיתון עמוק, ושוק המקרקעין הארצי קרס; עודפים גדולים של שטחי רצפות מתחרים שהגיעו לשוק בו-זמנית (החיבור מתייחס אל רובם) כולל יוזמות בנייה מסיביות של עיריית חיפה הן בעיר התחתית (מתחם השלטון ובתי המשפט) והן בהדר במתחם העירייה.
