# file = txt/2000126.txt
# filelineno = 157
# sentno = 7
# text = היא חילקה את המשרדים לשלושה סוגים לפי רמות הארגון שלהם המשפעים על המיקום: משרדים מקומיים המשרתים אזור מצומצם, יכולים להתמקם במקומות שונים ברחבי הערים ובפרברים, שלא כמו משרדים המשרתים את כל העיר או האזור (המשרדים בתווך אשר זקוקים למיקום המרכזי אך יכולים להתמקם גם בשולי העיר ולא כמו משרדי המטה, אשר משרתים את כל המדינה או קבוצת מדינות, אשר זקוקות למיקום מרכזי ביותר - במע״ר המטרופוליני.
