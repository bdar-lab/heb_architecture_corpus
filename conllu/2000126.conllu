# file = txt/2000126.txt
# filelineno = 473
# sentno = 4
# text = יוקרתו של פארק מת״מ והאטרקטיביות שלו כפארק היי-טק המספק שירותים נדרשים ברמה גבוה יחד עם "דיירי עוגן" בדמות של חברות בינלאומיות חשובות (אינטל, IBM), וכן שירותים נוספים שהוא מספק כמו גני ילדים, דואר ועוד, באה לידי ביטוי בשיעורי שכירות גבוהים ולמרות זאת באחוזי תפוסה גבוהים במשך תקופה ארוכה בנוסף לכך, המיקום של הפארק סמוך לכביש מהיר ולרכבת מאפשר יוממות נוחה של העובדים הנשענים ברובם על תחבורה פרטית (ניתן לראות מרחוק את החניות המשתרעות על שטחים גדולים ומלאות עד אפס מקום -ראו איור מס׳ 4, סעיף 2.5.2) וגם על מערכת הסעות, שמפעילות הפירמות השונות עבור העובדים.
