# file = txt/2000126.txt
# filelineno = 328
# sentno = 2
# text = עד לא מזמן התרכזו כל הפעילויות העסקיות בעבר במע״ר הישן בהדר הכרמל (ברחובות הרצל, הנביאים, ביאליק, בלפור וכו׳), היום אמנם מתקיימת כעילות כזו בהדר בבניניס חדשים כמו בבית מאי ומגדל ארמון, אך החלו להתפתח מרכזים נוספים כמו בעיר התחתית (שולי המע״ר במחקר זה) במושבה הגרמנית בבניין סיטי סנטר בבית כלבו מול אגד - בניין בת גלים לשעבר, בשולי העיר המרכזית- למשל בצ׳ק פוסט, ובקצה העיר במתחם מת״מ.
