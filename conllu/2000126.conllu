# file = txt/2000126.txt
# filelineno = 609
# sentno = 13
# text = התיישנות בנייני המשרדים במע״ר, רנטה גבוהה, מיסים גבוהים יחד עם בעיות נגישות וחניה חמורות הביאו לעליה בביקושים לשטח משרדי חדש בטבעות שמחוץ למע״ר, ותרמו במידה רבה לבניה הקיימת והעתידית בשולי המע״ר, וגם בחלקים אחרים של העיר כמו אזור הצ׳ק פוסט ורכס הכרמל (קפניס, 1993).
