# file = txt/2000126.txt
# filelineno = 158
# sentno = 4
# text = ההתפתחות הטכנולוגית ותחום התקשוב והמחשוב הביאו לשינוי במבנה הפנימי של פירמות המשרדים והביא לירידת הצורך בקרבה גיאוגרפית ביניהם מה שתרם רבות גם לשינויים בגורמי המיקום של הפירמות המשרדיות ,Daniels) (1993 ,1993; Clapp, כן תרמו לכך לא מעט המצב במרכזי הערים (גודש תנועה, התיישנות בניינים, בעיות חניה פשע ועוד).
