# file = txt/2000126.txt
# filelineno = 511
# sentno = 2
# text = השערת המחקר המרכזית העומדת בבסיס המחקר היא שפירמות המעדיפות להתמקם במרכזי הערים, בעיקר פירמות מסוג מנהל ושלטון, שירותים משפטיים ^FIRE, מייחסות חשיבות רבה ליתרונות של מרכזי הערים ביניהם: קירבה ללקוחות ולמתקנים חשובים, לאפשרות עשיית עסקים במפגשי "פנים מול פנים", לתדמית ויוקרת המקום ואיכות האתר והמבנים.
