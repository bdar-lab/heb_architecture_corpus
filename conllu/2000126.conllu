# file = txt/2000126.txt
# filelineno = 681
# sentno = 2
# text = השיקול העיקרי העומד מצד היזם בהקמת בניין יוקרתי הוא הרצון שלו למקסם את רווחיו מהבניין על ידי משיכת חברות מסטטוס גבוה, שמוכנות לשלם מחיר גבוה (שכ״ד ודמי אחזקה גבוהים) עבור ה״בית המהודר״ והצ׳ופרים שהוא מציע (1993 ,Clapp).
