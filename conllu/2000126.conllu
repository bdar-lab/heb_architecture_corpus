# file = txt/2000126.txt
# filelineno = 547
# sentno = 5
# text = יש לציין כי המיקום בטבעות הרחוקות נחשב עבורם מיקום קרוב לחיפה (משם מגיעים רוב העובדים), מכיוון שהמיקום של הפארקים בפרברים בסמיכות לכבישים ראשיים "מבטל" במידה רבה את גורם המרחק, כך שמיקום ביוקנעם או מגדל העמק לא משנה במיוחד כשהסיבות האחרות (שטח וכסף) דומיננטיים.
