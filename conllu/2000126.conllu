# file = txt/2000126.txt
# filelineno = 743
# sentno = 8
# text = פיתוח משולב שכזה, יחד עם הקצאת שצ״פים ומוקדים נוספים אשר יתחברו זה לזה במקום ו״יפרו" את תיגוניות הרחובות (על ידי בניית כיכרות, גנים קטנים), יעלו את ערכם של סביבות העבודה בע ר, '1יידו את ה״לחץ" מבחינת עומסי תנועה מהמע״ר, יפחיתו את פקקי התנועה, בעיות הנגישות והז הום הקיימים במרכז העיר.
