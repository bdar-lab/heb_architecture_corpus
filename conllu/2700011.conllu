# file = txt/2700011.txt
# filelineno = 134
# sentno = 2
# text = גם עכשיו אין לאגף התכנון על מחלקותיו ולשכותיו המחוזיות כל מעמד חוקי ודעתם אינה מחייבת איש, אך באפשרותם עכשיו לנסות ולכתוב את דעתם, ולהכתיב אח תנאיהם, באמצעות תכניות מתאר או תכניות מפורטות מתאימות, כלליות, (בהן החיצוב הוא רק אחד הפרטים) או תכניות ספציפיות (שמטרתן היחידה היא להסדיר את החיצוב).
