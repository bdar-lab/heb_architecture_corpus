# file = txt/2800107.txt
# filelineno = 170
# sentno = 1
# text = ראשית, למרות שמדובר בליבם של יישובים שמימדיהם עשויים לאפשר הליכה רגלית במרבית המירקם הבנוי, אין אותם צירי תנועה מהווים כלל "רחובות"; כמעט ללא יוצא מהכלל, אלה הם כבישים שביותם רחבים לרוב, מזמינים נהיגה מהירה, ובחלקם אף מוליכים "תנועה עוברת" מחוץ ליישוב ואליו.
