# text = אופי אזורי החיבור שבין המרכז בכללותו לבין המירקם הסובב המיידי, כשהמרכיבים הקובעים הינם במיוחד צרותם, "הדחקותם" ופיתוליהם של שערי ומסלולי הכניסה למרכז; הפרופיל הנמוך וההזנחה שב"שטחי מעבר"; והקפת המרכז מרוב צדדיו ע״י כבישים עמוסי תנועה מוטורית.
# raw = {'id': 1, 'text': 'אופי אזורי החיבור שבין המרכז בכללותו לבין המירקם הסובב המיידי, כשהמרכיבים הקובעים הינם במיוחד צרותם, "הדחקותם" ופיתוליהם של שערי ומסלולי הכניסה למרכז; הפרופיל הנמוך וההזנחה שב"שטחי מעבר"; והקפת המרכז מרוב צדדיו ע״י כבישים עמוסי תנועה מוטורית.', 'dspan': (0, 242), 'tokens': [{'id': 1, 'text': 'אופי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Sing', 'head': 0, 'deprel': 'root', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'אופי'}, {'id': 2, 'text': 'אזורי', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Masc|Number=Plur', 'head': 1, 'deprel': 'compound:smixut', 'dspan': (5, 10), 'span': (5, 10), 'lemma': 'אזור'}, {'id': (3, 4), 'text': 'החיבור', 'expanded': [{'id': 3, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 4, 'deprel': 'det', 'lemma': 'ה'}, {'id': 4, 'text': 'חיבור', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 2, 'deprel': 'compound:smixut', 'lemma': 'חיבור'}], 'span': (11, 17), 'dspan': (11, 17)}, {'id': (5, 6), 'text': 'שבין', 'expanded': [{'id': 5, 'text': 'ש', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 8, 'deprel': 'mark', 'lemma': 'ש'}, {'id': 6, 'text': 'בין', 'upos': 'ADP', 'xpos': 'ADP', 'head': 8, 'deprel': 'case', 'lemma': 'בין'}], 'span': (18, 22), 'dspan': (18, 22)}, {'id': (7, 8), 'text': 'המרכז', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'מרכז', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 1, 'deprel': 'acl:relcl', 'lemma': 'מרכז'}], 'span': (23, 28), 'dspan': (23, 28)}, {'id': (9, 11), 'text': 'בכללותו', 'expanded': [{'id': 9, 'text': 'ב', 'upos': 'ADP', 'xpos': 'ADP', 'head': 10, 'deprel': 'case', 'lemma': 'ב'}, {'id': 10, 'text': 'כללות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 8, 'deprel': 'nmod', 'lemma': 'כללות'}, {'id': 11, 'text': 'ו'