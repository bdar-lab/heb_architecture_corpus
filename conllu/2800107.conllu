# text = שנית, מבחינת המרכז עצמו,אין ספק שההפרדה הסטרילית גורעת אלמנט פוטנציאלי חשוב מתוך הפסיפס החי המבוקש ביישוב הפיתוח, כאשר שטחי ומבני מוסדות החינוך נמצאים כאילו "מחוץ לתחום"; הפעילות שבהם מצטמצמת, ככלל, ללוח הזמנים הפנימי של בתי-הספר ולחתך הספציפי של המשתמשים בהם.
# raw = {'id': 1, 'text': 'שנית, מבחינת המרכז עצמו,אין ספק שההפרדה הסטרילית גורעת אלמנט פוטנציאלי חשוב מתוך הפסיפס החי המבוקש ביישוב הפיתוח, כאשר שטחי ומבני מוסדות החינוך נמצאים כאילו "מחוץ לתחום"; הפעילות שבהם מצטמצמת, ככלל, ללוח הזמנים הפנימי של בתי-הספר ולחתך הספציפי של המשתמשים בהם.', 'dspan': (0, 260), 'tokens': [{'id': 1, 'text': 'שנית', 'upos': 'ADV', 'xpos': 'ADV', 'head': 9, 'deprel': 'advmod', 'dspan': (0, 4), 'span': (0, 4), 'lemma': 'שנית'}, {'id': 2, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 9, 'deprel': 'punct', 'dspan': (4, 5), 'span': (4, 5), 'lemma': ','}, {'id': (3, 4), 'text': 'מבחינת', 'expanded': [{'id': 3, 'text': 'מ', 'upos': 'ADP', 'xpos': 'ADP', 'head': 4, 'deprel': 'case', 'lemma': 'מ'}, {'id': 4, 'text': 'בחינת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 9, 'deprel': 'obl', 'lemma': 'בחינה'}], 'span': (6, 12), 'dspan': (6, 12)}, {'id': (5, 6), 'text': 'המרכז', 'expanded': [{'id': 5, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 6, 'deprel': 'det', 'lemma': 'ה'}, {'id': 6, 'text': 'מרכז', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 4, 'deprel': 'compound:smixut', 'lemma': 'מרכז'}], 'span': (13, 18), 'dspan': (13, 18)}, {'id': 7, 'text': 'עצמו', 'upos': 'PRON', 'xpos': 'PRON', 'feats': 'Gender=Masc|Number=Sing|Person=3|PronType=Emp|Reflex=Yes', 'head': 6, 'deprel': 'nmod', 'dspan': (19, 23), 'span': (19, 23), 'lemma': 'עצמו'}, {'id': 8, 'text': ',', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 9, 'deprel': 'punct', 'dspan': (23, 24), 'span': (23, 24), 'lemma': ','}, {'id': 9, 'text': 'אין', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'HebExistential=Yes', 'head': 0, 'deprel': 'root', 'dspan': (24, 27), 'span': (24, 27), 'lemma': 'אין'}, {'id': 10, 'text': 'ספק', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Sing', 'head': 9, 'deprel': 'nsubj', 'dspan': (28, 31), 'span': (28, 31), 'lemma': 'ספק'}, {'id': (11, 13),