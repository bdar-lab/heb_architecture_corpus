# file = txt/1500083.txt
# filelineno = 227
# sentno = 2
# text = אפשרות לפריצת גבולות התצוגה ויצירת ספירות - בהצבת מראות הנחתכות בנקודה אחת לאורך הצירים, והצבת פריט תצוגה על המראות או במשטח הקיטום של מפגש המראות, הצופה יכול לפתע לראות מולו כדור ענק של תצוגה, שכאילו נכנסת אל תוך החנות ופורצת את גבולות החלון (איור 44-41).
