# file = txt/1500083.txt
# filelineno = 161
# sentno = 4
# text = היטיב לבטא את הזיקה שאנו יוצרים בנפשנו, בין פרחים ויצירות אמנות, הצייר ג'יימס מקניל ויסלר (1834-1903):" יצירת המופת צריכה להתגלות כדרך שהפרח נגלה לעיני הצייר – מושלם בהנצתו כבמלוא פריחתו- בלי שום סיבה להסביר את נוכחותו – בלי שום שליחות שיש למלאה – חדווה לאמן, אשליה לנדבן – חידה לבוטנאי – מקריות של רגש ענוג ושל משחק מילים לאיש הרוח".
