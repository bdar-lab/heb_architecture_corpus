# file = txt/1500072.txt
# filelineno = 19
# sentno = 1
# text = קונצפטים ארכיטקטוניים של תקופת "הסגנון הבין-לאמי" המבוססים על עקרונות אחידים של תכנון ובניה שאינם מתחשבים בהבדלים אקלימיים בין מקום למקום, התפתחות האמצעים המכניים לחימום ולקירור, אנרגיה זולה שהייתה מצויה עד תקופת המשבר ב- 1973, גרמו להיווצרותה של ארכיטקטורה ״תלושה״ מקונטקסט אקלימי מקומי (2003 ,Heath).
