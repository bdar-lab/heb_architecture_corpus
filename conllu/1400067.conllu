# file = txt/1400067.txt
# filelineno = 127
# sentno = 1
# text = דגימת ואיסוף משתתפים: לשם דגימת משתתפים למחקר יצרנו בסוף שנת המחקר הראשונה קשר עם בעלי עניין המתגוררים באזור הכרמל תוך בקרה על איתור משתתפים בעלי מאפיינים חברתיים שונים (יהודים, דרוזים, בני נוער, נשים וגברים), המכירים את יערות הכרמל והמגיעים אליהם על מנת לקיים בהם מגוון פעילויות (נופש ובילוי, מחקר, מפגש עם חברים, טיולים ועוד), מתוך כוונה לשלב במחקר משתתפים בעלי מאפיינים חברתיים שונים (מבחינה מגדרית, גילאית, ואתנית) המשקפים את המארג החברתי המורכב של האוכלוסייה המשתמשת בשמ״א של יערות הכרמל.
