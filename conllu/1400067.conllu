# text = בחינת התפיסות המפיות של המשתתפים, במעבדת הוויזואליזציה ובשטח, על פי הפילוח לקבוצות חברתיות מעלה גם היא את המורכבות של התפיסות המפיות הקיימת בקרב קבוצות חברתיות שומת (ראו תרשימים 2-10 ומפות 1-6): בעוד שהתפיסות הדומיננטיות אצל מבוגרים במעבדת הוויזואליזציה היו אינטראקציה חברתית, נוף פתוח, התרחקות (בעיקר מאנשים אחרים) אך גם המשכיות (בעיקר בשימוש בתשתיות ובמתקנים מסודרים ונקיים), הרי שבקרב בני הנוער, התפיסה השלטת לבחירה בנופים היא זו של הנוף הפתוח.
# raw = {'id': 1, 'text': 'בחינת התפיסות המפיות של המשתתפים, במעבדת הוויזואליזציה ובשטח, על פי הפילוח לקבוצות חברתיות מעלה גם היא את המורכבות של התפיסות המפיות הקיימת בקרב קבוצות חברתיות שומת (ראו תרשימים 2-10 ומפות 1-6): בעוד שהתפיסות הדומיננטיות אצל מבוגרים במעבדת הוויזואליזציה היו אינטראקציה חברתית, נוף פתוח, התרחקות (בעיקר מאנשים אחרים) אך גם המשכיות (בעיקר בשימוש בתשתיות ובמתקנים מסודרים ונקיים), הרי שבקרב בני הנוער, התפיסה השלטת לבחירה בנופים היא זו של הנוף הפתוח.', 'dspan': (0, 447), 'tokens': [{'id': 1, 'text': 'בחינת', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Definite=Cons|Gender=Fem|Number=Sing', 'head': 25, 'deprel': 'nsubj', 'dspan': (0, 5), 'span': (0, 5), 'lemma': 'בחינה'}, {'id': (2, 3), 'text': 'התפיסות', 'expanded': [{'id': 2, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 3, 'deprel': 'det', 'lemma': 'ה'}, {'id': 3, 'text': 'תפיסות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 1, 'deprel': 'compound', 'lemma': 'תפיסות'}], 'span': (6, 13), 'dspan': (6, 13)}, {'id': (4, 5), 'text': 'המפיות', 'expanded': [{'id': 4, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 5, 'deprel': 'det', 'lemma': 'ה'}, {'id': 5, 'text': 'מפיות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Plur', 'head': 3, 'deprel': 'amod', 'lemma': 'מפיות'}], 'span': (14, 20), 'dspan': (14, 20)}, {'id': 6, 'text': 'של', 'upos': 'ADP', 'xpos': 'ADP', 'feats': 'Case=Gen', 'head': 8, 'deprel': 'case', 'dspan': (21, 23), 'span': (21, 23), 'lemma': 'של'}, {'id': (7, 8), 'text': 'המשתתפים', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'Definite=Def|PronType=Art', 'head': 8, 'deprel': 'det', 'lemma': 'ה'}, {'id': 8, 'text': 'משתתפים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 3, 'deprel': 'nmod:poss', 'lemma': 'משתתף'}], 'span': (24, 32), 'dspan': (24, 32)}, {'id': 9, 'text': ',', 'upos': 'PUNCT', 'xpos':