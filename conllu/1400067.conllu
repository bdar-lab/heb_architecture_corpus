# file = txt/1400067.txt
# filelineno = 152
# sentno = 1
# text = התרחקות - תפיסת הנופים כמספקים אפשרות התרחקות בזמן ולהרגיש קשר לעבר ("חיבור להיסטוריה"), התרחקות במרחב ממקום המגורים ("התנתקות מסביבה מיושבת.. מרוחק מהעיר"), יציאה משגרת היומיום /אסקפיזם ("מקום שונה מהנוף בו אני חיה ביומיום... מעלה את התחושה של 'יציאה מהשגרה' ויחופש מוחלט",, "מקום של ניתוק מהסביבה"), הגעה לנוף שונה ופראי (wilderness) ("טבע פראי, סבך צומח בוואדי... נראה כמו עולם אחר ושקט, עולם שהייתי רוצה להיות בו"), התמודדות עם הרפתקנות ואתגר ("מסלול טיולים מאתגר שההליכה בו נראית כלוקחת מאמץ מספק") , התרחקות מאנשים/מההמון במקום פרטי ואינטימי ("מקום לא המוני מדי, אינטימי, מבודד, אפשר לשבת בקבוצה קטנה או בזוג") ומקום לעצירה ולהתאווררות ("לנשום קצת אוויר מהנסיעה הארוכה באוטו"5).
