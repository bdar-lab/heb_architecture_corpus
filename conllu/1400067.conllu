# file = txt/1400067.txt
# filelineno = 153
# sentno = 1
# text = המשכיות - התייחסות לאתרים הנתפסים כמאפשרים את המשך שיגרת היומיום מתוך היותם נגישים וקרובים למקום המגורים ("מקום שקל להגיע אליו", "קרוב יחסית לבית"6), בעלי נוף מסודר ומטופח מעשי ידי אדם ("מקום זה נראה מטופח מאוד, מקום 'מזמין'", "נראה מקום מאורגן שנוח לעשות בו פיקניקים... נראה נקי ונוח"), מקומות המעניקים לשוהים בהם אווירה ביתית ("מקום לפתוח בו פק״ל קפה, להוריד נעליים ולנוח") ונתפסים כימקום הקבוע', המוכר והמוסכם, אליו חוזרים בכל הזדמנות ("זה המקום הקבוע שלנו").
# raw = {'id': 1, 'text': 'המשכיות - התייחסות לאתרים הנתפסים כמאפשרים את המשך שיגרת היומיום מתוך היותם נגישים וקרובים למקום המגורים ("מקום שקל להגיע אליו", "קרוב יחסית לבית"6), בעלי נוף מסודר ומטופח מעשי ידי אדם ("מקום זה נראה מטופח מאוד, מקום \'מזמין\'", "נראה מקום מאורגן שנוח לעשות בו פיקניקים... נראה נקי ונוח"), מקומות המעניקים לשוהים בהם אווירה ביתית ("מקום לפתוח בו פק״ל קפה, להוריד נעליים ולנוח") ונתפסים כימקום הקבוע\', המוכר והמוסכם, אליו חוזרים בכל הזדמנות ("זה המקום הקבוע שלנו").', 'dspan': (0, 462), 'tokens': [{'id': (1, 2), 'text': 'המשכיות', 'expanded': [{'id': 1, 'text': 'ה', 'upos': 'DET', 'xpos': 'DET', 'feats': 'PronType=Art', 'head': 2, 'deprel': 'det', 'lemma': 'ה'}, {'id': 2, 'text': 'משכיות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 0, 'deprel': 'root', 'lemma': 'משכיות'}], 'span': (0, 7), 'dspan': (0, 7)}, {'id': 3, 'text': '-', 'upos': 'PUNCT', 'xpos': 'PUNCT', 'head': 2, 'deprel': 'punct', 'dspan': (8, 9), 'span': (8, 9), 'lemma': '-'}, {'id': 4, 'text': 'התייחסות', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Fem|Number=Sing', 'head': 2, 'deprel': 'dep', 'dspan': (10, 18), 'span': (10, 18), 'lemma': 'התייחסות'}, {'id': (5, 6), 'text': 'לאתרים', 'expanded': [{'id': 5, 'text': 'ל', 'upos': 'ADP', 'xpos': 'ADP', 'head': 6, 'deprel': 'case', 'lemma': 'ל'}, {'id': 6, 'text': 'אתרים', 'upos': 'NOUN', 'xpos': 'NOUN', 'feats': 'Gender=Masc|Number=Plur', 'head': 4, 'deprel': 'nmod', 'lemma': 'אתר'}], 'span': (19, 25), 'dspan': (19, 25)}, {'id': (7, 8), 'text': 'הנתפסים', 'expanded': [{'id': 7, 'text': 'ה', 'upos': 'SCONJ', 'xpos': 'SCONJ', 'head': 8, 'deprel': 'mark', 'lemma': 'ה'}, {'id': 8, 'text': 'נתפסים', 'upos': 'VERB', 'xpos': 'VERB', 'feats': 'Gender=Masc|HebBinyan=NIFAL|Number=Plur|Person=1,2,3|VerbForm=Part|Voice=Mid', 'head': 6, 'deprel': 'acl:relcl', 'lemma': 'נתפס'}], 'span': (26, 33), 'dspan': (26, 33)}, {'id': (9, 10), 'text': 'כמאפשרים', 'expanded': [{'id': 9, 'text': 'כ', 'upos': 'ADP', 'xpos': 'AD